  "operations": [
    {
      "operation": "queryDocuments",
      "method": "POST",
      "path": "/v1/projects/{project}/databases/{database}/collections/{collection}/query",
      "scope": "documents:read"
    },
    {
      "operation": "createIndex",
      "method": "POST",
      "path": "/v1/projects/{project}/databases/{database}/indexes",
      "scope": "databases:write"
    },
    {
      "operation": "listIndexes",
      "method": "GET",
      "path": "/v1/projects/{project}/databases/{database}/indexes",
      "scope": "databases:read"
    }
  ],
  "contract": {
    "mediaType": "application/json",
    "near": {
      "maxLimit": 1000,
      "defaultLimit": 50,
      "maxDimensions": 4096,
      "geoMaxLimit": 1000,
      "cursor": false,
      "additionalSortKeys": false,
      "search": false
    },
    "createIndex": {
      "kinds": [
        "btree",
        "text",
        "vector"
      ],
      "vectorFields": 1,
      "minDimensions": 1,
      "maxDimensions": 4096,
      "dimensionsOnlyForVector": true,
      "status": 201,
      "errors": [
        400,
        403,
        404,
        409,
        503
      ],
      "retry": "never automatically retry create"
    },
    "index": {
      "required": [
        "name",
        "collection",
        "fields",
        "state"
      ],
      "kindDefault": "btree",
      "dimensions": "optional integer; present for vector indexes",
      "states": [
        "active",
        "building"
      ]
    }
  }
}
