{
  "openapi": "3.1.0",
  "info": {
    "title": "TerraBase Client HTTP API",
    "version": "1.0.0",
    "description": "Initial v1 HTTPS/JSON document API for a provisioned document shard (local-v1 or signed-v2 as configured). Use the same HTTPS origin that serves this specification. A scoped key is entered only in the browser authorization field or client process; no credential is included here. The collection schema and digest are provisioned through the operator path, not through these document routes. The active server configuration controls durability and retry limits. Document writes use transaction commits, reads use point reads, and scalar filters use the paginated query route; there are no separate PUT, PATCH or DELETE routes. Commit examples are refreshed with a ten-minute expiry when this document is served; reload the reference if the example has expired. Replace the example schema digest with the one provisioned for your collection.",
    "contact": {
      "name": "TerraBase API reference"
    },
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    }
  },
  "externalDocs": {
    "description": "Separate gRPC, SQL and local operator boundaries",
    "url": "/docs/protocols"
  },
  "servers": [
    {
      "url": "/",
      "description": "Same HTTPS origin as this document; direct requests with no third-party proxy."
    }
  ],
  "tags": [
    {
      "name": "Documents",
      "description": "Scoped point reads."
    },
    {
      "name": "Transactions",
      "description": "Atomic document creates, updates, deletes, and exact retries."
    },
    {
      "name": "Reference",
      "description": "Public API reference pages and OpenAPI specification."
    }
  ],
  "paths": {
    "/docs": {
      "get": {
        "tags": [
          "Reference"
        ],
        "operationId": "getApiReference",
        "summary": "Open the Scalar API reference",
        "description": "Public reference page served on this API origin. Its version-pinned Scalar script loads from an HTTPS CDN; API requests go directly to this origin. A bearer key is not required to load the page. Query strings are rejected and a GET body is ignored.",
        "security": [],
        "responses": {
          "200": {
            "description": "Open the Scalar API reference",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "invalid_request"
                  }
                }
              }
            }
          },
          "405": {
            "description": "method_not_allowed response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "method_not_allowed"
                  }
                }
              }
            }
          },
          "503": {
            "description": "The bounded client handler pool has no available slot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "capacity"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/docs/protocols": {
      "get": {
        "tags": [
          "Reference"
        ],
        "operationId": "getProtocolGuide",
        "summary": "Read protocol and operator guidance",
        "description": "Public same-origin reference asset. A bearer key is not required or used. Query strings are rejected and a GET body is ignored.",
        "security": [],
        "responses": {
          "200": {
            "description": "Read protocol and operator guidance",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "invalid_request"
                  }
                }
              }
            }
          },
          "405": {
            "description": "method_not_allowed response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "method_not_allowed"
                  }
                }
              }
            }
          },
          "503": {
            "description": "The bounded client handler pool has no available slot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "capacity"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "Reference"
        ],
        "operationId": "getOpenApi",
        "summary": "Get the v1 client OpenAPI document",
        "description": "Public same-origin reference asset. A bearer key is not required or used. Query strings are rejected and a GET body is ignored.",
        "security": [],
        "responses": {
          "200": {
            "description": "Get the v1 client OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "invalid_request"
                  }
                }
              }
            }
          },
          "405": {
            "description": "method_not_allowed response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "method_not_allowed"
                  }
                }
              }
            }
          },
          "503": {
            "description": "The bounded client handler pool has no available slot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "capacity"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "scopedApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "TerraBase API key",
        "description": "Use a provisioned, scoped tbk1 API key. Read and write grants are checked for the exact tenant/database/shard and collection. Do not put the key in a URL."
      }
    },
    "schemas": {
      "DecimalU64": {
        "type": "string",
        "description": "Unsigned decimal integer represented as a string so JavaScript does not round 64-bit values.",
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "PositiveDecimalU64": {
        "type": "string",
        "description": "Positive unsigned decimal integer represented as a string.",
        "pattern": "^[1-9][0-9]*$"
      },
      "Hex16": {
        "type": "string",
        "description": "Exactly 16 bytes in lowercase hexadecimal.",
        "pattern": "^[0-9a-f]{32}$"
      },
      "Hex32": {
        "type": "string",
        "description": "Exactly 32 bytes in lowercase hexadecimal.",
        "pattern": "^[0-9a-f]{64}$"
      },
      "TransactionId": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expires_at_unix_ms": {
            "$ref": "#/components/schemas/DecimalU64"
          },
          "nonce": {
            "$ref": "#/components/schemas/Hex16"
          }
        },
        "required": [
          "expires_at_unix_ms",
          "nonce"
        ],
        "description": "Expiry must be later than server time and within the configured retry window (24 hours in the current default profile). Generate a fresh random nonce for each new logical transaction; reuse both fields only for an exact retry."
      },
      "Observed": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "replica": {
            "$ref": "#/components/schemas/CanonicalUuid"
          },
          "incarnation": {
            "$ref": "#/components/schemas/Hex16"
          },
          "sequence": {
            "$ref": "#/components/schemas/PositiveDecimalU64"
          }
        },
        "required": [
          "replica",
          "incarnation",
          "sequence"
        ]
      },
      "NullValue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "null"
          }
        },
        "required": [
          "type"
        ]
      },
      "BooleanValue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "bool"
          },
          "value": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "IntegerValue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "i64"
          },
          "value": {
            "type": "string",
            "description": "Canonical signed i64 decimal string.",
            "pattern": "^(0|-?[1-9][0-9]*)$"
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "TextValue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "utf8"
          },
          "value": {
            "type": "string",
            "description": "UTF-8 text."
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "BytesValue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "bytes"
          },
          "value": {
            "type": "string",
            "description": "Unpadded canonical base64url bytes.",
            "pattern": "^[A-Za-z0-9_-]*$"
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "MapValue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "map"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Field"
            },
            "maxItems": 1024
          }
        },
        "required": [
          "type",
          "fields"
        ]
      },
      "ArrayValue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "array"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldValue"
            },
            "maxItems": 1024
          }
        },
        "required": [
          "type",
          "items"
        ]
      },
      "FieldValue": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/NullValue"
          },
          {
            "$ref": "#/components/schemas/BooleanValue"
          },
          {
            "$ref": "#/components/schemas/IntegerValue"
          },
          {
            "$ref": "#/components/schemas/TextValue"
          },
          {
            "$ref": "#/components/schemas/BytesValue"
          },
          {
            "$ref": "#/components/schemas/MapValue"
          },
          {
            "$ref": "#/components/schemas/ArrayValue"
          }
        ],
        "description": "Tagged document value. Nesting is limited to 16 levels and 4096 total value nodes."
      },
      "Field": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "uint32",
            "minimum": 1
          },
          "value": {
            "$ref": "#/components/schemas/FieldValue"
          }
        },
        "required": [
          "id",
          "value"
        ],
        "description": "Field IDs in each field array must be unique and strictly increasing."
      },
      "LiveWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "live"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Field"
            },
            "maxItems": 1024
          }
        },
        "required": [
          "kind",
          "fields"
        ]
      },
      "TombstoneWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "tombstone"
          }
        },
        "required": [
          "kind"
        ]
      },
      "WriteValue": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/LiveWrite"
          },
          {
            "$ref": "#/components/schemas/TombstoneWrite"
          }
        ]
      },
      "CommitRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "transaction_id": {
            "$ref": "#/components/schemas/TransactionId"
          },
          "writes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Write"
            },
            "minItems": 1,
            "maxItems": 1024
          },
          "authority": {
            "$ref": "#/components/schemas/MutationAuthority"
          },
          "effect_digest": {
            "$ref": "#/components/schemas/Hex32"
          }
        },
        "required": [
          "version",
          "transaction_id",
          "writes",
          "authority",
          "effect_digest"
        ],
        "description": "One atomic same-shard transaction, maximum 4 MiB raw JSON. SHA256 effect_digest uses TB-DOC-EFFECT-v1 normalized binary scope/authority/write grammar, excluding transaction_id. Exact retries preserve original committed and rejected outcomes until expiry; changed effects conflict before conditions are reevaluated."
      },
      "QueryBooleanValue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "bool"
          },
          "value": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "QueryIntegerValue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "i64"
          },
          "value": {
            "type": "string",
            "description": "Canonical signed i64 decimal string.",
            "pattern": "^(0|-?[1-9][0-9]*)$"
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "QueryTextValue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "utf8"
          },
          "value": {
            "type": "string",
            "description": "UTF-8 text bounded to 1 MiB of encoded value bytes and the 4 MiB request limit."
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "QueryBytesValue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "bytes"
          },
          "value": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]*$",
            "maxLength": 1398102
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "QueryValue": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/QueryBooleanValue"
          },
          {
            "$ref": "#/components/schemas/QueryIntegerValue"
          },
          {
            "$ref": "#/components/schemas/QueryTextValue"
          },
          {
            "$ref": "#/components/schemas/QueryBytesValue"
          }
        ]
      },
      "QueryValuePredicate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "equal",
              "less_than",
              "less_than_or_equal",
              "greater_than",
              "greater_than_or_equal"
            ]
          },
          "path": {
            "$ref": "#/components/schemas/QueryPath"
          },
          "value": {
            "$ref": "#/components/schemas/QueryValue"
          }
        },
        "required": [
          "op",
          "path",
          "value"
        ]
      },
      "QueryPresencePredicate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "is_null",
              "is_missing"
            ]
          },
          "path": {
            "$ref": "#/components/schemas/QueryPath"
          }
        },
        "required": [
          "op",
          "path"
        ]
      },
      "QueryPredicate": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/QueryValuePredicate"
          },
          {
            "$ref": "#/components/schemas/QueryPresencePredicate"
          }
        ]
      },
      "QueryRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "predicate": {
            "$ref": "#/components/schemas/QueryPredicate"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128
          },
          "cursor": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "version",
          "predicate",
          "limit"
        ],
        "description": "The body is limited to 4 MiB. Cursor tokens are opaque and valid for 60 seconds."
      },
      "QueryRow": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document": {
            "$ref": "#/components/schemas/CanonicalUuid"
          },
          "point": {
            "$ref": "#/components/schemas/PointResponse"
          }
        },
        "required": [
          "document",
          "point"
        ]
      },
      "QueryResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueryRow"
            },
            "maxItems": 128
          },
          "next_cursor": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "version",
          "rows"
        ],
        "description": "Rows are ordered by canonical document ID. Each point contains complete causal state, including all visible conflict siblings."
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "database": {
            "$ref": "#/components/schemas/CanonicalUuid"
          },
          "shard": {
            "$ref": "#/components/schemas/DecimalU64"
          },
          "replica": {
            "$ref": "#/components/schemas/CanonicalUuid"
          },
          "incarnation": {
            "$ref": "#/components/schemas/Hex16"
          },
          "sequence": {
            "$ref": "#/components/schemas/PositiveDecimalU64"
          }
        },
        "required": [
          "database",
          "shard",
          "replica",
          "incarnation",
          "sequence"
        ]
      },
      "SubscriptionPollRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "phase": {
            "const": "poll"
          },
          "predicate": {
            "$ref": "#/components/schemas/QueryPredicate"
          },
          "poll_cursor": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "version",
          "phase",
          "predicate",
          "poll_cursor"
        ]
      },
      "SubscriptionRequest": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/SubscriptionSnapshotRequest"
          },
          {
            "$ref": "#/components/schemas/SubscriptionPollRequest"
          }
        ]
      },
      "SubscriptionSnapshotPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "phase": {
            "const": "snapshot"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueryRow"
            },
            "maxItems": 128
          },
          "next_snapshot_cursor": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "version",
          "phase",
          "rows",
          "next_snapshot_cursor"
        ]
      },
      "SubscriptionSnapshotComplete": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "phase": {
            "const": "snapshot"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueryRow"
            },
            "maxItems": 128
          },
          "poll_cursor": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "version",
          "phase",
          "rows",
          "poll_cursor"
        ]
      },
      "SubscriptionGroup": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "$ref": "#/components/schemas/PositiveDecimalU64"
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubscriptionEffect"
            },
            "maxItems": 128
          }
        },
        "required": [
          "sequence",
          "effects"
        ]
      },
      "SubscriptionPollResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "phase": {
            "const": "poll"
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubscriptionGroup"
            },
            "maxItems": 8
          },
          "poll_cursor": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "version",
          "phase",
          "groups",
          "poll_cursor"
        ]
      },
      "SubscriptionResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/SubscriptionSnapshotPage"
          },
          {
            "$ref": "#/components/schemas/SubscriptionSnapshotComplete"
          },
          {
            "$ref": "#/components/schemas/SubscriptionPollResponse"
          }
        ]
      },
      "SubscriptionResyncError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "const": "resync_required"
              },
              "action": {
                "const": "start_snapshot"
              }
            },
            "required": [
              "code",
              "action"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "WriterIdentity": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "replica": {
            "$ref": "#/components/schemas/CanonicalUuid"
          },
          "incarnation": {
            "$ref": "#/components/schemas/Hex16"
          }
        },
        "required": [
          "replica",
          "incarnation"
        ]
      }
    }
  }
}
