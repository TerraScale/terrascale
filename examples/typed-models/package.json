{
  "name": "terrabase-typed-models",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x || 24.x",
    "npm": ">=11"
  },
  "scripts": {
    "generate": "terrascale-models schema.json Order models.ts",
    "check": "npm run generate && node verify-models.mjs && tsc --noEmit",
    "build": "npm run generate && tsc",
    "live": "npm run build && node dist/typed-models/live.js"
  },
  "dependencies": {
    "@terrascale/sdk": "0.0.13"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "@types/node": "26.0.0"
  }
}
