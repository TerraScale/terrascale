@inherits RazorSlice<TerraScale.Dashboard.Features.Organizations.OrganizationMemberModel>
@using TerraScale.Dashboard.Features.Organizations
<tr>
    <td><div class="ts-row ts-access-member"><span class="ts-avatar" aria-hidden="true">@(Model.Initials.Length > 0 ? Model.Initials : "?")</span><div class="ts-list-main"><span class="ts-strong ts-truncate">@Model.DisplayName</span><span class="ts-meta ts-truncate">@Model.Member.Email</span></div></div></td>
    <td><code class="ts-meta">@Model.Member.UserId</code></td><td><span class="ts-badge ts-badge-neutral"><span class="ts-dot" aria-hidden="true"></span>@(Model.Member.Role == "owner" ? "Organization Owner" : OrganizationPage.RoleLabel(Model.Member.Role))</span></td>
    <td class="ts-meta ts-access-date">@(Model.Member.CreatedAt != DateTimeOffset.MinValue ? Model.Member.CreatedAt.UtcDateTime.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture) : Model.Member.JoinedOn?.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "Not reported")</td>
    <td class="ts-table-actions">
    @if (Model.CanEdit)
    {
        <div class="ts-row ts-row-end"><form class="ts-row" method="post" action="@("/api/v1/access/members/" + Uri.EscapeDataString(Model.Member.UserId) + "/role?tab=members")"><input type="hidden" name="_csrf" value="@Model.Page.Shell.CsrfToken" /><label class="ts-sr-only" for="role-@Model.Member.UserId">Role for @Model.DisplayName</label><select class="ts-select ts-input-sm ts-access-role" id="role-@Model.Member.UserId" name="role" required>@if (Model.Member.Role is not ("viewer" or "member" or "admin")) { <option value="" selected disabled>@OrganizationPage.RoleLabel(Model.Member.Role)</option> }<option value="viewer" selected="@(Model.Member.Role == "viewer" ? "selected" : null)">Viewer</option><option value="member" selected="@(Model.Member.Role == "member" ? "selected" : null)">Member</option><option value="admin" selected="@(Model.Member.Role == "admin" ? "selected" : null)">Admin</option></select><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Save role</button></form>
        <button class="ts-btn ts-btn-danger ts-btn-sm" type="button" command="show-modal" commandfor="remove-member-@Model.Member.UserId">Remove access</button>
        <dialog class="ts-dialog" id="remove-member-@Model.Member.UserId" closedby="any" aria-labelledby="remove-member-@Model.Member.UserId-title"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="remove-member-@Model.Member.UserId-title">Remove @Model.DisplayName?</h2><p class="ts-dialog-description">@Model.Member.Email loses user access to this organization and its projects, and their dashboard sessions are revoked.</p><p class="ts-dialog-description">Organization and project service keys remain active. <a class="ts-link" href="/api-keys">Rotate or revoke any keys known to them</a>.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="remove-member-@Model.Member.UserId">@Icons.Render("X", 18)</button></header><form method="post" action="@("/api/v1/access/members/" + Uri.EscapeDataString(Model.Member.UserId) + "/revoke?tab=members")"><input type="hidden" name="_csrf" value="@Model.Page.Shell.CsrfToken" /><div class="ts-dialog-footer"><button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="remove-member-@Model.Member.UserId">Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Remove access</button></div></form></div></dialog></div>
    }
    else if (Model.Member.UserId == Model.Page.Shell.Context.UserId) { <span class="ts-meta">You</span> }
    else { <span class="ts-meta">@(Model.Member.Role == "owner" ? "Owner" : "—")</span> }
    </td>
</tr>
