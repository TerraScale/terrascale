@inherits RazorSlice<TerraScale.Dashboard.Features.Organizations.OrganizationPage>
@using TerraScale.Dashboard.Features.Organizations
<section class="ts-card ts-card-boxed @(Model.MemberRows.Count > 0 ? "ts-card-flush" : "")" id="team-members" aria-labelledby="team-members-title">
    <header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="team-members-title">Organization members <span class="ts-tab-count">@Model.MemberTotal</span></h2><p class="ts-card-description">Users returned by the TerraScale Dashboard API</p></div></header><div class="ts-card-body">
    @if (Model.MemberTotal == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No members returned</p><p class="ts-empty-detail">The API did not return organization members for this account.</p></div> }
    else if (Model.MemberRows.Count == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No members match</p><p class="ts-empty-detail">Adjust the search or role filter to see another organization member.</p>@if (Model.Filter.Query.Length > 0 || Model.Filter.Role != "all") { <div class="ts-empty-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="/organization?tab=members">Clear filters</a></div> }</div> }
    else
    {
        <div class="ts-table-wrap" tabindex="0" role="region" aria-label="Organization members table"><table class="ts-table"><thead><tr><th>Member</th><th>User ID</th><th>Organization role</th><th>Joined</th><th class="ts-table-actions">Actions</th></tr></thead><tbody>@foreach (var member in Model.MemberRows) { @(await RenderPartialAsync<TerraScale.Dashboard.Features.Organizations.Members.OrganizationMemberRow, OrganizationMemberModel>(new(Model, member))) }</tbody></table></div>
        @if (Model.MemberPages > 1) { <nav class="ts-pager" aria-label="Member pages"><span>Showing @((Model.MemberPage - 1) * 10 + 1)–@Math.Min(Model.MemberPage * 10, Model.MatchingMembers.Count) of @Model.MatchingMembers.Count</span><div class="ts-row">@if (Model.MemberPage > 1) { <a class="ts-btn ts-btn-secondary ts-btn-sm" href="@Model.MemberUrl(Model.MemberPage - 1)" rel="prev">Previous</a> }@if (Model.MemberPage < Model.MemberPages) { <a class="ts-btn ts-btn-secondary ts-btn-sm" href="@Model.MemberUrl(Model.MemberPage + 1)" rel="next">Next</a> }</div></nav> }
    }
    </div>
</section>
<div class="@(Model.CanManage ? "ts-access-bottom" : "ts-stack")">
<section class="ts-card ts-card-boxed @(Model.InvitationRows.Count > 0 ? "ts-card-flush" : "")" id="team-invitations" aria-labelledby="team-invitations-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="team-invitations-title">Invitations <span class="ts-tab-count">@Model.InvitationRows.Count</span></h2><p class="ts-card-description">Every invitation created for this organization.</p></div></header><div class="ts-card-body">
    @if (Model.InvitationRows.Count == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No invitations have been created.</p><p class="ts-empty-detail">Invite a teammate by email to give them access to this organization.</p></div> }
    else
    {
        <div class="ts-table-wrap" tabindex="0" role="region" aria-label="Organization invitations table"><table class="ts-table"><thead><tr><th>Email</th><th>Role</th><th>Status</th><th>Expires</th><th class="ts-table-actions">Actions</th></tr></thead><tbody>@foreach (var invitation in Model.InvitationPageRows)
        {
            <tr><td class="ts-strong">@invitation.Email</td><td>@OrganizationPage.RoleLabel(invitation.Role)</td><td><span class="ts-badge ts-badge-tone" data-tone="@OrganizationPage.InvitationTone(invitation.Status)"><span class="ts-dot" aria-hidden="true"></span>@OrganizationPage.RoleLabel(invitation.Status)</span></td><td class="ts-meta ts-access-date">@(invitation.ExpiresAt == DateTimeOffset.MinValue ? "No expiry" : invitation.ExpiresAt.UtcDateTime.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture))</td><td class="ts-table-actions">@if (invitation.Open && Model.CanManage) { <div class="ts-row ts-row-end"><form method="post" action="@("/api/v1/access/invitations/" + Uri.EscapeDataString(invitation.Id) + "/resend?tab=invitations")"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Resend</button></form><form method="post" action="@("/api/v1/access/invitations/" + Uri.EscapeDataString(invitation.Id) + "/revoke?tab=invitations")"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><button class="ts-btn ts-btn-danger ts-btn-sm" type="submit">Cancel</button></form></div> } else { <span class="ts-meta">—</span> }</td></tr>
        }</tbody></table></div>
        @if (Model.InvitationPages > 1) { <nav class="ts-pager" aria-label="Invitation pages"><span>Showing @((Model.InvitationPage - 1) * 10 + 1)–@Math.Min(Model.InvitationPage * 10, Model.InvitationRows.Count) of @Model.InvitationRows.Count</span><div class="ts-row">@if (Model.InvitationPage > 1) { <a class="ts-btn ts-btn-secondary ts-btn-sm" href="@Model.InvitationUrl(Model.InvitationPage - 1)" rel="prev">Previous</a> }@if (Model.InvitationPage < Model.InvitationPages) { <a class="ts-btn ts-btn-secondary ts-btn-sm" href="@Model.InvitationUrl(Model.InvitationPage + 1)" rel="next">Next</a> }</div></nav> }
    }
</div></section>

@if (Model.CanManage)
{
    <section class="ts-card ts-card-boxed" id="team-invite" aria-labelledby="team-invite-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="team-invite-title">Invite a teammate</h2><p class="ts-card-description">Links expire after seven days and can be refreshed by an owner or admin.</p></div></header><div class="ts-card-body"><form class="ts-access-invite" method="post" action="/api/v1/access/invitations?tab=invitations"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><div class="ts-field"><label class="ts-label" for="invite-email">Email address</label><input class="ts-input" id="invite-email" name="email" type="email" autocomplete="email" placeholder="teammate@example.com" required /></div><div class="ts-field"><label class="ts-label" for="invite-role">Role</label><select class="ts-select" id="invite-role" name="role"><option value="member">Member</option><option value="viewer">Viewer</option><option value="admin">Admin</option></select></div><button class="ts-btn ts-btn-primary" type="submit">Create invitation</button></form></div></section>
}
</div>
