@inherits RazorSlice<TerraScale.Dashboard.Features.Organizations.OrganizationPage>
@if (Model.Shell.Context.Organization is { Kind: "business" } org)
{
    @if (Model.Shell.Context.Role != "owner")
    {
        <button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" command="show-modal" commandfor="leave-organization">@Icons.Render("LogOut", 14)<span>Leave organization</span></button><dialog id="leave-organization" class="ts-dialog" closedby="any" aria-labelledby="leave-organization-title"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="leave-organization-title">Leave @org.Name?</h2><p class="ts-dialog-description">You lose access to its projects and data right away. To come back, an owner or admin has to invite you again.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="leave-organization">@Icons.Render("X", 18)</button></header><form method="post" action="/api/v1/dashboard/organization/leave"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><div class="ts-dialog-footer"><button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="leave-organization">Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Leave organization</button></div></form></div></dialog>
    }
    else
    {
        <div class="ts-card-section"><button class="ts-btn ts-btn-danger ts-btn-sm" type="button" command="show-modal" commandfor="delete-organization">@Icons.Render("Trash2", 14)<span>Organization deletion</span></button></div><dialog id="delete-organization" class="ts-dialog" closedby="any" aria-labelledby="delete-organization-title"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="delete-organization-title">Delete organization</h2><p class="ts-dialog-description">Deletes the organization, its projects, members and invitations, and ends its paid plan now. Delete its databases first.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="delete-organization">@Icons.Render("X", 18)</button></header><form method="post" action="/api/v1/dashboard/organization/deletion" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><div class="ts-field"><label class="ts-label" for="deletion-confirmation">Enter “@org.Name” to confirm</label><input class="ts-input" id="deletion-confirmation" name="confirmation" autocomplete="off" required /></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="delete-organization">Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Delete organization</button></div></form></div></dialog>
    }
}
