@inherits RazorSlice<TerraScale.Dashboard.Features.Organizations.Projects.ProjectGrantPage>
@implements IUsesLayout<TerraScale.Dashboard.Shared.UI.Slices.ShellDocument, ShellModel>
<main class="ts-page" aria-labelledby="project-grants-title" data-signals="{_grantPending: false}" data-on:submit="!evt.defaultPrevented &amp;&amp; ($_grantPending = true)" data-on:pageshow__window="$_grantPending = false" data-on:keydown__window="evt.key === 'Escape' &amp;&amp; ($_grantPending = false)">
    <header class="ts-page-header"><h1 id="project-grants-title">Explicit project grants</h1><p>@Model.Shell.Context.Project!.Name</p><a class="ts-link" href="@(WorkspaceUrl.For(Model.Shell.Context, "/project", replace: true))">Project settings</a></header>
    <p>This list contains explicit grants for the selected project only. Organization-implied access is not listed. Your effective project role is @Model.Shell.Context.Project.Role.</p>
    <p>Removing an explicit grant preserves organization-implied access and independent service keys. It does not promise total access revocation.</p>
    @if (Model.Status.Length > 0) { <p class="ts-alert ts-alert-success" role="status">@Model.Status</p> }
    @if (Model.CanManageGrants)
    {
        <form class="ts-form" method="post" action="@Model.PostUrl" data-submit-once data-attr:aria-busy="$_grantPending ? 'true' : 'false'">
            <input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
            <label class="ts-label" for="grant-user-id">Existing organization member user ID</label><input class="ts-input" id="grant-user-id" name="userId" value="@Model.DraftUserId" required minlength="26" maxlength="26" aria-describedby="grant-target-help" />
            <p class="ts-hint" id="grant-target-help">Enter the canonical user ULID, not an email. New grants require an existing organization member; existing collaborator grants can be changed. Project invitations are not available here.</p>
            <label class="ts-label" for="grant-role">Explicit project role</label><select class="ts-select" id="grant-role" name="role">
                @if (Model.DraftRole is not ("viewer" or "member" or "admin")) { <option value="@Model.DraftRole" selected>Choose a valid role (@Model.DraftRole)</option> }
                @foreach (var role in new[] { "viewer", "member", "admin" }) { <option value="@role" selected="@(role == Model.DraftRole ? "selected" : null)">@role</option> }
            </select>
            <button class="ts-btn ts-btn-primary" type="submit" name="operation" value="set">Grant or change explicit role</button>
            <p role="status" aria-live="polite" data-text="$_grantPending ? 'Updating explicit project grant…' : ''"></p>
        </form>
    }
    @if (Model.Error.Length > 0) { <p class="ts-alert ts-alert-danger" role="alert">@Model.Error <a class="ts-link" href="@Model.Url">Open the first page</a></p> }
    else if (Model.Grants.Count == 0) { <p class="ts-empty" role="status">No explicit project grants on this page. Organization-implied access may still apply.</p> }
    else
    {
        <div class="ts-table-wrap" tabindex="0" role="region" aria-label="Explicit project grants"><table class="ts-table"><thead><tr><th>User ID</th><th>Email</th><th>Explicit role</th>@if (Model.CanManageGrants) { <th>Actions</th> }</tr></thead><tbody>
        @foreach (var grant in Model.Grants)
        {
            <tr data-project-grant-user="@grant.UserId"><td class="ts-mono">@grant.UserId</td><td>@grant.Email</td><td>@grant.Role</td>
            @if (Model.CanManageGrants)
            {
                <td><button class="ts-btn ts-btn-secondary" type="button" command="show-modal" commandfor="edit-grant-@grant.UserId">Change role</button><button class="ts-btn ts-btn-secondary" type="button" command="show-modal" commandfor="remove-grant-@grant.UserId">Remove explicit grant</button>
                    <dialog class="ts-dialog" id="edit-grant-@grant.UserId" aria-labelledby="edit-grant-title-@grant.UserId" closedby="any"><div class="ts-dialog-content">
                        <h2 id="edit-grant-title-@grant.UserId">Change explicit project role</h2><p>@grant.Email</p>
                        <form method="post" action="@Model.PostUrl" data-submit-once data-attr:aria-busy="$_grantPending ? 'true' : 'false'"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="userId" value="@grant.UserId" />
                            <label class="ts-label" for="edit-grant-role-@grant.UserId">Explicit role for @grant.Email</label><select class="ts-select" id="edit-grant-role-@grant.UserId" name="role">@foreach (var role in new[] { "viewer", "member", "admin" }) { <option value="@role" selected="@(role == grant.Role ? "selected" : null)">@role</option> }</select>
                            <button class="ts-btn ts-btn-primary" type="submit" name="operation" value="set">Save role</button><button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="edit-grant-@grant.UserId">Cancel</button>
                            <p role="status" aria-live="polite" data-text="$_grantPending ? 'Saving explicit project role…' : ''"></p>
                        </form>
                    </div></dialog>
                    <dialog class="ts-dialog" id="remove-grant-@grant.UserId" aria-labelledby="remove-grant-title-@grant.UserId" closedby="any"><div class="ts-dialog-content">
                        <h2 id="remove-grant-title-@grant.UserId">Remove explicit grant?</h2><p>@grant.Email · @grant.UserId · @grant.Role</p>
                        <p>Organization-implied access and independent service keys remain. Removing your last project grant may remove your access to this project.</p>
                        <form method="post" action="@Model.PostUrl" data-submit-once data-attr:aria-busy="$_grantPending ? 'true' : 'false'"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="userId" value="@grant.UserId" /><button class="ts-btn ts-btn-danger" type="submit" name="operation" value="remove">Remove only this grant</button><button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="remove-grant-@grant.UserId">Cancel</button></form>
                        <p role="status" aria-live="polite" data-text="$_grantPending ? 'Removing explicit project grant…' : ''"></p>
                    </div></dialog>
                </td>
            }
            </tr>
        }
        </tbody></table></div>
    }
    <nav aria-label="Project grant pages">
        @if (Model.HasPrevious) { <a class="ts-link" href="@Model.Url">First page</a> }
        @if (Model.Next is not null) { <a class="ts-link" rel="next" href="@(Model.Url + "&after=" + Uri.EscapeDataString(Model.Next))">Next page</a> }
    </nav>
</main>
@functions {
    public ShellModel LayoutModel => Model.Shell;
}
