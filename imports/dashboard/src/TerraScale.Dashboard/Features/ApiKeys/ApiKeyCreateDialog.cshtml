@inherits RazorSlice<TerraScale.Dashboard.Features.ApiKeys.ApiKeysPage>
@{ var kind = Model.DialogKind; var access = Model.AccessFor(kind); var dialog = "create-" + kind; }
<dialog id="@dialog" class="ts-dialog ts-credential-dialog" closedby="any" aria-labelledby="@(dialog + "-title")" aria-describedby="@(dialog + "-description")" data-init="@(Model.Create == kind ? "el.showModal()" : "void 0")"><div class="ts-dialog-content">
<header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@(dialog + "-title")">New project key</h2><p class="ts-dialog-description" id="@(dialog + "-description")">Project keys authenticate applications and services (client_credentials) to this project's databases.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@dialog">@Icons.Render("X", 18)</button></header>
<form method="post" data-submit-once action="@Model.With("/api/v1/dashboard/credentials/" + kind)" class="ts-form ts-credential-form" data-signals="@Model.PermissionSignals(kind)"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />@if (Model.Error.Length > 0 && Model.Create == kind) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
<div class="ts-form-grid"><div class="ts-field"><label class="ts-label" for="@(kind + "-name")">Credential name</label><input class="ts-input" id="@(kind + "-name")" name="name" value="@(Model.Create == kind ? Model.Name : "")" placeholder="e.g. production-api" maxlength="128" aria-describedby="@(kind + "-name-hint")" required /><p class="ts-hint" id="@(kind + "-name-hint")">A name to recognize this credential later.</p></div><div class="ts-field"><label class="ts-label" for="@(kind + "-database")">Database access</label><select class="ts-select" id="@(kind + "-database")" name="databaseId" aria-describedby="@(kind + "-database-hint")" data-on:change="@("$_" + kind + "Database = el.selectedOptions[0].textContent")"><option value="">All project databases (current and future)</option>@if (Model.Context.Project is not null) { @foreach (var database in Model.Context.Project.Databases.Values.OrderBy(database => database.Name)) { <option value="@database.Id" selected="@(Model.Create == kind && Model.DraftDatabaseId == database.Id)">@database.Name</option> } }</select><p class="ts-hint" id="@(kind + "-database-hint")">Limit access to the database this app needs.</p></div><div class="ts-field"><label class="ts-label" for="@(kind + "-expiry")">Expiration</label><select class="ts-select" id="@(kind + "-expiry")" name="expiresInDays" aria-describedby="@(kind + "-expiry-hint")">@foreach (var option in new[] { (Days: "0", Label: "No expiry"), (Days: "30", Label: "30 days"), (Days: "90", Label: "90 days"), (Days: "365", Label: "1 year") }) { <option value="@option.Days" selected="@(Model.Create == kind && Model.DraftExpiresInDays == option.Days)">@option.Label</option> }</select><p class="ts-hint" id="@(kind + "-expiry-hint")">The key works until it expires or you revoke it.</p></div><div class="ts-field"><label class="ts-label" for="@(kind + "-cidrs")">Allowed IPs (CIDR)</label><textarea class="ts-input ts-mono" id="@(kind + "-cidrs")" name="allowedCidrs" rows="3" spellcheck="false" autocomplete="off" placeholder="203.0.113.0/24" aria-describedby="@(kind + "-cidrs-hint")">@(Model.Create == kind ? Model.DraftAllowedCidrs : "")</textarea><p class="ts-hint" id="@(kind + "-cidrs-hint")">One per line or comma separated, up to 32. Leave empty to allow any IP.</p></div></div>
<fieldset class="ts-permissions" aria-describedby="@(kind + "-permissions-hint")"><legend class="ts-label">Database permissions</legend><p class="ts-hint" id="@(kind + "-permissions-hint")">Choose the minimum access your application needs.</p><div class="ts-permission-options">
@foreach (var option in new[] { (Id: "read", Label: "Read only", Description: "Read and query records. Cannot change or delete data.", Scopes: "documents:read", Recommended: true), (Id: "write", Label: "Read and write", Description: "Read, create, update, and delete records. Use for apps that change data.", Scopes: "documents:read,documents:write", Recommended: false) }) {
var id = kind + "-access-" + option.Id;
<label class="ts-permission-option" for="@id"><input type="radio" id="@id" name="scopes" value="@option.Scopes" checked="@(access == option.Scopes)" required data-bind="@("_" + kind + "Access")" aria-labelledby="@(id + "-label")" aria-describedby="@(id + "-description")" /><span class="ts-field ts-permission-body"><span class="ts-row">@Icons.Render(option.Recommended ? "Eye" : "Pencil", 18)<strong id="@(id + "-label")">@option.Label</strong></span>@if (option.Recommended) { <span class="ts-hint">Recommended</span> }<span class="ts-meta ts-muted" id="@(id + "-description")">@option.Description</span><span class="ts-row ts-apikeys-scopes">@foreach (var scope in option.Scopes.Split(',')) { <code>@scope</code> }</span></span></label>
}
</div><details class="ts-permission-advanced" open="@(access is "documents:write" or TerraScale.Dashboard.Features.ApiKeys.ApiKeysPage.Full)"><summary class="ts-meta ts-muted">More access options</summary><label class="ts-permission-option" for="@(kind + "-access-write-only")"><input type="radio" id="@(kind + "-access-write-only")" name="scopes" value="documents:write" checked="@(access == "documents:write")" required data-bind="@("_" + kind + "Access")" aria-labelledby="@(kind + "-access-write-only-label")" aria-describedby="@(kind + "-access-write-only-description")" /><span class="ts-field ts-permission-body"><span class="ts-row">@Icons.Render("Pencil", 18)<strong id="@(kind + "-access-write-only-label")">Write only</strong></span><span class="ts-meta ts-muted" id="@(kind + "-access-write-only-description")">Create, update, and delete records without reading them. For ingestion services.</span><span class="ts-row ts-apikeys-scopes"><code>documents:write</code></span></span></label><label class="ts-permission-option" for="@(kind + "-access-full")"><input type="radio" id="@(kind + "-access-full")" name="scopes" value="@TerraScale.Dashboard.Features.ApiKeys.ApiKeysPage.Full" checked="@(access == TerraScale.Dashboard.Features.ApiKeys.ApiKeysPage.Full)" required data-bind="@("_" + kind + "Access")" aria-labelledby="@(kind + "-access-full-label")" aria-describedby="@(kind + "-access-full-description")" /><span class="ts-field ts-permission-body"><span class="ts-row">@Icons.Render("ShieldAlert", 18)<strong id="@(kind + "-access-full-label")">Full access</strong></span><span class="ts-meta ts-muted" id="@(kind + "-access-full-description")">Read and write records, and create and delete databases and indexes. For seed and migration scripts.</span><span class="ts-row ts-apikeys-scopes">@foreach (var scope in TerraScale.Dashboard.Features.ApiKeys.ApiKeysPage.Full.Split(',')) { <code>@scope</code> }</span></span></label></details></fieldset>
<section class="ts-permission-review" aria-label="Authorization summary" aria-live="polite" aria-atomic="true">@Icons.Render("ShieldCheck", 20)<div class="ts-field"><h3 class="ts-hint ts-muted">Access summary</h3><p class="ts-strong" data-text="@("$_" + kind + "Database")">@Model.DraftDatabaseFor(kind)</p><p class="ts-hint" data-text="@TerraScale.Dashboard.Features.ApiKeys.ApiKeysPage.PermissionSummary(kind)">@TerraScale.Dashboard.Features.ApiKeys.ApiKeysPage.Summary(access)</p></div></section>
<div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="@dialog">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">@(kind == "key" ? "Create key" : "Create client")</button></div>
</form></div></dialog>
