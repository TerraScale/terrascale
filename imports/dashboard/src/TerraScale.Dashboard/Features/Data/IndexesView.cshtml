@inherits RazorSlice<TerraScale.Dashboard.Features.Data.DataPage>
@{ var indexes = Model.Indexes?.Where(index => index.Collection == Model.Collection).ToArray() ?? []; }
<div class="ts-data-bar"><form class="ts-filters ts-data-scope" method="get" action="@DatabaseService.Path(Model.Database.Id,"indexes")" aria-label="Choose collection"><label class="ts-data-collection" for="collection"><span class="ts-sr-only">Collection</span><input class="ts-input ts-input-sm ts-mono" id="collection" name="collection" value="@Model.Collection" placeholder="Collection" required /></label><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Open</button></form></div>
<section class="ts-card" id="collection-indexes" aria-labelledby="collection-indexes-title">
<header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="collection-indexes-title">Collection indexes</h2><p class="ts-card-description">Secondary indexes on @Model.Collection.</p></div></header><div class="ts-card-body">
@if(Model.Error.Length == 0 && indexes.Length == 0){<div class="ts-empty" role="status"><p class="ts-empty-title">No indexes on @Model.Collection.</p><p class="ts-empty-detail">Create an index for fields used in queries.</p></div>}
else if(indexes.Length > 0){<div class="ts-table-wrap"><table class="ts-table"><thead><tr><th scope="col">Name</th><th scope="col">Fields</th><th scope="col">State</th><th scope="col"><span class="ts-sr-only">Actions</span></th></tr></thead><tbody>
@for(var i = 0; i < indexes.Length; i++){var index = indexes[i];
<tr><td class="ts-mono ts-break">@index.Name</td><td>@string.Join(", ",index.Fields)</td><td>@index.State</td><td>@if(Model.Context.CanManage){<button class="ts-btn ts-btn-danger ts-btn-sm" type="button" command="show-modal" commandfor="@("drop-index-"+i)" aria-label="@("Drop "+index.Name)">Drop</button>}</td></tr>
}</tbody></table></div>}
@if(Model.Context.CanManage && Model.Collection.Length > 0){
<div class="ts-card-section"><form method="post" action="/api/v1/dashboard/indexes" class="ts-filters ts-data-index-form" data-submit-once><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="collection" value="@Model.Collection" /><label class="ts-filter-field ts-data-grow" for="index-field">Fields<input class="ts-input" id="index-field" name="field" maxlength="515" value="@Model.QueryName" aria-describedby="index-fields-hint" required /></label><p class="ts-hint" id="index-fields-hint">Enter one to four comma-separated dotted field paths, up to 128 characters each.</p><button class="ts-btn ts-btn-primary ts-btn-sm" type="submit">Create index</button></form></div>
}</div></section>
@if(Model.Context.CanManage){
@for(var i = 0; i < indexes.Length; i++){var index = indexes[i];var dialog = "drop-index-"+i;
<dialog id="@dialog" class="ts-dialog" closedby="any" aria-labelledby="@(dialog+"-title")" aria-describedby="@(dialog+"-description")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@(dialog+"-title")">Drop @index.Name?</h2><p class="ts-dialog-description" id="@(dialog+"-description")">Queries on @Model.Collection that use this index may become slower or fail until an appropriate index is created. Documents stay in the collection.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@dialog">@Icons.Render("X",18)</button></header>
<form method="post" action="/api/v1/dashboard/indexes/delete" class="ts-form" data-submit-once><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="collection" value="@Model.Collection" /><input type="hidden" name="name" value="@index.Name" /><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="@dialog" autofocus>Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Drop index</button></div></form></div></dialog>
}}
