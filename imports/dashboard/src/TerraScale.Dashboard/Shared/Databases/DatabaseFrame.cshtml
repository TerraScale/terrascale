@inherits RazorSlice<TerraScale.Dashboard.Shared.Databases.DatabaseFrameModel>
@using TerraScale.Dashboard.Features.Databases
@inject AssetUrls Assets
<header class="ts-db-head"><nav class="ts-breadcrumb" aria-label="Breadcrumb"><a href="/databases">Databases</a><span aria-hidden="true">/</span><span aria-current="page">@Model.Database.Name</span></nav><div class="ts-db-identity"><span class="ts-db-icon" aria-hidden="true">@Icons.Render("Database",24)</span><h1 class="ts-db-title">@Model.Database.Name</h1><span class="ts-badge ts-badge-tone" data-tone="@DatabasesPage.Tone(Model.Database.Status)"><span class="ts-dot" aria-hidden="true"></span>@Model.Database.Status</span>@if(Model.Database.AllRegions){<span class="ts-badge ts-badge-info">All regions</span>}<span class="ts-db-chips">@foreach(var region in (Model.Serving ?? DatabaseService.Regions(Model.Database)).OrderBy(Regions.Rank)){var label = region.ToLowerInvariant();var country = Regions.Country(label);<span class="ts-db-region" data-region="@label" title="@DatabasesPage.RegionDisplay(region)">@if(country.Length > 0){<img class="ts-db-region-flag" src="@Assets.Url("flags/" + country + ".svg")" alt="" aria-hidden="true" />}<span class="ts-mono">@label</span></span>}</span></div></header>
<nav class="ts-tabs ts-db-tabs" aria-label="Database sections">@foreach(var tab in DatabaseFrameModel.Tabs){<a class="ts-tab" data-kind="@(tab.Key == "danger" ? "danger" : null)" href="@DatabaseService.Path(Model.Database.Id, tab.Key, tab.Key is "documents" or "sql" or "schema" or "indexes" or "webhooks" ? Model.Collection : "")" aria-current="@(Model.Tab == tab.Key ? "page" : null)"><span>@tab.Label</span></a>}</nav>
@if(Model.Database.ConflictOf is not null && Model.Database.PreviousName is { } previousName){<div class="ts-alert ts-alert-warning" id="database-name-conflict" role="status"><p class="ts-alert-title">Renamed after a name conflict</p><p class="ts-alert-body">The name <strong>@previousName</strong> was claimed concurrently in another region. This database is now <strong>@Model.Database.Name</strong>. Its ID, data, files, backups and keys are preserved. Update name-based connection strings, or choose another name in Settings.</p></div>}
