@inherits RazorSlice<ShellModel>
<button id="ts-notifications-menu" class="ts-menu-item" type="button" data-tone="amber" aria-label="@Model.NotificationsLabel" command="show-modal" commandfor="ts-notifications-dialog" data-on:click="(document.getElementById('ts-notifications-dialog').dataset.returnFocusSelector = 'details.ts-account summary', el.closest('details').open = false, @@get('/notifications/dialog', {retryMaxCount: 0}))">@ShellIcons.Svg("bell", 15)<span class="ts-menu-label">Notifications</span>@if (Model.Unread > 0) { <span class="ts-nav-count" aria-hidden="true">@ShellModel.Count(Model.Unread)</span> }</button>
