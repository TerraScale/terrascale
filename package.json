{
  "name": "terrascale-landing-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node --test scripts/*.test.mjs && vite build && node ./scripts/inline-prerendered-css.mjs && node ./scripts/write-build-info.mjs && node ./scripts/check-static-build.mjs",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "cf:dev": "npm run build && wrangler dev",
    "prepare": "svelte-kit sync",
    "icons:sync": "node ./scripts/icons-sync.mjs",
    "world-map:sync": "node ./scripts/world-map-sync.mjs",
    "preview": "vite preview"
  },
  "overrides": {
    "browserslist": "4.28.7",
    "nanoid": "3.3.18",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.5.2",
    "autoprefixer": "^10.4.27",
    "dotted-map": "^3.1.0",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "8.3.5",
    "wrangler": "4.131.2"
  }
}
