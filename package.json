{
  "name": "@terrascale/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for TerraScale public REST APIs.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal/dashboard": {
      "types": "./dist/internal/dashboard.d.ts",
      "import": "./dist/internal/dashboard.js"
    }
  },
  "files": [
    "dist",
    "!dist/integration",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js dist/integration/*.test.js",
    "test:integration": "node --test dist/integration/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.18.0"
}
