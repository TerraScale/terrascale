{
  "name": "@terrascale/sdk",
  "version": "0.0.18",
  "description": "JavaScript SDK, typed with JSDoc, for project-scoped C# TerraBase v1 and hosted TerraScale identity.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerraScale/ts-js.git"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./admin": {
      "types": "./types/admin.d.ts",
      "import": "./src/admin.js"
    },
    "./management": {
      "types": "./types/management.d.ts",
      "import": "./src/management.js"
    },
    "./ts-auth": {
      "types": "./types/ts-auth.d.ts",
      "import": "./src/ts-auth.js"
    },
    "./react": {
      "types": "./types/react/index.d.ts",
      "import": "./src/react/index.js"
    },
    "./svelte": {
      "types": "./types/svelte/index.d.ts",
      "import": "./src/svelte/index.js"
    },
    "./codegen": {
      "types": "./types/codegen.d.ts",
      "browser": null,
      "node": "./src/codegen.js"
    }
  },
  "bin": {
    "terrascale-models": "./src/codegen-cli.js"
  },
  "files": [
    "src",
    "!src/integration",
    "!src/**/*.test.js",
    "types",
    "!types/integration",
    "sdk-v1-route-manifest.json",
    "sdk-public-v1-route-manifest.json",
    "sdk-file-storage-route-manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('types', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check:v1-route-manifest": "node scripts/generate-v1-route-manifest.js --check",
    "check:forbidden-surface": "vitest run test/forbidden-surface.test.js",
    "check:sbom": "node scripts/check-sbom.js",
    "check:vulnerabilities": "node scripts/check-vulnerabilities.js",
    "generate:v1-route-manifest": "node scripts/generate-v1-route-manifest.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:browser": "playwright test",
    "qualify:auth-authority": "node scripts/qualify-auth-authority.js",
    "check:frameworks": "vitest run src/react/core.test.js src/svelte/index.test.js"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20.0.0",
    "json-schema-to-typescript": "16.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "json-schema-to-typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "svelte": "5.57.2",
    "react": "19.2.8",
    "react-test-renderer": "19.2.8",
    "@types/react": "19.2.14",
    "@types/react-test-renderer": "19.1.0",
    "json-schema-to-typescript": "16.0.0"
  },
  "engines": {
    "node": "22.x || 24.x",
    "npm": ">=11.0.0"
  },
  "browserslist": {
    "production": [
      "last 1 Chrome major version",
      "last 1 Firefox major version",
      "last 1 Safari major version",
      "last 1 Edge major version"
    ]
  },
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "ulid": "3.0.2"
  },
  "overrides": {
    "vite": "8.2.4"
  }
}
