{
  "name": "@terrascale/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for TerraScale public REST APIs.",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth.d.ts",
      "node": "./dist/better-auth.js"
    }
  },
  "files": [
    "dist",
    "!dist/integration",
    "!dist/internal",
    "!dist/**/*.test.*",
    "!dist/**/*capture*",
    "!dist/**/*.map",
    "sdk-route-manifest.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "qualify:artifact": "node scripts/qualify-npm-artifact.mjs",
    "generate:route-manifest": "npm run build && node scripts/generate-client-route-manifest.mjs",
    "generate:openapi-contract-descriptor": "npm run build && node scripts/generate-openapi-contract-descriptor.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "22.x || 24.x",
    "npm": ">=11.0.0"
  },
  "browserslist": {
    "production": [
      "last 1 Chrome major version",
      "last 1 Firefox major version",
      "last 1 Safari major version",
      "last 1 Edge major version"
    ]
  },
  "packageManager": "npm@11.18.0"
}
