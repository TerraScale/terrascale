{
  "name": "terrascale-landing-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node ./scripts/inline-prerendered-css.mjs && node ./scripts/validate-links.mjs",
    "candidate:stage": "node ./scripts/stage-pages-candidate.mjs",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "cf:project:create": "node ./scripts/cloudflare-pages-project-create.mjs",
    "cf:pages:dev": "npm run build && wrangler pages dev",
    "cf:deploy": "node ./scripts/cloudflare-pages-deploy.mjs --production",
    "cf:deploy:preview": "node ./scripts/cloudflare-pages-deploy.mjs --preview",
    "cf:pages:verify": "node ./scripts/cloudflare-pages-verify.mjs",
    "prepare": "svelte-kit sync",
    "check": "node scripts/validate-content.mjs && node scripts/validate-redirect-contract.mjs && node scripts/validate-claims.mjs && node --test scripts/cloudflare-pages-deploy.test.mjs tests/validator-contracts.test.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json && npm run build && node scripts/validate-claims.mjs --rendered",
    "icons:sync": "node ./scripts/icons-sync.mjs",
    "world-map:sync": "node ./scripts/world-map-sync.mjs",
    "lint": "eslint .",
    "test:deploy": "node --test scripts/cloudflare-pages-deploy.test.mjs",
    "test:redirect-contract": "node scripts/validate-redirect-contract.mjs",
    "test:claims": "node scripts/validate-claims.mjs",
    "test:links": "node scripts/validate-links.mjs",
    "test:external-links": "node scripts/validate-links.mjs --external",
    "test:validators": "node --test tests/validator-contracts.test.mjs",
    "check:release": "npm run build && node scripts/validate-content.mjs && node scripts/validate-redirect-contract.mjs --release && node scripts/validate-claims.mjs --rendered && node scripts/validate-links.mjs --release",
    "release:check": "npm run check:release",
    "preview": "vite preview",
    "test": "npm run test:deploy",
    "test:e2e": "playwright test"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.5.2",
    "autoprefixer": "^10.4.27",
    "dotted-map": "^3.1.0",
    "eslint": "^10.2.0",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "playwright": "^1.59.1",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "wrangler": "^4.114.0"
  }
}
