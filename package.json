{
  "name": "@terrascale/sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for TerraScale public REST APIs.",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "workspaces": [
    "mcp"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    }
  },
  "files": [
    "dist",
    "!dist/integration",
    "!dist/internal",
    "!dist/**/*.test.*",
    "!dist/**/*capture*",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "build:mcp": "npm run build --workspace @terrascale/mcp",
    "check:openapi-drift": "node scripts/check-openapi-drift.mjs",
    "check:public-contract-fixture": "node scripts/check-public-contract-fixture.mjs",
    "check:route-manifest": "node scripts/generate-client-route-manifest.mjs --check",
    "generate:route-manifest": "npm run build && node scripts/generate-client-route-manifest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js dist/integration/*.test.js",
    "test:integration": "node --test dist/integration/*.test.js",
    "test:unit": "node --test dist/*.test.js",
    "test:mcp": "npm run test --workspace @terrascale/mcp"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.18.0"
}
