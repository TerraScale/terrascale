{
  "name": "@terrascale/sdk",
  "version": "0.0.15",
  "description": "JavaScript SDK, typed with JSDoc, for project-scoped C# TerraBase v1 and hosted TerraScale identity.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerraScale/ts-js.git"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./admin": {
      "types": "./types/admin.d.ts",
      "import": "./src/admin.js"
    },
    "./schema": {
      "types": "./types/schema.d.ts",
      "import": "./src/schema.js"
    },
    "./sql": {
      "types": "./types/sql.d.ts",
      "import": "./src/sql.js"
    },
    "./management": {
      "types": "./types/management.d.ts",
      "import": "./src/management.js"
    },
    "./ts-auth": {
      "types": "./types/ts-auth.d.ts",
      "import": "./src/ts-auth.js"
    },
    "./react": {
      "types": "./types/react/index.d.ts",
      "import": "./src/react/index.js"
    },
    "./svelte": {
      "types": "./types/svelte/index.d.ts",
      "import": "./src/svelte/index.js"
    },
    "./tanstack": {
      "types": "./types/tanstack/index.d.ts",
      "import": "./src/tanstack/index.js"
    },
    "./local": {
      "types": "./types/local/index.d.ts",
      "workerd": null,
      "browser": null,
      "node": "./src/local/index.js"
    },
    "./postgres": {
      "types": "./types/postgres.d.ts",
      "workerd": null,
      "browser": null,
      "node": "./src/postgres.js"
    },
    "./codegen": {
      "types": "./types/codegen.d.ts",
      "browser": null,
      "node": "./src/codegen.js"
    }
  },
  "bin": {
    "terrascale-local": "./src/local/cli.js",
    "terrascale-models": "./src/codegen-cli.js"
  },
  "files": [
    "src",
    "!src/integration",
    "!src/**/*.test.js",
    "types",
    "!types/integration",
    "sdk-v1-route-manifest.json",
    "sdk-public-v1-route-manifest.json",
    "sdk-file-storage-route-manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('types', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check:v1-route-manifest": "node scripts/generate-v1-route-manifest.js --check",
    "check:forbidden-surface": "vitest run test/forbidden-surface.test.js",
    "check:sbom": "node scripts/check-sbom.js",
    "check:vulnerabilities": "node scripts/check-vulnerabilities.js",
    "generate:v1-route-manifest": "node scripts/generate-v1-route-manifest.js",
    "local": "node src/local/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:browser": "playwright test",
    "qualify:auth-authority": "node scripts/qualify-auth-authority.js",
    "check:frameworks": "vitest run src/database-view.test.js src/react/core.test.js src/svelte/index.test.js src/tanstack/index.test.js",
    "check:local-better-auth": "vitest run src/better-auth-factory-conformance.test.js"
  },
  "peerDependencies": {
    "@better-auth/core": "1.7.2",
    "react": ">=18.2.0 <20.0.0",
    "pg": "8.23.0",
    "@tanstack/db": "0.9.2",
    "json-schema-to-typescript": "16.0.0"
  },
  "peerDependenciesMeta": {
    "@better-auth/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "@tanstack/db": {
      "optional": true
    },
    "json-schema-to-typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@better-auth/core": "1.7.2",
    "@better-auth/test-utils": "1.7.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.0.0",
    "better-auth": "1.7.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@tanstack/db": "0.9.2",
    "svelte": "5.57.2",
    "react": "19.2.8",
    "react-test-renderer": "19.2.8",
    "@types/react": "19.2.14",
    "@types/react-test-renderer": "19.1.0",
    "pg": "8.23.0",
    "@types/pg": "8.23.1",
    "json-schema-to-typescript": "16.0.0"
  },
  "engines": {
    "node": "22.x || 24.x",
    "npm": ">=11.0.0"
  },
  "browserslist": {
    "production": [
      "last 1 Chrome major version",
      "last 1 Firefox major version",
      "last 1 Safari major version",
      "last 1 Edge major version"
    ]
  },
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "ulid": "3.0.2"
  },
  "overrides": {
    "vite": "8.2.4"
  }
}
