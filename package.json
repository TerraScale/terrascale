{
  "name": "terrascale-landing-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node ./scripts/inline-prerendered-css.mjs && node ./scripts/validate-links.mjs",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "cf:pages:dev": "npm run build && wrangler pages dev",
    "prepare": "svelte-kit sync",
    "check": "npm run build && node scripts/validate-content.mjs && node scripts/validate-redirect-contract.mjs && node scripts/validate-claims.mjs && node --test tests/validator-contracts.test.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json && node scripts/validate-claims.mjs --rendered",
    "icons:sync": "node ./scripts/icons-sync.mjs",
    "world-map:sync": "node ./scripts/world-map-sync.mjs",
    "lint": "eslint . --max-warnings 0",
    "test:redirect-contract": "node scripts/validate-redirect-contract.mjs",
    "test:claims": "node scripts/validate-claims.mjs",
    "test:links": "node scripts/validate-links.mjs",
    "test:external-links": "node scripts/validate-links.mjs --external",
    "test:validators": "node --test tests/validator-contracts.test.mjs",
    "check:release": "npm run build && node scripts/validate-content.mjs && node scripts/validate-redirect-contract.mjs --release && node scripts/validate-claims.mjs --rendered && node scripts/validate-links.mjs --release",
    "release:check": "npm run check:release",
    "preview": "vite preview",
    "test": "npm run test:validators",
    "test:e2e": "playwright test",
    "test:slow": "node scripts/test-code-samples-real.mjs"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.5.2",
    "autoprefixer": "^10.4.27",
    "dotted-map": "^3.1.0",
    "entities": "^8.0.0",
    "eslint": "^10.2.0",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "parse5": "^8.0.1",
    "playwright": "^1.59.1",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "wrangler": "^4.129.0"
  }
}
