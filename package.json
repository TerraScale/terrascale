{
  "name": "@terrascale/sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for TerraScale public REST APIs.",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./local": {
      "types": "./dist/local/index.d.ts",
      "node": "./dist/local/index.js"
    }
  },
  "bin": {
    "terrascale-local": "./dist/local/cli.js"
  },
  "files": [
    "dist",
    "!dist/integration",
    "!dist/internal",
    "!dist/**/*.test.*",
    "!dist/**/*capture*",
    "!dist/**/*.map",
    "sdk-route-manifest.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check:openapi-drift": "node scripts/check-openapi-drift.mjs",
    "check:openapi-contract-descriptor": "node scripts/check-openapi-contract-descriptor.mjs",
    "check:public-contract-fixture": "node scripts/check-public-contract-fixture.mjs",
    "check:route-manifest": "node scripts/generate-client-route-manifest.mjs --check",
    "generate:route-manifest": "npm run build && node scripts/generate-client-route-manifest.mjs",
    "generate:openapi-contract-descriptor": "npm run build && node scripts/generate-openapi-contract-descriptor.mjs",
    "local": "node dist/local/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js dist/integration/*.test.js",
    "test:integration": "node --test dist/integration/*.test.js",
    "test:unit": "node --test dist/*.test.js",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x || 24.x",
    "npm": ">=11.0.0"
  },
  "browserslist": {
    "production": [
      "last 1 Chrome major version",
      "last 1 Firefox major version",
      "last 1 Safari major version",
      "last 1 Edge major version"
    ]
  },
  "packageManager": "npm@11.18.0"
}
