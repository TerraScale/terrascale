# Legacy runnable configuration inventory; production must use automatic Vault delivery.
# This task preserves assignments for the separate runtime/config owner. In demo

# Legacy configuration inventory; do not source this file for production.
# OCI Vault must automatically provision/deliver production credentials.
# Demo/Stripe switch assignments below remain runtime/config follow-up work.
# See docs/zero-configuration.md; TS-795 changes comments only here.
# mode every Stripe setting below is ignored and billing runs through the local
# simulator without contacting Stripe.
TS_DASHBOARD_PRODUCTION_DEMO=1

# Legacy billing inputs remain below as inventory, not a production setup recipe.
# Every currently parsed value is required and
# validated at startup; the dashboard refuses to start and lists each problem
# when one is missing or inconsistent.
#
# STRIPE_MODE=test                 # test or live; must match the key below
# STRIPE_SECRET_KEY=rk_test_...    # restricted (rk_) or secret (sk_) key
# STRIPE_WEBHOOK_SECRET=whsec_...  # signing secret of this app's endpoint
# DASHBOARD_PUBLIC_ORIGIN=https://dashboard.terrascale.tech
#
# One recurring USD price per plan and interval, all distinct.
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_STARTER_ANNUAL=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_ANNUAL=price_...
#
# Synced Stripe state lives in the dashboard's own TerraBase database, reached
# through ts-go with TS_API_BASE_URL and TS_API_ACCESS_TOKEN.
# TS_BILLING_TENANT_ID=...
# TS_BILLING_PROJECT_ID=...
# TS_BILLING_DATABASE_ID=dashboard-billing
#
# The webhook endpoint (https://<origin>/api/v1/billing/stripe/webhook) must use the
# API version stripe-go was built for (stripe.APIVersion, currently
# 2026-08-26.dahlia) and subscribe to the events in docs/stripe.md.
