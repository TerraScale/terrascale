# Stripe sandbox (test mode) configuration for TerraScale.Dashboard.
#
# Copy to `.env.local` (gitignored) and fill in the sandbox values. The
# dashboard loads `.env.local` only when ASPNETCORE_ENVIRONMENT=Development, and
# real process environment variables always win over the file.
#
#   ASPNETCORE_ENVIRONMENT=Development dotnet run --project src/TerraScale.Dashboard
#
# A sandbox (test-mode) secret key is required and `Mode` must stay `test`.
# Live-mode keys are refused: the sandbox is development-only.

Payments__Stripe__Mode=test
Payments__Stripe__SecretKey=sk_test_replace_me
Payments__Stripe__WebhookSecret=whsec_replace_me

# Public HTTPS origin Stripe redirects back to. Use a Tailscale Funnel URL or
# the deployed Fly app; the webhook endpoint must be reachable over HTTPS.
Payments__Stripe__PublicOrigin=https://your-dashboard.example

# Billing catalog. Every plan may offer a monthly and an annual price; the
# checkout only offers a plan/interval pair whose price id is configured.
Payments__Stripe__StarterMonthlyPriceId=price_replace_me
Payments__Stripe__StarterAnnualPriceId=
Payments__Stripe__ProMonthlyPriceId=
Payments__Stripe__ProAnnualPriceId=
Payments__Stripe__BusinessMonthlyPriceId=
Payments__Stripe__BusinessAnnualPriceId=
