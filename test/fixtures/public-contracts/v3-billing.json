      "provider",
      "monthlyPriceId",
      "annualPriceId",
      "monthlyPolarProductId",
      "annualPolarProductId",
      "monthlyStripePriceId",
      "annualStripePriceId",
      "monthlyTrialDays",
      "annualTrialDays",
      "visible",
      "maxRegions",
      "operationOverageCentsPerMillion",
      "storageOverageCentsPerGbRegion"
