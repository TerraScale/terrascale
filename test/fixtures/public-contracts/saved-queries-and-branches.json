        "admissionState",
        "physicalCloneAvailable",
        "promotionAvailable",
        "mergeAvailable",
        "detail"
      ],
      "propertyTypes": {
        "projectId": [
          "string"
        ],
        "admissionState": [
          "string"
        ],
        "physicalCloneAvailable": [
          "boolean"
        ],
        "promotionAvailable": [
          "boolean"
        ],
        "mergeAvailable": [
          "boolean"
        ],
        "detail": [
          "string"
        ]
      },
      "errorStatuses": [
        400,
        401,
        403,
        404,
        409,
        429,
        500,
        503
      ]
    },
    "clone": {
      "path": "/api/v1/projects/{projectId}/database-branches",
      "method": "post",
      "operationId": "CreateDatabaseBranch",
      "sourceDatabaseIdRequired": false,
      "hasSuccessResponse": false,
      "errorStatuses": [
        400,
        401,
        403,
        404,
        409,
        429,
        500,
        503
      ]
    }
