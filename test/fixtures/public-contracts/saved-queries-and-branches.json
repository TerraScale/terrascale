{
  "contractVersion": 1,
  "savedQueriesV1": {
    "list": {
      "method": "get",
      "operationId": "ListProjectSavedQueries",
      "path": "/api/v1/projects/{projectId}/saved-queries",
      "parameters": [
        {
          "name": "skip",
          "required": false,
          "types": [
            "integer"
          ],
          "minimum": 0,
          "default": 0
        },
        {
          "name": "take",
          "required": false,
          "types": [
            "integer"
          ],
          "minimum": 0,
          "maximum": 500,
          "default": 100
        }
      ],
      "responseItemsRef": "#/components/schemas/ProjectSavedQueryResponse",
      "errorStatuses": [
        400,
        401,
        403,
        404,
        409,
        429,
        500
      ]
    },
    "get": {
      "method": "get",
      "operationId": "GetProjectSavedQuery",
      "path": "/api/v1/projects/{projectId}/saved-queries/{savedQueryId}",
      "responseRef": "#/components/schemas/ProjectSavedQueryResponse",
      "errorStatuses": [
        400,
        401,
        403,
        404,
        409,
        429,
        500
      ]
    }
  },
  "databaseBranches": {
