<?xml version="1.0" encoding="utf-8"?>
<!-- Hermetic sources: nuget.org only, nothing inherited from user or machine config.
     TerraScale.Endpoints and TerraScale.Logging are project references (src/), and ts-dotnet is consumed as source,
     so no TerraScale package registry is required. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
