  {"id": 4, "gridPos": {"x": 0, "y": 4, "w": 24, "h": 1}, "type": "row", "title": "Traffic", "collapsed": false, "panels": []},
  {"id": 5, "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8}, "type": "timeseries", "title": "Requests/s by app and region", "description": "", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"fillOpacity": 0, "stacking": {"mode": "none"}}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "expr": "sum by (app, region) (rate(http_server_request_duration_seconds_count{app=~\"ts-terrabase|ts-auth\",region=~\"$region\"}[$__rate_interval]))", "legendFormat": "{{app}} {{region}}"}]},
  {"id": 6, "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8}, "type": "timeseries", "title": "Error ratio (5xx)", "description": "", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"fillOpacity": 0, "stacking": {"mode": "none"}}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "expr": "sum by (app, region) (rate(http_server_request_duration_seconds_count{app=~\"ts-terrabase|ts-auth\",region=~\"$region\",http_response_status_code=~\"5..\"}[$__rate_interval])) / sum by (app, region) (rate(http_server_request_duration_seconds_count{app=~\"ts-terrabase|ts-auth\",region=~\"$region\"}[$__rate_interval]))", "legendFormat": "{{app}} {{region}}"}]},
