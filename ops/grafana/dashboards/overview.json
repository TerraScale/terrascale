{"uid": "ts-overview", "title": "TerraScale overview", "tags": ["terrascale"], "timezone": "utc", "schemaVersion": 39, "editable": true, "time": {"from": "now-6h", "to": "now"}, "refresh": "1m", "links": [{"type": "dashboards", "tags": ["terrascale"], "asDropdown": false, "title": "TerraScale"}], "templating": {"list": [{"type": "datasource", "name": "datasource", "label": "Data source", "query": "prometheus", "current": {}}, {"type": "query", "name": "region", "label": "Region", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}, "refresh": 2, "sort": 1, "query": {"query": "label_values(fly_instance_up{app=~\"ts-terrabase|ts-auth\"}, region)", "refId": "region"}, "definition": "label_values(fly_instance_up{app=~\"ts-terrabase|ts-auth\"}, region)"}]},
