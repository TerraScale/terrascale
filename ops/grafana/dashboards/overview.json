  {"id": 13, "gridPos": {"x": 12, "y": 30, "w": 12, "h": 8}, "type": "timeseries", "title": "Volume use", "description": "", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"fillOpacity": 0, "stacking": {"mode": "none"}}, "max": 1}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "expr": "max by (region) (terrabase_pressure_disk_used_bytes{app=\"ts-terrabase\",region=~\"$region\"} / terrabase_pressure_disk_total_bytes{app=\"ts-terrabase\",region=~\"$region\"})", "legendFormat": "{{region}}"}]},
  {"id": 14, "gridPos": {"x": 0, "y": 38, "w": 24, "h": 1}, "type": "row", "title": "Machine (512 MB RAM + 4 GB swap, shared-cpu-2x)", "collapsed": false, "panels": []},
  {"id": 15, "gridPos": {"x": 0, "y": 39, "w": 12, "h": 8}, "type": "timeseries", "title": "Memory used vs the 512 MB limit", "description": "MemTotal - MemAvailable. The guest sees ~459 MB of the 512 MB.", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"fillOpacity": 0, "stacking": {"mode": "none"}}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "expr": "sum by (app, region) (fly_instance_memory_mem_total{app=~\"ts-terrabase|ts-auth\",region=~\"$region\"} - fly_instance_memory_mem_available{app=~\"ts-terrabase|ts-auth\",region=~\"$region\"})", "legendFormat": "{{app}} {{region}}"}, {"refId": "B", "expr": "vector(536870912)", "legendFormat": "512 MB limit"}]},
  {"id": 16, "gridPos": {"x": 12, "y": 39, "w": 12, "h": 8}, "type": "timeseries", "title": "Swap used", "description": "Swap pages at a few MB/s (docs/fly/spike-1a.md): sustained use means the machine needs more RAM.", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"fillOpacity": 0, "stacking": {"mode": "none"}}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "expr": "sum by (app, region) (fly_instance_memory_swap_total{app=~\"ts-terrabase|ts-auth\",region=~\"$region\"} - fly_instance_memory_swap_free{app=~\"ts-terrabase|ts-auth\",region=~\"$region\"})", "legendFormat": "{{app}} {{region}}"}]},
  {"id": 17, "gridPos": {"x": 0, "y": 47, "w": 12, "h": 8}, "type": "timeseries", "title": "CPU used (cores of 2)", "description": "fly_instance_cpu counts centiseconds.", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "short", "custom": {"fillOpacity": 0, "stacking": {"mode": "none"}}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "expr": "sum by (app, region) (rate(fly_instance_cpu{app=~\"ts-terrabase|ts-auth\",region=~\"$region\",mode!~\"idle|steal\"}[$__rate_interval])) / 100", "legendFormat": "{{app}} {{region}}"}, {"refId": "B", "expr": "sum by (app, region) (rate(fly_instance_cpu{app=~\"ts-terrabase|ts-auth\",region=~\"$region\",mode=\"steal\"}[$__rate_interval])) / 100", "legendFormat": "{{app}} {{region}} steal"}]},
