<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Vendored TerraScale packages keep docker/CI builds hermetic; local
         source checkouts are preferred when they exist (see csproj). -->
    <add key="terrascale-vendored" value="src/ts-dashboard-2/nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="terrascale-vendored">
      <package pattern="TerraScale.Endpoints" />
      <package pattern="TerraScale.DotNet" />
    </packageSource>
  </packageSourceMapping>
</configuration>
