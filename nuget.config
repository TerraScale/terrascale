<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Vendored TerraScale.Endpoints: keeps docker/CI builds hermetic; the
         local ts-libs checkout is preferred when it exists (see csproj). -->
    <add key="terrascale-vendored" value="nuget" />
    <add key="terrascale" value="https://git.terrascale.tech/api/packages/TerraScale/nuget/index.json" />
  </packageSources>
</configuration>
