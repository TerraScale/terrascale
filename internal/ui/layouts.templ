package ui

import (
	"strconv"

	static "terrascale.tech/dashboard/web/static"

	"terrascale.tech/dashboard/internal/core"
	"terrascale.tech/dashboard/internal/ui/icons"
)

func Auth(page core.Page, body templ.Component) templ.Component {
	return authDocument(page, body)
}

func Shell(page core.Page, body templ.Component) templ.Component {
	return signedInDocument(page, body, false)
}

func Admin(page core.Page, body templ.Component) templ.Component {
	return signedInDocument(page, body, true)
}

templ document(page core.Page, bodyClass string) {
	<!DOCTYPE html>
	<html
		lang="en"
		data-theme="dark"
		if page.Nonce != "" {
			data-nonce={ page.Nonce }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark"/>
			<meta name="theme-color" content="#0a0c12"/>
			<title>{ title(page.Title) }</title>
			<link rel="icon" type="image/svg+xml" href="/brand/logo-icon-blue.svg"/>
			// Preloaded fonts are ready before first paint, so text never renders
			// in a fallback face and then swaps on every navigation.
			<link rel="preload" href="/fonts/oxanium-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/fonts/jetbrains-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/>
			<link id="ts-css" rel="stylesheet" href={ static.URL("css/terrascale.css") } data-dashboard-css/>
			<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin/>
			<script type="module" src={ datastarURL } integrity={ datastarIntegrity } crossorigin="anonymous" if page.Nonce != "" {
	nonce={ page.Nonce }
}></script>
			// Prefetch same-origin pages on hover so navigations feel instant.
			// Mutating requests send Clear-Site-Data: "prefetchCache" (internal/app).
			@speculationScript(page.Nonce)
		</head>
		// The body owns the navigation progress bar: Datastar flags same-origin
		// link clicks and form submissions that the browser will navigate.
		<body
			if bodyClass != "" {
				class={ bodyClass }
			}
			data-signals="{_navPending: false}"
			data-class:ts-nav-pending="$_navPending"
			data-on:click__window={ navClickPending }
			data-on:submit__window={ navSubmitPending }
			data-on:pageshow__window="$_navPending = false"
			data-on:keydown__window="evt.key === 'Escape' && ($_navPending = false)"
		>
			{ children... }
			if page.DevMode {
				// Development only: the Go dev host streams stylesheet patches and a
				// boot ID that reloads the page after a server restart.
				<div hidden data-signals="{_devBoot: '', _devFirstBoot: ''}" data-init="@get('/__dev/events', {openWhenHidden: true, retryMaxCount: 1000})" data-effect="$_devBoot && ($_devFirstBoot = $_devFirstBoot || $_devBoot) !== $_devBoot && location.reload()"></div>
			}
		</body>
	</html>
}

templ authDocument(page core.Page, body templ.Component) {
	@document(page, "ts-auth-body") {
		<a class="ts-skip-link" href="#ts-auth-main">Skip to main content</a>
		<div id="ts-auth-main">
			@body
		</div>
	}
}

templ signedInDocument(page core.Page, body templ.Component, admin bool) {
	@document(page, "") {
		<a class="ts-skip-link" href="#ts-main">Skip to main content</a>
		<div
			class="ts-shell"
			data-signals="{navOpen: false}"
			data-class:nav-open="$navOpen"
			data-on:keydown__window="evt.key === 'Escape' && $navOpen && ($navOpen = false, setTimeout(() => document.getElementById('ts-nav-toggle').focus()))"
			data-on:resize__window__debounce.150ms="innerWidth >= 768 && ($navOpen = false)"
		>
			<div class="ts-nav-backdrop" aria-hidden="true" data-on:click="$navOpen = false"></div>
			@shellSidebar(page, admin)
			<div class="ts-inset" data-attr:inert="$navOpen">
				<header class="ts-topbar">
					<button type="button" id="ts-nav-toggle" class="ts-icon-btn ts-fab-nav" aria-label="Open navigation" aria-controls="ts-navigation" aria-expanded="false" data-on:click="$navOpen = true; setTimeout(() => document.getElementById('ts-nav-close').focus())" data-attr:aria-expanded="$navOpen ? 'true' : 'false'">
						@icons.PanelLeft(18)
					</button>
					<img class="ts-topbar-brand" src="/brand/logo-terrascale-principal.svg" alt="TerraScale" decoding="async"/>
				</header>
				<div id="ts-main" class="ts-main" tabindex="-1">
					@body
				</div>
			</div>
		</div>
	}
}

templ shellSidebar(page core.Page, admin bool) {
	<aside id="ts-navigation" class={ "ts-sidebar", templ.KV("ts-admin-sidebar", admin) } aria-label={ sidebarLabel(admin) } tabindex="-1">
		<div class="ts-sidebar-header">
			if admin {
				<span class="ts-badge ts-badge-violet">Admin</span>
			}
			<button type="button" id="ts-nav-close" class="ts-sidebar-close ts-icon-btn" aria-label="Close navigation" data-on:click="$navOpen = false; setTimeout(() => document.getElementById('ts-nav-toggle').focus())">
				@icons.X(18)
			</button>
		</div>
		if !admin {
			@contextSwitcher(page)
		}
		<nav class="ts-sidebar-content" aria-label={ navSectionsLabel(admin) }>
			for _, group := range page.Shell.Navigation {
				<div class="ts-nav-group">
					if group.Label != "" {
						<div class="ts-nav-group-label">{ group.Label }</div>
					}
					@sidebarNavigation(group.Items)
				</div>
			}
		</nav>
		<div class="ts-sidebar-footer">
			<a class="ts-sidebar-brand" href="/" aria-label="TerraScale dashboard">
				<img src="/brand/logo-terrascale-principal.svg" alt="" aria-hidden="true" decoding="async"/>
			</a>
			if admin {
				<a class="ts-nav-link" href="/" data-tone="slate">
					<span class="ts-nav-icon" aria-hidden="true">@icons.ArrowLeft(16)</span>
					<span class="ts-nav-label">Back to dashboard</span>
				</a>
			}
			@accountMenu(page)
		</div>
	</aside>
}

// contextSwitcher is one menu for choosing the organization and the project.
templ contextSwitcher(page core.Page) {
	if len(page.Shell.Organizations) > 0 {
		@Dropdown(DropdownProps{
			Class:        "ts-context-menu",
			Label:        contextTriggerLabel(page.Shell),
			Trigger:      contextTrigger(page.Shell),
			TriggerClass: "ts-context-trigger",
			PanelClass:   "ts-context-panel",
			Attrs:        templ.Attributes{"data-signals": "{organizationSearch: '', projectSearch: ''}"},
		}) {
			@MenuHeading("Organizations")
			if len(page.Shell.Organizations) > 5 {
				<input class="ts-input ts-input-sm" id="organizationSearch" type="search" placeholder="Search organizations" aria-label="Search organizations" data-bind="organizationSearch"/>
			}
			<div class="ts-context-list">
				for _, organization := range page.Shell.Organizations {
					<form method="post" action="/api/v1/dashboard/switch-organization" data-show="$organizationSearch === '' || el.dataset.organizationName.toLowerCase().includes($organizationSearch.toLowerCase())" data-organization-name={ organization.Name }>
						@formToken(page.CSRFToken)
						<input type="hidden" name="organizationId" value={ organization.ID }/>
						@contextOption(organization.Name, organization.Selected, "data-organization-option", organization.ID)
					</form>
				}
			</div>
			if len(page.Shell.Projects) > 0 {
				@MenuSeparator()
				@MenuHeading("Projects in " + page.Shell.OrganizationName)
				if len(page.Shell.Projects) > 5 {
					<input class="ts-input ts-input-sm" id="projectSearch" type="search" placeholder="Search projects" aria-label="Search projects" data-bind="projectSearch"/>
				}
				<div class="ts-context-list">
					for _, project := range page.Shell.Projects {
						<form method="post" action="/api/v1/dashboard/switch-project" data-show="$projectSearch === '' || el.dataset.projectName.toLowerCase().includes($projectSearch.toLowerCase())" data-project-name={ project.Name }>
							@formToken(page.CSRFToken)
							<input type="hidden" name="projectId" value={ project.ID }/>
							<input type="hidden" name="returnUrl" value={ page.Shell.ReturnURL }/>
							@contextOption(project.Name, project.Selected, "data-project-option", project.ID)
						</form>
					}
				</div>
			}
			@MenuSeparator()
			@MenuItem(MenuItemProps{Href: "/organization?newProject=1#projects", Tone: "emerald", Icon: icons.Plus(15), Label: "Create new project"})
			@MenuItem(MenuItemProps{Href: "/settings?tab=identity", Tone: "slate", Icon: icons.Settings(15), Label: "Project settings"})
			@MenuItem(MenuItemProps{Href: "/organization", Tone: "indigo", Icon: icons.Boxes(15), Label: "All workspaces"})
		}
	}
}

templ contextTrigger(shell core.Shell) {
	<span class="ts-context-icon" data-tone={ initialTone(shell.OrganizationName) } aria-hidden="true">{ initial(shell.OrganizationName) }</span>
	<span class="ts-context-text">
		<span class="ts-context-kind">{ displayName(shell.OrganizationName, "Choose organization") }</span>
		<span class="ts-context-name">
			<span class="ts-context-dot" data-tone={ initialTone(shell.ProjectName) } aria-hidden="true"></span>
			<span class="ts-truncate">{ displayName(shell.ProjectName, "Choose project") }</span>
		</span>
	</span>
	<span class="ts-context-chevron" aria-hidden="true">@icons.ArrowUpDown(14)</span>
	for _, organization := range shell.Organizations {
		if organization.Selected {
			<span class="ts-sr-only" data-active-organization-id={ organization.ID }>Current organization: { organization.Name }</span>
		}
	}
	for _, project := range shell.Projects {
		if project.Selected {
			<span class="ts-sr-only" data-active-project-id={ project.ID }>Current project: { project.Name }</span>
		}
	}
}

templ contextOption(name string, selected bool, attr, id string) {
	@MenuItem(MenuItemProps{Type: "submit", Icon: menuTile(name), Label: name, Current: selected, Attrs: templ.Attributes{attr: id}})
}

templ menuTile(name string) {
	<span class="ts-menu-tile" data-tone={ initialTone(name) } aria-hidden="true">{ initial(name) }</span>
}

templ accountMenu(page core.Page) {
	@Dropdown(DropdownProps{Class: "ts-account", Up: true, Label: "Account menu", Trigger: accountTrigger(page.Shell), TriggerClass: "ts-account-trigger"}) {
		<div class="ts-account-card">
			<span class="ts-account-avatar ts-account-avatar-lg" aria-hidden="true">{ displayName(page.Shell.UserInitials, "TS") }</span>
			<span class="ts-account-meta">
				<span class="ts-account-name">{ displayName(page.Shell.UserName, "TerraScale user") }</span>
				<span class="ts-account-email">{ page.Shell.UserEmail }</span>
			</span>
		</div>
		@MenuSeparator()
		@MenuItem(MenuItemProps{Href: "/profile", Tone: "pink", Icon: icons.UserRound(15), Label: "Profile"})
		@MenuItem(MenuItemProps{Href: "/notifications", Tone: "amber", Icon: icons.Bell(15), Label: "Notifications"})
		@MenuItem(MenuItemProps{Href: "/settings", Tone: "slate", Icon: icons.Settings(15), Label: "Settings"})
		if page.Principal.PlatformAdmin {
			@MenuItem(MenuItemProps{Href: "/admin", Tone: "violet", Icon: icons.ShieldCheck(15), Label: "Administration"})
		}
		@MenuSeparator()
		<form method="post" action="/api/v1/auth/logout">
			@formToken(page.CSRFToken)
			@MenuItem(MenuItemProps{Type: "submit", Icon: icons.LogOut(15), Label: "Sign out", Danger: true})
		</form>
	}
}

templ accountTrigger(shell core.Shell) {
	<span class="ts-account-avatar" aria-hidden="true">{ displayName(shell.UserInitials, "TS") }</span>
	<span class="ts-account-meta">
		<span class="ts-account-name">{ displayName(shell.UserName, "TerraScale user") }</span>
		<span class="ts-account-email">{ shell.UserEmail }</span>
	</span>
	<span class="ts-account-chevron" aria-hidden="true">@icons.ChevronUp(15)</span>
}

templ formToken(token string) {
	<input type="hidden" name="_csrf" value={ token }/>
}

templ sidebarNavigation(items []core.NavItem) {
	<ul class="ts-nav">
		for _, item := range items {
			<li>
				if len(item.Children) > 0 {
					<details class="ts-nav-collapsible" data-tone={ navDestinations[item.URL].tone } open?={ item.Active }>
						<summary class="ts-nav-link">
							@navLinkContent(item)
							<span class="ts-nav-chevron" aria-hidden="true">@icons.ChevronRight(14)</span>
						</summary>
						<ul class="ts-subnav" aria-label={ item.Label }>
							for i, child := range item.Children {
								if child.Group != "" && (i == 0 || item.Children[i-1].Group != child.Group) {
									<li class="ts-subnav-group">{ child.Group }</li>
								}
								<li>
									<a
										class="ts-subnav-link"
										href={ child.URL }
										if child.Active {
											aria-current="page"
										}
									>{ child.Label }</a>
								</li>
							}
						</ul>
					</details>
				} else {
					<a
						class="ts-nav-link"
						href={ item.URL }
						data-tone={ navDestinations[item.URL].tone }
						if item.Active {
							aria-current="page"
						}
					>
						@navLinkContent(item)
					</a>
				}
			</li>
		}
	</ul>
}

templ navLinkContent(item core.NavItem) {
	<span class="ts-nav-icon" aria-hidden="true">
		@navIcon(item.URL)
	</span>
	<span class="ts-nav-label">{ item.Label }</span>
	if item.BadgeCount > 0 {
		<span class="ts-nav-count" aria-hidden="true">{ strconv.Itoa(item.BadgeCount) }</span>
	}
}
