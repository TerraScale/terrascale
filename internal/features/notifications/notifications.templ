package notifications

import (
	"fmt"
	"strings"

	"terrascale.tech/dashboard/internal/core"
	"terrascale.tech/dashboard/internal/ui"
)

templ notificationsView(data pageData, csrfToken string) {
	<main class="ts-page">
		@ui.PageHeader("Notifications") {
			<form method="post" action="/api/v1/notifications/read-all">
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				<button class="ts-btn ts-btn-secondary" type="submit" disabled?={ data.Unread == 0 }>Mark all read</button>
			</form>
		}
		<div class="ts-toolbar">
			@ui.Tabs("Notification filter", []ui.Tab{
				{Label: "All", URL: "/notifications", Active: data.Status == "all", Count: data.Total},
				{Label: "Unread", URL: "/notifications?status=unread", Active: data.Status == "unread", Count: data.Unread},
			})
			<p class="ts-meta ts-notifications-summary">
				{ fmt.Sprint(data.Unread) } unread
				if data.Critical > 0 {
					<span>· { fmt.Sprint(data.Critical) } critical</span>
				}
				· { fmt.Sprint(data.Total) } total
			</p>
		</div>
		if len(data.Notifications) > 0 {
			<ol class="ts-notification-list">
				for _, item := range data.Notifications {
					<li>
						@notificationItem(item, csrfToken)
					</li>
				}
			</ol>
		} else if data.Status == "unread" {
			@ui.Empty("You're all caught up", "No unread notifications in this scope.")
		} else {
			@ui.Empty("You're all caught up", "No notifications in this scope.")
		}
		if data.PageCount > 1 {
			<nav class="ts-pager" aria-label="Notification pages">
				<span>Page { fmt.Sprint(data.Page) } of { fmt.Sprint(data.PageCount) }</span>
				<div class="ts-row">
					if data.HasPrevious {
						<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ pageHref(data.Previous, data.Status) } rel="prev">Previous</a>
					}
					if data.HasNext {
						<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ pageHref(data.Next, data.Status) } rel="next">Next</a>
					}
				</div>
			</nav>
		}
	</main>
}

templ notificationItem(item core.Notification, csrfToken string) {
	<article
		class={ "ts-notification", templ.KV("ts-notification-unread", unread(item)) }
		data-tone={ severityTone(item.Severity) }
		aria-label={ item.Severity + " notification" }
	>
		<span class="ts-notification-marker" aria-hidden="true"></span>
		<div class="ts-stack-sm">
			<div class="ts-row">
				<strong class="ts-strong">{ item.Title }</strong>
				@ui.Badge("tone", item.Severity)
			</div>
			<p class="ts-muted">{ item.Body }</p>
			<p class="ts-meta"><time datetime={ item.CreatedAt.Format("2006-01-02T15:04:05Z07:00") }>{ item.CreatedAt.UTC().Format("Jan 2, 2006 15:04 UTC") }</time> · { item.Status }</p>
		</div>
		if unread(item) {
			<form method="post" action={ "/api/v1/notifications/" + item.ID + "/read" }>
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				<button class="ts-btn ts-btn-ghost ts-btn-sm" type="submit">Mark read</button>
			</form>
		}
	</article>
}

// unread matches the status case-insensitively; stored notifications use
// both "Unread" and "unread".
func unread(item core.Notification) bool {
	return strings.EqualFold(item.Status, "unread")
}

func pageHref(page int, status string) string {
	if status == "unread" {
		return fmt.Sprintf("/notifications?page=%d&status=unread", page)
	}
	return fmt.Sprintf("/notifications?page=%d", page)
}

func severityTone(severity string) string {
	switch severity {
	case "critical":
		return "rose"
	case "warning":
		return "amber"
	case "success":
		return "emerald"
	}
	return "sky"
}
