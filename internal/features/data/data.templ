package data

import (
	"fmt"
	"net/url"
	"strings"

	"terrascale.tech/dashboard/internal/core"
	"terrascale.tech/dashboard/internal/features/databases"
	"terrascale.tech/dashboard/internal/ui"
	"terrascale.tech/dashboard/internal/ui/icons"
)

// path links to a section of the open database, keeping the collection.
func path(d pageData, section string, extra ...string) string {
	query := url.Values{"collection": {d.Collection}}
	for i := 0; i+1 < len(extra); i += 2 {
		query.Set(extra[i], extra[i+1])
	}
	return sectionPath(d.Database.ID, section, query)
}

templ sectionPage(page core.Page, frame databases.FrameProps, d pageData) {
	@databases.Frame(frame) {
		if d.Error != "" {
			@ui.Alert("danger", "", d.Error)
		}
		// Dialog forms and the SQL console show their errors beside the input.
		if d.FormError != "" && d.Dialog == "" && d.Section != "sql" {
			@ui.Alert("danger", "", d.FormError)
		}
		switch d.Section {
			case "documents":
				@documentsView(page, d)
			case "history":
				@historyView(d)
			case "sql":
				@sqlView(page, d)
			case "schema":
				@schemaView(page, d)
			case "indexes":
				@indexesView(page, d)
		}
	}
}

// collectionScope chooses the collection a section works on. Children are
// extra filter controls submitted with it.
templ collectionScope(d pageData, section string) {
	<form class="ts-filters ts-data-scope" method="get" action={ templ.SafeURL(sectionPath(d.Database.ID, section, nil)) } aria-label="Choose collection">
		if section == "indexes" {
			<input type="hidden" name="view" value={ d.IndexView }/>
		}
		<label class="ts-data-collection" for="collection">
			<span class="ts-data-collection-icon" aria-hidden="true">@icons.Layers(15)</span>
			<span class="ts-sr-only">Collection</span>
			<input class="ts-input ts-input-sm ts-mono" id="collection" name="collection" value={ d.Collection } placeholder="Collection" required/>
		</label>
		{ children... }
		<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Open</button>
	</form>
}

templ documentsView(page core.Page, d pageData) {
	<div class="ts-data-head">
		<div class="ts-data-bar">
			@collectionScope(d, "documents") {
				<input class="ts-input ts-input-sm ts-data-search" type="search" name="q" value={ d.Search } placeholder="Search documents" aria-label="Search documents"/>
				if d.Search != "" {
					<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ templ.SafeURL(path(d, "documents")) }>Clear</a>
				}
			}
			if d.CanWrite {
				@ui.DialogTrigger(ui.DialogTriggerProps{Dialog: "add-document", Label: "Add document", Icon: icons.Plus(16), Variant: "primary", Small: true})
			}
		</div>
		<p class="ts-hint">Collection listing is unavailable in the published SDK, so enter a collection name explicitly.</p>
	</div>
	@ui.Card(ui.CardProps{ID: "documents", Flush: true}) {
		if len(d.Documents) > 0 {
			<div class="ts-table-wrap">
				<table class="ts-table ts-data-documents">
					<thead>
						<tr>
							<th>ID</th>
							<th>Document</th>
							<th class="ts-table-actions"><span class="ts-sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, doc := range d.Documents {
							<tr>
								<td><a class="ts-data-doc-id" href={ templ.SafeURL(path(d, "documents", "edit", doc.ID)) }>{ doc.ID }</a></td>
								<td><code class="ts-data-json">{ doc.Value.String() }</code></td>
								<td class="ts-table-actions">@documentMenu(page, d, doc.ID)</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			@ui.Empty("No documents match this collection and filter.", "Open another collection or add a document.")
		}
	}
	if d.CanWrite {
		@ui.Dialog(ui.DialogProps{ID: "add-document", Title: "Add document", Description: "Create a document in the " + d.Collection + " collection.", Open: d.Dialog == "add-document", Wide: true}) {
			<form method="post" action="/api/v1/dashboard/data/documents" class="ts-form">
				@documentScope(page, d)
				<input type="hidden" name="operation" value="create"/>
				@dialogError(d, "add-document")
				@ui.Field(ui.FieldProps{ID: "new-document-id", Label: "Document ID", Hint: "Leave empty to generate one."}) {
					<input class="ts-input ts-mono" id="new-document-id" name="id" maxlength="256" value={ d.NewDocumentID }/>
				}
				@ui.Field(ui.FieldProps{ID: "new-document-json", Label: "JSON document"}) {
					@ui.CodeEditor(ui.CodeEditorProps{ID: "new-document-json", Name: "document", Language: ui.CodeJSON, Value: newDocument(d), Rows: 10})
				}
				@ui.DialogActions("add-document") {
					<button class="ts-btn ts-btn-primary" type="submit">Add document</button>
				}
			</form>
		}
	}
	if d.EditJSON != "" || d.Dialog == "edit-document" {
		@editDocument(page, d)
	}
	if d.CanWrite && d.DeleteID != "" {
		@deleteDocument(page, d)
	}
}

// dialogError shows a failed post's error inside the dialog it came from.
templ dialogError(d pageData, dialog string) {
	if d.FormError != "" && d.Dialog == dialog {
		@ui.Alert("danger", "", d.FormError)
	}
}

templ documentMenu(page core.Page, d pageData, id string) {
	@ui.Dropdown(ui.DropdownProps{End: true, Label: "Actions for " + id, Trigger: icons.MoreHorizontal(16), TriggerClass: "ts-icon-btn"}) {
		if d.CanWrite {
			@ui.MenuItem(ui.MenuItemProps{Href: path(d, "documents", "edit", id), Icon: icons.Pencil(15), Label: "Edit"})
		} else {
			@ui.MenuItem(ui.MenuItemProps{Href: path(d, "documents", "edit", id), Icon: icons.Eye(15), Label: "View"})
		}
		@ui.MenuItem(ui.MenuItemProps{Href: path(d, "history", "id", id), Icon: icons.History(15), Label: "History"})
		if d.CanWrite {
			@ui.MenuSeparator()
			@ui.MenuItem(ui.MenuItemProps{Href: path(d, "documents", "delete", id), Icon: icons.Trash2(15), Label: "Delete", Danger: true})
		}
	}
}

// deleteDocument confirms a delete chosen from a document's menu.
templ deleteDocument(page core.Page, d pageData) {
	@ui.Dialog(ui.DialogProps{ID: "delete-document", Title: "Delete " + d.DeleteID + "?", Description: "This removes the document from the " + d.Collection + " collection. Its revision history keeps the deletion.", Open: true}) {
		<form method="post" action="/api/v1/dashboard/data/documents" class="ts-form">
			@documentScope(page, d)
			<input type="hidden" name="operation" value="delete"/>
			<input type="hidden" name="id" value={ d.DeleteID }/>
			@ui.DialogActions("delete-document") {
				<button class="ts-btn ts-btn-danger" type="submit">Delete document</button>
			}
		</form>
	}
}

templ editDocument(page core.Page, d pageData) {
	@ui.Dialog(ui.DialogProps{ID: "edit-document", Title: d.DocumentID, Description: "Document in the " + d.Collection + " collection.", Open: true, Wide: true}) {
		if d.CanWrite {
			<form method="post" action="/api/v1/dashboard/data/documents" class="ts-form">
				@documentScope(page, d)
				<input type="hidden" name="id" value={ d.DocumentID }/>
				@dialogError(d, "edit-document")
				@ui.Field(ui.FieldProps{ID: "operation", Label: "Operation", Hint: "Replace writes the whole document; patch merges the JSON into it."}) {
					<select class="ts-select" id="operation" name="operation">
						<option value="replace">Replace</option>
						<option value="patch" selected?={ d.EditOperation == "patch" }>Patch</option>
					</select>
				}
				@ui.Field(ui.FieldProps{ID: "document-json", Label: "JSON document or patch"}) {
					@ui.CodeEditor(ui.CodeEditorProps{ID: "document-json", Name: "document", Language: ui.CodeJSON, Value: d.EditJSON, Rows: 14})
				}
				@ui.DialogActions("edit-document") {
					<button class="ts-btn ts-btn-primary" type="submit">Save document</button>
				}
			</form>
		} else {
			<pre class="ts-code">{ d.EditJSON }</pre>
		}
	}
}

templ documentScope(page core.Page, d pageData) {
	<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
	<input type="hidden" name="databaseId" value={ d.Database.ID }/>
	<input type="hidden" name="collection" value={ d.Collection }/>
}

templ historyView(d pageData) {
	<a class="ts-data-back" href={ templ.SafeURL(path(d, "documents")) }>@icons.ArrowLeft(15)<span>All documents</span></a>
	@ui.Card(ui.CardProps{ID: "document-history", Title: historyTitle(d.DocumentID), Description: "Revisions of the document in " + d.Collection + ", oldest first."}) {
		if len(d.History) > 0 {
			<ol class="ts-data-history">
				for _, revision := range d.History {
					<li>
						<div class="ts-row">
							<span class="ts-strong">Revision { revision.Number }</span>
							if revision.Deleted {
								@ui.Badge("danger", "deleted")
							}
						</div>
						if !revision.Deleted && revision.Body != "" {
							<pre class="ts-code">{ revision.Body }</pre>
						}
					</li>
				}
			</ol>
		} else {
			@ui.Empty("No revisions recorded.", "Choose a document in the documents tab to inspect its revisions.")
		}
	}
}

templ sqlView(page core.Page, d pageData) {
	<div class="ts-data-sql">
		<div class="ts-stack-lg">
			@ui.Card(ui.CardProps{ID: "sql-editor", Title: "Query", Description: runDescription(d.Demo)}) {
				<form method="post" action="/api/v1/dashboard/data/sql" class="ts-form">
					@documentScope(page, d)
					<label class="ts-sr-only" for="sql">SQL</label>
					@ui.CodeEditor(ui.CodeEditorProps{ID: "sql", Language: ui.CodeSQL, Value: d.SQL, Rows: 8})
					<div class="ts-form-actions">
						<button class="ts-btn ts-btn-secondary" type="submit" formaction="/api/v1/dashboard/data/sql/check">@icons.CircleCheck(16)<span>Check SQL</span></button>
						<button class="ts-btn ts-btn-primary" type="submit">@icons.Play(16)<span>Run query</span></button>
					</div>
				</form>
			}
			if d.SQLResult != nil {
				@sqlResultView(*d.SQLResult)
			}
			// A failed run explains itself; the statement check would repeat or
			// contradict it.
			if d.FormError != "" && d.Dialog == "" {
				@ui.Alert("danger", "Query failed", d.FormError)
			} else if d.SQLAnalysis.OK {
				@sqlCheck(d)
			} else if d.SQLAnalysis.Error != "" {
				@ui.Alert("danger", "", d.SQLAnalysis.Error)
			}
		</div>
		@savedQueries(page, d)
	</div>
}

templ savedQueries(page core.Page, d pageData) {
	@ui.Card(ui.CardProps{ID: "saved-queries", Title: "Saved queries", Description: "Shared with everyone in this project.", Actions: saveQueryAction(d), Flush: true}) {
		if len(d.Queries) > 0 {
			<ul class="ts-data-queries">
				for _, query := range d.Queries {
					<li>
						<a class="ts-data-query" href={ templ.SafeURL(path(d, "sql", "savedQueryId", query.ID)) }>
							<span class="ts-strong">{ query.Name }</span>
							<code>{ query.SQL }</code>
						</a>
						if d.CanWrite {
							<button class="ts-icon-btn" type="button" command="show-modal" commandfor={ "delete-query-" + query.ID } aria-label={ "Delete " + query.Name }>@icons.Trash2(15)</button>
							@ui.Dialog(ui.DialogProps{ID: "delete-query-" + query.ID, Title: "Delete " + query.Name + "?", Description: "Everyone in this project loses this saved query."}) {
								<form method="post" action="/api/v1/dashboard/data/saved-queries/delete" class="ts-form">
									@documentScope(page, d)
									<input type="hidden" name="id" value={ query.ID }/>
									@ui.DialogActions("delete-query-" + query.ID) {
										<button class="ts-btn ts-btn-danger" type="submit">Delete query</button>
									}
								</form>
							}
						}
					</li>
				}
			</ul>
		} else {
			@ui.Empty("No saved queries yet.", "Save a query to reuse it and share it with collaborators.")
		}
	}
	if d.CanWrite {
		@ui.Dialog(ui.DialogProps{ID: "save-query", Title: "Save query", Description: "Saved queries are available to everyone with access to this project.", Open: d.Dialog == "save-query"}) {
			<form method="post" action="/api/v1/dashboard/data/saved-queries" class="ts-form">
				@documentScope(page, d)
				@dialogError(d, "save-query")
				@ui.Field(ui.FieldProps{ID: "query-name", Label: "Name"}) {
					<input class="ts-input" id="query-name" name="name" maxlength="128" value={ d.QueryName } required/>
				}
				@ui.Field(ui.FieldProps{ID: "saved-sql", Label: "SQL query"}) {
					@ui.CodeEditor(ui.CodeEditorProps{ID: "saved-sql", Name: "sql", Language: ui.CodeSQL, Value: d.SQL, Rows: 6, Required: true})
				}
				@ui.DialogActions("save-query") {
					<button class="ts-btn ts-btn-primary" type="submit">Save query</button>
				}
			</form>
		}
	}
}

templ saveQueryAction(d pageData) {
	if d.CanWrite {
		@ui.DialogTrigger(ui.DialogTriggerProps{Dialog: "save-query", Label: "Save query", Icon: icons.Save(14), Small: true})
	}
}

templ sqlResultView(r sqlResult) {
	@ui.Card(ui.CardProps{ID: "sql-result", Title: "Query result", Description: resultSummary(r), Flush: true}) {
		switch {
			case len(r.Rows) == 0:
				@ui.Empty("No rows matched.", "The query ran and returned no rows.")
			default:
				<div class="ts-table-wrap ts-data-result-wrap" role="region" tabindex="0" aria-labelledby="sql-result-title">
					<table class="ts-table ts-data-result">
						<thead>
							<tr>
								<th scope="col">id</th>
								for _, column := range r.Columns {
									<th scope="col" class={ templ.KV("ts-num", column.Numeric) }>{ column.Name }</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, row := range r.Rows {
								<tr>
									<td class="ts-data-result-id">{ row.ID }</td>
									for i, cell := range row.Cells {
										<td
											class={ templ.KV("ts-num", r.Columns[i].Numeric) }
											data-kind={ cell.Kind }
											if cell.Title != "" {
												title={ cell.Title }
											}
										>
											if cell.Kind == "missing" {
												<span aria-hidden="true">—</span>
												<span class="ts-sr-only">not set</span>
											} else {
												{ cell.Text }
											}
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
				<details class="ts-data-raw">
					<summary>Raw JSON</summary>
					<pre class="ts-code">{ r.JSON }</pre>
				</details>
		}
	}
}

templ sqlCheck(d pageData) {
	@ui.Card(ui.CardProps{ID: "sql-analysis", Title: "SQL check"}) {
		<ul class="ts-data-checks">
			<li>@icons.CircleCheck(16)<span>Read-only statement accepted. { d.SQLAnalysis.ParameterSlots } parameter slot(s).</span></li>
			if d.SQLAnalysis.HasLimit {
				<li>@icons.CircleCheck(16)<span>Bounded with LIMIT.</span></li>
			} else {
				<li class="ts-data-check-warn">@icons.CircleAlert(16)<span>Add LIMIT to bound results.</span></li>
			}
			if d.SQLChecked {
				<li>@icons.CircleCheck(16)<span>Server check passed.</span></li>
			}
			if d.SQLAnalysis.Collection != "" {
				<li>@icons.Table(16)<span>Statement collection: { d.SQLAnalysis.Collection }</span></li>
			}
		</ul>
		<div class="ts-stack-sm">
			<p class="ts-meta">EXPLAIN statement preview</p>
			<pre class="ts-code">{ d.SQLAnalysis.Explain }</pre>
		</div>
		<div class="ts-card-section">
			<h3 class="ts-strong">Advisory index suggestions</h3>
			if len(d.SQLAnalysis.Suggestions) == 0 {
				<p class="ts-meta">No index hints found in WHERE or ORDER BY.</p>
			} else {
				<ul class="ts-list">
					for _, suggestion := range d.SQLAnalysis.Suggestions {
						<li class="ts-list-item"><strong class="ts-mono">{ suggestion.Field }</strong><span class="ts-meta">{ suggestion.Reason }</span></li>
					}
				</ul>
			}
		</div>
	}
}

templ schemaView(page core.Page, d pageData) {
	<div class="ts-data-bar">
		@collectionScope(d, "schema")
	</div>
	@ui.Card(ui.CardProps{ID: "collection-schema", Title: "Collection schema", Description: "Fields, indexes, TTL, and merge policy declared for " + d.Collection + " in the terrascale.schema.json format."}) {
		<form method="post" action="/api/v1/dashboard/schema" class="ts-form">
			@documentScope(page, d)
			@ui.Field(ui.FieldProps{ID: "schema-json", Label: "Schema JSON", Hint: schemaHint(d.CanManage)}) {
				@ui.CodeEditor(ui.CodeEditorProps{ID: "schema-json", Name: "schema", Language: ui.CodeJSON, Value: d.Schema, Rows: 14, Required: true, ReadOnly: !d.CanManage})
			}
			if d.CanManage {
				<div class="ts-form-actions">
					<button class="ts-btn ts-btn-primary" type="submit">Apply schema</button>
				</div>
			}
		</form>
	}
}

templ indexesView(page core.Page, d pageData) {
	<div class="ts-data-bar">
		<nav class="ts-segmented" aria-label="Index views">
			for _, view := range indexViews {
				<a
					class="ts-segment"
					href={ templ.SafeURL(path(d, "indexes", "view", view.Key)) }
					if d.IndexView == view.Key {
						aria-current="page"
					}
				>{ view.Label }</a>
			}
		</nav>
		@collectionScope(d, "indexes")
	</div>
	switch {
		case d.IndexView == "overview":
			@ui.Card(ui.CardProps{ID: "collection-indexes", Title: "Collection indexes", Description: "Secondary indexes on " + d.Collection + "."}) {
				if len(d.Indexes) > 0 {
					<ul class="ts-data-chips">
						for _, field := range d.Indexes {
							<li>@icons.ListChecks(14)<span>{ field }</span></li>
						}
					</ul>
				} else {
					<p class="ts-meta">No indexes yet.</p>
				}
				if d.CanManage {
					<div class="ts-card-section">
						<form method="post" action="/api/v1/dashboard/indexes" class="ts-filters ts-data-index-form">
							@documentScope(page, d)
							<label class="ts-filter-field ts-data-grow" for="index-field">
								Field
								<input class="ts-input" id="index-field" name="field" maxlength="128" value={ d.IndexField } required/>
							</label>
							<button class="ts-btn ts-btn-primary ts-btn-sm" type="submit">Create index</button>
						</form>
					</div>
				}
			}
		case d.IndexView == "recommendations" && d.Demo:
			@ui.Card(ui.CardProps{ID: "index-recommendations", Title: "Recommendations", Description: "Sample recommendations for the in-memory demo. Applying one starts a simulated index build."}) {
				if len(d.Recommendations) == 0 {
					@ui.Empty("No demo recommendations for this collection.", "")
				} else {
					<ul class="ts-list">
						for _, recommendation := range d.Recommendations {
							<li class="ts-list-item">
								<div class="ts-list-main">
									<strong class="ts-mono">{ strings.Join(recommendation.Fields, ", ") }</strong>
									<span class="ts-meta">{ recommendation.Reason }</span>
								</div>
								@ui.Badge("info", recommendation.State)
								if recommendation.State == "recommended" && d.CanManage {
									<form method="post" action="/api/v1/dashboard/indexes/recommendations/apply">
										@documentScope(page, d)
										<input type="hidden" name="recommendationId" value={ recommendation.ID }/>
										<button class="ts-btn ts-btn-primary ts-btn-sm" type="submit">Apply</button>
									</form>
								}
							</li>
						}
					</ul>
				}
				if len(d.IndexBuilds) > 0 {
					<h3 class="ts-section-title">Demo index builds</h3>
					<ul class="ts-list">
						for _, build := range d.IndexBuilds {
							<li class="ts-list-item"><span class="ts-mono">{ build.Field }</span>: { build.Status }</li>
						}
					</ul>
				}
			}
		case d.IndexView == "migration" && d.Migration != nil:
			<div class="ts-data-migration">
				@ui.Card(ui.CardProps{ID: "index-migration", Title: "Migration progress", Description: "Static sample from the Mario in-memory demo. Applying an index recommendation does not advance this snapshot.", Actions: ui.Badge("info", "Sample · "+d.Migration.State)}) {
					<progress class="ts-data-progress" value={ d.Migration.Completed } max={ d.Migration.Total } aria-label="Sample index migration progress">{ d.Migration.Percent }%</progress>
					<p class="ts-meta">{ d.Migration.Completed } / { d.Migration.Total } · { d.Migration.Percent }% · watermark <span class="ts-mono">{ d.Migration.Watermark }</span></p>
					<p class="ts-meta">Pin and forbid controls are unavailable until the provider publishes lifecycle mutations.</p>
				}
			</div>
		default:
			@ui.Card(ui.CardProps{ID: "index-" + d.IndexView, Title: indexViewTitle(d.IndexView)}) {
				@ui.Empty(indexUnavailable(d.IndexView), "")
			}
	}
}

func runDescription(demo bool) string {
	if demo {
		return "Demo execution supports SELECT * FROM collection [LIMIT n]. Checking validates a read-only statement without running it."
	}
	return "Run a read-only statement against this database, or check it without running it."
}

// newDocument is the add-document editor's content: the submitted JSON after
// a failed post, otherwise an empty object.
func newDocument(d pageData) string {
	if d.Dialog == "add-document" {
		return d.NewDocument
	}
	return "{}"
}

func resultSummary(r sqlResult) string {
	summary := plural(len(r.Rows), "row", "rows")
	if r.Truncated() {
		summary = fmt.Sprintf("First %d of %d matched rows; add a LIMIT to narrow the query", len(r.Rows), r.Matched)
	}
	if r.HiddenColumns > 0 {
		summary += fmt.Sprintf(" · %d more %s in the raw JSON", r.HiddenColumns, pluralWord(r.HiddenColumns, "field", "fields"))
	}
	return summary
}

func plural(count int, one, many string) string {
	return fmt.Sprintf("%d %s", count, pluralWord(count, one, many))
}

func pluralWord(count int, one, many string) string {
	if count == 1 {
		return one
	}
	return many
}

func schemaHint(canManage bool) string {
	if canManage {
		return "Applying replaces the declared schema of this collection."
	}
	return "Only project managers can change the schema."
}

func historyTitle(id string) string {
	if id == "" {
		return "History"
	}
	return "History for " + id
}

func indexViewTitle(view string) string {
	switch view {
	case "templates":
		return "Index templates"
	case "recommendations":
		return "Recommendations"
	default:
		return "Index migration"
	}
}

func indexUnavailable(view string) string {
	switch view {
	case "templates":
		return "No provider index templates are published for this database."
	case "recommendations":
		return "Query workload recommendations are unavailable without provider analysis data."
	default:
		return "Index migration state is unavailable in the current provider contract."
	}
}
