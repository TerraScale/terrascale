package organization

import (
	"fmt"
	"strings"
	"time"

	"terrascale.tech/dashboard/internal/core"
	"terrascale.tech/dashboard/internal/ui"
	"terrascale.tech/dashboard/internal/ui/icons"
)

templ organizationPageView(page core.Page, data organizationPageData) {
	<main class="ts-page">
		@ui.PageHeader(ui.Header{
			Eyebrow:     organizationKindLabel(data.Organization.Kind),
			Title:       data.Organization.Name,
			Description: organizationStatusLabel(data.Organization.Status) + " · Projects, placement, and ownership for this organization.",
		}) {
			<a class="ts-btn ts-btn-secondary" href="/access">@icons.Users(16)<span>Manage team</span></a>
			<a class="ts-btn ts-btn-primary" href="/organization?newOrganization=organization">@icons.Plus(16)<span>Create organization</span></a>
		}
		if data.Error != "" {
			@ui.Alert("danger", "", data.Error)
		}
		@ui.Stats("Organization summary") {
			@ui.Stat("Projects", fmt.Sprint(len(data.Projects)), "Projects in this workspace")
			@ui.Stat("Members", fmt.Sprint(len(data.Members)), "People with organization access")
			@ui.Stat("Invitations", fmt.Sprint(data.InvitationCount), "Current and historical invitations")
			@ui.Stat("Created", organizationDay(data.Organization.CreatedAt), "Organization record")
		}
		@ui.Card(ui.CardProps{ID: "projects", Title: "Projects", Description: organizationKindLabel(data.Organization.Kind) + " · Projects returned by the TerraScale Dashboard API", Flush: true}) {
			if len(data.Projects) == 0 {
				@ui.Empty("No projects returned", "The API did not return projects for this organization.")
			} else {
				<div class="ts-table-wrap">
					<table class="ts-table">
						<thead><tr><th>Project</th><th>Slug</th><th>Status</th><th>Backup region</th><th>Created</th><th class="ts-table-actions">Actions</th></tr></thead>
						<tbody>
							for _, project := range data.Projects {
								@organizationProjectRow(page, data, project)
							}
						</tbody>
					</table>
				</div>
			}
			if data.CanProvision {
				<details id="create-project" class="ts-disclosure ts-org-create-project" open?={ data.OpenCreateProject }>
					<summary class="ts-btn ts-btn-primary">@icons.Plus(16)<span>Create project</span></summary>
					<form method="post" action="/api/v1/dashboard/organization/projects" class="ts-form">
						<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
						@ui.Field(ui.FieldProps{ID: "project-name", Label: "New project"}) {
							<input class="ts-input" id="project-name" name="name" placeholder="Analytics" maxlength="128" required/>
						}
						@regionPlacement(placement{
							RegionsID: "project-regions", PrimaryID: "project-region", BackupID: "project-backup",
							Regions: allSelected(data.Regions), All: data.Regions, RequireRegions: true,
							Hint: "Databases and authentication inherit this placement.",
						})
						<div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Create project</button></div>
					</form>
				</details>
			}
		}
		<div class="ts-split">
			@ui.Card(ui.CardProps{ID: "organization-details", Title: "Organization details", Description: "Current tenant context"}) {
				<dl class="ts-kv">
					<dt>Name</dt>
					<dd>{ data.Organization.Name }</dd>
					<dt>Status</dt>
					<dd>
						@ui.Badge("success", organizationStatusLabel(data.Organization.Status))
					</dd>
					<dt>Organization ID</dt>
					<dd class="ts-mono">{ data.Organization.ID }</dd>
					<dt>Current project</dt>
					<dd class="ts-mono">{ displayProjectID(data.CurrentProjectID) }</dd>
					<dt>Created</dt>
					<dd>{ organizationDate(data.Organization.CreatedAt) }</dd>
					<dt>Signed-in user</dt>
					<dd>{ data.SignedInEmail }</dd>
				</dl>
				@ui.Alert("success", "", "Organization access is enforced by the API session and project context.")
				if data.CanManage {
					<details class="ts-disclosure">
						<summary class="ts-btn ts-btn-secondary ts-btn-sm">@icons.Pencil(14)<span>Edit name</span></summary>
						<form method="post" action="/api/v1/dashboard/organization/rename" class="ts-form">
							<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
							@ui.Field(ui.FieldProps{ID: "organizationName", Label: "Organization name"}) {
								<input class="ts-input" id="organizationName" name="name" value={ data.Organization.Name } required/>
							}
							<div class="ts-form-actions"><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Save name</button></div>
						</form>
					</details>
				}
			}
			<div class="ts-stack">
				@ui.Card(ui.CardProps{ID: "organization-switch", Title: "Active organization", Description: "Switch the organization used by the dashboard."}) {
					<form method="post" action="/api/v1/dashboard/switch-organization" class="ts-form">
						<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
						@ui.Field(ui.FieldProps{ID: "activeOrganization", Label: "Active organization"}) {
							<select class="ts-select" id="activeOrganization" name="organizationId">
								for _, organization := range data.Organizations {
									<option value={ organization.ID } selected?={ organization.ID == data.Organization.ID }>{ organization.Name } ({ organizationKindShortLabel(organization.Kind) })</option>
								}
							</select>
						}
						<div class="ts-form-actions"><button class="ts-btn ts-btn-secondary" type="submit">Switch organization</button></div>
					</form>
				}
				if data.CanLeave || data.CanManage || data.CanConfirmOwnership {
					@ui.Card(ui.CardProps{ID: "organization-ownership", Title: "Ownership", Description: "Leave, transfer, or delete this organization."}) {
						@organizationOwnership(page, data)
					}
				}
			</div>
		</div>
		if data.NewOrganization != "" {
			@newOrganizationDialog(page, data)
		}
	</main>
}

templ organizationOwnership(page core.Page, data organizationPageData) {
	if data.CanLeave {
		<form method="post" action="/api/v1/dashboard/organization/leave">
			<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
			<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">@icons.LogOut(14)<span>Leave organization</span></button>
		</form>
	}
	if data.CanManage {
		if hasTransferCandidate(data.Members) {
			<form method="post" action="/api/v1/dashboard/organization/members/ownership" class="ts-form">
				<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
				@ui.Field(ui.FieldProps{ID: "new-owner", Label: "Transfer ownership to"}) {
					<select class="ts-select" id="new-owner" name="userID" required>
						for _, member := range data.Members {
							if !member.IsOwner {
								<option value={ member.ID }>{ member.Name } · { member.Email }</option>
							}
						}
					</select>
				}
				<div class="ts-form-actions"><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Request transfer</button></div>
			</form>
		} else {
			<p class="ts-meta">Invite another member before transferring ownership.</p>
		}
		if data.Organization.Kind != "personal" {
			<details class="ts-disclosure ts-card-section">
				<summary class="ts-btn ts-btn-danger ts-btn-sm">@icons.Trash2(14)<span>Organization deletion</span></summary>
				<form method="post" action="/api/v1/dashboard/organization/deletion" class="ts-form">
					<p class="ts-meta">Deletion preserves linked projects and data until the operation completes.</p>
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
					@ui.Field(ui.FieldProps{ID: "deletion-confirmation", Label: "Enter “" + data.Organization.Name + "” to confirm"}) {
						<input class="ts-input" id="deletion-confirmation" name="confirmation" autocomplete="off" required disabled?={ data.Organization.DeletionRequested }/>
					}
					<div class="ts-form-actions"><button class="ts-btn ts-btn-danger ts-btn-sm" type="submit" disabled?={ data.Organization.DeletionRequested }>{ deletionActionLabel(data.Organization.DeletionRequested) }</button></div>
				</form>
			</details>
		}
	} else if data.CanConfirmOwnership {
		<h3 class="ts-section-title">Confirm ownership transfer</h3>
		<form method="post" action="/api/v1/dashboard/organization/members/ownership/confirm">
			<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
			<button class="ts-btn ts-btn-primary" type="submit">Accept ownership</button>
		</form>
	}
}

templ organizationProjectRow(page core.Page, data organizationPageData, project projectView) {
	<tr>
		<td><div class="ts-stack-sm ts-org-project-name"><span class="ts-table-strong">{ project.Name }</span><span class="ts-meta ts-mono">{ project.ID }</span></div></td>
		<td class="ts-muted">{ displayProjectSlug(project.Slug) }</td>
		<td>
			if project.Selected {
				@ui.Badge("success", "Current")
			} else {
				@ui.Badge("neutral", "Available")
			}
		</td>
		<td>
			if project.BackupRegion != "" {
				@ui.Badge("info", strings.ToUpper(project.BackupRegion))
			} else {
				<span class="ts-meta">None</span>
			}
		</td>
		<td class="ts-muted">{ organizationDate(project.CreatedAt) }</td>
		<td class="ts-table-actions">
			<div class="ts-row ts-row-end">
				if !project.Selected {
					<form method="post" action="/api/v1/dashboard/switch-project">
						<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
						<input type="hidden" name="projectId" value={ project.ID }/>
						<input type="hidden" name="returnUrl" value="/organization"/>
						<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Select</button>
					</form>
				}
				if data.CanManage {
						<details { ui.MenuBehavior... } class="ts-menu ts-rename">
							<summary class="ts-btn ts-btn-ghost ts-btn-sm">@icons.Pencil(14)<span>Rename</span></summary>
							<form method="post" action={ "/api/v1/dashboard/organization/projects/" + project.ID + "/rename" } class="ts-menu-panel ts-form ts-org-rename-panel">
								<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
								@ui.Field(ui.FieldProps{ID: "rename-" + project.ID, Label: "Rename project"}) {
									<input class="ts-input" id={ "rename-" + project.ID } name="name" value={ project.Name } required/>
								}
								@regionPlacement(placement{
									RegionsID: "project-regions-" + project.ID, PrimaryID: "project-region-" + project.ID, BackupID: "project-backup-" + project.ID,
									Regions: project.RegionOptions, All: data.Regions, Primary: project.Region, Backup: project.BackupRegion,
									Hint: "Placement changes are applied asynchronously to every project resource.",
								})
								<div class="ts-form-actions"><button class="ts-btn ts-btn-primary ts-btn-sm" type="submit">Save project</button></div>
							</form>
						</details>
				}
			</div>
		</td>
	</tr>
}

// placement configures the shared project-region fieldset used by project
// creation, project rename, and the new-organization wizard.
type placement struct {
	RegionsID, PrimaryID, BackupID string
	Regions                        []regionView
	All                            []string
	Primary, Backup                string
	RequireRegions                 bool
	RequireSelects                 bool
	Hint                           string
}

templ regionPlacement(p placement) {
	<fieldset class="ts-org-placement">
		<legend class="ts-label">Project regions</legend>
		<div class="ts-field">
			<label class="ts-label" for={ p.RegionsID }>Allowed regions</label>
			@ui.RegionMap(p.RegionsID)
			<select class="ts-select" id={ p.RegionsID } name="regions" multiple size={ fmt.Sprint(len(p.Regions)) } required?={ p.RequireRegions } aria-describedby={ p.RegionsID + "-hint" }>
				for _, region := range p.Regions {
					<option value={ region.Code } selected?={ region.Selected }>{ region.Code }</option>
				}
			</select>
		</div>
		@regionSelect(p.PrimaryID, "Primary region", "region", p.All, p.Primary, p.RequireSelects)
		@regionSelect(p.BackupID, "Backup region", "backupRegion", p.All, p.Backup, p.RequireSelects)
		<p class="ts-hint ts-org-placement-hint" id={ p.RegionsID + "-hint" }>{ p.Hint }</p>
	</fieldset>
}

templ regionSelect(id, label, name string, regions []string, selected string, required bool) {
	<div class="ts-field">
		<label class="ts-label" for={ id }>{ label }</label>
		@ui.RegionMap(id)
		<select class="ts-select" id={ id } name={ name } required?={ required }>
			for _, region := range regions {
				<option value={ region } selected?={ region == selected }>{ region }</option>
			}
		</select>
	</div>
}

func hasTransferCandidate(members []memberView) bool {
	for _, member := range members {
		if !member.IsOwner {
			return true
		}
	}
	return false
}

func allSelected(regions []string) []regionView {
	views := make([]regionView, len(regions))
	for i, region := range regions {
		views[i] = regionView{Code: region, Selected: true}
	}
	return views
}

func organizationKindLabel(kind string) string {
	if kind == "personal" {
		return "Personal workspace"
	}
	return "Business workspace"
}

func organizationKindShortLabel(kind string) string {
	if kind == "personal" {
		return "Personal"
	}
	return "Business"
}

func organizationStatusLabel(status string) string {
	if status == "" {
		return "Unknown"
	}
	return strings.ToUpper(status[:1]) + status[1:]
}

func displayProjectID(projectID string) string {
	if projectID == "" {
		return "None"
	}
	return projectID
}

func displayProjectSlug(slug string) string {
	if slug == "" {
		return "None"
	}
	return slug
}

func organizationDate(value string) string {
	createdAt, err := time.Parse(time.RFC3339, value)
	if err != nil {
		return value
	}
	return createdAt.UTC().Format("Jan 2, 2006 15:04 UTC")
}

func organizationDay(value string) string {
	createdAt, err := time.Parse(time.RFC3339, value)
	if err != nil {
		return value
	}
	return createdAt.UTC().Format("Jan 2, 2006")
}

func deletionActionLabel(requested bool) string {
	if requested {
		return "Deletion pending"
	}
	return "Request deletion"
}
