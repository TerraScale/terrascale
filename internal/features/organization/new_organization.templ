package organization

import (
	"fmt"

	"terrascale.tech/dashboard/internal/core"
	"terrascale.tech/dashboard/internal/ui"
	"terrascale.tech/dashboard/internal/ui/icons"
)

// newOrganizationDialog renders the query-driven business-organization wizard.
// Its forms remain ordinary POST forms so every step works without JavaScript.
templ newOrganizationDialog(page core.Page, data organizationPageData) {
	<dialog id="create-organization" class="ts-dialog ts-org-wizard" data-init="el.showModal()" aria-labelledby="create-organization-title" aria-describedby="create-organization-description">
		<div class="ts-dialog-content">
			<div class="ts-row-between ts-org-wizard-head">
				<div class="ts-dialog-header">
					<h2 class="ts-dialog-title" id="create-organization-title">Create organization</h2>
					<p class="ts-dialog-description" id="create-organization-description">Set up a business organization, confirm its billing, then create the first project.</p>
				</div>
				<button class="ts-icon-btn" type="button" aria-label="Close create organization" command="close" commandfor="create-organization">@icons.X(18)</button>
			</div>
			@newOrganizationWizardContent(page, data, "modal")
		</div>
	</dialog>
	<noscript>
		@ui.Card(ui.CardProps{ID: "create-organization-fallback", Title: "Create organization", Description: "Complete the setup steps below. You can return to the organization page at any time.", Actions: closeSetupLink()}) {
			@newOrganizationWizardContent(page, data, "fallback")
		}
	</noscript>
}

templ closeSetupLink() {
	<a class="ts-btn ts-btn-secondary ts-btn-sm" href="/organization">Close setup</a>
}

var wizardSteps = []struct{ Key, Label string }{
	{"organization", "Organization"},
	{"payment", "Billing"},
	{"project", "Project"},
}

templ newOrganizationWizardContent(page core.Page, data organizationPageData, suffix string) {
	<div class="ts-stack-lg">
		<div class="ts-stack-sm">
			<div class="ts-row-between ts-meta">
				<span>Step { fmt.Sprint(organizationWizardCurrentStep(data.NewOrganization)) } of 3</span>
				<span>{ fmt.Sprint(organizationWizardProgress(data.NewOrganization)) }%</span>
			</div>
			<div class="ts-progress" role="progressbar" aria-label="New organization setup progress" aria-valuenow={ fmt.Sprint(organizationWizardProgress(data.NewOrganization)) } aria-valuemin="0" aria-valuemax="100">
				<div class="ts-progress-bar" data-progress={ fmt.Sprint(organizationWizardProgress(data.NewOrganization)) }></div>
			</div>
			<nav aria-label="New organization steps">
				<ol class="ts-org-steps">
					for i, step := range wizardSteps {
						<li
							class={ "ts-org-step", templ.KV("ts-org-step-current", data.NewOrganization == step.Key), templ.KV("ts-org-step-complete", organizationWizardCurrentStep(data.NewOrganization) > i+1) }
							aria-current={ organizationWizardStepCurrent(data.NewOrganization, step.Key) }
						>
							<span class="ts-org-step-icon" aria-hidden="true">
								if organizationWizardCurrentStep(data.NewOrganization) > i+1 {
									@icons.Check(14)
								} else {
									{ fmt.Sprint(i + 1) }
								}
							</span>
							<span class="ts-org-step-label">{ step.Label }</span>
							<span class="ts-sr-only">{ organizationWizardStepState(data.NewOrganization, step.Key) }</span>
						</li>
					}
				</ol>
			</nav>
		</div>
		if data.PaymentCanceled {
			@ui.Alert("warning", "Payment setup canceled", "No payment method was changed. Choose a plan to try checkout again.")
		}
		if data.Error != "" {
			@ui.Alert("danger", "", data.Error)
		}
		switch data.NewOrganization {
			case "payment":
				@wizardStep("organization-payment-title-"+suffix, "Set up billing", "This business organization needs its own paid billing before it can create projects. Your Personal allowance stays separate.") {
					<form class="ts-form" method="post" action="/api/v1/dashboard/organization/new-organization">
						<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
						<input type="hidden" name="step" value="payment-method"/>
						<input type="hidden" name="organizationID" value={ data.NewOrganizationID }/>
						if len(data.Plans) == 0 {
							@ui.Alert("warning", "", "No paid plans are available right now. Contact an administrator before continuing.")
						} else {
							<fieldset>
								<legend class="ts-label">Choose a plan</legend>
								<div class="ts-org-plans">
									for _, plan := range data.Plans {
										<label class="ts-org-plan" for={ "organization-plan-" + plan.Key + "-" + suffix }>
											<input type="radio" id={ "organization-plan-" + plan.Key + "-" + suffix } name="plan" value={ plan.Key } checked?={ plan.Key == organizationDefaultPlan(data.Plans) } required/>
											<span class="ts-strong">{ plan.Name }</span>
											<span class="ts-org-plan-price"><strong>{ plan.MonthlyPrice }</strong> / month</span>
											if plan.AnnualPriceCents > 0 {
												<span class="ts-meta">{ plan.AnnualPrice } billed annually</span>
											} else {
												<span class="ts-meta">Annual billing unavailable</span>
											}
											for _, allowance := range plan.Allowances {
												<span class="ts-meta">{ allowance }</span>
											}
											if plan.Trial != "" {
												@ui.Badge("success", plan.Trial)
											}
										</label>
									}
								</div>
							</fieldset>
							<fieldset>
								<legend class="ts-label">Billing interval</legend>
								<div class="ts-org-intervals">
									<label class="ts-org-interval"><input type="radio" name="interval" value="monthly" checked required/> Monthly</label>
									<label class="ts-org-interval"><input type="radio" name="interval" value="annual"/> Annual</label>
								</div>
							</fieldset>
							if data.Demo {
								<p class="ts-meta">Continue to a local checkout simulation to confirm this organization’s billing. Projects can be created once it’s confirmed.</p>
							} else {
								<p class="ts-meta">Continue to Stripe Checkout to add a payment method. Projects can be created once Stripe confirms billing.</p>
							}
						}
						<div class="ts-form-actions">
							<button class="ts-btn ts-btn-primary ts-btn-lg" type="submit" disabled?={ len(data.Plans) == 0 }>Continue to checkout</button>
						</div>
					</form>
				}
			case "project":
				@wizardStep("organization-project-title-"+suffix, "Create the first project", "Choose a name and deployment placement for this organization’s first project.") {
					<form class="ts-form" method="post" action="/api/v1/dashboard/organization/new-organization">
						<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
						<input type="hidden" name="step" value="project"/>
						<input type="hidden" name="organizationID" value={ data.NewOrganizationID }/>
						@ui.Field(ui.FieldProps{ID: "wizard-project-name-" + suffix, Label: "Project name"}) {
							<input class="ts-input" id={ "wizard-project-name-" + suffix } name="name" maxlength="128" placeholder="Production" required/>
						}
						@regionPlacement(placement{
							RegionsID: "wizard-project-regions-" + suffix, PrimaryID: "wizard-project-region-" + suffix, BackupID: "wizard-project-backup-" + suffix,
							Regions: allSelected(data.Regions), All: data.Regions, RequireRegions: true, RequireSelects: true,
							Hint: "Use your browser’s native picker to select one or more regions. This control also works without the map.",
						})
						<div class="ts-form-actions">
							<button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Create project</button>
						</div>
					</form>
				}
			default:
				@wizardStep("organization-name-title-"+suffix, "Create organization", "A business organization has its own paid billing, members and projects.") {
					<form class="ts-form" method="post" action="/api/v1/dashboard/organization/new-organization">
						<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
						<input type="hidden" name="step" value="organization"/>
						@ui.Field(ui.FieldProps{ID: "new-organization-name-" + suffix, Label: "Organization name"}) {
							<input class="ts-input" id={ "new-organization-name-" + suffix } name="name" maxlength="128" placeholder="Acme Labs" autocomplete="organization" required/>
						}
						<div class="ts-form-actions">
							<button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Create organization</button>
						</div>
					</form>
				}
		}
	</div>
}

// wizardStep titles one wizard step; children are the step's form.
templ wizardStep(id, title, subtitle string) {
	<section class="ts-stack" aria-labelledby={ id }>
		<header class="ts-stack-sm">
			<h3 class="ts-section-title" id={ id }>{ title }</h3>
			<p class="ts-muted">{ subtitle }</p>
		</header>
		{ children... }
	</section>
}

func organizationWizardCurrentStep(step string) int {
	switch step {
	case "payment":
		return 2
	case "project":
		return 3
	default:
		return 1
	}
}

func organizationDefaultPlan(plans []planView) string {
	for _, plan := range plans {
		if plan.Key == "starter" {
			return plan.Key
		}
	}
	if len(plans) == 0 {
		return ""
	}
	return plans[0].Key
}

func organizationWizardProgress(step string) int {
	switch step {
	case "payment":
		return 66
	case "project":
		return 100
	default:
		return 33
	}
}

func organizationWizardStepCurrent(step, target string) string {
	if step == target {
		return "step"
	}
	return "false"
}

func organizationWizardStepState(step, target string) string {
	if step == target {
		return "Current"
	}
	if organizationWizardCurrentStep(step) > organizationWizardCurrentStep(target) {
		return "Completed"
	}
	return "Pending"
}
