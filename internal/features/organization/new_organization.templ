package organization

import "terrascale.tech/dashboard/internal/core"

// newOrganizationDialog renders the query-driven business-organization wizard.
// Its forms remain ordinary POST forms so every step works without JavaScript.
templ newOrganizationDialog(page core.Page, data organizationPageData) {
	<dialog id="create-organization" class="ts-dialog ts-dialog-wizard" data-autoopen aria-labelledby="create-organization-title" aria-describedby="create-organization-description">
		<div class="ts-dialog-wizard-head">
			<div class="ts-dialog-header">
				<h2 class="ts-dialog-title" id="create-organization-title">Create organization</h2>
				<p class="ts-dialog-description" id="create-organization-description">Set up a business organization, confirm its billing, then create the first project.</p>
			</div>
			<button class="ts-icon-btn" type="button" aria-label="Close create organization" data-close-dialog><span aria-hidden="true">×</span></button>
		</div>
		<div class="ts-dialog-content ts-dialog-content-wizard">
			@newOrganizationWizardContent(page, data, "modal")
		</div>
	</dialog>
	<noscript>
		<section class="ts-section ts-org-wizard-fallback" aria-labelledby="create-organization-fallback-title">
			<div class="ts-section-head">
				<div>
					<h2 class="ts-panel-title" id="create-organization-fallback-title">Create organization</h2>
					<p class="ts-meta">Complete the setup steps below. You can return to the organization page at any time.</p>
				</div>
				<a class="ts-btn ts-btn-secondary" href="/organization">Close setup</a>
			</div>
			@newOrganizationWizardContent(page, data, "fallback")
		</section>
	</noscript>
}

templ newOrganizationWizardContent(page core.Page, data organizationPageData, suffix string) {
	<div class="ts-onboarding-container ts-onboarding-container-wide">
		<div class="ts-onboarding-progress">
			<div class="ts-onboarding-progress-meta">
				<span>SETUP STEP { organizationWizardCurrentStep(data.NewOrganization) } OF 3</span>
				<span>{ organizationWizardProgress(data.NewOrganization) }%</span>
			</div>
			<div class="ts-onboarding-progress-frame">
				<div class="ts-progress" role="progressbar" aria-label="New organization setup progress" aria-valuenow={ organizationWizardProgress(data.NewOrganization) } aria-valuemin="0" aria-valuemax="100">
					<div class="ts-progress-bar" data-progress={ organizationWizardProgress(data.NewOrganization) }></div>
				</div>
			</div>
		</div>
		<nav aria-label="New organization steps">
			<ol class="ts-onboarding-steps ts-onboarding-steps-compact">
				<li class={ organizationWizardStepClass(data.NewOrganization, "organization") } aria-current={ organizationWizardStepCurrent(data.NewOrganization, "organization") }>
					<span class="ts-onboarding-step-icon" aria-hidden="true">1</span><span>Organization</span><span class="ts-onboarding-step-state">{ organizationWizardStepState(data.NewOrganization, "organization") }</span>
				</li>
				<li class={ organizationWizardStepClass(data.NewOrganization, "payment") } aria-current={ organizationWizardStepCurrent(data.NewOrganization, "payment") }>
					<span class="ts-onboarding-step-icon" aria-hidden="true">2</span><span>Billing</span><span class="ts-onboarding-step-state">{ organizationWizardStepState(data.NewOrganization, "payment") }</span>
				</li>
				<li class={ organizationWizardStepClass(data.NewOrganization, "project") } aria-current={ organizationWizardStepCurrent(data.NewOrganization, "project") }>
					<span class="ts-onboarding-step-icon" aria-hidden="true">3</span><span>Project</span><span class="ts-onboarding-step-state">{ organizationWizardStepState(data.NewOrganization, "project") }</span>
				</li>
			</ol>
		</nav>
		if data.PaymentCanceled {
			<div class="ts-alert ts-alert-warning" role="alert">
				<span class="ts-onboarding-alert-icon" aria-hidden="true">!</span>
				<div class="ts-onboarding-alert-stack">
					<span class="ts-alert-title">Payment setup canceled</span>
					<span class="ts-alert-body">No payment method was changed. Choose a plan to try checkout again.</span>
				</div>
			</div>
		}
		if data.Error != "" {
			<div class="ts-alert ts-alert-danger" role="alert">{ data.Error }</div>
		}
		if data.NewOrganization == "payment" {
			<section class="ts-onboarding-section" aria-labelledby={ "organization-payment-title-" + suffix }>
				<header class="ts-onboarding-section-header">
					<h3 class="ts-onboarding-step-title" id={ "organization-payment-title-" + suffix }>Set up billing</h3>
					<p class="ts-onboarding-step-subtitle">This business organization needs its own paid billing before it can create projects. Your Personal allowance stays separate.</p>
				</header>
				<form class="ts-onboarding-content ts-org-payment-form" method="post" action="/api/v1/dashboard/organization/new-organization">
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
					<input type="hidden" name="step" value="payment-method"/>
					<input type="hidden" name="organizationID" value={ data.NewOrganizationID }/>
					if len(data.Plans) == 0 {
						<p class="ts-alert ts-alert-warning" role="status">No paid plans are available right now. Contact an administrator before continuing.</p>
					} else {
						<fieldset class="ts-org-plan-fieldset">
							<legend class="ts-label">Choose a plan</legend>
							<div class="ts-onboarding-plans">
								for _, plan := range data.Plans {
									<label class="ts-org-plan-choice" for={ "organization-plan-" + plan.Key + "-" + suffix }>
										<input class="ts-org-plan-radio" type="radio" id={ "organization-plan-" + plan.Key + "-" + suffix } name="plan" value={ plan.Key } checked?={ plan.Key == organizationDefaultPlan(data.Plans) } required/>
										<span class="ts-org-plan-choice-body">
											<span class="ts-onboarding-plan-name">{ plan.Name }</span>
											<span class="ts-onboarding-plan-price-row"><strong>{ plan.MonthlyPrice }</strong><span> / month</span></span>
											if plan.AnnualPriceCents > 0 {
												<span class="ts-org-plan-annual-price">{ plan.AnnualPrice } billed annually</span>
											} else {
												<span class="ts-org-plan-annual-price">Annual billing unavailable</span>
											}
										</span>
									</label>
								}
							</div>
						</fieldset>
						<fieldset class="ts-org-interval-fieldset">
							<legend class="ts-label">Billing interval</legend>
							<div class="ts-org-billing-intervals">
								<label><input type="radio" name="interval" value="monthly" checked required/> Monthly</label>
								<label><input type="radio" name="interval" value="annual"/> Annual</label>
							</div>
						</fieldset>
						<p class="ts-meta ts-org-billing-note">Continue to the demo checkout to confirm this organization’s billing before project creation.</p>
					}
					<div class="ts-onboarding-form-footer">
						<button class="ts-btn ts-btn-primary ts-btn-lg" type="submit" disabled?={ len(data.Plans) == 0 }>Continue to checkout</button>
					</div>
				</form>
			</section>
		} else if data.NewOrganization == "project" {
			<section class="ts-onboarding-section" aria-labelledby={ "organization-project-title-" + suffix }>
				<header class="ts-onboarding-section-header">
					<h3 class="ts-onboarding-step-title" id={ "organization-project-title-" + suffix }>Create the first project</h3>
					<p class="ts-onboarding-step-subtitle">Choose a name and deployment placement for this organization’s first project.</p>
				</header>
				<form class="ts-onboarding-content ts-org-project-wizard-form" method="post" action="/api/v1/dashboard/organization/new-organization">
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
					<input type="hidden" name="step" value="project"/>
					<input type="hidden" name="organizationID" value={ data.NewOrganizationID }/>
					<div class="ts-onboarding-field-list">
						<div class="ts-field">
							<label class="ts-label" for={ "wizard-project-name-" + suffix }>Project name</label>
							<input class="ts-input" id={ "wizard-project-name-" + suffix } name="name" maxlength="128" placeholder="Production" required/>
						</div>
						<fieldset class="ts-field ts-org-regions-fieldset">
							<legend class="ts-label">Project regions</legend>
							<label class="ts-label" for={ "wizard-project-regions-" + suffix }>Choose the regions where project resources may run</label>
							<select class="ts-select" id={ "wizard-project-regions-" + suffix } name="regions" multiple required aria-describedby={ "wizard-project-regions-hint-" + suffix }>
								for _, region := range data.Regions {
									<option value={ region } selected>{ region }</option>
								}
							</select>
							<p class="ts-hint" id={ "wizard-project-regions-hint-" + suffix }>Use your browser’s native picker to select one or more regions. This control also works without the map.</p>
							<ts-region-map data-src="/brand/region-map.svg" data-select-id={ "wizard-project-regions-" + suffix } aria-hidden="true"></ts-region-map>
						</fieldset>
						<div class="ts-field">
							<label class="ts-label" for={ "wizard-project-region-" + suffix }>Primary region</label>
							<select class="ts-select" id={ "wizard-project-region-" + suffix } name="region" required>
								for _, region := range data.Regions {
									<option value={ region }>{ region }</option>
								}
							</select>
							<ts-region-map data-src="/brand/region-map.svg" data-select-id={ "wizard-project-region-" + suffix } aria-hidden="true"></ts-region-map>
						</div>
						<div class="ts-field">
							<label class="ts-label" for={ "wizard-project-backup-" + suffix }>Backup region</label>
							<select class="ts-select" id={ "wizard-project-backup-" + suffix } name="backupRegion" required>
								for _, region := range data.Regions {
									<option value={ region }>{ region }</option>
								}
							</select>
							<ts-region-map data-src="/brand/region-map.svg" data-select-id={ "wizard-project-backup-" + suffix } aria-hidden="true"></ts-region-map>
						</div>
					</div>
					<div class="ts-onboarding-form-footer">
						<button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Create project</button>
					</div>
				</form>
			</section>
		} else {
			<section class="ts-onboarding-section" aria-labelledby={ "organization-name-title-" + suffix }>
				<header class="ts-onboarding-section-header">
					<h3 class="ts-onboarding-step-title" id={ "organization-name-title-" + suffix }>Create organization</h3>
					<p class="ts-onboarding-step-subtitle">A business organization has its own paid billing, members and projects.</p>
				</header>
				<form class="ts-onboarding-content" method="post" action="/api/v1/dashboard/organization/new-organization">
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
					<input type="hidden" name="step" value="organization"/>
					<div class="ts-field">
						<label class="ts-label" for={ "new-organization-name-" + suffix }>Organization name</label>
						<input class="ts-input" id={ "new-organization-name-" + suffix } name="name" maxlength="128" placeholder="Acme Labs" autocomplete="organization" required/>
					</div>
					<div class="ts-onboarding-form-footer">
						<button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Create organization</button>
					</div>
				</form>
			</section>
		}
	</div>
}

func organizationWizardCurrentStep(step string) int {
	switch step {
	case "payment":
		return 2
	case "project":
		return 3
	default:
		return 1
	}
}

func organizationDefaultPlan(plans []planView) string {
	for _, plan := range plans {
		if plan.Key == "starter" {
			return plan.Key
		}
	}
	if len(plans) == 0 {
		return ""
	}
	return plans[0].Key
}

func organizationWizardProgress(step string) int {
	switch step {
	case "payment":
		return 66
	case "project":
		return 100
	default:
		return 33
	}
}

func organizationWizardStepClass(step, target string) string {
	if step == target {
		return "ts-onboarding-step ts-onboarding-step-current"
	}
	if organizationWizardCurrentStep(step) > organizationWizardCurrentStep(target) {
		return "ts-onboarding-step ts-onboarding-step-complete"
	}
	return "ts-onboarding-step"
}

func organizationWizardStepCurrent(step, target string) string {
	if step == target {
		return "step"
	}
	return "false"
}

func organizationWizardStepState(step, target string) string {
	if step == target {
		return "Current"
	}
	if organizationWizardCurrentStep(step) > organizationWizardCurrentStep(target) {
		return "Completed"
	}
	return "Pending"
}
