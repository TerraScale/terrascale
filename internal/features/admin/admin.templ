package admin

import "net/url"
import "strconv"

import (
	"terrascale.tech/dashboard/internal/core"
	"terrascale.tech/dashboard/internal/ui"
)

func adminPlatformAdminCount(rows []userRow) int {
	count := 0
	for _, row := range rows {
		if row.PlatformAdmin {
			count++
		}
	}
	return count
}

func adminOrganizationOwnerCount(rows []organizationRow) int {
	count := 0
	for _, row := range rows {
		if row.OwnerEmail != "" {
			count++
		}
	}
	return count
}

func adminProjectDatabaseCount(rows []projectRow) int {
	count := 0
	for _, row := range rows {
		count += row.DatabaseCount
	}
	return count
}

func adminDatabaseRegionCount(rows []databaseRow) int {
	count := 0
	for _, row := range rows {
		if row.Region != "Not recorded" {
			count++
		}
	}
	return count
}

func adminVisiblePlanCount(plans []core.Plan) int {
	count := 0
	for _, plan := range plans {
		if plan.Visible {
			count++
		}
	}
	return count
}

func estateTabs(active string) []ui.Tab {
	return []ui.Tab{
		{Label: "Regions", URL: "/admin/estate?tab=regions", Active: active == "regions"},
		{Label: "Hosts", URL: "/admin/estate?tab=hosts", Active: active == "hosts"},
		{Label: "Operations", URL: "/admin/estate?tab=operations", Active: active == "operations"},
	}
}

func adminDescription(section string) string {
	switch section {
	case "users":
		return "Review registered accounts and platform administrator access in the demo store."
	case "organizations":
		return "View organizations and their owner and project relationships."
	case "projects":
		return "Review projects, their recorded regions, and linked databases."
	case "databases":
		return "Review database inventory from the demo store. Version details are unavailable here."
	case "estate":
		return "Review region placement recorded on projects and databases. Provider availability is not reported."
	case "usage":
		return "View in-memory inventory totals. Provider-metered usage is unavailable."
	}
	return "Create and manage pricing plans stored in the dashboard demo."
}

templ adminView(data pageData, csrfToken string) {
	<main class="ts-page ts-admin">
		@ui.PageHeader(ui.Header{Eyebrow: "Administration", Title: data.Title, Description: adminDescription(data.Section)})
		if data.Notice != "" {
			@ui.Alert("success", "", data.Notice)
		}
		if data.Error != "" {
			@ui.Alert("danger", "", data.Error)
		}
		if data.Section != "usage" && data.Section != "estate" {
			<div class="ts-toolbar">
				@filterForm(templ.SafeURL("/admin/"+data.Section), "admin-query", "Filter "+data.Title, "Filter "+data.Title, data.Query, "")
			</div>
		}
		switch data.Section {
			case "users":
				@usersSection(data, csrfToken)
			case "organizations":
				@organizationsSection(data, csrfToken)
			case "projects":
				@projectsSection(data, csrfToken)
			case "databases":
				@databasesSection(data)
			case "estate":
				@estateSection(data, csrfToken)
			case "usage":
				@usageSection(data)
			default:
				@plansSection(data, csrfToken)
		}
	</main>
}

// filterForm is the GET search form shared by every filterable list; tab keeps
// the estate sub-tab selected across searches.
templ filterForm(action templ.SafeURL, id, label, placeholder, query, tab string) {
	<form class="ts-filters ts-admin-filters" method="get" action={ action } role="search">
		if tab != "" {
			<input type="hidden" name="tab" value={ tab }/>
		}
		<label class="ts-sr-only" for={ id }>{ label }</label>
		<input class="ts-input ts-input-sm" id={ id } name="q" type="search" maxlength="200" value={ query } placeholder={ placeholder }/>
		<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Filter</button>
		if query != "" {
			if tab != "" {
				<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ action + templ.SafeURL("?tab="+tab) }>Clear</a>
			} else {
				<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ action }>Clear</a>
			}
		}
	</form>
}

// recordName is the bold name plus identifier shown in the first column.
templ recordName(name, id string) {
	<div class="ts-list-main">
		<span class="ts-strong">{ name }</span>
		<code class="ts-admin-id">{ id }</code>
	</div>
}

templ nameField(name string) {
	<label class="ts-admin-inline-field"><span class="ts-sr-only">Name</span><input class="ts-input ts-input-sm" name="name" maxlength="128" value={ name } required/></label>
}

templ usersSection(data pageData, csrfToken string) {
	@ui.Stats("Matching user summary") {
		@ui.Stat("Matching accounts", strconv.Itoa(len(data.Users)), "Accounts shown for this filter")
		@ui.Stat("Platform administrators", strconv.Itoa(adminPlatformAdminCount(data.Users)), "Among the matching accounts")
	}
	@ui.Card(ui.CardProps{ID: "admin-users", Title: "Registered accounts", Description: "Account details and platform access in the in-memory demo.", Flush: true}) {
		if len(data.Users) > 0 {
			<div class="ts-table-wrap">
				<table class="ts-table">
					<caption class="ts-sr-only">Registered accounts matching the current filter</caption>
					<thead><tr><th scope="col">User</th><th scope="col">Account</th><th scope="col" class="ts-num">Organizations</th><th scope="col" class="ts-num">Projects</th><th scope="col">Created</th><th scope="col">Management</th></tr></thead>
					<tbody>
						for _, row := range data.Users {
							<tr>
								<td>
									<div class="ts-list-main">
										<span class="ts-strong">{ row.Name }</span>
										<span class="ts-meta">{ row.Email }</span>
										if row.PlatformAdmin {
											@ui.Badge("warning", "Platform administrator")
										} else {
											@ui.Badge("neutral", "Standard account")
										}
									</div>
								</td>
								<td>
									<div class="ts-list-main">
										<code class="ts-admin-id">{ row.AccountID }</code>
										<span class="ts-meta">User ID</span>
										<code class="ts-admin-id">{ row.UserID }</code>
									</div>
								</td>
								<td class="ts-num">{ strconv.Itoa(row.OrganizationCount) }</td>
								<td class="ts-num">{ strconv.Itoa(row.ProjectCount) }</td>
								<td class="ts-meta ts-admin-date">{ row.CreatedAt }</td>
								<td>
									<form class="ts-admin-action-form" method="post" action={ "/api/v1/admin/users/" + row.AccountID }>
										<input type="hidden" name="_csrf" value={ csrfToken }/>
										@nameField(row.Name)
										<label class="ts-admin-inline-field">
											<span class="ts-sr-only">Access</span>
											<select class="ts-input ts-input-sm" name="platformAdmin">
												<option value="false" selected?={ !row.PlatformAdmin }>Standard account</option>
												<option value="true" selected?={ row.PlatformAdmin }>Platform administrator</option>
											</select>
										</label>
										<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Save user</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			@ui.Empty("No matching accounts", "Try another name, email address, or user ID.")
		}
	}
}

templ organizationsSection(data pageData, csrfToken string) {
	@ui.Stats("Matching organization summary") {
		@ui.Stat("Matching organizations", strconv.Itoa(len(data.Organizations)), "Organization records shown")
		@ui.Stat("With owner accounts", strconv.Itoa(adminOrganizationOwnerCount(data.Organizations)), "Owner email is recorded")
	}
	@ui.Card(ui.CardProps{ID: "admin-organizations", Title: "Organizations", Description: "Owner, project, status, and creation details for matching organizations.", Flush: true}) {
		if len(data.Organizations) > 0 {
			<div class="ts-table-wrap">
				<table class="ts-table">
					<caption class="ts-sr-only">Organizations matching the current filter</caption>
					<thead><tr><th scope="col">Organization</th><th scope="col">Owner</th><th scope="col">Status</th><th scope="col" class="ts-num">Projects</th><th scope="col">Created</th><th scope="col">Management</th></tr></thead>
					<tbody>
						for _, row := range data.Organizations {
							<tr>
								<td>
									@recordName(row.Name, row.ID)
								</td>
								<td>{ adminFallback(row.OwnerEmail, "Owner account unavailable") }</td>
								<td>
									@ui.Badge("neutral", adminFallback(row.Status, "Unknown"))
								</td>
								<td class="ts-num">{ strconv.Itoa(row.ProjectCount) }</td>
								<td class="ts-meta ts-admin-date">{ row.CreatedAt }</td>
								<td>
									<div class="ts-row">
										<form class="ts-admin-action-form" method="post" action={ "/api/v1/admin/organizations/" + row.AccountID + "/" + row.ID }>
											<input type="hidden" name="_csrf" value={ csrfToken }/>
											@nameField(row.Name)
											<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Save organization</button>
										</form>
										<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ "/admin/projects?q=" + url.QueryEscape(row.ID) }>View projects</a>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			@ui.Empty("No matching organizations", "Try another organization, owner email, or status.")
		}
	}
}

templ projectsSection(data pageData, csrfToken string) {
	@ui.Stats("Matching project summary") {
		@ui.Stat("Matching projects", strconv.Itoa(len(data.Projects)), "Project records shown")
		@ui.Stat("Databases in matching projects", strconv.Itoa(adminProjectDatabaseCount(data.Projects)), "Linked database records")
	}
	@ui.Card(ui.CardProps{ID: "admin-projects", Title: "Projects", Description: "Organization, placement, status, and database counts for matching projects.", Flush: true}) {
		if len(data.Projects) > 0 {
			<div class="ts-table-wrap">
				<table class="ts-table">
					<caption class="ts-sr-only">Projects matching the current filter</caption>
					<thead><tr><th scope="col">Project</th><th scope="col">Organization</th><th scope="col">Region</th><th scope="col">Status</th><th scope="col" class="ts-num">Databases</th><th scope="col">Created</th><th scope="col">Management</th></tr></thead>
					<tbody>
						for _, row := range data.Projects {
							<tr>
								<td>
									@recordName(row.Name, row.ID)
								</td>
								<td>{ row.Organization }</td>
								<td>{ adminFallback(row.Region, "Not recorded") }</td>
								<td>
									@ui.Badge("neutral", adminFallback(row.Status, "Unknown"))
								</td>
								<td class="ts-num">{ strconv.Itoa(row.DatabaseCount) }</td>
								<td class="ts-meta ts-admin-date">{ row.CreatedAt }</td>
								<td>
									<form class="ts-admin-action-form" method="post" action={ "/api/v1/admin/projects/" + row.AccountID + "/" + row.OrganizationID + "/" + row.ID }>
										<input type="hidden" name="_csrf" value={ csrfToken }/>
										@nameField(row.Name)
										<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Save project</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			@ui.Empty("No matching projects", "Try another project, organization, region, or status.")
		}
	}
}

templ databasesSection(data pageData) {
	@ui.Stats("Matching database summary") {
		@ui.Stat("Matching databases", strconv.Itoa(len(data.Databases)), "Database records shown")
		@ui.Stat("With recorded region", strconv.Itoa(adminDatabaseRegionCount(data.Databases)), "Region value is present in the store")
	}
	@ui.Card(ui.CardProps{ID: "admin-databases", Title: "Database inventory", Description: "Region and status are recorded values. Version details are not represented by this demo.", Flush: true}) {
		if len(data.Databases) > 0 {
			<div class="ts-table-wrap">
				<table class="ts-table">
					<caption class="ts-sr-only">Databases matching the current filter</caption>
					<thead><tr><th scope="col">Database</th><th scope="col">Organization</th><th scope="col">Project</th><th scope="col">Region</th><th scope="col">Status</th><th scope="col">Created</th></tr></thead>
					<tbody>
						for _, row := range data.Databases {
							<tr>
								<td>
									@recordName(row.Name, row.ID)
								</td>
								<td>{ row.Organization }</td>
								<td>{ row.Project }</td>
								<td>{ row.Region }</td>
								<td>
									@ui.Badge("neutral", row.Status)
								</td>
								<td class="ts-meta ts-admin-date">{ row.CreatedAt }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			@ui.Empty("No matching databases", "Try another database, project, organization, region, or status.")
		}
	}
}

templ estateSection(data pageData, csrfToken string) {
	@ui.Stats("Estate inventory summary") {
		@ui.Stat("Demo region codes", strconv.Itoa(data.EstateRegionCount), "Supported local codes; availability is not reported")
		@ui.Stat("Database records", strconv.Itoa(data.EstateDatabaseCount), "Unique databases in the dashboard store")
		@ui.Stat("Recorded requests", strconv.Itoa(data.EstateActionCount), "Product-action audit entries in this process")
	}
	@ui.Tabs("Estate sections", estateTabs(data.EstateTab))
	switch data.EstateTab {
		case "regions":
			@ui.Card(ui.CardProps{ID: "admin-estate-regions", Title: "Regions", Description: "Recorded database and project placements across the three supported demo region codes. Provider availability is not reported by this local store.", Flush: true}) {
				if len(data.Regions) > 0 {
					<div class="ts-table-wrap">
						<table class="ts-table">
							<caption class="ts-sr-only">Database and project placements recorded for demo region codes</caption>
							<thead><tr><th scope="col">Region</th><th scope="col" class="ts-num">Project placements</th><th scope="col" class="ts-num">Database records</th><th scope="col">Provider availability</th></tr></thead>
							<tbody>
								for _, row := range data.Regions {
									<tr>
										<td>
											@recordName(adminFallback(row.Location, row.Region), row.Region)
										</td>
										<td class="ts-num">{ strconv.Itoa(row.ObservedProjects) }</td>
										<td class="ts-num">{ strconv.Itoa(row.ObservedDatabases) }</td>
										<td>
											@ui.Badge("neutral", "Not reported")
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				} else {
					@ui.Empty("No recorded region matches this filter", "Clear the filter to see all supported demo codes.")
				}
			}
		case "hosts":
			@ui.Card(ui.CardProps{ID: "admin-estate-hosts", Title: "Hosts", Description: "Provider host inventory and host health are unavailable from this local dashboard store.", Actions: filterForm("/admin/estate", "admin-estate-host-query", "Filter recorded database records", "Filter database records", data.Query, "hosts"), Flush: true}) {
				<div class="ts-admin-card-note">
					@ui.Alert("warning", "", "The rows below are recorded database records and placement values. They are not provider hosts or host telemetry.")
				</div>
				if len(data.EstateDatabases) > 0 {
					<div class="ts-table-wrap">
						<table class="ts-table">
							<caption class="ts-sr-only">Dashboard database records and recorded placements</caption>
							<thead><tr><th scope="col">Database record</th><th scope="col">Recorded region</th><th scope="col">Recorded status</th><th scope="col">Created</th></tr></thead>
							<tbody>
								for _, row := range data.EstateDatabases {
									<tr>
										<td>
											@recordName(row.Name, row.ID)
										</td>
										<td>{ row.Region }</td>
										<td>
											@ui.Badge("neutral", row.Status)
										</td>
										<td class="ts-meta ts-admin-date">{ row.CreatedAt }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				} else {
					@ui.Empty("No matching database records", "Try another database, project, organization, region, or status.")
				}
			}
		default:
			<div class="ts-page-heading">
				<h2 class="ts-section-title" id="estate-operations-title">Operations</h2>
				<p class="ts-meta">Demo product-action requests are recorded for review. This page has no provider operation or live estate telemetry contract.</p>
			</div>
			<div class="ts-split">
				@ui.Card(ui.CardProps{ID: "admin-estate-action-log", Title: "Recorded actions", Description: "Platform-wide entries for this in-memory demo.", Flush: true}) {
					if len(data.EstateActions) > 0 {
						<div class="ts-table-wrap">
							<table class="ts-table">
								<caption class="ts-sr-only">Recorded platform administrator estate actions, newest first</caption>
								<thead><tr><th scope="col">Action</th><th scope="col">Target</th><th scope="col">Reason</th><th scope="col">Actor user ID</th><th scope="col">Recorded</th></tr></thead>
								<tbody>
									for _, row := range data.EstateActions {
										<tr>
											<td class="ts-strong">{ row.Action }</td>
											<td><code class="ts-admin-id">{ row.Target }</code></td>
											<td>{ row.Reason }</td>
											<td><code class="ts-admin-id">{ row.ActorUserID }</code></td>
											<td class="ts-meta ts-admin-date"><time datetime={ row.RecordedAt.Format("2006-01-02T15:04:05Z07:00") }>{ formatTime(row.RecordedAt) }</time></td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					} else {
						@ui.Empty("No actions recorded", "Submitted product actions will appear here with their audit details.")
					}
				}
				@ui.Card(ui.CardProps{ID: "admin-estate-actions", Title: "Product actions", Description: "Each request records the administrator, action, target, reason, and time."}) {
					@ui.Alert("warning", "", "Record only: this demo does not change infrastructure, billing, tenant state, or access.")
					<form class="ts-form" method="post" action="/api/v1/admin/estate/action">
						<input type="hidden" name="_csrf" value={ csrfToken }/>
						@ui.Field(ui.FieldProps{ID: "admin-estate-action", Label: "Action"}) {
							<select class="ts-input" id="admin-estate-action" name="action" required>
								<option value="pause">Pause database</option>
								<option value="resume">Resume database</option>
								<option value="guard">Set guard</option>
								<option value="spendCap">Set spend cap</option>
								<option value="trial">Adjust trial</option>
								<option value="refund">Issue refund</option>
								<option value="reaperExemption">Set reaper exemption</option>
								<option value="flag">Set feature flag</option>
								<option value="viewAs">View as tenant</option>
							</select>
						}
						@ui.Field(ui.FieldProps{ID: "admin-estate-target", Label: "Target"}) {
							<input class="ts-input" id="admin-estate-target" name="targetId" placeholder="Tenant, database, or organization ID" required/>
						}
						@ui.Field(ui.FieldProps{ID: "admin-estate-reason", Label: "Reason", Hint: "Accepted requests appear in this demo's in-memory audit log."}) {
							<textarea class="ts-input" id="admin-estate-reason" name="reason" rows="3" minlength="3" maxlength="1000" required></textarea>
						}
						<div class="ts-form-actions">
							<button type="submit" class="ts-btn ts-btn-primary">Record action</button>
						</div>
					</form>
				}
			</div>
	}
}

templ usageSection(data pageData) {
	@ui.Stats("In-memory inventory totals") {
		@ui.Stat("Accounts", strconv.Itoa(data.Inventory.Accounts), "Registered demo accounts")
		@ui.Stat("Organizations", strconv.Itoa(data.Inventory.Organizations), "Unique organization records")
		@ui.Stat("Projects", strconv.Itoa(data.Inventory.Projects), "Unique project records")
		@ui.Stat("Databases", strconv.Itoa(data.Inventory.Databases), "Unique database records")
	}
	@ui.Card(ui.CardProps{ID: "admin-usage", Title: "Demo inventory", Description: "These totals describe records in the dashboard's in-memory store."}) {
		@ui.Alert("warning", "", "Live request, storage, and provider usage metrics are not available in this demo.")
	}
}

templ plansSection(data pageData, csrfToken string) {
	@ui.Stats("Matching plan summary") {
		@ui.Stat("Matching plans", strconv.Itoa(len(data.Plans)), "Plan records shown")
		@ui.Stat("Visible plans shown", strconv.Itoa(adminVisiblePlanCount(data.Plans)), "Among the matching plans")
	}
	@ui.Card(ui.CardProps{ID: "admin-plans", Title: "Plan catalog", Description: "Current pricing plan values from the demo store. Amounts are displayed in cents.", Flush: true}) {
		if len(data.Plans) > 0 {
			<div class="ts-table-wrap">
				<table class="ts-table">
					<caption class="ts-sr-only">Pricing plans matching the current filter</caption>
					<thead><tr><th scope="col">Plan</th><th scope="col" class="ts-num">Monthly price</th><th scope="col" class="ts-num">Annual price</th><th scope="col" class="ts-num">Trial</th><th scope="col" class="ts-num">Storage</th><th scope="col" class="ts-num">Monthly requests</th><th scope="col">Visibility</th><th scope="col">Actions</th></tr></thead>
					<tbody>
						for _, plan := range data.Plans {
							<tr>
								<td>
									<div class="ts-list-main">
										<span class="ts-strong">{ plan.Name }</span>
										<code class="ts-admin-id">{ plan.Key }</code>
										<span class="ts-meta">Plan ID <code class="ts-admin-id">{ plan.ID }</code></span>
									</div>
								</td>
								<td class="ts-num">{ strconv.FormatInt(plan.PriceCents, 10) } cents</td>
								<td class="ts-num">{ strconv.FormatInt(plan.AnnualPriceCents, 10) } cents</td>
								<td class="ts-num">{ strconv.Itoa(plan.TrialDays) } days</td>
								<td class="ts-num">{ strconv.FormatInt(plan.StorageMiB, 10) } MiB</td>
								<td class="ts-num">{ strconv.FormatInt(plan.MonthlyRequests, 10) }</td>
								<td>
									if plan.Visible {
										@ui.Badge("success", "Visible")
									} else {
										@ui.Badge("neutral", "Hidden")
									}
								</td>
								<td>
									<div class="ts-row ts-admin-nowrap">
										<form method="post" action={ "/api/v1/admin/plans/" + plan.ID + "/visibility" }>
											<input type="hidden" name="_csrf" value={ csrfToken }/><input type="hidden" name="visible" value={ planVisibilityValue(plan.Visible) }/>
											<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">{ planVisibilityLabel(plan.Visible) }</button>
										</form>
										<form method="post" action={ "/api/v1/admin/plans/" + plan.ID + "/delete" }>
											<input type="hidden" name="_csrf" value={ csrfToken }/>
											<button class="ts-btn ts-btn-danger ts-btn-sm" type="submit">Delete plan</button>
										</form>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			@ui.Empty("No matching plans", "Try another plan name, key, or ID.")
		}
	}
	@ui.Card(ui.CardProps{ID: "admin-plan-create", Title: "Create a plan", Description: "Add a plan to the in-memory demo catalog."}) {
		@planForm(csrfToken, core.Plan{Visible: true}, true)
	}
	if len(data.Plans) > 0 {
		@ui.Card(ui.CardProps{ID: "admin-plan-edit", Title: "Edit plans", Description: "Open a plan to update its limits, prices, or visibility."}) {
			<div class="ts-admin-plan-list">
				for _, plan := range data.Plans {
					<details class="ts-admin-plan">
						<summary>
							<span class="ts-strong">{ plan.Name }</span>
							<code class="ts-admin-id">{ plan.Key }</code>
						</summary>
						@planForm(csrfToken, plan, false)
					</details>
				}
			</div>
		}
	}
}

// planForm creates a plan when isNew, otherwise edits plan in place; the
// key of an existing plan is submitted but read-only.
templ planForm(csrfToken string, plan core.Plan, isNew bool) {
	<form class="ts-form" method="post" action="/api/v1/admin/plans">
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		if !isNew {
			<input type="hidden" name="planID" value={ plan.ID }/>
		}
		<fieldset>
			if isNew {
				<legend class="ts-sr-only">Plan details</legend>
			} else {
				<legend class="ts-sr-only">Edit { plan.Name }</legend>
			}
			<div class="ts-form-grid">
				@ui.Field(ui.FieldProps{ID: planFieldID(plan, isNew, "key"), Label: "Key"}) {
					<input
						class="ts-input"
						id={ planFieldID(plan, isNew, "key") }
						name="key"
						maxlength="64"
						if !isNew {
							value={ plan.Key }
						}
						pattern="[a-z0-9][a-z0-9_-]*"
						required
						if !isNew {
							readonly
						}
					/>
				}
				@ui.Field(ui.FieldProps{ID: planFieldID(plan, isNew, "name"), Label: "Name"}) {
					<input class="ts-input" id={ planFieldID(plan, isNew, "name") } name="name" maxlength="128" value={ plan.Name } required/>
				}
				@planNumberField(planFieldID(plan, isNew, "price"), "Monthly price (cents)", "priceCents", strconv.FormatInt(plan.PriceCents, 10))
				@planNumberField(planFieldID(plan, isNew, "annual"), "Annual price (cents)", "annualPriceCents", strconv.FormatInt(plan.AnnualPriceCents, 10))
				@planNumberField(planFieldID(plan, isNew, "trial"), "Trial days", "trialDays", strconv.Itoa(plan.TrialDays))
				@planNumberField(planFieldID(plan, isNew, "storage"), "Storage (MiB)", "storageMiB", strconv.FormatInt(plan.StorageMiB, 10))
				@planNumberField(planFieldID(plan, isNew, "requests"), "Monthly requests", "monthlyRequests", strconv.FormatInt(plan.MonthlyRequests, 10))
				@ui.Field(ui.FieldProps{ID: planFieldID(plan, isNew, "visible"), Label: "Visibility"}) {
					<select class="ts-input" id={ planFieldID(plan, isNew, "visible") } name="visible">
						<option value="true" selected?={ plan.Visible }>Visible</option>
						<option value="false" selected?={ !plan.Visible }>Hidden</option>
					</select>
				}
			</div>
		</fieldset>
		<div class="ts-form-actions">
			if isNew {
				<button class="ts-btn ts-btn-primary" type="submit">Create plan</button>
			} else {
				<button class="ts-btn ts-btn-primary" type="submit">Save plan</button>
			}
		</div>
	</form>
}

templ planNumberField(id, label, name, value string) {
	@ui.Field(ui.FieldProps{ID: id, Label: label}) {
		<input class="ts-input" id={ id } name={ name } type="number" min="0" value={ value } required/>
	}
}

func planFieldID(plan core.Plan, isNew bool, field string) string {
	if isNew {
		return "admin-plan-create-" + field
	}
	return "admin-plan-" + plan.ID + "-" + field
}
