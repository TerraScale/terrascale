package access

import (
	"fmt"
	"strings"
	"terrascale.tech/dashboard/internal/core"
)

templ accessPageView(page core.Page, data pageData) {
	<main id="access-page" class="ts-page ts-access-page">
		if data.Error != "" {
			<div class="ts-alert ts-alert-warning" role="alert"><span class="ts-alert-title">{ data.Error }</span></div>
		}
		if data.InviteURL != "" {
			<section class="ts-alert ts-alert-success" aria-labelledby="invitation-link-title">
				<strong id="invitation-link-title">Invitation created</strong>
				<p>Share this one-time link with the invitee. It will only be shown again if you resend the invitation.</p>
				<a class="ts-link" href={ data.InviteURL } rel="noreferrer">{ data.InviteURL }</a>
			</section>
		}
		<div class="ts-toolbar">
			<ts-tabs>
				<nav class="ts-tabs" aria-label="Team sections">
					<a class={ accessTabClass(data.Tab, "overview") } aria-current={ accessTabCurrent(data.Tab, "overview") } aria-selected={ accessTabSelected(data.Tab, "overview") } href="/access">Overview</a>
					<a class={ accessTabClass(data.Tab, "members") } aria-current={ accessTabCurrent(data.Tab, "members") } aria-selected={ accessTabSelected(data.Tab, "members") } href="/access?tab=members">Members</a>
					<a class={ accessTabClass(data.Tab, "projects") } aria-current={ accessTabCurrent(data.Tab, "projects") } aria-selected={ accessTabSelected(data.Tab, "projects") } href="/access?tab=projects">Projects</a>
					<a class={ accessTabClass(data.Tab, "invitations") } aria-current={ accessTabCurrent(data.Tab, "invitations") } aria-selected={ accessTabSelected(data.Tab, "invitations") } href="/access?tab=invitations">Invitations</a>
				</nav>
			</ts-tabs>
			if data.Tab == "members" {
				<form id="access-filter-form" method="get" action="/access" class="ts-filters ts-access-filters" role="search" aria-label="Filter members" data-on:submit="@get('/access', {contentType:'form'})">
					<input type="hidden" name="tab" value="members"/>
					<div class="ts-filter-field ts-access-search-field">
						<label class="ts-sr-only" for="member-search">Filter members</label>
						<div class="ts-access-search-box">
							<input class="ts-input" id="member-search" name="q" type="search" placeholder="Search members" value={ data.Query }/>
						</div>
					</div>
					<div class="ts-filter-field">
						<span class="ts-filter-label ts-sr-only" id="member-role-filter-label">Organization role</span>
						<input type="hidden" name="role" value={ roleFilterValue(data.RoleFilter) }/>
						<ts-menu>
							<details class="ts-menu ts-menu-end ts-filter-menu">
								<summary class="ts-select ts-filter-select ts-filter-trigger" aria-labelledby="member-role-filter-label member-role-filter-value"><span id="member-role-filter-value">{ roleFilterLabel(data.RoleFilter) }</span></summary>
								<div class="ts-menu-panel">
									<button class="ts-menu-item" type="button" data-filter-value="" aria-current={ accessFilterCurrent(data.RoleFilter, "all") }>All roles</button>
									<button class="ts-menu-item" type="button" data-filter-value="owner" aria-current={ accessFilterCurrent(data.RoleFilter, "owner") }>Organization owner</button>
									<button class="ts-menu-item" type="button" data-filter-value="member" aria-current={ accessFilterCurrent(data.RoleFilter, "member") }>Member</button>
									<button class="ts-menu-item" type="button" data-filter-value="viewer" aria-current={ accessFilterCurrent(data.RoleFilter, "viewer") }>Viewer</button>
								</div>
							</details>
						</ts-menu>
					</div>
					if data.Query != "" || data.RoleFilter != "all" {
						<a class="ts-btn ts-btn-ghost" href="/access?tab=members">Clear</a>
					}
					<button class="ts-sr-only" type="submit">Apply filters</button>
				</form>
			}
		</div>
		if data.Tab == "overview" {
			<section class="ts-section" aria-labelledby="team-overview-title">
				<div class="ts-section-head">
					<div>
						<h1 class="ts-panel-title" id="team-overview-title">Team overview</h1>
						<p class="ts-meta">People, projects and invitations for the active organization</p>
					</div>
					if data.CanManage {
						<a class="ts-btn ts-btn-primary" href="/access?tab=invitations&amp;create=1">Invite member</a>
					}
				</div>
				<dl class="ts-kpis" aria-label="Team totals">
					<div><dt>Organization members</dt><dd><span class="ts-kpi-value">{ fmt.Sprint(data.MemberCount) }</span></dd><small class="ts-meta">People with organization access</small></div>
					<div><dt>Projects</dt><dd><span class="ts-kpi-value">{ fmt.Sprint(data.ProjectCount) }</span></dd><small class="ts-meta">Projects visible to this account</small></div>
					<div><dt>Pending invitations</dt><dd><span class="ts-kpi-value">{ fmt.Sprint(data.PendingInviteCount) }</span></dd><small class="ts-meta">Awaiting a response</small></div>
				</dl>
			</section>
			<section class="ts-section" aria-labelledby="organization-members-title">
				<div class="ts-section-head">
					<div><h2 class="ts-panel-title" id="organization-members-title">Organization members</h2><p class="ts-meta">Users returned by the TerraScale Dashboard API</p></div>
					<a class="ts-btn ts-btn-ghost" href="/access?tab=members">View and filter members <span aria-hidden="true">→</span></a>
				</div>
				if data.MemberCount == 0 {
					<div class="ts-empty"><span class="ts-empty-title">No members returned</span><span class="ts-meta">The API did not return organization members for this account.</span></div>
				} else {
					<ul class="ts-access-summary-list" aria-label="Organization member summary">
						for _, member := range data.Members[:min(len(data.Members), 5)] {
							<li>
								<div class="ts-access-member-cell">
									<span class="ts-access-avatar" aria-hidden="true">{ accessInitials(member.Name, member.Email) }</span>
									<div class="ts-access-identity"><div class="ts-access-member-name">{ accessMemberDisplayName(member) }</div><div class="ts-access-member-email">{ member.Email }</div></div>
								</div>
								<span class={ accessMemberBadgeClass(member.IsOwner) }>{ accessMemberRoleLabel(member) }</span>
							</li>
						}
					</ul>
				}
			</section>
			<section class="ts-section" aria-labelledby="invitations-summary-title">
				<div class="ts-section-head">
					<div><h2 class="ts-panel-title" id="invitations-summary-title">Invitations and role changes</h2><p class="ts-meta">Persistent access mutations</p></div>
					<a class="ts-btn ts-btn-ghost" href="/access?tab=invitations">Manage access <span aria-hidden="true">→</span></a>
				</div>
				if data.CanManage {
					<form method="post" action="/api/v1/access/invitations" class="ts-access-invite-form ts-access-overview-invite">
						<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
						<div class="ts-field"><label class="ts-label" for="invite-email">Invite email</label><input class="ts-input" id="invite-email" name="email" type="email" placeholder="teammate@example.com" required/></div>
						<button class="ts-btn ts-btn-primary" type="submit">Send invite</button>
					</form>
					<p class="ts-meta">{ fmt.Sprint(data.PendingInviteCount) } pending { invitationNoun(data.PendingInviteCount) } and { fmt.Sprint(data.MemberCount) } organization access { accessRecordNoun(data.MemberCount) }.</p>
					if len(data.Invitations) > 0 {
						<ul class="ts-access-summary-list ts-access-invitation-summary" aria-label="Invitation summary">
							for _, invitation := range data.Invitations[:min(len(data.Invitations), 3)] {
								<li>
									<span class="ts-table-strong">{ invitation.Email }</span>
									<span class={ accessInvitationBadgeClass(invitation.Status) }>{ invitation.Status }</span>
									if invitation.Status == "Pending" {
										<form method="post" action={ "/api/v1/access/invitations/" + invitation.ID + "/revoke" }><input type="hidden" name="_csrf" value={ page.CSRFToken }/><button class="ts-btn ts-btn-ghost ts-btn-sm" type="submit" title={ "Cancel invitation for " + invitation.Email }>Cancel</button></form>
									}
								</li>
							}
						</ul>
					}
				} else {
					<div class="ts-alert ts-alert-info" role="status"><span class="ts-alert-title">Owner access required</span><span class="ts-alert-body">Organization and project owners manage invitations, roles, and project access.</span></div>
				}
			</section>
		}
		if data.Tab == "members" {
			<section class="ts-section" aria-labelledby="team-members-heading">
				<div class="ts-section-head">
					<div>
						<h2 class="ts-panel-title" id="team-members-heading">Organization members</h2>
						<p class="ts-meta">Users returned by the TerraScale Dashboard API</p>
					</div>
				</div>
				if data.MemberCount == 0 {
					<div class="ts-empty"><span class="ts-empty-title">No members returned</span><span class="ts-meta">The API did not return organization members for this account.</span></div>
				} else if len(data.Members) == 0 {
					<div class="ts-empty"><span class="ts-empty-title">No members match</span><span class="ts-meta">Adjust the search or role filter to see another organization member.</span></div>
					if data.Query != "" || data.RoleFilter != "all" {
						<a class="ts-btn ts-btn-secondary ts-btn-sm ts-access-empty-action" href="/access?tab=members">Clear filters</a>
					}
				} else {
					<div class="ts-table-wrap">
						<table class="ts-table">
							<thead><tr><th>Member</th><th>User ID</th><th>Organization role</th><th>Joined</th><th>Actions</th></tr></thead>
							<tbody>
								for _, member := range data.Members {
									@accessMemberRow(page, member)
								}
							</tbody>
						</table>
					</div>
					if data.PageCount > 1 {
						<div class="ts-pagination">
							<span class="ts-meta">Showing { fmt.Sprint(data.First) }–{ fmt.Sprint(data.Last) } of { fmt.Sprint(data.Total) }</span>
							if data.PreviousURL != "" {
								<a class="ts-btn ts-btn-secondary ts-btn-sm" href={ data.PreviousURL }>Previous</a>
							}
							if data.NextURL != "" {
								<a class="ts-btn ts-btn-secondary ts-btn-sm" href={ data.NextURL }>Next</a>
							}
						</div>
					}
				}
			</section>
		}
		if data.Tab == "overview" || data.Tab == "projects" {
			<section class="ts-section" aria-labelledby="team-projects-heading">
				<div class="ts-section-head">
					<div>
						<h2 class="ts-panel-title" id="team-projects-heading">Project access context</h2>
						<p class="ts-meta">Projects visible to the current account</p>
					</div>
				</div>
				if len(data.Projects) == 0 {
					<div class="ts-empty"><span class="ts-empty-title">No projects returned</span><span class="ts-meta">The API did not return accessible projects for this organization.</span></div>
				} else {
					<div class="ts-table-wrap">
						<table class="ts-table">
							<thead><tr><th>Project</th><th>Status</th><th>Created</th></tr></thead>
							<tbody>
								for _, project := range data.Projects {
									<tr>
										<td><div class="ts-access-min-width"><p class="ts-access-text-strong">{ project.Name }</p><p class="ts-meta">{ project.ID }</p></div></td>
										<td><span class={ accessProjectBadgeClass(project.Selected) }>{ projectStatus(project.Selected) }</span></td>
										<td>{ project.CreatedAt }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					if data.PageCount > 1 {
						<div class="ts-pagination"><span class="ts-meta">Showing { fmt.Sprint(data.First) }–{ fmt.Sprint(data.Last) } of { fmt.Sprint(data.Total) }</span></div>
					}
				}
			</section>
		}
		if data.Tab == "overview" || data.Tab == "invitations" {
			<section class="ts-section" aria-labelledby="team-invitations-heading">
				<div class="ts-section-head">
					<div>
						<h2 class="ts-panel-title" id="team-invitations-heading">Invitations</h2>
						<p class="ts-meta">Links expire after seven days and can be refreshed by an owner.</p>
					</div>
				</div>
				if data.CanManage {
					<form method="post" action="/api/v1/access/invitations" class="ts-access-invite-form">
						<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
						<div class="ts-field">
							<label class="ts-label" for="invite-email">Email address</label>
							<input class="ts-input" id="invite-email" name="email" type="email" autocomplete="email" required/>
						</div>
						<div class="ts-field">
							<label class="ts-label" for="invite-role">Role</label>
							<select class="ts-select" id="invite-role" name="role"><option value="member">Member</option><option value="viewer">Viewer</option></select>
						</div>
						<button class="ts-btn ts-btn-primary" type="submit">Create invitation</button>
					</form>
				}
				<div class="ts-table-wrap">
					<table class="ts-table">
						<thead><tr><th>Email</th><th>Role</th><th>Status</th><th>Expires</th><th>Actions</th></tr></thead>
						<tbody>
							if len(data.Invitations) == 0 {
								<tr><td colspan="5">No invitations have been created.</td></tr>
							} else {
								for _, invitation := range data.Invitations {
									@accessInvitationRow(page, data.CanManage, invitation)
								}
							}
						</tbody>
					</table>
				</div>
			</section>
		}
	</main>
}

templ accessMemberRow(page core.Page, member memberView) {
	<tr>
		<td><div class="ts-access-member-cell"><span class="ts-access-avatar" aria-hidden="true">{ accessInitials(member.Name, member.Email) }</span><div class="ts-access-identity"><div class="ts-access-member-name">{ accessMemberDisplayName(member) }</div><div class="ts-access-member-email">{ member.Email }</div></div></div></td>
		<td><code class="ts-access-mono-meta">{ member.ID }</code></td>
		<td><span class={ accessMemberBadgeClass(member.IsOwner) }>{ accessMemberRoleLabel(member) }</span></td>
		<td><span class="ts-access-meta-text">{ member.JoinedAt }</span></td>
		<td>
			if member.CanEdit {
				<form method="post" action={ "/api/v1/access/members/" + member.ID + "/role" }>
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
					<label class="ts-sr-only" for={ "role-" + member.ID }>Role for { member.Name }</label>
					<select class="ts-select" id={ "role-" + member.ID } name="role">
						<option value="member" selected?={ member.Role == "member" }>Member</option>
						<option value="viewer" selected?={ member.Role == "viewer" }>Viewer</option>
					</select>
					<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Save role</button>
				</form>
				<form method="post" action={ "/api/v1/access/members/" + member.ID + "/revoke" }>
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
					<button class="ts-btn ts-btn-destructive ts-btn-sm" type="submit">Remove access</button>
				</form>
			} else if member.IsSelf {
				You
			} else {
				Owner
			}
		</td>
	</tr>
}

templ accessInvitationRow(page core.Page, canManage bool, invitation invitationView) {
	<tr>
		<td>{ invitation.Email }</td>
		<td>{ invitation.Role }</td>
		<td>{ invitation.Status }</td>
		<td>{ invitation.ExpiresAt }</td>
		<td>
			if canManage && invitation.Status == "Pending" {
				<form method="post" action={ "/api/v1/access/invitations/" + invitation.ID + "/resend" }>
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
					<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Resend</button>
				</form>
				<form method="post" action={ "/api/v1/access/invitations/" + invitation.ID + "/revoke" }>
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
					<button class="ts-btn ts-btn-destructive ts-btn-sm" type="submit">Cancel</button>
				</form>
			} else {
				—
			}
		</td>
	</tr>
}

func accessTabClass(tab, candidate string) string {
	if tab == candidate {
		return "ts-tab ts-tab-active"
	}
	return "ts-tab"
}

func accessTabCurrent(tab, candidate string) string {
	if tab == candidate {
		return "page"
	}
	return ""
}

func accessTabSelected(tab, candidate string) string {
	if tab == candidate {
		return "true"
	}
	return "false"
}

func roleFilterValue(role string) string {
	if role == "all" {
		return ""
	}
	return role
}

func roleFilterLabel(role string) string {
	switch role {
	case "owner":
		return "Organization owner"
	case "member":
		return "Member"
	case "viewer":
		return "Viewer"
	default:
		return "All roles"
	}
}

func accessFilterCurrent(role, candidate string) string {
	if role == candidate {
		return "true"
	}
	return "false"
}

func accessMemberDisplayName(member memberView) string {
	name := strings.TrimSpace(member.Name)
	if name == "" {
		return member.Email
	}
	return name
}

func accessInitials(name, email string) string {
	value := strings.TrimSpace(name)
	if value == "" {
		value = email
	}
	parts := strings.FieldsFunc(value, func(r rune) bool {
		return r == ' ' || r == '.' || r == '@' || r == '_' || r == '-'
	})
	if len(parts) == 0 {
		return "?"
	}
	initials := []rune(strings.ToUpper(string([]rune(parts[0])[0])))
	if len(parts) > 1 {
		initials = append(initials, []rune(strings.ToUpper(string([]rune(parts[1])[0])))...)
	}
	return string(initials)
}

func accessMemberRoleLabel(member memberView) string {
	if member.IsOwner {
		return "Organization Owner"
	}
	role := strings.TrimSpace(member.Role)
	if role == "" {
		return "Unknown"
	}
	return strings.ToUpper(role[:1]) + role[1:]
}

func accessMemberBadgeClass(owner bool) string {
	if owner {
		return "ts-badge ts-badge-success"
	}
	return "ts-badge ts-badge-neutral"
}

func accessInvitationBadgeClass(status string) string {
	if status == "Pending" {
		return "ts-badge ts-badge-info"
	}
	return "ts-badge ts-badge-neutral"
}

func accessProjectBadgeClass(current bool) string {
	if current {
		return "ts-badge ts-badge-success"
	}
	return "ts-badge ts-badge-neutral"
}

func invitationNoun(count int) string {
	if count == 1 {
		return "invitation"
	}
	return "invitations"
}

func accessRecordNoun(count int) string {
	if count == 1 {
		return "record"
	}
	return "records"
}

func projectStatus(selected bool) string {
	if selected {
		return "Current"
	}
	return "Available"
}
