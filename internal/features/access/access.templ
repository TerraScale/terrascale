package access

import (
	"fmt"
	"strings"

	"terrascale.tech/dashboard/internal/core"
	"terrascale.tech/dashboard/internal/features/organization"
	"terrascale.tech/dashboard/internal/ui"
	"terrascale.tech/dashboard/internal/ui/charts"
	"terrascale.tech/dashboard/internal/ui/icons"
)

templ accessPageView(page core.Page, data pageData) {
	<main id="access-page" class="ts-page ts-access-page">
		@ui.PageHeader("Organization") {}
		if data.Error != "" {
			@ui.Alert("warning", data.Error, "")
		}
		if data.Notice.Title != "" {
			@ui.Alert(data.Notice.Tone, data.Notice.Title, data.Notice.Message)
		}
		if data.InviteURL != "" {
			// The link answers a POST: swap the address for the tab's own, so a
			// reload cannot resend the invitation and void the copied link.
			<section class="ts-alert ts-alert-success" aria-labelledby="invitation-link-title" data-init={ "history.replaceState(null, '', '" + tabPath(data.Tab) + "')" }>
				<p class="ts-alert-title" id="invitation-link-title">Invitation created</p>
				<p class="ts-alert-body">Copy this link and send it to the invitee. It works once and expires in seven days; resending the invitation replaces it.</p>
				<div class="ts-row">
					<a id="invitation-link" class="ts-link ts-break" href={ data.InviteURL } rel="noreferrer" data-text="el.href">{ data.InviteURL }</a>
					// Clipboard access needs a secure context and permission: say so when
					// it fails, and reset the label after a copy.
					<button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-signals="{_copy: ''}" data-on:click="(navigator.clipboard?.writeText(document.getElementById('invitation-link').href) ?? Promise.reject()).then(() => { $_copy = 'Copied'; setTimeout(() => $_copy = '', 2000) }, () => $_copy = 'Copy failed: select the link')">
						@icons.Copy(14)
						<span data-text="$_copy || 'Copy link'">Copy link</span>
					</button>
				</div>
			</section>
		}
		<div class="ts-toolbar ts-access-toolbar">
			@organization.Tabs(data.Tab)
			if data.Tab == "members" {
				@memberFilters(data)
			}
			if data.CanManage {
				<a class="ts-btn ts-btn-primary" href="/organization?tab=invitations&amp;create=1">@icons.UserPlus(16)<span>Invite member</span></a>
			}
		</div>
		switch data.Tab {
			case "overview":
				@accessOverview(page, data)
			case "members":
				@accessMembers(page, data)
			case "projects":
				@accessProjects(data)
			case "invitations":
				@accessInvitations(page, data)
		}
	</main>
}

templ memberFilters(data pageData) {
	<form id="access-filter-form" method="get" action="/organization" class="ts-filters ts-access-filters" role="search" aria-label="Filter members" data-on:submit="@get('/organization', {contentType:'form'})">
		<input type="hidden" name="tab" value="members"/>
		// The first submit button is the form's default, used when Enter is
		// pressed; it keeps the current role. A clicked role option is sent after
		// this field, and the handler reads the last role value.
		<button class="ts-sr-only" type="submit">Apply filters</button>
		<input type="hidden" name="role" value={ roleFilterValue(data.RoleFilter) }/>
		<div class="ts-filter-field ts-access-search">
			<label class="ts-sr-only" for="member-search">Filter members</label>
			<input class="ts-input" id="member-search" name="q" type="search" placeholder="Search members" value={ data.Query }/>
		</div>
		<div class="ts-filter-field">
			<span class="ts-sr-only" id="member-role-filter-label">Organization role</span>
			@ui.Dropdown(ui.DropdownProps{End: true, LabelledBy: "member-role-filter-label member-role-filter-value", Trigger: roleFilterTrigger(data.RoleFilter), TriggerClass: "ts-select"}) {
				for _, role := range filterRoles {
					@ui.MenuItem(ui.MenuItemProps{Type: "submit", Name: "role", Value: roleFilterValue(role), Label: roleFilterLabel(role), Current: data.RoleFilter == role})
				}
			}
		</div>
		if data.Query != "" || data.RoleFilter != "all" {
			<a class="ts-btn ts-btn-ghost ts-btn-sm" href="/organization?tab=members">Clear</a>
		}
	</form>
}

templ accessOverview(page core.Page, data pageData) {
	@ui.Stats("Team totals") {
		@ui.ToneStat("pink", "Organization members", fmt.Sprint(data.MemberCount), "People with organization access")
		@ui.ToneStat("indigo", "Projects", fmt.Sprint(data.ProjectCount), "Projects visible to this account")
		@ui.ToneStat("amber", "Pending invitations", fmt.Sprint(data.PendingInviteCount), "Awaiting a response")
	}
	<div class="ts-grid-2">
		@ui.Card(ui.CardProps{ID: "team-roles", Title: "Roles", Description: "Active members by organization role"}) {
			if data.MemberCount == 0 {
				@noMembers()
			} else {
				@shareChart("Members by role", "active members", data.RoleShares)
			}
		}
		@ui.Card(ui.CardProps{ID: "team-invitation-status", Title: "Invitation status", Description: fmt.Sprintf("%d %s created for this organization", data.InvitationTotal, invitationNoun(data.InvitationTotal))}) {
			if data.InvitationTotal == 0 {
				@ui.Empty("No invitations yet.", "Invite a teammate by email to give them access to this organization.")
			} else {
				@shareChart("Invitations by status", "invitations", data.InvitationShares)
			}
		}
	</div>
	<div class="ts-grid-2">
		@ui.Card(ui.CardProps{ID: "organization-members", Title: "Organization members", Description: "Users returned by the TerraScale Dashboard API", Actions: linkAction("/organization?tab=members", "View all"), Flush: data.MemberCount > 0}) {
			if data.MemberCount == 0 {
				@noMembers()
			} else {
				<ul class="ts-list" aria-label="Organization member summary">
					for _, member := range data.Members[:min(len(data.Members), 5)] {
						<li class="ts-list-item">
							@memberIdentity(member)
							@ui.StatusBadge(memberRoleTone(member), accessMemberRoleLabel(member))
						</li>
					}
				</ul>
			}
		}
		@ui.Card(ui.CardProps{ID: "invitations-summary", Title: "Invitations and role changes", Description: "Persistent access mutations", Actions: linkAction("/organization?tab=invitations", "Manage access")}) {
			if data.CanManage {
				<form method="post" action="/api/v1/access/invitations" class="ts-access-invite ts-access-overview-invite">
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
					@ui.Field(ui.FieldProps{ID: "invite-email", Label: "Invite email"}) {
						<input class="ts-input" id="invite-email" name="email" type="email" placeholder="teammate@example.com" required/>
					}
					<button class="ts-btn ts-btn-primary" type="submit">Send invite</button>
				</form>
				<p class="ts-meta">{ fmt.Sprint(data.PendingInviteCount) } pending { invitationNoun(data.PendingInviteCount) } and { fmt.Sprint(data.MemberCount) } organization access { accessRecordNoun(data.MemberCount) }.</p>
				if len(data.Invitations) > 0 {
					<ul class="ts-list ts-access-invitation-summary" aria-label="Invitation summary">
						for _, invitation := range data.Invitations[:min(len(data.Invitations), 3)] {
							<li class="ts-list-item">
								<span class="ts-list-main ts-strong ts-truncate">{ invitation.Email }</span>
								@ui.StatusBadge(invitationTone(invitation.Status), invitation.Status)
								if invitation.Open {
									<form method="post" action={ "/api/v1/access/invitations/" + invitation.ID + "/revoke" }><input type="hidden" name="_csrf" value={ page.CSRFToken }/><button class="ts-btn ts-btn-ghost ts-btn-sm" type="submit" title={ "Cancel invitation for " + invitation.Email }>Cancel</button></form>
								}
							</li>
						}
					</ul>
				}
			} else {
				@ui.Alert("info", "Owner access required", "Organization and project owners manage invitations, roles, and project access.")
			}
		}
	</div>
	@accessProjects(data)
}

templ accessMembers(page core.Page, data pageData) {
	@ui.Card(ui.CardProps{ID: "team-members", Title: "Organization members", Description: "Users returned by the TerraScale Dashboard API", Flush: len(data.Members) > 0}) {
		if data.MemberCount == 0 {
			@noMembers()
		} else if len(data.Members) == 0 {
			@ui.Empty("No members match", "Adjust the search or role filter to see another organization member.") {
				if data.Query != "" || data.RoleFilter != "all" {
					<a class="ts-btn ts-btn-secondary ts-btn-sm" href="/organization?tab=members">Clear filters</a>
				}
			}
		} else {
			<div class="ts-table-wrap">
				<table class="ts-table">
					<thead><tr><th>Member</th><th>User ID</th><th>Organization role</th><th>Joined</th><th class="ts-table-actions">Actions</th></tr></thead>
					<tbody>
						for _, member := range data.Members {
							@accessMemberRow(page, member)
						}
					</tbody>
				</table>
			</div>
			@accessPager("Member pages", data)
		}
	}
}

templ accessProjects(data pageData) {
	@ui.Card(ui.CardProps{ID: "team-projects", Title: "Project access context", Description: "Projects visible to the current account", Flush: len(data.Projects) > 0}) {
		if len(data.Projects) == 0 {
			@ui.Empty("No projects returned", "The API did not return accessible projects for this organization.")
		} else {
			<div class="ts-table-wrap">
				<table class="ts-table">
					<thead><tr><th>Project</th><th>Status</th><th>Created</th></tr></thead>
					<tbody>
						for _, project := range data.Projects {
							<tr>
								<td><div class="ts-list-main"><span class="ts-strong">{ project.Name }</span><span class="ts-meta ts-mono">{ project.ID }</span></div></td>
								<td>
									if project.Selected {
										@ui.Badge("success", projectStatus(project.Selected))
									} else {
										@ui.Badge("neutral", projectStatus(project.Selected))
									}
								</td>
								<td class="ts-meta ts-access-date">{ project.CreatedAt }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if data.Tab == "projects" {
				@accessPager("Project pages", data)
			}
		}
	}
}

templ accessInvitations(page core.Page, data pageData) {
	if data.CanManage {
		@ui.Card(ui.CardProps{ID: "team-invite", Title: "Invite a teammate", Description: "Links expire after seven days and can be refreshed by an owner."}) {
			<form method="post" action="/api/v1/access/invitations?tab=invitations" class="ts-access-invite">
				<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
				@ui.Field(ui.FieldProps{ID: "invite-email", Label: "Email address"}) {
					<input class="ts-input" id="invite-email" name="email" type="email" autocomplete="email" placeholder="teammate@example.com" required/>
				}
				@ui.Field(ui.FieldProps{ID: "invite-role", Label: "Role"}) {
					<select class="ts-select" id="invite-role" name="role"><option value="member">Member</option><option value="viewer">Viewer</option></select>
				}
				<button class="ts-btn ts-btn-primary" type="submit">Create invitation</button>
			</form>
		}
	}
	@ui.Card(ui.CardProps{ID: "team-invitations", Title: "Invitations", Description: "Every invitation created for this organization.", Flush: len(data.Invitations) > 0}) {
		if len(data.Invitations) == 0 {
			@ui.Empty("No invitations have been created.", "Invite a teammate by email to give them access to this organization.")
		} else {
			<div class="ts-table-wrap">
				<table class="ts-table">
					<thead><tr><th>Email</th><th>Role</th><th>Status</th><th>Expires</th><th class="ts-table-actions">Actions</th></tr></thead>
					<tbody>
						for _, invitation := range data.Invitations {
							@accessInvitationRow(page, data.CanManage, invitation)
						}
					</tbody>
				</table>
			</div>
			@accessPager("Invitation pages", data)
		}
	}
}

// shareChart lists one colored share bar per category; of names the whole
// each bar is a share of ("Member: 40 percent of active members").
templ shareChart(label, of string, shares []shareView) {
	<ul class="ts-access-shares" aria-label={ label }>
		for _, share := range shares {
			<li class="ts-access-share" data-tone={ share.Tone }>
				<span class="ts-access-share-label"><span class="ts-dot" aria-hidden="true"></span>{ share.Label }</span>
				<span class="ts-access-share-value"><span class="ts-strong">{ fmt.Sprint(share.Count) }</span> <span class="ts-meta">{ fmt.Sprint(share.Percent) }%</span></span>
				@charts.Bar(charts.NewBar(share.Label, share.Percent, of))
			</li>
		}
	</ul>
}

// accessPager pages the active tab's list; it renders nothing for one page.
templ accessPager(label string, data pageData) {
	if data.PageCount > 1 {
		<nav class="ts-pager" aria-label={ label }>
			<span>Showing { fmt.Sprint(data.First) }–{ fmt.Sprint(data.Last) } of { fmt.Sprint(data.Total) }</span>
			<div class="ts-row">
				if data.PreviousURL != "" {
					<a class="ts-btn ts-btn-secondary ts-btn-sm" rel="prev" href={ data.PreviousURL }>Previous</a>
				}
				if data.NextURL != "" {
					<a class="ts-btn ts-btn-secondary ts-btn-sm" rel="next" href={ data.NextURL }>Next</a>
				}
			</div>
		</nav>
	}
}

templ noMembers() {
	@ui.Empty("No members returned", "The API did not return organization members for this account.")
}

templ linkAction(href, label string) {
	<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ templ.SafeURL(href) }><span>{ label }</span>@icons.ArrowRight(14)</a>
}

templ memberIdentity(member memberView) {
	<span class="ts-avatar" aria-hidden="true">{ accessInitials(member.Name, member.Email) }</span>
	<div class="ts-list-main">
		<span class="ts-strong ts-truncate">{ accessMemberDisplayName(member) }</span>
		<span class="ts-meta ts-truncate">{ member.Email }</span>
	</div>
}

templ accessMemberRow(page core.Page, member memberView) {
	<tr>
		<td><div class="ts-row ts-access-member">@memberIdentity(member)</div></td>
		<td><code class="ts-meta">{ member.ID }</code></td>
		<td>@ui.StatusBadge(memberRoleTone(member), accessMemberRoleLabel(member))</td>
		<td class="ts-meta ts-access-date">{ member.JoinedOn }</td>
		<td class="ts-table-actions">
			if member.CanEdit {
				<div class="ts-row ts-row-end">
					<form class="ts-row" method="post" action={ "/api/v1/access/members/" + member.ID + "/role?tab=members" }>
						<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
						<label class="ts-sr-only" for={ "role-" + member.ID }>Role for { accessMemberDisplayName(member) }</label>
						<select class="ts-select ts-input-sm ts-access-role" id={ "role-" + member.ID } name="role" required>
							// A role the form cannot assign stays shown and selected, so
							// saving without a choice cannot silently change it.
							if member.Role != "member" && member.Role != "viewer" {
								<option value="" selected disabled>{ roleLabel(member.Role) }</option>
							}
							<option value="member" selected?={ member.Role == "member" }>Member</option>
							<option value="viewer" selected?={ member.Role == "viewer" }>Viewer</option>
						</select>
						<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Save role</button>
					</form>
					@ui.DialogTrigger(ui.DialogTriggerProps{Dialog: "remove-member-" + member.ID, Label: "Remove access", Variant: "danger", Small: true})
					@ui.Dialog(ui.DialogProps{ID: "remove-member-" + member.ID, Title: "Remove " + accessMemberDisplayName(member) + "?", Description: member.Email + " loses access to this organization and all of its projects. You can invite them again later."}) {
						<form method="post" action={ "/api/v1/access/members/" + member.ID + "/revoke?tab=members" }>
							<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
							@ui.DialogActions("remove-member-" + member.ID) {
								<button class="ts-btn ts-btn-danger" type="submit">Remove access</button>
							}
						</form>
					}
				</div>
			} else if member.IsSelf {
				<span class="ts-meta">You</span>
			} else {
				<span class="ts-meta">Owner</span>
			}
		</td>
	</tr>
}

templ accessInvitationRow(page core.Page, canManage bool, invitation invitationView) {
	<tr>
		<td class="ts-strong">{ invitation.Email }</td>
		<td>{ roleLabel(invitation.Role) }</td>
		<td>@ui.StatusBadge(invitationTone(invitation.Status), invitation.Status)</td>
		<td class="ts-meta ts-access-date">{ invitation.ExpiresOn }</td>
		<td class="ts-table-actions">
			if canManage && invitation.Open {
				<div class="ts-row ts-row-end">
					<form method="post" action={ "/api/v1/access/invitations/" + invitation.ID + "/resend?tab=invitations" }>
						<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
						<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Resend</button>
					</form>
					<form method="post" action={ "/api/v1/access/invitations/" + invitation.ID + "/revoke?tab=invitations" }>
						<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
						<button class="ts-btn ts-btn-danger ts-btn-sm" type="submit">Cancel</button>
					</form>
				</div>
			} else {
				<span class="ts-meta">—</span>
			}
		</td>
	</tr>
}

// tabPath is the address of a Team page tab.
func tabPath(tab string) string {
	if tab == "overview" {
		return "/access"
	}
	return "/organization?tab=" + tab
}

func roleFilterValue(role string) string {
	if role == "all" {
		return ""
	}
	return role
}

func roleFilterLabel(role string) string {
	switch role {
	case "all":
		return "All roles"
	case "owner":
		return "Organization owner"
	default:
		return roleLabel(role)
	}
}

templ roleFilterTrigger(role string) {
	<span id="member-role-filter-value">{ roleFilterLabel(role) }</span>
}

func accessMemberDisplayName(member memberView) string {
	name := strings.TrimSpace(member.Name)
	if name == "" {
		return member.Email
	}
	return name
}

func accessInitials(name, email string) string {
	value := strings.TrimSpace(name)
	if value == "" {
		value = email
	}
	parts := strings.FieldsFunc(value, func(r rune) bool {
		return r == ' ' || r == '.' || r == '@' || r == '_' || r == '-'
	})
	if len(parts) == 0 {
		return "?"
	}
	initials := []rune(strings.ToUpper(string([]rune(parts[0])[0])))
	if len(parts) > 1 {
		initials = append(initials, []rune(strings.ToUpper(string([]rune(parts[1])[0])))...)
	}
	return string(initials)
}

func accessMemberRoleLabel(member memberView) string {
	if member.IsOwner {
		return "Organization Owner"
	}
	return roleLabel(member.Role)
}

func invitationNoun(count int) string {
	if count == 1 {
		return "invitation"
	}
	return "invitations"
}

func accessRecordNoun(count int) string {
	if count == 1 {
		return "record"
	}
	return "records"
}

func projectStatus(selected bool) string {
	if selected {
		return "Current"
	}
	return "Available"
}

func memberRoleTone(member memberView) string {
	if member.IsOwner {
		return roleTone("owner")
	}
	return roleTone(member.Role)
}
