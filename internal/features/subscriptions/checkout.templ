package subscriptions

import (
	"terrascale.tech/dashboard/internal/ui"
	static "terrascale.tech/dashboard/web/static"
)

templ checkoutContent(csrfToken string, data checkoutPage) {
	<main class="ts-auth">
		<section class="ts-auth-card" aria-labelledby="checkout-title">
			@simulatorHeading("checkout-title", "Local payment setup", data.PlanName+" · billed "+data.Interval)
			@ui.Alert("info", "Demo simulator only", "No card details are collected, no Stripe service is contacted, and no real payment or charge occurs.")
			<dl class="ts-kv">
				<dt>Checkout session</dt>
				<dd class="ts-mono">{ data.SessionID }</dd>
				<dt>Expires</dt>
				<dd>{ data.ExpiresAt }</dd>
			</dl>
			<div class="ts-stack-sm">
				<form method="post" action={ "/checkout/" + data.SessionID + "/complete" }>
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					<button class="ts-btn ts-btn-primary ts-btn-lg ts-btn-block" type="submit">Confirm local demo setup</button>
				</form>
				<form method="post" action={ "/checkout/" + data.SessionID + "/cancel" }>
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					<button class="ts-btn ts-btn-secondary ts-btn-lg ts-btn-block" type="submit">Cancel checkout</button>
				</form>
				<a class="ts-btn ts-btn-ghost ts-btn-block" href="/billing">Return to billing</a>
			</div>
		</section>
	</main>
}

// simulatorHeading is the brand-and-title block shared by the local Stripe
// simulator pages.
templ simulatorHeading(id, title, subtitle string) {
	<div class="ts-auth-brand">
		<img class="ts-brand-logo" src={ static.URL("brand/logo-terrascale-blue.svg") } alt="TerraScale" decoding="async"/>
	</div>
	<div class="ts-auth-heading">
		<h1 class="ts-auth-title" id={ id }>{ title }</h1>
		<p class="ts-auth-subtitle">{ subtitle }</p>
	</div>
}
