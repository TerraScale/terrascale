package subscriptions

import "terrascale.tech/dashboard/internal/ui"

templ portalContent(data portalPage) {
	<main class="ts-auth">
		<section class="ts-auth-card" aria-labelledby="portal-title">
			@simulatorHeading("portal-title", "Local billing portal", "Review "+data.OrganizationName+" billing state.")
			@ui.Alert("info", "Demo simulator only", "This page does not collect payment details or contact Stripe. No real payment method or charge is used.")
			<dl class="ts-kv">
				<dt>Plan</dt>
				<dd>{ data.PlanName }</dd>
				<dt>Billing status</dt>
				<dd>{ data.BillingStatus }</dd>
				<dt>Renewal</dt>
				<dd>{ data.Renewal }</dd>
			</dl>
			<a class="ts-btn ts-btn-secondary ts-btn-block" href="/billing">Return to billing</a>
		</section>
	</main>
}
