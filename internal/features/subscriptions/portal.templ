package subscriptions

templ portalContent(data portalPage) {
	<main class="ts-flow-root">
		<section class="ts-flow-panel">
			<div class="ts-flow-section">
				<div class="ts-flow-header">
					<span class="ts-flow-icon" aria-hidden="true">◈</span>
					<div>
						<h1 class="ts-flow-title">Local billing portal</h1>
						<p class="ts-flow-subtitle">Review { data.OrganizationName } billing state.</p>
					</div>
				</div>
				<div class="ts-alert ts-alert-info" role="status">
					<span class="ts-alert-title">Demo simulator only</span>
					<span class="ts-alert-body">This page does not collect payment details or contact Stripe. No real payment method or charge is used.</span>
				</div>
				<dl class="ts-kv">
					<dt>Plan</dt>
					<dd>{ data.PlanName }</dd>
					<dt>Billing status</dt>
					<dd>{ data.BillingStatus }</dd>
					<dt>Renewal</dt>
					<dd>{ data.Renewal }</dd>
				</dl>
				<a class="ts-btn ts-btn-secondary" href="/billing">Return to billing</a>
			</div>
		</section>
	</main>
}
