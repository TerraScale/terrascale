package subscriptions

import "terrascale.tech/dashboard/internal/ui"

templ subscriptionsContent(csrfToken string, data subscriptionsPage) {
	<main class="ts-page">
		@ui.PageHeader(ui.Header{Eyebrow: "Organization billing", Title: "Plans and billing", Description: "Billing for " + data.OrganizationName + "."}) {
			if data.Demo {
				@ui.Badge("info", "Demo billing")
			}
		}
		if data.PaymentNotice != "" {
			@ui.Alert("info", "", data.PaymentNotice)
		}
		@ui.Card(ui.CardProps{ID: "billing-summary", Title: "Current plan", Description: "Your plan and billing status for this organization.", Actions: manageBilling()}) {
			<dl class="ts-kv">
				<div>
					<dt>Plan</dt>
					<dd class="ts-strong">
						if data.PlanName != "" {
							{ data.PlanName }
						} else {
							Free
						}
					</dd>
				</div>
				<div><dt>Status</dt><dd>{ data.BillingStatus }</dd></div>
				if data.BillingInterval != "" {
					<div><dt>Interval</dt><dd>{ data.BillingInterval }</dd></div>
				}
				<div><dt>Renewal</dt><dd>{ data.Renewal }</dd></div>
				<div>
					<dt>Payment method</dt>
					<dd>
						if data.PaymentValidated {
							On file
						} else {
							Not set
						}
					</dd>
				</div>
			</dl>
		}
		@ui.Card(ui.CardProps{ID: "available-plans", Title: "Available plans", Description: "Choose a billing interval to continue."}) {
			if len(data.Plans) == 0 {
				@ui.Empty("No paid plans are available right now.", "")
			} else {
				<div class="ts-grid">
					for _, plan := range data.Plans {
						<article class="ts-plan" aria-labelledby={ "plan-" + plan.Key }>
							<div class="ts-stack-sm">
								<h3 id={ "plan-" + plan.Key } class="ts-section-title">{ plan.Name }</h3>
								<p class="ts-plan-price">{ plan.MonthlyPrice } <small>/ month</small></p>
								if plan.AnnualAvailable {
									<p class="ts-meta">{ plan.AnnualPrice } billed annually</p>
								}
								if plan.TrialDays > 0 {
									<p class="ts-meta">{ plan.TrialDays } day trial</p>
								}
								if plan.ShowLimits {
									<p class="ts-meta">{ plan.StorageMiB } MiB storage · { plan.MonthlyRequests } requests per month</p>
								}
							</div>
							<div class="ts-stack-sm">
								@checkoutButton(csrfToken, plan.Key, "monthly", "ts-btn-primary", "Choose monthly")
								if plan.AnnualAvailable {
									@checkoutButton(csrfToken, plan.Key, "annual", "ts-btn-secondary", "Choose annual")
								}
							</div>
						</article>
					}
				</div>
			}
		}
	</main>
}

templ manageBilling() {
	<a class="ts-btn ts-btn-secondary" href="/billing/portal">Manage billing</a>
}

templ checkoutButton(csrfToken, plan, interval, variant, label string) {
	<form method="post" action="/billing/checkout">
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		<input type="hidden" name="plan" value={ plan }/>
		<input type="hidden" name="interval" value={ interval }/>
		<input type="hidden" name="return" value="/billing"/>
		<button class={ "ts-btn", variant, "ts-btn-block" } type="submit">{ label }</button>
	</form>
}
