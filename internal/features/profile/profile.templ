package profile

templ profileView(data pageData, csrfToken string) {
	<main class="ts-page">
		<header class="ts-row-header">
			<div>
				<h1>Profile</h1>
				<p>{ data.Name } · { data.Email }</p>
			</div>
		</header>
		if data.Error != "" {
			<p role="alert" class="ts-alert ts-alert-danger">{ data.Error }</p>
		}
		<ts-tabs>
			<nav class="ts-tabs" aria-label="Profile sections">
				if data.Tab == "profile" {
					<a class="ts-tab" href="/profile?tab=profile" aria-current="page">Profile</a>
				} else {
					<a class="ts-tab" href="/profile?tab=profile">Profile</a>
				}
				if data.Tab == "security" {
					<a class="ts-tab" href="/profile?tab=security" aria-current="page">Security</a>
				} else {
					<a class="ts-tab" href="/profile?tab=security">Security</a>
				}
			</nav>
		</ts-tabs>
		if data.Tab == "security" {
			<section class="ts-panel ts-panel-pad20">
				<h2>Change password</h2>
				<p>All active sessions are terminated after the password changes.</p>
				<form class="ts-form" method="post" action="/api/v1/dashboard/profile/password">
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					<div class="ts-field">
						<label class="ts-label" for="currentPassword">Current password</label>
						<ts-password-control>
							<div class="ts-input-group">
								<input class="ts-input" id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required/>
								<button class="ts-input-adornment" type="button" data-password-toggle aria-controls="currentPassword" aria-pressed="false" aria-label="Show password" hidden>
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
								</button>
							</div>
						</ts-password-control>
					</div>
					<div class="ts-field">
						<label class="ts-label" for="newPassword">New password</label>
						<ts-password-control>
							<div class="ts-input-group">
								<input class="ts-input" id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="12" required/>
								<button class="ts-input-adornment" type="button" data-password-toggle aria-controls="newPassword" aria-pressed="false" aria-label="Show password" hidden>
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
								</button>
							</div>
						</ts-password-control>
						<span class="ts-hint">Use at least 12 characters.</span>
					</div>
					<div class="ts-field">
						<label class="ts-label" for="confirmPassword">Confirm new password</label>
						<ts-password-control>
							<div class="ts-input-group">
								<input class="ts-input" id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" required/>
								<button class="ts-input-adornment" type="button" data-password-toggle aria-controls="confirmPassword" aria-pressed="false" aria-label="Show password" hidden>
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
								</button>
							</div>
						</ts-password-control>
					</div>
					<button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Change password and sign out</button>
				</form>
			</section>
		} else {
			<section class="ts-grid-two-pane">
				<section class="ts-panel ts-panel-pad20">
					<h2>Email and contact</h2>
					<dl class="ts-summary-terms">
						<div><dt>Email</dt><dd>{ data.Email }</dd></div>
						<div><dt>Account ID</dt><dd>{ data.AccountID }</dd></div>
					</dl>
				</section>
				<section class="ts-panel ts-panel-pad20">
					<h2>Profile details</h2>
					<form class="ts-form" method="post" action="/api/v1/dashboard/profile">
						<input type="hidden" name="_csrf" value={ csrfToken }/>
						<div class="ts-field">
							<label class="ts-label" for="name">Full name</label>
							<input class="ts-input" id="name" name="name" value={ data.Name } maxlength="128" required/>
						</div>
						<div class="ts-field">
							<label class="ts-label" for="phoneNumber">Phone number</label>
							<input class="ts-input" id="phoneNumber" name="phoneNumber" type="tel" value={ data.Phone } autocomplete="tel"/>
						</div>
						<p>Language: { data.Locale }</p>
						<button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Save profile</button>
					</form>
				</section>
			</section>
		}
	</main>
}
