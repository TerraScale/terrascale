package profile

import (
	"fmt"
	"strings"

	"terrascale.tech/dashboard/internal/ui"
)

templ profileView(data pageData, csrfToken string) {
	<main class="ts-page">
		@ui.PageHeader(data.Name)
		if data.Error != "" {
			@ui.Alert("danger", "", data.Error)
		}
		if data.Status != "" {
			<p role="status" aria-live="polite" class="ts-alert ts-alert-success">{ data.Status }</p>
		}
		@ui.Stats("Account summary") {
			@ui.Stat("Roles", fmt.Sprint(len(data.Roles)), "")
			@ui.Stat("Listed capabilities", fmt.Sprint(len(data.Permissions)), "")
			@ui.Stat("Sessions", fmt.Sprint(len(data.Sessions)), "")
			@ui.Stat("Passkey records", fmt.Sprint(len(data.Passkeys)), "")
			@ui.Stat("Demo MFA", onOff(data.MFAEnabled), "")
		}
		@ui.Tabs("Profile sections", []ui.Tab{
			{Label: "Profile", URL: "/profile?tab=profile", Active: data.Tab == "profile"},
			{Label: "Security", URL: "/profile?tab=security", Active: data.Tab == "security"},
			{Label: "Sessions", URL: "/profile?tab=sessions", Active: data.Tab == "sessions"},
		})
		switch data.Tab {
			case "profile":
				@profileTab(data, csrfToken)
			case "security":
				@securityTab(data, csrfToken)
			default:
				@sessionsTab(data)
		}
		@ui.Card(ui.CardProps{ID: "profile-context", Title: "Session context", Description: "Authenticated account and selected scope."}) {
			<dl class="ts-kv">
				<dt>User ID</dt>
				<dd class="ts-mono">{ data.UserID }</dd>
				<dt>Account ID</dt>
				<dd class="ts-mono">{ data.AccountID }</dd>
				<dt>Email</dt>
				<dd>{ data.Email }</dd>
				<dt>Active organization</dt>
				<dd class="ts-mono">{ data.ActiveOrganizationID }</dd>
				<dt>Dashboard project</dt>
				<dd class="ts-mono">{ data.ActiveProjectID }</dd>
				<dt>Language</dt>
				<dd>{ data.Locale }</dd>
			</dl>
		}
	</main>
}

templ profileTab(data pageData, csrfToken string) {
	<div class="ts-grid-2">
		@ui.Card(ui.CardProps{ID: "profile-details", Title: "Profile details", Description: "Update the account information shown across TerraScale."}) {
			<form class="ts-form" method="post" action="/api/v1/dashboard/profile">
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				@ui.Field(ui.FieldProps{ID: "displayName", Label: "Display name"}) {
					<input class="ts-input" id="displayName" name="name" value={ data.Name } autocomplete="name" maxlength="128" required/>
				}
				@ui.Field(ui.FieldProps{ID: "phoneNumber", Label: "Phone number (optional)"}) {
					<input class="ts-input" id="phoneNumber" name="phoneNumber" type="tel" value={ data.Phone } autocomplete="tel" inputmode="tel"/>
				}
				<div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Save profile</button></div>
			</form>
		}
		@ui.Card(ui.CardProps{ID: "profile-email", Title: "Email and contact", Description: "Change your sign-in email after confirming your current password. Changes are stored in this demo account."}) {
			<form method="post" action="/api/v1/dashboard/profile/email-change" class="ts-form">
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				@ui.Field(ui.FieldProps{ID: "newEmail", Label: "New email"}) {
					<input class="ts-input" id="newEmail" name="newEmail" type="email" autocomplete="email" required/>
				}
				@ui.Field(ui.FieldProps{ID: "emailPassword", Label: "Current password"}) {
					@ui.PasswordInput(ui.PasswordProps{ID: "emailPassword", Name: "password", Autocomplete: "current-password"})
				}
				<div class="ts-form-actions"><button class="ts-btn ts-btn-secondary" type="submit">Change email</button></div>
			</form>
		}
		@ui.Card(ui.CardProps{ID: "profile-language", Title: "Language", Description: "Choose the language used by onboarding and the Dashboard."}) {
			<form method="post" action="/api/v1/dashboard/profile/language" class="ts-form">
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				@ui.Field(ui.FieldProps{ID: "interfaceLanguage", Label: "Interface language"}) {
					<select class="ts-select" id="interfaceLanguage" name="locale">
						<option value="en" selected?={ data.Locale == "en" }>English</option>
						<option value="pt-BR" selected?={ data.Locale == "pt-BR" }>Português</option>
					</select>
				}
				<div class="ts-form-actions"><button class="ts-btn ts-btn-secondary" type="submit">Save language</button></div>
			</form>
		}
		@ui.Card(ui.CardProps{ID: "profile-posture", Title: "Security posture", Description: "Current account and demo security records."}) {
			<dl class="ts-kv ts-profile-posture">
				<dt>Active organization role</dt>
				<dd>
					if data.Role != "" {
						@ui.Badge("info", data.Role)
					} else {
						@ui.Badge("neutral", "Unavailable")
					}
				</dd>
				<dt>Multi-factor record</dt>
				<dd>
					if data.MFAEnabled {
						@ui.Badge("success", "Enabled in demo")
					} else {
						@ui.Badge("neutral", "Not enabled")
					}
				</dd>
				<dt>Passkey records</dt>
				<dd>
					@ui.Badge("neutral", fmt.Sprint(len(data.Passkeys)))
				</dd>
				<dt>Active sessions</dt>
				<dd>
					@ui.Badge("neutral", fmt.Sprint(len(data.Sessions)))
				</dd>
			</dl>
		}
	</div>
	@ui.Card(ui.CardProps{ID: "profile-roles", Title: "Roles and permissions", Description: "Common resource capabilities for your current organization and project scope. Billing, platform-admin, and other routes may apply separate checks."}) {
		<div class="ts-grid-2">
			@claimList("profile-role-list-title", "Roles", data.Roles, "No active organization role", "No role is available for the current organization membership.")
			@claimList("profile-permission-list-title", "Common capabilities", data.Permissions, "No scoped permissions", "No resource capabilities are available for the current organization and project scope.")
		</div>
	}
}

templ claimList(id, title string, values []string, emptyTitle, emptyDetail string) {
	<section class="ts-stack-sm" aria-labelledby={ id }>
		<h3 class="ts-label" id={ id }>{ title }</h3>
		if len(values) == 0 {
			@ui.Empty(emptyTitle, emptyDetail)
		} else {
			<div class="ts-row ts-profile-claims">
				for _, value := range values {
					@ui.Badge("neutral", value)
				}
			</div>
		}
	</section>
}

templ securityTab(data pageData, csrfToken string) {
	<div class="ts-split">
		<div class="ts-stack-lg">
			@ui.Card(ui.CardProps{ID: "profile-password", Title: "Change password", Description: "All active sessions are terminated after the password changes."}) {
				<form method="post" action="/api/v1/dashboard/profile/password" class="ts-form">
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					@passwordField("currentPassword", "currentPassword", "Current password", "current-password")
					@ui.Field(ui.FieldProps{ID: "newPassword", Label: "New password", Hint: "Use at least 12 characters."}) {
						@ui.PasswordInput(ui.PasswordProps{ID: "newPassword", Autocomplete: "new-password", MinLength: 12})
					}
					@ui.Field(ui.FieldProps{ID: "confirmPassword", Label: "Confirm new password"}) {
						@ui.PasswordInput(ui.PasswordProps{ID: "confirmPassword", Autocomplete: "new-password", MinLength: 12})
					}
					<div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Change password and sign out</button></div>
				</form>
			}
			@ui.Card(ui.CardProps{ID: "profile-mfa", Title: "Multi-factor authentication", Description: "Demo simulation only. These records do not verify sign-ins or protect your account."}) {
				@mfaBody(data, csrfToken)
			}
		</div>
		@ui.Card(ui.CardProps{ID: "profile-passkeys", Title: "Passkeys", Description: "Demo records only. No passkey is registered with a browser or security key, and these records cannot sign you in."}) {
			if data.Demo {
				if len(data.Passkeys) == 0 {
					@ui.Empty("No demo passkey records", "You can add a placeholder record to preview this interface.")
				} else {
					<ul class="ts-list">
						for _, passkey := range data.Passkeys {
							<li class="ts-list-item">
								<div class="ts-list-main">
									<span class="ts-strong">{ passkey.Name }</span>
									<span class="ts-meta">Demo record · Added { passkey.CreatedAt }</span>
								</div>
								<form method="post" action="/api/v1/dashboard/profile/passkeys/remove">
									<input type="hidden" name="_csrf" value={ csrfToken }/>
									<input type="hidden" name="passkeyId" value={ passkey.ID }/>
									<button class="ts-btn ts-btn-danger ts-btn-sm" type="submit">Remove demo record</button>
								</form>
							</li>
						}
					</ul>
				}
				<form method="post" action="/api/v1/dashboard/profile/passkeys/register" class="ts-form ts-card-section">
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					@ui.Field(ui.FieldProps{ID: "passkeyName", Label: "Demo record name"}) {
						<input class="ts-input" id="passkeyName" name="name" maxlength="128" placeholder="Work laptop" required/>
					}
					<div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Add demo passkey record</button></div>
				</form>
			} else {
				@ui.Alert("info", "", "Demo passkey records are unavailable in this deployment.")
			}
		}
	</div>
}

templ mfaBody(data pageData, csrfToken string) {
	if !data.Demo {
		@ui.Alert("info", "", "Demo MFA enrollment is unavailable in this deployment.")
	} else {
		<div class="ts-alert ts-alert-warning" role="note">
			<p class="ts-alert-title">Demo-only security simulation</p>
			<p class="ts-alert-body">Authenticator secrets and recovery codes shown here are demonstration values. They are not usable authentication factors and do not secure sign-in.</p>
		</div>
		if data.MFAEnabled {
			<div class="ts-alert">
				<p class="ts-alert-title">A demo authenticator record is enabled.</p>
				<p class="ts-alert-body">It is stored only for this demo and is never checked during sign-in.</p>
			</div>
			<form method="post" action="/api/v1/dashboard/profile/mfa/remove" class="ts-form">
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				<input type="hidden" name="factor" value="totp"/>
				@passwordField("mfaDisablePassword", "password", "Current password", "current-password")
				<div class="ts-form-actions"><button class="ts-btn ts-btn-danger" type="submit">Remove demo MFA record</button></div>
			</form>
			<form method="post" action="/api/v1/dashboard/profile/mfa/recovery-codes" class="ts-form ts-card-section">
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				@passwordField("recoveryPassword", "password", "Current password", "current-password")
				<div class="ts-form-actions"><button class="ts-btn ts-btn-secondary" type="submit">Generate demo recovery codes</button></div>
			</form>
		} else if data.TOTPSecret != "" {
			<form method="post" action="/api/v1/dashboard/profile/mfa/verify" class="ts-form">
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				<input type="hidden" name="enrollment" value={ data.TOTPEnrollmentToken }/>
				<div class="ts-alert ts-alert-info">
					<p class="ts-alert-title">One-time demo secret</p>
					<code class="ts-mono ts-break">{ data.TOTPSecret }</code>
					<p class="ts-alert-body">This secret is displayed once for this simulation. It is not a real authenticator secret and cannot be used to protect sign-in.</p>
				</div>
				@ui.Field(ui.FieldProps{ID: "mfaCode", Label: "Six-digit demo verification code"}) {
					<input class="ts-input ts-profile-code" id="mfaCode" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required/>
				}
				<div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Verify demo code</button></div>
			</form>
		} else {
			<div class="ts-alert">
				<p class="ts-alert-title">No demo MFA record is enabled.</p>
				<p class="ts-alert-body">The enrollment flow is for previewing the profile interface only.</p>
			</div>
			<form method="post" action="/api/v1/dashboard/profile/mfa/enroll" class="ts-form">
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				@passwordField("mfaPassword", "password", "Current password", "current-password")
				<div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Start demo MFA enrollment</button></div>
			</form>
		}
		if len(data.RecoveryCodes) > 0 {
			<div class="ts-alert ts-alert-warning" role="status">
				<p class="ts-alert-title">One-time demo recovery codes</p>
				<p class="ts-alert-body">These values are revealed once, are not accepted at sign-in, and do not protect your account.</p>
				<pre class="ts-code">{ strings.Join(data.RecoveryCodes, "\n") }</pre>
			</div>
		}
	}
}

templ passwordField(id, name, label, autocomplete string) {
	@ui.Field(ui.FieldProps{ID: id, Label: label}) {
		@ui.PasswordInput(ui.PasswordProps{ID: id, Name: name, Autocomplete: autocomplete})
	}
}

templ sessionsTab(data pageData) {
	@ui.Card(ui.CardProps{ID: "profile-sessions", Title: "Active sessions", Description: "Read-only local dashboard sessions. Session details are limited to the values available here.", Flush: true}) {
		if len(data.Sessions) == 0 {
			@ui.Empty("No active sessions", "No active local dashboard sessions were returned.")
		} else {
			<div class="ts-table-wrap" tabindex="0" role="region" aria-label="Active sessions table. Scroll horizontally to see all columns.">
				<table class="ts-table">
					<caption class="ts-sr-only">Active local dashboard sessions with their current status and expiry.</caption>
					<thead>
						<tr><th scope="col">Status</th><th scope="col">Session ID</th><th scope="col">Expires</th></tr>
					</thead>
					<tbody>
						for _, session := range data.Sessions {
							<tr>
								<td>
									if session.Current {
										@ui.Badge("success", "Current session")
									} else {
										@ui.Badge("neutral", "Active")
									}
								</td>
								<td class="ts-table-mono">{ session.ID }</td>
								<td>{ session.ExpiresAt }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}


func onOff(on bool) string {
	if on {
		return "On"
	}
	return "Off"
}
