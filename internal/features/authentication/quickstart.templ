package authentication

import (
	"cmp"
	"strings"

	"terrascale.tech/dashboard/internal/ui"
	"terrascale.tech/dashboard/internal/ui/icons"
)

// quickstartSection walks through an OpenID Connect integration using this
// instance's issuer and its first registered application.
templ quickstartSection(data pageData) {
	@ui.Card(ui.CardProps{ID: "auth-quickstart", Title: "Connect your application", Description: data.Section.Description}) {
		<ol class="ts-idp-steps ts-idp-quickstart">
			<li class={ "ts-idp-step", templ.KV("ts-idp-step-done", len(data.Clients) > 0) }>
				@stepMarker(1, len(data.Clients) > 0)
				<div class="ts-idp-step-text">
					<p class="ts-strong">Register an OAuth application</p>
					if len(data.Clients) > 0 {
						<p class="ts-meta">Using <span class="ts-strong">{ data.Clients[0].Name }</span>. Add its redirect URIs before starting a sign-in.</p>
					} else {
						<p class="ts-meta">Create a client with the redirect URI your app handles.</p>
						<a class="ts-btn ts-btn-primary ts-btn-sm" href="/auth/clients">
							@icons.Plus(15)
							<span>Register application</span>
						</a>
					}
				</div>
			</li>
			<li class="ts-idp-step">
				@stepMarker(2, false)
				<div class="ts-idp-step-text">
					<p class="ts-strong">Configure your OpenID Connect library</p>
					<p class="ts-meta">Any certified client works; it discovers every endpoint from the issuer.</p>
					@snippet(".env", envSnippet(data))
				</div>
			</li>
			<li class="ts-idp-step">
				@stepMarker(3, false)
				<div class="ts-idp-step-text">
					<p class="ts-strong">Send users to sign in</p>
					<p class="ts-meta">Use the authorization code flow with a PKCE S256 challenge; <code>openid</code>, <code>profile</code>, and <code>email</code> scopes are available.</p>
					@snippet("Authorization request", authorizeSnippet(data))
				</div>
			</li>
			<li class="ts-idp-step">
				@stepMarker(4, false)
				<div class="ts-idp-step-text">
					<p class="ts-strong">Verify tokens on your API</p>
					<p class="ts-meta">ID and access tokens are ES256 JWTs; check them against the instance key set.</p>
					<dl class="ts-kv ts-idp-endpoints">
						<dt>Discovery</dt>
						<dd>
							@copyValue("Discovery URL", data.issuer()+"/.well-known/openid-configuration")
						</dd>
						<dt>JWKS</dt>
						<dd>
							@copyValue("JWKS URL", data.issuer()+"/.well-known/jwks.json")
						</dd>
						<dt>Userinfo</dt>
						<dd>
							@copyValue("Userinfo URL", data.issuer()+"/oauth/userinfo")
						</dd>
					</dl>
				</div>
			</li>
			<li class="ts-idp-step">
				@stepMarker(5, false)
				<div class="ts-idp-step-text">
					<p class="ts-strong">Manage users from your backend</p>
					<p class="ts-meta">Call the Management API with a scoped <code>sk_</code> key from <a class="ts-link" href="/auth/keys">Management keys</a>.</p>
					@snippet("Management API", managementSnippet(data))
				</div>
			</li>
		</ol>
	}
}

templ stepMarker(number int, done bool) {
	<span class="ts-idp-step-marker" aria-hidden="true">
		if done {
			@icons.Check(14)
		} else {
			{ number }
		}
	</span>
}

templ snippet(title, body string) {
	<div class="ts-snippet">
		<div class="ts-snippet-header">{ title }</div>
		<pre class="ts-snippet-body">{ body }</pre>
	</div>
}

func quickstartClient(data pageData) (string, string) {
	if len(data.Clients) == 0 {
		return "<client id>", "https://app.example.com/callback"
	}
	client := data.Clients[0]
	redirect, _, _ := strings.Cut(client.Values["redirect_uris"], "\n")
	return client.ID, cmp.Or(redirect, "https://app.example.com/callback")
}

func envSnippet(data pageData) string {
	clientID, redirect := quickstartClient(data)
	return "TS_AUTH_ISSUER=" + data.issuer() + "\n" +
		"TS_AUTH_CLIENT_ID=" + clientID + "\n" +
		"TS_AUTH_REDIRECT_URI=" + redirect
}

func authorizeSnippet(data pageData) string {
	clientID, redirect := quickstartClient(data)
	return "GET " + data.issuer() + "/oauth/authorize\n" +
		"  ?response_type=code\n" +
		"  &client_id=" + clientID + "\n" +
		"  &redirect_uri=" + redirect + "\n" +
		"  &scope=openid%20profile%20email\n" +
		"  &code_challenge=<S256 challenge>&code_challenge_method=S256\n" +
		"  &state=<random>&nonce=<random>"
}

func managementSnippet(data pageData) string {
	return "curl " + data.Origin + "/v1/" + data.Slug + "/users \\\n" +
		"  -H \"Authorization: Bearer $TS_AUTH_SECRET_KEY\""
}
