package authentication

import (
	"unicode"

	"terrascale.tech/dashboard/internal/ui"
	"terrascale.tech/dashboard/internal/ui/icons"
)

templ authenticationView(data pageData, csrfToken string) {
	<main class="ts-page ts-idp" data-tone={ data.Section.Tone } data-auth-section={ data.Section.Key }>
		@ui.PageHeader(heading(data.Section))
		if data.Saved {
			@ui.Alert("success", "", "Changes saved.")
		}
		if data.Error != "" {
			@ui.Alert("danger", "", data.Error)
		}
		if !data.CanManage && data.Section.Key != "overview" && data.Section.Key != "quickstart" && data.Section.Key != "audit" {
			@ui.Alert("info", "", "You can view this configuration. Organization owners and admins can change it.")
		}
		switch data.Section.Key {
			case "overview":
				@overviewSection(data)
			case "quickstart":
				@quickstartSection(data)
			case "sign-in", "mfa":
				@strategySection(data, csrfToken)
			case "sessions":
				@sessionsSection(data)
			case "branding":
				@brandingSection(data, csrfToken)
			case "audit":
				@auditSection(data)
			case "connections":
				@connectionsSection(data, csrfToken)
			default:
				@resourceSection(data, csrfToken)
		}
	</main>
}

// tile is a small colored icon badge for a section, provider, or step.
templ tile(icon func(int) templ.Component, tone string) {
	<span class="ts-idp-tile" data-tone={ tone } aria-hidden="true">
		@icon(16)
	</span>
}

templ statusBadge(status string) {
	@ui.StatusBadge(statusTone(status), status)
}

// copyValue shows a value in monospace with a Datastar copy button.
templ copyValue(label, value string) {
	<div class="ts-idp-copy">
		<code class="ts-idp-copy-value" aria-label={ label }>{ value }</code>
		<button class="ts-btn ts-btn-ghost ts-btn-sm" type="button" aria-label={ "Copy " + label } data-signals={ "{" + copySignal(label) + ": false}" } data-on:click={ "navigator.clipboard.writeText(el.previousElementSibling.textContent).then(() => $" + copySignal(label) + " = true)" }>
			@icons.Copy(14)
			<span data-text={ "$" + copySignal(label) + " ? 'Copied' : 'Copy'" }>Copy</span>
		</button>
	</div>
}

// copySignal names a page-local Datastar signal after the copied value.
func copySignal(label string) string {
	name := []rune("_copy")
	for _, r := range label {
		if unicode.IsLetter(r) || unicode.IsDigit(r) {
			name = append(name, r)
		}
	}
	return string(name)
}

func heading(current section) string {
	if current.Key == "overview" {
		return "Authentication"
	}
	return "Authentication: " + current.Title
}

func statusTone(status string) string {
	switch status {
	case "Active":
		return "emerald"
	case "Pending":
		return "amber"
	case "Blocked", "Revoked":
		return "rose"
	}
	return "slate"
}
