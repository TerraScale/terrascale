package databases

import (
	"strconv"

	"terrascale.tech/dashboard/internal/core"
	"terrascale.tech/dashboard/internal/features/replication"
	"terrascale.tech/dashboard/internal/ui"
	"terrascale.tech/dashboard/internal/ui/icons"
)

type fact struct {
	Label string
	Value string
}

templ detailContent(page core.Page, d detailData) {
	@Frame(FrameProps{Database: d.Database, Tab: d.Tab}) {
		if d.Error != "" && !d.OpenDelete && !restoreErrorInDialog(d) {
			@ui.Alert("danger", "", d.Error)
		}
		if d.Created {
			@createdNotice(d.Database)
		}
		switch d.Tab {
			case "backups":
				@detailBackups(page, d)
			case "branches":
				@detailBranches(page, d)
			case "import":
				@ui.Card(ui.CardProps{ID: "import", Title: "Import and export", Description: "Lossless JSONL and CSV controls will appear when the SDK contract is published"}) {
					@ui.Alert("info", "No local import or export", "The published TerraScale SDK does not expose database import or lossless export operations.")
					<div class="ts-row">
						<button type="button" class="ts-btn ts-btn-secondary" disabled>@icons.Upload(16)<span>Import JSONL / CSV</span></button>
						<button type="button" class="ts-btn ts-btn-secondary" disabled>@icons.Download(16)<span>Export lossless JSONL</span></button>
					</div>
				}
			default:
				if d.Info.Unavailable != "" {
					@ui.Alert("warning", "Counts unavailable", d.Info.Unavailable)
				}
				@ui.Stats("Database summary") {
					@ui.ToneStat("violet", "Collections", strconv.Itoa(d.Info.Collections), "In this database")
					@ui.ToneStat("blue", "Documents", strconv.Itoa(d.Info.Documents), ui.FormatBytes(d.Info.Bytes)+" across all collections")
					@ui.ToneStat("teal", "Restore points", strconv.Itoa(len(d.Info.Backups)), backupStatusDescription(d.Info))
					@ui.ToneStat("slate", "Created", d.Database.CreatedAt.UTC().Format("Jan 2"), d.Database.CreatedAt.UTC().Format("2006 · 15:04 UTC"))
				}
				@detailPlacement(page, d)
				<p class="ts-meta ts-measurement-loading" role="status">Loading replication measurements…</p>
				@replication.Section(d.Replication)
				if d.CanManage {
					@detailDelete(page, d)
				}
		}
	}
}

// createdNotice ends the create flow on the new database: ready, still
// provisioning, or failed, as its status says.
templ createdNotice(db core.Database) {
	{{ tone, title, body := createdState(db) }}
	<div class={ "ts-alert", "ts-db-created", "ts-alert-" + tone } data-status={ db.Status }>
		<span class="ts-db-created-mark" aria-hidden="true">
			if tone == "success" {
				@icons.Check(18)
			} else {
				@icons.Database(18)
			}
		</span>
		<div class="ts-list-main">
			<p class="ts-alert-title">{ title }</p>
			<p class="ts-alert-body">{ body }</p>
		</div>
	</div>
}

templ facts(items []fact) {
	<dl class="ts-db-facts">
		for _, item := range items {
			<div>
				<dt>{ item.Label }</dt>
				<dd>{ item.Value }</dd>
			</div>
		}
	</dl>
}

templ detailPlacement(page core.Page, d detailData) {
	@ui.Card(ui.CardProps{ID: "placement", Title: "Placement and latency", Description: "Configured regions for this database"}) {
		@facts([]fact{
			{Label: "Placement lock", Value: regionListDisplay(databaseRegions(d.Database))},
			{Label: "Placement status", Value: "Not reported"},
			{Label: "Generation", Value: "Not reported"},
			{Label: "Replication", Value: replicationDisplay(databaseRegions(d.Database))},
		})
		@ui.Alert("info", "Configured regions", "The dashboard records the database regions. Replication measurements are shown below.")
		if d.CanManage {
			<form method="post" action="/api/v1/dashboard/databases/regions" class="ts-form" aria-label="Change regions">
				<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
				<input type="hidden" name="databaseId" value={ d.Database.ID }/>
				<fieldset class="ts-field ts-db-regions">
					<legend class="ts-label">Regions</legend>
					@regionCards("database-placement", d.Choices, databaseRegions(d.Database), d.Database.Region)
					if d.RegionsError != "" {
						@regionHint(d.RegionsError)
					} else {
						<p class="ts-hint">{ regionDisplay(d.Database.Region) } is the home region and stays selected. Add a region to replicate the database there; remove one to stop serving it there.</p>
					}
				</fieldset>
				<div class="ts-row">
					<button class="ts-btn ts-btn-secondary" type="submit">Save regions</button>
				</div>
			</form>
		}
		if len(d.Info.Regions) > 0 {
			<div class="ts-table-wrap">
				<table class="ts-table">
					<thead><tr><th>Region</th><th class="ts-num">Estimated round trip</th></tr></thead>
					<tbody>
						for _, region := range d.Info.Regions {
							<tr><td>{ region.Name }</td><td class="ts-num">{ region.Estimate }</td></tr>
						}
					</tbody>
				</table>
			</div>
		}
		if len(d.Info.Regions) > 0 && d.Info.Regions[0].Sample {
			<p class="ts-meta">Illustrative 0 ms estimate from the original Mario demo fixture; no provider measurement was taken.</p>
		} else {
			<p class="ts-meta">No provider latency measurements are available.</p>
		}
	}
}

templ detailBackups(page core.Page, d detailData) {
	<div class="ts-split">
		@ui.Card(ui.CardProps{ID: "restore-points", Title: "Restore points", Description: "Restore a snapshot over this database or into a new one.", Actions: createBackupAction(page, d), Flush: true}) {
			if len(d.Info.Backups) > 0 {
				<div class="ts-table-wrap">
					<table class="ts-table">
						<thead><tr><th>Created</th><th>Status</th><th class="ts-num">Size</th><th>Actions</th></tr></thead>
						<tbody>
							for _, backup := range d.Info.Backups {
								<tr>
									<td class="ts-mono">{ backup.CreatedAt.UTC().Format("2006-01-02 15:04 UTC") }</td>
									<td>@ui.Badge(backupTone(backup.Status), backup.Status)</td>
									<td class="ts-num">{ ui.FormatBytes(backup.SizeBytes) }</td>
									<td>
										if d.Info.CanRestoreBackups || d.Info.CanOverwriteBackups {
											@ui.DialogTrigger(ui.DialogTriggerProps{Dialog: "restore-" + backup.ID, Label: "Restore", Icon: icons.RotateCcw(15), Small: true})
											@restoreDialog(page, d, backup)
										} else {
											<span class="ts-meta">Requires provisioning access</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			} else {
				@ui.Empty("No restore points yet.", "Create a backup to capture the current state of this database.")
			}
		}
		@ui.Card(ui.CardProps{ID: "backup-policy", Title: "Backup policy", Description: "Cron schedules and how long snapshots are kept."}) {
			<div class="ts-db-setting">
				<div class="ts-list-main">
					<span class="ts-strong">Scheduled backups</span>
					<span class="ts-meta">{ backupStatusDescription(d.Info) }</span>
				</div>
				if d.Info.CanToggleBackups {
					<form method="post" action="/api/v1/dashboard/backups/policy">
						<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
						<input type="hidden" name="databaseId" value={ d.Database.ID }/>
						<input type="hidden" name="fullBackupCron" value={ d.Info.BackupPolicy.FullBackupCron }/>
						<input type="hidden" name="incrementalBackupCron" value={ d.Info.BackupPolicy.IncrementalBackupCron }/>
						<input type="hidden" name="retentionDays" value={ backupRetentionDays(d.Info.BackupPolicy.RetentionDays) }/>
						<input type="hidden" name="disabled" value={ backupToggleDisabled(d.Info.BackupsEnabled) }/>
						<button type="submit" class="ts-switch" role="switch" aria-checked={ backupChecked(d.Info.BackupsEnabled) } aria-label="Scheduled backups"></button>
					</form>
				} else {
					<span class="ts-meta">{ backupAvailability(d.Info) }</span>
				}
			</div>
			if d.Info.CanEditBackupPolicy {
				<form method="post" action="/api/v1/dashboard/backups/policy" class="ts-form">
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
					<input type="hidden" name="databaseId" value={ d.Database.ID }/>
					<input type="hidden" name="disabled" value={ backupToggleDisabled(d.Info.BackupPolicy.Disabled) }/>
					@ui.Field(ui.FieldProps{ID: "full-cron", Label: "Full backup schedule"}) {
						<input class="ts-input ts-mono" id="full-cron" name="fullBackupCron" value={ policyValue(d, d.Refill.FullCron, d.Info.BackupPolicy.FullBackupCron) } placeholder="0 2 * * *"/>
					}
					@ui.Field(ui.FieldProps{ID: "incremental-cron", Label: "Incremental schedule"}) {
						<input class="ts-input ts-mono" id="incremental-cron" name="incrementalBackupCron" value={ policyValue(d, d.Refill.IncrementalCron, d.Info.BackupPolicy.IncrementalBackupCron) } placeholder="0 * * * *"/>
					}
					@ui.Field(ui.FieldProps{ID: "retention", Label: "Retention days"}) {
						<input class="ts-input" id="retention" name="retentionDays" type="number" min="1" max="35" value={ policyValue(d, d.Refill.Retention, backupRetentionDays(d.Info.BackupPolicy.RetentionDays)) } required/>
					}
					<div class="ts-form-actions">
						<button class="ts-btn ts-btn-primary" type="submit">Save policy</button>
					</div>
				</form>
			} else if d.Info.HasBackupSchedule {
				<p class="ts-meta">Schedule: <span class="ts-mono">{ d.Info.BackupPolicy.FullBackupCron }</span> · Retention: { backupRetentionDays(d.Info.BackupPolicy.RetentionDays) } days</p>
			}
			if d.Info.Demo {
				<p class="ts-meta">The demo saves this policy, but does not run scheduled backups automatically.</p>
			}
		}
	</div>
}

// restoreDialog restores backup over the database, after the user types its
// name, or into a new database.
templ restoreDialog(page core.Page, d detailData, backup core.Backup) {
	{{ id := "restore-" + backup.ID }}
	{{ taken := backup.CreatedAt.UTC().Format("2006-01-02 15:04 UTC") }}
	@ui.Dialog(ui.DialogProps{ID: id, Title: "Restore backup", Description: "Restore the " + taken + " backup of " + d.Database.Name + ".", Open: restoreErrorInDialog(d) && d.Refill.RestoreBackupID == backup.ID}) {
		if restoreErrorInDialog(d) && d.Refill.RestoreBackupID == backup.ID {
			@ui.Alert("danger", "", d.Error)
		}
		@facts([]fact{{Label: "Database", Value: d.Database.Name}, {Label: "Backup taken", Value: taken}, {Label: "Size", Value: ui.FormatBytes(backup.SizeBytes)}})
		if d.Info.CanRestoreBackups {
			<form method="post" action="/api/v1/dashboard/backups/restore" class="ts-form" aria-label="Restore into a new database">
				<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
				<input type="hidden" name="databaseId" value={ d.Database.ID }/>
				<input type="hidden" name="backupId" value={ backup.ID }/>
				@ui.Field(ui.FieldProps{ID: id + "-name", Label: "New database name", Hint: "Leaves " + d.Database.Name + " unchanged."}) {
					<input class="ts-input" id={ id + "-name" } name="name" value={ restoreName(d, backup.ID) } pattern={ namePatternHTML } maxlength="63" title="Lowercase letters, digits, and hyphens" required/>
				}
				<div class="ts-form-actions">
					<button class="ts-btn ts-btn-secondary" type="submit">Restore as new database</button>
				</div>
			</form>
		}
		if d.Info.CanOverwriteBackups {
			<form method="post" action="/api/v1/dashboard/backups/restore" class="ts-form" aria-label={ "Overwrite " + d.Database.Name }>
				<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
				<input type="hidden" name="databaseId" value={ d.Database.ID }/>
				<input type="hidden" name="backupId" value={ backup.ID }/>
				<input type="hidden" name="replace" value="1"/>
				@ui.Alert("warning", "This overwrites current data", "Every document, schema, and index in "+d.Database.Name+" is replaced with this backup. Changes made after "+taken+" are lost.")
				@ui.Field(ui.FieldProps{ID: id + "-confirm", Label: "Type " + d.Database.Name + " to confirm"}) {
					<input class="ts-input" id={ id + "-confirm" } name="confirmName" required autocomplete="off"/>
				}
				@ui.DialogActions(id) {
					<button class="ts-btn ts-btn-danger" type="submit">Overwrite { d.Database.Name }</button>
				}
			</form>
		}
	}
}

templ createBackupAction(page core.Page, d detailData) {
	if d.Info.CanCreateBackups {
		<form method="post" action="/api/v1/dashboard/backups">
			<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
			<input type="hidden" name="databaseId" value={ d.Database.ID }/>
			<button class="ts-btn ts-btn-primary ts-btn-sm" type="submit">@icons.Archive(16)<span>Create backup</span></button>
		</form>
	}
}

templ detailBranches(page core.Page, d detailData) {
	@ui.Card(ui.CardProps{ID: "branches", Title: "Branches", Description: "Create a database branch in the selected project"}) {
		@facts([]fact{
			{Label: "Branch creation", Value: branchCapability(d.Info.Demo)},
			{Label: "Physical clone", Value: "Not reported"},
			{Label: "Promotion", Value: "Unavailable"},
			{Label: "Merge", Value: "Unavailable"},
		})
		if d.Info.Demo {
			<p class="ts-meta">Demo branches copy the source database snapshot in memory.</p>
		}
		<div class="ts-row">
			if d.Info.CanBranch {
				<form method="post" action="/api/v1/dashboard/databases/branch">
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
					<input type="hidden" name="databaseId" value={ d.Database.ID }/>
					<button type="submit" class="ts-btn ts-btn-primary">@icons.GitBranch(16)<span>Create preview branch</span></button>
				</form>
				@ui.DialogTrigger(ui.DialogTriggerProps{Dialog: "name-branch", Label: "Choose a branch name", Icon: icons.Pencil(15)})
			}
			<button type="button" class="ts-btn ts-btn-secondary" disabled>View diff (contract unavailable)</button>
		</div>
	}
	if d.Info.CanBranch {
		@ui.Dialog(ui.DialogProps{ID: "name-branch", Title: "Create branch", Description: "Copy " + d.Database.Name + " into a new database with the name you choose."}) {
			<form method="post" action="/api/v1/dashboard/databases/branch" class="ts-form">
				<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
				<input type="hidden" name="databaseId" value={ d.Database.ID }/>
				@ui.Field(ui.FieldProps{ID: "branch-name", Label: "New database name", Hint: "Lowercase letters, digits, and hyphens."}) {
					<input class="ts-input" id="branch-name" name="name" pattern={ namePatternHTML } maxlength="63" required/>
				}
				@ui.DialogActions("name-branch") {
					<button class="ts-btn ts-btn-primary" type="submit">Create branch</button>
				}
			</form>
		}
	}
}

templ detailDelete(page core.Page, d detailData) {
	<section class="ts-db-danger" aria-labelledby="danger-zone-title">
		<div class="ts-list-main">
			<h2 class="ts-section-title" id="danger-zone-title">Danger zone</h2>
			<p class="ts-meta">Permanently remove this database and its data.</p>
		</div>
		@ui.DialogTrigger(ui.DialogTriggerProps{Dialog: "delete-database", Label: "Delete database", Icon: icons.Trash2(15), Variant: "danger"})
	</section>
	@ui.Dialog(ui.DialogProps{ID: "delete-database", Title: "Delete " + d.Database.Name, Description: "This permanently removes the database and all of its data.", Open: d.OpenDelete}) {
		<form method="post" action="/api/v1/dashboard/databases/delete" class="ts-form">
			<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
			<input type="hidden" name="databaseId" value={ d.Database.ID }/>
			if d.OpenDelete && d.Error != "" {
				@ui.Alert("danger", "", d.Error)
			}
			@ui.Field(ui.FieldProps{ID: "confirm-name", Label: "Type " + d.Database.Name + " to confirm"}) {
				<input class="ts-input" id="confirm-name" name="confirmName" required autocomplete="off"/>
			}
			@ui.DialogActions("delete-database") {
				<button class="ts-btn ts-btn-danger" type="submit">Delete database</button>
			}
		</form>
	}
}
