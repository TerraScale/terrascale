package home

import (
	"fmt"

	"terrascale.tech/dashboard/internal/ui"
	"terrascale.tech/dashboard/internal/features/analytics"
	"terrascale.tech/dashboard/internal/features/replication"
	"terrascale.tech/dashboard/internal/ui/charts"
	"terrascale.tech/dashboard/internal/ui/icons"
)

templ homeView(data pageData) {
	<main class="ts-page ts-home">
		@ui.PageHeader(homeTitle(data.Tab)) {
			<a class="ts-btn ts-btn-secondary" href="/api-keys">@icons.KeyRound(16)
<span>API keys</span></a>
			<a class="ts-btn ts-btn-primary" href="/databases">@icons.Plus(16)
<span>New database</span></a>
			if data.Tab == "overview" {
				<form class="ts-filters" method="get" action="/" aria-label="Filter overview analytics" data-submit-once>
					<label class="ts-filter-inline" for="overview-range">
						<span class="ts-filter-inline-label">Range</span>
						<select class="ts-select" id="overview-range" name="range">
							for _, rangeKey := range []string{"1h", "24h", "7d", "30d"} {
								<option value={ rangeKey } selected?={ rangeKey == data.ActivityRange }>{ rangeKey }</option>
							}
						</select>
					</label>
					<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Apply</button>
				</form>
			}
		}
		@ui.Tabs("Overview sections", []ui.Tab{
			{Label: "Overview", URL: "/", Active: data.Tab != "connect"},
			{Label: "Connect", URL: "/?tab=connect", Active: data.Tab == "connect"},
		})
		if data.Tab == "connect" {
			@connectView(data)
		} else {
			@overviewView(data)
		}
	</main>
}

templ overviewView(data pageData) {
	<p class="ts-meta ts-measurement-loading" role="status">Loading analytics, replication and regions…</p>
	@analytics.Home(data.Analytics)
	<div class="ts-grid ts-grid-2">
		@regionsPanel(data.Regions)
		@replication.Summary(data.Replication)
	</div>
	@ui.Stats("Workspace metrics") {
		@ui.Stat("Databases", fmt.Sprint(data.DatabaseCount), data.DatabaseDetail)
		@ui.Stat("Organization members", fmt.Sprint(data.OrganizationMembers), data.OrganizationMembersDetail)
		@ui.Stat("Unread alerts", fmt.Sprint(data.UnreadNotifications), fmt.Sprint(data.TotalNotifications)+" "+data.NotificationsDetail)
	}
	<div class="ts-split">
		@ui.Card(ui.CardProps{ID: "home-activity", Title: "Activity", Description: data.ActivityNote, Actions: activityRange(data)}) {
			if len(data.ActivityChart.Paths) > 0 {
				<p class="ts-home-activity-total">
					<span class="ts-chart-swatch ts-cat-1" aria-hidden="true"></span> Reads <strong>{ fmt.Sprint(data.ActivityReads) }</strong>
					<span class="ts-chart-swatch ts-cat-2" aria-hidden="true"></span> Writes <strong>{ fmt.Sprint(data.ActivityWrites) }</strong>
				</p>
				<div class="ts-chart-shell" role="region" aria-label="Reads and writes chart. Scroll horizontally for the full plot." tabindex="0">
					@charts.Line(data.ActivityChart)
				</div>
			} else {
				@ui.Empty("No measured reads or writes to plot.", "")
			}
			<a class="ts-link ts-meta" href="/organization?tab=audit">View persisted audit events →</a>
		}
		@ui.Card(ui.CardProps{ID: "getting-started", Title: "Getting started", Description: "Get a database online and wire it into your stack."}) {
			<ol class="ts-home-steps">
				@gettingStartedStep(1, "Create first database", "Create a logical database in the region closest to your users.", "/databases", "Open databases", data.DatabaseCount > 0)
				@gettingStartedStep(2, "Create an Application credential", "Generate a scoped API key or M2M client for your application.", "/api-keys", "Open API keys", data.ActiveCredentials > 0)
			</ol>
			<a class="ts-btn ts-btn-secondary ts-btn-block" href="/?tab=connect">@icons.Zap(16)
<span>Connect your AI or platform</span></a>
		}
	</div>
}

templ activityRange(data pageData) {
	<span class="ts-sr-only" id="home-range-label">Activity range</span>
	@ui.Dropdown(ui.DropdownProps{End: true, LabelledBy: "home-range-label home-range-value", Trigger: rangeTrigger(data.ActivityRange), TriggerClass: "ts-select ts-input-sm"}) {
		for _, r := range []string{"1h", "24h", "7d", "30d"} {
			@ui.MenuItem(ui.MenuItemProps{Href: "/?range=" + r, Label: r, Current: data.ActivityRange == r})
		}
	}
}

templ rangeTrigger(activityRange string) {
	<span id="home-range-value">{ activityRange }</span>
}

templ gettingStartedStep(number int, title, description, href, cta string, done bool) {
	<li class={ "ts-home-step", templ.KV("ts-home-step-done", done) }>
		<span class="ts-home-step-number" aria-hidden="true">
			if done {
				@icons.Check(14)
			} else {
				{ fmt.Sprint(number) }
			}
		</span>
		<div class="ts-stack-sm">
			<div class="ts-row-between">
				<span class="ts-strong">{ title }</span>
				if done {
					@ui.Badge("success", "Done")
				} else {
					@ui.Badge("warning", "Open")
				}
			</div>
			<p class="ts-meta">{ description }</p>
			<a class="ts-link" href={ templ.SafeURL(href) }>{ cta } →</a>
		</div>
	</li>
}

templ connectView(data pageData) {
	<ul class="ts-grid ts-home-connect">
		@connectOption(icons.Bot(18), "AI assistants", "Connect Claude, Cursor, and other MCP-compatible assistants to manage your organizations, projects, and databases.", true)
		@connectOption(icons.FileJson(18), "TypeScript SDK", "Install the SDK and query your databases directly from your application.", false)
		@connectOption(icons.Globe(18), "REST API", "Call the project API from any language with a scoped credential.", false)
		@connectOption(icons.Terminal(18), "CLI and CI", "Manage databases and run queries from your terminal or pipeline.", false)
	</ul>
	@ui.Card(ui.CardProps{ID: "mcp-config", Title: "MCP client configuration", Description: "Add this server to your assistant's MCP settings. Assistants act as you, with your dashboard permissions."}) {
		<ol class="ts-home-steps">
			<li class="ts-home-step">
				<span class="ts-home-step-number" aria-hidden="true">1</span>
				<div class="ts-stack-sm">
					<span class="ts-strong">Create a personal access token</span>
					<p class="ts-meta">Tokens expire and can be revoked at any time from your profile.</p>
					<a class="ts-link" href="/profile?tab=access-tokens">Open access tokens →</a>
				</div>
			</li>
			<li class="ts-home-step">
				<span class="ts-home-step-number" aria-hidden="true">2</span>
				<div class="ts-stack-sm">
					<span class="ts-strong">Add the server with the token as a bearer credential</span>
					<pre class="ts-code"><code>{ mcpClientConfig(data.MCPEndpoint) }</code></pre>
				</div>
			</li>
		</ol>
	}
}

templ connectOption(icon templ.Component, title, description string, available bool) {
	<li class="ts-home-connect-item">
		<span class="ts-home-connect-icon" aria-hidden="true">
			@icon
		</span>
		<div class="ts-stack-sm">
			<div class="ts-row-between">
				<span class="ts-strong">{ title }</span>
				if available {
					@ui.Badge("success", "Available")
				} else {
					@ui.Badge("neutral", "Preview")
				}
			</div>
			<p class="ts-meta">{ description }</p>
		</div>
	</li>
}

// mcpClientConfig is the MCP client configuration for endpoint.
func mcpClientConfig(endpoint string) string {
	return `{
  "mcpServers": {
    "terrascale": {
      "type": "http",
      "url": "` + endpoint + `",
      "headers": {
        "Authorization": "Bearer <your-access-token>"
      }
    }
  }
}`
}

func homeTitle(tab string) string {
	if tab == "connect" {
		return "Connect your AI or platform"
	}
	return "Overview"
}
