package home

import (
	"fmt"

	"terrascale.tech/dashboard/internal/ui"
	"terrascale.tech/dashboard/internal/ui/aria"
	"terrascale.tech/dashboard/internal/ui/charts"
	"terrascale.tech/dashboard/internal/ui/icons"
)

templ homeView(data pageData) {
	<main class="ts-page ts-home">
		@ui.PageHeader(homeTitle(data.Tab)) {
			<a class="ts-btn ts-btn-secondary" href="/api-keys">@icons.KeyRound(16)<span>API keys</span></a>
			<a class="ts-btn ts-btn-primary" href="/databases">@icons.Plus(16)<span>New database</span></a>
		}
		@ui.Tabs("Overview sections", []ui.Tab{
			{Label: "Overview", URL: "/", Active: data.Tab != "connect"},
			{Label: "Connect", URL: "/?tab=connect", Active: data.Tab == "connect"},
		})
		if data.Tab == "connect" {
			@connectView()
		} else {
			@overviewView(data)
		}
	</main>
}

templ overviewView(data pageData) {
	@ui.Stats("Workspace metrics") {
		@ui.Stat("Databases", fmt.Sprint(data.DatabaseCount), data.DatabaseDetail)
		@ui.Stat("Organization members", fmt.Sprint(data.OrganizationMembers), data.OrganizationMembersDetail)
		@ui.Stat("Unread alerts", fmt.Sprint(data.UnreadNotifications), fmt.Sprint(data.TotalNotifications)+" "+data.NotificationsDetail)
	}
	<div class="ts-split">
		@ui.Card(ui.CardProps{ID: "home-activity", Title: "Activity", Description: data.ActivityNote, Actions: activityRange(data)}) {
			<p class="ts-home-activity-total"><span class="ts-dot" aria-hidden="true"></span> { data.ActivityTotalLabel } <strong>{ fmt.Sprint(data.ActivityEvents) }</strong></p>
			<div class="ts-chart-shell" role="region" aria-label="Activity chart. Scroll horizontally for the full plot." tabindex="0">
				@charts.Line(data.ActivityChart)
			</div>
			<a class="ts-link ts-meta" href="/audit">View persisted audit events →</a>
		}
		@ui.Card(ui.CardProps{ID: "getting-started", Title: "Getting started", Description: "Get a database online and wire it into your stack."}) {
			<ol class="ts-home-steps">
				@gettingStartedStep(1, "Create first database", "Create a logical database in the region closest to your users.", "/databases", "Open databases", data.DatabaseCount > 0)
				@gettingStartedStep(2, "Create an Application credential", "Generate a scoped API key or M2M client for your application.", "/api-keys", "Open API keys", data.ActiveCredentials > 0)
			</ol>
			<a class="ts-btn ts-btn-secondary ts-btn-block" href="/?tab=connect">@icons.Zap(16)<span>Connect your AI or platform</span></a>
		}
	</div>
}

templ activityRange(data pageData) {
	<span class="ts-sr-only" id="home-range-label">Activity range</span>
		<details { ui.MenuBehavior... } class="ts-menu ts-menu-end">
			<summary class="ts-select ts-input-sm" aria-labelledby="home-range-label home-range-value"><span id="home-range-value">{ data.ActivityRange }</span></summary>
			<div class="ts-menu-panel">
				for _, r := range []string{"24h", "7d", "30d"} {
					<a class="ts-menu-item" aria-current={ aria.CurrentPage(data.ActivityRange == r) } href={ templ.SafeURL("/?range=" + r) }>{ r }</a>
				}
			</div>
		</details>
}

templ gettingStartedStep(number int, title, description, href, cta string, done bool) {
	<li class={ "ts-home-step", templ.KV("ts-home-step-done", done) }>
		<span class="ts-home-step-number" aria-hidden="true">
			if done {
				@icons.Check(14)
			} else {
				{ fmt.Sprint(number) }
			}
		</span>
		<div class="ts-stack-sm">
			<div class="ts-row-between">
				<span class="ts-strong">{ title }</span>
				if done {
					@ui.Badge("success", "Done")
				} else {
					@ui.Badge("warning", "Open")
				}
			</div>
			<p class="ts-meta">{ description }</p>
			<a class="ts-link" href={ templ.SafeURL(href) }>{ cta } →</a>
		</div>
	</li>
}

templ connectView() {
	<ul class="ts-grid ts-home-connect">
		@connectOption(icons.Bot(18), "AI assistants", "Connect Claude, Cursor, and other MCP-compatible assistants to your project.")
		@connectOption(icons.FileJson(18), "TypeScript SDK", "Install the SDK and query your databases directly from your application.")
		@connectOption(icons.Globe(18), "REST API", "Call the project API from any language with a scoped credential.")
		@connectOption(icons.Terminal(18), "CLI and CI", "Manage databases and run queries from your terminal or pipeline.")
	</ul>
	@ui.Card(ui.CardProps{ID: "mcp-config", Title: "MCP client configuration", Description: "Add this server to your assistant's MCP settings."}) {
		<pre class="ts-code"><code>{ `{
  "mcpServers": {
    "terrascale": {
      "url": "https://<your-terrascale-host>/mcp"
    }
  }
}` }</code></pre>
	}
}

templ connectOption(icon templ.Component, title, description string) {
	<li class="ts-home-connect-item">
		<span class="ts-home-connect-icon" aria-hidden="true">
			@icon
		</span>
		<div class="ts-stack-sm">
			<div class="ts-row-between">
				<span class="ts-strong">{ title }</span>
				@ui.Badge("neutral", "Preview")
			</div>
			<p class="ts-meta">{ description }</p>
		</div>
	</li>
}

func homeTitle(tab string) string {
	if tab == "connect" {
		return "Connect your AI or platform"
	}
	return "Overview"
}

