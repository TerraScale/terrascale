package engine

import (
	"fmt"
	"strconv"

	"terrascale.tech/dashboard/internal/ui"
	"terrascale.tech/dashboard/internal/ui/icons"
)

templ engineContent(d pageData) {
	<main class="ts-page">
		@ui.PageHeader(ui.Header{Eyebrow: "TerraBase", Title: "Engine", Description: "Live member health and the provider's available region catalog."}) {
			if d.Configured {
				<a class="ts-btn ts-btn-secondary" href="/engine">@icons.RefreshCw(16)
<span>Refresh</span></a>
			}
		}
		if !d.Configured {
			@ui.Card(ui.CardProps{ID: "engine-config", Title: "Engine provider unavailable", Description: "Connect the dashboard to the scoped ts-go provider before viewing live engine status."}) {
				@ui.Alert("warning", "", d.ConfigMessage)
			}
		} else {
			@ui.Card(ui.CardProps{ID: "engine-health", Title: "Member health", Description: "Readiness reported by the serving member."}) {
				if d.Health != nil {
					@ui.Stats("Member health") {
						@ui.Stat("Serving region", d.Health.Region, "")
						@ui.Stat("Version", d.Health.Version, "")
						@ui.Stat("Readiness", readiness(d.Health.Healthy), "")
					}
				} else {
					@ui.Alert("warning", "", d.HealthError)
				}
			}
			@ui.Card(ui.CardProps{ID: "engine-regions", Title: "Region catalog", Description: "Provider-advertised regions and member hosts.", Actions: catalogCount(d), Flush: true}) {
				if d.CatalogError != "" {
					<div class="ts-engine-inset">
						@ui.Alert("warning", "", d.CatalogError)
					</div>
				} else if len(d.Regions) > 0 {
					<div class="ts-table-wrap">
						<table class="ts-table">
							<thead><tr><th>Code</th><th>Name</th><th>Country</th><th class="ts-num">Coordinates</th><th>Availability</th></tr></thead>
							<tbody>
								for _, region := range d.Regions {
									<tr>
										<td><code>{ region.Code }</code></td>
										<td class="ts-strong">{ region.Name }</td>
										<td>
											<span class="ts-engine-country">
												if flag := flagURL(region.Country); flag != "" {
													<img class="ts-engine-flag" src={ flag } alt="" width="20" height="15" loading="lazy" decoding="async"/>
												}
												{ region.Country }
											</span>
										</td>
										<td class="ts-num ts-mono">{ fmt.Sprintf("%.2f, %.2f", region.Latitude, region.Longitude) }</td>
										<td>
											if region.Available {
												@ui.Badge("success", "Available")
											} else {
												@ui.Badge("neutral", "Unavailable")
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					if d.PageCount > 1 {
						<nav class="ts-pager" aria-label="Region catalog pages">
							<span>Page { strconv.Itoa(d.Page) } of { strconv.Itoa(d.PageCount) }</span>
							<div class="ts-row">
								if d.HasPrevious {
									<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ templ.SafeURL("/engine?page=" + strconv.Itoa(d.Previous)) } rel="prev">Previous</a>
								}
								if d.HasNext {
									<a class="ts-btn ts-btn-secondary ts-btn-sm" href={ templ.SafeURL("/engine?page=" + strconv.Itoa(d.Next)) } rel="next">Next</a>
								}
							</div>
						</nav>
					}
				} else {
					@ui.Empty("No available regions.", "The provider returned no available regions.")
				}
			}
		}
	</main>
}

templ catalogCount(d pageData) {
	if d.CatalogError == "" {
		@ui.Badge("neutral", strconv.Itoa(d.RegionCount)+" regions · "+strconv.Itoa(d.HostCount)+" hosts")
	}
}

func readiness(healthy bool) string {
	if healthy {
		return "Healthy"
	}
	return "Unhealthy"
}
