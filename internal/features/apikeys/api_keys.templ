package apikeys

import (
	"terrascale.tech/dashboard/internal/core"
	"terrascale.tech/dashboard/internal/ui"
	"terrascale.tech/dashboard/internal/ui/icons"
)

templ apiKeysContent(page core.Page, d pageData) {
	<main class="ts-page ts-apikeys-page" data-project-id={ d.ProjectID } data-organization-id={ page.Principal.OrganizationID }>
		@ui.PageHeader("API keys") {}
		// A create dialog reopened after invalid input shows its own error.
		if d.Error != "" && d.Create == "" {
			@ui.Alert("danger", "", d.Error)
		}
		if d.Revealed.Secret != "" {
			// The secret answers a POST: swap the address for the page's own, so
			// reloading or going back never issues or rotates a credential again.
			<section class="ts-alert ts-alert-success ts-apikeys-secret" role="status" data-list-url={ d.with("/api-keys") } data-init="history.replaceState(null, '', el.dataset.listUrl)">
				if d.Revealed.Rotated {
					<h2 class="ts-alert-title">New secret for { d.Revealed.Name }</h2>
					<p class="ts-alert-body">The previous secret has stopped working. Copy this one now and update every client that uses it. It is shown only once.</p>
				} else {
					<h2 class="ts-alert-title">Secret for { d.Revealed.Name }</h2>
					<p class="ts-alert-body">Copy it now: it is shown only once. If you lose it, rotate the credential to issue a new one.</p>
				}
				<div class="ts-row">
					<code class="ts-apikeys-secret-value">{ d.Revealed.Secret }</code>
					<button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-signals="{_copied: false}" data-on:click="navigator.clipboard.writeText(el.previousElementSibling.textContent).then(() => $_copied = true)">
						@icons.Copy(14)
						<span data-text="$_copied ? 'Copied' : 'Copy'">Copy</span>
					</button>
				</div>
			</section>
		}
		if d.CanManage {
			@createCredential(page, d, "key", "Create key", "New project key", "Project keys authenticate application requests to this project's databases.")
			@createCredential(page, d, "m2m", "Create client", "New machine credential", "Machine clients authenticate services that call TerraScale without a user.")
			if d.Kind == "" {
				@chooseCredential(d.listFilters)
			}
		}
		<div class="ts-toolbar">
			@ui.Tabs("Credential types", d.tabs())
		</div>
		@ui.Card(ui.CardProps{ID: "credentials", Title: "Credentials", Description: "Keys and machine clients in the selected project.", Actions: credentialActions(d), Flush: len(d.Keys) > 0, ShrinkActions: true}) {
			if len(d.Keys) > 0 {
				<div class="ts-table-wrap">
					<table class="ts-table">
						<thead>
							<tr>
								<th>Name</th>
								<th>Type</th>
								<th>Prefix</th>
								<th>Scopes</th>
								<th>Database</th>
								<th>Status</th>
								if d.CanManage {
									<th class="ts-table-actions">Actions</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, key := range d.Keys {
								@credentialRow(page, d.listFilters, d.CanManage, key)
							}
						</tbody>
					</table>
				</div>
			} else {
				@ui.Empty("No credentials match these filters.", "Change the filters or create a new credential.")
			}
		}
	</main>
}

templ credentialActions(d pageData) {
	@apiKeysFilters(d)
	if d.CanManage {
		@createCredentialAction(d.Kind)
	}
}

func createCredentialAction(kind string) templ.Component {
	tab := controlsFor(kind)
	return ui.DialogTrigger(ui.DialogTriggerProps{Dialog: tab.CreateDialog, Label: tab.CreateLabel, Icon: credentialIcon(kind), Variant: "primary"})
}

templ apiKeysFilters(d pageData) {
	{{ tab := controlsFor(d.Kind) }}
	<form class="ts-filters ts-apikeys-filters" method="get" action="/api-keys" role="search" aria-label={ "Filter " + tab.Label }>
		<input type="hidden" name="kind" value={ tab.Kind }/>
		<input class="ts-input ts-input-sm" type="search" name="q" value={ d.Search } placeholder={ tab.SearchLabel } aria-label={ tab.SearchLabel }/>
		<select class="ts-select ts-input-sm" name="status" aria-label="Status">
			<option value="">All statuses</option>
			for _, status := range tab.Statuses {
				<option value={ status.Value } selected?={ d.Status == status.Value }>{ status.Label }</option>
			}
		</select>
		if tab.DatabaseFilter {
			<select class="ts-select ts-input-sm" name="databaseId" aria-label="Database" title={ databaseFilterTitle(d) } data-on:change="el.title = el.selectedOptions[0].textContent">
				<option value="">All databases</option>
				for _, db := range d.Databases {
					<option value={ db.ID } selected?={ d.DatabaseID == db.ID }>{ db.Name }</option>
				}
			</select>
		}
		<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Filter</button>
		if d.Search != "" || d.Status != "" || d.DatabaseID != "" {
			<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ d.clearURL() }>Clear</a>
		}
	</form>
}

func databaseFilterTitle(d pageData) string {
	for _, db := range d.Databases {
		if db.ID == d.DatabaseID {
			return db.Name
		}
	}
	return "All databases"
}

templ chooseCredential(filters listFilters) {
	@ui.Dialog(ui.DialogProps{ID: "create-credential", Title: "Create credential", Description: "Choose the type of credential to create."}) {
		<div class="ts-row">
			<a class="ts-btn ts-btn-secondary" href={ filters.createURL("key") }>
				@credentialIcon("key")
				API key
			</a>
			<a class="ts-btn ts-btn-secondary" href={ filters.createURL("m2m") }>
				@credentialIcon("m2m")
				M2M client
			</a>
		</div>
	}
}

templ createCredential(page core.Page, d pageData, kind, action, title, description string) {
	@ui.Dialog(ui.DialogProps{ID: "create-" + kind, Title: title, Description: description, Open: d.Create == kind, Class: "ts-credential-dialog"}) {
		<form method="post" action={ d.with("/api/v1/dashboard/credentials/" + kind) } class="ts-form ts-credential-form" data-signals={ d.permissionSignals(kind) }>
			<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
			if d.Error != "" && d.Create == kind {
				@ui.Alert("danger", "", d.Error)
			}
			<div class="ts-form-grid">
				@ui.Field(ui.FieldProps{ID: kind + "-name", Label: "Credential name", Hint: "A name to recognize this credential later."}) {
					<input class="ts-input" id={ kind + "-name" } name="name" value={ d.draftFor(kind).Name } placeholder="e.g. production-api" maxlength="128" aria-describedby={ kind + "-name-hint" } required/>
				}
				@ui.Field(ui.FieldProps{ID: kind + "-database", Label: "Database access", Hint: "Limit access to the database this app needs."}) {
					<select class="ts-select" id={ kind + "-database" } name="databaseId" aria-describedby={ kind + "-database-hint" } data-on:change={ "$_" + kind + "Database = el.selectedOptions[0].textContent" }>
						<option value="">All project databases (current and future)</option>
						for _, db := range d.Databases {
							<option value={ db.ID } selected?={ d.draftFor(kind).DatabaseID == db.ID }>{ db.Name }</option>
						}
					</select>
				}
			</div>
			<fieldset class="ts-permissions" aria-describedby={ kind + "-permissions-hint" }>
				<legend class="ts-label">Database permissions</legend>
				<p class="ts-hint" id={ kind + "-permissions-hint" }>Choose the minimum access your application needs.</p>
				<div class="ts-permission-options">
					@permissionOption(kind, "read", "Read only", "Read and query records. Cannot change or delete data.", readAccess, d.accessFor(kind) == readAccess, true)
					@permissionOption(kind, "write", "Read and write", "Read, create, update, and delete records. Use for apps that change data.", readWriteAccess, d.accessFor(kind) == readWriteAccess, false)
				</div>
				<details class="ts-permission-advanced" open?={ d.accessFor(kind) == writeAccess }>
					<summary class="ts-meta ts-muted">More access options</summary>
					@permissionOption(kind, "write-only", "Write only", "Create, update, and delete records without reading them. For ingestion services.", writeAccess, d.accessFor(kind) == writeAccess, false)
				</details>
			</fieldset>
			<section class="ts-permission-review" aria-label="Authorization summary" aria-live="polite" aria-atomic="true">
				@icons.ShieldCheck(20)
				<div class="ts-field">
					<h3 class="ts-hint ts-muted">Access summary</h3>
					<p class="ts-strong" data-text={ "$_" + kind + "Database" }>{ d.databaseFor(kind) }</p>
					<p class="ts-hint" data-text={ permissionSummary(kind) }>
						if d.accessFor(kind) == readWriteAccess {
							Can read, create, update, and delete records.
						} else if d.accessFor(kind) == readAccess {
							Can read records. Cannot create, update, or delete them.
						} else if d.accessFor(kind) == writeAccess {
							Can create, update, and delete records. Cannot read or query them.
						} else {
							Choose an access level before creating this credential.
						}
					</p>
				</div>
			</section>
			@ui.DialogActions("create-" + kind) {
				<button class="ts-btn ts-btn-primary" type="submit">{ action }</button>
			}
		</form>
	}
}

templ permissionOption(kind, id, label, description, scopes string, selected, recommended bool) {
	<label class="ts-permission-option" for={ kind + "-access-" + id }>
		<input type="radio" id={ kind + "-access-" + id } name="scopes" value={ scopes } checked?={ selected } required data-bind={ "_" + kind + "Access" } aria-labelledby={ kind + "-access-" + id + "-label" } aria-describedby={ kind + "-access-" + id + "-description" }/>
		<span class="ts-field ts-permission-body">
			<span class="ts-row">
				if recommended {
					@icons.Eye(18)
				} else {
					@icons.Pencil(18)
				}
				<strong id={ kind + "-access-" + id + "-label" }>{ label }</strong>
			</span>
			if recommended {
				<span class="ts-hint">Recommended</span>
			}
			<span class="ts-meta ts-muted" id={ kind + "-access-" + id + "-description" }>{ description }</span>
			<span class="ts-row ts-apikeys-scopes">
				for _, scope := range formScopes(scopes) {
					<code>{ scope }</code>
				}
			</span>
		</span>
	</label>
}

func credentialIcon(kind string) templ.Component {
	if kind == "" {
		return icons.Plus(16)
	}
	if kind == "key" {
		return readWriteKey.Icon(16)
	}
	return machineClient.Icon(16)
}

templ credentialRow(page core.Page, filters listFilters, canManage bool, key keyView) {
	<tr>
		<td class="ts-strong">{ key.Name }</td>
		<td>
			<span class="ts-badge ts-badge-tone ts-apikeys-type" data-tone={ key.Type.Tone }>
				@key.Type.Icon(12)
				{ key.Type.Label }
			</span>
		</td>
		<td><code>{ key.Prefix }…{ key.LastFour }</code></td>
		<td>
			<div class="ts-row ts-apikeys-scopes">
				for _, scope := range key.Scopes {
					@ui.Badge("neutral", scope)
				}
			</div>
		</td>
		<td class="ts-meta">
			if key.DatabaseID != "" {
				{ key.DatabaseName }
			} else {
				All project databases
			}
		</td>
		<td>
			switch {
				case key.Active:
					@ui.Badge("success", "Active")
				case key.RevokedAt != "":
					@ui.Badge("neutral", "Revoked")
				default:
					@ui.Badge("warning", "Expired")
			}
		</td>
		if canManage {
			<td class="ts-table-actions">
				if key.Active {
					<div class="ts-row ts-row-end">
						@ui.DialogTrigger(ui.DialogTriggerProps{Dialog: "rotate-" + key.ID, Label: "Rotate", Small: true})
						@ui.DialogTrigger(ui.DialogTriggerProps{Dialog: "revoke-" + key.ID, Label: "Revoke", Variant: "danger", Small: true})
					</div>
					@credentialAction(page, filters, key, "rotate", "Rotate "+key.Name+"?", "A new secret is issued and the current one stops working immediately. Clients that use it fail until you update them.", "Rotate secret", "primary")
					@credentialAction(page, filters, key, "revoke", "Revoke "+key.Name+"?", "Revoking is permanent: requests that use this credential are rejected from now on. Create a new credential to restore access.", "Revoke credential", "danger")
				}
			</td>
		}
	</tr>
}

// credentialAction confirms a rotate or revoke in a dialog before posting it.
templ credentialAction(page core.Page, filters listFilters, key keyView, action, title, description, label, variant string) {
	@ui.Dialog(ui.DialogProps{ID: action + "-" + key.ID, Title: title, Description: description}) {
		<form method="post" action={ filters.with("/api/v1/dashboard/credentials/" + action) }>
			<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
			<input type="hidden" name="keyId" value={ key.ID }/>
			@ui.DialogActions(action + "-" + key.ID) {
				<button class={ "ts-btn", "ts-btn-" + variant } type="submit">{ label }</button>
			}
		</form>
	}
}
