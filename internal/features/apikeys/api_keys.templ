package apikeys

import (
	"cmp"

	"terrascale.tech/dashboard/internal/core"
	"terrascale.tech/dashboard/internal/ui"
	"terrascale.tech/dashboard/internal/ui/icons"
)

templ apiKeysContent(page core.Page, d pageData) {
	<main class="ts-page ts-apikeys-page" data-project-id={ d.ProjectID } data-organization-id={ page.Principal.OrganizationID }>
		@ui.PageHeader("API keys") {}
		// A create dialog reopened after invalid input shows its own error.
		if d.Error != "" && d.Create == "" {
			@ui.Alert("danger", "", d.Error)
		}
		if d.Revealed.Secret != "" {
			// The secret answers a POST: swap the address for the page's own, so
			// reloading or going back never issues or rotates a credential again.
			<section class="ts-alert ts-alert-success ts-apikeys-secret" role="status" data-list-url={ d.with("/api-keys") } data-init="history.replaceState(null, '', el.dataset.listUrl)">
				if d.Revealed.Rotated {
					<h2 class="ts-alert-title">New secret for { d.Revealed.Name }</h2>
					<p class="ts-alert-body">The previous secret has stopped working. Copy this one now and update every client that uses it. It is shown only once.</p>
				} else {
					<h2 class="ts-alert-title">Secret for { d.Revealed.Name }</h2>
					<p class="ts-alert-body">Copy it now: it is shown only once. If you lose it, rotate the credential to issue a new one.</p>
				}
				<div class="ts-row">
					<code class="ts-apikeys-secret-value">{ d.Revealed.Secret }</code>
					<button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-signals="{_copied: false}" data-on:click="navigator.clipboard.writeText(el.previousElementSibling.textContent).then(() => $_copied = true)">
						@icons.Copy(14)
						<span data-text="$_copied ? 'Copied' : 'Copy'">Copy</span>
					</button>
				</div>
			</section>
		}
		if d.CanManage {
			@createCredential(page, d, "key", "Create key", "New project key", "Project keys authenticate application requests to this project's databases.", "database:read,database:write")
			@createCredential(page, d, "m2m", "Create machine credential", "New machine credential", "Machine clients authenticate services that call TerraScale without a user.", "database:read")
		}
		<div class="ts-toolbar">
			@ui.Tabs("Credential types", []ui.Tab{
				{Label: "All credentials", URL: "/api-keys", Active: d.Kind == ""},
				{Label: "API keys", URL: "/api-keys?kind=key", Active: d.Kind == "key"},
				{Label: "M2M clients", URL: "/api-keys?kind=m2m", Active: d.Kind == "m2m"},
			})
			<form class="ts-filters ts-apikeys-filters" method="get" action="/api-keys" role="search" aria-label="Filter credentials">
				<input type="hidden" name="kind" value={ d.Kind }/>
				<input class="ts-input ts-input-sm" type="search" name="q" value={ d.Search } placeholder="Search credentials" aria-label="Search credentials"/>
				<select class="ts-select ts-input-sm" name="status" aria-label="Status">
					<option value="">All statuses</option>
					<option value="active" selected?={ d.Status == "active" }>Active</option>
					<option value="inactive" selected?={ d.Status == "inactive" }>Inactive</option>
				</select>
				<select class="ts-select ts-input-sm" name="databaseId" aria-label="Database">
					<option value="">All databases</option>
					for _, db := range d.Databases {
						<option value={ db.ID } selected?={ d.DatabaseID == db.ID }>{ db.Name }</option>
					}
				</select>
				<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Filter</button>
				if d.Search != "" || d.Status != "" || d.DatabaseID != "" {
					<a class="ts-btn ts-btn-ghost ts-btn-sm" href="/api-keys">Clear</a>
				}
			</form>
		</div>
		@ui.Card(ui.CardProps{ID: "credentials", Title: "Credentials", Description: "Keys and machine clients in the selected project.", Actions: createKeyAction(d.CanManage), Flush: len(d.Keys) > 0}) {
			if len(d.Keys) > 0 {
				<div class="ts-table-wrap">
					<table class="ts-table">
						<thead>
							<tr>
								<th>Name</th>
								<th>Type</th>
								<th>Prefix</th>
								<th>Scopes</th>
								<th>Database</th>
								<th>Status</th>
								if d.CanManage {
									<th class="ts-table-actions">Actions</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, key := range d.Keys {
								@credentialRow(page, d.listFilters, d.CanManage, key)
							}
						</tbody>
					</table>
				</div>
			} else {
				@ui.Empty("No credentials match these filters.", "Change the filters or create a new credential.")
			}
		}
	</main>
}

func createKeyAction(canManage bool) templ.Component {
	if !canManage {
		return nil
	}
	return ui.DialogTrigger(ui.DialogTriggerProps{Dialog: "create-key", Label: "Create key", Icon: credentialIcon("key"), Variant: "primary"})
}

templ createCredential(page core.Page, d pageData, kind, action, title, description, scopes string) {
	@ui.Dialog(ui.DialogProps{ID: "create-" + kind, Title: title, Description: description, Open: d.Create == kind}) {
		<form method="post" action={ d.with("/api/v1/dashboard/credentials/" + kind) } class="ts-form">
			<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
			if d.Error != "" && d.Create == kind {
				@ui.Alert("danger", "", d.Error)
			}
			@ui.Field(ui.FieldProps{ID: kind + "-name", Label: "Name"}) {
				<input class="ts-input" id={ kind + "-name" } name="name" value={ d.draftFor(kind).Name } maxlength="128" required/>
			}
			@ui.Field(ui.FieldProps{ID: kind + "-scopes", Label: "Scopes", Hint: "Comma-separated, for example database:read,database:write."}) {
				<input class="ts-input" id={ kind + "-scopes" } name="scopes" value={ cmp.Or(d.draftFor(kind).Scopes, scopes) } required/>
			}
			@ui.Field(ui.FieldProps{ID: kind + "-database", Label: "Database"}) {
				<select class="ts-select" id={ kind + "-database" } name="databaseId">
					<option value="">All project databases</option>
					for _, db := range d.Databases {
						<option value={ db.ID } selected?={ d.draftFor(kind).DatabaseID == db.ID }>{ db.Name }</option>
					}
				</select>
			}
			@ui.DialogActions("create-" + kind) {
				<button class="ts-btn ts-btn-primary" type="submit">{ action }</button>
			}
		</form>
	}
}

func credentialIcon(kind string) templ.Component {
	if kind == "key" {
		return readWriteKey.Icon(16)
	}
	return machineClient.Icon(16)
}

templ credentialRow(page core.Page, filters listFilters, canManage bool, key keyView) {
	<tr>
		<td class="ts-strong">{ key.Name }</td>
		<td>
			<span class="ts-badge ts-badge-tone ts-apikeys-type" data-tone={ key.Type.Tone }>
				@key.Type.Icon(12)
				{ key.Type.Label }
			</span>
		</td>
		<td><code>{ key.Prefix }…{ key.LastFour }</code></td>
		<td>
			<div class="ts-row ts-apikeys-scopes">
				for _, scope := range key.Scopes {
					@ui.Badge("neutral", scope)
				}
			</div>
		</td>
		<td class="ts-meta">
			if key.DatabaseID != "" {
				{ key.DatabaseName }
			} else {
				All project databases
			}
		</td>
		<td>
			switch {
				case key.Active:
					@ui.Badge("success", "Active")
				case key.RevokedAt != "":
					@ui.Badge("neutral", "Revoked")
				default:
					@ui.Badge("warning", "Expired")
			}
		</td>
		if canManage {
			<td class="ts-table-actions">
				if key.Active {
					<div class="ts-row ts-row-end">
						@ui.DialogTrigger(ui.DialogTriggerProps{Dialog: "rotate-" + key.ID, Label: "Rotate", Small: true})
						@ui.DialogTrigger(ui.DialogTriggerProps{Dialog: "revoke-" + key.ID, Label: "Revoke", Variant: "danger", Small: true})
					</div>
					@credentialAction(page, filters, key, "rotate", "Rotate "+key.Name+"?", "A new secret is issued and the current one stops working immediately. Clients that use it fail until you update them.", "Rotate secret", "primary")
					@credentialAction(page, filters, key, "revoke", "Revoke "+key.Name+"?", "Revoking is permanent: requests that use this credential are rejected from now on. Create a new credential to restore access.", "Revoke credential", "danger")
				}
			</td>
		}
	</tr>
}

// credentialAction confirms a rotate or revoke in a dialog before posting it.
templ credentialAction(page core.Page, filters listFilters, key keyView, action, title, description, label, variant string) {
	@ui.Dialog(ui.DialogProps{ID: action + "-" + key.ID, Title: title, Description: description}) {
		<form method="post" action={ filters.with("/api/v1/dashboard/credentials/" + action) }>
			<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
			<input type="hidden" name="keyId" value={ key.ID }/>
			@ui.DialogActions(action + "-" + key.ID) {
				<button class={ "ts-btn", "ts-btn-" + variant } type="submit">{ label }</button>
			}
		</form>
	}
}
