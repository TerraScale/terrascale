package apikeys

import (
	"strconv"
	"terrascale.tech/dashboard/internal/core"
)

templ apiKeysContent(page core.Page, d pageData) {
	<main class="ts-page" data-project-id={ d.ProjectID } data-organization-id={ page.Principal.OrganizationID }>
		<header class="ts-section"><h1>API keys</h1><p>Manage project credentials and their database scope.</p></header>
		<div class="ts-toolbar">
			<nav class="ts-tabs" aria-label="Credential types"><a class="ts-tab" href="/api-keys" aria-current={ currentCredentialTab(d.Kind == "") }>All credentials</a><a class="ts-tab" href="/api-keys?kind=key" aria-current={ currentCredentialTab(d.Kind == "key") }>API keys</a><a class="ts-tab" href="/api-keys?kind=m2m" aria-current={ currentCredentialTab(d.Kind == "m2m") }>M2M clients</a></nav>
			<form class="ts-filters" method="get" action="/api-keys" role="search" aria-label="Filter credentials">
				<input type="hidden" name="kind" value={ d.Kind }/><input class="ts-input" type="search" name="q" value={ d.Search } placeholder="Search credentials" aria-label="Search credentials"/><select class="ts-select" name="status" aria-label="Status"><option value="">All statuses</option><option value="active" selected?={ d.Status == "active" }>Active</option><option value="inactive" selected?={ d.Status == "inactive" }>Inactive</option></select>
				<select class="ts-select" name="databaseId" aria-label="Database">
					<option value="">All databases</option>
					for _, db := range d.Databases {
						<option value={ db.ID } selected?={ d.DatabaseID == db.ID }>{ db.Name }</option>
					}
				</select><button class="ts-btn ts-btn-secondary" type="submit">Filter</button>
				if d.Search != "" || d.Status != "" || d.DatabaseID != "" {
					<a class="ts-btn ts-btn-ghost" href="/api-keys">Clear</a>
				}
			</form>
		</div>
		if d.Error != "" {
			<p class="ts-alert ts-alert-danger" role="alert">{ d.Error }</p>
		}
		if d.CreatedSecret != "" {
			<section class="ts-card ts-section" role="status"><h2>Copy this secret now</h2><p>It is shown only in this response.</p><code>{ d.CreatedSecret }</code></section>
		}
		if d.CanManage {
			<details class="ts-card ts-section" open?={ d.Create == "key" }>
				<summary class="ts-btn ts-btn-primary">Create key</summary>
				<h2>New project key</h2>
				<form method="post" action="/api/v1/dashboard/credentials/key" class="ts-stack-12">
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/><label class="ts-label" for="key-name">Name</label><input class="ts-input" id="key-name" name="name" required/>
					<label class="ts-label" for="key-scopes">Scopes</label><input class="ts-input" id="key-scopes" name="scopes" value="database:read,database:write" required/>
					<label class="ts-label" for="key-database">Database</label>
					<select class="ts-input" id="key-database" name="databaseId">
						<option value="">All project databases</option>
						for _, db := range d.Databases {
							<option value={ db.ID }>{ db.Name }</option>
						}
					</select><button class="ts-btn ts-btn-primary" type="submit">Create key</button>
				</form>
			</details>
			<details class="ts-card ts-section" open?={ d.Create == "m2m" }>
				<summary class="ts-btn ts-btn-secondary">Create machine credential</summary>
				<h2>New machine credential</h2>
				<form method="post" action="/api/v1/dashboard/credentials/m2m" class="ts-stack-12">
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/><label class="ts-label" for="m2m-name">Name</label><input class="ts-input" id="m2m-name" name="name" required/>
					<label class="ts-label" for="m2m-scopes">Scopes</label><input class="ts-input" id="m2m-scopes" name="scopes" value="database:read" required/>
					<label class="ts-label" for="m2m-database">Database</label>
					<select class="ts-input" id="m2m-database" name="databaseId">
						<option value="">All project databases</option>
						for _, db := range d.Databases {
							<option value={ db.ID }>{ db.Name }</option>
						}
					</select><button class="ts-btn ts-btn-primary" type="submit">Create machine credential</button>
				</form>
			</details>
		}
		<section class="ts-section">
			<h2>Credentials</h2>
			<dl class="ts-kpis" aria-label="Credential counts"><div><dt>Active keys</dt><dd><span class="ts-kpi-value">{ strconv.Itoa(d.ActiveKeys) }</span></dd><small class="ts-meta">Available for project access</small></div><div><dt>Expiring keys</dt><dd><span class="ts-kpi-value">{ strconv.Itoa(d.ExpiringKeys) }</span></dd><small class="ts-meta">Dated keys expiring within 14 days</small></div><div><dt>M2M clients</dt><dd><span class="ts-kpi-value">{ strconv.Itoa(d.M2MClients) }</span></dd><small class="ts-meta">Active machine credentials</small></div></dl>
			if len(d.Keys) > 0 {
				<div class="ts-table-wrap">
					<table class="ts-table">
						<thead>
							<tr>
								<th>Name</th>
								<th>Type</th>
								<th>Prefix</th>
								<th>Scopes</th>
								<th>Database</th>
								<th>Status</th>
								if d.CanManage {
									<th>Actions</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, key := range d.Keys {
								<tr>
									<td>{ key.Name }</td>
									<td>{ key.Kind }</td>
									<td><code>{ key.Prefix }…{ key.LastFour }</code></td>
									<td>
										for _, scope := range key.Scopes {
											{ scope }
										}
									</td>
									<td>
										if key.DatabaseID != "" {
											{ key.DatabaseID }
										} else {
											All project databases
										}
									</td>
									<td>
										if key.Active {
											Active
										} else {
											Revoked or expired
										}
									</td>
									if d.CanManage {
										<td>
											if key.Active {
												<form method="post" action="/api/v1/dashboard/credentials/rotate"><input type="hidden" name="_csrf" value={ page.CSRFToken }/><input type="hidden" name="keyId" value={ key.ID }/><button class="ts-btn ts-btn-secondary" type="submit">Rotate</button></form>
												<form method="post" action="/api/v1/dashboard/credentials/revoke"><input type="hidden" name="_csrf" value={ page.CSRFToken }/><input type="hidden" name="keyId" value={ key.ID }/><button class="ts-btn ts-btn-secondary" type="submit">Revoke</button></form>
											}
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			} else {
				<p>No credentials match these filters.</p>
			}
		</section>
	</main>
}

func currentCredentialTab(active bool) string {
	if active {
		return "page"
	}
	return ""
}
