package usage

import (
	"fmt"
	"net/url"
	"strings"

	"terrascale.tech/dashboard/internal/core"
	"terrascale.tech/dashboard/internal/ui"
	"terrascale.tech/dashboard/internal/ui/aria"
	"terrascale.tech/dashboard/internal/ui/charts"
	"terrascale.tech/dashboard/internal/ui/icons"
)

templ usageView(data pageData, csrfToken string) {
	<main class="ts-page ts-usage">
		@ui.PageHeader("Usage")
		<div class="ts-toolbar">
			@ui.Tabs("Usage sections", []ui.Tab{
				{Label: "Overview", URL: usageTabHref("overview", data.SelectedProject), Active: data.Tab == "overview"},
				{Label: "Spending controls", URL: usageTabHref("settings", data.SelectedProject), Active: data.Tab == "settings"},
			})
			if data.Tab == "overview" {
				@overviewFilters(data)
			} else if data.Tab == "billing" {
				@invoiceFilters(data)
			}
		</div>
		if data.Saved == "ok" {
			<div class="ts-spending-notice" data-signals="{spendingSaved: true}" data-attr:hidden="!$spendingSaved">
				@ui.Alert("success", "Changes saved", "Spending controls saved.") {
					<button class="ts-icon-btn" type="button" aria-label="Dismiss save confirmation" data-on:click="$spendingSaved = false">@icons.X(16)</button>
				}
			</div>
		}
		if data.Saved == "invalid" {
			@ui.Alert("danger", "", "Enter a non-negative dollar amount with at most two decimal places, and whole numbers for operation limits.")
		}
		if data.BillingNotice != "" {
			@ui.Alert("info", "", data.BillingNotice)
		}
		switch data.Tab {
			case "overview":
				@overviewTab(data)
			case "billing":
				@billingTab(data, csrfToken)
			default:
				@spendingControlsTab(data, csrfToken)
		}
	</main>
}

templ overviewFilters(data pageData) {
	<form class="ts-filters" method="get" action="/usage" role="search" aria-label="Filter usage">
		<input type="hidden" name="tab" value="overview"/>
		<label class="ts-filter-inline" for="usage-project">
			<span class="ts-filter-inline-label">Project</span>
			<select class="ts-select" id="usage-project" name="project">
				for _, project := range data.Projects {
					<option value={ project.ID } selected?={ project.ID == data.SelectedProject }>{ project.Name }</option>
				}
			</select>
		</label>
		<label class="ts-filter-inline" for="usage-database">
			<span class="ts-filter-inline-label">Database</span>
			<select class="ts-select" id="usage-database" name="database">
				<option value="">All databases</option>
				for _, database := range data.DatabaseOptions {
					<option value={ database.ID } selected?={ database.ID == data.SelectedDatabase }>{ database.Name }</option>
				}
			</select>
		</label>
		<label class="ts-filter-inline" for="usage-range">
			<span class="ts-filter-inline-label">Period</span>
			<select class="ts-select" id="usage-range" name="range">
				<option value="24h" selected?={ data.HistoryRange == "24h" }>Last 24 hours</option>
				<option value="7d" selected?={ data.HistoryRange == "7d" }>Last 7 days</option>
				<option value="30d" selected?={ data.HistoryRange == "30d" }>Last 30 days</option>
			</select>
		</label>
		<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Apply</button>
	</form>
}

templ invoiceFilters(data pageData) {
	<form class="ts-filters" method="get" action="/organization" role="search" aria-label="Filter payment history">
		<input type="hidden" name="tab" value="billing"/>
		<input type="hidden" name="project" value={ data.SelectedProject }/>
		<label class="ts-filter-inline" for="invoice-status">
			<span class="ts-filter-inline-label">Invoice status</span>
			<select class="ts-select" id="invoice-status" name="status">
				<option value="" selected?={ data.InvoicePage.Status == "" }>All statuses</option>
				for _, option := range data.InvoicePage.StatusOptions {
					<option value={ option.Value } selected?={ data.InvoicePage.Status == option.Value }>{ option.Label }</option>
				}
			</select>
		</label>
		<label class="ts-filter-inline" for="invoice-issued">
			<span class="ts-filter-inline-label">Issued</span>
			<select class="ts-select" id="invoice-issued" name="issued">
				<option value="" selected?={ data.InvoicePage.Issued == "" }>Any time</option>
				for _, option := range data.InvoicePage.IssuedOptions {
					<option value={ option.Value } selected?={ data.InvoicePage.Issued == option.Value }>{ option.Label }</option>
				}
			</select>
		</label>
		<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Apply</button>
		if data.InvoicePage.Status != "" || data.InvoicePage.Issued != "" {
			<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ billingTabHref(data.SelectedProject) }>Clear</a>
		}
	</form>
}

templ overviewTab(data pageData) {
	if data.InternalBill != nil {
		@internalBillCard(data.InternalBill)
	}
	@ui.Card(ui.CardProps{ID: "usage-allowance", Title: "Plan allowance", Description: "Use of the " + data.PlanName + " plan this month"}) {
		if data.AllowanceError != "" {
			@ui.Alert("warning", "", data.AllowanceError)
		}
		<div class="ts-usage-gauges">
			for _, gauge := range data.Allowances {
				<div class="ts-usage-gauge">
					if gauge.HasRing {
						<div class="ts-usage-ring">
							@charts.Ring(gauge.Ring)
							<span class="ts-usage-ring-value"><strong>{ fmt.Sprint(gauge.Percent) }%</strong><small>used</small></span>
						</div>
					}
					<div class="ts-stack-sm">
						<span class="ts-stat-label">{ gauge.Name }</span>
						<span class="ts-usage-gauge-value">{ gauge.Used }</span>
						<span class="ts-meta">{ gauge.Note }</span>
					</div>
				</div>
			}
		</div>
		<p class="ts-meta">{ data.PlanUsageNote }</p>
		if len(data.SampleGauges) > 0 {
			<div class="ts-card-section">
				<p class="ts-meta"><strong class="ts-strong">Illustrative demo capacity</strong> · The figures below are seeded samples, not your plan allowance or measured provider usage.</p>
				<div class="ts-usage-sample-gauges">
					for _, gauge := range data.SampleGauges {
						<div class="ts-usage-gauge">
							<div class="ts-usage-ring">
								@charts.Ring(gauge.Ring)
								<span class="ts-usage-ring-value"><strong>{ fmt.Sprint(gauge.Percent) }%</strong><small>sample</small></span>
							</div>
							<div class="ts-stack-sm">
								<span class="ts-stat-label">{ gauge.Name }</span>
								<span class="ts-usage-gauge-value">{ gauge.Used } <small>/ { gauge.Capacity }</small></span>
								<span class="ts-meta">Illustrative demo capacity</span>
							</div>
						</div>
					}
				</div>
			</div>
		}
	}
	<div class="ts-split">
		@ui.Card(ui.CardProps{ID: "usage-history", Title: "Reads and writes", Description: historyDescription(data), Actions: historyTotals(data)}) {
			if data.UsageAvailable || data.SampleHistory {
				<div class="ts-chart-shell ts-usage-chart-shell" role="region" aria-label="Reads and writes chart. Scroll horizontally for the full plot." tabindex="0">
					@charts.Line(data.HistoryChart)
				</div>
				if data.SampleHistory {
					<p class="ts-meta">Reads, writes, and replication are deterministic demo series. They are separate from saved document counts and billing facts.</p>
				}
			} else {
				@ui.Empty("Reads and writes are not metered here.", data.UsageSource)
			}
		}
		@ui.Card(ui.CardProps{ID: "usage-by-project", Title: shareTitle(data), Description: shareDescription(data)}) {
			if (data.ExplicitProjectFilter && !data.StorageMeasured) || (!data.ExplicitProjectFilter && !data.OrganizationStorageMeasured) {
				@ui.Empty("Storage isn't measured here.", data.UsageSource)
			} else if data.ExplicitProjectFilter && len(data.Databases) > 0 {
				<ul class="ts-usage-share">
					for _, database := range data.Databases {
						<li>
							<div class="ts-row-between"><span class="ts-strong">{ database.Name }</span><span class="ts-mono">{ database.LogicalSize }</span></div>
							@charts.Bar(charts.NewBar(database.Name, database.SharePercent, "logical storage in this scope"))
							<span class="ts-meta">{ fmt.Sprint(database.Documents) } documents</span>
						</li>
					}
				</ul>
			} else if data.ExplicitProjectFilter {
				@ui.Empty("No databases match this project filter.", "")
			} else if len(data.Projects) > 0 {
				<ul class="ts-usage-share">
					for _, project := range data.Projects {
						<li>
							<div class="ts-row-between">
								<a class="ts-strong" href={ usageTabHref("overview", project.ID) } aria-current={ aria.CurrentPage(project.Selected) }>{ project.Name }</a>
								<span class="ts-mono">{ project.LogicalSize }</span>
							</div>
							@charts.Bar(charts.NewBar(project.Name, project.SharePercent, "logical storage in this organization"))
							<span class="ts-meta">{ fmt.Sprint(project.DatabaseCount) } databases · Region: { project.Region } · Effective spending cap: { project.Effective }</span>
						</li>
					}
				</ul>
			} else {
				@ui.Empty("No projects are saved in this organization.", "")
			}
		}
	</div>
	@ui.Card(ui.CardProps{ID: "usage-summary", Title: "Project usage summary", Description: data.UsageSource}) {
		if data.UsageError != "" {
			@ui.Alert("warning", "", data.UsageError)
		}
		@ui.Stats("Project usage summary") {
			@ui.Stat("Databases in project", fmt.Sprint(data.ActiveDatabases), "")
			@ui.Stat("Regions in project", fmt.Sprint(data.RegionCount), "")
			if data.UsageAvailable {
				@ui.Stat("Reads", formatCount(data.Reads), data.HistoryRangeLabel)
				@ui.Stat("Writes", formatCount(data.Writes), data.HistoryRangeLabel)
			}
			if data.StorageMeasured {
				@ui.Stat("Logical storage", data.LogicalSize, "Live document bytes")
			}
		}
	}
	@ui.Card(ui.CardProps{ID: "database-usage", Title: "Project databases", Description: "Reads and writes " + lowerFirst(data.HistoryRangeLabel) + ", storage, and spending limits", Flush: true}) {
		if len(data.Databases) > 0 {
			<div class="ts-table-wrap" tabindex="0" role="region" aria-label="Project databases table. Scroll horizontally to see all columns.">
				<table class="ts-table">
					<caption class="ts-sr-only">Databases in the selected project with their reads, writes, storage, and spending limits</caption>
					<thead><tr><th scope="col">Database</th><th scope="col">Region</th><th scope="col">Status</th><th scope="col" class="ts-num">Reads</th><th scope="col" class="ts-num">Writes</th><th scope="col" class="ts-num">Documents</th><th scope="col" class="ts-num">Logical storage</th><th scope="col">Spend cap</th><th scope="col">Effective limit</th></tr></thead>
					<tbody>
						for _, database := range data.Databases {
							<tr>
								<td class="ts-table-strong">{ database.Name }</td>
								<td>{ database.Region }</td>
								<td>
									@ui.Badge(statusTone(database.Status), database.Status)
								</td>
								if database.Metered {
									<td class="ts-num">{ formatCount(database.Reads) }</td>
									<td class="ts-num">{ formatCount(database.Writes) }</td>
								} else {
									<td class="ts-num ts-meta">Not metered</td>
									<td class="ts-num ts-meta">Not metered</td>
								}
								if data.StorageMeasured {
									<td class="ts-num">{ fmt.Sprint(database.Documents) }</td>
									<td class="ts-num">{ database.LogicalSize }</td>
								} else {
									<td class="ts-num ts-meta">Not measured</td>
									<td class="ts-num ts-meta">Not measured</td>
								}
								<td>
									if database.SpendCap != "" {
										${ database.SpendCap }
									} else {
										<span class="ts-meta">No database cap</span>
									}
								</td>
								<td>{ database.Effective }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			@ui.Empty("No databases match this project filter.", "")
		}
	}
}

templ historyTotals(data pageData) {
	if len(data.HistoryTotals) > 0 {
		<dl class="ts-usage-figures" aria-label="Totals for this range">
			for _, total := range data.HistoryTotals {
				<div><dt><span class={ "ts-chart-swatch " + total.Class }></span>{ total.Name }</dt><dd>{ fmt.Sprint(total.Value) }</dd></div>
			}
		</dl>
	}
}

templ billingTab(data pageData, csrfToken string) {
	if data.InternalBill != nil {
		@internalBillCard(data.InternalBill)
	}
	@ui.Card(ui.CardProps{ID: "billing-invoice-summary", Title: "Invoice summary", Description: "Invoice information reported for this organization", Actions: billingSummaryActions(data)}) {
		<dl class="ts-stats ts-usage-billing-kpis ts-stats-compact">
			<div class="ts-stat">
				<dt class="ts-stat-label">Plan</dt>
				<dd class="ts-stat-value">{ data.PlanName }</dd>
				<dd class="ts-stat-detail">
					Billing status:
					if data.BillingStatus != "" {
						{ data.BillingStatus }
					} else {
						Not reported
					}
					· { fmt.Sprint(data.InvoiceCount) } recorded invoices
					if !data.BillingRenewal.IsZero() {
						· Renews { data.BillingRenewal.UTC().Format("Jan 2, 2006") }
					}
					if data.BillingPrice != "" {
						· { data.BillingPrice } / { data.BillingInterval }
					}
				</dd>
			</div>
			@ui.Stat("Next recorded invoice", data.BillingSummary.NextInvoice, data.BillingSummary.NextDetail)
			<div class="ts-stat">
				<dt class="ts-stat-label">Billing period</dt>
				<dd class="ts-stat-value">{ data.BillingSummary.Period }</dd>
				if data.BillingSummary.HasPeriod {
					<dd>
						@charts.Bar(charts.NewBar("Billing period elapsed", data.BillingSummary.PeriodPercent, "the recorded billing period"))
					</dd>
				}
				<dd class="ts-stat-detail">{ data.BillingSummary.PeriodDetail }</dd>
			</div>
			@ui.Stat("Outstanding balance", data.BillingSummary.Outstanding, data.BillingSummary.OutstandingDetail)
			@ui.Stat("Current spending limit", data.EffectiveCap, "Configured for the selected project and database scope")
		</dl>
		if !data.OrganizationBilling && data.PendingPlan != "" {
			<div class="ts-card-section">@ui.Alert("warning", "Awaiting payment", "Stripe is confirming the change to "+data.PendingPlan+". Your current plan stays active until confirmation.")</div>
		}
		if !data.OrganizationBilling && data.ScheduledPlan != "" {
			<div class="ts-card-section ts-stack-sm">
				@ui.Alert("info", "Change scheduled", "Your plan will change to "+data.ScheduledPlan+" "+whenScheduled(data.ScheduledAt)+".")
				if data.CanManageBilling {
					<form method="post" action="/billing/change/undo">
						<input type="hidden" name="_csrf" value={ csrfToken }/>
						<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Undo scheduled change</button>
					</form>
				}
			</div>
		}
	}
	if data.CanManageBilling {
		@billingPlanDialog(data)
		if data.Review.Open {
			@billingReviewDialog(data, csrfToken)
		}
	}
	@ui.Card(ui.CardProps{ID: "recent-invoices", Title: "Payment history", Description: "Invoices recorded for this organization, newest first", Flush: true}) {
		if data.InvoicePage.Total > 0 {
			<div class="ts-table-wrap" tabindex="0" role="region" aria-label="Recent invoices table. Scroll horizontally to see all columns.">
				<table class="ts-table">
					<caption class="ts-sr-only">Invoices for this organization matching the current filters</caption>
					<thead><tr><th scope="col">Invoice</th><th scope="col">Issued</th><th scope="col">Period</th><th scope="col" class="ts-num">Amount</th><th scope="col">Status</th><th scope="col" class="ts-table-actions">Actions</th></tr></thead>
					<tbody>
						for _, invoice := range data.InvoicePage.Rows {
							<tr>
								<td class="ts-table-strong ts-mono">{ invoice.Number }</td>
								<td>
									if !invoice.CreatedAt.IsZero() {
										<time datetime={ invoice.CreatedAt.UTC().Format("2006-01-02") }>{ invoiceDate(invoice.CreatedAt) }</time>
									} else {
										-
									}
								</td>
								<td class="ts-meta">{ invoiceDate(invoice.PeriodStart) } – { invoiceDate(invoice.PeriodEnd) }</td>
								<td class="ts-num">{ invoice.Amount }</td>
								<td>
									@ui.Badge(invoiceTone(invoice.Status), invoice.Status)
								</td>
								<td class="ts-table-actions">
									if invoice.HostedURL != "" {
										<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ invoice.HostedURL } target="_blank" rel="noopener noreferrer">Open</a>
									}
									if invoice.PDFURL != "" {
										<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ invoice.PDFURL } target="_blank" rel="noopener noreferrer">PDF</a>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<nav class="ts-pager" aria-label="Payment history pages">
				<span>Showing { fmt.Sprint(data.InvoicePage.First) }–{ fmt.Sprint(data.InvoicePage.First + len(data.InvoicePage.Rows) - 1) } of { fmt.Sprint(data.InvoicePage.Total) }</span>
				if data.InvoicePage.PageCount > 1 {
					<div class="ts-row">
						if data.InvoicePage.Page > 1 {
							<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ data.InvoicePage.Href(data.SelectedProject, data.InvoicePage.Page-1) } rel="prev">Previous</a>
						}
						for pageNumber := 1; pageNumber <= data.InvoicePage.PageCount; pageNumber++ {
							<a class="ts-btn ts-btn-ghost ts-btn-sm ts-usage-page" href={ data.InvoicePage.Href(data.SelectedProject, pageNumber) } aria-current={ aria.CurrentPage(pageNumber == data.InvoicePage.Page) }>{ fmt.Sprint(pageNumber) }</a>
						}
						if data.InvoicePage.Page < data.InvoicePage.PageCount {
							<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ data.InvoicePage.Href(data.SelectedProject, data.InvoicePage.Page+1) } rel="next">Next</a>
						}
					</div>
				}
			</nav>
		} else {
			@ui.Empty("No invoices match these filters", "Change the status or issued date, or clear the filters.")
		}
	}
}

templ billingActions(data pageData) {
	if data.InternalBill != nil {
		<p class="ts-meta">Internal billing reports usage without Stripe charges.</p>
	} else if data.CanManageBilling {
		<button class="ts-btn ts-btn-primary" type="button" command="show-modal" commandfor="change-billing-plan">
			if data.BillingSubscription {
				Change plan
			} else {
				Choose plan
			}
		</button>
		if data.BillingSubscription {
			<a class="ts-btn ts-btn-secondary" href="/billing/portal">Manage payment</a>
		}
	} else {
		<p class="ts-meta">Only the organization owner can manage billing.</p>
	}
}

templ billingPlanDialog(data pageData) {
	{{ interval := "monthly"
if data.BillingInterval == "annual" {
	interval = "annual"
} }}
	<dialog id="change-billing-plan" class="ts-dialog" aria-labelledby="change-billing-plan-title">
		<div class="ts-dialog-content ts-stack">
			<div class="ts-billing-dialog-head">
				<div class="ts-dialog-header"><h2 class="ts-dialog-title" id="change-billing-plan-title">Choose a plan</h2><p class="ts-dialog-description">Select a plan and billing interval, then review the change.</p></div>
				<button class="ts-icon-btn" type="button" aria-label="Close plan selection" command="close" commandfor="change-billing-plan">@icons.X(18)</button>
			</div>
			<form method="get" action="/organization" class="ts-form" data-signals={ fmt.Sprintf("{_billingPlanInterval: %q}", interval) }>
				<input type="hidden" name="tab" value="billing"/>
				<input type="hidden" name="review" value="1"/>
				<fieldset class="ts-stack-sm">
					<legend class="ts-section-title">Plan</legend>
					for _, plan := range data.BillingPlans {
						<label class="ts-check">
							<input type="radio" name="plan" value={ plan.Key } required checked?={ plan.Key == data.BillingPlanKey }/>
							<span>
								<strong>{ plan.Name }</strong> · <span hidden?={ interval == "annual" } data-attr:hidden="$_billingPlanInterval === 'annual'">{ plan.MonthlyPrice } / month</span><span hidden?={ interval != "annual" } data-attr:hidden="$_billingPlanInterval !== 'annual'">{ plan.AnnualPrice } / year</span>
								<br/>
								<small>{ plan.Databases } · { plan.Storage } · { plan.Reads } · { plan.Writes } · { plan.Members }</small>
							</span>
						</label>
					}
					if data.Personal && data.BillingSubscription {
						<label class="ts-check"><input type="radio" name="plan" value="free"/><span><strong>Free</strong> · at renewal</span></label>
					}
				</fieldset>
				<fieldset class="ts-segmented">
					<legend class="ts-sr-only">Billing interval</legend>
					<label><input type="radio" name="interval" value="monthly" checked?={ interval == "monthly" } data-bind="_billingPlanInterval"/><span>Monthly</span></label>
					<label><input type="radio" name="interval" value="annual" checked?={ interval == "annual" } data-bind="_billingPlanInterval"/><span>Annual</span></label>
				</fieldset>
				<div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Review change</button></div>
			</form>
		</div>
	</dialog>
}

templ billingReviewDialog(data pageData, csrfToken string) {
	<dialog id="review-billing-plan" class="ts-dialog" data-init="el.showModal()" aria-labelledby="review-billing-plan-title">
		<div class="ts-dialog-content ts-stack">
			<div class="ts-billing-dialog-head">
				<div class="ts-dialog-header">
					<h2 class="ts-dialog-title" id="review-billing-plan-title">Review plan change</h2>
					<p class="ts-dialog-description">
						if data.Demo {
							Demo billing doesn’t contact Stripe or charge a card.
						} else {
							Stripe confirms the final charge and billing date.
						}
					</p>
				</div>
				<a class="ts-icon-btn" href="/organization?tab=billing" aria-label="Close plan review">@icons.X(18)</a>
			</div>
			if data.Review.Error != "" {
				@ui.Alert("warning", "", data.Review.Error)
				if data.Review.CanUndo {
					<form method="post" action="/billing/change/undo">
						<input type="hidden" name="_csrf" value={ csrfToken }/>
						<button class="ts-btn ts-btn-secondary" type="submit">Undo scheduled change</button>
					</form>
				}
			} else {
				<dl class="ts-kv">
					<div><dt>Plan</dt><dd>{ data.Review.Name }</dd></div>
					<div><dt>Price</dt><dd>{ data.Review.Price }</dd></div>
					<div><dt>Charge today</dt><dd>{ data.Review.Estimate }</dd></div>
					<div><dt>Effective</dt><dd>{ data.Review.Effect }</dd></div>
					<div><dt>Storage</dt><dd>{ data.Review.Storage }</dd></div>
					<div><dt>Reads</dt><dd>{ data.Review.Reads }</dd></div>
					<div><dt>Writes</dt><dd>{ data.Review.Writes }</dd></div>
					<div><dt>Databases</dt><dd>{ data.Review.Databases }</dd></div>
					<div><dt>Team</dt><dd>{ data.Review.Members }</dd></div>
				</dl>
				for _, warning := range data.Review.Warnings {
					@ui.Alert("warning", warning.Title, warning.Detail)
				}
				if data.Review.Ready {
					<form method="post" action={ billingChangeAction(data) }>
						<input type="hidden" name="_csrf" value={ csrfToken }/>
						<input type="hidden" name="plan" value={ data.Review.Key }/>
						<input type="hidden" name="interval" value={ data.Review.Interval }/>
						<input type="hidden" name="return" value="/organization?tab=billing"/>
						<button class="ts-btn ts-btn-primary" type="submit">Confirm change</button>
					</form>
				}
			}
		</div>
	</dialog>
}

func billingChangeAction(data pageData) string {
	if data.BillingSubscription { return "/billing/change" }
	return "/billing/checkout"
}

templ spendingControlsTab(data pageData, csrfToken string) {
	<div class="ts-spending-heading">
		<div class="ts-stack-sm">
			<h2 class="ts-spending-title">Spending controls</h2>
			<p class="ts-meta">Manage monthly budgets and operation limits across your organization.</p>
		</div>
		@ui.Badge("info", data.PlanName + " plan")
	</div>
	if data.InternalBill != nil {
		@ui.Alert("info", "Report-only spending cap", "Internal caps only report alerts. They never charge Stripe, restrict writes or suspend services.")
	}
	if !data.CanManage {
		@ui.Alert("info", "View-only access", "Only organization owners and admins can change spending controls.")
	}
	<form id="spending-controls" class="ts-spending-form" method="post" action="/api/v1/dashboard/usage/spending-controls" data-submit-once data-signals={ spendingSignals(data.SelectedProject) } data-on:invalid__capture="$spendingProject = el.querySelector('input:invalid')?.closest('[data-project-id]')?.dataset.projectId || $spendingProject">
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		@ui.Card(ui.CardProps{ID: "organization-controls", Title: "Organization", Description: "Set the monthly budget shared by all projects and databases."}) {
			<fieldset class="ts-spending-fields" disabled?={ !data.CanManage }>
				<legend class="ts-sr-only">Organization spending limits</legend>
				<div class="ts-spending-identity">
					@icons.Building2(20)
					<strong class="ts-break">{ data.OrganizationName }</strong>
				</div>
				<div class="ts-spending-organization-price">
					@spendingPrice("organization-spend-cap", "spendCap", data.OrganizationCap)
				</div>
				if data.InternalBill == nil {
					<label class="ts-spending-excess" for="paid-excess">
						<span class="ts-stack-sm"><strong>Allow usage beyond included plan resources</strong><span class="ts-hint" id="paid-excess-hint">Additional usage is billed according to your plan.</span></span>
						<input class="ts-checkbox" id="paid-excess" type="checkbox" role="switch" name="paidExcess" value="true" checked?={ data.PaidExcess } aria-describedby="paid-excess-hint"/>
					</label>
				}
			</fieldset>
		}
		@ui.Card(ui.CardProps{ID: "project-controls", Title: "Project", Description: "Choose a project and configure its price and operation limits."}) {
			@ui.Field(ui.FieldProps{ID: "spending-project", Label: "Select project"}) {
				<div class="ts-spending-select">
					@icons.FolderOpen(18)
					<select class="ts-select" id="spending-project" name="project" data-bind="spendingProject" disabled?={ len(data.SpendingProjects) == 0 }>
						if len(data.SpendingProjects) == 0 {
							<option value="">No projects yet</option>
						}
						for _, project := range data.SpendingProjects {
							<option value={ project.ID } selected?={ project.ID == data.SelectedProject }>{ project.Name }</option>
						}
					</select>
				</div>
			}
			for _, project := range data.SpendingProjects {
				<div class="ts-spending-project" data-project-id={ project.ID } hidden?={ project.ID != data.SelectedProject } data-attr:hidden="$spendingProject !== el.dataset.projectId">
					<fieldset class="ts-spending-fields" disabled?={ !data.CanManage }>
						<legend class="ts-sr-only">{ project.Name + " project limits" }</legend>
						@spendingLimitFields("project", "proj", project.ID, project.SpendCap, project.Operations)
					</fieldset>
					<p class="ts-hint">Current effective price limit: <strong>{ project.Effective }</strong>. The lowest organization or project price limit applies.</p>
				</div>
			}
		}
		@ui.Card(ui.CardProps{ID: "database-controls", Title: "Databases", Description: "Fine-tune limits for individual databases in the selected project."}) {
			if len(data.SpendingProjects) == 0 {
				@ui.Empty("No databases yet", "Create a project and database to configure database spending controls.")
			}
			for _, project := range data.SpendingProjects {
				<div class="ts-spending-databases" data-project-id={ project.ID } hidden?={ project.ID != data.SelectedProject } data-attr:hidden="$spendingProject !== el.dataset.projectId">
					if len(project.Databases) == 0 {
						@ui.Empty("No databases yet", "Create a database in this project to configure its spending controls.") {
							<a class="ts-link" href={ "/databases?project=" + url.QueryEscape(project.ID) }>View databases</a>
						}
					}
					for _, database := range project.Databases {
						<fieldset class="ts-spending-database ts-spending-fields" disabled?={ !data.CanManage }>
							<legend class="ts-sr-only">{ database.Name + " database limits" }</legend>
							<div class="ts-spending-database-heading">
								<div class="ts-spending-identity">@icons.Database(18)<h3 class="ts-section-title ts-break">{ database.Name }</h3></div>
								@ui.Badge("neutral", database.Region)
							</div>
							@spendingLimitFields("database", "db", database.ID, database.SpendCap, database.Operations)
							<p class="ts-hint">Current effective price limit: <strong>{ database.Effective }</strong>. The lowest organization, project or database price limit applies.</p>
						</fieldset>
					}
				</div>
			}
		}
		<div class="ts-spending-actions">
			<p class="ts-hint">Limits reset monthly. Leave a field empty or enter 0 for no limit.</p>
			if data.CanManage {
				<button class="ts-btn ts-btn-primary" type="submit">@icons.Save(16)<span>Save spending controls</span></button>
			}
		</div>
	</form>
}

templ spendingLimitFields(kind, prefix, id, price string, operations core.OperationLimits) {
	<div class="ts-spending-limit-grid">
		@spendingPrice(kind+"-spend-cap-"+id, prefix+"Cap_"+id, price)
		@spendingOperation(kind+"-read-limit-"+id, prefix+"Read_"+id, "Read Limit", "Reads per month", operations.ReadLimit)
		@spendingOperation(kind+"-write-limit-"+id, prefix+"Write_"+id, "Write Limit", "Writes per month", operations.WriteLimit)
		@spendingOperation(kind+"-replication-limit-"+id, prefix+"Replication_"+id, "Replication Limit", "Replications per month", operations.ReplicationLimit)
	</div>
}

templ spendingPrice(id, name, value string) {
	{{ field := ui.FieldProps{ID: id, Label: "Price limit (USD)", Hint: "USD per month"} }}
	@ui.Field(field) {
		<div class="ts-spending-price">
			<span aria-hidden="true">$</span>
			<input class="ts-input" id={ id } name={ name } inputmode="decimal" pattern="\d+(\.\d{1,2})?" value={ value } placeholder="No limit" { field.ControlAttrs()... }/>
		</div>
	}
}

templ spendingOperation(id, name, label, hint string, value int64) {
	{{ field := ui.FieldProps{ID: id, Label: label, Hint: hint} }}
	@ui.Field(field) {
		<input class="ts-input" id={ id } name={ name } inputmode="numeric" pattern="\d+" value={ operationValue(value) } placeholder="No limit" { field.ControlAttrs()... }/>
	}
}

func usageTabHref(tab, project string) string {
	return "/usage?tab=" + tab + "&project=" + url.QueryEscape(project)
}

func historyDescription(data pageData) string {
	if data.SampleHistory {
		return "Sample organization operations, " + data.HistoryRangeLabel + ". Not measured provider traffic."
	}
	if data.SelectedDatabase != "" {
		return "The selected database, " + lowerFirst(data.HistoryRangeLabel)
	}
	return "The selected project, " + lowerFirst(data.HistoryRangeLabel)
}

func lowerFirst(text string) string {
	if text == "" {
		return text
	}
	return strings.ToLower(text[:1]) + text[1:]
}

func shareTitle(data pageData) string {
	if data.ExplicitProjectFilter {
		return "By database"
	}
	return "By project"
}

func shareDescription(data pageData) string {
	if data.ExplicitProjectFilter {
		return "Logical storage in the selected project and database scope"
	}
	return "Logical storage across this organization"
}

func statusTone(status string) string {
	switch status {
	case "ready", "active", "Ready", "Active":
		return "success"
	case "":
		return "neutral"
	}
	return "info"
}

func invoiceTone(status string) string {
	switch status {
	case "paid":
		return "success"
	case "open":
		return "warning"
	case "uncollectible":
		return "danger"
	}
	return "neutral"
}

// Organization keeps plan management, invoice filters and reviews within Billing.
templ organizationBillingContent(data pageData, csrfToken string, plans templ.Component) {
	<div class="ts-stack ts-billing ts-usage">
		if data.BillingNotice != "" {
			@ui.Alert("info", "", data.BillingNotice)
		}
		@plans
		<div class="ts-row">@billingActions(data)</div>
		<div class="ts-toolbar">@invoiceFilters(data)</div>
		@billingTab(data, csrfToken)
	</div>
}

templ billingSummaryActions(data pageData) {
	if !data.OrganizationBilling {
		@billingActions(data)
	}
}


templ internalBillCard(bill *internalBill) {
	@ui.Card(ui.CardProps{ID: "internal-bill", Title: "Internal computed bill", Description: "Report-only estimate from every project's UTC month-to-date usage. Reads are free. Storage uses the current logical size for a full month, not historical byte-seconds. No Stripe charges."}) {
		if !bill.Available {
			@ui.Alert("warning", "Internal bill unavailable", bill.Error)
		} else {
			<dl class="ts-kv">
				<div><dt>Period</dt><dd>{ bill.PeriodStart.Format("Jan 2, 2006") } – { bill.PeriodEnd.Format("Jan 2, 2006") } (UTC)</dd></div>
				<div><dt>Base plan</dt><dd>{ priceUSD(bill.BaseCents) }</dd></div>
				<div><dt>Reads / writes</dt><dd>{ fmt.Sprint(bill.Reads) } / { fmt.Sprint(bill.Writes) }</dd></div>
				<div><dt>Write overage</dt><dd>{ priceUSD(bill.WriteCents) } ({ priceUSD(bill.WriteRateCents) } per million beyond the allowance)</dd></div>
				<div><dt>Storage estimate</dt><dd>{ priceUSD(bill.StorageCents) } ({ priceUSD(bill.StorageRateCents) } per GiB-month beyond the allowance)</dd></div>
				<div><dt>Total estimate</dt><dd>{ priceUSD(bill.TotalCents) }</dd></div>
				<div><dt>Organization cap</dt><dd>{ capLabel(bill.SpendCapCents) } · report only; services remain active</dd></div>
			</dl>
			if bill.CapReached {
				@ui.Alert("warning", "Report-only spending cap reached", bill.Alert)
			}
		}
	}
}
