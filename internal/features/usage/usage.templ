package usage

import (
	"fmt"
	"net/url"
)

templ usageView(data pageData, projectName, csrfToken string) {
	<main class="ts-page">
		<header class="ts-page-header"><div><p class="ts-eyebrow">Organization billing</p><h1>Usage</h1><p>Current project: { projectName }</p></div></header>
		<nav aria-label="Usage sections">
			<a href={ "/usage?tab=overview&project=" + url.QueryEscape(data.SelectedProject) } aria-current={ templ.KV("page", data.Tab == "overview") }>Overview</a>
			<a href={ "/usage?tab=billing&project=" + url.QueryEscape(data.SelectedProject) } aria-current={ templ.KV("page", data.Tab == "billing") }>Billing</a>
			<a href={ "/usage?tab=settings&project=" + url.QueryEscape(data.SelectedProject) } aria-current={ templ.KV("page", data.Tab == "settings") }>Spending controls</a>
		</nav>
		if data.Saved == "ok" {
			<p role="status" class="ts-alert ts-alert-success">Spending controls saved.</p>
		}
		if data.Saved == "invalid" {
			<p role="alert" class="ts-alert ts-alert-danger">Enter a non-negative dollar amount with at most two decimal places.</p>
		}
		if data.Tab == "overview" {
			<section class="ts-usage-section" aria-labelledby="usage-allowance-title">
				<div class="ts-section-head">
					<div>
						<h2 class="ts-panel-title" id="usage-allowance-title">Plan allowance</h2>
						<p class="ts-meta">Configured limits for the { data.PlanName } plan</p>
					</div>
				</div>
				<div class="ts-usage-allowance">
					<dl class="ts-stats">
						<div><dt>Included storage</dt><dd>{ data.PlanStorageAllowance }</dd></div>
						<div><dt>Monthly requests</dt><dd>{ data.PlanRequestAllowance }</dd></div>
					</dl>
					<p class="ts-meta">{ data.PlanUsageNote }</p>
				</div>
			</section>
			<section class="ts-usage-section" aria-labelledby="usage-history-title">
				<div class="ts-section-head">
					<div>
						<h2 class="ts-panel-title" id="usage-history-title">Workload history</h2>
						<p class="ts-meta">Timestamped activity by operation</p>
					</div>
				</div>
				<div class="ts-empty" role="status">
					<span class="ts-empty-title">Workload history is unavailable.</span>
					<p class="ts-meta">This deployment has no timestamped workload source. Aggregate database totals cannot be shown as time-series history.</p>
				</div>
			</section>
			<section class="ts-usage-section" aria-labelledby="usage-by-project-title">
				<div class="ts-section-head">
					<div>
						<h2 class="ts-panel-title" id="usage-by-project-title">By project</h2>
						<p class="ts-meta">Project inventory and configured spending limits in this organization</p>
					</div>
				</div>
				if len(data.Projects) > 0 {
					<ul class="ts-usage-share">
						for _, project := range data.Projects {
							<li>
								<div class="ts-usage-share-head">
									<a class="ts-usage-drill" href={ "/usage?project=" + url.QueryEscape(project.ID) } aria-current={ templ.KV("page", project.Selected) }>{ project.Name }</a>
									<span class="ts-meta">{ fmt.Sprint(project.DatabaseCount) } databases</span>
								</div>
								<span class="ts-meta">Region: { project.Region }</span>
								<span class="ts-meta">Effective spending cap: { project.Effective }</span>
								<span class="ts-meta">Workload totals by project are unavailable.</span>
							</li>
						}
					</ul>
				} else {
					<div class="ts-empty" role="status"><span class="ts-empty-title">No projects are saved in this organization.</span></div>
				}
			</section>
			<section aria-labelledby="usage-summary">
				<h2 id="usage-summary">Project usage summary</h2>
				<p>{ data.UsageSource }</p>
				if data.UsageError != "" {
					<p role="status" class="ts-alert ts-alert-warning">{ data.UsageError }</p>
				}
				if data.UsageAvailable {
					<dl class="ts-stats">
						<div><dt>Databases</dt><dd>{ fmt.Sprint(data.ActiveDatabases) }</dd></div>
						<div><dt>Distinct database regions</dt><dd>{ fmt.Sprint(data.RegionCount) }</dd></div>
						<div><dt>Read operations</dt><dd>{ fmt.Sprint(data.Reads) }</dd></div>
						<div><dt>Write units</dt><dd>{ fmt.Sprint(data.Writes) }</dd></div>
						<div><dt>Read and write operations</dt><dd>{ fmt.Sprint(data.Requests) }</dd></div>
						if data.StorageByteSeconds > 0 {
							<div><dt>Storage activity</dt><dd>{ fmt.Sprint(data.StorageByteSeconds) } byte-seconds</dd></div>
						}
					</dl>
				} else {
					<div class="ts-empty" role="status">
						<span class="ts-empty-title">Usage totals are unavailable.</span>
						<p class="ts-meta">{ data.UsageError }</p>
					</div>
				}
			</section>
			<section aria-labelledby="database-usage">
				<h2 id="database-usage">Project databases</h2>
				<form method="get" action="/usage">
					<input type="hidden" name="tab" value="overview"/><input type="hidden" name="project" value={ data.SelectedProject }/>
					<label>
						Database filter 
						<select name="database">
							<option value="">All databases</option>
							for _, database := range data.Databases {
								<option value={ database.ID } selected?={ database.ID == data.SelectedDatabase }>{ database.Name }</option>
							}
						</select>
					</label><button type="submit">Apply</button>
				</form>
				if len(data.Databases) > 0 {
					<table>
						<thead><tr><th>Database</th><th>Region</th><th>Status</th><th>Documents</th><th>Spend cap</th><th>Effective limit</th></tr></thead>
						<tbody>
							for _, database := range data.Databases {
								<tr>
									<td>{ database.Name }</td>
									<td>{ database.Region }</td>
									<td>{ database.Status }</td>
									<td>{ fmt.Sprint(database.Documents) }</td>
									<td>
										if database.SpendCap != "" {
											${ database.SpendCap }
										} else {
											No database cap
										}
									</td>
									<td>{ database.Effective }</td>
								</tr>
							}
						</tbody>
					</table>
				} else {
					<p>No databases match this project filter.</p>
				}
			</section>
		} else if data.Tab == "billing" {
			<section aria-labelledby="billing-summary">
				<h2 id="billing-summary">Billing summary</h2>
				<dl>
					<div><dt>Plan</dt><dd>{ data.PlanName }</dd></div>
					<div>
						<dt>Billing status</dt>
						<dd>
							if data.BillingStatus != "" {
								{ data.BillingStatus }
							} else {
								Not reported
							}
						</dd>
					</div>
					<div><dt>Invoices</dt><dd>{ fmt.Sprint(data.InvoiceCount) }</dd></div>
					<div><dt>Current spending limit</dt><dd>{ data.EffectiveCap }</dd></div>
					if !data.BillingRenewal.IsZero() {
						<div><dt>Renewal</dt><dd>{ data.BillingRenewal.UTC().Format("Jan 2, 2006") }</dd></div>
					}
				</dl>
				if len(data.Invoices) > 0 {
					<h3>Recent invoices</h3>
					<table>
						<thead><tr><th>Invoice</th><th>Status</th><th>Amount</th><th>Date</th></tr></thead>
						<tbody>
							for _, invoice := range data.Invoices {
								<tr><td>{ invoice.Number }</td><td>{ invoice.Status }</td><td>{ invoice.Amount }</td><td>{ invoice.CreatedAt.UTC().Format("Jan 2, 2006") }</td></tr>
							}
						</tbody>
					</table>
				} else {
					<p>No invoices are available for this organization.</p>
				}
			</section>
		} else {
			<section aria-labelledby="spending-controls">
				<h2 id="spending-controls">Spending controls</h2>
				<p>Organization, project, and database caps work together. The tightest configured limit applies to each database.</p>
				if data.CanManage {
					<form method="post" action="/api/v1/dashboard/usage/spending-controls">
						<input type="hidden" name="_csrf" value={ csrfToken }/>
						<label>Monthly organization spending cap in USD <input name="spendCap" inputmode="decimal" pattern="\d+(\.\d{1,2})?" value={ data.OrganizationCap }/></label>
						<label><input type="checkbox" name="paidExcess" value="true" checked?={ data.PaidExcess }/> Allow usage beyond included plan resources</label>
						<h3>Project caps</h3>
						for _, project := range data.Projects {
							<label>{ project.Name } project cap in USD <input name={ "projCap_" + project.ID } inputmode="decimal" pattern="\d+(\.\d{1,2})?" value={ project.SpendCap }/> <small>Effective: { project.Effective }</small></label>
						}
						<h3>Database caps</h3>
						for _, database := range data.Databases {
							<label>{ database.Name } database cap in USD <input name={ "dbCap_" + database.ID } inputmode="decimal" pattern="\d+(\.\d{1,2})?" value={ database.SpendCap }/> <small>Effective: { database.Effective }</small></label>
						}
						<button type="submit">Save spending controls</button>
					</form>
				} else {
					<p>Only organization owners and admins can change spending controls.</p>
				}
			</section>
		}
	</main>
}
