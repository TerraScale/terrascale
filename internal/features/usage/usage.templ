package usage

import (
	"fmt"
	"net/url"

	"terrascale.tech/dashboard/internal/ui"
	"terrascale.tech/dashboard/internal/ui/aria"
	"terrascale.tech/dashboard/internal/ui/charts"
)

templ usageView(data pageData, projectName, csrfToken string) {
	<main class="ts-page ts-usage">
		@ui.PageHeader(ui.Header{Eyebrow: "Organization billing", Title: "Usage", Description: "Current project: " + projectName})
		<div class="ts-toolbar">
			@ui.Tabs("Usage sections", []ui.Tab{
				{Label: "Overview", URL: usageTabHref("overview", data.SelectedProject), Active: data.Tab == "overview"},
				{Label: "Billing", URL: usageTabHref("billing", data.SelectedProject), Active: data.Tab == "billing"},
				{Label: "Spending controls", URL: usageTabHref("settings", data.SelectedProject), Active: data.Tab == "settings"},
			})
			if data.Tab == "overview" {
				@overviewFilters(data)
			} else if data.Tab == "billing" {
				@invoiceFilters(data)
			}
		</div>
		if data.Saved == "ok" {
			@ui.Alert("success", "", "Spending controls saved.")
		}
		if data.Saved == "invalid" {
			@ui.Alert("danger", "", "Enter a non-negative dollar amount with at most two decimal places.")
		}
		switch data.Tab {
			case "overview":
				@overviewTab(data)
			case "billing":
				@billingTab(data)
			default:
				@spendingControlsTab(data, csrfToken)
		}
	</main>
}

templ overviewFilters(data pageData) {
	<form class="ts-filters" method="get" action="/usage" role="search" aria-label="Filter usage">
		<input type="hidden" name="tab" value="overview"/>
		<label class="ts-filter-field" for="usage-project">
			Project
			<select class="ts-select" id="usage-project" name="project">
				for _, project := range data.Projects {
					<option value={ project.ID } selected?={ project.ID == data.SelectedProject }>{ project.Name }</option>
				}
			</select>
		</label>
		<label class="ts-filter-field" for="usage-database">
			Database
			<select class="ts-select" id="usage-database" name="database">
				<option value="">All databases</option>
				for _, database := range data.DatabaseOptions {
					<option value={ database.ID } selected?={ database.ID == data.SelectedDatabase }>{ database.Name }</option>
				}
			</select>
		</label>
		<label class="ts-filter-field" for="usage-range">
			Period
			<select class="ts-select" id="usage-range" name="range">
				<option value="24h" selected?={ data.HistoryRange == "24h" }>Last 24 hours</option>
				<option value="7d" selected?={ data.HistoryRange == "7d" }>Last 7 days</option>
				<option value="30d" selected?={ data.HistoryRange == "30d" }>Last 30 days</option>
			</select>
		</label>
		<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Apply</button>
	</form>
}

templ invoiceFilters(data pageData) {
	<form class="ts-filters" method="get" action="/usage" role="search" aria-label="Filter payment history">
		<input type="hidden" name="tab" value="billing"/>
		<input type="hidden" name="project" value={ data.SelectedProject }/>
		<label class="ts-filter-field" for="invoice-status">
			Invoice status
			<select class="ts-select" id="invoice-status" name="status">
				<option value="" selected?={ data.InvoicePage.Status == "" }>All statuses</option>
				for _, option := range data.InvoicePage.StatusOptions {
					<option value={ option.Value } selected?={ data.InvoicePage.Status == option.Value }>{ option.Label }</option>
				}
			</select>
		</label>
		<label class="ts-filter-field" for="invoice-issued">
			Issued
			<select class="ts-select" id="invoice-issued" name="issued">
				<option value="" selected?={ data.InvoicePage.Issued == "" }>Any time</option>
				for _, option := range data.InvoicePage.IssuedOptions {
					<option value={ option.Value } selected?={ data.InvoicePage.Issued == option.Value }>{ option.Label }</option>
				}
			</select>
		</label>
		<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Apply</button>
		if data.InvoicePage.Status != "" || data.InvoicePage.Issued != "" {
			<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ billingTabHref(data.SelectedProject) }>Clear</a>
		}
	</form>
}

templ overviewTab(data pageData) {
	@ui.Card(ui.CardProps{ID: "usage-allowance", Title: "Plan allowance", Description: "Configured limits for the " + data.PlanName + " plan"}) {
		<div class="ts-stats-compact">
			@ui.Stats("Plan allowance") {
				@ui.Stat("Included storage", data.PlanStorageAllowance, "")
				@ui.Stat("Monthly requests", data.PlanRequestAllowance, "")
			}
		</div>
		<p class="ts-meta">{ data.PlanUsageNote }</p>
		if len(data.SampleGauges) > 0 {
			<div class="ts-card-section">
				<p class="ts-meta"><strong class="ts-strong">Illustrative demo capacity</strong> · The figures below are seeded samples, not your plan allowance or measured provider usage.</p>
				<div class="ts-usage-sample-gauges">
					for _, gauge := range data.SampleGauges {
						<div class="ts-usage-gauge">
							<div class="ts-usage-ring">
								@charts.Ring(gauge.Ring)
								<span class="ts-usage-ring-value"><strong>{ fmt.Sprint(gauge.Percent) }%</strong><small>sample</small></span>
							</div>
							<div class="ts-stack-sm">
								<span class="ts-stat-label">{ gauge.Name }</span>
								<span class="ts-usage-gauge-value">{ gauge.Used } <small>/ { gauge.Capacity }</small></span>
								<span class="ts-meta">Illustrative demo capacity</span>
							</div>
						</div>
					}
				</div>
			</div>
		}
	}
	<div class="ts-split">
		@ui.Card(ui.CardProps{ID: "usage-history", Title: "Workload history", Description: historyDescription(data), Actions: historyTotals(data)}) {
			if data.SampleHistory {
				<div class="ts-chart-shell ts-usage-chart-shell" role="region" aria-label="Sample workload chart. Scroll horizontally for the full plot." tabindex="0">
					@charts.Line(data.HistoryChart)
				</div>
				<p class="ts-meta">Reads, writes, and replication are deterministic demo series. They are separate from saved document counts and billing facts.</p>
			} else {
				@ui.Empty("Workload history is unavailable.", "This deployment has no timestamped workload source. Aggregate database totals cannot be shown as time-series history.")
			}
		}
		@ui.Card(ui.CardProps{ID: "usage-by-project", Title: shareTitle(data), Description: shareDescription(data)}) {
			if data.ExplicitProjectFilter && len(data.Databases) > 0 {
				<ul class="ts-usage-share">
					for _, database := range data.Databases {
						<li>
							<div class="ts-row-between"><span class="ts-strong">{ database.Name }</span><span class="ts-mono">{ database.StoredSize }</span></div>
							@charts.Bar(charts.NewBar(fmt.Sprintf("%s: %d percent of stored document bytes in this scope", database.Name, database.SharePercent), database.SharePercent))
							<span class="ts-meta">{ fmt.Sprint(database.Documents) } saved documents</span>
						</li>
					}
				</ul>
			} else if data.ExplicitProjectFilter {
				@ui.Empty("No databases match this project filter.", "")
			} else if len(data.Projects) > 0 {
				<ul class="ts-usage-share">
					for _, project := range data.Projects {
						<li>
							<div class="ts-row-between">
								<a class="ts-strong" href={ usageTabHref("overview", project.ID) } aria-current={ aria.CurrentPage(project.Selected) }>{ project.Name }</a>
								<span class="ts-mono">{ project.StoredSize }</span>
							</div>
							@charts.Bar(charts.NewBar(fmt.Sprintf("%s: %d percent of stored document bytes in this organization", project.Name, project.SharePercent), project.SharePercent))
							<span class="ts-meta">{ fmt.Sprint(project.DatabaseCount) } databases · Region: { project.Region } · Effective spending cap: { project.Effective }</span>
						</li>
					}
				</ul>
			} else {
				@ui.Empty("No projects are saved in this organization.", "")
			}
		}
	</div>
	@ui.Card(ui.CardProps{ID: "usage-summary", Title: "Project usage summary", Description: data.UsageSource}) {
		if data.UsageError != "" {
			@ui.Alert("warning", "", data.UsageError)
		}
		if data.UsageAvailable {
			@ui.Stats("Project usage summary") {
				@ui.Stat("Databases in project", fmt.Sprint(data.ActiveDatabases), "")
				@ui.Stat("Regions in project", fmt.Sprint(data.RegionCount), "")
				@ui.Stat("Read operations", fmt.Sprint(data.Reads), "")
				@ui.Stat("Write units", fmt.Sprint(data.Writes), "")
				@ui.Stat("Read and write operations", fmt.Sprint(data.Requests), "")
				if data.StorageByteSeconds > 0 {
					@ui.Stat("Storage activity", fmt.Sprint(data.StorageByteSeconds), "byte-seconds")
				}
			}
		} else {
			@ui.Empty("Usage totals are unavailable.", data.UsageError)
		}
	}
	@ui.Card(ui.CardProps{ID: "database-usage", Title: "Project databases", Description: "Database state and configured spending limits", Flush: true}) {
		if len(data.Databases) > 0 {
			<div class="ts-table-wrap" tabindex="0" role="region" aria-label="Project databases table. Scroll horizontally to see all columns.">
				<table class="ts-table">
					<caption class="ts-sr-only">Databases in the selected project and their configured spending limits</caption>
					<thead><tr><th scope="col">Database</th><th scope="col">Region</th><th scope="col">Status</th><th scope="col" class="ts-num">Documents</th><th scope="col">Spend cap</th><th scope="col">Effective limit</th></tr></thead>
					<tbody>
						for _, database := range data.Databases {
							<tr>
								<td class="ts-table-strong">{ database.Name }</td>
								<td>{ database.Region }</td>
								<td>@ui.Badge(statusTone(database.Status), database.Status)
</td>
								<td class="ts-num">{ fmt.Sprint(database.Documents) }</td>
								<td>
									if database.SpendCap != "" {
										${ database.SpendCap }
									} else {
										<span class="ts-meta">No database cap</span>
									}
								</td>
								<td>{ database.Effective }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			@ui.Empty("No databases match this project filter.", "")
		}
	}
}

templ historyTotals(data pageData) {
	if len(data.HistoryTotals) > 0 {
		<dl class="ts-usage-figures" aria-label="Sample totals for this range">
			for _, total := range data.HistoryTotals {
				<div><dt><span class={ "ts-chart-swatch " + total.Class }></span>{ total.Name }</dt><dd>{ fmt.Sprint(total.Value) }</dd></div>
			}
		</dl>
	}
}

templ billingTab(data pageData) {
	@ui.Card(ui.CardProps{ID: "billing-summary", Title: "Billing summary", Description: "Plan and invoice information reported for this organization", Actions: billingActions(data)}) {
		<dl class="ts-stats ts-usage-billing-kpis ts-stats-compact">
			<div class="ts-stat">
				<dt class="ts-stat-label">Plan</dt>
				<dd class="ts-stat-value">{ data.PlanName }</dd>
				<dd class="ts-stat-detail">
					Billing status:
					if data.BillingStatus != "" {
						{ data.BillingStatus }
					} else {
						Not reported
					}
					· { fmt.Sprint(data.InvoiceCount) } recorded invoices
					if !data.BillingRenewal.IsZero() {
						· Renews { data.BillingRenewal.UTC().Format("Jan 2, 2006") }
					}
				</dd>
			</div>
			@ui.Stat("Next recorded invoice", data.BillingSummary.NextInvoice, data.BillingSummary.NextDetail)
			<div class="ts-stat">
				<dt class="ts-stat-label">Billing period</dt>
				<dd class="ts-stat-value">{ data.BillingSummary.Period }</dd>
				if data.BillingSummary.HasPeriod {
					<dd>
						@charts.Bar(charts.NewBar(fmt.Sprintf("%d percent of recorded billing period elapsed", data.BillingSummary.PeriodPercent), data.BillingSummary.PeriodPercent))
					</dd>
				}
				<dd class="ts-stat-detail">{ data.BillingSummary.PeriodDetail }</dd>
			</div>
			@ui.Stat("Outstanding balance", data.BillingSummary.Outstanding, data.BillingSummary.OutstandingDetail)
			@ui.Stat("Current spending limit", data.EffectiveCap, "Configured for the selected project and database scope")
		</dl>
	}
	@ui.Card(ui.CardProps{ID: "recent-invoices", Title: "Payment history", Description: "Invoices recorded for this organization, newest first", Flush: true}) {
		if data.InvoicePage.Total > 0 {
			<div class="ts-table-wrap" tabindex="0" role="region" aria-label="Recent invoices table. Scroll horizontally to see all columns.">
				<table class="ts-table">
					<caption class="ts-sr-only">Invoices for this organization matching the current filters</caption>
					<thead><tr><th scope="col">Invoice</th><th scope="col">Issued</th><th scope="col">Period</th><th scope="col" class="ts-num">Amount</th><th scope="col">Status</th><th scope="col" class="ts-table-actions">Actions</th></tr></thead>
					<tbody>
						for _, invoice := range data.InvoicePage.Rows {
							<tr>
								<td class="ts-table-strong ts-mono">{ invoice.Number }</td>
								<td>
									if !invoice.CreatedAt.IsZero() {
										<time datetime={ invoice.CreatedAt.UTC().Format("2006-01-02") }>{ invoiceDate(invoice.CreatedAt) }</time>
									} else {
										-
									}
								</td>
								<td class="ts-meta">{ invoiceDate(invoice.PeriodStart) } – { invoiceDate(invoice.PeriodEnd) }</td>
								<td class="ts-num">{ invoice.Amount }</td>
								<td>@ui.Badge(invoiceTone(invoice.Status), invoice.Status)
</td>
								<td class="ts-table-actions">
									if invoice.HostedURL != "" {
										<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ invoice.HostedURL } target="_blank" rel="noopener noreferrer">Open</a>
									}
									if invoice.PDFURL != "" {
										<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ invoice.PDFURL } target="_blank" rel="noopener noreferrer">PDF</a>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<nav class="ts-pager" aria-label="Payment history pages">
				<span>Showing { fmt.Sprint(data.InvoicePage.First) }–{ fmt.Sprint(data.InvoicePage.First + len(data.InvoicePage.Rows) - 1) } of { fmt.Sprint(data.InvoicePage.Total) }</span>
				if data.InvoicePage.PageCount > 1 {
					<div class="ts-row">
						if data.InvoicePage.Page > 1 {
							<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ data.InvoicePage.Href(data.SelectedProject, data.InvoicePage.Page-1) } rel="prev">Previous</a>
						}
						for pageNumber := 1; pageNumber <= data.InvoicePage.PageCount; pageNumber++ {
							<a class="ts-btn ts-btn-ghost ts-btn-sm ts-usage-page" href={ data.InvoicePage.Href(data.SelectedProject, pageNumber) } aria-current={ aria.CurrentPage(pageNumber == data.InvoicePage.Page) }>{ fmt.Sprint(pageNumber) }</a>
						}
						if data.InvoicePage.Page < data.InvoicePage.PageCount {
							<a class="ts-btn ts-btn-ghost ts-btn-sm" href={ data.InvoicePage.Href(data.SelectedProject, data.InvoicePage.Page+1) } rel="next">Next</a>
						}
					</div>
				}
			</nav>
		} else {
			@ui.Empty("No invoices match these filters", "Change the status or issued date, or clear the filters.")
		}
	}
}

templ billingActions(data pageData) {
	if data.CanManageBilling {
		<a class="ts-btn ts-btn-primary" href="/billing/portal">Manage subscription</a>
	} else {
		<p class="ts-meta">Only the organization owner can manage billing.</p>
	}
}

templ spendingControlsTab(data pageData, csrfToken string) {
	@ui.Card(ui.CardProps{ID: "spending-controls", Title: "Spending controls", Description: "The tightest configured limit applies to each database."}) {
		if data.CanManage {
			<form class="ts-form" method="post" action="/api/v1/dashboard/usage/spending-controls">
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				<div class="ts-form-grid ts-usage-caps">
					@ui.Field(ui.FieldProps{ID: "organization-spend-cap", Label: "Monthly organization spending cap in USD"}) {
						@capInput("organization-spend-cap", "spendCap", data.OrganizationCap)
					}
				</div>
				<label class="ts-check"><input class="ts-checkbox" type="checkbox" name="paidExcess" value="true" checked?={ data.PaidExcess }/><span>Allow usage beyond included plan resources</span></label>
				<div class="ts-card-section">
					<h3 class="ts-section-title">Project caps</h3>
					<div class="ts-form-grid ts-usage-caps">
						for _, project := range data.Projects {
							@ui.Field(ui.FieldProps{ID: "project-spend-cap-" + project.ID, Label: project.Name + " project cap in USD", Hint: "Effective: " + project.Effective}) {
								@capInput("project-spend-cap-"+project.ID, "projCap_"+project.ID, project.SpendCap)
							}
						}
					</div>
				</div>
				<div class="ts-card-section">
					<h3 class="ts-section-title">Database caps</h3>
					<div class="ts-form-grid ts-usage-caps">
						for _, database := range data.Databases {
							@ui.Field(ui.FieldProps{ID: "database-spend-cap-" + database.ID, Label: database.Name + " database cap in USD", Hint: "Effective: " + database.Effective}) {
								@capInput("database-spend-cap-"+database.ID, "dbCap_"+database.ID, database.SpendCap)
							}
						}
					</div>
				</div>
				<div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Save spending controls</button></div>
			</form>
		} else {
			<p class="ts-meta">Only organization owners and admins can change spending controls.</p>
		}
	}
}

templ capInput(id, name, value string) {
	<input class="ts-input" id={ id } name={ name } inputmode="decimal" pattern="\d+(\.\d{1,2})?" value={ value }/>
}

func usageTabHref(tab, project string) string {
	return "/usage?tab=" + tab + "&project=" + url.QueryEscape(project)
}

func historyDescription(data pageData) string {
	if data.SampleHistory {
		return "Sample organization operations, " + data.HistoryRangeLabel + ". Not measured provider traffic."
	}
	return "Timestamped activity by operation"
}

func shareTitle(data pageData) string {
	if data.ExplicitProjectFilter {
		return "By database"
	}
	return "By project"
}

func shareDescription(data pageData) string {
	if data.ExplicitProjectFilter {
		return "Stored dashboard document bytes in the selected project and database scope"
	}
	return "Stored dashboard document bytes across this organization; not metered logical storage"
}

func statusTone(status string) string {
	switch status {
	case "ready", "active", "Ready", "Active":
		return "success"
	case "":
		return "neutral"
	}
	return "info"
}

func invoiceTone(status string) string {
	switch status {
	case "paid":
		return "success"
	case "open":
		return "warning"
	case "uncollectible":
		return "danger"
	}
	return "neutral"
}
