package auth

import (
	"fmt"

	"terrascale.tech/dashboard/internal/ui"
)

// One native input keeps paste, autofill, keyboard editing and screen readers
// working as usual; Datastar mirrors its value and selection into six boxes.
templ emailCodeInput(errorMessage string) {
	{{ field := ui.FieldProps{ID: "code", Label: "Six-digit code", Error: errorMessage} }}
	<div class="ts-field">
		<label class="ts-sr-only" for="code">{ field.Label }</label>
		<div class="ts-email-code" data-signals="{_emailCode: '', _codeCaret: 0, _codeEnd: 0}" data-init="el.classList.add('ts-email-code-ready')">
			<input
				class="ts-input ts-input-lg ts-email-code-input"
				id="code"
				name="code"
				inputmode="numeric"
				autocomplete="one-time-code"
				maxlength="64"
				pattern="[0-9]{6}"
				required
				autofocus
				spellcheck="false"
				data-bind="_emailCode"
				data-init="el.maxLength = 6"
				data-on:input="const start = el.value.slice(0, el.selectionStart).replace(/[^0-9]/g, '').length; const end = el.value.slice(0, el.selectionEnd).replace(/[^0-9]/g, '').length; el.value = el.value.replace(/[^0-9]/g, '').slice(0, 6); el.setSelectionRange(start, end); $_emailCode = el.value; $_codeCaret = el.selectionStart; $_codeEnd = el.selectionEnd"
				data-on:select="$_codeCaret = el.selectionStart; $_codeEnd = el.selectionEnd"
				data-on:keyup="$_codeCaret = el.selectionStart; $_codeEnd = el.selectionEnd"
				data-on:focus="$_codeCaret = el.selectionStart; $_codeEnd = el.selectionEnd"
				data-on:pointerdown="evt.preventDefault(); el.focus(); const index = Math.min(el.value.length, Math.max(0, Math.min(5, Math.floor((evt.clientX - el.getBoundingClientRect().left) / (el.clientWidth / 6))))); el.setSelectionRange(index, Math.min(index + 1, el.value.length)); $_codeCaret = el.selectionStart; $_codeEnd = el.selectionEnd"
				data-on:paste="evt.preventDefault(); const digits = evt.clipboardData.getData('text').replace(/[^0-9]/g, ''); el.setRangeText(digits.slice(0, 6 - el.value.length + el.selectionEnd - el.selectionStart), el.selectionStart, el.selectionEnd, 'end'); el.dispatchEvent(new Event('input', {bubbles: true}))"
				{ field.ControlAttrs()... }
			/>
			<div class="ts-email-code-slots" aria-hidden="true">
				for index := range 6 {
					<span
						class="ts-email-code-slot"
						data-text={ fmt.Sprintf("$_emailCode[%d] || ''", index) }
						data-class:ts-email-code-active={ fmt.Sprintf("Math.min($_codeCaret, 5) === %d", index) }
						data-class:ts-email-code-selected={ fmt.Sprintf("$_codeCaret <= %d && $_codeEnd > %d", index, index) }
					></span>
				}
			</div>
		</div>
		if field.Error != "" {
			<p class="ts-field-error" id="code-error">{ field.Error }</p>
		}
	</div>
}
