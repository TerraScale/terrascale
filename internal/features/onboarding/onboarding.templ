package onboarding

import (
	"fmt"

	"terrascale.tech/dashboard/internal/ui"
)

templ onboardingView(data pageData, csrfToken string) {
	<main class={ "ts-onboarding", templ.KV("ts-onboarding-wide", data.Step == "payment-method") }>
		<header class="ts-onboarding-header">
			<img class="ts-brand-logo" src="/brand/logo-terrascale-blue.svg" alt="TerraScale" decoding="async"/>
			<h1 class="ts-sr-only">Activate your TerraScale account</h1>
		</header>
		<div class="ts-onboarding-progress">
			<div class="ts-row-between ts-meta">
				<span class="ts-eyebrow">Step { onboardingProgressValue(data.CurrentStep) } of { onboardingProgressValue(data.TotalSteps) }</span>
				<span>{ onboardingProgressValue(data.Progress) }%</span>
			</div>
			<div class="ts-progress" role="progressbar" aria-label="Account setup progress" aria-valuenow={ onboardingProgressValue(data.Progress) } aria-valuemin="0" aria-valuemax="100">
				<div class="ts-progress-bar" data-progress={ onboardingProgressValue(data.Progress) }></div>
			</div>
			<ol class="ts-onboarding-steps" aria-label="Onboarding progress">
				for _, step := range data.Steps {
					<li class={ "ts-onboarding-step", templ.KV("ts-onboarding-step-current", step.Current), templ.KV("ts-onboarding-step-complete", step.Completed) } aria-current={ onboardingStepCurrent(step) }>
						<span class="ts-onboarding-step-icon" aria-hidden="true">{ onboardingStepGlyph(step) }</span>
						<span>{ step.Label }</span>
						<span class="ts-sr-only">{ step.State }</span>
					</li>
				}
			</ol>
		</div>
		<div class="ts-onboarding-card">
			if data.Step == "payment-method" && data.PaymentCanceled {
				@ui.Alert("warning", "Payment setup canceled", "Your earlier account progress is still saved. No payment method was changed; you can continue on the Free plan or try the demo checkout again.")
			}
			if data.Error != "" {
				@ui.Alert("danger", "", data.Error)
			}
			if data.Registration {
				@stepHeading("create-account-title", "Create your account", "Your Personal workspace is ready as soon as you save.")
				<form class="ts-form" method="post" action="/onboarding/register" aria-labelledby="create-account-title">
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					@ui.Field(ui.FieldProps{ID: "displayName", Label: "Full name"}) {
						<input class="ts-input" id="displayName" name="displayName" autocomplete="name" maxlength="128" required/>
					}
					@ui.Field(ui.FieldProps{ID: "email", Label: "Email"}) {
						<input class="ts-input" id="email" name="email" type="email" autocomplete="email" placeholder="name@company.com" required/>
					}
					<div class="ts-form-grid">
						@ui.Field(ui.FieldProps{ID: "password", Label: "Password"}) {
							@ui.PasswordInput(ui.PasswordProps{ID: "password", Autocomplete: "new-password", Placeholder: "Enter your password"})
						}
						@ui.Field(ui.FieldProps{ID: "confirmPassword", Label: "Confirm password"}) {
							@ui.PasswordInput(ui.PasswordProps{ID: "confirmPassword", Autocomplete: "new-password"})
						}
					</div>
					<label class="ts-check">
						<input type="checkbox" name="terms" value="true" required/>
						<span>I accept the Terms of Service</span>
					</label>
					<div class="ts-onboarding-footer">
						<p class="ts-meta">Already have an account? <a class="ts-link" href="/login">Sign in</a></p>
						<button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Save <span aria-hidden="true">→</span></button>
					</div>
				</form>
			} else if data.Step == "account-information" {
				@stepHeading("account-information-title", "Review your account information", "Signed in as "+data.Email)
				<form class="ts-form" method="post" action="/onboarding/step" aria-labelledby="account-information-title">
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					<input type="hidden" name="step" value="account-information"/>
					@ui.Field(ui.FieldProps{ID: "displayName", Label: "Full name"}) {
						<input class="ts-input" id="displayName" name="displayName" value={ data.DisplayName } maxlength="128" autocomplete="name" required/>
					}
					@ui.Field(ui.FieldProps{ID: "accountEmail", Label: "Email", Hint: "Your sign-in email cannot be changed during account setup."}) {
						<input class="ts-input" id="accountEmail" type="email" value={ data.Email } readonly/>
					}
					<div class="ts-onboarding-footer">
						<span></span>
						<button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Save and continue <span aria-hidden="true">→</span></button>
					</div>
				</form>
			} else if data.Step == "payment-method" {
				<form class="ts-form" method="post" action="/onboarding/step" aria-labelledby="payment-method-title">
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					<input type="hidden" name="step" value="payment-method"/>
					<input type="hidden" name="return" value="/onboarding"/>
					<div class="ts-row-between ts-onboarding-payment-head">
						if data.Demo {
							@stepHeading("payment-method-title", "Choose your plan", "Payment setup is optional for your Personal workspace. No real payment details or charges are used in this demo.")
						} else {
							@stepHeading("payment-method-title", "Choose your plan", "Payment setup is optional for your Personal workspace. Stripe collects your card and confirms the subscription.")
						}
						<fieldset class="ts-segmented" aria-label="Billing interval">
							<legend class="ts-sr-only">Billing interval</legend>
							<label>
								<input type="radio" name="interval" value="monthly" checked required/>
								<span>Monthly</span>
							</label>
							<label>
								<input type="radio" name="interval" value="annual"/>
								<span>Annual</span>
								@ui.Badge("success", "2 months free")
							</label>
						</fieldset>
					</div>
					<fieldset class="ts-onboarding-plans">
						<legend class="ts-sr-only">Select a plan</legend>
						for i, plan := range data.Plans {
							<label class="ts-onboarding-plan" data-tone={ planTone(i) }>
								<input class="ts-onboarding-plan-radio" type="radio" name="plan" value={ plan.Key } checked?={ i == 0 } required/>
								<span class="ts-row-between">
									<span class="ts-onboarding-plan-name">{ plan.Name }</span>
									<span class="ts-onboarding-plan-check" aria-hidden="true">✓</span>
								</span>
								<span class="ts-onboarding-plan-price">{ fmt.Sprintf("$%.2f", float64(plan.PriceCents)/100) }<span class="ts-meta"> / month</span></span>
								<span class="ts-meta">{ fmt.Sprintf("$%.2f", float64(plan.AnnualPriceCents)/100) } / year</span>
								<span class="ts-meta">{ plan.DatabaseAllowance() } · { plan.OperationsAllowance() }</span>
								<span class="ts-meta">{ plan.StorageAllowance() } · { plan.MemberAllowance() }</span>
								@ui.Badge("tone", fmt.Sprintf("%d-day trial", plan.TrialDays))
							</label>
						}
					</fieldset>
					if data.Demo {
						<p class="ts-meta">Continue to a local checkout simulation to test the flow. You can also continue on the Free plan without payment.</p>
					} else {
						<p class="ts-meta">Continue to Stripe Checkout or stay on Free without payment.</p>
					}
					<div class="ts-onboarding-footer">
						<button class="ts-btn ts-btn-secondary ts-btn-lg" type="submit" name="bypass" value="1" formnovalidate>Continue on Free</button>
						<button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Continue to checkout <span aria-hidden="true">→</span></button>
					</div>
				</form>
			} else {
				@stepHeading("project-title", "Create your first project", "Choose where your project's data will live.")
				<form class="ts-form" method="post" action="/onboarding/step" aria-labelledby="project-title">
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					<input type="hidden" name="step" value="project"/>
					@ui.Field(ui.FieldProps{ID: "projectName", Label: "Project name"}) {
						<input class="ts-input" id="projectName" name="name" maxlength="100" value="Personal" autocomplete="organization" required/>
					}
					@ui.Field(ui.FieldProps{ID: "region", Label: "Primary region", Hint: "You can add regions to your project later."}) {
						@ui.RegionMap("region")
						<select class="ts-select" id="region" name="region" required>
							<option value="GRU" selected>GRU · São Paulo</option>
							<option value="SFO">SFO · San Francisco</option>
							<option value="FRA">FRA · Frankfurt</option>
						</select>
					}
					<div class="ts-onboarding-footer">
						<span></span>
						<button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Create project and open Dashboard <span aria-hidden="true">→</span></button>
					</div>
				</form>
			}
		</div>
	</main>
}

templ stepHeading(id, title, description string) {
	<div class="ts-onboarding-heading">
		<h2 class="ts-section-title" id={ id }>{ title }</h2>
		<p class="ts-meta">{ description }</p>
	</div>
}
