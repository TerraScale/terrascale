package querysubscriptions

import (
	"terrascale.tech/dashboard/internal/core"
	"terrascale.tech/dashboard/internal/ui"
)

templ subscriptionsContent(page core.Page, d pageData) {
	<main class="ts-page" data-project-id={ d.ProjectID } data-organization-id={ page.Principal.OrganizationID }>
		@ui.PageHeader("Subscriptions")
		@ui.Alert("info", "", "Demo configuration only. Live revisions, checkpoints, subscriber counts, and delivery metrics are unavailable.")
		<div class="ts-split">
			@ui.Card(ui.CardProps{ID: "saved-configurations", Title: "Saved configurations", Description: "Shared views saved in this project.", Flush: true}) {
				if len(d.Configs) == 0 {
					@ui.Empty("No shared-result configurations yet.", "Save a read-only query to share its results.")
				} else {
					<div class="ts-table-wrap">
						<table class="ts-table">
							<thead><tr><th>View</th><th>Database</th><th>SQL</th><th>Preference</th><th>Status</th><th class="ts-table-actions">Actions</th></tr></thead>
							<tbody>
								for _, config := range d.Configs {
									<tr>
										<td class="ts-strong">{ config.Name }</td>
										<td>{ databaseName(d, config.DatabaseID) }</td>
										<td><code>{ config.Query }</code></td>
										<td>{ config.Transport }</td>
										<td>@ui.Badge(configTone(config.Status), config.Status)
</td>
										<td class="ts-table-actions">
											<div class="ts-row ts-row-end">
												if config.Status == "saved" {
													<form method="post" action="/api/v1/dashboard/subscriptions/pause"><input type="hidden" name="_csrf" value={ page.CSRFToken }/><input type="hidden" name="configId" value={ config.ID }/><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Pause</button></form>
												}
												<form method="post" action="/api/v1/dashboard/subscriptions/detach"><input type="hidden" name="_csrf" value={ page.CSRFToken }/><input type="hidden" name="configId" value={ config.ID }/><button class="ts-btn ts-btn-ghost ts-btn-sm" type="submit">Detach</button></form>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			}
			@ui.Card(ui.CardProps{ID: "shared-result", Title: "Shared result configuration", Description: "Choose an authorized database, a read-only query, and a delivery preference."}) {
				<form method="post" action="/api/v1/dashboard/subscriptions/attach" class="ts-form" aria-label="Save a shared view configuration">
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
					@ui.Field(ui.FieldProps{ID: "subscription-database", Label: "Database"}) {
						<select class="ts-select" id="subscription-database" name="databaseId" disabled?={ len(d.Databases) == 0 }>
							if len(d.Databases) == 0 {
								<option value="">No databases available</option>
							}
							for _, db := range d.Databases {
								<option value={ db.ID }>{ db.Name }</option>
							}
						</select>
					}
					@ui.Field(ui.FieldProps{ID: "subscription-name", Label: "View name", Hint: "Lowercase letters, digits, underscores, and hyphens."}) {
						<input class="ts-input" id="subscription-name" name="name" pattern="[a-z][a-z0-9_\-]*" maxlength="64" required/>
					}
					@ui.Field(ui.FieldProps{ID: "subscription-query", Label: "Read-only SQL statement", Hint: "Demo accepts SELECT * FROM collection with an optional LIMIT up to 100."}) {
						@ui.CodeEditor(ui.CodeEditorProps{ID: "subscription-query", Name: "query", Language: ui.CodeSQL, Value: "SELECT * FROM documents LIMIT 100", Rows: 5, Required: true})
					}
					@ui.Field(ui.FieldProps{ID: "subscription-transport", Label: "Delivery preference"}) {
						<select class="ts-select" id="subscription-transport" name="transport"><option value="http">HTTP + CDN</option><option value="websocket">WebSocket</option></select>
					}
					<div class="ts-form-actions">
						<button class="ts-btn ts-btn-primary" type="submit" disabled?={ len(d.Databases) == 0 }>Save configuration</button>
					</div>
				</form>
			}
		</div>
	</main>
}

func databaseName(d pageData, databaseID string) string {
	for _, db := range d.Databases {
		if db.ID == databaseID {
			return db.Name
		}
	}
	return "Unavailable database"
}

func configTone(status string) string {
	if status == "saved" {
		return "success"
	}
	return "neutral"
}
