package backups

import (
	"strconv"

	"terrascale.tech/dashboard/internal/core"
	"terrascale.tech/dashboard/internal/ui"
	"terrascale.tech/dashboard/internal/ui/icons"
)

func retentionDays(days int) string {
	if days == 0 {
		return "7"
	}
	return strconv.Itoa(days)
}

templ backupsContent(page core.Page, d pageData) {
	<main class="ts-page" data-project-id={ d.ProjectID } data-organization-id={ page.Principal.OrganizationID }>
		@ui.PageHeader(ui.Header{Title: "Backups", Description: "Take a snapshot and restore it to a new database."}) {
			if len(d.Databases) > 0 {
				<form method="get" class="ts-filters" aria-label="Choose database">
					<label class="ts-sr-only" for="database">Choose database</label>
					<select class="ts-select ts-input-sm ts-backups-db" id="database" name="databaseId">
						for _, db := range d.Databases {
							<option value={ db.ID } selected?={ db.ID == d.DatabaseID }>{ db.Name }</option>
						}
					</select>
					<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Open</button>
				</form>
				<form method="post" action="/api/v1/dashboard/backups">
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
					<input type="hidden" name="databaseId" value={ d.DatabaseID }/>
					<button class="ts-btn ts-btn-primary" type="submit">@icons.Archive(16)
<span>Create backup</span></button>
				</form>
			}
		}
		if d.Error != "" {
			@ui.Alert("danger", "", d.Error)
		}
		if len(d.Databases) > 0 {
			<div class="ts-split">
				@ui.Card(ui.CardProps{ID: "restore-points", Title: "Restore points", Description: "Restore a snapshot side by side as a new database.", Flush: true}) {
					if len(d.Backups) > 0 {
						<div class="ts-table-wrap">
							<table class="ts-table">
								<thead><tr><th>Created</th><th>Status</th><th class="ts-num">Size</th><th>Restore</th></tr></thead>
								<tbody>
									for _, backup := range d.Backups {
										<tr>
											<td class="ts-mono">{ backup.CreatedAt.UTC().Format("2006-01-02 15:04 UTC") }</td>
											<td>@ui.Badge(backupTone(backup.Status), backup.Status)
</td>
											<td class="ts-num">{ strconv.FormatInt(backup.SizeBytes, 10) } bytes</td>
											<td>
												<form class="ts-backups-restore" method="post" action="/api/v1/dashboard/backups/restore">
													<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
													<input type="hidden" name="databaseId" value={ d.DatabaseID }/>
													<input type="hidden" name="backupId" value={ backup.ID }/>
													<label class="ts-sr-only" for={ "restore-name-" + backup.ID }>New database name</label>
													<input class="ts-input ts-input-sm" id={ "restore-name-" + backup.ID } name="name" placeholder="New database name" required/>
													<button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Restore side by side</button>
												</form>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					} else {
						@ui.Empty("No restore points yet.", "Create a backup to capture the current state of this database.")
					}
				}
				@ui.Card(ui.CardProps{ID: "backup-policy", Title: "Backup policy", Description: "Cron schedules and how long snapshots are kept."}) {
					<form method="post" action="/api/v1/dashboard/backups/policy" class="ts-form">
						<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
						<input type="hidden" name="databaseId" value={ d.DatabaseID }/>
						@ui.Field(ui.FieldProps{ID: "full-cron", Label: "Full backup schedule"}) {
							<input class="ts-input ts-mono" id="full-cron" name="fullBackupCron" value={ d.Policy.FullBackupCron } placeholder="0 2 * * *"/>
						}
						@ui.Field(ui.FieldProps{ID: "incremental-cron", Label: "Incremental schedule"}) {
							<input class="ts-input ts-mono" id="incremental-cron" name="incrementalBackupCron" value={ d.Policy.IncrementalBackupCron } placeholder="0 * * * *"/>
						}
						@ui.Field(ui.FieldProps{ID: "retention", Label: "Retention days"}) {
							<input class="ts-input" id="retention" name="retentionDays" type="number" min="1" max="365" value={ retentionDays(d.Policy.RetentionDays) }/>
						}
						<div class="ts-form-actions">
							<button class="ts-btn ts-btn-primary" type="submit">Save policy</button>
						</div>
					</form>
				}
			</div>
		} else {
			@ui.Empty("Create a database to manage backups.", "Backups and restore points belong to a database.") {
				<a class="ts-btn ts-btn-primary" href="/databases">Go to databases</a>
			}
		}
	</main>
}

func backupTone(status string) string {
	switch status {
	case "completed", "ready", "succeeded":
		return "success"
	case "failed":
		return "danger"
	default:
		return "neutral"
	}
}
