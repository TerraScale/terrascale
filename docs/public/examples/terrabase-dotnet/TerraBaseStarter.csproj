<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TerraScale.DotNet" Version="$(TerraBaseSdkPackageVersion)" />
  </ItemGroup>
  <Target Name="RequireExactPackage" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(TerraBaseSdkPackageVersion)' == ''" Text="Supply TerraBaseSdkPackageVersion from the verified C# SDK artifact; obtain an exact C# TerraBase SDK candidate package." />
  </Target>
</Project>
