{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.terrascale.tech/cli-output.schema.json",
  "title": "TerraScale Go ts CLI output",
  "description": "Validate finite JSON once or each NDJSON line. x-commandResults selects each command success schema; finite failures use error. SDK metadata may include additional fields. This schema cannot validate exit status or terminal sequence.",
  "anyOf": [{"$ref": "#/$defs/finite"}, {"$ref": "#/$defs/error"}, {"$ref": "#/$defs/documentLine"}, {"$ref": "#/$defs/exportLine"}, {"$ref": "#/$defs/changeLine"}, {"$ref": "#/$defs/shellLine"}],
  "$defs": {
    "ulid": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"},
    "errorDetail": {"type": "object", "required": ["code", "message"], "properties": {"code": {"$ref": "#/$defs/identifier"}, "message": {"type": "string"}, "status": {"type": "integer", "minimum": 100, "maximum": 599}, "requestId": {"$ref": "#/$defs/identifier"}}, "additionalProperties": false},
    "error": {"type": "object", "required": ["error"], "properties": {"error": {"$ref": "#/$defs/errorDetail"}}, "additionalProperties": false},
    "complete": {"type": "object", "required": ["type"], "properties": {"type": {"const": "complete"}}, "additionalProperties": false},
    "streamError": {"type": "object", "required": ["type", "error"], "properties": {"type": {"const": "error"}, "error": {"$ref": "#/$defs/errorDetail"}}, "additionalProperties": false},
    "version": {"type": "object", "required": ["version"], "properties": {"version": {"type": "string"}}, "additionalProperties": false},
    "rootHelp": {"type": "object", "required": ["commands", "usage", "flags"], "properties": {"commands": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "integer"}}}, "usage": {"type": "string"}, "flags": {"type": "object", "additionalProperties": {"type": "string"}}}},
    "scopedHelp": {"type": "object", "required": ["command", "usage", "flags"], "properties": {"command": {"type": "string"}, "usage": {"type": "array", "items": {"type": "string"}}, "flags": {"type": "object", "additionalProperties": {"type": "string"}}}},
    "completion": {"type": "object", "required": ["shell", "script"], "properties": {"shell": {"enum": ["bash", "zsh", "fish"]}, "script": {"type": "string"}}, "additionalProperties": false},
    "signedIn": {"type": "object", "required": ["signedIn"], "properties": {"signedIn": {"type": "boolean"}}, "additionalProperties": false},
    "account": {"type": "object", "required": ["sub", "email"], "properties": {"sub": {"type": "string"}, "email": {"type": "string"}}, "additionalProperties": false},
    "organization": {"type": "object", "required": ["id", "name", "created_by"], "properties": {"id": {"$ref": "#/$defs/ulid"}, "name": {"type": "string"}, "created_by": {"$ref": "#/$defs/ulid"}, "role": {"type": "string"}}},
    "project": {"type": "object", "required": ["id", "organization_id", "name", "created_by"], "properties": {"id": {"$ref": "#/$defs/ulid"}, "organization_id": {"$ref": "#/$defs/ulid"}, "name": {"type": "string"}, "created_by": {"$ref": "#/$defs/ulid"}, "role": {"type": "string"}}},
    "keyMetadata": {"type": "object", "required": ["id", "name", "organization_id", "scopes"], "properties": {"id": {"$ref": "#/$defs/ulid"}, "name": {"type": "string"}, "organization_id": {"$ref": "#/$defs/ulid"}, "project_id": {"type": "string"}, "database": {"type": "string"}, "scopes": {"type": "array", "items": {"type": "string"}}, "allowed_cidrs": {"type": ["array", "null"], "items": {"type": "string"}}, "expires_at": {"type": ["string", "null"]}}},
    "createdKey": {"type": "object", "required": ["api_key", "key"], "properties": {"api_key": {"$ref": "#/$defs/keyMetadata"}, "key": {"type": "string"}}, "additionalProperties": false},
    "revokedKey": {"type": "object", "required": ["id", "revoked"], "properties": {"id": {"$ref": "#/$defs/ulid"}, "revoked": {"const": true}}, "additionalProperties": false},
    "database": {"type": "object", "required": ["id", "projectId", "name"], "properties": {"id": {"$ref": "#/$defs/ulid"}, "projectId": {"$ref": "#/$defs/ulid"}, "name": {"type": "string"}, "homeRegion": {"type": ["string", "null"]}, "replicaRegions": {"type": ["array", "null"], "items": {"type": "string"}}, "allRegions": {"type": "boolean"}}},
    "deletedDatabase": {"type": "object", "required": ["name", "deleted"], "properties": {"name": {"type": "string"}, "deleted": {"const": true}}, "additionalProperties": false},
    "collection": {"type": "object", "required": ["id", "name", "created_at"], "properties": {"id": {"$ref": "#/$defs/ulid"}, "name": {"type": "string"}, "created_at": {"type": "string"}}},
    "document": {"type": "object", "required": ["id", "version", "state"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "state": {"type": "string"}, "document": {"type": ["object", "null"]}, "siblings": {"type": "array", "items": {"type": "object"}}}},
    "writeResult": {"type": "object", "required": ["id", "version", "offset", "durability"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "offset": {"type": "string", "pattern": "^[0-9]+$"}, "durability": {"type": "string"}}},
    "importedDocuments": {"type": "object", "required": ["imported"], "properties": {"imported": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "declaredSchema": {"type": "object", "required": ["schema"], "properties": {"schema": {"type": ["object", "boolean", "null"]}, "dialect": {"type": "string"}}},
    "ttl": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}, "collection": {"type": "string"}}},
    "index": {"type": "object", "required": ["name", "collection", "fields"], "properties": {"name": {"type": "string"}, "collection": {"type": "string"}, "fields": {"type": "array", "items": {"type": "string"}}, "state": {"type": "string"}}},
    "droppedIndex": {"type": "object", "required": ["name", "dropped"], "properties": {"name": {"type": "string"}, "dropped": {"const": true}}, "additionalProperties": false},
    "usage": {"type": "object", "required": ["storageBytes", "documents", "reads", "writes"], "properties": {"storageBytes": {"type": "integer"}, "documents": {"type": "integer"}, "reads": {"type": "integer"}, "writes": {"type": "integer"}}},
    "backup": {"type": "object", "required": ["id", "databaseId", "status"], "properties": {"id": {"$ref": "#/$defs/ulid"}, "databaseId": {"$ref": "#/$defs/ulid"}, "status": {"type": "string"}, "trigger": {"type": "string"}, "sizeBytes": {"type": "integer"}}},
    "importJob": {"type": "object", "required": ["id", "project", "database", "state"], "properties": {"id": {"$ref": "#/$defs/ulid"}, "project": {"$ref": "#/$defs/ulid"}, "database": {"type": "string"}, "state": {"type": "string"}}},
    "function": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "source": {"type": "string"}, "trigger": {"type": ["object", "null"]}, "cron": {"type": ["string", "null"]}}},
    "functionLog": {"type": "object", "required": ["id", "at", "status"], "properties": {"id": {"$ref": "#/$defs/ulid"}, "at": {"type": "string"}, "status": {"type": "string"}, "durationMs": {"type": "integer"}, "lines": {"type": "array", "items": {"type": "string"}}}},
    "invocation": {"oneOf": [{"type": "object", "required": ["body"], "properties": {"body": {}}, "additionalProperties": false}, {"type": "object", "required": ["bodyBase64"], "properties": {"bodyBase64": {"type": "string", "contentEncoding": "base64"}}, "additionalProperties": false}]},
    "deletedFunction": {"type": "object", "required": ["name", "deleted"], "properties": {"name": {"type": "string"}, "deleted": {"const": true}}, "additionalProperties": false},
    "sqlRow": {"type": "object", "required": ["id", "value"], "properties": {"id": {"type": "string"}, "value": {"type": "object"}}},
    "documentSQL": {"type": "object", "required": ["matched", "truncated", "rows"], "properties": {"matched": {"type": "integer"}, "truncated": {"type": "boolean"}, "rows": {"type": "array", "items": {"$ref": "#/$defs/sqlRow"}}}},
    "sqlColumn": {"type": "object", "required": ["name", "decltype"], "properties": {"name": {"type": "string"}, "decltype": {"type": ["string", "null"]}}},
    "relationalSQL": {"type": "object", "required": ["columns", "rows", "rows_affected", "last_insert_rowid"], "properties": {"columns": {"type": "array", "items": {"$ref": "#/$defs/sqlColumn"}}, "rows": {"type": "array", "items": {"type": "array", "items": {}}}, "rows_affected": {"type": "integer"}, "last_insert_rowid": {"type": ["integer", "null"]}}},
    "migrationPath": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}}, "additionalProperties": false},
    "migrationRun": {"type": "object", "required": ["database", "applied"], "properties": {"database": {"type": "string"}, "applied": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "migrationState": {"type": "object", "required": ["name", "state"], "properties": {"name": {"type": "string"}, "state": {"enum": ["pending", "applied", "changed", "applied_missing_file"]}}, "additionalProperties": false},
    "schemaEntity": {"type": "object", "required": ["kind", "name"], "properties": {"kind": {"enum": ["table", "collection", "index"]}, "name": {"type": "string"}, "columns": {"type": "array", "items": {"$ref": "#/$defs/sqlColumn"}}, "collection": {"type": "string"}, "fields": {"type": "array", "items": {"type": "string"}}}},
    "schemaChange": {"type": "object", "required": ["kind", "name", "before", "after"], "properties": {"kind": {"type": "string"}, "name": {"type": "string"}, "before": {"anyOf": [{"$ref": "#/$defs/schemaEntity"}, {"type": "null"}]}, "after": {"anyOf": [{"$ref": "#/$defs/schemaEntity"}, {"type": "null"}]}}, "additionalProperties": false},
    "schemaDiff": {"type": "object", "required": ["base", "branch", "changes"], "properties": {"base": {"type": "string"}, "branch": {"type": "string"}, "changes": {"type": "array", "items": {"$ref": "#/$defs/schemaChange"}}}, "additionalProperties": false},
    "exportDocument": {"type": "object", "required": ["collection", "id", "document"], "properties": {"collection": {"type": "string"}, "id": {"type": "string"}, "document": {"type": "object"}}, "additionalProperties": false},
    "changeEvent": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["change", "cursor"]}, "cursor": {"type": "string"}, "collection": {"type": "string"}, "id": {"type": "string"}, "op": {"type": "string"}, "version": {"type": "string"}, "origin": {"type": "string"}, "document": {"type": ["object", "null"]}}},
    "context": {"type": "object", "required": ["accountId", "organizationId", "projectId"], "properties": {"accountId": {"type": "string"}, "organizationId": {"type": "string"}, "projectId": {"type": "string"}, "database": {"type": "string"}}, "additionalProperties": false},
    "clearedContext": {"type": "object", "required": ["cleared"], "properties": {"cleared": {"const": true}}, "additionalProperties": false},
    "backupPolicy": {"type": "object", "required": ["fullBackupCron", "retentionDays"], "properties": {"fullBackupCron": {"type": ["string", "null"]}, "retentionDays": {"type": "integer"}}},
    "restoreWindow": {"type": "object", "required": ["earliest", "latest"], "properties": {"earliest": {"type": "string"}, "latest": {"type": "string"}}},
    "restorePlan": {"type": "object", "required": ["window", "pointInTime", "snapshotAt"], "properties": {"window": {"$ref": "#/$defs/restoreWindow"}, "pointInTime": {"type": "string"}, "snapshotAt": {"type": "string"}, "segmentCount": {"type": "integer"}, "historyCheck": {"type": "string"}}},
    "backupDestination": {"type": "object", "required": ["endpoint", "region", "bucket", "mode"], "properties": {"endpoint": {"type": "string"}, "region": {"type": "string"}, "bucket": {"type": "string"}, "mode": {"enum": ["both", "customer"]}}},
    "deletedDestination": {"type": "object", "required": ["deleted", "projectId"], "properties": {"deleted": {"const": true}, "projectId": {"$ref": "#/$defs/ulid"}}, "additionalProperties": false},
    "deletedOrganization": {"type": "object", "required": ["deleted", "organizationId"], "properties": {"deleted": {"const": true}, "organizationId": {"$ref": "#/$defs/ulid"}}, "additionalProperties": false},
    "deletedProject": {"type": "object", "required": ["deleted", "organizationId", "projectId"], "properties": {"deleted": {"const": true}, "organizationId": {"$ref": "#/$defs/ulid"}, "projectId": {"$ref": "#/$defs/ulid"}}, "additionalProperties": false},
    "databases": {"type": "array", "items": {"$ref": "#/$defs/database"}},
    "organizations": {"type": "array", "items": {"$ref": "#/$defs/organization"}},
    "projects": {"type": "array", "items": {"$ref": "#/$defs/project"}},
    "keys": {"type": "array", "items": {"$ref": "#/$defs/keyMetadata"}},
    "collections": {"type": "array", "items": {"$ref": "#/$defs/collection"}},
    "indexes": {"type": "array", "items": {"$ref": "#/$defs/index"}},
    "backups": {"type": "array", "items": {"$ref": "#/$defs/backup"}},
    "functions": {"type": "array", "items": {"$ref": "#/$defs/function"}},
    "functionLogs": {"type": "array", "items": {"$ref": "#/$defs/functionLog"}},
    "migrationStates": {"type": "array", "items": {"$ref": "#/$defs/migrationState"}},
    "documentLine": {"anyOf": [{"type": "object", "required": ["type", "data"], "properties": {"type": {"const": "record"}, "data": {"$ref": "#/$defs/document"}}, "additionalProperties": false}, {"$ref": "#/$defs/complete"}, {"$ref": "#/$defs/streamError"}]},
    "exportLine": {"anyOf": [{"type": "object", "required": ["type", "data"], "properties": {"type": {"const": "record"}, "data": {"$ref": "#/$defs/exportDocument"}}, "additionalProperties": false}, {"$ref": "#/$defs/complete"}, {"$ref": "#/$defs/streamError"}]},
    "changeLine": {"anyOf": [{"type": "object", "required": ["type", "data"], "properties": {"type": {"const": "record"}, "data": {"$ref": "#/$defs/changeEvent"}}, "additionalProperties": false}, {"$ref": "#/$defs/complete"}, {"$ref": "#/$defs/streamError"}]},
    "shellLine": {"anyOf": [{"type": "object", "required": ["type", "data"], "properties": {"type": {"const": "record"}, "data": {"anyOf": [{"$ref": "#/$defs/documentSQL"}, {"$ref": "#/$defs/relationalSQL"}]}}, "additionalProperties": false}, {"$ref": "#/$defs/complete"}, {"$ref": "#/$defs/streamError"}]},
    "finite": {"anyOf": [{"$ref": "#/$defs/account"}, {"$ref": "#/$defs/backup"}, {"$ref": "#/$defs/backupDestination"}, {"$ref": "#/$defs/backupPolicy"}, {"$ref": "#/$defs/backups"}, {"$ref": "#/$defs/clearedContext"}, {"$ref": "#/$defs/collection"}, {"$ref": "#/$defs/collections"}, {"$ref": "#/$defs/completion"}, {"$ref": "#/$defs/context"}, {"$ref": "#/$defs/createdKey"}, {"$ref": "#/$defs/database"}, {"$ref": "#/$defs/databases"}, {"$ref": "#/$defs/declaredSchema"}, {"$ref": "#/$defs/deletedDatabase"}, {"$ref": "#/$defs/deletedDestination"}, {"$ref": "#/$defs/deletedFunction"}, {"$ref": "#/$defs/deletedOrganization"}, {"$ref": "#/$defs/deletedProject"}, {"$ref": "#/$defs/document"}, {"$ref": "#/$defs/documentSQL"}, {"$ref": "#/$defs/droppedIndex"}, {"$ref": "#/$defs/function"}, {"$ref": "#/$defs/functionLogs"}, {"$ref": "#/$defs/functions"}, {"$ref": "#/$defs/importJob"}, {"$ref": "#/$defs/importedDocuments"}, {"$ref": "#/$defs/index"}, {"$ref": "#/$defs/indexes"}, {"$ref": "#/$defs/invocation"}, {"$ref": "#/$defs/keys"}, {"$ref": "#/$defs/migrationPath"}, {"$ref": "#/$defs/migrationRun"}, {"$ref": "#/$defs/migrationStates"}, {"$ref": "#/$defs/organization"}, {"$ref": "#/$defs/organizations"}, {"$ref": "#/$defs/project"}, {"$ref": "#/$defs/projects"}, {"$ref": "#/$defs/relationalSQL"}, {"$ref": "#/$defs/restorePlan"}, {"$ref": "#/$defs/restoreWindow"}, {"$ref": "#/$defs/revokedKey"}, {"$ref": "#/$defs/rootHelp"}, {"$ref": "#/$defs/schemaDiff"}, {"$ref": "#/$defs/signedIn"}, {"$ref": "#/$defs/ttl"}, {"$ref": "#/$defs/usage"}, {"$ref": "#/$defs/version"}, {"$ref": "#/$defs/writeResult"}, {"$ref": "#/$defs/scopedHelp"}, {"$ref": "#/$defs/billing"}]},
    "billing": {"type": "object", "required": ["url"], "properties": {"url": {"const": "https://dash.terrascale.tech/billing"}}, "additionalProperties": false}
  },
  "x-commandResults": {
    "--version": {"$ref": "#/$defs/version"},
    "auth login": {"$ref": "#/$defs/signedIn"},
    "auth logout": {"$ref": "#/$defs/signedIn"},
    "backup create": {"$ref": "#/$defs/backup"},
    "backup destination delete": {"$ref": "#/$defs/deletedDestination"},
    "backup destination get": {"$ref": "#/$defs/backupDestination"},
    "backup destination set": {"$ref": "#/$defs/backupDestination"},
    "backup list": {"$ref": "#/$defs/backups"},
    "backup plan": {"$ref": "#/$defs/restorePlan"},
    "backup policy": {"$ref": "#/$defs/backupPolicy"},
    "backup policy-set": {"$ref": "#/$defs/backupPolicy"},
    "backup restore": {"$ref": "#/$defs/database"},
    "backup restore-at": {"$ref": "#/$defs/database"},
    "backup window": {"$ref": "#/$defs/restoreWindow"},
    "billing": {"$ref": "#/$defs/billing"},
    "collection create": {"$ref": "#/$defs/collection"},
    "collection drop": {"$ref": "#/$defs/collection"},
    "collection list": {"$ref": "#/$defs/collections"},
    "completion": {"$ref": "#/$defs/completion"},
    "context clear": {"$ref": "#/$defs/clearedContext"},
    "context set": {"$ref": "#/$defs/context"},
    "context show": {"$ref": "#/$defs/context"},
    "db branch": {"$ref": "#/$defs/database"},
    "db changes": {"$ref": "#/$defs/changeLine"},
    "db create": {"$ref": "#/$defs/database"},
    "db delete": {"$ref": "#/$defs/deletedDatabase"},
    "db info": {"$ref": "#/$defs/database"},
    "db list": {"$ref": "#/$defs/databases"},
    "db regions": {"$ref": "#/$defs/database"},
    "doc delete": {"$ref": "#/$defs/writeResult"},
    "doc get": {"$ref": "#/$defs/document"},
    "doc import": {"$ref": "#/$defs/importedDocuments"},
    "doc list": {"$ref": "#/$defs/documentLine"},
    "doc put": {"$ref": "#/$defs/writeResult"},
    "exec": {"$ref": "#/$defs/relationalSQL"},
    "export": {"$ref": "#/$defs/exportLine"},
    "functions delete": {"$ref": "#/$defs/deletedFunction"},
    "functions deploy": {"$ref": "#/$defs/function"},
    "functions invoke": {"$ref": "#/$defs/invocation"},
    "functions list": {"$ref": "#/$defs/functions"},
    "functions logs": {"$ref": "#/$defs/functionLogs"},
    "help": {"$ref": "#/$defs/rootHelp"},
    "import": {"$ref": "#/$defs/importJob"},
    "import cancel": {"$ref": "#/$defs/importJob"},
    "import status": {"$ref": "#/$defs/importJob"},
    "index create": {"$ref": "#/$defs/index"},
    "index drop": {"$ref": "#/$defs/droppedIndex"},
    "index list": {"$ref": "#/$defs/indexes"},
    "keys create": {"$ref": "#/$defs/createdKey"},
    "keys list": {"$ref": "#/$defs/keys"},
    "keys revoke": {"$ref": "#/$defs/revokedKey"},
    "migrate diff": {"$ref": "#/$defs/schemaDiff"},
    "migrate new": {"$ref": "#/$defs/migrationPath"},
    "migrate status": {"$ref": "#/$defs/migrationStates"},
    "migrate up": {"$ref": "#/$defs/migrationRun"},
    "orgs": {"$ref": "#/$defs/organizations"},
    "orgs create": {"$ref": "#/$defs/organization"},
    "orgs delete": {"$ref": "#/$defs/deletedOrganization"},
    "orgs info": {"$ref": "#/$defs/organization"},
    "orgs rename": {"$ref": "#/$defs/organization"},
    "projects": {"$ref": "#/$defs/projects"},
    "projects create": {"$ref": "#/$defs/project"},
    "projects delete": {"$ref": "#/$defs/deletedProject"},
    "projects info": {"$ref": "#/$defs/project"},
    "projects rename": {"$ref": "#/$defs/project"},
    "schema delete": {"$ref": "#/$defs/declaredSchema"},
    "schema get": {"$ref": "#/$defs/declaredSchema"},
    "schema set": {"$ref": "#/$defs/declaredSchema"},
    "shell": {"$ref": "#/$defs/shellLine"},
    "sql": {"$ref": "#/$defs/documentSQL"},
    "ttl delete": {"$ref": "#/$defs/ttl"},
    "ttl get": {"$ref": "#/$defs/ttl"},
    "ttl set": {"$ref": "#/$defs/ttl"},
    "usage": {"$ref": "#/$defs/usage"},
    "version": {"$ref": "#/$defs/version"},
    "whoami": {"$ref": "#/$defs/account"}
  }
}
