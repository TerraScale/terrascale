{
  "repository": "TerraScale.DotNet",
  "dependencies": [{ "source": "src/", "target": "internals-api-dashboard", "reason": "SDK changes require API and Dashboard consumer validation" }],
  "prProfiles": [
    { "name": "static", "resourceWeight": "light", "commands": [{ "description": "Restore", "command": "dotnet", "arguments": ["restore", "TerraScale.DotNet.slnx"] }, { "description": "Verify formatting", "command": "dotnet", "arguments": ["format", "TerraScale.DotNet.slnx", "--verify-no-changes", "--no-restore"] }] },
    { "name": "build", "resourceWeight": "medium", "commands": [{ "description": "Build SDK and sample", "command": "dotnet", "arguments": ["build", "TerraScale.DotNet.slnx", "--configuration", "Release", "--no-restore"] }] }
  ],
  "releaseProfiles": [
    { "name": "base-sdk-release-e2e", "resourceWeight": "heavy", "required": true, "candidateTarget": "base-sdk-release-e2e-tests", "entrypoint": "TerraScale.DotNet.Tests", "arguments": [], "minimumExpectedTests": 225 },
    { "name": "ef-core-release-e2e", "resourceWeight": "heavy", "required": true, "candidateTarget": "ef-core-release-e2e-tests", "entrypoint": "TerraScale.EntityFrameworkCore.Tests", "arguments": [], "minimumExpectedTests": 10 }
  ],
  "buildTargets": [
    { "name": "base-sdk-release-e2e-tests", "resourceWeight": "heavy", "outputPath": "artifacts/candidate-tests/base-sdk-release-e2e", "commands": [{ "description": "Publish the candidate-bound base SDK TUnit apphost", "command": "dotnet", "arguments": ["publish", "tests/TerraScale.DotNet.Tests/TerraScale.DotNet.Tests.csproj", "--configuration", "Release", "--output", "artifacts/candidate-tests/base-sdk-release-e2e"] }] },
    { "name": "ef-core-release-e2e-tests", "resourceWeight": "heavy", "outputPath": "artifacts/candidate-tests/ef-core-release-e2e", "commands": [{ "description": "Publish the candidate-bound EF Core TUnit apphost", "command": "dotnet", "arguments": ["publish", "tests/TerraScale.EntityFrameworkCore.Tests/TerraScale.EntityFrameworkCore.Tests.csproj", "--configuration", "Release", "--output", "artifacts/candidate-tests/ef-core-release-e2e"] }] },
    { "name": "dotnet-package-set-v2", "resourceWeight": "medium", "outputPath": "artifacts/candidate/dotnet-package-set-v2", "commands": [{ "description": "Build and verify the atomic SDK and EF Core package set", "command": "python3", "arguments": ["scripts/verify-package-set-candidate.py", "--emit-candidate"] }] }
  ],
  "candidate": { "genericPackageName": "ci-candidates-dotnet", "retentionDays": 7 },
  "promotion": { "strategy": "package", "endpoints": [] }
}
