{
  "repository": "TerraScale.TypeScript",
  "dependencies": [
    {
      "source": "src/",
      "target": "dashboard",
      "reason": "SDK changes require Dashboard build and browser E2E"
    }
  ],
  "prProfiles": [
    {
      "name": "static",
      "resourceWeight": "light",
      "commands": [
        {
          "description": "Clean install",
          "command": "npm",
          "arguments": [
            "ci"
          ]
        },
        {
          "description": "Typecheck",
          "command": "npm",
          "arguments": [
            "run",
            "typecheck"
          ]
        },
        {
          "description": "Build SDK",
          "command": "npm",
          "arguments": [
            "run",
            "build"
          ]
        },
        {
          "description": "Vitest suite (contract, drift, and forbidden-surface gates)",
          "command": "npm",
          "arguments": [
            "test"
          ]
        }
      ]
    },
    {
      "name": "build",
      "resourceWeight": "medium",
      "commands": [
        {
          "description": "Build SDK",
          "command": "npm",
          "arguments": [
            "run",
            "build"
          ]
        }
      ]
    }
  ],
  "releaseProfiles": [
    {
      "name": "regression",
      "resourceWeight": "medium",
      "required": true,
      "commands": [
        {
          "description": "Clean install",
          "command": "npm",
          "arguments": [
            "ci"
          ]
        },
        {
          "description": "Build SDK",
          "command": "npm",
          "arguments": [
            "run",
            "build"
          ]
        },
        {
          "description": "Unit and contract regression",
          "command": "npm",
          "arguments": [
            "test"
          ]
        }
      ]
    },
    {
      "name": "release-e2e",
      "resourceWeight": "heavy",
      "required": true,
      "commands": [
        {
          "description": "Clean install",
          "command": "npm",
          "arguments": [
            "ci"
          ]
        },
        {
          "description": "Build SDK",
          "command": "npm",
          "arguments": [
            "run",
            "build"
          ]
        },
        {
          "description": "Require live integration configuration",
          "command": "node",
          "arguments": [
            "scripts/require-release-e2e-config.mjs"
          ]
        },
        {
          "description": "Authenticated live API integration",
          "command": "npm",
          "arguments": [
            "run",
            "test:integration"
          ]
        }
      ]
    }
  ],
  "buildTargets": [
    {
      "name": "npm",
      "resourceWeight": "medium",
      "outputPath": "artifacts/candidate",
      "commands": [
        {
          "description": "Clean install",
          "command": "npm",
          "arguments": [
            "ci"
          ]
        },
        {
          "description": "Build SDK",
          "command": "npm",
          "arguments": [
            "run",
            "build"
          ]
        },
        {
          "description": "Unit and contract regression",
          "command": "npm",
          "arguments": [
            "test"
          ]
        },
        {
          "description": "Qualify npm release candidate",
          "command": "node",
          "arguments": [
            "scripts/qualify-npm-artifact.mjs",
            "--release",
            "--output",
            "artifacts/candidate"
          ]
        }
      ]
    }
  ],
  "candidate": {
    "genericPackageName": "ci-candidates-typescript",
    "retentionDays": 7
  },
  "promotion": {
    "strategy": "package",
    "endpoints": []
  }
}
