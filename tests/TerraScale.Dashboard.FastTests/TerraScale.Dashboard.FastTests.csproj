<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TerraScale.Dashboard.FastTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TerraScale.Dashboard.Testing/TerraScale.Dashboard.Testing.csproj" />
    <PackageReference Include="TUnit" Version="1.56.18" />
  </ItemGroup>

</Project>
