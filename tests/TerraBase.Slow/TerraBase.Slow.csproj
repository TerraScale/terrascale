<Project Sdk="Microsoft.NET.Sdk">
  <!-- The slow integration suite: comprehensive, expensive and exhaustive scenarios.
       It runs independently and never blocks.
       Test references and conventions come from Directory.Build.targets. -->
  <PropertyGroup>
    <RootNamespace>TerraBase.Slow</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- Linked ts-auth harness files name ts-auth through the tsauth alias below. -->
    <DefineConstants>$(DefineConstants);TSAUTH_ALIAS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../TerraBase.Fast/Import/Fixtures/**" Link="Import/Fixtures/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Npgsql" />
    <Compile Include="../../benchmark/dotnet/TerraBase.LiveRestoreDrill/ScratchCleanup.cs" Link="Backup/ScratchCleanup.cs" />
    <!-- The real ts-auth, run in process, for the token interoperability test (Management/RealAuthFixture.cs). The alias
         keeps its generated Program apart from TerraBase's. -->
    <ProjectReference Include="../../src/TerraScale.Authentication/TerraScale.Authentication.csproj" Aliases="tsauth" />
    <!-- ts-auth's own stand-in for GitHub's OIDC issuer, for the GitHub Actions workload token; TSAUTH_ALIAS makes it name
         ts-auth's types through the alias. -->
    <Compile Include="../TerraScale.Authentication.TestHarness/FakeGitHubActions.cs" Link="Management/FakeGitHubActions.cs" />
  </ItemGroup>
</Project>
