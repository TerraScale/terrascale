<Project Sdk="Microsoft.NET.Sdk">
  <!-- The slow integration suite: comprehensive, expensive and exhaustive scenarios.
       It runs independently and never blocks.
       Test references and conventions come from Directory.Build.targets. -->
  <PropertyGroup>
    <RootNamespace>TerraBase.Slow</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- The real ts-auth, run in process, for the token interoperability test (Management/RealAuthFixture.cs). The alias
         keeps its generated Program apart from TerraBase's. -->
    <ProjectReference Include="../../src/TerraScale.Authentication/TerraScale.Authentication.csproj" Aliases="tsauth" />
    <!-- ts-auth's storage in that test: the TerraBase release its own suite pins. -->
  </ItemGroup>
</Project>
