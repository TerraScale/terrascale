<Project Sdk="Microsoft.NET.Sdk">
  <!-- The slow integration suite. Tests drive the real application over HTTP on a
       loopback Kestrel socket; there are no unit tests. -->
  <PropertyGroup>
    <RootNamespace>TerraScale.Authentication.Slow</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1515: TUnit discovers public test classes. CA1707: test names use
         underscores as sentence separators. CA2007: tests have no synchronization
         context to capture. -->
    <NoWarn>$(NoWarn);CA1515;CA1707;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/TerraScale.Authentication/TerraScale.Authentication.csproj" />
    <ProjectReference Include="$(TsDotnetRoot)/src/TerraScale.DotNet.Testing/TerraScale.DotNet.Testing.csproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Bogus" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared harness source; deliberately not a third test project. -->
    <Compile Include="../TerraScale.Auth.TestHarness/**/*.cs" Link="TestHarness/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
