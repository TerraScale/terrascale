<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <IsPackable>false</IsPackable>
    <!-- The repository defaults to net11.0; fall back to the newest bundled
         runtime so the suite still builds and runs under a .NET 10 SDK. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(BundledNETCoreAppTargetFrameworkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0</TargetFrameworks>
    <TargetFramework />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.56.18" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\contracts\v1\conformance\msgpack\hostile-vectors.json" Link="conformance\hostile-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\v1\conformance\reactive.json" Link="conformance\reactive.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\v1\conformance\http.json" Link="conformance\http.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\v1\openapi.json" Link="conformance\openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TerraScale.DotNet\TerraScale.DotNet.csproj" />
  </ItemGroup>

</Project>
