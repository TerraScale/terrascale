<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <IsPackable>false</IsPackable>
    <!-- The repository defaults to net11.0; fall back to the newest bundled
         runtime so the suite still builds and runs under a .NET 10 SDK. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(BundledNETCoreAppTargetFrameworkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0</TargetFrameworks>
    <TargetFramework />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.56.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TerraScale.DotNet\TerraScale.DotNet.csproj" />
    <ProjectReference Include="../TerraScale.DotNet.FifoProbe/TerraScale.DotNet.FifoProbe.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="../TerraScale.DotNet.Qualification/NativeChecks.cs" Link="Native/NativeChecks.cs" />
  </ItemGroup>
  <Target Name="CopyFifoProbeArtifacts" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <MSBuild Projects="../TerraScale.DotNet.FifoProbe/TerraScale.DotNet.FifoProbe.csproj"
             Targets="GetFifoProbeArtifacts"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="FifoProbeArtifact" />
    </MSBuild>
    <Copy SourceFiles="@(FifoProbeArtifact)" DestinationFolder="$(TargetDir)FifoProbe" SkipUnchangedFiles="true" />
  </Target>
</Project>
