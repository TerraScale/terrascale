<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(BundledNETCoreAppTargetFrameworkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0</TargetFrameworks>
    <TargetFramework />
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/TerraScale.DotNet/TerraScale.DotNet.csproj" />
  </ItemGroup>
  <Target Name="GetFifoProbeArtifacts" DependsOnTargets="ResolveReferences;GetTargetPath" Returns="@(FifoProbeArtifact)">
    <ItemGroup>
      <FifoProbeArtifact Include="$(TargetPath);$(TargetDir)$(AssemblyName).runtimeconfig.json;$(TargetDir)$(AssemblyName).deps.json;@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
  </Target>
</Project>
