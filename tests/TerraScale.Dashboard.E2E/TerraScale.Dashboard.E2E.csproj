<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <OutputType>Exe</OutputType>
    <PublishAot>false</PublishAot>
    <!-- Culture-independence journeys exercise real cultures, as in the original dashboard suite. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Many concurrent real hosts allocate independently; use parallel GC as in the TerraBase integration suite. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- The synthetic host switches run from an awaited Main (Support/TestExecutableEntryPoint.cs), not a module initializer.
         The generated testing-platform helper stays, so TUnit runs exactly as its generated entry point would run it. -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <GenerateTestingPlatformApplicationHelper>true</GenerateTestingPlatformApplicationHelper>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/TerraScale.Dashboard/TerraScale.Dashboard.csproj" />
    <!-- Fake TerraBase producers serve the dashboard's MagicOnion calls through their REST fakes. -->
    <ProjectReference Include="../../src/TerraScale.TerraBase.Rpc/TerraScale.TerraBase.Rpc.csproj" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Stripe.net" />
    <None Update="Support/axe-core/axe.min.js" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Bogus" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="TerraScale.Dashboard.E2E.Demo" />
    <!-- TUnit.Core also has a TestState. -->
    <Using Include="TerraScale.Dashboard.E2E.Demo.TestState" Alias="TestState" />
  </ItemGroup>
</Project>
