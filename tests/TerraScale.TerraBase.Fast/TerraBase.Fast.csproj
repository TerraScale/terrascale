<Project Sdk="Microsoft.NET.Sdk">
  <!-- The fast integration suite: critical paths and common workflows. It blocks every
       merge, deployment and release.
       Test references and conventions come from Directory.Build.targets. -->
  <PropertyGroup>
    <RootNamespace>TerraBase.Fast</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../../scripts/prod-replication-check" Link="scripts/prod-replication-check" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
