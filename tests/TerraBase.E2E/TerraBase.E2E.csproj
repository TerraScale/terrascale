<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>TerraBase.E2E</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <ProjectReference Include="$(TsDotnetRoot)/src/TerraScale.DotNet/TerraScale.DotNet.csproj" />
    <Compile Include="../../benchmark/dotnet/VsTurso/*.cs" Link="Benchmarks/%(Filename)%(Extension)" />
    <Compile Include="../../benchmark/dotnet/LocalBenchmarkHost.cs" Link="Benchmarks/LocalBenchmarkHost.cs" />
    <!-- Built at test time by WalFaults/WalSyncFaults.cs with the host's C compiler. -->
    <None Include="WalFaults/walfaults.c" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
