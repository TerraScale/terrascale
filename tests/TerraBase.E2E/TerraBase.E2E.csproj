<Project Sdk="Microsoft.NET.Sdk">
  <!-- The end-to-end replication suite: leaderless writes between gru, sjc and fra over the public HTTP API.
       Local by default (in-process nodes); set TERRABASE_E2E_ORCH_NODES to run the same scenarios against ts-orch.
       Test references and conventions come from Directory.Build.targets. -->
  <PropertyGroup>
    <RootNamespace>TerraBase.E2E</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built at test time by WalFaults/WalSyncFaults.cs with the host's C compiler. -->
    <None Include="WalFaults/walfaults.c" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
