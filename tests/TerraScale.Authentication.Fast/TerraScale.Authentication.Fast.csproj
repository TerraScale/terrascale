<Project Sdk="Microsoft.NET.Sdk">
  <!-- The fast integration suite. Tests drive the real application over HTTP on a
       loopback Kestrel socket; there are no unit tests. -->
  <PropertyGroup>
    <RootNamespace>TerraScale.Authentication.Fast</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1515: TUnit discovers public test classes. CA1707: test names use
         underscores as sentence separators. CA2007: tests have no synchronization
         context to capture. -->
    <NoWarn>$(NoWarn);CA1515;CA1707;CA2007</NoWarn>
    <!-- Tiered PGO instrumentation costs the suite about 36% of its CPU: 4m43s to 3m02s of user time on the same binary. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/TerraScale.Authentication/TerraScale.Authentication.csproj" />
    <!-- Stopped-copy fault injection only; application access continues through ts-dotnet. -->
    <ProjectReference Include="../../src/vendor/Turso.Data.Sqlite/src/Turso.Data.Sqlite/Turso.Data.Sqlite.csproj" />
    <!-- TerraBaseSdkContractTests: the routes the pinned ts-dotnet clients call. -->
    <None Include="$(TsDotnetRoot)/contracts/terrabase/routes.json" Link="contracts/terrabase/routes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="ZLogger" />
    <!-- FakeTimeProvider: drives the readiness loop's five-second passes and eight-second deadline. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests start many short-lived hosts: no IL-compiled DI resolvers per host (see Directory.Build.targets). -->
    <RuntimeHostConfigurationOption Include="Microsoft.Extensions.DependencyInjection.DisableDynamicEngine" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- axe-core is a pinned test-only JavaScript asset; Deque's .NET adapter transitively requires banned Newtonsoft.Json. -->
    <Content Include="Accessibility/node_modules/axe-core/axe.min.js" Link="axe.min.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Accessibility/node_modules/axe-core/LICENSE" Link="axe-core-LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shared harness source; deliberately not a third test project. -->
    <Compile Include="../TerraScale.Authentication.TestHarness/**/*.cs" Link="TestHarness/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
