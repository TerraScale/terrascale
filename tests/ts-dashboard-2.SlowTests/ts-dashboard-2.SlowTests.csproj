<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net11 to reference the net11 ts-auth + TerraBase siblings for the live stack. -->
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>TerraScale.Dashboard.SlowTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ts-dashboard-2.Testing/ts-dashboard-2.Testing.csproj" />
    <PackageReference Include="TUnit" Version="1.56.18" />
  </ItemGroup>

  <!-- The live stack (embedded TerraBase engine + the real ts-auth service)
       resolves the sibling checkouts; without them the live fixtures compile
       out and only the demo-mode methodical tests run. -->
  <PropertyGroup>
    <TsAuthProject Condition="'$(TsAuthProject)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\ts-auth\src\TerraScale.Auth\TerraScale.Auth.csproj')">$(MSBuildThisFileDirectory)..\..\..\ts-auth\src\TerraScale.Auth\TerraScale.Auth.csproj</TsAuthProject>
    <TerraBaseProject Condition="'$(TerraBaseProject)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\terrabase\src\TerraBase\TerraBase.csproj')">$(MSBuildThisFileDirectory)..\..\..\terrabase\src\TerraBase\TerraBase.csproj</TerraBaseProject>
    <HasLiveStack Condition="'$(TsAuthProject)' != '' and '$(TerraBaseProject)' != ''">true</HasLiveStack>
    <DefineConstants Condition="'$(HasLiveStack)' == 'true'">$(DefineConstants);TS_AUTH_STACK</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(HasLiveStack)' == 'true'">
    <ProjectReference Include="$(TsAuthProject)" />
    <ProjectReference Include="$(TerraBaseProject)" />
  </ItemGroup>

</Project>
