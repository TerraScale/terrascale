<Project>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <!-- TerraScale.Endpoints (src/): opt in with <UseTerraScaleEndpoints>true</UseTerraScaleEndpoints>. Its generator
       is referenced as an analyzer only, so endpoint registration happens at compile time. -->
  <ItemGroup Condition="'$(UseTerraScaleEndpoints)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/TerraScale.Endpoints/TerraScale.Endpoints.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/TerraScale.Endpoints.Generators/TerraScale.Endpoints.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Authored code uses System.Text.Json; BannedSymbols.txt blocks Newtonsoft APIs.
       The package graph also rejects Newtonsoft except the approved dashboard
       Stripe.net transitive edge, checked below. -->
  <Target Name="BanNewtonsoftJsonPackages" AfterTargets="ResolvePackageAssets" Condition="'@(PackageDependencies)' != '' or '@(PackageReference)' != ''">
    <ItemGroup>
      <_DirectNewtonsoftPackage Include="@(PackageReference)" Condition="$([System.String]::Copy('%(Identity)').Contains('Newtonsoft', System.StringComparison.OrdinalIgnoreCase))" />
      <_DashboardStripePackage Include="@(ResolvedCompileFileDefinitions)" Condition="'$(IsDashboardArea)' == 'true' and '%(ResolvedCompileFileDefinitions.NuGetPackageId)' == 'Stripe.net'" />
      <_NewtonsoftPackage Include="@(PackageReference)" Condition="$([System.String]::Copy('%(Identity)').Contains('Newtonsoft', System.StringComparison.OrdinalIgnoreCase))" />
      <_NewtonsoftPackage Include="@(RuntimeCopyLocalItems->'%(NuGetPackageId)')" Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.NuGetPackageId)').Contains('Newtonsoft', System.StringComparison.OrdinalIgnoreCase))" />
      <_NewtonsoftPackage Include="@(ResolvedCompileFileDefinitions->'%(NuGetPackageId)')" Condition="$([System.String]::Copy('%(ResolvedCompileFileDefinitions.NuGetPackageId)').Contains('Newtonsoft', System.StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
    <Error Condition="'@(_DirectNewtonsoftPackage)' != ''" Text="Direct Newtonsoft package references are banned. Use System.Text.Json." />
    <PropertyGroup>
      <_DesignHostStripe Condition="'@(_DashboardStripePackage)' != ''">Stripe.net</_DesignHostStripe>
    </PropertyGroup>
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory).github/scripts/dashboard/check-stripe-dependency.py&quot; &quot;$(ProjectAssetsFile)&quot;" Condition="'@(_DashboardStripePackage)' != '' and !$(MSBuildProjectName.EndsWith('.EntityFrameworkDesign'))" />
    <ItemGroup Condition="'@(_DashboardStripePackage)' != ''">
      <_NewtonsoftPackage Remove="@(_NewtonsoftPackage)" Condition="'%(_NewtonsoftPackage.NuGetPackageId)' == 'Newtonsoft.Json'" />
    </ItemGroup>
    <Error Condition="$(MSBuildProjectName.EndsWith('.EntityFrameworkDesign')) and ('$(IsPackable)' != 'false' or '$(IsPublishable)' != 'false')" Text="An Entity Framework Core design host is never packed or published: set IsPackable and IsPublishable to false." />
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory).github/scripts/check-design-host.py&quot; &quot;$(ProjectAssetsFile)&quot; $(_DesignHostStripe)" Condition="$(MSBuildProjectName.EndsWith('.EntityFrameworkDesign'))" />
    <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.EntityFrameworkDesign'))">
      <_NewtonsoftPackage Remove="@(_NewtonsoftPackage)" Condition="'%(_NewtonsoftPackage.NuGetPackageId)' == 'Newtonsoft.Json'" />
    </ItemGroup>
    <Error Condition="'@(ProjectReference)' != '' and $([System.String]::Copy('@(ProjectReference)').Contains('.EntityFrameworkDesign.csproj'))" Text="Entity Framework Core design hosts carry design-time tooling; no project references one." />
    <Error Condition="'$(MSBuildProjectName)' == 'TerraScale.Aspire' and ('$(IsPackable)' != 'false' or '$(IsPublishable)' != 'false')" Text="TerraScale.Aspire is a local development host and is never packed or published: set IsPackable and IsPublishable to false." />
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory).github/scripts/check-aspire-host.py&quot; &quot;$(ProjectAssetsFile)&quot;" Condition="'$(MSBuildProjectName)' == 'TerraScale.Aspire'" />
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'TerraScale.Aspire'">
      <_NewtonsoftPackage Remove="@(_NewtonsoftPackage)" Condition="'%(_NewtonsoftPackage.NuGetPackageId)' == 'Newtonsoft.Json'" />
    </ItemGroup>
    <Error Condition="'@(ProjectReference)' != '' and $([System.String]::Copy('@(ProjectReference)').Contains('TerraScale.Aspire.csproj'))" Text="TerraScale.Aspire is a local development host; no project references it." />
    <Error Condition="'@(_NewtonsoftPackage)' != ''" Text="Newtonsoft packages are banned ('@(_NewtonsoftPackage->Distinct())'). Use System.Text.Json; remove the package or the dependency that brings it in." />
  </Target>

  <Target Name="ClassifyStorageNativeForSingleFile" BeforeTargets="_ComputeFilesToBundle" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'libsqlite3mc.so' Or '%(Filename)%(Extension)' == 'libmsquic.so.2' Or '%(Filename)%(Extension)' == 'libnuma.so.1'" AssetType="native" RelativePath="%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(IsTerraBaseArea)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsDashboardArea)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
