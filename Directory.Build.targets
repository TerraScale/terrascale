<Project>
  <!-- Imported after every project file, so these rules can key on properties the
       projects set (UseTerraScaleEndpoints, IsTestProject) and the area flags of Directory.Build.props. -->

  <!-- TerraScale.Endpoints (src/): opt in with <UseTerraScaleEndpoints>true</UseTerraScaleEndpoints>. Its generator
       is referenced as an analyzer only, so endpoint registration happens at compile time. -->
  <ItemGroup Condition="'$(UseTerraScaleEndpoints)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/TerraScale.Endpoints/TerraScale.Endpoints.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/TerraScale.Endpoints.Generators/TerraScale.Endpoints.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Authored code uses System.Text.Json; BannedSymbols.txt blocks Newtonsoft APIs.
       The package graph also rejects Newtonsoft except the approved dashboard
       Stripe.net transitive edge, checked below. -->
  <Target Name="BanNewtonsoftJsonPackages" AfterTargets="ResolvePackageAssets" Condition="'@(PackageDependencies)' != '' or '@(PackageReference)' != ''">
    <ItemGroup>
      <_DirectNewtonsoftPackage Include="@(PackageReference)" Condition="$([System.String]::Copy('%(Identity)').Contains('Newtonsoft', System.StringComparison.OrdinalIgnoreCase))" />
      <_DashboardStripePackage Include="@(ResolvedCompileFileDefinitions)" Condition="'$(IsDashboardArea)' == 'true' and '%(ResolvedCompileFileDefinitions.NuGetPackageId)' == 'Stripe.net'" />
      <_NewtonsoftPackage Include="@(PackageReference)" Condition="$([System.String]::Copy('%(Identity)').Contains('Newtonsoft', System.StringComparison.OrdinalIgnoreCase))" />
      <_NewtonsoftPackage Include="@(RuntimeCopyLocalItems->'%(NuGetPackageId)')" Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.NuGetPackageId)').Contains('Newtonsoft', System.StringComparison.OrdinalIgnoreCase))" />
      <_NewtonsoftPackage Include="@(ResolvedCompileFileDefinitions->'%(NuGetPackageId)')" Condition="$([System.String]::Copy('%(ResolvedCompileFileDefinitions.NuGetPackageId)').Contains('Newtonsoft', System.StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
    <Error Condition="'@(_DirectNewtonsoftPackage)' != ''" Text="Direct Newtonsoft package references are banned. Use System.Text.Json." />
    <!-- Human approval 2026-10-29: only the official Stripe SDK's transitive Newtonsoft.Json dependency in dashboard projects. -->
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)scripts/dashboard/check-stripe-dependency.py&quot; &quot;$(ProjectAssetsFile)&quot;" Condition="'@(_DashboardStripePackage)' != ''" />
    <ItemGroup Condition="'@(_DashboardStripePackage)' != ''">
      <_NewtonsoftPackage Remove="@(_NewtonsoftPackage)" Condition="'%(_NewtonsoftPackage.NuGetPackageId)' == 'Newtonsoft.Json'" />
    </ItemGroup>
    <Error Condition="'@(_NewtonsoftPackage)' != ''" Text="Newtonsoft packages are banned ('@(_NewtonsoftPackage->Distinct())'). Use System.Text.Json; remove the package or the dependency that brings it in." />
  </Target>


  <!-- Project-reference content loses AssetType; .NET's single-file publisher otherwise leaves Turso beside the app. -->
  <Target Name="ClassifyTursoNativeForSingleFile" BeforeTargets="_ComputeFilesToBundle" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'libturso_sdk_kit.so'" AssetType="native" />
    </ItemGroup>
  </Target>

  <!-- Every test project: not packable. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- TerraBase area: banned APIs (RS0030) and the BannedSymbols.txt list. Auth and ts-libs throw framework exceptions
       on purpose (BadHttpRequestException in the endpoint binder), so the rule stays with TerraBase. -->
  <ItemGroup Condition="'$(IsTerraBaseArea)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsDashboardArea)' == 'true' and '$(MSBuildProjectName)' != 'TerraScale.Dashboard.Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/TerraScale.Dashboard.Analyzers/TerraScale.Dashboard.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- TerraBase integration suites (Fast and Slow): TUnit executables driving the real server. -->
  <PropertyGroup Condition="'$(IsTerraBaseArea)' == 'true' and '$(IsTestProject)' == 'true'">
    <!-- Server GC, unlike the production server (one host per 512 MB machine): one test process runs up to 16 hosts at
         once, and workstation GC ran 15x more collections there, adding 42 s of pauses to a 136 s Fast run. Nothing in
         TerraBase depends on the GC mode; the memory budget reads TotalAvailableMemoryBytes, the same in both. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- Tiered PGO instrumentation costs the suite about 28% of its CPU: 15m34s to 11m12s of user time on the same binary. -->
    <TieredPGO>false</TieredPGO>
    <!-- CA1515: TUnit discovers public test classes. CA1707: test names use
         underscores as sentence separators. CA2007: tests have no synchronization
         context to capture. CS1591: tests are not a public API. -->
    <NoWarn>$(NoWarn);CA1515;CA1707;CA2007;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTerraBaseArea)' == 'true' and '$(IsTestProject)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/TerraBase/TerraBase.csproj" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- Starts the top-level Program on real Kestrel listeners (WebApplicationFactory.UseKestrel). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Shared harness source; deliberately not a third test project. -->
    <Compile Include="$(MSBuildThisFileDirectory)tests/TerraBase.TestHarness/**/*.cs" Link="TestHarness/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Every test starts its own host, and DI's dynamic engine compiles IL resolvers per host that the finalizer thread
         then tears down: about 13% of the suite's CPU. The reflection engine resolves the same graph. -->
    <RuntimeHostConfigurationOption Include="Microsoft.Extensions.DependencyInjection.DisableDynamicEngine" Value="true" />
  </ItemGroup>
</Project>
