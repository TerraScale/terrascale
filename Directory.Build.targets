<Project>
  <!-- Imported after every project file, so these rules can key on properties the
       projects set (UseTerraScaleEndpoints, IsTestProject). -->

  <!-- TerraScale.Endpoints, the ts-libs package (its analyzer does the compile-time endpoint
       registration): opt in with <UseTerraScaleEndpoints>true</UseTerraScaleEndpoints>. -->
  <ItemGroup Condition="'$(UseTerraScaleEndpoints)' == 'true'">
    <PackageReference Include="TerraScale.Endpoints" />
  </ItemGroup>

  <!-- Newtonsoft.Json is not allowed: System.Text.Json (source-generated) only.
       BannedSymbols.txt blocks its APIs in code; this blocks every Newtonsoft
       package, direct or transitive, from entering the build. -->
  <Target Name="BanNewtonsoftJsonPackages" AfterTargets="ResolvePackageAssets" Condition="'@(PackageDependencies)' != '' or '@(PackageReference)' != ''">
    <ItemGroup>
      <_NewtonsoftPackage Include="@(PackageReference)" Condition="$([System.String]::Copy('%(Identity)').Contains('Newtonsoft', System.StringComparison.OrdinalIgnoreCase))" />
      <_NewtonsoftPackage Include="@(RuntimeCopyLocalItems->'%(NuGetPackageId)')" Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.NuGetPackageId)').Contains('Newtonsoft', System.StringComparison.OrdinalIgnoreCase))" />
      <_NewtonsoftPackage Include="@(ResolvedCompileFileDefinitions->'%(NuGetPackageId)')" Condition="$([System.String]::Copy('%(ResolvedCompileFileDefinitions.NuGetPackageId)').Contains('Newtonsoft', System.StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
    <Error Condition="'@(_NewtonsoftPackage)' != ''" Text="Newtonsoft packages are banned in TerraBase ('@(_NewtonsoftPackage->Distinct())'). Use System.Text.Json; remove the package or the dependency that brings it in." />
  </Target>

  <!-- Integration suites (Fast and Slow): TUnit executables driving the real server. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <!-- The real server uses server GC; the parallel in-process hosts must use the same runtime mode. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- CA1515: TUnit discovers public test classes. CA1707: test names use
         underscores as sentence separators. CA2007: tests have no synchronization
         context to capture. CS1591: tests are not a public API. -->
    <NoWarn>$(NoWarn);CA1515;CA1707;CA2007;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/TerraScale.TerraBase/TerraScale.TerraBase.csproj" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Bogus" />
    <!-- Starts the top-level Program on real Kestrel listeners (WebApplicationFactory.UseKestrel). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Shared harness source; deliberately not a third test project. -->
    <Compile Include="$(MSBuildThisFileDirectory)src/Tests/TestHarness/**/*.cs" Link="TestHarness/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
