<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>TerraScale.Endpoints</RootNamespace>
    <PackageId>TerraScale.Endpoints</PackageId>
    <Description>Shared TerraScale endpoint authoring and ASP.NET Core mapping library.</Description>
    <!-- net10.0 so ts-auth (net10.0) and TerraBase (net11.0) both consume it. -->
    <TargetFramework />
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- Stable calendar versions while it depends on the prerelease Microsoft.AspNetCore.OpenApi 11 rc; drop when that ships stable. -->
    <!-- ASP0029: the validation API used by AddValidation() is marked experimental in the net10.0 pack. -->
    <NoWarn>$(NoWarn);NU5104;ASP0029</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageProjectUrl>https://git.terrascale.tech/TerraScale/ts-libs</PackageProjectUrl>
    <RepositoryUrl>https://git.terrascale.tech/TerraScale/ts-libs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>terrascale;aspnetcore;endpoints;openapi</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build the generator first and ship it in analyzers/ so consumers get compile-time registration. -->
    <ProjectReference Include="../TerraScale.Endpoints.Generators/TerraScale.Endpoints.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../TerraScale.Endpoints.Generators/bin/$(Configuration)/netstandard2.0/TerraScale.Endpoints.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
