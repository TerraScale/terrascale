<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>TerraScale.Authentication</RootNamespace>
    <AssemblyName>ts-auth</AssemblyName>
    <Version>0.1.0-alpha</Version>
    <!-- /healthz reports "<version>+<revision>"; CI passes TS_AUTH_REVISION. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion Condition="'$(TS_AUTH_REVISION)' != ''">$(Version)+$(TS_AUTH_REVISION)</InformationalVersion>
    <UserSecretsId />
    <!-- Tiered PGO: on 2 shared vCPUs it costs +12% JIT time and leaves time to ready unchanged (docs/fly/spike-1a.md);
         TS-607's 2x JIT cost was on 1 vCPU. -->
    <TieredPGO>true</TieredPGO>
    <!-- ReadyToRun precompiles on publish for a faster cold start; hot methods still tier up on the JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Workstation GC: a 512 MB machine gets no per-core server heaps; concurrent marking keeps pauses short. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- TerraScale.Endpoints (src/TerraScale.Endpoints) and its generator, referenced by Directory.Build.targets. -->
    <UseTerraScaleEndpoints>true</UseTerraScaleEndpoints>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerraScale.Authentication.Fast" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TerraScale.Authentication.Contracts/TerraScale.Authentication.Contracts.csproj" />
    <ProjectReference Include="../TerraScale.Authentication.Security/TerraScale.Authentication.Security.csproj" />
    <ProjectReference Include="../TerraScale.Authentication.Store/TerraScale.Authentication.Store.csproj" />
    <ProjectReference Include="../TerraScale.Logging/TerraScale.Logging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Direct references pin newer patches than the TerraScale packages' own central versions. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="RazorSlices" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="ZLogger" />
    <PackageReference Include="ZString" />
    <PackageReference Include="Sentry.AspNetCore" />
    <!-- Only the server stack: the OpenIddict.AspNetCore metapackage also brings the unused client and
         validation HTTP stacks, whose Microsoft.Extensions.Telemetry dependency reorders log state, which
         SafeLogging renders positionally. -->
    <PackageReference Include="OpenIddict.Core" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" />
    <PackageReference Include="Otp.NET" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/admin/admin.css" LogicalName="assets/admin/admin.css" />
    <EmbeddedResource Include="Assets/admin/datastar.js" LogicalName="assets/admin/datastar.js" />
    <EmbeddedResource Include="Assets/admin/logo.svg" LogicalName="assets/admin/logo.svg" />
    <EmbeddedResource Include="Assets/admin/logo-icon-blue.svg" LogicalName="assets/admin/logo-icon-blue.svg" />
    <EmbeddedResource Include="Assets/email/logo.png" LogicalName="assets/email/logo.png" />
    <EmbeddedResource Include="Assets/email/logo-dark.png" LogicalName="assets/email/logo-dark.png" />
    <EmbeddedResource Include="Assets/fonts/oxanium-latin-wght-normal.woff2" LogicalName="assets/fonts/oxanium-latin-wght-normal.woff2" />
    <EmbeddedResource Include="Assets/fonts/jetbrains-mono-latin-wght-normal.woff2" LogicalName="assets/fonts/jetbrains-mono-latin-wght-normal.woff2" />
    <EmbeddedResource Include="Assets/fonts/Geist-Variable.woff2" LogicalName="assets/fonts/Geist-Variable.woff2" />
  </ItemGroup>
</Project>
