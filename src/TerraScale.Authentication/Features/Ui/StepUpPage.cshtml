@inherits RazorSlice<StepUpPageModel>
@implements IUsesLayout<HostedLayout, HostedLayoutModel>
<div class="head"><h1>@Model.Operation</h1></div>
<div class="chip"><svg class="icon icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-mail"></use></svg><span>@Model.Email</span></div>
@if (Model.Notice is { } notice)
{
<p role="status">@notice</p>
}
<form method="post" action="/ui/terrascale/step-up/@Model.Id">
@if (Model.Mfa)
{
<div class="field"><label for="code">Authenticator or recovery code</label><input id="code" name="code" autocomplete="one-time-code" maxlength="32" required autofocus></div>
<button type="submit">Verify and continue</button>
}
else if (Model.Password)
{
<div class="field"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required autofocus></div>
<button type="submit">Verify and continue</button>
}
else if (Model.MailRequested)
{
<div class="field"><label for="code">Email verification code</label><input id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" maxlength="6" required autofocus></div>
<button type="submit">Verify and continue</button>
}
else
{
<button type="submit" name="action" value="send">Email me a code</button>
}
</form>
@functions {
    /// <inheritdoc />
    public HostedLayoutModel LayoutModel => new(Model.Operation, Model.Nonce);
}
