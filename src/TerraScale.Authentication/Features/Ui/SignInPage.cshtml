@inherits RazorSlice<SignInPageModel>
@using TerraScale.Authentication.Features.AttackProtection
@inject TurnstileKeys Turnstile
@implements IUsesLayout<HostedLayout, HostedLayoutModel>
<div class="head">
<h1>@Model.Title</h1>
@switch (Model.Step)
{
case SignInStep.Code:
case SignInStep.EnrollmentInbox:
@if (Model.CodeBudgetExhausted)
{
<p class="sub">@WriteHtml(Model.Sub(Model.Copy.SubNoNewCode))</p>
}
else if (Model.Limited)
{
<p class="sub">@WriteHtml(Model.Sub(Model.Copy.SubLimited))</p>
}
else
{
<p class="sub">@WriteHtml(Model.Sub(Model.Copy.SubCodeSent))</p>
}
@if (Model.Step == SignInStep.Code)
{
<p class="sub">@Model.Copy.SubRecoverySignsOut</p>
}
break;
case SignInStep.SignOutConfirm:
<p class="sub">@WriteHtml(Model.SubBrand(Model.Copy.SubSignOutAsked))</p>
break;
case SignInStep.SignUpCode:
@if (Model.CodeBudgetExhausted)
{
<p class="sub">@WriteHtml(Model.Sub(Model.Copy.SubNoNewCode))</p>
}
else
{
<p class="sub">@WriteHtml(Model.Sub(Model.Copy.SubSignUpCodeSent))</p>
}
<p class="sub">@Model.Copy.SubSignUpRecovery</p>
break;
case SignInStep.ResetCode:
@if (Model.CodeBudgetExhausted)
{
<p class="sub">@WriteHtml(Model.Sub(Model.Copy.SubNoNewCode))</p>
}
else
{
<p class="sub">@WriteHtml(Model.Sub(Model.Copy.SubCodeSent))</p>
}
break;
case SignInStep.ResetDone:
<p class="sub">@Model.Copy.SubResetDone</p>
break;
case SignInStep.DeviceConfirm:
<p class="sub">@Model.Copy.SubDeviceConfirm</p>
break;
case SignInStep.RecoveryCodes:
<p class="sub">@Model.Copy.SubRecoveryCodes</p>
break;
}
</div>
@if (Model.Notice is { } notice)
{
<div class="alert" data-state="success" role="status"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-circle-check"></use></svg><p>@notice</p></div>
}
@if (Model.Error is { } error)
{
<div class="alert" id="sign-in-error" data-state="@(Model.Limited ? "limited" : "error")" role="alert"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#@(Model.Limited ? "i-clock" : "i-circle-alert")"></use></svg><div>@if (Model.ErrorTitle is { } errorTitle)
{<strong>@errorTitle</strong>}<p>@error</p></div></div>
}
@if (Model.Error is not null || Model.Step is SignInStep.Rejected or SignInStep.NotFound)
{
<p class="hint">@(Model.Copy.RequestIdLabel): @Model.RequestId</p>
}
@if (Model.Slug == TerraScale.Authentication.Features.Oidc.OidcIssuer.InstanceId && Model.Step is SignInStep.Email or SignInStep.SignUp && Model.Theme.Providers is { Count: > 0 } providers)
{
<div class="actions" aria-label="@Model.Copy.SocialAria">
@foreach (var provider in providers)
{
<form method="post" action="/ui/@Model.Slug/social/@provider">
<input type="hidden" name="next" value="@Model.Next">
<button class="secondary" type="submit">@string.Format(CultureInfo.InvariantCulture, Model.Copy.ContinueWith, TerraScale.Authentication.Features.ProjectTenants.SocialProviders.Label(provider))</button>
</form>
}
</div>
<p class="alt">@Model.Copy.OrEmail</p>
}
@switch (Model.Step)
{
case SignInStep.Email:
<form method="post" action="@Model.Link(Model.Theme.Passcode ? "sign-in" : "sign-in/password", form: true)">
@if (Model.Theme.BotChallenge) {
<div class="cf-turnstile" data-sitekey="@Turnstile.SiteKey"></div>
}
<input type="hidden" name="next" value="@Model.Next">
<div class="field">
<label for="sign-in-email">@Model.Copy.Email</label>
<input id="sign-in-email" name="email" type="email" autocomplete="username" placeholder="@Model.Copy.EmailPlaceholder" required minlength="3" maxlength="254" autofocus value="@Model.Email">
</div>
<div class="actions">
@if (Model.Theme.Passcode)
{
<button type="submit">@Model.Copy.EmailCodeButton<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></button>
}
@if (Model.Theme.Password)
{
<button type="submit" class="@(Model.Theme.Passcode ? "secondary" : "")" formaction="@Model.Link("sign-in/password", form: true)"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-key-round"></use></svg>@(Model.Theme.Passcode ? Model.Copy.UsePassword : Model.Copy.ContinuePassword)</button>
}
<button type="button" id="passkey-sign-in" class="secondary" hidden data-i18n="@Model.Copy.PasskeyI18n" data-options="/ui/@Model.Slug/sign-in/passkey/options" data-verify="@Model.Link("sign-in/passkey", form: true)" data-sign-in="@Model.Link("sign-in")"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-lock-keyhole"></use></svg>@Model.Copy.Passkey</button>
</div>
</form>
@if (Model.Slug != TerraScale.Authentication.Features.Oidc.OidcIssuer.InstanceId && Model.Theme.Providers.Count > 0)
{
<div class="actions">
@foreach (var provider in Model.Theme.Providers)
{
<a class="btn secondary" href="@Model.Link("social/" + provider)">@string.Format(CultureInfo.InvariantCulture, Model.Copy.ContinueWith, TerraScale.Authentication.Features.ProjectTenants.SocialProviders.Label(provider))</a>
}
</div>
}
<div class="row">
@if (Model.Theme.Password)
{
<a href="@Model.Link("reset")">@Model.Copy.ForgotPassword</a>
}
@if (Model.Theme.SignUp)
{
<a href="@Model.Link("sign-up")">@Model.Copy.CreateAccount</a>
}
</div>
break;
case SignInStep.Password:
<form method="post" action="@Model.Link("sign-in/password", form: true)">
@if (Model.Theme.BotChallenge) {
<div class="cf-turnstile" data-sitekey="@Turnstile.SiteKey"></div>
}
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
<div class="chip"><svg class="icon icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-mail"></use></svg><span>@Model.Email</span><a href="@Model.Link("sign-in")">@Model.Copy.Change</a></div>
<div class="field">
<div class="row"><label for="sign-in-password">@Model.Copy.Password</label><a href="@Model.Link("reset")">@Model.Copy.ForgotPassword</a></div>
<input id="sign-in-password" name="password" type="password" autocomplete="current-password" required minlength="1" maxlength="1024" autofocus>
</div>
<button type="submit">@Model.Copy.SignIn</button>
</form>
@if (Model.Theme.Passcode)
{
<form method="post" action="@Model.Link("sign-in", form: true)">
@if (Model.Theme.BotChallenge) {
<div class="cf-turnstile" data-sitekey="@Turnstile.SiteKey"></div>
}
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
<button type="submit" class="secondary"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-mail"></use></svg>@Model.Copy.EmailCodeButton</button>
</form>
}
break;
case SignInStep.Code:
case SignInStep.EnrollmentInbox:
<form method="post" action="@Model.Link(Model.Step == SignInStep.EnrollmentInbox ? "mfa/enroll/verify-email" : "sign-in/verify", form: true)">
<input type="hidden" name="challenge" value="@Model.Challenge">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
<div class="field">
<label for="sign-in-code">@Model.Copy.SignInCode</label>
<input id="sign-in-code" class="code" name="code" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" autocomplete="one-time-code" placeholder="······" required autofocus>
</div>
<button type="submit">@Model.Copy.VerifySignIn</button>
</form>
<form method="post" action="@Model.Link(Model.Step == SignInStep.EnrollmentInbox ? "mfa/enroll/email" : "sign-in", form: true)">
<input type="hidden" name="challenge" value="@Model.Challenge">
@if (Model.Theme.BotChallenge) {
<div class="cf-turnstile" data-sitekey="@Turnstile.SiteKey" data-action="sign_in" data-cdata="@Model.Slug"></div>
}
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
@if (Model.CodeBudgetExhausted)
{
<button type="submit" class="secondary" disabled data-wait-seconds="@Model.WaitSeconds" data-wait-format="@Model.Copy.CountdownIn" data-label="@Model.Copy.SendNewCode">@string.Format(CultureInfo.InvariantCulture, Model.Copy.SendNewCodeIn, Model.WaitSeconds)</button>
}
else
{
<button type="submit" class="secondary">@Model.Copy.SendNewCode</button>
}
</form>
<div class="row"><a href="@Model.Link("sign-in")"><svg class="icon icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-left"></use></svg>@Model.Copy.DifferentEmail</a><a href="@Model.Link("sign-up")">@Model.Copy.CreateAccount</a></div>
break;
case SignInStep.Continue:
@if (Model.Refresh is { })
{
<a class="btn delayed-continue" href="@Model.Refresh">@Model.Copy.Continue<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
}
else
{
<a class="btn" data-continue href="@Model.DefaultDestination">@Model.Copy.Continue<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
}
break;
case SignInStep.SignedIn:
<div class="alert" data-state="success" role="status"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-circle-check"></use></svg><p>@Model.Copy.SignedIn</p></div>
<a class="btn" data-continue href="@Model.DefaultDestination">@Model.Copy.Continue<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
break;
case SignInStep.Sso:
@if (Model.Refresh is { })
{
<a class="btn delayed-continue" href="@Model.Refresh">@Model.Copy.Continue<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
}
break;
case SignInStep.SignedOut:
@if (Model.Refresh is { })
{
<a class="btn delayed-continue" href="@Model.Refresh">@Model.Copy.Continue<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
}
else
{
<div class="alert" data-state="success" role="status"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-log-out"></use></svg><p>@Model.Copy.SignedOut</p></div>
<a class="btn" href="@Model.Link("sign-in")">@Model.Copy.SignIn<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
}
break;
case SignInStep.SignOutConfirm:
<form method="post" action="/@Model.Slug/oauth/logout">
@foreach (var field in Model.LogoutFields)
{
<input type="hidden" name="@field.Key" value="@field.Value">
}
<button type="submit" name="confirm" value="1"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-log-out"></use></svg>@Model.Copy.SignOut</button>
</form>
break;
case SignInStep.Rejected:
@if (Model.Detail is { } detail)
{
<p class="hint">@Model.Copy.ErrorCodeLabel @detail</p>
}
<a class="btn" href="@Model.Link("sign-in")">@Model.Copy.BackToSignIn<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
break;
case SignInStep.SignUp:
<form method="post" action="@Model.Link("sign-up", form: true)">
@if (Model.Theme.BotChallenge) {
<div class="cf-turnstile" data-sitekey="@Turnstile.SiteKey"></div>
}
<input type="hidden" name="next" value="@Model.Next">
<div class="field">
<label for="sign-up-email">@Model.Copy.Email</label>
<input id="sign-up-email" name="email" type="email" autocomplete="username" placeholder="@Model.Copy.EmailPlaceholder" required minlength="3" maxlength="254" autofocus value="@Model.Email">
</div>
<div class="field">
<label for="sign-up-password">@Model.Copy.Password</label>
<input id="sign-up-password" name="password" type="password" autocomplete="new-password" minlength="10" maxlength="1024" placeholder="@Model.Copy.NewPasswordPlaceholder" required aria-describedby="@Model.ErrorId">
</div>
<button type="submit">@Model.Copy.CreateAccount</button>
</form>
@if (Model.Slug != TerraScale.Authentication.Features.Oidc.OidcIssuer.InstanceId && Model.Theme.Providers.Count > 0)
{
<div class="actions">
@foreach (var provider in Model.Theme.Providers)
{
<a class="btn secondary" href="@Model.Link("social/" + provider)">@string.Format(CultureInfo.InvariantCulture, Model.Copy.ContinueWith, TerraScale.Authentication.Features.ProjectTenants.SocialProviders.Label(provider))</a>
}
</div>
}
<p class="alt"><a href="@Model.Link("sign-in")">@Model.Copy.SignIn</a></p>
break;
case SignInStep.SignUpCode:
<form method="post" action="@Model.Link("sign-up/verify", form: true)">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
<input type="hidden" name="pending_token" value="@Model.PendingToken">
<div class="field">
<label for="sign-up-code">@Model.Copy.VerificationCode</label>
<input id="sign-up-code" class="code" name="code" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" autocomplete="one-time-code" placeholder="······" required autofocus>
</div>
<button type="submit">@Model.Copy.VerifyEmail</button>
</form>
<form method="post" action="@Model.Link("sign-up/resend", form: true)">
@if (Model.Theme.BotChallenge) {
<div class="cf-turnstile" data-sitekey="@Turnstile.SiteKey"></div>
}
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
<input type="hidden" name="pending_token" value="@Model.PendingToken">
@if (Model.CodeBudgetExhausted)
{
<button type="submit" class="secondary" disabled data-wait-seconds="@Model.WaitSeconds" data-wait-format="@Model.Copy.CountdownIn" data-label="@Model.Copy.ResendCode">@string.Format(CultureInfo.InvariantCulture, Model.Copy.ResendCodeIn, Model.WaitSeconds)</button>
}
else
{
<button type="submit" class="secondary"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-mail"></use></svg>@Model.Copy.ResendCode</button>
}
</form>
<div class="row"><a href="@Model.Link("sign-up")"><svg class="icon icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-left"></use></svg>@Model.Copy.ChangeEmail</a></div>
break;
case SignInStep.Reset:
<form method="post" action="@Model.Link("reset", form: true)">
@if (Model.Theme.BotChallenge) {
<div class="cf-turnstile" data-sitekey="@Turnstile.SiteKey"></div>
}
<input type="hidden" name="next" value="@Model.Next">
<div class="field">
<label for="reset-email">@Model.Copy.Email</label>
<input id="reset-email" name="email" type="email" autocomplete="username" placeholder="@Model.Copy.EmailPlaceholder" required minlength="3" maxlength="254" autofocus value="@Model.Email">
</div>
<button type="submit">@Model.Copy.ResetCodeButton</button>
</form>
<p class="alt"><a href="@Model.Link("sign-in")">@Model.Copy.SignIn</a></p>
break;
case SignInStep.ResetCode:
<form method="post" action="@Model.Link("reset/complete", form: true)">
@if (Model.Theme.BotChallenge) {
<div class="cf-turnstile" data-sitekey="@Turnstile.SiteKey"></div>
}
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
<div class="field">
<label for="reset-code">@Model.Copy.ResetCode</label>
<input id="reset-code" class="code" name="code" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" autocomplete="one-time-code" placeholder="······" required autofocus aria-describedby="@Model.ErrorId">
</div>
<div class="field">
<label for="reset-password">@Model.Copy.NewPassword</label>
<input id="reset-password" name="password" type="password" autocomplete="new-password" minlength="10" maxlength="1024" placeholder="@Model.Copy.NewPasswordPlaceholder" required aria-describedby="@Model.ErrorId">
</div>
<p class="hint">@Model.Copy.SubSettingSignsOut</p>
<button type="submit">@Model.Copy.SetNewPassword</button>
</form>
<form method="post" action="@Model.Link("reset/resend", form: true)">
@if (Model.Theme.BotChallenge) {
<div class="cf-turnstile" data-sitekey="@Turnstile.SiteKey"></div>
}
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
@if (Model.CodeBudgetExhausted)
{
<button type="submit" class="secondary" disabled data-wait-seconds="@Model.WaitSeconds" data-wait-format="@Model.Copy.CountdownIn" data-label="@Model.Copy.SendNewCode">@string.Format(CultureInfo.InvariantCulture, Model.Copy.SendNewCodeIn, Model.WaitSeconds)</button>
}
else
{
<button type="submit" class="secondary"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-mail"></use></svg>@Model.Copy.SendNewCode</button>
}
</form>
<div class="row"><a href="@Model.Link("reset")"><svg class="icon icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-left"></use></svg>@Model.Copy.DifferentEmail</a></div>
break;
case SignInStep.ResetDone:
@if (Model.Refresh is { })
{
<a class="btn delayed-continue" href="@Model.Refresh">@Model.Copy.SignIn<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
}
break;
case SignInStep.DeviceEnter:
<form method="get" action="/ui/@Model.Slug/device">
<div class="field">
<label for="device-code">@Model.Copy.DeviceCodeTerminal</label>
<input id="device-code" class="code" name="user_code" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="32" placeholder="0000-0000-0000" required autofocus value="@Model.UserCode">
</div>
<button type="submit">@Model.Copy.Continue<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></button>
</form>
@if (Model.Account is { } enterAccount)
{
<p class="alt">@Model.Copy.SignedInAs <strong>@enterAccount</strong></p>
}
break;
case SignInStep.DeviceConfirm:
<div class="device-code" aria-label="@Model.Copy.DeviceCodeAria">@Model.UserCode</div>
<dl class="facts">
<div><dt>@Model.Copy.Application</dt><dd>@Model.ClientName</dd></div>
<div><dt>@Model.Copy.Account</dt><dd>@Model.Account</dd></div>
</dl>
@if (Model.Scopes is { Count: > 0 } scopes)
{
<ul class="scopes">@foreach (var scope in scopes) { <li>@scope</li> }</ul>
}
<form method="post" action="/ui/@Model.Slug/device">
<input type="hidden" name="user_code" value="@Model.UserCode">
<div class="actions">
<button type="submit" name="decision" value="approve"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-terminal"></use></svg>@Model.Copy.Approve</button>
<button type="submit" name="decision" value="deny" class="secondary">@Model.Copy.Deny</button>
</div>
</form>
break;
case SignInStep.DeviceApproved:
<div class="alert" data-state="success" role="status"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-circle-check"></use></svg><p>@Model.Copy.DeviceApproved</p></div>
break;
case SignInStep.Mfa:
<form method="post" action="@Model.Link("sign-in/mfa", form: true)">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" id="sign-in-email" name="email" value="@Model.Email">
<input type="hidden" name="challenge" value="@Model.Challenge">
@if (Model.AllowTotp)
{
<div class="field">
<label for="mfa-code">@Model.Copy.AuthOrRecoveryCode</label>
<input id="mfa-code" class="code" name="code" autocomplete="one-time-code" autocapitalize="off" spellcheck="false" maxlength="32" placeholder="······" required autofocus>
</div>
<button type="submit">@Model.Copy.VerifySignIn</button>
}
@if (Model.AllowPasskey)
{
<button type="button" id="passkey-sign-in" class="secondary" hidden data-i18n="@Model.Copy.PasskeyI18n" data-options="/ui/@Model.Slug/sign-in/passkey/options" data-verify="@Model.Link("sign-in/passkey", form: true)" data-sign-in="@Model.Link("sign-in")"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-lock-keyhole"></use></svg>@Model.Copy.Passkey</button>
}
</form>
<div class="row"><a href="@Model.Link("sign-in")"><svg class="icon icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-left"></use></svg>@Model.Copy.StartOver</a></div>
break;
case SignInStep.Security:
<dl class="facts">
<div><dt>@Model.Copy.Account</dt><dd>@Model.Account</dd></div>
<div><dt>@Model.Copy.TitleMfa</dt><dd>@(Model.MfaEnabled ? Model.Copy.MfaOn : Model.Copy.MfaOff)</dd></div>
@if (Model.MfaEnabled)
{
<div><dt>@Model.Copy.RecoveryCodesLeft</dt><dd>@Model.RecoveryRemaining</dd></div>
}
</dl>
@if (Model.AccountUrl is { } securityUrl)
{
<a class="btn secondary" href="@securityUrl"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-left"></use></svg>@Model.Copy.BackToAccount</a>
}
@if (Model.MfaEnabled)
{
<form method="post" action="/ui/@Model.Slug/security/recovery/regenerate">
<input type="hidden" name="next" value="@Model.Next">
<div class="field">
<label for="regenerate-code">@Model.Copy.AuthOrRecoveryCode</label>
<input id="regenerate-code" class="code" name="code" autocomplete="one-time-code" autocapitalize="off" spellcheck="false" maxlength="32" placeholder="······" required>
</div>
<p class="hint">@Model.Copy.HintRegenerate</p>
<button type="submit" class="secondary">@Model.Copy.RegenerateRecovery</button>
</form>
<form method="post" action="/ui/@Model.Slug/security/totp/disable">
<input type="hidden" name="next" value="@Model.Next">
<div class="field">
<label for="disable-code">@Model.Copy.AuthOrRecoveryCode</label>
<input id="disable-code" class="code" name="code" autocomplete="one-time-code" autocapitalize="off" spellcheck="false" maxlength="32" placeholder="······" required>
</div>
<p class="hint">@Model.Copy.HintDisableMfa</p>
<button type="submit" class="secondary">@Model.Copy.TurnOffMfa</button>
</form>
}
else
{
<form method="post" action="/ui/@Model.Slug/security/totp">
<input type="hidden" name="next" value="@Model.Next">
<button type="submit"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-key-round"></use></svg>@Model.Copy.SetUpAuthenticator</button>
</form>
}
@foreach (var identity in Model.LinkedProviders)
{
<form method="post" action="/ui/@Model.Slug/security/social/unlink">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="provider" value="@identity.Provider">
<button type="submit" class="secondary">@Model.Copy.Remove @TerraScale.Authentication.Features.ProjectTenants.SocialProviders.Label(identity.Provider)</button>
</form>
}
@foreach (var provider in Model.ConnectableProviders.Where(name => Model.LinkedProviders.All(identity => identity.Provider != name)))
{
<form method="post" action="/ui/@Model.Slug/security/social/connect">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="provider" value="@provider">
<button type="submit" class="secondary"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg>@string.Format(CultureInfo.InvariantCulture, Model.Copy.ConnectProvider, TerraScale.Authentication.Features.ProjectTenants.SocialProviders.Label(provider))</button>
</form>
}
<dl class="facts" aria-label="@Model.Copy.PasskeysAria">
@if (Model.Passkeys.Count == 0)
{
<div><dt>@Model.Copy.PasskeysAria</dt><dd>@Model.Copy.None</dd></div>
}
</dl>
@foreach (var passkey in Model.Passkeys)
{
<form method="post" action="/ui/@Model.Slug/security/passkeys/rename">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="id" value="@passkey.CredentialId">
<div class="field">
<label for="passkey-name-@passkey.CredentialId">@Model.Copy.PasskeyName</label>
<input id="passkey-name-@passkey.CredentialId" name="name" minlength="1" maxlength="64" autocomplete="off" required value="@passkey.Name">
</div>
<p class="hint">@string.Format(CultureInfo.InvariantCulture, Model.Copy.PasskeyAdded, passkey.CreatedAt.ToString("d", CultureInfo.InvariantCulture)) · @(passkey.LastUsedAt is { } lastUsed ? string.Format(CultureInfo.InvariantCulture, Model.Copy.PasskeyLastUsed, lastUsed.ToString("d", CultureInfo.InvariantCulture)) : Model.Copy.PasskeyNeverUsed)</p>
<button type="submit" class="secondary">@Model.Copy.Rename</button>
</form>
<form method="post" action="/ui/@Model.Slug/security/passkeys/delete">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="id" value="@passkey.CredentialId">
<div class="field">
<label for="passkey-code-@passkey.CredentialId">@Model.Copy.AuthOrRecoveryCode</label>
<input id="passkey-code-@passkey.CredentialId" class="code" name="code" autocomplete="one-time-code" autocapitalize="off" spellcheck="false" maxlength="32" placeholder="······" required>
</div>
<button type="submit" class="secondary">@Model.Copy.Remove</button>
</form>
}
<form id="passkey-add" data-i18n="@Model.Copy.PasskeyI18n" data-options="/ui/@Model.Slug/security/passkeys/options" data-verify="/ui/@Model.Slug/security/passkeys/verify">
<div class="field">
<label for="passkey-name">@Model.Copy.PasskeyName</label>
<input id="passkey-name" name="name" maxlength="100" autocomplete="off" placeholder="YubiKey 5C">
</div>
<button type="submit" class="secondary"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-key-round"></use></svg>@Model.Copy.AddPasskey</button>
</form>
break;
case SignInStep.MfaEnroll:
@if (Model.AllowTotp)
{
<form method="post" action="/ui/@Model.Slug/sign-in/enroll/totp">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="challenge" value="@Model.Challenge">
<button type="submit">@Model.Copy.SetUpAuthenticator</button>
</form>
}
@if (Model.AllowPasskey)
{
<form id="passkey-add" method="post" action="/ui/@Model.Slug/security/passkeys/options" data-i18n="@Model.Copy.PasskeyI18n" data-enrollment="@Model.Challenge" data-complete="@(Model.Next ?? $"/ui/{Model.Slug}/security")" data-options="/ui/@Model.Slug/security/passkeys/options" data-verify="/ui/@Model.Slug/security/passkeys/verify">
<button type="submit" class="secondary">@Model.Copy.AddPasskey</button>
</form>
<a class="btn secondary" href="@Model.Link("sign-in")">@Model.Copy.SignIn</a>
}
break;
case SignInStep.TotpSetup:
<img src="@Model.QrCode" alt="@WriteHtml(Model.SubBrand(Model.Copy.QrAlt))" width="240" height="240">
<dl class="facts"><div><dt>@Model.Copy.SetupKey</dt><dd><code data-mfa-secret>@Model.Secret</code></dd></div></dl>
<form method="post" action="@(Model.Challenge is null ? $"/ui/{Model.Slug}/security/totp/confirm" : $"/ui/{Model.Slug}/sign-in/enroll/totp/confirm")">
<input type="hidden" name="challenge" value="@Model.Challenge">
<input type="hidden" name="next" value="@Model.Next">
<div class="field">
<label for="totp-code">@Model.Copy.CodeFromApp</label>
<input id="totp-code" class="code" name="code" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" autocomplete="one-time-code" placeholder="······" required autofocus>
</div>
<p class="hint">@Model.Copy.HintEnableMfa</p>
<button type="submit">@Model.Copy.TurnOnMfa</button>
</form>
<div class="row"><a href="/ui/@Model.Slug/security"><svg class="icon icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-left"></use></svg>@Model.Copy.Cancel</a></div>
break;
case SignInStep.RecoveryCodes:
<ul class="facts" aria-label="@Model.Copy.RecoveryCodesAria">
@foreach (var recovery in Model.RecoveryCodes)
{
<li><code data-mfa-secret>@recovery</code></li>
}
</ul>
<a class="btn" href="@(Model.Next ?? $"/ui/{Model.Slug}/security")">@Model.Copy.ISavedThem<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
@if (Model.AccountUrl is { } savedUrl)
{
<a class="btn secondary" href="@savedUrl"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-left"></use></svg>@Model.Copy.BackToAccount</a>
}
break;
case SignInStep.Reauthenticate:
<a class="btn" href="@Model.Link("sign-in")">@Model.Copy.SignIn<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
break;
case SignInStep.DeviceDenied:
<div class="alert" role="status"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-circle-x"></use></svg><p>@Model.Copy.DeviceDenied</p></div>
break;
case SignInStep.NotFound:
<a class="btn" href="@Model.Link("sign-in")">@Model.Copy.SignIn<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
break;
}
@functions {
    public HostedLayoutModel LayoutModel => new(Model.Title, Model.Nonce, Model.Theme.ThemeColor, Model.Theme.LogoUrl, Model.Theme.Name,
        Model.Theme.TitleSize, Model.Theme.FooterLinks?.Select(link => (link.Label, link.Url)).ToArray(), Model.Theme.DefaultTheme, Model.Slug,
        Model.Theme.BackgroundColor, Model.Theme.TextColor, Model.Locale) { PublicOrigin = Model.PublicOrigin, ContinueOnly = Model.Refresh is not null };

    protected override Task ExecuteSectionAsync(string name)
    {
        if (name == "head" && Model.Refresh is { } refresh)
        {
            WriteLiteral("<meta http-equiv=\"refresh\" content=\"0;url=");
            Write(refresh);
            WriteLiteral("\">");
        }

        return Task.CompletedTask;
    }
}
