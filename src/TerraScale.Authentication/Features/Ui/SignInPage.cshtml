@inherits RazorSlice<SignInPageModel>
@implements IUsesLayout<HostedLayout, HostedLayoutModel>
<div class="head">
<h1>@Model.Heading</h1>
@switch (Model.Step)
{
case SignInStep.Email:
<p class="sub">Welcome back. Use the email you signed up with.</p>
break;
case SignInStep.Password:
<p class="sub">@(Model.Theme.Passcode ? "Or get a one-time code by email." : "Use the password for your account.")</p>
break;
case SignInStep.Code:
@if (Model.Limited)
{
<p class="sub">This request sent no new code. If you already received a sign-in code for <strong>@Model.Email</strong>, enter it below.</p>
}
else
{
<p class="sub">If an account exists for <strong>@Model.Email</strong>, we emailed it a six-digit code. It expires in 10 minutes.</p>
}
<p class="sub">If this code recovers access after repeated requests, using it signs out your older sessions.</p>
break;
case SignInStep.Continue:
<p class="sub">Returning to the application…</p>
break;
case SignInStep.SignedIn:
<p class="sub">You can close this page.</p>
break;
case SignInStep.SignedOut:
<p class="sub">@(Model.ReturnTo is null ? "You can close this page." : "Returning to the application…")</p>
break;
case SignInStep.Rejected:
<p class="sub">Start again from the application you were signing in to.</p>
break;
case SignInStep.SignUp:
<p class="sub">Get started with @Model.Brand in under a minute.</p>
break;
case SignInStep.SignUpCode:
<p class="sub">We emailed a six-digit code to <strong>@Model.Email</strong>. It expires in 10 minutes.</p>
<p class="sub">For an existing account, recovery after repeated code requests signs out your older sessions.</p>
break;
case SignInStep.Reset:
<p class="sub">Enter your account email and we will send you a reset code.</p>
break;
case SignInStep.ResetCode:
<p class="sub">If an account exists for <strong>@Model.Email</strong>, we emailed it a six-digit code. It expires in 10 minutes.</p>
break;
case SignInStep.ResetDone:
<p class="sub">You were signed out everywhere. Sign in with your new password.</p>
break;
case SignInStep.DeviceEnter:
<p class="sub">Enter the code shown in your terminal.</p>
break;
case SignInStep.DeviceConfirm:
<p class="sub">Approve only if you started this sign-in from <strong>@Model.ClientName</strong> and the code matches your device.</p>
break;
case SignInStep.DeviceApproved:
<p class="sub">The device is signed in. You can close this page and return to your application.</p>
break;
case SignInStep.DeviceDenied:
<p class="sub">The device was not signed in. You can close this page.</p>
break;
case SignInStep.NotFound:
<p class="sub">The page you opened doesn't exist. Check the link, or sign in again.</p>
break;
case SignInStep.Sso:
<p class="sub">Your organization signs in <strong>@Model.Email</strong> through its identity provider.</p>
break;
case SignInStep.Mfa:
<p class="sub">Enter the code from your authenticator app for <strong>@Model.Email</strong>.</p>
break;
case SignInStep.Security:
<p class="sub">Protect <strong>@Model.Account</strong> with an authenticator app. Sign-ins then ask for its code after your email code or password.</p>
break;
case SignInStep.TotpSetup:
<p class="sub">Scan this QR code with an authenticator app such as 1Password, Google Authenticator or Authy, then enter the six-digit code it shows.</p>
break;
case SignInStep.RecoveryCodes:
<p class="sub">Two-factor authentication is on. Each recovery code signs you in once if you lose your authenticator. They are shown only now.</p>
break;
case SignInStep.Reauthenticate:
<p class="sub">Changing two-factor authentication needs a sign-in from the last 15 minutes.</p>
break;
}
</div>
@if (Model.Notice is { } notice)
{
<div class="alert" data-state="success" role="status"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-circle-check"></use></svg><p>@notice</p></div>
}
@if (Model.Error is { } error)
{
<div class="alert" data-state="@(Model.Limited ? "limited" : "error")" role="alert"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#@(Model.Limited ? "i-clock" : "i-circle-alert")"></use></svg><div>@if (Model.ErrorTitle is { } errorTitle)
{<strong>@errorTitle</strong>}<p id="form-error">@error</p></div></div>
}
@if (Model.RetryAt is { } retryAt)
{
<p id="retry-hint" class="hint" role="status">Try again at <time datetime="@retryAt.ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@retryAt.ToString("HH:mm:ss 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</time>. If sign-in expires while waiting, start again.</p>
<p class="hint" data-retry-seconds="@Model.RetrySeconds" aria-live="off"></p>
}
@if (Model.Step is SignInStep.Code or SignInStep.SignUpCode or SignInStep.ResetCode)
{
<p id="resend-hint" class="hint">Wait at least 60 seconds before requesting another code. Request limits still apply.
@if (Model.ResendAt is { } resendAt)
{
<span>Request another code after <time datetime="@resendAt.ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@resendAt.ToString("HH:mm:ss 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</time>.</span>
<span data-retry-seconds="@TerraScale.Authentication.Features.SignIn.HostedAuth.MailCooldown.TotalSeconds" aria-live="off"></span>
}
</p>
}
<p id="submission-status" class="hint" role="status" aria-live="polite"></p>
@if (Model.Slug == TerraScale.Authentication.Features.Oidc.OidcIssuer.InstanceId && Model.Step is SignInStep.Email or SignInStep.SignUp && Model.Theme.Providers is { Count: > 0 } providers)
{
<div class="actions" aria-label="Social sign-in">
@foreach (var provider in providers)
{
<form id="social-@provider" name="social-@provider" method="post" action="/ui/@Model.Slug/social/@provider">
<input type="hidden" name="next" value="@Model.Next">
<button class="secondary" type="submit">Continue with @TerraScale.Authentication.Features.ProjectTenants.SocialProviders.Label(provider)</button>
</form>
}
</div>
<p class="alt">or continue with email</p>
}
@switch (Model.Step)
{
case SignInStep.Email:
<form id="sign-in-email-form" name="sign-in-email-form" method="post" action="/ui/@Model.Slug/sign-in@(Model.Theme.Passcode ? "" : "/password")">
<input type="hidden" name="next" value="@Model.Next">
<div class="field">
<label for="sign-in-email">Email</label>
<input id="sign-in-email" name="email" type="email" autocomplete="username" placeholder="you@company.com" required autofocus value="@Model.Email" aria-describedby="@(Model.Error is null ? null : "form-error")">
</div>
<div class="actions">
@if (Model.Theme.Passcode)
{
<button type="submit">Email me a sign-in code<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></button>
}
@if (Model.Theme.Password)
{
<button type="submit" class="@(Model.Theme.Passcode ? "secondary" : "")" formaction="/ui/@Model.Slug/sign-in/password"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-key-round"></use></svg>@(Model.Theme.Passcode ? "Use a password instead" : "Continue with a password")</button>
}
</div>
</form>
@if (Model.Slug != TerraScale.Authentication.Features.Oidc.OidcIssuer.InstanceId && Model.Theme.Providers.Count > 0)
{
<div class="actions">
@foreach (var provider in Model.Theme.Providers)
{
<a class="btn secondary" href="@Model.Link("social/" + provider)">Continue with @TerraScale.Authentication.Features.ProjectTenants.SocialProviders.Label(provider)</a>
}
</div>
}
<div class="row">
@if (Model.Theme.Password)
{
<a href="@Model.Link("reset")">Forgot password?</a>
}
@if (Model.Theme.SignUp)
{
<span class="alt">New here? <a href="@Model.Link("sign-up")">Create account</a></span>
}
</div>
break;
case SignInStep.Password:
<form id="sign-in-password-form" name="sign-in-password-form" method="post" action="/ui/@Model.Slug/sign-in/password">
<input type="hidden" name="next" value="@Model.Next">
<input id="sign-in-username" type="hidden" name="email" autocomplete="username" value="@Model.Email">
<div class="chip"><svg class="icon icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-mail"></use></svg><span>@Model.Email</span><a href="@Model.Link("sign-in")">Change</a></div>
<div class="field">
<label for="sign-in-password">Password <a href="@Model.Link("reset")">Forgot password?</a></label>
<input id="sign-in-password" name="password" type="password" autocomplete="current-password" required autofocus aria-describedby="@(Model.Error is null ? null : "form-error")">
</div>
<button type="submit">Sign in</button>
</form>
@if (Model.Theme.Passcode)
{
<form id="sign-in-password-resend-form" name="sign-in-password-resend-form" method="post" action="/ui/@Model.Slug/sign-in">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
<button type="submit" class="secondary"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-mail"></use></svg>Email me a sign-in code</button>
</form>
}
break;
case SignInStep.Code:
<form id="sign-in-code-form" name="sign-in-code-form" method="post" action="/ui/@Model.Slug/sign-in/verify">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
<div class="field">
<label for="sign-in-code">Sign-in code</label>
<input id="sign-in-code" class="code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="······" required autofocus aria-describedby="@(Model.Error is null ? null : "form-error")">
</div>
<button type="submit">Verify and sign in</button>
</form>
<form id="sign-in-code-resend-form" name="sign-in-code-resend-form" method="post" action="/ui/@Model.Slug/sign-in">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
<input type="hidden" name="resend" value="true">
<button type="submit" class="secondary" aria-describedby="resend-hint">Send a new code</button>
</form>
<div class="row"><a href="@Model.Link("sign-in")"><svg class="icon icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-left"></use></svg>Different email</a></div>
break;
case SignInStep.Continue:
<a class="btn" href="@Model.Next">Continue<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
break;
case SignInStep.SignedIn:
<div class="alert" data-state="success" role="status"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-circle-check"></use></svg><p>You are signed in.</p></div>
break;
case SignInStep.Sso:
<a class="btn" href="@Model.SsoUrl">Continue with single sign-on<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
<div class="row"><a href="@Model.Link("sign-in")"><svg class="icon icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-left"></use></svg>Different email</a></div>
break;
case SignInStep.SignedOut:
<div class="alert" data-state="success" role="status"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-log-out"></use></svg><p>You are signed out.</p></div>
@if (Model.ReturnTo is { } returnTo)
{
<a class="btn" href="@returnTo">Continue<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
}
break;
case SignInStep.Rejected:
@if (Model.Detail is { } detail)
{
<p class="hint">Error code: @detail</p>
}
<a class="btn" href="@Model.Link("sign-in")">Back to sign in<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
break;
case SignInStep.SignUp:
<form id="sign-up-form" name="sign-up-form" method="post" action="/ui/@Model.Slug/sign-up">
<input type="hidden" name="next" value="@Model.Next">
<div class="field">
<label for="sign-up-email">Email</label>
<input id="sign-up-email" name="email" type="email" autocomplete="username" placeholder="you@company.com" required autofocus value="@Model.Email" aria-describedby="@(Model.Error is null ? null : "form-error")">
</div>
<div class="field">
<label for="sign-up-password">Password</label>
<input id="sign-up-password" name="password" type="password" autocomplete="new-password" minlength="8" required aria-describedby="password-requirements @(Model.Error is null ? null : "form-error")">
<span id="password-requirements" class="hint">At least 8 characters.</span>
</div>
<button type="submit">Create account</button>
</form>
@if (Model.Slug != TerraScale.Authentication.Features.Oidc.OidcIssuer.InstanceId && Model.Theme.Providers.Count > 0)
{
<div class="actions">
@foreach (var provider in Model.Theme.Providers)
{
<a class="btn secondary" href="@Model.Link("social/" + provider)">Continue with @TerraScale.Authentication.Features.ProjectTenants.SocialProviders.Label(provider)</a>
}
</div>
}
<p class="alt">Already have an account? <a href="@Model.Link("sign-in")">Sign in</a></p>
break;
case SignInStep.SignUpCode:
<form id="sign-up-code-form" name="sign-up-code-form" method="post" action="/ui/@Model.Slug/sign-up/verify">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
<input type="hidden" name="pending_token" value="@Model.PendingToken">
<div class="field">
<label for="sign-up-code">Verification code</label>
<input id="sign-up-code" class="code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="······" required autofocus aria-describedby="@(Model.Error is null ? null : "form-error")">
</div>
<button type="submit">Verify email</button>
</form>
<form id="sign-up-code-resend-form" name="sign-up-code-resend-form" method="post" action="/ui/@Model.Slug/sign-up/resend">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
<input type="hidden" name="pending_token" value="@Model.PendingToken">
<input type="hidden" name="resend" value="true">
<button type="submit" class="secondary" aria-describedby="resend-hint">Send a new code</button>
</form>
<div class="row"><a href="@Model.Link("sign-up")"><svg class="icon icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-left"></use></svg>Change email</a></div>
break;
case SignInStep.Reset:
<form id="reset-form" name="reset-form" method="post" action="/ui/@Model.Slug/reset">
<input type="hidden" name="next" value="@Model.Next">
<div class="field">
<label for="reset-email">Email</label>
<input id="reset-email" name="email" type="email" autocomplete="username" placeholder="you@company.com" required autofocus value="@Model.Email" aria-describedby="@(Model.Error is null ? null : "form-error")">
</div>
<button type="submit">Email me a reset code</button>
</form>
<p class="alt">Remembered it? <a href="@Model.Link("sign-in")">Sign in</a></p>
break;
case SignInStep.ResetCode:
<form id="reset-code-form" name="reset-code-form" method="post" action="/ui/@Model.Slug/reset/complete">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
<div class="field">
<label for="reset-code">Reset code</label>
<input id="reset-code" class="code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="······" required autofocus aria-describedby="@(Model.Error is null ? null : "form-error")">
</div>
<div class="field">
<label for="reset-password">New password</label>
<input id="reset-password" name="password" type="password" autocomplete="new-password" minlength="8" required aria-describedby="password-requirements @(Model.Error is null ? null : "form-error")">
<span id="password-requirements" class="hint">At least 8 characters. Every session ends when it changes.</span>
</div>
<button type="submit">Set new password</button>
</form>
<form id="reset-code-resend-form" name="reset-code-resend-form" method="post" action="/ui/@Model.Slug/reset">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
<input type="hidden" name="resend" value="true">
<button type="submit" class="secondary" aria-describedby="resend-hint">Send a new code</button>
</form>
<div class="row"><a href="@Model.Link("reset")"><svg class="icon icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-left"></use></svg>Different email</a></div>
break;
case SignInStep.ResetDone:
<a class="btn" href="@Model.Link("sign-in")">Sign in<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
break;
case SignInStep.DeviceEnter:
<form id="device-entry-form" name="device-entry-form" method="get" action="/ui/@Model.Slug/device">
<div class="field">
<label for="device-code">Device code</label>
<input id="device-code" class="code" name="user_code" autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" maxlength="32" placeholder="0000-0000-0000" required autofocus value="@Model.UserCode" aria-describedby="@(Model.Error is null ? null : "form-error")">
</div>
<button type="submit">Continue<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></button>
</form>
@if (Model.Account is { } enterAccount)
{
<p class="alt">Signed in as <strong>@enterAccount</strong></p>
}
break;
case SignInStep.DeviceConfirm:
<div class="device-code" aria-label="Device code">@Model.UserCode</div>
<dl class="facts">
<div><dt>Application</dt><dd>@Model.ClientName</dd></div>
<div><dt>Account</dt><dd>@Model.Account</dd></div>
</dl>
<p id="device-permissions">Requested permissions</p>
<ul aria-labelledby="device-permissions">
@foreach (var permission in Model.RequestedPermissions)
{
<li>@permission</li>
}
</ul>
<form id="device-consent-form" name="device-consent-form" method="post" action="/ui/@Model.Slug/device">
<input type="hidden" name="user_code" value="@Model.UserCode">
<div class="actions">
<button type="submit" name="decision" value="approve"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-terminal"></use></svg>Approve</button>
<button type="submit" name="decision" value="deny" class="secondary">Deny</button>
</div>
</form>
break;
case SignInStep.DeviceApproved:
<div class="alert" data-state="success" role="status"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-circle-check"></use></svg><p>Device approved.</p></div>
break;
case SignInStep.Mfa:
<form id="mfa-form" name="mfa-form" method="post" action="/ui/@Model.Slug/sign-in/mfa">
<input type="hidden" name="next" value="@Model.Next">
<input type="hidden" name="email" value="@Model.Email">
<input type="hidden" name="challenge" value="@Model.Challenge">
<div class="field">
<label for="mfa-code">Authentication code</label>
<input id="mfa-code" class="code" name="code" autocomplete="one-time-code" autocapitalize="off" spellcheck="false" maxlength="32" placeholder="······" required autofocus aria-describedby="mfa-hint @(Model.Error is null ? null : "form-error") @(Model.RetryAt is null ? null : "retry-hint")">
<span id="mfa-hint" class="hint">Lost your authenticator? Enter one of your recovery codes instead.</span>
</div>
<button type="submit">Verify and sign in</button>
</form>
<div class="row"><a href="@Model.Link("sign-in")"><svg class="icon icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-left"></use></svg>Start over</a></div>
break;
case SignInStep.Security:
<dl class="facts">
<div><dt>Account</dt><dd>@Model.Account</dd></div>
<div><dt>Two-factor authentication</dt><dd>@(Model.MfaEnabled ? "On (authenticator app)" : "Off")</dd></div>
@if (Model.MfaEnabled)
{
<div><dt>Recovery codes left</dt><dd>@Model.RecoveryRemaining</dd></div>
}
</dl>
@if (Model.MfaEnabled)
{
<form id="security-form" name="security-form" method="post" action="/ui/@Model.Slug/security/totp/disable">
<input type="hidden" name="next" value="@Model.Next">
<div class="field">
<label for="disable-code">Code to turn off two-factor</label>
<input id="disable-code" class="code" name="code" autocomplete="one-time-code" autocapitalize="off" spellcheck="false" maxlength="32" placeholder="······" required aria-describedby="@(Model.Error is null ? null : "form-error")">
<span class="hint">Your authenticator's current code or an unused recovery code. Every session signs out.</span>
</div>
<button type="submit" class="secondary">Turn off two-factor authentication</button>
</form>
}
else
{
<form id="security-resend-form" name="security-resend-form" method="post" action="/ui/@Model.Slug/security/totp">
<input type="hidden" name="next" value="@Model.Next">
<button type="submit"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-key-round"></use></svg>Set up an authenticator app</button>
</form>
}
break;
case SignInStep.TotpSetup:
<img src="@Model.QrCode" alt="QR code to add TerraScale to your authenticator app" width="240" height="240">
<p class="hint">Can't scan it? Enter this key: <code>@Model.Secret</code></p>
<form id="totp-setup-form" name="totp-setup-form" method="post" action="/ui/@Model.Slug/security/totp/confirm">
<input type="hidden" name="next" value="@Model.Next">
<div class="field">
<label for="totp-code">Code from the app</label>
<input id="totp-code" class="code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="······" required autofocus aria-describedby="@(Model.Error is null ? null : "form-error")">
<span class="hint">Turning it on signs you out everywhere else.</span>
</div>
<button type="submit">Turn on two-factor authentication</button>
</form>
<div class="row"><a href="@Model.Link("security")"><svg class="icon icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-left"></use></svg>Cancel</a></div>
break;
case SignInStep.RecoveryCodes:
<ul class="facts" aria-label="Recovery codes">
@foreach (var recovery in Model.RecoveryCodes)
{
<li><code>@recovery</code></li>
}
</ul>
<a class="btn" href="@Model.Link("security")">I saved them<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
break;
case SignInStep.Reauthenticate:
<a class="btn" href="@Model.Link("sign-in")">Sign in<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
break;
case SignInStep.DeviceDenied:
<div class="alert" role="status"><svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-circle-x"></use></svg><p>Device denied.</p></div>
break;
case SignInStep.NotFound:
<a class="btn" href="@Model.Link("sign-in")">Sign in<svg class="icon" aria-hidden="true"><use href="/admin/icons.svg#i-arrow-right"></use></svg></a>
break;
}
@if (Model.AccountReturn is { } accountReturn)
{
<div class="row"><a href="@accountReturn">Back to account</a></div>
}
@functions {
    /// <inheritdoc />
    public HostedLayoutModel LayoutModel => new(Model.Title, Model.Nonce, Model.Theme.ThemeColor, Model.Theme.LogoUrl, Model.Theme.Name,
        Model.Theme.TitleSize, Model.Theme.FooterLinks?.Select(link => (link.Label, link.Url)).ToArray(), Model.Theme.DefaultTheme, Model.Slug,
        Model.Theme.BackgroundColor, Model.Theme.TextColor);

    /// <inheritdoc />
    protected override Task ExecuteSectionAsync(string name)
    {
        // A navigation, not a redirect from the form post: form-action 'self' governs redirects after a submission.
        if (name == "head" && Model.Step == SignInStep.Continue)
        {
<meta http-equiv="refresh" content="0;url=@Model.Next">
        }

        // The client's validated post-logout URI, after a moment to read the page; the Continue link also goes there.
        if (name == "head" && Model.Step == SignInStep.SignedOut && Model.ReturnTo is { } returnTo)
        {
<meta http-equiv="refresh" content="2;url=@returnTo">
        }

        return Task.CompletedTask;
    }
}
