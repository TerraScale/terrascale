@inherits RazorLayoutSlice<HostedLayoutModel>
<!doctype html>
@* The hosted pages are dark only (user decision 2026-10-12); the tokens resolve light-dark() to their dark values. *@
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<title>@Model.Title · TerraScale</title>
<link rel="icon" href="/admin/icon.svg" type="image/svg+xml">
<style nonce="@Model.Nonce">@WriteHtml(HostedLayoutModel.PageCss)</style>
@if (Model.AccentColor is { } accent)
{
<style nonce="@Model.Nonce">:root{--ts-primary:@accent;--ts-primary-hover:@accent;--ts-on-primary:#ffffff;--ts-accent:@accent}</style>
}
@await RenderSectionAsync("head")
<script nonce="@Model.Nonce">
(function () {
  var saved = 'system';
  try { saved = localStorage.getItem('ts-auth-theme') || saved; } catch (e) { }
  document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
})();
</script>
</head>
<body>
<main class="auth-page">
<div class="card">
<div class="brand"><img src="@(Model.LogoUrl ?? "/admin/logo-icon-blue.svg")" alt="" class="logo-img"><span>@(Model.LogoUrl is null ? "TerraScale" : "ts-auth")</span></div>
@await RenderBodyAsync()
</div>
</main>
<footer class="auth-foot">
<select class="theme-picker" aria-label="Theme">
<option value="system">System</option>
<option value="light">Light</option>
<option value="dark">Dark</option>
</select>
<p class="auth-powered">Powered by <b>TerraScale</b></p>
</footer>
<script nonce="@Model.Nonce">
(function () {
  var root = document.documentElement, picker = document.querySelector('.theme-picker'), key = 'ts-auth-theme';
  var osDark = window.matchMedia('(prefers-color-scheme: dark)');
  function apply(choice) {
    root.dataset.theme = choice === 'light' || choice === 'dark' ? choice : osDark.matches ? 'dark' : 'light';
  }
  var saved = 'system';
  try { saved = localStorage.getItem(key) || saved; } catch (e) { }
  if (saved !== 'light' && saved !== 'dark') saved = 'system';
  picker.value = saved;
  apply(saved);
  picker.addEventListener('change', function () {
    try { localStorage.setItem(key, picker.value); } catch (e) { }
    apply(picker.value);
  });
  osDark.addEventListener('change', function () { apply(picker.value); });
})();
</script>
</body>
</html>
