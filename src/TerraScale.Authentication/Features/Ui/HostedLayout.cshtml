@inherits RazorLayoutSlice<HostedLayoutModel>
<!doctype html>
<html lang="en" data-theme="@Model.DefaultTheme" data-theme-key="@Model.ThemeKey" data-default-theme="@Model.DefaultTheme">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@Model.Title · @Model.Name</title>
<link rel="icon" href="/admin/logo-icon-blue.svg" type="image/svg+xml">
<style nonce="@Model.Nonce">@WriteHtml(HostedLayoutModel.PageCss)</style>
<style nonce="@Model.Nonce">@WriteHtml(Model.Palette)</style>
@if (Model.TitleSize is { } titleSize)
{
<style nonce="@Model.Nonce">:root{--title-size:@(titleSize.ToString(CultureInfo.InvariantCulture))px}</style>
}
@await RenderSectionAsync("head")
<script nonce="@Model.Nonce">
(function () {
  var root = document.documentElement, saved = root.dataset.theme;
  try { saved = localStorage.getItem(root.dataset.themeKey) || saved; } catch (e) { }
  document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
})();
</script>
</head>
<body>
<main class="auth-page">
<div class="card">
<div class="brand"><img src="@(Model.LogoUrl ?? "/admin/logo-icon-blue.svg")" alt="" class="logo-img"><span>@Model.Name</span></div>
@await RenderBodyAsync()
</div>
</main>
<footer class="auth-foot">
<nav class="foot-links" aria-label="Footer">
@foreach (var (label, url) in Model.Footer)
{
@if (Model.IsExternalFooterUrl(url))
{
<a href="@url" target="_blank" rel="noopener noreferrer">@label</a>
}
else
{
<a href="@url">@label</a>
}
}
</nav>
<div class="foot-row">
<select class="theme-picker" aria-label="Theme">
<option value="system">System</option>
<option value="light">Light</option>
<option value="dark">Dark</option>
</select>
</div>
<p class="auth-powered">Powered by <b>TerraScale</b></p>
</footer>
<script nonce="@Model.Nonce">
(function () {
  var root = document.documentElement, picker = document.querySelector('.theme-picker'), key = root.dataset.themeKey;
  var osDark = window.matchMedia('(prefers-color-scheme: dark)');
  function apply(choice) {
    root.dataset.theme = choice === 'light' || choice === 'dark' ? choice : osDark.matches ? 'dark' : 'light';
  }
  var saved = document.documentElement.getAttribute('data-default-theme') || 'system';
  try { saved = localStorage.getItem(key) || saved; } catch (e) { }
  if (saved !== 'light' && saved !== 'dark') saved = 'system';
  picker.value = saved;
  apply(saved);
  picker.addEventListener('change', function () {
    try { localStorage.setItem(key, picker.value); } catch (e) { }
    apply(picker.value);
  });
  osDark.addEventListener('change', function () { apply(picker.value); });
})();
</script>
<script nonce="@Model.Nonce">@WriteHtml(HostedPageBehavior.Script)</script>
</body>
</html>
