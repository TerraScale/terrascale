<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>TerraBase</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>terrabase</AssemblyName>
    <Version>0.1.0</Version>
    <SourceRevisionId Condition="'$(TERRABASE_REVISION)' != ''">$(TERRABASE_REVISION)</SourceRevisionId>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UserSecretsId />
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <UseTerraScaleEndpoints>true</UseTerraScaleEndpoints>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Cronos" />
    <PackageReference Include="Jint" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="NativeCompressions" />
    <PackageReference Include="Ulid" />
    <PackageReference Include="NUlid" />
    <PackageReference Include="SqlParserCS" />
    <PackageReference Include="ZLogger" />
    <PackageReference Include="ZString" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TerraBase.Analyzers/TerraBase.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../TerraScale.Logging/TerraScale.Logging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerraBase.Fast" />
    <InternalsVisibleTo Include="TerraBase.Slow" />
    <InternalsVisibleTo Include="TerraBase.E2E" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../vendor/Turso.Data.Sqlite/src/Turso.Data.Sqlite/Turso.Data.Sqlite.csproj" />
  </ItemGroup>
</Project>
