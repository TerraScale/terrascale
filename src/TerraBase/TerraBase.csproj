<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>TerraBase</RootNamespace>
    <AssemblyName>terrabase</AssemblyName>
    <Version>2.0.0</Version>
    <SourceRevisionId Condition="'$(TERRABASE_REVISION)' != ''">$(TERRABASE_REVISION)</SourceRevisionId>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UserSecretsId />
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <UseTerraScaleEndpoints>true</UseTerraScaleEndpoints>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="Ulid" />
    <PackageReference Include="ZLogger" />
    <PackageReference Include="ZString" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../sdk/dotnet/src/TerraScale.DotNet/TerraScale.DotNet.csproj" />
    <ProjectReference Include="../TerraScale.Logging/TerraScale.Logging.csproj" />
    <ProjectReference Include="../TerraScale.Contracts/TerraScale.Contracts.csproj" />
    <ProjectReference Include="../TerraScale.QuicRpc/TerraScale.QuicRpc.csproj" />
    <ProjectReference Include="../TerraBase.Storage/TerraBase.Storage.csproj" />
    <ProjectReference Include="../TerraBase.Postgres/TerraBase.Postgres.csproj" />
    <ProjectReference Include="../TerraBase.Cluster/TerraBase.Cluster.csproj" />
    <ProjectReference Include="../TerraBase.Continuity/TerraBase.Continuity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TerraScale.Results" />
    <Using Include="TerraScale.Contracts.Consistency" />
    <Using Include="TerraScale.Contracts.Storage" />
  </ItemGroup>

  <ItemGroup>
    <None Update="THIRD-PARTY-NOTICES" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
