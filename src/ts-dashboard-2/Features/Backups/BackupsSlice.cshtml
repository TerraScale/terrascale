@inherits RazorSlice<BackupsPageModel>
@{
    var shell = Model.Shell;
    var culture = System.Globalization.CultureInfo.InvariantCulture;
}
@ShellHtml.Top(shell)
<div class="ts-page">
    <section class="ts-panel ts-panel-20">
        <div class="ts-row-header-actions ts-row-actions-end">
            <span class="ts-meta">Loaded @Model.LoadedAtLabel</span>
            <form method="post" action="/api/v1/dashboard/backups/refresh">
                <button type="submit" class="ts-icon-btn" aria-label="Refresh backups">@Icons.RefreshCw(18)</button>
            </form>
        </div>
    </section>
    @if (Model.Error is { } error)
    {
        <div class="ts-alert ts-alert-danger" role="alert">
            <div class="ts-stack-xs">
                <span class="ts-alert-title">@error</span>
                <code class="ts-meta ts-mono">backup_request_failed</code>
            </div>
        </div>
    }
    @if (Model.RestoredNotice is { } notice)
    {
        <div class="ts-alert ts-alert-success" role="status">
            <div class="ts-stack-xs">
                <span class="ts-alert-title">Restore started side-by-side</span>
                <span class="ts-alert-body"><span aria-label="Most recent restored database">@notice</span> was created as a new database. The source database remains unchanged.</span>
            </div>
        </div>
    }
    @if (Model.Confirmation is { } plan)
    {
        <section class="ts-panel ts-backups-plan" aria-labelledby="backups-plan-title">
            <div class="ts-panel-header">
                <h2 class="ts-panel-title" id="backups-plan-title">Restore side-by-side</h2>
                <p class="ts-panel-subtitle">Create a new database from @plan.Generation</p>
            </div>
            <div class="ts-panel-pad ts-stack-lg">
                <div class="ts-alert ts-alert-info" role="status">
                    <div class="ts-stack-xs">
                        <span class="ts-alert-title">No restore has been started</span>
                        <span class="ts-alert-body">This confirmation is scoped to your current Dashboard session and expires automatically.</span>
                    </div>
                </div>
                <div class="ts-alert ts-alert-warning" role="status">
                    <div class="ts-stack-xs">
                        <span class="ts-alert-title">The source database is not overwritten</span>
                        <span class="ts-alert-body">Restoring creates a separate logical database with a new database ID. @plan.DatabaseName stays available with its current data.</span>
                    </div>
                </div>
                <div class="ts-backups-plan-box">
                    <dl class="ts-kv">
                        <dt>Database</dt>
                        <dd>@plan.DatabaseName</dd>
                        <dt>Action</dt>
                        <dd>@plan.Action</dd>
                        <dt>Restore point</dt>
                        <dd class="ts-mono">@plan.Generation</dd>
                        <dt>Target region</dt>
                        <dd>@plan.Region</dd>
                        <dt>Expires (UTC)</dt>
                        <dd>@plan.ExpiresLabel</dd>
                    </dl>
                    <p class="ts-meta">@Icons.Clock3(14) @plan.TtlLabel</p>
                </div>
                <p class="ts-meta">@Icons.TriangleAlert(14) @plan.CutoffWarning</p>
                <div class="ts-form-actions">
                    <a class="ts-btn ts-btn-secondary ts-btn-lg" href="/backups">Cancel</a>
                    <form method="post" action="/api/v1/dashboard/backups/restore-execute">
                        <input type="hidden" name="token" value="@plan.Token" />
                        <button type="submit" class="ts-btn ts-btn-primary ts-btn-lg">
                            @Icons.RotateCcw(16)
                            <span>Restore into new database</span>
                        </button>
                    </form>
                </div>
            </div>
        </section>
    }
    <section class="ts-panel">
        <div class="ts-panel-header">
            <h2 class="ts-panel-title">Backups</h2>
            <p class="ts-panel-subtitle">Per-database backup policy, backup jobs, restore points, and side-by-side restores</p>
        </div>
        <div class="ts-panel-pad">
            <div class="ts-backups-metrics">
                <div class="ts-metric"><span class="ts-muted">Project</span><span class="ts-metric-inline ts-mono">@Model.Project</span></div>
                <div class="ts-metric"><span class="ts-muted">Restore points</span><span class="ts-metric-inline">@Model.RestorePoints.Length.ToString("N0", culture)</span></div>
                <div class="ts-metric"><span class="ts-muted">Restores</span><span class="ts-metric-inline">@Model.RestoreJobs.Length.ToString("N0", culture)</span></div>
                <div class="ts-metric">
                    <span class="ts-muted">Last restore</span>
                    @if (Model.LatestRestore is { } latest)
                    {
                        <span class="ts-badge @latest.StateTone">@latest.State</span>
                    }
                    else
                    {
                        <span class="ts-metric-inline">-</span>
                    }
                </div>
            </div>
        </div>
    </section>
    <section class="ts-panel">
        <div class="ts-panel-header">
            <h2 class="ts-panel-title">Restore points</h2>
            <p class="ts-panel-subtitle">Restores create a new database next to the source database</p>
        </div>
        @if (Model.RestorePoints.Length == 0)
        {
            <div class="ts-panel-pad ts-stack-lg">
                <div class="ts-empty">
                    <span class="ts-empty-icon">@Icons.Archive(28)</span>
                    <span class="ts-empty-title">No restore points</span>
                    <p class="ts-muted">A completed backup with a restore point is required before restoring.</p>
                </div>
            </div>
        }
        else
        {
            <div class="ts-panel-pad">
                <div class="ts-table-wrap">
                    <table class="ts-table">
                        <thead>
                            <tr>
                                <th>Restore point</th>
                                <th>Database</th>
                                <th>Mode</th>
                                <th>Files</th>
                                <th>Size</th>
                                <th>Created</th>
                                <th aria-hidden="true"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.RestorePoints)
                            {
                                <tr>
                                    <td>
                                        <div class="ts-stack-xs">
                                            <span class="ts-mono">@row.Generation</span>
                                            <span class="ts-meta">@row.Region</span>
                                        </div>
                                    </td>
                                    <td>@row.Database</td>
                                    <td>
                                        <div class="ts-stack-xs">
                                            <span class="ts-badge @row.ModeTone">@row.Mode</span>
                                            <span class="ts-meta">@row.EncryptionLabel</span>
                                        </div>
                                    </td>
                                    <td>@row.FilesToRestore.ToString("N0", culture)</td>
                                    <td>@row.SizeLabel</td>
                                    <td>@row.CreatedLabel</td>
                                    <td>
                                        <form method="post" action="/api/v1/dashboard/backups/restore-plan">
                                            <input type="hidden" name="generation" value="@row.GenerationId" />
                                            <button type="submit" class="ts-btn ts-btn-secondary ts-btn-sm">
                                                @Icons.RotateCcw(16)
                                                <span>Restore side-by-side</span>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
    <section class="ts-panel">
        <div class="ts-panel-header">
            <h2 class="ts-panel-title">Restore jobs</h2>
            <p class="ts-panel-subtitle">Each restore targets a new logical database and preserves the source</p>
        </div>
        @if (Model.RestoreJobs.Length == 0)
        {
            <div class="ts-panel-pad ts-stack-lg">
                <div class="ts-empty">
                    <span class="ts-empty-icon">@Icons.RotateCcw(28)</span>
                    <span class="ts-empty-title">No restore jobs</span>
                    <p class="ts-muted">Start a side-by-side restore from a restore point.</p>
                </div>
            </div>
        }
        else
        {
            <div class="ts-panel-pad">
                <div class="ts-table-wrap">
                    <table class="ts-table">
                        <thead>
                            <tr>
                                <th>Restore</th>
                                <th>New database</th>
                                <th>Status</th>
                                <th>Started</th>
                                <th>Finished</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.RestoreJobs)
                            {
                                <tr>
                                    <td>
                                        <div class="ts-stack-xs">
                                            <span class="ts-mono">@row.Id</span>
                                            <span class="ts-meta">Source @row.Database</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="ts-stack-xs">
                                            <span>@row.RestoredDatabaseName</span>
                                            <span class="ts-meta">@row.TargetRegion</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="ts-stack-xs">
                                            <span class="ts-badge @row.StateTone">@row.State</span>
                                            @if (row.Error is { } failure)
                                            {
                                                <span class="ts-meta">@failure</span>
                                            }
                                        </div>
                                    </td>
                                    <td>@row.StartedLabel</td>
                                    <td>@row.FinishedLabel</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
</div>
@ShellHtml.Bottom(shell)
