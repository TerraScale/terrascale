@inherits RazorSlice<CliApprovePageModel>
@{
    var title = "Approve CLI access | TerraScale";
    var hasReview = Model.Code is not null;
}
@FlowHtml.Document(title)
<main class="ts-flow-root">
    <section class="ts-flow-panel">
        <div class="ts-flow-header">
            <div class="ts-flow-header-content">
                <h1 class="ts-flow-title">Approve CLI access</h1>
                <p class="ts-flow-subtitle">Review the terminal request before allowing TerraScale CLI to act for your account.</p>
            </div>
        </div>
        <div class="ts-flow-section">
            @if (!Model.Authenticated)
            {
                <div class="ts-alert ts-alert-info" role="status">
                    <span class="ts-alert-title">@Icons.Info(16) Sign-in required</span>
                    <span class="ts-alert-body">Sign in to review this CLI request. <a class="ts-link" href="/login?next=/cli/approve">Go to sign in</a></span>
                </div>
            }
            @if (Model.Error is { } error)
            {
                <div class="ts-alert ts-alert-danger" role="alert">
                    <span class="ts-alert-title">@Icons.CircleAlert(16) @error</span>
                </div>
            }
            @if (hasReview)
            {
                if (Model.Outcome is { } outcome)
                {
                    if (outcome == "approved")
                    {
                        <div class="ts-alert ts-alert-success" role="status">
                            <span class="ts-alert-title">@Icons.CircleCheckBig(16) CLI access approved</span>
                            <span class="ts-alert-body">Return to your terminal to finish signing in. You can close this page.</span>
                        </div>
                    }
                    else
                    {
                        <div class="ts-alert ts-alert-info" role="status">
                            <span class="ts-alert-title">@Icons.CircleAlert(16) CLI access denied</span>
                            <span class="ts-alert-body">This request will not receive access. You can close this page.</span>
                        </div>
                    }
                }
                else
                {
                    <dl class="ts-kv">
                        <dt>Account</dt>
                        <dd class="ts-mono">@Model.AccountEmail</dd>
                        <dt>Application</dt>
                        <dd>TerraScale CLI</dd>
                        <dt>Device code</dt>
                        <dd class="ts-mono">@Model.Code</dd>
                        <dt>Resource</dt>
                        <dd>@string.Join(", ", Model.Resources)</dd>
                    </dl>
                    <section class="ts-flow-section" aria-labelledby="cli-permissions">
                        <h2 id="cli-permissions" class="ts-flow-section-heading">Requested permissions</h2>
                        <ul class="ts-capability-list">
                            @foreach (var scope in Model.Scopes)
                            {
                                <li class="ts-capability">
                                    <span>@scope</span>
                                    <span class="ts-capability-reason">@TerraScale.Dashboard2.DashboardStore.CliScopeDescription(scope)</span>
                                </li>
                            }
                        </ul>
                    </section>
                    <section class="ts-flow-section">
                        <h2 class="ts-flow-section-heading">Organizations and databases</h2>
                        <p class="ts-muted ts-ui">Access covers organizations and databases available to this account, limited by the permissions above and your current organization roles. A billing role does not grant document access.</p>
                        <p class="ts-muted ts-ui">Approval does not subscribe to a plan or enable paid excess. Existing organization billing consent and spending controls still apply to writes and storage.</p>
                    </section>
                    <div class="ts-flow-section">
                        <p class="ts-muted ts-ui">Approve only if you started this request and the code matches your terminal.</p>
                        <div class="ts-flow-actions">
                            <form method="post" action="/cli/approve/submit">
                                <input type="hidden" name="user_code" value="@Model.Code" />
                                <input type="hidden" name="action" value="approve" />
                                <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Approve CLI access</button>
                            </form>
                            <form method="post" action="/cli/approve/submit">
                                <input type="hidden" name="user_code" value="@Model.Code" />
                                <input type="hidden" name="action" value="deny" />
                                <button class="ts-btn ts-btn-secondary ts-btn-lg" type="submit">Deny and cancel login</button>
                            </form>
                        </div>
                    </div>
                }
            }
            else if (Model.Authenticated)
            {
                <form class="ts-form" action="/cli/approve" method="get">
                    <div class="ts-field">
                        <label class="ts-label" for="user_code">Device code from your terminal</label>
                        <input class="ts-input ts-input-mono" type="text" id="user_code" name="user_code" required maxlength="64" autocomplete="one-time-code" placeholder="TSCL-…">
                    </div>
                    <div class="ts-form-actions">
                        <button class="ts-btn ts-btn-primary" type="submit">Review request</button>
                    </div>
                </form>
            }
        </div>
    </section>
</main>
@FlowHtml.End()
