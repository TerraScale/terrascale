@inherits RazorSlice<ResetPasswordPageModel>
@{
    var token = HttpContext?.Request?.Query["token"].FirstOrDefault() ?? "";
    var title = Model.Reset ? "Set a new password" : "Reset password";
    var subtitle = Model.Reset
        ? "Choose a new password for your TerraScale account."
        : "We will send password reset instructions to your email.";
    var action = Model.Reset ? "Set new password" : "Reset password";
}
@FlowHtml.Document("Reset password")
<main class="ts-auth">
    <div class="ts-auth-panel">
        <div class="ts-auth-card">
            <div class="ts-auth-brand">
                <img src="/brand/logo-terrascale-blue.svg" alt="TerraScale" decoding="async" />
            </div>
            <div class="ts-auth-heading">
                <h1 class="ts-auth-title">@title</h1>
                <p class="ts-auth-subtitle">@subtitle</p>
            </div>
            @if (Model.Updated)
            {
                <div class="ts-auth-feedback ts-auth-feedback-success" role="status">
                    @Icons.CircleCheckBig(16)
                    <span>Password updated. You can sign in with your new password.</span>
                </div>
            }
            else if (Model.Sent)
            {
                <div class="ts-auth-feedback ts-auth-feedback-success" role="status">
                    @Icons.CircleCheckBig(16)
                    <span>Password reset instructions were sent if the account exists.</span>
                </div>
            }
            @if (Model.Error is { } error)
            {
                <div class="ts-auth-feedback ts-auth-feedback-error" role="alert">
                    @Icons.CircleAlert(16)
                    <span>@error</span>
                </div>
            }
            <form class="ts-form" method="post" action="/reset-password">
                @if (Model.Reset)
                {
                    <input type="hidden" name="token" value="@token" />
                    <div class="ts-field">
                        <label class="ts-label" for="newPassword">New password</label>
                        <div class="ts-input-group">
                            <input class="ts-input" type="password" id="newPassword" name="newPassword" autocomplete="new-password" required />
                            <button class="ts-input-adornment" type="button" data-toggle-type="password" aria-label="Show password">@Icons.Eye(18)</button>
                        </div>
                    </div>
                    <div class="ts-field">
                        <label class="ts-label" for="confirmPassword">Confirm new password</label>
                        <div class="ts-input-group">
                            <input class="ts-input" type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required />
                            <button class="ts-input-adornment" type="button" data-toggle-type="password" aria-label="Show password">@Icons.Eye(18)</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ts-field">
                        <label class="ts-label" for="email">Email</label>
                        <input class="ts-input" type="email" id="email" name="email" autocomplete="email" required placeholder="name@company.com" />
                    </div>
                }
                <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">@action</button>
            </form>
            <p class="ts-auth-footer"><a class="ts-auth-back-link" href="/login">Back to sign in</a></p>
        </div>
        <div class="ts-auth-locale-footer">
            <label class="ts-sr-only" for="auth-locale">Language</label>
            <select id="auth-locale" class="ts-auth-locale" aria-label="Language">
                <option value="en" selected>English</option>
                <option value="pt-BR">Português</option>
            </select>
        </div>
    </div>
</main>
@FlowHtml.End()
