@inherits RazorSlice<CheckoutPageModel>
@FlowHtml.Document("Checkout | TerraScale")
<main class="ts-flow-root ts-checkout-root">
    <section class="ts-flow-panel ts-checkout-panel">
        <div class="ts-flow-panel-header">
            <div>
                <h2 class="ts-flow-panel-title">Checkout</h2>
                <p class="ts-flow-panel-subtitle">TerraScale local development payment provider</p>
            </div>
            <span class="ts-flow-panel-icon" aria-hidden="true">@Icons.CreditCard(20)</span>
        </div>
        <div class="ts-flow-section">
            <h1 class="ts-flow-title">TerraScale local payment setup</h1>
            <p class="ts-flow-subtitle">No card data or real payment is used.</p>
            <div class="ts-flow-actions">
                <form method="post" action="/checkout/@Model.SessionId/complete">
                    <button class="ts-btn ts-btn-primary ts-btn-lg ts-flow-action" type="submit">@Icons.CreditCard(20) Use local test payment method</button>
                </form>
                <form method="post" action="/checkout/@Model.SessionId/cancel">
                    <button class="ts-btn ts-btn-secondary ts-btn-lg ts-flow-action" type="submit">Cancel</button>
                </form>
            </div>
        </div>
    </section>
</main>
@FlowHtml.End()
