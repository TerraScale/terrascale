@inherits RazorSlice<AccessRulesPageModel>
@{
    var shell = Model.Shell;
    var editing = (Model.EditRuleId?.Length ?? 0) > 0;
    var dryRun = Model.DryRun;
    var dryRunRuleId = dryRun?.RuleId ?? Model.Rules.FirstOrDefault()?.Id ?? "";
    var dryRunAuthMode = dryRun?.AuthMode ?? "publishable-key";
    var dryRunPrincipal = dryRun?.PrincipalJson ?? DashboardStore.DefaultAccessRulePrincipal;
    var dryRunDocument = dryRun?.DocumentJson ?? DashboardStore.DefaultAccessRuleDocument;
}
@ShellHtml.Top(shell)
<div class="ts-page">
    @if (Model.Error is { } error)
    {
        <div class="ts-alert ts-alert-warning" role="alert">
            <span class="ts-alert-title">@Icons.TriangleAlert(16) @error</span>
        </div>
    }

    <section class="ts-panel ts-panel-20">
        <p class="ts-access-description">
            CEL access rules evaluated locally. Rules compile against a safe CEL subset;
            validation reports parser diagnostics with line and column, and the dry-run
            evaluator checks a rule against principal and document claims before publishing.
        </p>
        <dl class="ts-grid ts-grid-3 ts-access-margin-top-20">
            <div class="ts-summary-term">
                <dt>RULES</dt>
                <dd>@Model.Rules.Count</dd>
            </div>
            <div class="ts-summary-term">
                <dt>VALID</dt>
                <dd>@Model.ValidCount</dd>
            </div>
            <div class="ts-summary-term">
                <dt>DOCUMENT FIELDS</dt>
                <dd>@Model.Rules.SelectMany(r => r.ReferencedFields).Distinct().Count()</dd>
            </div>
        </dl>
        <p class="ts-accessrules-meta ts-code-meta">revision @Model.Revision · entitlement epoch @Model.EntitlementEpoch</p>
    </section>

    <section class="ts-panel">
        <div class="ts-panel-header">
            <h2 class="ts-panel-title">Rules</h2>
            <p class="ts-panel-subtitle">Stored CEL rules with local compilation status</p>
        </div>
        @if (Model.Rules.Count == 0)
        {
            <div class="ts-padded">
                <div class="ts-empty">
                    <span class="ts-empty-icon">@Icons.SearchX(28)</span>
                    <span class="ts-empty-title">No access rules</span>
                    <span>Create a rule to start constraining document access.</span>
                </div>
            </div>
        }
        else
        {
            <div class="ts-table-wrap ts-table-flush">
                <table class="ts-table">
                    <thead>
                        <tr>
                            <th>Rule</th>
                            <th>CEL source</th>
                            <th>Document fields</th>
                            <th>Status</th>
                            <th aria-label="Actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in Model.Rules)
                        {
                            <tr>
                                <td>
                                    <div class="ts-access-min-width">
                                        <p class="ts-access-text-strong">@rule.Name</p>
                                        <p class="ts-meta ts-code-meta">@rule.Generation</p>
                                    </div>
                                </td>
                                <td><code class="ts-accessrules-rule-source">@rule.Source</code></td>
                                <td>
                                    @if (rule.ReferencedFields.Count == 0)
                                    {
                                        <span class="ts-muted ts-ui">—</span>
                                    }
                                    else
                                    {
                                        <div class="ts-accessrules-chips">
                                            @foreach (var field in rule.ReferencedFields)
                                            {
                                                <span class="ts-badge ts-badge-neutral">@field</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (rule.IsValid)
                                    {
                                        <span class="ts-badge ts-badge-success">@Icons.ShieldCheck(14) @rule.StatusLabel</span>
                                    }
                                    else
                                    {
                                        <span class="ts-badge ts-badge-danger">@Icons.ShieldOff(14) @rule.StatusLabel</span>
                                    }
                                </td>
                                <td>
                                    <div class="ts-accessrules-row-actions">
                                        <a class="ts-btn ts-btn-ghost ts-access-compact-action" href="/access-rules?edit=@rule.Id">Edit</a>
                                        <form method="post" action="/api/v1/access-rules/@rule.Id/delete">
                                            <button class="ts-btn ts-btn-ghost ts-access-compact-action" type="submit" title="Delete rule @rule.Name">
                                                @Icons.Trash2(15)
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="ts-padded ts-accessrules-toolbar">
                <a class="ts-btn ts-btn-secondary" href="/access-rules?edit=new">
                    @Icons.Plus(16)
                    New rule
                </a>
            </div>
        }
    </section>

    @if (editing)
    {
        <section class="ts-panel">
            <div class="ts-panel-header">
                <h2 class="ts-panel-title">Rule editor</h2>
                <p class="ts-panel-subtitle">@(Model.EditRuleId == "new" ? "New local draft" : Model.EditName)</p>
            </div>
            <div class="ts-stack-20 ts-padded">
                <form class="ts-accessrules-editor-form" method="post" action="/api/v1/access-rules">
                    <input type="hidden" name="ruleId" value="@Model.EditRuleId" />
                    <div class="ts-field">
                        <label class="ts-label" for="access-rule-name">Rule name</label>
                        <input class="ts-input" id="access-rule-name" name="name" value="@Model.EditName" placeholder="Owner read" required />
                    </div>
                    <div class="ts-field">
                        <label class="ts-label" for="access-rule-source">CEL rule</label>
                        <textarea class="ts-textarea ts-textarea-mono" id="access-rule-source" name="source" rows="4" spellcheck="false"
                                  aria-invalid="@(Model.Validation is { Ok: false } ? "true" : null)">@Model.EditSource</textarea>
                        @if (Model.EditGeneration.Length > 0)
                        {
                            <p class="ts-meta ts-code-meta">generation @Model.EditGeneration</p>
                        }
                    </div>
                    <div class="ts-accessrules-actions">
                        <button class="ts-btn ts-btn-secondary" type="submit" formaction="/api/v1/access-rules/validate">
                            @Icons.CircleCheck(16)
                            Validate
                        </button>
                        <button class="ts-btn ts-btn-primary" type="submit">
                            @Icons.Save(16)
                            Save rule
                        </button>
                        <a class="ts-btn ts-btn-ghost" href="/access-rules">Cancel</a>
                    </div>
                </form>

                @if (Model.Validation is { } validation)
                {
                    if (validation.Ok)
                    {
                        <div class="ts-alert ts-alert-success" role="alert">
                            <span class="ts-alert-title">@Icons.CircleCheck(16) The rule compiles.</span>
                            <span class="ts-alert-body">
                                @(validation.RequiredFields.Count == 0
                                    ? "Every referenced document field has a backing index."
                                    : $"Missing indexes for: {string.Join(", ", validation.RequiredFields)}.")
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="ts-table-wrap ts-table-flush">
                            <table class="ts-table">
                                <thead>
                                    <tr>
                                        <th>Line</th>
                                        <th>Column</th>
                                        <th>Code</th>
                                        <th>Message</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var diagnostic in validation.Diagnostics)
                                    {
                                        <tr>
                                            <td><span class="ts-mono">@diagnostic.Line</span></td>
                                            <td><span class="ts-mono">@diagnostic.Column</span></td>
                                            <td><code class="ts-code-meta">@AccessRuleValidationView.FormatCode(diagnostic.Code)</code></td>
                                            <td>@diagnostic.Message</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (validation.RecommendedIndexes.Count > 0)
                    {
                        <div class="ts-accessrules-index-note">
                            <span class="ts-meta">Recommended indexes:</span>
                            <div class="ts-accessrules-chips">
                                @foreach (var index in validation.RecommendedIndexes)
                                {
                                    <span class="ts-badge ts-badge-neutral">@index</span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </section>
    }

    <section class="ts-panel">
        <div class="ts-panel-header">
            <h2 class="ts-panel-title">Dry-run evaluation</h2>
            <p class="ts-panel-subtitle">Run a compiled rule against a local claims context</p>
        </div>
        <div class="ts-stack-20 ts-padded">
            <form class="ts-accessrules-dryrun-form" method="post" action="/api/v1/access-rules/dry-run">
                <div class="ts-field">
                    <label class="ts-label" for="access-rule-dryrun-rule">Rule</label>
                    <select class="ts-select" id="access-rule-dryrun-rule" name="ruleId">
                        @foreach (var rule in Model.Rules)
                        {
                            <option value="@rule.Id" selected="@(rule.Id == dryRunRuleId ? "selected" : null)">@(rule.IsValid ? "" : "✕ ")@rule.Name</option>
                        }
                    </select>
                </div>
                <div class="ts-field">
                    <label class="ts-label" for="access-rule-dryrun-auth">Authorization context</label>
                    <select class="ts-select" id="access-rule-dryrun-auth" name="authMode">
                        <option value="publishable-key" selected="@(dryRunAuthMode == "publishable-key" ? "selected" : null)">publishable-key</option>
                        <option value="byo-jwt" selected="@(dryRunAuthMode == "byo-jwt" ? "selected" : null)">byo-jwt</option>
                    </select>
                </div>
                <div class="ts-field">
                    <label class="ts-label" for="access-rule-dryrun-principal">Principal JSON</label>
                    <textarea class="ts-textarea ts-textarea-mono" id="access-rule-dryrun-principal" name="principal" rows="5" spellcheck="false">@dryRunPrincipal</textarea>
                </div>
                <div class="ts-field">
                    <label class="ts-label" for="access-rule-dryrun-document">Document JSON</label>
                    <textarea class="ts-textarea ts-textarea-mono" id="access-rule-dryrun-document" name="document" rows="5" spellcheck="false">@dryRunDocument</textarea>
                </div>
                <div class="ts-accessrules-dryrun-footer">
                    <button class="ts-btn ts-btn-primary" type="submit">
                        @Icons.Play(16)
                        Run evaluation
                    </button>
                </div>
            </form>

            @if (dryRun is { } run)
            {
                if (run.Error is { } runError)
                {
                    <div class="ts-alert ts-alert-warning" role="alert">
                        <span class="ts-alert-title">@Icons.TriangleAlert(16) @runError</span>
                    </div>
                }
                else if (run.Result is { } result)
                {
                    <div class="ts-accessrules-outcome">
                        @if (result.Allowed)
                        {
                            <span class="ts-badge ts-badge-success">@Icons.ShieldCheck(14) allow</span>
                        }
                        else
                        {
                            <span class="ts-badge ts-badge-danger">@Icons.ShieldOff(14) deny</span>
                        }
                        @if (result.Error is { } diagnostic)
                        {
                            <span class="ts-meta">
                                @AccessRuleValidationView.FormatCode(diagnostic.Code) at line @diagnostic.Line, column @diagnostic.Column: @diagnostic.Message
                            </span>
                        }
                    </div>
                }
            }
        </div>
    </section>
</div>
@ShellHtml.Bottom(shell)
