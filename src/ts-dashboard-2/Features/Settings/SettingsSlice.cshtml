@inherits RazorSlice<SettingsPageModel>
@{
    var shell = Model.Shell;
    var t = (string s) => s;
    string WebhookStatusTone(string status) => status switch { "Active" => "ts-badge-success", "Paused" => "ts-badge-warning", _ => "ts-badge-neutral" };
    string DeliveryStatusTone(string status) => status switch { "Delivered" => "ts-badge-success", "Retrying" => "ts-badge-warning", "Pending" => "ts-badge-info", _ => "ts-badge-danger" };
    var tabs = new (string Id, string Label)[]
    {
        ("identity", "Identity"),
        ("credentials", "Credentials"),
        ("webhooks", "Webhooks"),
        ("backups", "Backups"),
        ("danger", "Danger zone"),
    };
    var activeProviders = Model.Providers.Count(p => p.Status == "Enabled");
    var activeCredentials = Model.Credentials.Count(c => c.Status == "Active");
    var apiKeys = Model.Credentials.Where(c => c.Type == "API key").Count();
    var m2mApps = Model.Credentials.Where(c => c.Type == "M2M application").Count();
    var summary = new (string Label, string Value)[]
    {
(t("PROJECT"), Model.ProjectId),
        (t("AUTH PROVIDERS"), $"{activeProviders}/{Model.Providers.Length}"),
        (t("API KEYS"), apiKeys.ToString()),
        (t("M2M APPLICATIONS"), m2mApps.ToString()),
        (t("DATABASES"), Model.Databases.Length.ToString()),
        (t("ACTIVE CREDENTIALS"), activeCredentials.ToString()),
        (t("LOADED"), Model.LoadedAtText),
    };
}
@ShellHtml.Top(shell)
<div class="ts-page">
    <section class="ts-panel">
        <div class="ts-row-header">
            <div class="ts-min-width">
                <h2 class="ts-page-title-24">@t("Settings")</h2>
                <p class="ts-page-desc">@t("Project identity providers, API keys, and machine clients loaded from public TerraScale REST endpoints.")</p>
            </div>
            <a class="ts-btn ts-btn-secondary ts-btn-lg" href="/settings?tab=@Model.Tab">@Icons.RefreshCw(16) @t("Reload")</a>
        </div>
    </section>

    <section class="ts-panel">
        <div class="ts-panel-header">
            <h3 class="ts-panel-title">@t("Security summary")</h3>
            <p class="ts-panel-subtitle">@t("Persisted project auth and credential state")</p>
        </div>
        <dl class="ts-summary-grid">
            @foreach (var (label, value) in summary)
            {
                <div class="ts-summary-cell">
                    <dt class="ts-text-upper">@label</dt>
                    <dd class="ts-summary-value ts-mono">@value</dd>
                </div>
            }
        </dl>
    </section>

    <nav class="ts-tabs" aria-label="Settings sections">
        @foreach (var (id, label) in tabs)
        {
            <a class="ts-tab @(id == "danger" && Model.Tab == "danger" ? "ts-tab-danger" : null)" href="/settings?tab=@id" aria-selected="@(Model.Tab == id ? "true" : "false")">@label</a>
        }
    </nav>

    @if (Model.Tab == "identity")
    {
        <div class="ts-stack-20">
            <section class="ts-panel">
                <div class="ts-panel-header">
                    <h3 class="ts-panel-title">@t("Authentication product")</h3>
                    <p class="ts-panel-subtitle">@t("Control project-wide access to TerraScale Authentication")</p>
                    <span class="ts-badge @(Model.AuthenticationEnabled ? "ts-badge-success" : "ts-badge-warning")">@(Model.AuthenticationEnabled ? t("On") : t("Off"))</span>
                </div>
                <div class="ts-stack-16 ts-padded">
                    @if (!Model.AuthenticationEnabled)
                    {
                        <div class="ts-alert ts-alert-danger">
                            <span class="ts-alert-title">@t("Authentication is disabled")</span>
                            <span class="ts-alert-body">@t("Project sign-in and authentication integrations are unavailable until an owner turns the product back on.")</span>
                        </div>
                    }
                    <form method="post" action="/api/v1/dashboard/settings/authentication" class="ts-setting-row">
<span class="ts-setting-copy">
                            <span class="ts-setting-icon" aria-hidden="true">@(Model.AuthenticationEnabled ? Icons.ShieldCheck(17) : Icons.ShieldAlert(17))</span>
                            <span class="ts-setting-copy-text">
                                <span class="ts-setting-label">@t("Enable Authentication")</span>
                                <span class="ts-setting-description">@t("When off, project authentication requests are rejected. Disabling requires an explicit warning confirmation because applications and active users may be interrupted.")</span>
                                @if (Model.SecuritySettingsUpdatedAt.Length > 0)
                                {
                                    <span class="ts-setting-updated">@t("Last changed") @DashboardStore.FormatUtcDateTime(Model.SecuritySettingsUpdatedAt)</span>
                                }
                            </span>
                        </span>
                        <input class="ts-switch" type="checkbox" name="enabled" value="true" aria-label='@t("Enable Authentication")' @(Model.AuthenticationEnabled ? "checked" : null) onchange="this.form.submit()" />
                    </form>
                    @if (!Model.CanManageByok)
                    {
                        <div class="ts-alert ts-alert-info">
                            <span class="ts-alert-title">@Icons.Info(16) @t("Customer managed keys (BYOK)")</span>
                            <span class="ts-alert-body">@t("An active Enterprise plan and Organization Owner access are required.")</span>
                        </div>
                    }
                </div>
            </section>
            <section class="ts-panel">
                <div class="ts-panel-header">
                    <h3 class="ts-panel-title">@t("Identity providers")</h3>
                    <p class="ts-panel-subtitle">@t("Project authentication providers returned by the TerraScale Dashboard API")</p>
                    <span class="ts-badge ts-badge-info">@Model.Providers.Length</span>
                </div>
                <div class="ts-padded">
                    @if (Model.Providers.Length == 0)
                    {
                        <div class="ts-empty">
                            <span class="ts-empty-title">@t("No identity providers")</span>
                            @t("The TerraScale Dashboard API returned no persisted auth providers for this project.")
                        </div>
                    }
                    else
                    {
                        <div class="ts-table-wrap">
                            <table class="ts-table">
                                <thead>
                                    <tr>
                                        <th>@t("Provider")</th>
                                        <th>@t("Protocol")</th>
                                        <th>@t("Credentials")</th>
                                        <th>@t("Endpoints")</th>
                                        <th>@t("Status")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var provider in Model.Providers)
                                    {
                                        <tr>
                                            <td>
                                                <div class="ts-grid-tight">
                                                    <span class="ts-text-strong">@provider.DisplayName</span>
                                                    <span class="ts-mono ts-meta">@provider.Provider</span>
                                                </div>
                                            </td>
                                            <td class="ts-meta">@provider.Protocol</td>
                                            <td>
                                                @if (provider.Protocol.Equals("SAML", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <div class="ts-grid-tight">
                                                        <span class="ts-meta">@(provider.SamlServiceProviderEntityId.Length > 0 ? provider.SamlServiceProviderEntityId : "-")</span>
                                                        <span class="ts-meta">@t(provider.SamlCertificateStatus)</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="ts-grid-tight">
                                                        <span class="ts-mono ts-meta">@(provider.ClientId.Length > 0 ? provider.ClientId : "-")</span>
                                                        <span class="ts-meta">@t("Secret configured")</span>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                @if (provider.Protocol.Equals("SAML", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <div class="ts-grid-tight">
                                                        @foreach (var endpoint in new[] { provider.SamlSingleSignOnUrl, provider.SamlAssertionConsumerServiceUrl }.Where(e => e.Length > 0))
                                                        {
                                                            <span class="ts-mono ts-meta ts-break-all">@endpoint</span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="ts-grid-tight">
                                                        @foreach (var endpoint in new[] { provider.AuthorizationEndpoint, provider.TokenEndpoint, provider.UserInfoEndpoint, provider.RedirectUri }.Where(e => e.Length > 0))
                                                        {
                                                            <span class="ts-mono ts-meta ts-break-all">@endpoint</span>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <div class="ts-grid-tight">
                                                    <span class="ts-badge @(provider.Status == "Enabled" ? "ts-badge-success" : "ts-badge-neutral")">@t(provider.Status)</span>
                                                    <span class="ts-meta">@DashboardStore.FormatUtcDateTime(provider.UpdatedAt)</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>
        </div>
    }
    else if (Model.Tab == "credentials")
    {
        <section class="ts-panel">
            <div class="ts-panel-header">
                <h3 class="ts-panel-title">@t("Project credentials")</h3>
                <p class="ts-panel-subtitle">@t("API keys and M2M applications returned by the TerraScale Dashboard API")</p>
                <span class="ts-badge ts-badge-info">@Model.Credentials.Length</span>
            </div>
            <div class="ts-padded">
                @if (Model.Credentials.Length == 0)
                {
                    <div class="ts-empty">
                        <span class="ts-empty-title">@t("No project credentials")</span>
                        @t("The TerraScale Dashboard API returned no persisted API keys or M2M applications.")
                    </div>
                }
                else
                {
                    <div class="ts-table-wrap">
                        <table class="ts-table">
                            <thead>
                                <tr>
                                    <th>@t("Name")</th>
                                    <th>@t("Type")</th>
                                    <th>@t("Token")</th>
                                    <th>@t("Scopes")</th>
                                    <th>@t("Status")</th>
                                    <th>@t("Activity")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var credential in Model.Credentials)
                                {
                                    <tr>
                                        <td>
                                            <div class="ts-row ts-gap-12">
                                                <span class="ts-credential-icon">@(credential.Type == "API key" ? Icons.KeyRound(16) : Icons.Users(16))</span>
                                                <div class="ts-min-width">
                                                    <div class="ts-text-strong">@credential.Name</div>
                                                    <div class="ts-mono ts-meta">@credential.Id</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="ts-badge ts-badge-info">@t(credential.Type)</span></td>
                                        <td class="ts-mono ts-meta">@credential.Prefix...@credential.LastFour</td>
                                        <td class="ts-meta">@(credential.Scopes.Count == 0 ? "-" : string.Join(", ", credential.Scopes))</td>
                                        <td><span class="ts-badge @(credential.Status == "Active" ? "ts-badge-success" : "ts-badge-warning")">@t(credential.Status)</span></td>
                                        <td>
                                            <div class="ts-grid-tight ts-meta">
                                                <span>@t("Created") @DashboardStore.FormatUtcDateTime(credential.CreatedAt)</span>
                                                <span>@t("Last used") @(credential.LastUsedAt.Length == 0 ? "-" : DashboardStore.FormatUtcDateTime(credential.LastUsedAt))</span>
                                                <span>@t("Expires") @(credential.ExpiresAt.Length == 0 ? "-" : DashboardStore.FormatUtcDateTime(credential.ExpiresAt))</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    }
    else if (Model.Tab == "webhooks")
    {
        <section class="ts-panel">
            <div class="ts-panel-header">
                <h3 class="ts-panel-title">@t("Webhooks")</h3>
                <p class="ts-panel-subtitle">@t("Endpoint deliveries for project events")</p>
                @Icons.Webhook(18)
            </div>
            <div class="ts-padded ts-stack-16">
                <p class="ts-webhook-usage">@Model.WebhookAllowance.Used of @Model.WebhookAllowance.Limit endpoints used — the @Model.WebhookAllowance.Plan plan allows up to @Model.WebhookAllowance.Limit webhook endpoints per database. Each delivery is retried up to @(DashboardStore.WebhookMaxRetryAttempts) times.</p>
                @if (Model.Webhooks.Length == 0)
                {
                    <div class="ts-empty">
                        <span class="ts-empty-title">@t("No webhooks")</span>
                        @t("The TerraScale Dashboard API returned no persisted webhooks for this project.")
                    </div>
                }
                else
                {
                    <div class="ts-table-wrap">
                        <table class="ts-table">
                            <thead>
                                <tr>
                                    <th>URL</th>
                                    <th>Secret</th>
                                    <th>Status</th>
                                    <th>Created</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var webhook in Model.Webhooks)
                                {
                                    <tr>
                                        <td class="ts-mono ts-meta ts-break-all">@webhook.Url</td>
                                        <td class="ts-mono ts-meta">@webhook.SecretPreview</td>
                                        <td><span class="ts-badge @WebhookStatusTone(webhook.Status)">@webhook.Status</span></td>
                                        <td class="ts-meta">@DashboardStore.FormatUtcDateTime(webhook.CreatedAt)</td>
                                        <td>
                                            <div class="ts-credential-actions">
                                                @if (webhook.Status == "Disabled")
                                                {
                                                    <form method="post" action="/api/v1/dashboard/webhooks/toggle">
                                                        <input type="hidden" name="webhookId" value="@webhook.Id" />
                                                        <input type="hidden" name="state" value="active" />
                                                        <button type="submit" class="ts-btn ts-btn-ghost ts-btn-sm">Enable</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <form method="post" action="/api/v1/dashboard/webhooks/toggle">
                                                        <input type="hidden" name="webhookId" value="@webhook.Id" />
                                                        <input type="hidden" name="state" value="@(webhook.Status == "Paused" ? "active" : "paused")" />
                                                        <button type="submit" class="ts-btn ts-btn-ghost ts-btn-sm">@(webhook.Status == "Paused" ? "Resume" : "Pause")</button>
                                                    </form>
                                                    <form method="post" action="/api/v1/dashboard/webhooks/toggle">
                                                        <input type="hidden" name="webhookId" value="@webhook.Id" />
                                                        <input type="hidden" name="state" value="disabled" />
                                                        <button type="submit" class="ts-btn ts-btn-ghost ts-btn-sm">Disable</button>
                                                    </form>
                                                }
                                                <form method="post" action="/api/v1/dashboard/webhooks/rotate">
                                                    <input type="hidden" name="webhookId" value="@webhook.Id" />
                                                    <button type="submit" class="ts-btn ts-btn-ghost ts-btn-sm">Rotate secret</button>
                                                </form>
                                                <form method="post" action="/api/v1/dashboard/webhooks/delete">
                                                    <input type="hidden" name="webhookId" value="@webhook.Id" />
                                                    <button type="submit" class="ts-btn ts-btn-ghost ts-btn-sm ts-text-danger">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @foreach (var webhook in Model.Webhooks)
                    {
                        var deliveries = Model.WebhookDeliveries.Where(d => d.WebhookId == webhook.Id).ToArray();
                        if (deliveries.Length == 0)
                        {
                            continue;
                        }
                        <div class="ts-webhook-deliveries">
                            <h4 class="ts-webhook-deliveries-title">@t("Deliveries")</h4>
                            <span class="ts-mono ts-meta ts-break-all">@webhook.Url</span>
                            <div class="ts-table-wrap">
                                <table class="ts-table">
                                    <thead>
                                        <tr>
                                            <th>Event</th>
                                            <th>Status</th>
                                            <th>Attempts</th>
                                            <th>Last response</th>
                                            <th>Next retry</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var delivery in deliveries)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="ts-grid-tight">
                                                        <span class="ts-text-strong">@delivery.Event</span>
                                                        <span class="ts-mono ts-meta">@delivery.Id</span>
                                                    </div>
                                                </td>
                                                <td><span class="ts-badge @DeliveryStatusTone(delivery.Status)">@delivery.Status</span></td>
                                                <td class="ts-mono ts-meta">@delivery.Attempt/@delivery.MaxAttempts</td>
                                                <td>
                                                    <div class="ts-grid-tight">
                                                        <span class="ts-meta">@(delivery.StatusCode is { } code ? code.ToString() : "-")</span>
                                                        @if (delivery.Error.Length > 0)
                                                        {
                                                            <span class="ts-meta">@delivery.Error</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="ts-meta">@(delivery.NextAttemptAt.Length > 0 ? DashboardStore.FormatUtcDateTime(delivery.NextAttemptAt) : "-")</td>
                                                <td>
                                                    <form method="post" action="/api/v1/dashboard/webhooks/replay">
                                                        <input type="hidden" name="deliveryId" value="@delivery.Id" />
                                                        <button type="submit" class="ts-btn ts-btn-ghost ts-btn-sm">Replay</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
                <form method="post" action="/api/v1/dashboard/webhooks" class="ts-form ts-inline-form">
                    <div class="ts-field">
                        <label class="ts-label" for="webhookUrl">Endpoint URL</label>
                        <input class="ts-input" id="webhookUrl" name="url" type="url" placeholder="https://ops.example.net/hooks/terrascale" required />
                    </div>
                    <div class="ts-form-actions">
                        <button class="ts-btn ts-btn-primary" type="submit">Create webhook</button>
                    </div>
                </form>
            </div>
        </section>
    }
    else if (Model.Tab == "backups")
    {
        <section class="ts-panel">
            <div class="ts-panel-header">
                <h3 class="ts-panel-title">Backups</h3>
                <p class="ts-panel-subtitle">Database backup policy and restore points</p>
            </div>
            <div class="ts-padded ts-stack-16">
                @if (Model.Databases.Length == 0)
                {
                    <div class="ts-empty">
                        <span class="ts-empty-title">No databases</span>
                        Provision a database before configuring backups.
                    </div>
                }
                else
                {
                    <form method="post" action="/api/v1/dashboard/settings/backup-policy" class="ts-form">
                        <div class="ts-field">
                            <label class="ts-label" for="backupDatabase">Database</label>
                            <select class="ts-select" id="backupDatabase" name="databaseId">
                                @foreach (var database in Model.Databases)
                                {
                                    <option value="@database.Id">@database.Name</option>
                                }
                            </select>
                        </div>
                        <div class="ts-field">
                            <label class="ts-label" for="backupSchedule">Schedule</label>
                            <select class="ts-select" id="backupSchedule" name="schedule">
                                <option value="daily" selected>Daily at 03:00 UTC</option>
                                <option value="hourly">Hourly</option>
                            </select>
                        </div>
                        <div class="ts-field">
                            <label class="ts-label" for="backupRetention">Retention</label>
                            <select class="ts-select" id="backupRetention" name="retention">
                                <option value="7">7 days</option>
                                <option value="30" selected>30 days</option>
                            </select>
                        </div>
                        <div class="ts-form-actions">
                            <button class="ts-btn ts-btn-primary" type="submit">Save backup policy</button>
                        </div>
                    </form>
                    <form method="post" action="/api/v1/dashboard/settings/backup-now" class="ts-form">
                        <div class="ts-field">
                            <label class="ts-label" for="onDemandDatabase">On-demand backup</label>
                            <select class="ts-select" id="onDemandDatabase" name="databaseId">
                                @foreach (var database in Model.Databases)
                                {
                                    <option value="@database.Id">@database.Name</option>
                                }
                            </select>
                            <span class="ts-hint">A confirmation is reviewed before a backup job starts.</span>
                        </div>
                        <div class="ts-form-actions">
                            <button class="ts-btn ts-btn-secondary" type="submit">Back up now</button>
                        </div>
                    </form>
                }
            </div>
        </section>
        @if (Model.Databases.Length > 0)
        {
            <section class="ts-panel">
                <div class="ts-panel-header">
                    <h3 class="ts-panel-title">Backup jobs</h3>
                    <p class="ts-panel-subtitle">Policy and on-demand runs for this project</p>
                </div>
                <div class="ts-table-frame">
                    <table class="ts-table">
                        <thead>
                            <tr>
                                <th>Job</th>
                                <th>Database</th>
                                <th>Policy</th>
                                <th>Status</th>
                                <th>Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in Model.BackupJobs.OrderByDescending(j => j.UpdatedAt, StringComparer.Ordinal))
                            {
                                <tr>
                                    <td><code class="ts-mono ts-meta">@job.Id</code></td>
                                    <td>@job.DatabaseName</td>
                                    <td class="ts-meta">@job.Policy</td>
                                    <td><span class="ts-badge ts-badge-success">@job.State</span></td>
                                    <td class="ts-meta">@DashboardStore.FormatUtcDateTime(job.UpdatedAt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="ts-panel">
                <div class="ts-panel-header">
                    <h3 class="ts-panel-title">Restore points</h3>
                    <p class="ts-panel-subtitle">Completed generations available for a side-by-side restore</p>
                </div>
                <div class="ts-table-frame">
                    <table class="ts-table">
                        <thead>
                            <tr>
                                <th>Restore point</th>
                                <th>Database</th>
                                <th>Mode</th>
                                <th>Files</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var point in Model.RestorePoints.OrderByDescending(p => p.CreatedAt, StringComparer.Ordinal).Take(8))
                            {
                                <tr>
                                    <td><code class="ts-mono ts-meta">@point.Generation</code></td>
                                    <td>@point.DatabaseName</td>
                                    <td class="ts-meta">@point.Mode</td>
                                    <td class="ts-meta">@point.FilesToRestore</td>
                                    <td class="ts-meta">@DashboardStore.FormatUtcDateTime(point.CreatedAt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
    else
    {
        <section class="ts-panel">
            <div class="ts-panel-header">
                <h3 class="ts-panel-title">@t("Danger zone")</h3>
                <p class="ts-panel-subtitle">@t("Destructive project settings")</p>
            </div>
            <div class="ts-stack-16 ts-padded">
                @if (!Model.CanDeleteProject)
                {
                    <div class="ts-alert ts-alert-info">
                        <span class="ts-alert-title">@t("Organization Owner required")</span>
                        <span class="ts-alert-body">@t("Only an Organization Owner may permanently delete this project.")</span>
                    </div>
                }
                else
                {
                    <form method="post" action="/api/v1/dashboard/settings/delete-project" class="ts-form">
                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                        <div class="ts-field">
                            <label class="ts-label" for="confirmProjectName">Type the project name to confirm deletion</label>
                            <input class="ts-input ts-input-mono" id="confirmProjectName" name="confirmName" placeholder="@Model.ProjectName" required />
                            <span class="ts-hint">Deleting @Model.ProjectName permanently removes its databases, credentials, and backups.</span>
                        </div>
                        <div class="ts-form-actions">
                            <button class="ts-btn ts-btn-danger-solid" type="submit">Delete project</button>
                        </div>
                    </form>
                }
                <div class="ts-grid ts-grid-cards-3">
                    @foreach (var tile in new (string Label, string Icon)[] { (t("Identity"), "ShieldCheck"), (t("Credentials"), "KeyRound"), (t("Access"), "Shield") })
                    {
                        <div class="ts-danger-tile">
                            @(typeof(Icons).GetMethod(tile.Icon)?.Invoke(null, [17]))
                            <span>@tile.Label</span>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
</div>

@if (Model.WebhookSecretValue is { } webhookSecret)
{
    <dialog class="ts-dialog" data-autoopen>
        <div class="ts-dialog-content">
            <div class="ts-dialog-header">
                <h3 class="ts-dialog-title">@t("Webhook secret")</h3>
                <p class="ts-dialog-description">@t("Copy this secret now. It will not be shown again.")</p>
            </div>
            <div class="ts-alert ts-alert-warning">
                <span class="ts-alert-title">@Icons.TriangleAlert(16) @t("Secret is shown once")</span>
                <span class="ts-alert-body">@t("The previous signing secret stops working as soon as consumers switch to this one.")</span>
            </div>
            <dl class="ts-secret-list">
                <div class="ts-secret-row"><dt class="ts-muted">@t("Webhook")</dt><dd class="ts-secret-value">@Model.WebhookSecretId</dd></div>
                <div class="ts-secret-row"><dt class="ts-muted">@t("Endpoint")</dt><dd class="ts-secret-value ts-break-all">@Model.WebhookSecretUrl</dd></div>
                <div class="ts-secret-section">
                    <dt class="ts-muted">@t("Secret")</dt>
                    <dd class="ts-secret-secret-row">
                        <code class="ts-secret-code">@webhookSecret</code>
                        <button type="button" class="ts-icon-btn" data-copy="@webhookSecret" aria-label='@t("Copy secret")'>@Icons.Copy(15)</button>
                    </dd>
                </div>
            </dl>
            <div class="ts-form-actions">
                <button type="button" class="ts-btn ts-btn-primary ts-btn-lg" data-copy="@webhookSecret"><span data-copy-label>@t("Copy secret")</span></button>
                <a class="ts-btn ts-btn-ghost ts-btn-lg" href="/settings?tab=webhooks">@t("Done")</a>
            </div>
        </div>
    </dialog>
}

@if (Model.Toast is { } toast)
{
    <div class="ts-toasts"><div class="ts-toast"><span class="ts-alert-title">@Icons.CircleCheck(16) @toast</span></div></div>
}
@ShellHtml.Bottom(shell)
