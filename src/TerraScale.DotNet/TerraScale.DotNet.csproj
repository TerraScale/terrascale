<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Build both supported targets with .NET 11, or .NET 10 LTS with an
         older toolchain. Clear the inherited singular TargetFramework so
         multi-target dispatch selects the configured frameworks. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(BundledNETCoreAppTargetFrameworkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0</TargetFrameworks>
    <TargetFramework />
    <PackageId>TerraScale.DotNet</PackageId>
    <Version>0.0.2</Version>
    <Description>Official .NET SDK for TerraBase and ts-auth.</Description>
    <PackageProjectUrl>https://github.com/TerraScale/ts-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TerraScale/ts-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>terrascale;terrabase;database;documents;auth;sdk</PackageTags>
    <PackageReleaseNotes>0.0.2: TerraBase's regional contract. A Region option (lowercase region id) targets https://&lt;region&gt;.api.terrascale.tech and pins every request with X-TerraScale-Region-Pin; a 421 is TerraBaseWrongRegionException with the answering region and the database's home and serving regions; every TerraBaseException carries the answering region. Removed since 0.0.1 (no shim): TerraScale.DotNet.Native (the retired Rust UUID/shard API and its Atlas admission) and the auth client's Atlas discovery (UseReverseProxy, DiscoveryBaseAddress). Supports .NET 10 and .NET 11.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <IncludeSymbols>false</IncludeSymbols>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerraScale.DotNet.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="../../contracts/auth/error-codes.json" LogicalName="TerraScale.DotNet.Auth.error-codes.json" />
    <None Include="../../contracts/auth/**/*" Pack="true" PackagePath="contracts/auth/%(RecursiveDir)" />
    <None Include="../../contracts/terrabase/**/*" Pack="true" PackagePath="contracts/terrabase/%(RecursiveDir)" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="NUlid" Version="1.7.3" />
  </ItemGroup>
</Project>
