<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>TerraScale.DotNet</PackageId>
    <Version>0.1.0</Version>
    <Description>Official .NET SDK for TerraScale database and repository APIs.</Description>
    <PackageProjectUrl>https://git.mariogk.com/TerraScale/TerraScale.DotNet</PackageProjectUrl>
    <RepositoryUrl>https://git.mariogk.com/TerraScale/TerraScale.DotNet</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>terrascale;database;documents;sdk</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-preview.5.26302.115" />
  </ItemGroup>
</Project>
