<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Build both supported targets with .NET 11, or .NET 10 LTS with an
         older toolchain. Clear the inherited singular TargetFramework so
         multi-target dispatch selects the configured frameworks. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(BundledNETCoreAppTargetFrameworkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0</TargetFrameworks>
    <TargetFramework />
    <PackageId>TerraScale.DotNet</PackageId>
    <Version>0.1.0</Version>
    <Description>Official .NET SDK for TerraScale native database and auth APIs.</Description>
    <PackageProjectUrl>https://git.terrascale.tech/TerraScale/ts-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://git.terrascale.tech/TerraScale/ts-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>terrascale;database;documents;native;auth;sdk</PackageTags>
    <PackageReleaseNotes>Native v1 client replaces TerraScaleClient, its options, AddTerraScaleClient, and the obsolete EF provider; use NativeClient and AddTerraScaleAuthClient. Supports .NET 10 and .NET 11. Producer and release qualification remain external gates recorded against immutable package bytes.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="../../contracts/native/**/*" Pack="true" PackagePath="contracts/native" />
    <EmbeddedResource Include="../../contracts/native/client-openapi.json" LogicalName="TerraScale.DotNet.Native.client-openapi.json" />
    <EmbeddedResource Include="../../contracts/native/atomic_vectors.json" LogicalName="TerraScale.DotNet.Native.atomic_vectors.json" />
    <EmbeddedResource Include="../../contracts/native/atlas/native-wire-identity.json" LogicalName="TerraScale.DotNet.Native.atlas.native-wire-identity.json" />
    <EmbeddedResource Include="../../contracts/native/atlas/native-discovery-success.json" LogicalName="TerraScale.DotNet.Native.atlas.native-discovery-success.json" />
    <EmbeddedResource Include="../../contracts/native/atlas/native-discovery-forbidden.json" LogicalName="TerraScale.DotNet.Native.atlas.native-discovery-forbidden.json" />
    <EmbeddedResource Include="../../contracts/auth/error-codes.json" LogicalName="TerraScale.DotNet.Auth.error-codes.json" />
    <None Include="../../contracts/auth/error-codes.json" Pack="true" PackagePath="contracts/auth" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>
</Project>
