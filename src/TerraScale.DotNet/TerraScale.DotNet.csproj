<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-target so net10.0 consumers (the terrabase benchmark lane) can
         reference this project directly while the package keeps its primary
         net11.0 target. Toolchains older than .NET 11 cannot build net11.0, so
         the target list drops it there instead of failing the whole build.
         Clears the singular TargetFramework inherited from Directory.Build.props
         so cross-target dispatch runs; per-TFM inner builds set TargetFramework
         as a global property and are unaffected. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(BundledNETCoreAppTargetFrameworkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0</TargetFrameworks>
    <TargetFramework />
    <PackageId>TerraScale.DotNet</PackageId>
    <Version>0.1.0</Version>
    <Description>Official .NET SDK for TerraScale public APIs.</Description>
    <PackageProjectUrl>https://git.terrascale.tech/TerraScale/TerraScale.DotNet</PackageProjectUrl>
    <RepositoryUrl>https://git.terrascale.tech/TerraScale/TerraScale.DotNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>terrascale;database;documents;projects;auth;notifications;backups;billing;sdk</PackageTags>
    <PackageReleaseNotes>Supports TerraScale public API /api/v1 on .NET 11 preview. Public Alpha API candidate qualification is an external release gate recorded outside the immutable package.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="ZString" Version="2.6.0" />
  </ItemGroup>
</Project>
