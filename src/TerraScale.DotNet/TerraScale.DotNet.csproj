<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>TerraScale.DotNet</PackageId>
    <Version>0.1.0</Version>
    <Description>Official .NET SDK for TerraScale public APIs.</Description>
    <PackageProjectUrl>https://git.terrascale.tech/TerraScale/TerraScale.DotNet</PackageProjectUrl>
    <RepositoryUrl>https://git.terrascale.tech/TerraScale/TerraScale.DotNet</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>terrascale;database;documents;projects;queues;messaging;auth;notifications;backups;billing;stripe;sdk</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
  </ItemGroup>
</Project>
