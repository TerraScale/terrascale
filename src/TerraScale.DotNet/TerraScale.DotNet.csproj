<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Build both supported targets with .NET 11, or .NET 10 LTS with an
         older toolchain. Clear the inherited singular TargetFramework so
         multi-target dispatch selects the configured frameworks. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(BundledNETCoreAppTargetFrameworkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0</TargetFrameworks>
    <TargetFramework />
    <PackageId>TerraScale.DotNet</PackageId>
    <Version>0.0.7</Version>
    <Description>Official .NET SDK for TerraBase and ts-auth.</Description>
    <PackageProjectUrl>https://github.com/TerraScale/ts-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TerraScale/ts-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>terrascale;terrabase;database;documents;auth;sdk</PackageTags>
    <PackageReleaseNotes>0.0.7: Adds receipt-capable account deletion and receipt-only account and organization completion status on TerraScaleAuthClient.Platform, preserving the existing DeleteAccountAsync overload. Validates canonical 32-byte base64url receipts; 401 and unknown receipts remain errors. Also adds TerraBaseQuery.Explain with the typed TerraBaseDocumentPage.Explain result, query shape LatencyBuckets and P95LatencyMs, query aggregates (TerraBaseQuery.Aggregate, TerraBaseDocumentPage.Groups), geo within filters (TerraBaseFilter) and the geo near sort (TerraBaseSort.NearPoint), and project social sign-in providers. Includes 0.0.6: relational SQL on TerraBaseDatabase: ExecuteSqlAsync, QuerySqlAsync and ExecuteSqlBatchAsync (one transaction per request) with positional and named arguments, typed columns and rows (TerraBaseSqlRecord with GetInt64, GetDouble, GetString, GetBoolean), RowsAffected, LastInsertRowid and TerraBaseSqlException (Code, Statement, SqliteCode). Includes 0.0.5 (TerraScaleAuthClient.Projects) and the existing TerraBase and ts-auth clients. Existing APIs are unchanged.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <IncludeSymbols>false</IncludeSymbols>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerraScale.DotNet.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="../../contracts/auth/error-codes.json" LogicalName="TerraScale.DotNet.Auth.error-codes.json" />
    <None Include="../../contracts/auth/**/*" Pack="true" PackagePath="contracts/auth/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../../contracts/terrabase/**/*" Pack="true" PackagePath="contracts/terrabase/%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="NUlid" Version="1.7.3" />
  </ItemGroup>
</Project>
