<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>TerraBase</RootNamespace>
    <AssemblyName>terrabase</AssemblyName>
    <Version>0.1.0</Version>
    <!-- Release artifact: one self-contained, single-file executable running on the
         JIT (no native AOT, no trimming). Native libraries are bundled into the file.
         Self-contained is set only for publish (make publish): the test suites
         reference this project and cannot reference a self-contained executable. -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UserSecretsId />
    <!-- No dynamic PGO (TS-607): on the 1-vCPU gru-1 nodes it doubles JIT time after every start (instrumented tier)
         for no measurable steady-state CPU or latency gain; without it startup and idle CPU and RSS drop. -->
    <TieredPGO>false</TieredPGO>
    <!-- HTTP endpoints, OpenAPI and Scalar from the ts-libs TerraScale.Endpoints package (Directory.Build.targets). -->
    <UseTerraScaleEndpoints>true</UseTerraScaleEndpoints>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Cronos" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="NATS.Client.KeyValueStore" />
    <PackageReference Include="NativeCompressions" />
    <PackageReference Include="Ulid" />
    <PackageReference Include="SqlParserCS" />
  </ItemGroup>

  <ItemGroup>
    <!-- TerraBase's own compile-time rules (TB0001: discarded union results); analyzer only, not in the binary. -->
    <ProjectReference Include="../TerraBase.Analyzers/TerraBase.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Fast suite checks the query plan of every engine statement (Engine/Sqlite/SqliteStatements.cs);
         the shared test harness, linked into both suites, applies the engine's lock-conflict test. -->
    <InternalsVisibleTo Include="TerraBase.Fast" />
    <InternalsVisibleTo Include="TerraBase.Slow" />
  </ItemGroup>

  <ItemGroup>
    <!-- Checked-in, versioned inter-node contract (wire-compatible with terrabase-rust/proto). -->
    <Protobuf Include="Features/Replication/Protos/**/*.proto" ProtoRoot="Features/Replication/Protos" GrpcServices="Both" />
  </ItemGroup>
</Project>
