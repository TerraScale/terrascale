<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>TerraScale.Authentication.Store</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TerraScale.Authentication.Contracts/TerraScale.Authentication.Contracts.csproj" />
    <ProjectReference Include="$(TsDotnetRoot)/src/TerraScale.DotNet/TerraScale.DotNet.csproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>
  <Target Name="EnsureTsDotnet" BeforeTargets="CollectPackageReferences;BeforeBuild" Condition="!Exists('$(TsDotnetRoot)/src/TerraScale.DotNet/TerraScale.DotNet.csproj')">
    <Error Text="ts-dotnet not found at '$(TsDotnetRoot)'. Clone it next to ts-auth or pass -p:TsDotnetRoot=&lt;ts-dotnet checkout&gt;." />
  </Target>
</Project>
