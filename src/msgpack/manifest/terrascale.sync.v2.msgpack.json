{
  "manifestVersion": 1,
  "protocol": "terrascale.sync.v2.msgpack",
  "protocolMajor": 2,
  "protocolMinor": 0,
  "supportedFeatures": 0,
  "doc": "The language-neutral frame contract for the public terrascale.sync.v2 reactive protocol. One binary WebSocket message is one complete MessagePack envelope. Frames carry authorized query-result views and opaque checkpoints only.",
  "envelope": {
    "doc": "Every frame is an indexed array [major, minor, features, tag, correlation, causation, body]. Unknown versions, features, tags, and field shapes fail closed.",
    "elements": [
      { "index": 0, "name": "major", "type": { "kind": "u32" } },
      { "index": 1, "name": "minor", "type": { "kind": "u32" } },
      { "index": 2, "name": "features", "type": { "kind": "u32" } },
      { "index": 3, "name": "tag", "type": { "kind": "u32" } },
      { "index": 4, "name": "correlation", "type": { "kind": "u64" } },
      { "index": 5, "name": "causation", "type": { "kind": "u64" } },
      { "index": 6, "name": "body", "type": { "kind": "message_body" } }
    ]
  },
  "scan": {
    "doc": "Allocation bounds enforced over every frame before any public value is built.",
    "maxMessageBytes": 8388608,
    "maxDepth": 64,
    "maxStringBytes": 262144,
    "maxBinaryBytes": 1048576,
    "maxArrayItems": 10000,
    "maxMapEntries": 0,
    "extensionsAllowed": false,
    "float32Allowed": false
  },
  "types": [
    {
      "struct": {
        "name": "projected_field",
        "doc": "One projected field in an authorized result item.",
        "fields": [
          { "name": "path", "type": { "kind": "text", "maxBytes": 256 } },
          { "name": "value", "type": { "kind": "binary", "minBytes": 0, "maxBytes": 65536 } }
        ]
      }
    },
    {
      "struct": {
        "name": "result_item",
        "doc": "One authorized result item in canonical query order.",
        "fields": [
          { "name": "identity", "type": { "kind": "text", "maxBytes": 256 } },
          {
            "name": "fields",
            "type": { "kind": "array", "maxItems": 1024, "items": { "kind": "ref", "name": "projected_field" } }
          }
        ]
      }
    },
    {
      "struct": {
        "name": "snapshot",
        "doc": "A complete authorized result view at one opaque checkpoint.",
        "fields": [
          { "name": "view_generation", "type": { "kind": "u64" } },
          { "name": "authorization_generation", "type": { "kind": "u64" } },
          { "name": "revision", "type": { "kind": "u64" } },
          {
            "name": "items",
            "type": { "kind": "array", "maxItems": 10000, "items": { "kind": "ref", "name": "result_item" } }
          },
          { "name": "digest", "type": { "kind": "text", "maxBytes": 64 } },
          { "name": "checkpoint", "type": { "kind": "binary", "minBytes": 1, "maxBytes": 4096 } }
        ]
      }
    },
    {
      "struct": {
        "name": "field_change",
        "doc": "One projected field replacement or removal.",
        "fields": [
          { "name": "path", "type": { "kind": "text", "maxBytes": 256 } },
          {
            "name": "value",
            "type": { "kind": "option", "of": { "kind": "binary", "minBytes": 0, "maxBytes": 65536 } }
          }
        ]
      }
    },
    {
      "union": {
        "name": "result_operation",
        "doc": "One ordered mutation of an authorized result view.",
        "variants": [
          {
            "name": "insert",
            "discriminant": 1,
            "fields": [
              { "name": "identity", "type": { "kind": "text", "maxBytes": 256 } },
              { "name": "position", "type": { "kind": "u32" } },
              {
                "name": "fields",
                "type": { "kind": "array", "maxItems": 1024, "items": { "kind": "ref", "name": "projected_field" } }
              }
            ]
          },
          {
            "name": "update",
            "discriminant": 2,
            "fields": [
              { "name": "identity", "type": { "kind": "text", "maxBytes": 256 } },
              {
                "name": "fields",
                "type": { "kind": "array", "maxItems": 1024, "items": { "kind": "ref", "name": "projected_field" } }
              }
            ]
          },
          {
            "name": "patch",
            "discriminant": 3,
            "fields": [
              { "name": "identity", "type": { "kind": "text", "maxBytes": 256 } },
              {
                "name": "changes",
                "type": { "kind": "array", "maxItems": 1024, "items": { "kind": "ref", "name": "field_change" } }
              }
            ]
          },
          {
            "name": "remove",
            "discriminant": 4,
            "fields": [{ "name": "identity", "type": { "kind": "text", "maxBytes": 256 } }]
          },
          {
            "name": "move",
            "discriminant": 5,
            "fields": [
              { "name": "identity", "type": { "kind": "text", "maxBytes": 256 } },
              { "name": "position", "type": { "kind": "u32" } }
            ]
          }
        ]
      }
    },
    {
      "enum": {
        "name": "reset_reason",
        "doc": "Why the server replaced an incremental view with a snapshot.",
        "values": [
          { "name": "checkpoint_expired", "value": 1 },
          { "name": "retention_advanced", "value": 2 },
          { "name": "generation_changed", "value": 3 },
          { "name": "checkpoint_not_current", "value": 4 },
          { "name": "view_diverged", "value": 5 },
          { "name": "oversized", "value": 6 },
          { "name": "invalid_operations", "value": 7 },
          { "name": "invalid_checkpoint", "value": 8 },
          { "name": "backpressure", "value": 9 }
        ]
      }
    },
    {
      "enum": {
        "name": "error_code",
        "doc": "The closed public reactive error vocabulary.",
        "values": [
          { "name": "unsupported_version", "value": 1 },
          { "name": "malformed_frame", "value": 2 },
          { "name": "authentication_expired", "value": 3 },
          { "name": "permission_denied", "value": 4 },
          { "name": "checkpoint_refused", "value": 5 },
          { "name": "slow_consumer", "value": 6 },
          { "name": "overloaded", "value": 7 },
          { "name": "unavailable", "value": 8 }
        ]
      }
    },
    {
      "enum": {
        "name": "backpressure_mode",
        "doc": "The server's bounded-consumer instruction.",
        "values": [
          { "name": "pause", "value": 1 },
          { "name": "resume", "value": 2 }
        ]
      }
    }
  ],
  "messages": [
    {
      "name": "subscribe",
      "tag": 1,
      "direction": "client_to_server",
      "doc": "Open one bounded typed TQL result view, optionally resuming from an opaque checkpoint.",
      "fields": [
        { "name": "subscription", "type": { "kind": "text", "maxBytes": 128 } },
        { "name": "query", "type": { "kind": "text", "maxBytes": 262144 } },
        { "name": "parameters", "type": { "kind": "binary", "minBytes": 0, "maxBytes": 1048576 } },
        {
          "name": "checkpoint",
          "type": { "kind": "option", "of": { "kind": "binary", "minBytes": 1, "maxBytes": 4096 } }
        }
      ]
    },
    {
      "name": "unsubscribe",
      "tag": 2,
      "direction": "client_to_server",
      "doc": "Close one result view.",
      "fields": [{ "name": "subscription", "type": { "kind": "text", "maxBytes": 128 } }]
    },
    {
      "name": "snapshot",
      "tag": 3,
      "direction": "server_to_client",
      "doc": "Install the complete authorized result for one subscription.",
      "fields": [
        { "name": "subscription", "type": { "kind": "text", "maxBytes": 128 } },
        { "name": "snapshot", "type": { "kind": "ref", "name": "snapshot" } }
      ]
    },
    {
      "name": "delta",
      "tag": 4,
      "direction": "server_to_client",
      "doc": "Apply one complete authorized result revision.",
      "fields": [
        { "name": "subscription", "type": { "kind": "text", "maxBytes": 128 } },
        { "name": "view_generation", "type": { "kind": "u64" } },
        { "name": "from_revision", "type": { "kind": "u64" } },
        { "name": "to_revision", "type": { "kind": "u64" } },
        {
          "name": "operations",
          "type": { "kind": "array", "maxItems": 1024, "items": { "kind": "ref", "name": "result_operation" } }
        },
        { "name": "digest", "type": { "kind": "text", "maxBytes": 64 } },
        { "name": "checkpoint", "type": { "kind": "binary", "minBytes": 1, "maxBytes": 4096 } }
      ]
    },
    {
      "name": "reset",
      "tag": 5,
      "direction": "server_to_client",
      "doc": "Replace a view after a gap, expiry, divergence, or backpressure reset.",
      "fields": [
        { "name": "subscription", "type": { "kind": "text", "maxBytes": 128 } },
        { "name": "reason", "type": { "kind": "ref", "name": "reset_reason" } },
        { "name": "snapshot", "type": { "kind": "ref", "name": "snapshot" } }
      ]
    },
    {
      "name": "heartbeat",
      "tag": 6,
      "direction": "bidirectional",
      "doc": "A content-free liveness frame.",
      "fields": []
    },
    {
      "name": "checkpoint_ack",
      "tag": 7,
      "direction": "client_to_server",
      "doc": "Acknowledge the opaque result-view checkpoint now durable at the client.",
      "fields": [
        { "name": "subscription", "type": { "kind": "text", "maxBytes": 128 } },
        { "name": "checkpoint", "type": { "kind": "binary", "minBytes": 1, "maxBytes": 4096 } }
      ]
    },
    {
      "name": "authorization_changed",
      "tag": 8,
      "direction": "server_to_client",
      "doc": "Remove newly forbidden rows and install a result at the new authorization generation.",
      "fields": [
        { "name": "subscription", "type": { "kind": "text", "maxBytes": 128 } },
        { "name": "authorization_generation", "type": { "kind": "u64" } },
        {
          "name": "removed",
          "type": { "kind": "array", "maxItems": 10000, "items": { "kind": "text", "maxBytes": 256 } }
        },
        { "name": "snapshot", "type": { "kind": "ref", "name": "snapshot" } }
      ]
    },
    {
      "name": "region_route_change",
      "tag": 9,
      "direction": "server_to_client",
      "doc": "Tell the transport to re-resolve the API endpoint and resume its opaque checkpoints.",
      "fields": [{ "name": "region", "type": { "kind": "text", "maxBytes": 64 } }]
    },
    {
      "name": "error",
      "tag": 10,
      "direction": "server_to_client",
      "doc": "A typed public reactive failure.",
      "fields": [
        { "name": "code", "type": { "kind": "ref", "name": "error_code" } },
        { "name": "detail", "type": { "kind": "option", "of": { "kind": "text", "maxBytes": 256 } } }
      ]
    },
    {
      "name": "backpressure",
      "tag": 11,
      "direction": "server_to_client",
      "doc": "Pause or resume client-to-server traffic without growing an unbounded queue.",
      "fields": [{ "name": "mode", "type": { "kind": "ref", "name": "backpressure_mode" } }]
    }
  ]
}
