@inherits RazorSlice<ShellModel>
@inject AssetUrls Assets
@using TerraScale.Dashboard.Shared.Databases
@{ var pages = SearchPages().ToArray(); }
<div class="ts-mobile-context" data-attr:inert="$navOpen">
    <span title="@Model.Context.Organization?.Name">Organization: @(Model.Context.Organization?.Name ?? "None selected")</span>
    <span title="@Model.Context.Project?.Name">Project: @(Model.Context.Project?.Name ?? "None selected")</span>
</div>
<aside id="ts-navigation" class="ts-sidebar" aria-label="Primary navigation" tabindex="-1"
       data-attr:role="$navOpen ? 'dialog' : null" data-attr:aria-modal="$navOpen ? 'true' : null"
       data-on:keydown="(() => { if (!$navOpen || evt.key !== 'Tab') return; const controls = [...el.querySelectorAll('a[href], button, input, select, textarea, summary, [tabindex]')].filter(item => item.tabIndex >= 0 &amp;&amp; !item.matches(':disabled') &amp;&amp; item.checkVisibility({visibilityProperty: true}) &amp;&amp; !item.closest('[inert]')); const first = controls[0], last = controls.at(-1); if (!first) { evt.preventDefault(); el.focus(); } else if (evt.shiftKey &amp;&amp; (document.activeElement === first || document.activeElement === el)) { evt.preventDefault(); last.focus(); } else if (!evt.shiftKey &amp;&amp; document.activeElement === last) { evt.preventDefault(); first.focus(); } })()">
    <div class="ts-sidebar-header"><button type="button" id="ts-nav-close" class="ts-sidebar-close ts-icon-btn" aria-label="Close navigation" data-on:click="$navOpen = false; setTimeout(() => document.getElementById('ts-nav-toggle').focus())">@ShellIcons.Svg("x", 18)</button><a class="ts-sidebar-brand" href="/" aria-label="TerraScale dashboard"><img src="@Assets.Url("brand/logo-terrascale-principal.svg")" alt="" aria-hidden="true" decoding="async" /></a>@(await RenderPartialAsync<TerraScale.Dashboard.Shared.UI.Slices.ShellNotificationsBell, ShellModel>(Model))</div>
    @if (Model.Context.Organizations.Count > 0)
    {
        <details class="ts-menu ts-context-menu" data-on:click__outside="el.open = false" data-on:click="evt.target.closest('.ts-menu-panel [type=submit]') &amp;&amp; (el.open = false, el.querySelector('summary').focus())" data-on:keydown__window="evt.key === 'Escape' &amp;&amp; el.open &amp;&amp; (el.open = false, el.querySelector('summary').focus())" data-signals="{organizationSearch: '', projectSearch: ''}">
            <summary class="ts-context-trigger" aria-label="Switch organization or project, current: @(Model.Context.Organization?.Name ?? "none") / @(Model.Context.Project?.Name ?? "none")">
                <span class="ts-context-icon" data-tone="@ShellModel.Tone(Model.Context.Organization?.Name ?? "")" aria-hidden="true">@ShellModel.Initial(Model.Context.Organization?.Name ?? "")</span>
                <span class="ts-context-text"><span class="ts-context-kind">@(Model.Context.Organization?.Name ?? "Choose organization")</span><span class="ts-context-name"><span class="ts-context-dot" data-tone="@ShellModel.Tone(Model.Context.Project?.Name ?? "")" aria-hidden="true"></span><span class="ts-truncate">@(Model.Context.Project?.Name ?? "Choose project")</span></span></span><span class="ts-context-chevron" aria-hidden="true">@ShellIcons.Svg("arrow-up-down", 14)</span>
                @if (Model.Context.Organization is { } current) { <span class="ts-sr-only" data-active-organization-id="@current.Id">Current organization: @current.Name</span> }
                @if (Model.Context.Project is { } activeProject) { <span class="ts-sr-only" data-active-project-id="@activeProject.Id">Current project: @activeProject.Name</span> }
            </summary>
            <div class="ts-menu-panel ts-context-panel"><div class="ts-menu-heading">Organizations</div>
                @if (Model.Context.Organizations.Count > 5) { <input class="ts-input ts-input-sm" id="organizationSearch" type="search" placeholder="Search organizations" aria-label="Search organizations" data-bind="organizationSearch" /> }
                <div class="ts-context-list">@foreach (var org in Model.Context.Organizations)
                {
                    <form method="post" action="/api/v1/dashboard/switch-organization" data-show="$organizationSearch === '' || el.dataset.organizationName.toLowerCase().includes($organizationSearch.toLowerCase())" data-organization-name="@org.Name"><input type="hidden" name="_csrf" value="@Model.CsrfToken" /><input type="hidden" name="organizationId" value="@org.Id" /><input type="hidden" name="returnUrl" value="@Model.ReturnUrl" /><button class="ts-menu-item" type="submit" data-organization-option="@org.Id" aria-current="@(org.Id == Model.Context.Organization?.Id ? "true" : null)"><span class="ts-menu-tile" data-tone="@ShellModel.Tone(org.Name)" aria-hidden="true">@ShellModel.Initial(org.Name)</span><span class="ts-menu-label">@org.Name</span>@if (org.Id == Model.Context.Organization?.Id) { <span class="ts-menu-check" aria-hidden="true">@ShellIcons.Svg("check", 15)</span> }</button></form>
                }</div>
                @if (Model.Context.Organizations.Count > 5)
                {
                    <div class="ts-context-search-empty" data-show="@NoMatches(Model.Context.Organizations.Select(org => org.Name), "$organizationSearch")"><p role="status" aria-live="polite">No organizations match</p><button class="ts-btn ts-btn-ghost ts-btn-sm" type="button" data-on:click="$organizationSearch = ''; document.getElementById('organizationSearch').focus()">Clear search</button></div>
                }
                @if (Model.Context.Organization is { Projects.Count: > 0 } selected)
                {
                    <hr class="ts-menu-separator" /><div class="ts-menu-heading">Projects in @selected.Name</div>
                    @if (selected.Projects.Count > 5) { <input class="ts-input ts-input-sm" id="projectSearch" type="search" placeholder="Search projects" aria-label="Search projects" data-bind="projectSearch" /> }
                    <div class="ts-context-list">@foreach (var project in selected.Projects.Values.OrderBy(item => item.Name))
                    {
                        <form method="post" action="/api/v1/dashboard/switch-project" data-show="$projectSearch === '' || el.dataset.projectName.toLowerCase().includes($projectSearch.toLowerCase())" data-project-name="@project.Name"><input type="hidden" name="_csrf" value="@Model.CsrfToken" /><input type="hidden" name="projectId" value="@project.Id" /><input type="hidden" name="returnUrl" value="@Model.ReturnUrl" /><button class="ts-menu-item" type="submit" data-project-option="@project.Id" aria-current="@(project.Id == Model.Context.Project?.Id ? "true" : null)"><span class="ts-menu-tile" data-tone="@ShellModel.Tone(project.Name)" aria-hidden="true">@ShellModel.Initial(project.Name)</span><span class="ts-menu-label">@project.Name</span>@if (project.Id == Model.Context.Project?.Id) { <span class="ts-menu-check" aria-hidden="true">@ShellIcons.Svg("check", 15)</span> }</button></form>
                    }</div>
                    @if (selected.Projects.Count > 5)
                    {
                        <div class="ts-context-search-empty" data-show="@NoMatches(selected.Projects.Values.Select(project => project.Name), "$projectSearch")"><p role="status" aria-live="polite">No projects match</p><button class="ts-btn ts-btn-ghost ts-btn-sm" type="button" data-on:click="$projectSearch = ''; document.getElementById('projectSearch').focus()">Clear search</button></div>
                    }
                }
                <hr class="ts-menu-separator" /><a class="ts-menu-item" href="/organization?newProject=1#projects" data-tone="emerald">@ShellIcons.Svg("plus", 15)<span class="ts-menu-label">Create new project</span></a><a class="ts-menu-item" href="/organization" data-tone="indigo">@ShellIcons.Svg("boxes", 15)<span class="ts-menu-label">All workspaces</span></a>
            </div>
        </details>
    }
    <button type="button" id="ts-search-toggle" class="ts-search" aria-keyshortcuts="Meta+K Control+K" data-on:click="(() => { if (document.querySelector('dialog[open]')) return; const dialog = document.getElementById('ts-search-dialog'); dialog.returnFocusElement = document.activeElement; dialog.showModal(); })()" data-on:keydown__window="(evt.metaKey || evt.ctrlKey) && evt.key.toLowerCase() === 'k' && (evt.preventDefault(), !$navOpen && el.click())">@ShellIcons.Svg("search", 14)<span>Search pages</span><kbd class="ts-kbd" aria-hidden="true">⌘K</kbd></button>
    <nav class="ts-sidebar-content" aria-label="Dashboard sections"
         data-init="(() => { try { const saved = sessionStorage.getItem('ts-dashboard:nav-scroll'); sessionStorage.removeItem('ts-dashboard:nav-scroll'); const position = JSON.parse(saved); if (position?.href === location.href &amp;&amp; Number.isFinite(position.top) &amp;&amp; position.top >= 0) el.scrollTop = position.top; } catch {} })()"
         data-on:click__window="(() => { const link = evt.target.closest?.('a[href]'); if (evt.defaultPrevented || evt.button !== 0 || evt.metaKey || evt.ctrlKey || evt.shiftKey || evt.altKey || !link || !el.contains(link) || link.hasAttribute('download') || (link.target &amp;&amp; link.target !== '_self') || link.origin !== location.origin || (link.pathname === location.pathname &amp;&amp; link.search === location.search)) return; try { sessionStorage.setItem('ts-dashboard:nav-scroll', JSON.stringify({href: link.href, top: el.scrollTop})); } catch {} })()">
        @foreach (var group in Navigation)
        {
            <div class="ts-nav-group">@if (group.Label.Length > 0) { <div class="ts-nav-group-label">@group.Label</div> }<ul class="ts-nav">@foreach (var item in group.Items)
            {
                <li><a class="ts-nav-link" href="@item.Url" aria-current="@(Active(item.Url) ? "page" : null)" aria-label="@(item.Url == "/organization" && Model.Context.Organizations.Count > 0 ? "Organization, " + (Model.Context.Organizations.Count > 99 ? "99+" : Model.Context.Organizations.Count.ToString()) + (Model.Context.Organizations.Count == 1 ? " organization" : " organizations") : null)"><span class="ts-nav-icon" aria-hidden="true">@ShellIcons.Svg(item.Icon)</span><span class="ts-nav-label">@item.Label</span>@if (item.Url == "/organization" && Model.Context.Organizations.Count > 0) { <span class="ts-nav-count" aria-hidden="true">@(Model.Context.Organizations.Count > 99 ? "99+" : Model.Context.Organizations.Count.ToString())</span> }</a></li>
            }</ul></div>
        }
    </nav>
    <div class="ts-sidebar-links"><a class="ts-nav-link" href="https://docs.terrascale.tech"><span class="ts-nav-icon" aria-hidden="true">@ShellIcons.Svg("book-open")</span><span class="ts-nav-label">Docs</span><span class="ts-nav-external" aria-hidden="true">@ShellIcons.Svg("arrow-up-right", 14)</span></a><a class="ts-nav-link" href="https://status.terrascale.tech"><span class="ts-nav-icon" aria-hidden="true">@ShellIcons.Svg("activity")</span><span class="ts-nav-label">System status</span><span class="ts-nav-external" aria-hidden="true">@ShellIcons.Svg("arrow-up-right", 14)</span></a><a class="ts-nav-link" href="/support" aria-current="@(Model.Title == "Support" ? "page" : null)"><span class="ts-nav-icon" aria-hidden="true">@ShellIcons.Svg("circle-help")</span><span class="ts-nav-label">Contact support</span></a></div>
    <div class="ts-sidebar-footer">
        <details class="ts-menu ts-menu-up ts-account" data-on:click__outside="el.open = false" data-on:click="evt.target.closest('.ts-menu-panel [type=submit]') &amp;&amp; (el.open = false, el.querySelector('summary').focus())" data-on:keydown__window="evt.key === 'Escape' &amp;&amp; el.open &amp;&amp; (el.open = false, el.querySelector('summary').focus())">
            <summary class="ts-account-trigger"><span class="ts-account-avatar" aria-hidden="true">@Model.Initials</span><span class="ts-sr-only">Account menu for </span><span class="ts-account-meta"><span class="ts-account-name">@Model.Context.Account.Name</span><span class="ts-account-email">@Model.Context.Account.Email</span></span><span class="ts-account-chevron" aria-hidden="true">@ShellIcons.Svg("chevron-up", 15)</span></summary>
            <div class="ts-menu-panel"><div class="ts-account-card"><span class="ts-account-avatar ts-account-avatar-lg" aria-hidden="true">@Model.Initials</span><span class="ts-account-meta"><span class="ts-account-name">@Model.Context.Account.Name</span><span class="ts-account-email">@Model.Context.Account.Email</span></span></div><hr class="ts-menu-separator" /><a class="ts-menu-item" href="/profile" data-tone="pink">@ShellIcons.Svg("user-round", 15)<span class="ts-menu-label">Profile</span></a>
            @(await RenderPartialAsync<TerraScale.Dashboard.Shared.UI.Slices.ShellNotificationsMenu, ShellModel>(Model))
            <hr class="ts-menu-separator" /><form method="post" action="/api/v1/auth/logout"><input type="hidden" name="_csrf" value="@Model.CsrfToken" /><button class="ts-menu-item ts-menu-item-danger" type="submit">@ShellIcons.Svg("log-out", 15)<span class="ts-menu-label">Sign out</span></button></form></div>
        </details>
    </div>
</aside>
<dialog id="ts-search-dialog" class="ts-dialog ts-search-dialog" closedby="any" aria-label="Search pages" data-signals="{pageSearch: ''}" data-on:keydown="(() => { if (evt.key === 'Escape') { evt.preventDefault(); evt.stopPropagation(); el.close(); return; } const items = [...el.querySelectorAll('.ts-search-results a')].filter(item => item.checkVisibility()); const at = items.indexOf(document.activeElement); if (items.length === 0) return; if (evt.key === 'Enter' &amp;&amp; at &lt; 0) { evt.preventDefault(); items[0].click(); } else if (evt.key === 'ArrowDown' || evt.key === 'ArrowUp') { evt.preventDefault(); items[evt.key === 'ArrowDown' ? (at + 1) % items.length : at &lt;= 0 ? items.length - 1 : at - 1].focus(); } })()" data-on:close="(() => { $pageSearch = ''; const target = el.returnFocusElement; setTimeout(() => (target?.matches('button, a[href], input, select, textarea, [tabindex]') &amp;&amp; target.checkVisibility() ? target : document.getElementById(innerWidth &lt; 768 &amp;&amp; !$navOpen ? 'ts-nav-toggle' : 'ts-search-toggle')).focus()); })()"><div class="ts-dialog-content"><div class="ts-input-group">@ShellIcons.Svg("search", 14)<input class="ts-input" id="ts-search-input" type="search" placeholder="Search pages" aria-label="Search pages" autofocus data-bind="pageSearch" /></div><div class="ts-search-results">@for (var index = 0; index < pages.Length; index++)
{
    var item = pages[index];
    <a class="ts-menu-item" href="@item.Url" aria-label="@item.Label" aria-describedby="@("ts-page-context-" + index)" data-search-label="@item.SearchLabel" data-show="$pageSearch === '' || el.dataset.searchLabel.toLowerCase().includes($pageSearch.toLowerCase())">@ShellIcons.Svg(item.Icon)<span class="ts-menu-label"><span>@item.Label</span><small class="ts-search-context" id="@("ts-page-context-" + index)">@item.Context</small></span></a>
}<p class="ts-empty" role="status" aria-live="polite" data-show="@NoMatches(pages.Select(item => item.SearchLabel), "$pageSearch")">No pages match</p></div></div></dialog>
@functions {
    private bool Active(string url) => url == "/" ? Model.ReturnUrl == "/" || Model.ReturnUrl.StartsWith("/?") : Model.ReturnUrl.StartsWith(url, StringComparison.Ordinal);
    private sealed record Item(string Label, string Url, string Icon);
    private sealed record Group(string Label, Item[] Items);
    private static readonly Group[] Navigation = [new("", [new("Overview", "/", "layout-dashboard")]), new("Build", [new("Databases", "/databases", "database"), new("Files", "/storage", "database")]), new("Secure", [new("API keys", "/api-keys", "key-round"), new("Authentication", "/auth", "fingerprint")]), new("Manage", [new("Analytics", "/analytics", "line-chart"), new("Usage", "/usage", "chart-column-big"), new("Organization", "/organization", "building2")])];
    private sealed record SearchPage(string Label, string Url, string Icon, string Context)
    {
        public string SearchLabel => Label + " " + Context;
    }
    private static string NoMatches(IEnumerable<string> labels, string query) =>
        $"{query} !== '' && !{System.Text.Json.JsonSerializer.Serialize(labels)}.some(label => label.toLowerCase().includes({query}.toLowerCase()))";
    private IEnumerable<SearchPage> SearchPages()
    {
        var organization = "Organization · " + (Model.Context.Organization?.Name ?? "Choose organization");
        var project = "Project · " + (Model.Context.Organization?.Name ?? "Choose organization") + " / " + (Model.Context.Project?.Name ?? "Choose project");
        foreach (var item in Navigation.SelectMany(group => group.Items))
            yield return new(item.Label, item.Url, item.Icon, item.Url == "/organization" ? organization : project);
        yield return new("Support", "/support", "circle-help", "Help");
        yield return new("Profile", "/profile", "user-round", "Account");
        yield return new("Notifications", "/notifications", "bell", "Account inbox");
        if (Model.Context.Organization is not null)
            foreach (var (key, label) in OrganizationPages)
                yield return new(label, "/organization?tab=" + key, "building2", organization);
        if (Model.Context.Project is null) yield break;
        yield return new("Imports", "/imports", "database", project);
        yield return new("Connect", "/?tab=connect", "database", project);
        yield return new("Query subscriptions", "/subscriptions", "database", project);
        var parts = Model.ReturnUrl.Split('?')[0].Split('/');
        if (parts.Length < 3 || parts[1] != "databases" || !Model.Context.Project.Databases.TryGetValue(Uri.UnescapeDataString(parts[2]), out var database)) yield break;
        var queryAt = Model.ReturnUrl.IndexOf('?');
        var collection = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(queryAt < 0 ? "" : Model.ReturnUrl[queryAt..])["collection"].ToString();
        foreach (var tab in DatabaseFrameModel.Tabs)
            yield return new(tab.Label, DatabaseService.Path(database.Id, tab.Key, tab.Key is "documents" or "sql" or "schema" or "indexes" or "webhooks" ? collection : ""), "database", "Database · " + database.Name + " · " + project);
    }
    private static readonly (string Key, string Label)[] OrganizationPages = [("members", "Members"), ("invitations", "Invitations"), ("projects", "Projects"), ("billing", "Billing"), ("audit", "Audit"), ("sso", "Single sign-on"), ("danger", "Danger zone")];
}
