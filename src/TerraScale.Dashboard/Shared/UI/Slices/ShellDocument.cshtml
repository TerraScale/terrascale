@inherits RazorLayoutSlice<ShellModel>
@inject AssetUrls Assets
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
<!DOCTYPE html>
<html lang="en" data-theme="dark" data-nonce="@Model.Nonce" data-workspace-organization="@Model.Context.Organization?.Id" data-workspace-project="@Model.Context.Project?.Id">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="color-scheme" content="dark" /><meta name="theme-color" content="#151515" />
    <title>@Model.Title · TerraScale</title>
    <link rel="icon" type="image/svg+xml" href="@Assets.Url("brand/logo-icon-blue.svg")" />
    <link rel="preload" href="@Assets.Url("fonts/Geist-Variable.woff2")" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="@Assets.Url("fonts/GeistMono-Variable.woff2")" as="font" type="font/woff2" crossorigin />
    <link id="ts-css" rel="stylesheet" href="@Assets.Url("css/terrascale.css")" data-dashboard-css />
    <script type="module" src="@Assets.Url("js/button-loading.js")" nonce="@Model.Nonce"></script>
    <script type="module" src="@Assets.Url("js/datastar.js")" integrity="@AssetUrls.DatastarIntegrity" crossorigin="anonymous" nonce="@Model.Nonce"></script>
    <script id="ts-table-menu-placement" type="module" nonce="@Model.Nonce">
        // Keep native details/Datastar dismissal and DOM order; only lift the panel's paint layer.
        const open = new Set();
        let pending = 0;
        const place = () => {
            pending = 0;
            for (const menu of open) {
                if (!menu.isConnected || !menu.open) { open.delete(menu); continue; }
                const panel = menu.querySelector(':scope > .ts-menu-panel'), anchor = menu.querySelector('summary').getBoundingClientRect();
                const width = document.documentElement.clientWidth, height = innerHeight;
                panel.style.maxWidth = `${width - 16}px`; panel.style.maxHeight = `${height - 16}px`;
                // A fixed fallback may have the shell's container as its containing block.
                panel.style.left = '0px'; panel.style.top = '0px';
                const origin = panel.getBoundingClientRect();
                const left = menu.classList.contains('ts-menu-end') ? anchor.right - panel.offsetWidth : anchor.left;
                panel.style.left = `${Math.max(8, Math.min(left, width - panel.offsetWidth - 8)) - origin.left}px`;
                panel.style.top = `${(anchor.bottom + 4 + panel.offsetHeight <= height - 8 ? anchor.bottom + 4 : Math.max(8, anchor.top - panel.offsetHeight - 4)) - origin.top}px`;
            }
        };
        document.addEventListener('toggle', evt => {
            const menu = evt.target;
            if (!menu.matches('.ts-table-wrap details.ts-menu')) return;
            const panel = menu.querySelector(':scope > .ts-menu-panel');
            if (!panel) return;
            if (menu.open) {
                if (typeof panel.showPopover === 'function') { panel.popover = 'manual'; panel.showPopover(); }
                open.add(menu); place();
            } else {
                open.delete(menu);
                if (panel.hasAttribute('popover')) { panel.hidePopover(); panel.removeAttribute('popover'); }
            }
        }, true);
        const schedule = () => { if (open.size && !pending) pending = requestAnimationFrame(place); };
        document.addEventListener('scroll', schedule, true);
        addEventListener('resize', schedule);
    </script>
</head>
<body data-signals="{_navPending: false, navOpen: false}" data-class:ts-nav-pending="$_navPending"
      data-on:click__window="$_navPending = $_navPending || !!(!evt.defaultPrevented &amp;&amp; evt.button === 0 &amp;&amp; !evt.metaKey &amp;&amp; !evt.ctrlKey &amp;&amp; !evt.shiftKey &amp;&amp; !evt.altKey &amp;&amp; evt.target.closest &amp;&amp; evt.target.closest('a[href]:not([target]):not([download])') &amp;&amp; evt.target.closest('a[href]').origin === location.origin &amp;&amp; (evt.target.closest('a[href]').pathname !== location.pathname || evt.target.closest('a[href]').search !== location.search))"
      data-on:submit__window="evt.target.hasAttribute('data-submit-once') &amp;&amp; $_navPending ? evt.preventDefault() : ($_navPending = $_navPending || (!evt.defaultPrevented &amp;&amp; evt.target.method !== 'dialog' &amp;&amp; !evt.target.target))"
      data-on:pageshow__window="$_navPending = false" data-on:keydown__window="evt.key === 'Escape' &amp;&amp; ($_navPending = false)"
      data-page-url="@(HttpContext?.Request.Path.StartsWithSegments("/api") == true ? Model.ReturnUrl : null)" data-init="el.dataset.pageUrl &amp;&amp; history.replaceState(null, '', el.dataset.pageUrl)">
    <a class="ts-skip-link" href="#ts-main" data-attr:inert="$navOpen">Skip to main content</a>
    <div class="ts-shell" data-class:nav-open="$navOpen"
         data-on:keydown__window="evt.key === 'Escape' &amp;&amp; $navOpen &amp;&amp; !document.querySelector('dialog[open]') &amp;&amp; ($navOpen = false, setTimeout(() => document.getElementById('ts-nav-toggle').focus()))"
         data-on:resize__window__debounce.150ms="innerWidth >= 768 &amp;&amp; $navOpen &amp;&amp; ($navOpen = false, setTimeout(() => document.getElementById('ts-navigation').focus()))">
        <button type="button" id="ts-nav-toggle" class="ts-icon-btn ts-fab-nav" aria-label="Open navigation" aria-controls="ts-navigation" aria-expanded="false" data-on:click="$navOpen = true; setTimeout(() => document.getElementById('ts-nav-close').focus())" data-attr:aria-expanded="$navOpen ? 'true' : 'false'">@ShellIcons.Svg("panel-left", 18)</button>
        <div class="ts-nav-backdrop" aria-hidden="true" data-on:click="$navOpen = false; setTimeout(() => document.getElementById('ts-nav-toggle').focus())"></div>
        @(await RenderPartialAsync<TerraScale.Dashboard.Shared.UI.Slices.ShellSidebar, ShellModel>(Model))
        <div class="ts-inset" data-attr:inert="$navOpen">
            <div id="ts-main" class="ts-main" tabindex="-1">@await RenderBodyAsync()</div>
        </div>
    </div>
    <dialog id="ts-notifications-dialog" class="ts-dialog" closedby="any" aria-labelledby="ts-notifications-dialog-title"
            data-signals="{_notificationsPending: 0, _notificationsLoaded: false}"
            data-on:datastar-fetch="(evt.detail.el.getAttribute('data-on:click')?.includes('/notifications/dialog') || evt.detail.el.getAttribute('data-on:submit')?.includes('/api/v1/notifications/')) &amp;&amp; (evt.detail.type === 'started' ? ($_notificationsPending++, $_notificationsLoaded = false) : evt.detail.type === 'finished' ? $_notificationsPending = Math.max(0, $_notificationsPending - 1) : evt.detail.type === 'datastar-patch-elements' ? $_notificationsLoaded = true : null)"
            data-on:close="el.dataset.returnFocusSelector &amp;&amp; document.querySelector(el.dataset.returnFocusSelector)?.focus()">
        <div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="ts-notifications-dialog-title">Notifications</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="ts-notifications-dialog">@ShellIcons.Svg("x", 18)</button></header>
            <p role="status" aria-live="polite" aria-atomic="true" data-text="$_notificationsPending ? 'Loading notifications…' : ($_notificationsLoaded ? '' : 'Unable to load notifications. Please try again.')"></p>
            <div class="ts-row" data-show="!$_notificationsPending &amp;&amp; !$_notificationsLoaded">
                <button class="ts-btn ts-btn-ghost" type="button" data-on:click="@@get('/notifications/dialog', {retryMaxCount: 0})">Retry</button>
                <a class="ts-btn ts-btn-ghost" href="/notifications">Open inbox</a>
            </div>
            <div id="ts-notifications-body" aria-busy="false" data-attr:aria-busy="$_notificationsPending ? 'true' : 'false'" data-show="!$_notificationsPending &amp;&amp; $_notificationsLoaded"></div>
        </div>
    </dialog>
    @if (HostEnvironment.IsDevelopment())
    {
        <div id="ts-dev-updates" hidden data-signals="{_devBoot: '', _devFirstBoot: '', _devRevision: -1, _devFirstRevision: -1, _devCss: '', _devFirstCss: '', _devJs: '', _devFirstJs: ''}"
             data-attr:data-dev-ready="$_devBoot ? 'true' : 'false'" data-init="@@get('/__dev/events', {openWhenHidden: true, retryMaxCount: 1000})"
             data-effect="$_devBoot &amp;&amp; ($_devFirstBoot = $_devFirstBoot || $_devBoot) !== $_devBoot &amp;&amp; location.reload(); $_devRevision >= 0 &amp;&amp; ($_devFirstRevision = $_devFirstRevision === -1 ? $_devRevision : $_devFirstRevision) !== $_devRevision &amp;&amp; location.reload(); $_devCss &amp;&amp; ($_devFirstCss = $_devFirstCss || $_devCss) !== $_devCss &amp;&amp; (document.getElementById('ts-css').href = '/css/terrascale.css?v=' + $_devCss, $_devFirstCss = $_devCss); $_devJs &amp;&amp; ($_devFirstJs = $_devFirstJs || $_devJs) !== $_devJs &amp;&amp; location.reload()"></div>
    }
</body></html>
