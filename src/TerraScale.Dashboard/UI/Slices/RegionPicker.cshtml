@inherits RazorSlice<RegionMapField>
@inject AssetUrls Assets
<div class="ts-region-map" role="group" aria-label="Choose regions on the map" data-select-id="@Model.SelectId" data-selected="@Model.Selected" data-init="@Model.Sync" data-on:change__window="@Model.Change">
    <img class="ts-region-map-image" src="@Assets.Url("brand/region-map.svg")" alt="" loading="lazy" decoding="async" />
    @foreach (var pin in new[] { (Code: "SFO", Name: "San Francisco", Country: "us"), (Code: "GRU", Name: "São Paulo", Country: "br") })
    {
        @if (Model.Shows(pin.Code))
        {
            <button type="button" class="ts-region-node" data-region="@pin.Code" aria-label="@($"{pin.Name} ({pin.Code})")" aria-pressed="@(Model.Selected.Split(' ').Contains(pin.Code) ? "true" : "false")" data-on:click="@Model.Pick" aria-description="@Model.Ping(pin.Code)">
                <img class="ts-region-node-flag" src="@Assets.Url($"flags/{pin.Country}.svg")" alt="" aria-hidden="true" />
                <span class="ts-region-node-ring" aria-hidden="true"></span><span class="ts-region-node-core" aria-hidden="true"></span>
                <span class="ts-region-node-label" aria-hidden="true"><strong>@pin.Name</strong>
                    @if (Model.Ping(pin.Code) is { Length: > 0 } ping) { <span class="ts-region-node-ping">@ping</span> }
                </span>
            </button>
        }
    }
</div>
