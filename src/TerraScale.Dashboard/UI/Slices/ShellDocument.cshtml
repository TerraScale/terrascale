@inherits RazorLayoutSlice<ShellModel>
@inject AssetUrls Assets
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
<!DOCTYPE html>
<html lang="@Model.Context.Account.Locale" data-theme="@Theme" data-nonce="@Model.Nonce">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" /><meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a" />
    <title>@Model.Title · TerraScale</title>
    <link rel="icon" type="image/svg+xml" href="@Assets.Url("brand/logo-icon-blue.svg")" />
    <link rel="preload" href="@Assets.Url("fonts/Geist-Variable.woff2")" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="@Assets.Url("fonts/GeistMono-Variable.woff2")" as="font" type="font/woff2" crossorigin />
    <link id="ts-css" rel="stylesheet" href="@Assets.Url("css/terrascale.css")" data-dashboard-css />
    <script nonce="@Model.Nonce">window.tsMode = () => { const scheme = getComputedStyle(document.documentElement).colorScheme; document.documentElement.dataset.mode = scheme.includes("light") && scheme.includes("dark") ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : scheme.includes("light") ? "light" : "dark"; }; tsMode();</script>
    <script type="module" src="@Assets.Url("js/button-loading.js")" nonce="@Model.Nonce"></script>
    <script type="module" src="@Assets.Url("js/datastar.js")" integrity="@AssetUrls.DatastarIntegrity" crossorigin="anonymous" nonce="@Model.Nonce"></script>
</head>
<body data-signals="{_navPending: false, navOpen: false}" data-class:ts-nav-pending="$_navPending"
      data-on:click__window="$_navPending = $_navPending || !!(!evt.defaultPrevented &amp;&amp; evt.button === 0 &amp;&amp; !evt.metaKey &amp;&amp; !evt.ctrlKey &amp;&amp; !evt.shiftKey &amp;&amp; !evt.altKey &amp;&amp; evt.target.closest &amp;&amp; evt.target.closest('a[href]:not([target]):not([download])') &amp;&amp; evt.target.closest('a[href]').origin === location.origin &amp;&amp; (evt.target.closest('a[href]').pathname !== location.pathname || evt.target.closest('a[href]').search !== location.search))"
      data-on:submit__window="evt.target.hasAttribute('data-submit-once') &amp;&amp; $_navPending ? evt.preventDefault() : ($_navPending = $_navPending || (!evt.defaultPrevented &amp;&amp; evt.target.method !== 'dialog' &amp;&amp; !evt.target.target))"
      data-on:pageshow__window="$_navPending = false" data-on:keydown__window="evt.key === 'Escape' &amp;&amp; ($_navPending = false)">
    <a class="ts-skip-link" href="#ts-main" data-attr:inert="$navOpen">Skip to main content</a>
    <div class="ts-shell" data-class:nav-open="$navOpen"
         data-on:keydown__window="evt.key === 'Escape' &amp;&amp; $navOpen &amp;&amp; !document.querySelector('dialog[open]') &amp;&amp; ($navOpen = false, setTimeout(() => document.getElementById('ts-nav-toggle').focus()))"
         data-on:resize__window__debounce.150ms="innerWidth >= 768 &amp;&amp; $navOpen &amp;&amp; ($navOpen = false, setTimeout(() => document.getElementById('ts-navigation').focus()))">
        <div class="ts-nav-backdrop" aria-hidden="true" data-on:click="$navOpen = false; setTimeout(() => document.getElementById('ts-nav-toggle').focus())"></div>
        @(await RenderPartialAsync<TerraScale.Dashboard.UI.Slices.ShellSidebar, ShellModel>(Model))
        <div class="ts-inset" data-attr:inert="$navOpen">
            <header class="ts-topbar"><button type="button" id="ts-nav-toggle" class="ts-icon-btn ts-fab-nav" aria-label="Open navigation" aria-controls="ts-navigation" aria-expanded="false" data-on:click="$navOpen = true; setTimeout(() => document.getElementById('ts-nav-close').focus())" data-attr:aria-expanded="$navOpen ? 'true' : 'false'">@ShellIcons.Svg("panel-left", 18)</button>
            <img class="ts-topbar-brand ts-logo-on-dark" src="@Assets.Url("brand/logo-terrascale-principal.svg")" alt="TerraScale" decoding="async" /><img class="ts-topbar-brand ts-logo-on-light" src="@Assets.Url("brand/logo-terrascale-blue.svg")" alt="TerraScale" decoding="async" />
            @(await RenderPartialAsync<TerraScale.Dashboard.UI.Slices.ShellNotificationsBell, ShellModel>(Model))</header>
            <div id="ts-main" class="ts-main" tabindex="-1">@await RenderBodyAsync()</div>
        </div>
    </div>
    <dialog id="ts-notifications-dialog" class="ts-dialog" closedby="any" aria-labelledby="ts-notifications-dialog-title" data-on:close="el.dataset.returnFocusSelector &amp;&amp; document.querySelector(el.dataset.returnFocusSelector)?.focus()"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="ts-notifications-dialog-title">Notifications</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="ts-notifications-dialog">@ShellIcons.Svg("x", 18)</button></header><div id="ts-notifications-body"></div></div></dialog>
    @if (HostEnvironment.IsDevelopment())
    {
        <div id="ts-dev-updates" hidden data-signals="{_devBoot: '', _devFirstBoot: '', _devRevision: -1, _devFirstRevision: -1, _devCss: '', _devFirstCss: '', _devJs: '', _devFirstJs: ''}"
             data-attr:data-dev-ready="$_devBoot ? 'true' : 'false'" data-init="@@get('/__dev/events', {openWhenHidden: true, retryMaxCount: 1000})"
             data-effect="$_devBoot &amp;&amp; ($_devFirstBoot = $_devFirstBoot || $_devBoot) !== $_devBoot &amp;&amp; location.reload(); $_devRevision >= 0 &amp;&amp; ($_devFirstRevision = $_devFirstRevision === -1 ? $_devRevision : $_devFirstRevision) !== $_devRevision &amp;&amp; location.reload(); $_devCss &amp;&amp; ($_devFirstCss = $_devFirstCss || $_devCss) !== $_devCss &amp;&amp; (document.getElementById('ts-css').href = '/css/terrascale.css?v=' + $_devCss, $_devFirstCss = $_devCss); $_devJs &amp;&amp; ($_devFirstJs = $_devFirstJs || $_devJs) !== $_devJs &amp;&amp; location.reload()"></div>
    }
</body></html>
@functions {
    // Light, Dark or System from the account menu; no cookie keeps the token file's default mode.
    private string? Theme => HttpContext?.Request.Cookies["ts-theme"] is ("light" or "dark" or "system") and var theme ? theme : null;
}
