<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU1900: vulnerability audit needs the network; CI builds offline. -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <RootNamespace>TerraScale.Dashboard</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RazorSlices" Version="0.11.3" />
    <PackageReference Include="Stripe.net" Version="52.4.2" />
    <ProjectReference Include="../TerraScale.Datastar/TerraScale.Datastar.csproj" />
  </ItemGroup>

  <!-- Prefer the sibling ts-libs checkout; fall back to the vendored nuget/ package. -->
  <ItemGroup Condition="Exists('../../../ts-libs/src/TerraScale.Endpoints/TerraScale.Endpoints.csproj')">
    <ProjectReference Include="../../../ts-libs/src/TerraScale.Endpoints/TerraScale.Endpoints.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../ts-libs/src/TerraScale.Endpoints/TerraScale.Endpoints.csproj')">
    <PackageReference Include="TerraScale.Endpoints" Version="1.1.0" />
  </ItemGroup>

  <!-- Prefer the sibling ts-dotnet SDK checkout during workspace development. -->
  <PropertyGroup Condition="Exists('../../../ts-dotnet/src/TerraScale.DotNet/TerraScale.DotNet.csproj')">
    <DefineConstants>$(DefineConstants);TERRABASE_SDK</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('../../../ts-dotnet/src/TerraScale.DotNet/TerraScale.DotNet.csproj')">
    <ProjectReference Include="../../../ts-dotnet/src/TerraScale.DotNet/TerraScale.DotNet.csproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

  <!-- Docker and CI build from this repository alone. Keep the same SDK
       surface in those builds instead of silently compiling out live mode. -->
  <PropertyGroup Condition="!Exists('../../../ts-dotnet/src/TerraScale.DotNet/TerraScale.DotNet.csproj')">
    <DefineConstants>$(DefineConstants);TERRABASE_SDK</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="!Exists('../../../ts-dotnet/src/TerraScale.DotNet/TerraScale.DotNet.csproj')">
    <PackageReference Include="TerraScale.DotNet" Version="0.1.0" />
  </ItemGroup>

  <!-- Stylesheet: lightningcss bundles Styles/terrascale.css and the partials it
       imports (Styles/**, Features/**/*.css) into wwwroot/css/terrascale.css, which
       is gitignored build output. Every build refreshes it when a partial changed;
       under dotnet watch, CssWatcher keeps it current between builds. Docker
       builds the minified file in its node stage and passes SkipCssBuild=true. -->
  <ItemGroup>
    <CssPartial Include="Styles/**/*.css;Features/**/*.css" />
    <!-- dotnet watch tracks source partials so its static asset hot reload can
         apply the generated file after the in-process CSS watcher rebuilds it. -->
    <Watch Include="Styles/**/*.css;Features/**/*.css" />
    <!-- Declared explicitly so a clean checkout, where the file does not exist
         yet at evaluation time, still serves it as a static web asset. -->
    <Content Remove="wwwroot/css/terrascale.css" />
    <Content Include="wwwroot/css/terrascale.css" />
  </ItemGroup>

  <Target Name="BuildCss" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(SkipCssBuild)' != 'true'"
          Inputs="@(CssPartial);$(MSBuildProjectDirectory)/../../scripts/build-css.mjs;$(MSBuildProjectDirectory)/../../package-lock.json"
          Outputs="$(MSBuildProjectDirectory)/wwwroot/css/terrascale.css">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)/../.."
          Condition="!Exists('$(MSBuildProjectDirectory)/../../node_modules/lightningcss')" />
    <Exec Command="node scripts/build-css.mjs --dev" WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
  </Target>

</Project>
