<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <RootNamespace>TerraScale.Dashboard</RootNamespace>
    <AssemblyName>TerraScale.Dashboard</AssemblyName>
    <WebRoot>web/static</WebRoot>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../sites/landing/static/pricing.json" LogicalName="TerraScale.Dashboard.Common.Accounts.pricing.json" />
    <Content Include="../../sites/landing/static/pricing.json" Link="Common/Accounts/pricing.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Cronos" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="RazorSlices" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Stripe.net" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Dapper.AOT" />
    <PackageReference Include="dbup-core" />
    <PackageReference Include="Ulid" />
    <ProjectReference Include="../TerraScale.Endpoints/TerraScale.Endpoints.csproj" />
    <ProjectReference Include="../TerraScale.Contracts/TerraScale.Contracts.csproj" />
    <ProjectReference Include="../../sdk/dotnet/src/TerraScale.DotNet/TerraScale.DotNet.csproj" />
    <EmbeddedResource Include="Platform/Persistence/Schema/*.sql" LogicalName="TerraScale.Dashboard.Schema.%(Filename)%(Extension)" />
    <Content Remove="web/package.json;web/package-lock.json" />
    <None Update="**/*" Watch="false" />
    <Content Include="web/static/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="web/static/**/*" Watch="false" />
    <Watch Include="web/assets/**/*" />
    <Watch Include="Features/**/*.css" />
  </ItemGroup>
  <Target Name="BundleDashboardAssets" BeforeTargets="PrepareForBuild">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/web" Command="npm ci --ignore-scripts" Condition="!Exists('web/node_modules/lightningcss/package.json')" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/web" Command="node build/build-css.mjs" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/web" Command="node build/build-js.mjs" />
    <ItemGroup>
      <Content Remove="web/static/js/**" />
      <Content Include="web/static/js/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Watch="false" />
    </ItemGroup>
  </Target>
</Project>
