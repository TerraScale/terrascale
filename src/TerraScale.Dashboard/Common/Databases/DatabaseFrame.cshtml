@inherits RazorSlice<TerraScale.Dashboard.Common.Databases.DatabaseFrameModel>
@using TerraScale.Dashboard.Features.Databases
@inject AssetUrls Assets
<header class="ts-db-head"><nav class="ts-breadcrumb" aria-label="Breadcrumb"><a href="/databases">Databases</a><span aria-hidden="true">/</span><span aria-current="page">@Model.Database.Name</span></nav>
<div class="ts-db-identity"><div class="ts-db-meta"><div class="ts-menu ts-db-switch"><button class="ts-db-switcher" type="button" popovertarget="db-switcher"><span class="ts-db-icon" aria-hidden="true">@Icons.Render("Database",18)</span><span class="ts-db-title">@Model.Database.Name</span>@Icons.Render("ChevronDown",14)</button><div class="ts-menu-panel" id="db-switcher" popover="auto" role="group" aria-label="Databases"><div class="ts-menu-heading">Databases</div>@foreach(var database in Model.Switchable){<a class="ts-menu-item" href="@DatabaseService.Path(database.Id, DatabaseFrameModel.IsMore(Model.Tab) ? "overview" : Model.Tab)" aria-current="@(database.Id == Model.Database.Id ? "page" : null)">@Icons.Render("Database",15)<span class="ts-mono">@database.Name</span></a>}<hr class="ts-menu-separator" /><a class="ts-menu-item" href="/databases">@Icons.Render("Layers",15)<span>All databases</span></a></div></div>
<span class="ts-badge ts-badge-tone" data-tone="@DatabasesPage.Tone(Model.Database.Status)"><span class="ts-dot" aria-hidden="true"></span>@Model.Database.Status</span>
<span class="ts-db-copy" data-signals="{_dbFrameIdCopy: ''}"><button class="ts-db-id" type="button" value="@Model.Database.Id" aria-label="@("Copy database ID " + Model.Database.Id)" aria-describedby="db-frame-id-status" data-on:click="$_dbFrameIdCopy = 'Copying…'; Promise.resolve().then(() => navigator.clipboard.writeText(el.value)).then(() => $_dbFrameIdCopy = 'Copied', () => $_dbFrameIdCopy = 'Copy failed. Select and copy it manually.')">@Icons.Render("Copy",12)<span class="ts-mono">@Model.Database.Id</span></button><span class="ts-meta" id="db-frame-id-status" role="status" aria-live="polite" aria-atomic="true" data-text="$_dbFrameIdCopy"></span></span>
<span class="ts-db-chips">@foreach(var region in Model.Regions){var label = region.ToLowerInvariant();var country = Regions.Country(label);<a class="ts-db-region" href="@DatabaseService.Path(Model.Database.Id, "replication")" data-region="@label" title="@DatabasesPage.RegionDisplay(region)">@if(country.Length > 0){<img class="ts-db-region-flag" src="@Assets.Url("flags/" + country + ".svg")" alt="" aria-hidden="true" />}<span class="ts-mono">@label</span></a>}</span></div>
<div class="ts-db-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="@DatabaseService.Path(Model.Database.Id, "connect")">@Icons.Render("Zap",14)<span>Connect</span></a><a class="ts-btn ts-btn-primary ts-btn-sm" href="@DatabaseService.Path(Model.Database.Id, "sql")">@Icons.Render("Terminal",14)<span>SQL editor</span></a></div></div></header>
<nav class="ts-tabs ts-db-tabs" aria-label="Database sections">@foreach(var tab in Model.Primary){<a class="ts-tab" href="@DatabaseService.Path(Model.Database.Id, tab.Key)" aria-current="@(Model.Tab == tab.Key ? "page" : null)"><span>@tab.Label</span></a>}<div class="ts-menu ts-menu-end ts-db-more"><button class="ts-tab" type="button" popovertarget="db-more" data-active="@(DatabaseFrameModel.IsMore(Model.Tab) ? "true" : "false")"><span>More</span>@Icons.Render("ChevronDown",14)</button><div class="ts-menu-panel" id="db-more" popover="auto" role="group" aria-label="More database sections">@foreach(var tab in Model.More){<a class="@(tab.Key == "danger" ? "ts-menu-item ts-menu-item-danger" : "ts-menu-item")" href="@DatabaseService.Path(Model.Database.Id, tab.Key)" aria-current="@(Model.Tab == tab.Key ? "page" : null)">@tab.Label</a>}</div></div></nav>
@if(Model.Database.ConflictOf is not null && Model.Database.PreviousName is { } previousName){<div class="ts-alert ts-alert-warning" id="database-name-conflict" role="status"><p class="ts-alert-title">Renamed after a name conflict</p><p class="ts-alert-body">The name <strong>@previousName</strong> was claimed concurrently in another region. This database is now <strong>@Model.Database.Name</strong>. Its ID, data, files, backups and keys are preserved. Update name-based connection strings, or choose another name in Settings.</p></div>}
