@inherits RazorSlice<TerraScale.Dashboard.Common.UI.McpClientConfig>
<div class="ts-snippet" data-signals="@("{_" + Model.Id + "Copy: ''}")"><div class="ts-snippet-header ts-row-between"><span>mcp.json</span><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-on:click="@("(navigator.clipboard?.writeText(document.getElementById('" + Model.Id + "-mcp-json').textContent) ?? Promise.reject()).then(() => { $_" + Model.Id + "Copy = 'Copied'; setTimeout(() => $_" + Model.Id + "Copy = '', 2000) }, () => $_" + Model.Id + "Copy = 'Copy failed')")">@Icons.Render("Copy", 14)<span data-text="@("$_" + Model.Id + "Copy || 'Copy'")">Copy</span></button></div><pre class="ts-snippet-body" id="@(Model.Id + "-mcp-json")"><code>@Model.Json</code></pre></div>
