@inherits RazorSlice<ShellModel>
@inject AssetUrls Assets
@using TerraScale.Dashboard.Common.Databases
@{ var pages = SearchPages().ToArray(); var creates = CreateActions().ToArray(); }
<aside id="ts-navigation" class="ts-sidebar" aria-label="Primary navigation" tabindex="-1"
       data-attr:role="$navOpen ? 'dialog' : null" data-attr:aria-modal="$navOpen ? 'true' : null"
       data-on:keydown="(() => { if (!$navOpen || evt.key !== 'Tab') return; const controls = [...el.querySelectorAll('a[href], button, input, select, textarea, summary, [tabindex]')].filter(item => item.tabIndex >= 0 &amp;&amp; !item.matches(':disabled') &amp;&amp; item.checkVisibility({visibilityProperty: true}) &amp;&amp; !item.closest('[inert]')); const first = controls[0], last = controls.at(-1); if (!first) { evt.preventDefault(); el.focus(); } else if (evt.shiftKey &amp;&amp; (document.activeElement === first || document.activeElement === el)) { evt.preventDefault(); last.focus(); } else if (!evt.shiftKey &amp;&amp; document.activeElement === last) { evt.preventDefault(); first.focus(); } })()">
    <div class="ts-sidebar-header"><a class="ts-sidebar-brand" href="/" aria-label="TerraScale dashboard"><img src="@Assets.Url("brand/logo-terrascale-principal.svg")" alt="" aria-hidden="true" decoding="async" /></a><button type="button" id="ts-nav-close" class="ts-sidebar-close ts-icon-btn" aria-label="Close navigation" data-on:click="$navOpen = false; setTimeout(() => document.getElementById('ts-nav-toggle').focus())">@ShellIcons.Svg("x")</button></div>
    <nav class="ts-sidebar-content" aria-label="Dashboard sections"
         data-init="(() => { try { const saved = sessionStorage.getItem('ts-dashboard:nav-scroll'); sessionStorage.removeItem('ts-dashboard:nav-scroll'); const position = JSON.parse(saved); if (position?.href === location.href &amp;&amp; Number.isFinite(position.top) &amp;&amp; position.top >= 0) el.scrollTop = position.top; } catch {} })()"
         data-on:click__window="(() => { const link = evt.target.closest?.('a[href]'); if (evt.defaultPrevented || evt.button !== 0 || evt.metaKey || evt.ctrlKey || evt.shiftKey || evt.altKey || !link || !el.contains(link) || link.hasAttribute('download') || (link.target &amp;&amp; link.target !== '_self') || link.origin !== location.origin || (link.pathname === location.pathname &amp;&amp; link.search === location.search)) return; try { sessionStorage.setItem('ts-dashboard:nav-scroll', JSON.stringify({href: link.href, top: el.scrollTop})); } catch {} })()">
        @foreach (var group in Groups)
        {
            <div class="ts-nav-group">@if (group.Label.Length > 0) { <div class="ts-nav-group-label">@group.Label</div> }<ul class="ts-nav">@foreach (var item in group.Items)
            {
                <li><a class="ts-nav-link" href="@item.Url" aria-current="@(Active(item.Url) ? "page" : null)"><span class="ts-nav-icon" aria-hidden="true">@ShellIcons.Svg(item.Icon)</span><span class="ts-nav-label">@item.Label</span>@if (item.Url == "/databases" && DatabaseCount > 0) { <span class="ts-nav-count" aria-hidden="true">@ShellModel.Count(DatabaseCount)</span> }</a></li>
            }</ul></div>
        }
    </nav>
    <div class="ts-sidebar-links"><a class="ts-nav-link" href="https://docs.terrascale.tech" @(ExternalLink.Attributes)><span class="ts-nav-icon" aria-hidden="true">@ShellIcons.Svg("book-open")</span><span class="ts-nav-label">Docs</span><span class="ts-nav-trailing" aria-hidden="true">@ShellIcons.Svg("arrow-up-right", 14)</span>@(ExternalLink.Hint)</a><a class="ts-nav-link" href="https://status.terrascale.tech" @(ExternalLink.Attributes)><span class="ts-nav-icon" aria-hidden="true">@ShellIcons.Svg("activity")</span><span class="ts-nav-label">System status</span><span class="ts-nav-trailing" aria-hidden="true">@ShellIcons.Svg("arrow-up-right", 14)</span>@(ExternalLink.Hint)</a><a class="ts-nav-link" href="/support" aria-current="@(Active("/support") ? "page" : null)"><span class="ts-nav-icon" aria-hidden="true">@ShellIcons.Svg("circle-help")</span><span class="ts-nav-label">Contact support</span></a></div>
    <div class="ts-sidebar-footer">
        <div class="ts-menu ts-menu-up ts-account">
            @(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.ShellAccountTrigger, ShellModel>(Model))
            <div class="ts-menu-panel" id="ts-account-menu" popover="auto" role="group" aria-label="Account"><div class="ts-account-card"><span class="ts-account-avatar ts-account-avatar-lg" aria-hidden="true">@Model.Initials</span><span class="ts-account-meta"><span class="ts-account-name">@Model.Context.Account.Name</span><span class="ts-account-email">@Model.Context.Account.Email</span></span></div><hr class="ts-menu-separator" /><a class="ts-menu-item" href="/profile">@ShellIcons.Svg("user-round")<span class="ts-menu-label">Profile</span></a>
            @(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.ShellNotificationsMenu, ShellModel>(Model))
            <hr class="ts-menu-separator" /><form method="post" action="/api/v1/auth/logout"><input type="hidden" name="_csrf" value="@Model.CsrfToken" /><button class="ts-menu-item ts-menu-item-danger" type="submit">@ShellIcons.Svg("log-out")<span class="ts-menu-label">Sign out</span></button></form></div>
        </div>
    </div>
</aside>
<header class="ts-topbar" data-attr:inert="$navOpen">
    <button type="button" id="ts-nav-toggle" class="ts-icon-btn ts-topbar-nav" aria-label="Open navigation" aria-controls="ts-navigation" aria-expanded="false" data-on:click="$navOpen = true; setTimeout(() => document.getElementById('ts-nav-close').focus())" data-attr:aria-expanded="$navOpen ? 'true' : 'false'">@ShellIcons.Svg("panel-left", 18)</button>
    @if (Model.Context.Organizations.Count > 0)
    {
        <div class="ts-menu ts-context-menu" data-signals="{organizationSearch: '', projectSearch: ''}">
            @(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.ShellContextTrigger, ShellModel>(Model))
            <div class="ts-menu-panel" id="ts-context-menu" popover="auto" role="group" aria-label="Organizations and projects"><div class="ts-menu-heading">Organizations</div>
                @if (Model.Context.Organizations.Count > 5) { <input class="ts-input ts-input-sm" id="organizationSearch" type="search" placeholder="Search organizations" aria-label="Search organizations" data-bind="organizationSearch" /> }
                <div class="ts-context-list">@foreach (var org in Model.Context.Organizations)
                {
                    <form method="post" action="/api/v1/dashboard/switch-organization" data-show="$organizationSearch === '' || el.dataset.organizationName.toLowerCase().includes($organizationSearch.toLowerCase())" data-organization-name="@org.Name"><input type="hidden" name="_csrf" value="@Model.CsrfToken" /><input type="hidden" name="organizationId" value="@org.Id" /><input type="hidden" name="returnUrl" value="@Model.ReturnUrl" /><button class="ts-menu-item" type="submit" data-organization-option="@org.Id" aria-current="@(org.Id == Model.Context.Organization?.Id ? "true" : null)"><span class="ts-menu-tile" data-tone="@ShellModel.Tone(org.Name)" aria-hidden="true">@ShellModel.Initial(org.Name)</span><span class="ts-menu-label">@org.Name</span>@if (org.Id == Model.Context.Organization?.Id) { <span class="ts-menu-check" aria-hidden="true">@ShellIcons.Svg("check")</span> }</button></form>
                }</div>
                @if (Model.Context.Organizations.Count > 5)
                {
                    <div class="ts-context-search-empty" data-show="@NoMatches(Model.Context.Organizations.Select(org => org.Name), "$organizationSearch")"><p role="status" aria-live="polite">No organizations match</p><button class="ts-btn ts-btn-ghost ts-btn-sm" type="button" data-on:click="$organizationSearch = ''; document.getElementById('organizationSearch').focus()">Clear search</button></div>
                }
                @if (Model.Context.Organization is { Projects.Count: > 0 } selected)
                {
                    <hr class="ts-menu-separator" /><div class="ts-menu-heading">Projects in @selected.Name</div>
                    @if (selected.Projects.Count > 5) { <input class="ts-input ts-input-sm" id="projectSearch" type="search" placeholder="Search projects" aria-label="Search projects" data-bind="projectSearch" /> }
                    <div class="ts-context-list">@foreach (var project in selected.Projects.Values.OrderBy(item => item.Name))
                    {
                        <form method="post" action="/api/v1/dashboard/switch-project" data-show="$projectSearch === '' || el.dataset.projectName.toLowerCase().includes($projectSearch.toLowerCase())" data-project-name="@project.Name"><input type="hidden" name="_csrf" value="@Model.CsrfToken" /><input type="hidden" name="projectId" value="@project.Id" /><input type="hidden" name="returnUrl" value="@Model.ReturnUrl" /><button class="ts-menu-item" type="submit" data-project-option="@project.Id" aria-current="@(project.Id == Model.Context.Project?.Id ? "true" : null)"><span class="ts-menu-tile" data-tone="@ShellModel.Tone(project.Name)" aria-hidden="true">@ShellModel.Initial(project.Name)</span><span class="ts-menu-label">@project.Name</span>@if (project.Id == Model.Context.Project?.Id) { <span class="ts-menu-check" aria-hidden="true">@ShellIcons.Svg("check")</span> }</button></form>
                    }</div>
                    @if (selected.Projects.Count > 5)
                    {
                        <div class="ts-context-search-empty" data-show="@NoMatches(selected.Projects.Values.Select(project => project.Name), "$projectSearch")"><p role="status" aria-live="polite">No projects match</p><button class="ts-btn ts-btn-ghost ts-btn-sm" type="button" data-on:click="$projectSearch = ''; document.getElementById('projectSearch').focus()">Clear search</button></div>
                    }
                }
                <hr class="ts-menu-separator" />
                @if (Model.Context.Project is not null) { <a class="ts-menu-item" href="/project">@ShellIcons.Svg("sliders-horizontal")<span class="ts-menu-label">Project settings</span></a> }
                @if (CanCreateProject) { <a class="ts-menu-item" href="/organization?newProject=1#projects">@ShellIcons.Svg("plus")<span class="ts-menu-label">New project</span></a> }
                <a class="ts-menu-item" href="/organizations/choose">@ShellIcons.Svg("building2")<span class="ts-menu-label">All organizations</span></a>
            </div>
        </div>
    }
    <div class="ts-topbar-actions">
        <button type="button" id="ts-search-toggle" class="ts-search" aria-label="Search" aria-keyshortcuts="Meta+K Control+K" data-on:click="(() => { if (document.querySelector('dialog[open]')) return; const dialog = document.getElementById('ts-search-dialog'); dialog.returnFocusElement = document.activeElement; dialog.showModal(); })()" data-on:keydown__window="(evt.metaKey || evt.ctrlKey) && evt.key.toLowerCase() === 'k' && (evt.preventDefault(), !$navOpen && el.click())">@ShellIcons.Svg("search")<span class="ts-search-label">Search…</span><kbd class="ts-kbd" aria-hidden="true">⌘K</kbd></button>
        @if (creates.Length > 0)
        {
            <div class="ts-menu ts-menu-end ts-create-menu">
                <button type="button" id="ts-create-toggle" class="ts-icon-btn ts-topbar-create" popovertarget="ts-create-menu" aria-label="Create">@ShellIcons.Svg("plus")</button>
                <div class="ts-menu-panel" id="ts-create-menu" popover="auto" role="group" aria-label="Create">@foreach (var action in creates)
                {
                    <a class="ts-menu-item" href="@action.Url">@ShellIcons.Svg(action.Icon)<span class="ts-menu-label">@action.Label</span></a>
                }</div>
            </div>
        }
        @(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.ShellNotificationsBell, ShellModel>(Model))
    </div>
</header>
<dialog id="ts-search-dialog" class="ts-dialog" closedby="any" aria-label="Search" data-signals="{pageSearch: ''}" data-on:keydown="(() => { if (evt.key === 'Escape') { evt.preventDefault(); evt.stopPropagation(); el.close(); return; } const items = [...el.querySelectorAll('.ts-search-results a')].filter(item => item.checkVisibility()); const at = items.indexOf(document.activeElement); if (items.length === 0) return; if (evt.key === 'Enter' &amp;&amp; at &lt; 0) { evt.preventDefault(); items[0].click(); } else if (evt.key === 'ArrowDown' || evt.key === 'ArrowUp') { evt.preventDefault(); items[evt.key === 'ArrowDown' ? (at + 1) % items.length : at &lt;= 0 ? items.length - 1 : at - 1].focus(); } })()" data-on:close="(() => { $pageSearch = ''; const target = el.returnFocusElement; setTimeout(() => (target?.matches('button, a[href], input, select, textarea, [tabindex]') &amp;&amp; target.checkVisibility() ? target : document.getElementById('ts-search-toggle')).focus()); })()"><div class="ts-dialog-content"><div class="ts-input-group">@ShellIcons.Svg("search")<input class="ts-input" id="ts-search-input" type="search" placeholder="Search pages, databases and actions" aria-label="Search" autofocus data-bind="pageSearch" /></div><div class="ts-search-results">@for (var index = 0; index < pages.Length; index++)
{
    var item = pages[index];
    <a class="ts-menu-item" href="@item.Url" aria-label="@item.Label" data-search-label="@item.SearchLabel" data-show="$pageSearch === '' || el.dataset.searchLabel.toLowerCase().includes($pageSearch.toLowerCase())">@ShellIcons.Svg(item.Icon)<span class="ts-menu-label">@item.Label</span><span class="ts-search-scope" aria-hidden="true">@item.Context</span></a>
}<p class="ts-empty" role="status" aria-live="polite" hidden data-attr:hidden="@("!(" + NoMatches(pages.Select(item => item.SearchLabel), "$pageSearch") + ")")">No results</p></div></div></dialog>
@functions {
    private string CurrentPath => Model.ReturnUrl.Split('?', '#')[0];
    private bool Active(string url)
    {
        var path = url.Split('?', '#')[0];
        return path == "/" ? CurrentPath == "/" : CurrentPath == path || CurrentPath.StartsWith(path + "/", StringComparison.Ordinal);
    }
    private int DatabaseCount => Model.Context.Project?.Databases.Count ?? 0;
    private IEnumerable<Group> Groups => Navigation.Select(group => group with { Items = [.. group.Items.Select(Scope).Where(Visible)] })
        .Where(group => group.Items.Length > 0);
    private Item Scope(Item item) => IsCollaborator && item.Url is "/usage" or "/analytics" ? item with { Url = item.Url + "?project=" + Model.Context.Project!.Id } : item;
    private bool Visible(Item item) => (IsMember || item.Url is not ("/organization" or "/analytics" or "/usage")) && (Model.Context.Project is not null || item.Url is not ("/project" or "/notifications/alerts"));
    private bool IsMember => Model.Context.Role.Length > 0;
    private bool CanProvision => Model.Context.Organization?.CanProvision(Model.Context.UserId) == true;
    private bool CanCreateProject => Model.Context.CanManage && CanProvision;
    private bool IsCollaborator => !IsMember && Model.Context.Organization is { } organization && TerraScale.Dashboard.Common.Accounts.ProjectCollaborator.Allows(organization, Model.Context.Project);
    private sealed record Item(string Label, string Url, string Icon);
    private sealed record Group(string Label, Item[] Items);
    private static readonly Group[] Navigation = [new("", [new("Overview", "/", "layout-dashboard")]), new("Build", [new("Databases", "/databases", "database"), new("Files", "/storage", "folder-open")]), new("Security", [new("API keys", "/api-keys", "key-round"), new("Authentication", "/auth", "fingerprint")]), new("Observe", [new("Analytics", "/analytics", "line-chart"), new("Usage", "/usage", "chart-column-big"), new("Alerts", "/notifications/alerts", "bell")]), new("Settings", [new("Project", "/project", "sliders-horizontal"), new("Organization", "/organization", "building2")])];
    private sealed record SearchPage(string Label, string Url, string Icon, string Context)
    {
        public string SearchLabel => Label + " " + Context;
    }
    private static string NoMatches(IEnumerable<string> labels, string query) =>
        $"{query} !== '' && !{System.Text.Json.JsonSerializer.Serialize(labels)}.some(label => label.toLowerCase().includes({query}.toLowerCase()))";
    private string OrganizationScope => Model.Context.Organization?.Name ?? "No organization";
    private string ProjectScope => OrganizationScope + " / " + (Model.Context.Project?.Name ?? "No project");
    private IEnumerable<Item> CreateActions()
    {
        if (Model.Context.Project is not null)
        {
            if (CanProvision) yield return new("New database", "/databases?create=1", "database");
            if (Model.Context.CanManageKeys) yield return new("New API key", "/api-keys?create=key", "key-round");
            if (Model.Context.CanWriteProjectData) yield return new("New bucket", "/storage", "folder-open");
            if (Model.Context.Role == "owner") yield return new("New alert rule", "/notifications/alerts", "bell");
        }
        if (CanCreateProject) yield return new("New project", "/organization?newProject=1#projects", "boxes");
    }
    private IEnumerable<SearchPage> SearchPages()
    {
        foreach (var item in Navigation.SelectMany(group => group.Items).Select(Scope).Where(Visible))
            yield return new(item.Url == "/project" ? "Project settings" : item.Label, item.Url, item.Icon, item.Url == "/organization" ? OrganizationScope : ProjectScope);
        if (Model.Context.Project is not null)
        {
            if (CanProvision) yield return new("New database", "/databases?create=1", "plus", ProjectScope);
            if (Model.Context.CanManageKeys) yield return new("New API key", "/api-keys?create=key", "plus", ProjectScope);
        }
        if (CanCreateProject) yield return new("New project", "/organization?newProject=1#projects", "plus", OrganizationScope);
        if (Model.Context.Project is { } active)
        {
            yield return new("Connect", "/?tab=connect", "plug", ProjectScope);
            foreach (var database in active.Databases.Values.OrderBy(item => item.Name, StringComparer.Ordinal))
                yield return new(database.Name, DatabaseService.Path(database.Id), "database", "Database · " + ProjectScope);
        }
        yield return new("Support", "/support", "circle-help", "Help");
        yield return new("Profile", "/profile", "user-round", "Account");
        yield return new("Notifications", "/notifications", "bell", "Account");
        if (IsMember && Model.Context.Organization is not null)
            foreach (var (key, label) in OrganizationPages)
                yield return new(label, "/organization?tab=" + key, "building2", OrganizationScope);
        if (Model.Context.Project is null) yield break;
        var parts = CurrentPath.Split('/');
        if (parts.Length < 3 || parts[1] != "databases" || !Model.Context.Project.Databases.TryGetValue(Uri.UnescapeDataString(parts[2]), out var current)) yield break;
        foreach (var tab in DatabaseFrameModel.Tabs)
            yield return new(tab.Key is "overview" or "danger" ? "Database " + tab.Label.ToLowerInvariant() : tab.Label, DatabaseService.Path(current.Id, tab.Key), "database", current.Name);
    }
    private static readonly (string Key, string Label)[] OrganizationPages = [("members", "Members"), ("invitations", "Invitations"), ("projects", "Projects"), ("billing", "Billing"), ("audit", "Audit"), ("sso", "Single sign-on"), ("danger", "Danger zone")];
}
