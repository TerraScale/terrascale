@inherits RazorSlice<DialogFormError>
@{ var form = Model.Form; }
<button class="ts-btn ts-btn-danger ts-btn-sm" type="button" command="show-modal" commandfor="@form.Id" aria-label="@(form.Button + ": " + form.Target)">@form.Button</button>
<dialog id="@form.Id" class="ts-dialog" closedby="any" aria-labelledby="@(form.Id + "-title")"><div class="ts-dialog-content">
    <header class="ts-dialog-head"><h2 class="ts-dialog-title" id="@(form.Id + "-title")">@form.Button: @form.Target</h2><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@form.Id">@Icons.Render("X", 18)</button></header>
    @if (form.Description is { } description) { <p class="ts-dialog-description">@description</p> }
    @(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.DialogErrorView, DialogError>(new(form.Id, Model.Message)))
    <form method="post" action="@form.Action" class="ts-form" data-submit-once>
        <input type="hidden" name="_csrf" value="@form.CsrfToken" />
        @foreach (var field in form.Fields) { <input type="hidden" name="@field.Key" value="@field.Value" /> }
        <div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="@form.Id">Cancel</button><button class="ts-btn ts-btn-danger" type="submit">@form.Button</button></div>
    </form>
</div></dialog>
