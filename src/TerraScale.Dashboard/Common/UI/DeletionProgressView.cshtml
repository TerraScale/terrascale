@inherits RazorSlice<TerraScale.Dashboard.Common.UI.DeletionProgressPage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.Document, DocumentModel>
<main class="ts-login">
    <section class="ts-login-hero ts-auth-hero" aria-hidden="true">
        @(await RenderPartialAsync<TerraScale.Dashboard.Features.Auth.AuthRegionMap>())
    </section>
    <div class="ts-login-column"><div class="ts-login-panel"><div class="ts-login-stack">
    <h1 class="ts-auth-title">Deletion in progress</h1>
    <p class="ts-auth-subtitle" role="status">Waiting for the closing machine to confirm the deletion. This page checks again by itself.</p>
    <form method="post" action="@Model.Action" data-init="@($"setTimeout(() => el.requestSubmit(), {Model.DelayMilliseconds})")">
        @foreach (var field in Model.Form)
        {
            @foreach (var value in field.Value)
            {
                <input type="hidden" name="@field.Key" value="@value" />
            }
        }
        <noscript><button class="ts-btn ts-btn-primary" type="submit">Check deletion status</button></noscript>
    </form>
</div></div></div></main>
@functions { public DocumentModel LayoutModel => Model.Document; }
