@inherits RazorSlice<TerraScale.Dashboard.Features.Analytics.AnalyticsLinePlot>
@using TerraScale.Dashboard.Shared.Charts
<svg class="ts-chart" viewBox="0 0 720 200" role="group" aria-label="@Model.Label" data-init="el.querySelectorAll('.ts-chart-column').forEach((column, i, all) => column.setAttribute('tabindex', i === all.length - 1 ? '0' : '-1'))" data-on:keydown="evt.target.matches('.ts-chart-column') &amp;&amp; ['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(evt.key) &amp;&amp; (evt.preventDefault(), [{ArrowLeft: evt.target.previousElementSibling, ArrowRight: evt.target.nextElementSibling, Home: el.querySelector('.ts-chart-column'), End: el.querySelector('.ts-chart-column:last-of-type')}[evt.key]?.closest('.ts-chart-column')].filter(Boolean).forEach(next => (evt.target.setAttribute('tabindex', '-1'), next.setAttribute('tabindex', '0'), next.focus())))"><defs><linearGradient id="@Model.GradientId" x1="0" y1="0" x2="0" y2="1"><stop class="ts-chart-fill-start" offset="0"></stop><stop class="ts-chart-fill-end" offset="1"></stop></linearGradient></defs>
@for (var index = 0; index < Model.Grid.Count; index++) { var grid = Model.Grid[index]; <line class="ts-chart-grid @(index == Model.Grid.Count - 1 ? "ts-chart-baseline" : "")" x1="48" y1="@grid.Y" x2="708" y2="@grid.Y"></line>@if (grid.Label.Length > 0) { <g><text class="ts-chart-axis" x="38" y="@grid.Y" dy="0.32em" text-anchor="end">@grid.Label</text></g> } }
@foreach (var tick in Model.Ticks) { <g><text class="ts-chart-axis" x="@tick.X" y="192" text-anchor="@tick.Anchor">@tick.Label</text></g> }
@if (Model.Area.Length > 0) { <path class="ts-chart-area" d="@Model.Area" fill="url(#@Model.GradientId)"></path> }
@foreach (var path in Model.Paths) { <path class="ts-chart-line @path.Class" d="@path.Path" stroke-dasharray="@path.Dash"></path> }
@foreach (var dot in Model.Markers) { <circle class="ts-chart-dot ts-chart-marker @dot.Class" cx="@dot.X" cy="@dot.Y" stroke-dasharray="@dot.Dash" r="4" aria-hidden="true"></circle> }
@foreach (var column in Model.Columns)
{
    var left = double.Parse(column.TipX, System.Globalization.CultureInfo.InvariantCulture); var width = double.Parse(column.TipWidth, System.Globalization.CultureInfo.InvariantCulture);
    <g class="ts-chart-column" tabindex="0" role="img" aria-label="@column.Label"><rect class="ts-chart-hit" x="@column.Left" y="14" width="@column.Width" height="154"></rect><line class="ts-chart-guide" x1="@column.X" y1="14" x2="@column.X" y2="168"></line>@foreach (var dot in column.Dots) { <circle class="ts-chart-dot @dot.Class" cx="@dot.X" cy="@dot.Y" stroke-dasharray="@dot.Dash" r="4"></circle> }<g class="ts-chart-tip" aria-hidden="true"><rect class="ts-chart-tip-box" x="@column.TipX" y="14.0" width="@column.TipWidth" height="@column.TipHeight" rx="6"></rect><text class="ts-chart-tip-label" x="@ChartGeometry.Coordinate(left + 10)" y="28.5" dy="0.35em">@column.Header</text>@foreach (var row in column.Rows) { <g><line class="ts-chart-tip-swatch @row.Class" x1="@ChartGeometry.Coordinate(left + 10)" x2="@ChartGeometry.Coordinate(left + 34)" y1="@row.Y" y2="@row.Y" stroke-dasharray="@row.Dash"></line><text class="ts-chart-tip-name" x="@ChartGeometry.Coordinate(left + 42)" y="@row.Y" dy="0.35em">@row.Name</text><text class="ts-chart-tip-value" x="@ChartGeometry.Coordinate(left + width - 10)" y="@row.Y" dy="0.35em" text-anchor="end">@row.Value</text></g> }</g></g>
}
</svg>
