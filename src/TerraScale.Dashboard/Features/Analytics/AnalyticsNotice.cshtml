@inherits RazorSlice<TerraScale.Dashboard.Features.Analytics.AnalyticsNoticeModel>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
<main class="ts-page"><h1 class="ts-sr-only">Analytics</h1>
    <section class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Could not open analytics</p><p class="ts-alert-body">@Model.Message</p><p class="ts-meta">Request ID: <code>@RequestIdentity.Id</code></p><a class="ts-link" href="/analytics">Reset analytics filters</a></section>
</main>
@functions { public ShellModel LayoutModel => Model.Shell; }
