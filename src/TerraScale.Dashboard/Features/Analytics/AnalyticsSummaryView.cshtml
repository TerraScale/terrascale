@inherits RazorSlice<TerraScale.Dashboard.Features.Analytics.AnalyticsPage>
@using System.Globalization
@using TerraScale.Dashboard.Common.Charts
@using TerraScale.Dashboard.Common.Formatting
<section class="ts-card" id="analytics-summary" aria-labelledby="analytics-summary-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="analytics-summary-title">Key analytics</h2></div></header><div class="ts-card-body">
@if (Model.Error.Length > 0) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Analytics unavailable</p><p class="ts-alert-body">@Model.Error</p></div> }
else if (Model.Totals is not { } data) { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("BarChart3", 16)</span><p class="ts-empty-title">@Model.Empty</p></div> }
else
{
    <dl class="ts-stats" aria-label="Key analytics">@foreach (var stat in new[] { ("Requests", ChartGeometry.Compact(data.Requests), data.Requests.ToString("N0", CultureInfo.InvariantCulture)), ("Errors", ChartGeometry.Compact(data.Errors), data.Errors.ToString("N0", CultureInfo.InvariantCulture)), ("Worst p95 latency", MetricFormat.Latency(data.WorstP95Ms), ""), ("Storage on disk", data.StorageBytes is { } storage ? MetricFormat.Bytes(storage) : "Not measured", "") }) { <div class="ts-stat"><dt class="ts-stat-label">@stat.Item1</dt><dd class="ts-stat-value" title="@(stat.Item3.Length > 0 ? stat.Item3 : null)">@stat.Item2</dd></div> }</dl>
    <dl class="ts-stats" aria-label="Operations and bandwidth">@foreach (var stat in new[] { ("Operations", ChartGeometry.Compact(data.Operations), data.Operations.ToString("N0", CultureInfo.InvariantCulture)), ("Client bandwidth", MetricFormat.Bytes(data.ClientBytes), ""), ("Replication sent", MetricFormat.Bytes(data.ReplicationSentBytes), ""), ("Replication received", MetricFormat.Bytes(data.ReplicationReceivedBytes), "") }) { <div class="ts-stat"><dt class="ts-stat-label">@stat.Item1</dt><dd class="ts-stat-value" title="@(stat.Item3.Length > 0 ? stat.Item3 : null)">@stat.Item2</dd></div> }</dl>
}
</div></section>
