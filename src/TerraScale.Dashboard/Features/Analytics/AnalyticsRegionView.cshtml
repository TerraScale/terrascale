@inherits RazorSlice<TerraScale.Dashboard.Features.Analytics.AnalyticsPage>
@inject AssetUrls Assets
@using System.Globalization
@using TerraScale.Dashboard.Common.Charts
@using TerraScale.Dashboard.Features.Home
@using TerraScale.Dashboard.Common.UI
@using TerraScale.Dashboard.Common.Formatting
@{
    var regions = Model.Totals!.Regions;
    Func<string, string> filterHref = code => $"/analytics?project={Uri.EscapeDataString(Model.Selection.Context.Project!.Id)}&range={Uri.EscapeDataString(Model.Selection.Range)}&database={Uri.EscapeDataString(Model.Selection.DatabaseId)}&region={Uri.EscapeDataString(code)}";
}
<section class="ts-card" id="analytics-regions" aria-labelledby="analytics-regions-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="analytics-regions-title">By region</h2></div></header><div class="ts-card-body">
@if (regions.Count == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No region measurements for these filters.</p></div> }
else {
    <div class="ts-analytics-regions">@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.RegionMap, RegionMapModel>(new("analytics-region-map", RegionMapMode.ReadOnly, RegionMapModel.Rows(regions.Select(region => new RegionMapRegion(region.Code, "", region.Flag, region.WorstP95Ms is { } p95 ? MetricFormat.Latency(p95) : ""))), [.. regions.Select(region => region.Code)]) { LabelledBy = "analytics-regions-title", Fit = RegionMapFit.Page }))
    <div class="ts-stack">@foreach (var region in regions) { <a class="ts-card ts-card-boxed ts-analytics-region" href="@filterHref(region.Code)"><div class="ts-db-region">@if (region.Flag.Length > 0) { <img class="ts-db-region-flag" src="@Assets.Url("flags/" + region.Flag + ".svg")" alt="" aria-hidden="true" /> }<strong>@Regions.Name(region.Code)</strong><span class="ts-mono">@region.Code.ToLowerInvariant()</span></div><dl class="ts-kv"><dt>Requests</dt><dd title="@region.Requests.ToString("N0", CultureInfo.InvariantCulture)">@ChartGeometry.Compact(region.Requests)</dd><dt>Worst p95 latency</dt><dd>@MetricFormat.Latency(region.WorstP95Ms)</dd></dl></a> }</div></div>
    <div class="ts-table-wrap" role="region" aria-label="Analytics by region table" tabindex="0"><table class="ts-table"><caption class="ts-sr-only">Requests and worst database p95 in each region across the selected period</caption><thead><tr><th>Region</th><th class="ts-num">Requests</th><th class="ts-num">Worst p95 latency</th></tr></thead><tbody>@foreach (var region in regions) { <tr><th scope="row"><a class="ts-db-region" href="@filterHref(region.Code)">@if (region.Flag.Length > 0) { <img class="ts-db-region-flag" src="@Assets.Url("flags/" + region.Flag + ".svg")" alt="" aria-hidden="true" /> }<span class="ts-mono">@region.Code.ToLowerInvariant()</span></a></th><td class="ts-num" title="@region.Requests.ToString("N0", CultureInfo.InvariantCulture)">@ChartGeometry.Compact(region.Requests)</td><td class="ts-num">@MetricFormat.Latency(region.WorstP95Ms)</td></tr> }</tbody></table></div>
}
</div></section>
