@inherits RazorSlice<TerraScale.Dashboard.Features.Analytics.AnalyticsChart>
@{
    var selection = Model.Selection;
    var filters = "/analytics?project=" + Uri.EscapeDataString(selection.Context.Project!.Id) + "&database=" + Uri.EscapeDataString(selection.DatabaseId) + "&region=" + Uri.EscapeDataString(selection.Region);
}
<section class="ts-card"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title">@Model.Title</h2></div><div class="ts-card-actions"><nav class="ts-segmented" aria-label="@(Model.Title + " range")">@foreach (var value in new[] { "1h", "24h", "7d", "30d" }) { <a class="ts-segment" href="@(filters + "&range=" + value)" aria-current="@(value == selection.Range ? "page" : null)">@value</a> }</nav></div></header><div class="ts-card-body">
@if (Model.Plot.Paths.Count > 0)
{
    <ul class="ts-chart-legend" aria-label="Chart series">@foreach (var path in Model.Plot.Paths) { <li class="ts-chart-legend-item"><svg class="ts-chart-swatch @path.Class" viewBox="0 0 32 8" aria-hidden="true"><line x1="0" x2="32" y1="4" y2="4" stroke-dasharray="@path.Dash"></line></svg>@path.Name</li> }</ul>
    <div class="ts-chart-shell" role="region" aria-label="@(Model.Title + " chart")" tabindex="0">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Analytics.AnalyticsLineView, TerraScale.Dashboard.Features.Analytics.AnalyticsLinePlot>(Model.Plot))</div>
}
else { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("LineChart", 16)</span><p class="ts-empty-title">No samples for @Model.Title.</p></div> }
</div></section>
