@using TerraScale.Dashboard.Common.Charts
@inherits RazorSlice<TerraScale.Dashboard.Features.Logs.DatabaseLogPage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
@using System.Globalization
<main class="ts-page" data-database-id="@Model.Database.Id">
    @(await RenderPartialAsync<TerraScale.Dashboard.Common.Databases.DatabaseFrame, DatabaseFrameModel>(new(Model.Database, "logs")))
    <section class="ts-card" aria-labelledby="request-logs-title">
        <header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="request-logs-title">Request logs</h2></div></header>
        <div class="ts-card-body">
            <form method="get" class="ts-row" action="@DatabaseService.Path(Model.Database.Id, "logs")">
                <label class="ts-label" for="request-status">HTTP status</label>
                <select class="ts-select" id="request-status" name="status">
                    <option value="" selected="@(Model.Status == "")">All statuses</option>
                    @foreach (var status in new[] { "2xx", "3xx", "4xx", "5xx" }) { <option value="@status" selected="@(Model.Status == status)">@status</option> }
                </select>
                <button class="ts-btn ts-btn-secondary" type="submit">Filter</button>
                <a class="ts-btn ts-btn-ghost" href="@(DatabaseService.Path(Model.Database.Id, "logs") + (Model.Status.Length == 0 ? "" : "?status=" + Uri.EscapeDataString(Model.Status)))">Retry</a>
            </form>
            @if (Model.Error.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
            else
            {
                @if (Model.Logs!.RecordingLimited) { <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">Recording reached capacity on this server. Some requests may be missing.</p></div> }
                @if (Model.Logs.Truncated) { <p class="ts-meta" role="status">Only the latest 100 recorded requests are searched by this filter.</p> }
                @if (Model.Logs.Items.Count == 0) { <p class="ts-empty">No recorded requests match this filter in the recent window.</p> }
                else {
                <div class="ts-table-wrap"><table class="ts-table"><caption class="ts-sr-only">Recent requests for @Model.Database.Name</caption><thead><tr><th scope="col">Time (UTC)</th><th scope="col">Route</th><th scope="col">Request ID</th><th scope="col">Status</th><th scope="col">Latency</th><th scope="col">Operations</th></tr></thead><tbody>
                @foreach (var log in Model.Logs.Items)
                {
                    <tr><td><time datetime="@log.Time.ToString("O", CultureInfo.InvariantCulture)">@log.Time.UtcDateTime.ToString("MMM d HH:mm:ss", CultureInfo.InvariantCulture)</time><div class="ts-meta">@log.Region</div></td><td><code>@log.Method @log.Route</code></td><td>@if(log.RequestId is { } requestId){<code>@requestId</code><div><a href="@("/support?relatedRequestId=" + requestId)">Contact support</a></div>}else{<span class="ts-meta">Unavailable</span>}</td><td><span class="ts-badge ts-badge-tone" data-tone="@(log.Status >= 400 ? "danger" : "success")">@log.Status</span></td><td>@MetricFormat.Latency(log.LatencyMs)</td><td title="@log.Operations.ToString("N0", CultureInfo.InvariantCulture)">@ChartGeometry.Compact(log.Operations)</td></tr>
                }
                </tbody></table></div>
                }
            }
        </div>
    </section>
    <section class="ts-card" id="log-drain" aria-labelledby="log-drain-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="log-drain-title">Project log drain</h2></div></header><div class="ts-card-body ts-stack">
        @if (Model.DrainError.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.DrainError</p></div> }
        @if (Model.Drain is { } drain)
        {
            <dl class="ts-kv"><dt>Endpoint</dt><dd class="ts-break">@drain.Url</dd><dt>Header</dt><dd>@(drain.HeaderName is null ? "None" : drain.HeaderName + ": set")</dd><dt>Last success</dt><dd>@(drain.LastSuccessAt?.UtcDateTime.ToString("MMM d HH:mm:ss 'UTC'", CultureInfo.InvariantCulture) ?? "Not yet")</dd><dt>Last error</dt><dd data-drain-error="@drain.LastErrorStatus">@(drain.LastErrorAt is { } failed ? (drain.LastErrorStatus is > 0 ? "HTTP " + drain.LastErrorStatus : "No response") + " at " + failed.UtcDateTime.ToString("MMM d HH:mm:ss 'UTC'", CultureInfo.InvariantCulture) : "None")</dd><dt>Skipped requests</dt><dd data-drain-gap="@(drain.LastGapAt is not null)">@(drain.LastGapAt is { } gap ? "Some requests left the 100-entry log window before they were exported, last at " + gap.UtcDateTime.ToString("MMM d HH:mm:ss 'UTC'", CultureInfo.InvariantCulture) : "None")</dd></dl>
        }
        else { <p class="ts-meta">No log drain is set for this project.</p> }
        @if (Model.CanManageDrain)
        {
            <form method="post" action="/api/v1/dashboard/log-drain" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><div class="ts-form-grid">
                <div class="ts-field"><label class="ts-label" for="drain-url">OTLP logs URL</label><input class="ts-input" id="drain-url" name="url" type="url" pattern="https://.+" maxlength="2048" value="@Model.Drain?.Url" placeholder="https://otlp-gateway-prod-us-east-0.grafana.net/otlp/v1/logs" autocomplete="off" required /></div>
                <div class="ts-field"><label class="ts-label" for="drain-header-name">Header name</label><input class="ts-input" id="drain-header-name" name="headerName" maxlength="64" value="@Model.Drain?.HeaderName" placeholder="Authorization or DD-API-KEY" autocomplete="off" /></div>
                <div class="ts-field"><label class="ts-label" for="drain-header-value">Header value</label><input class="ts-input" id="drain-header-value" name="headerValue" type="password" maxlength="4096" placeholder="@(Model.Drain?.HeaderValue is null ? "Basic base64(instance:token)" : "Unchanged")" autocomplete="off" /></div>
            </div><div class="ts-form-actions"><button type="submit" class="ts-btn ts-btn-primary">Save log drain</button></div></form>
            @if (Model.Drain is not null) { @(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.ConfirmDialog, ConfirmDialogModel>(new("remove-log-drain", "/api/v1/dashboard/log-drain/delete", "Remove log drain", Model.Drain.Url, Model.Shell.CsrfToken, new Dictionary<string, string> { ["databaseId"] = Model.Database.Id }, Description: "Saved credentials are deleted."))) }
        }
        else { <p class="ts-meta">Organization owners manage the log drain.</p> }
    </div></section>
</main>

@functions { public ShellModel LayoutModel => Model.Shell; }
