@inherits RazorSlice<TerraScale.Dashboard.Features.Logs.DatabaseLogPage>
@using System.Globalization
@using TerraScale.Dashboard.Common.Charts
@using TerraScale.Dashboard.Common.Live
@using Microsoft.AspNetCore.Html
        <div id="request-log-results" class="ts-card-body" @(Model.Live ? LiveView.Initializer(Model.Shell.Context, DatabaseService.Path(Model.Database.Id, "logs/live")) : HtmlString.Empty)>

            @if (Model.Error.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p><a class="ts-link" href="@(DatabaseService.Path(Model.Database.Id, "logs") + (Model.Status.Length == 0 ? "" : "?status=" + Uri.EscapeDataString(Model.Status)))">Retry</a></div> }
            else
            {
                @if (Model.Logs!.RecordingLimited) { <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">Recording reached capacity on this server. Some requests may be missing.</p></div> }
                @if (Model.Logs.Truncated) { <p class="ts-meta" role="status">Only the latest 100 recorded requests are searched by this filter.</p> }
                @if (Model.Logs.Items.Count == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No recorded requests match this filter in the recent window.</p></div> }
                else {
                <div class="ts-table-wrap" role="region" aria-label="Recent requests" tabindex="0"><table class="ts-table ts-table-stacked"><caption class="ts-sr-only">Recent requests for @Model.Database.Name</caption><thead><tr><th scope="col">Time (UTC)</th><th scope="col">Route</th><th scope="col">Request ID</th><th scope="col">Status</th><th scope="col" class="ts-num">Latency</th><th scope="col" class="ts-num">Operations</th></tr></thead><tbody>
                @foreach (var log in Model.Logs.Items)
                {
                    <tr><td data-label="Time"><time datetime="@log.Time.ToString("O", CultureInfo.InvariantCulture)">@log.Time.UtcDateTime.ToString("MMM d HH:mm:ss", CultureInfo.InvariantCulture)</time><div class="ts-meta">@log.Region</div></td><td data-label="Route" class="ts-break"><code>@log.Method @log.Route</code></td><td data-label="Request ID">@if(log.RequestId is { } requestId){<code>@requestId</code><div><a class="ts-link" href="@("/support?relatedRequestId=" + requestId)">Contact support</a></div>}else{<span class="ts-meta">Unavailable</span>}</td><td data-label="Status"><span class="ts-badge ts-badge-tone" data-tone="@(log.Status >= 400 ? "danger" : "success")">@log.Status</span></td><td data-label="Latency" class="ts-num">@MetricFormat.Latency(log.LatencyMs)</td><td data-label="Operations" class="ts-num" title="@log.Operations.ToString("N0", CultureInfo.InvariantCulture)">@ChartGeometry.Compact(log.Operations)</td></tr>
                }
                </tbody></table></div>
                }
            }
        </div>
