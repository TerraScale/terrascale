@inherits RazorSlice<TerraScale.Dashboard.Features.Logs.DatabaseLogPage>
@using System.Globalization
@using TerraScale.Dashboard.Features.Logs
<main id="database-logs" class="ts-page" data-database-id="@Model.Database.Id">
    @(await RenderPartialAsync<TerraScale.Dashboard.Common.Databases.DatabaseFrame, DatabaseFrameModel>(new(Model.Database, "logs", Databases: Model.Shell.Context.Project?.Databases.Values)))
    <h1 class="ts-sr-only">Logs</h1>
    <section class="ts-card" id="request-logs" aria-labelledby="request-logs-title">
        <header class="ts-card-head">
            <div class="ts-card-heading"><h2 class="ts-card-title" id="request-logs-title">Request logs</h2></div>
            <div class="ts-card-actions">
                <form id="request-log-filters" method="get" data-on:submit="evt.preventDefault(); const url = new URL(el.getAttribute('action'), window.location.origin); url.search = new URLSearchParams(new FormData(el)).toString(); history.replaceState(null, '', url); @@get(url.toString(), {retryMaxCount: 0})" class="ts-filters" action="@DatabaseService.Path(Model.Database.Id, "logs")">
                    <label class="ts-label" for="request-status">HTTP status</label>
                    <select class="ts-select" id="request-status" name="status" data-on:change="el.form.requestSubmit()">
                        <option value="" selected="@(Model.Status == "")">All statuses</option>
                        @foreach (var status in StatusFilters)
                        {
                            <option value="@status" selected="@(Model.Status == status)">@status</option>
                        }
                    </select>
                </form>
            </div>
        </header>
        @(await RenderPartialAsync<DatabaseLogResults, DatabaseLogPage>(Model))
    </section>
    <section class="ts-card" id="log-drain" aria-labelledby="log-drain-title">
        <header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="log-drain-title">Project log drain</h2></div></header>
        <div class="ts-card-body ts-stack">
            @if (Model.DrainError.Length > 0)
            {
                <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.DrainError</p></div>
            }
            @if (Model.Drain is { } drain)
            {
                <dl class="ts-kv">
                    <dt>Endpoint</dt><dd class="ts-break">@drain.Url</dd>
                    <dt>Header</dt><dd>@(drain.HeaderName is null ? "None" : drain.HeaderName + ": set")</dd>
                    <dt>Last success</dt><dd>@(drain.LastSuccessAt?.UtcDateTime.ToString("MMM d HH:mm:ss 'UTC'", CultureInfo.InvariantCulture) ?? "Not yet")</dd>
                    <dt>Last error</dt><dd data-drain-error="@drain.LastErrorStatus">@(drain.LastErrorAt is { } failed ? (drain.LastErrorStatus is > 0 ? "HTTP " + drain.LastErrorStatus : "No response") + " at " + failed.UtcDateTime.ToString("MMM d HH:mm:ss 'UTC'", CultureInfo.InvariantCulture) : "None")</dd>
                    <dt>Skipped requests</dt><dd data-drain-gap="@(drain.LastGapAt is not null)">@(drain.LastGapAt is { } gap ? "Some requests left the 100-entry log window before they were exported, last at " + gap.UtcDateTime.ToString("MMM d HH:mm:ss 'UTC'", CultureInfo.InvariantCulture) : "None")</dd>
                </dl>
            }
            else
            {
                <p class="ts-meta">No log drain is set for this project.</p>
            }
            @if (Model.CanManageDrain)
            {
                <form method="post" action="/api/v1/dashboard/log-drain" class="ts-form">
                    <input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
                    <input type="hidden" name="databaseId" value="@Model.Database.Id" />
                    <div class="ts-form-grid">
                        <div class="ts-field"><label class="ts-label" for="drain-url">OTLP logs URL</label><input class="ts-input" id="drain-url" name="url" type="url" maxlength="2048" value="@Model.Drain?.Url" placeholder="https://otlp-gateway-prod-us-east-0.grafana.net/otlp/v1/logs" autocomplete="off" required title="Enter an HTTPS URL" /></div>
                        <div class="ts-field"><label class="ts-label" for="drain-header-name">Header name</label><input class="ts-input" id="drain-header-name" name="headerName" value="@Model.Drain?.HeaderName" placeholder="Authorization or DD-API-KEY" autocomplete="off" /></div>
                        <div class="ts-field"><label class="ts-label" for="drain-header-value">Header value</label><input class="ts-input" id="drain-header-value" name="headerValue" type="password" placeholder="@(Model.Drain?.HeaderName is null ? "Basic base64(instance:token)" : "Unchanged")" autocomplete="off" /></div>
                    </div>
                    <div class="ts-form-actions"><button type="submit" class="ts-btn ts-btn-primary">Save log drain</button></div>
                </form>
                @if (Model.Drain is not null)
                {
                    @(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.DialogFormErrorView, DialogFormError>(new(new("remove-log-drain", "/api/v1/dashboard/log-drain/delete", "Remove log drain", Model.Drain.Url, Model.Shell.CsrfToken, new Dictionary<string, string> { ["databaseId"] = Model.Database.Id }, Description: "Saved credentials are deleted."), HttpContext is { } http && DialogSubmission.Matches(http, "/api/v1/dashboard/log-drain/delete") ? Model.DrainError : "")))
                }
            }
            else
            {
                <p class="ts-meta">Organization owners manage the log drain.</p>
            }
        </div>
    </section>
</main>
@functions {
    private static readonly string[] StatusFilters = ["2xx", "3xx", "4xx", "5xx"];
}
