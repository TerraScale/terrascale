@inherits RazorSlice<TerraScale.Dashboard.Features.Data.DataPage>
@using TerraScale.Dashboard.Features.Data
@{ var savedQueryId = HttpContext?.Request.Query["savedQueryId"].ToString() ?? ""; }
<section class="ts-studio-rail-section" id="saved-queries" aria-labelledby="saved-queries-title">
<div class="ts-studio-rail-head"><h2 class="ts-studio-rail-title" id="saved-queries-title">Saved queries</h2></div>
@if(Model.SavedQueries is not { Count: > 0 }){
<p class="ts-studio-rail-empty" role="status">No saved queries yet.</p>
}else{
<ul class="ts-studio-rail-list">
@foreach(var query in Model.SavedQueries){
<li class="ts-studio-query"><a class="ts-studio-rail-link" href="@(DatabaseService.Path(Model.Database.Id,"sql")+"?savedQueryId="+Uri.EscapeDataString(query.Id))" title="@query.Sql" data-saved-query="@query.Id" aria-current="@(savedQueryId == query.Id ? "true" : null)"><span class="ts-studio-rail-icon" aria-hidden="true">@Icons.Render("ScrollText",14)</span><span class="ts-truncate">@query.Name</span></a>
@if(Model.Context.CanWriteProjectData){<button class="ts-icon-btn ts-studio-query-delete" type="button" command="show-modal" commandfor="@("delete-query-"+query.Id)" aria-label="@("Delete "+query.Name)">@Icons.Render("Trash2",14)</button>}
</li>}
</ul>}
@if(Model.Context.CanWriteProjectData){
@(await RenderPartialAsync<SaveQueryDialog,DataPage>(Model))
@foreach(var query in Model.SavedQueries ?? []){
@(await RenderPartialAsync<QueryDeleteDialog,QueryDeleteModel>(new(Model,query)))
}}
</section>
