@inherits RazorSlice<TerraScale.Dashboard.Features.Data.DataPage>
@using System.Text.Json
@using TerraScale.Dashboard.Features.Data
<div id="sql-history" class="ts-data-sql-history">
<input type="hidden" name="history" form="sql-query-form" value="@JsonSerializer.Serialize(Model.History ?? [])" />
<select class="ts-select" form="sql-query-form" data-sql-history aria-label="Recent queries" disabled="@(Model.History is not { Count: > 0 })"><option value="">Recent queries</option>
@foreach(var statement in Model.History ?? []){<option value="@statement">@SqlHistory.Label(statement)</option>}
</select>
</div>
