@inherits RazorSlice<TerraScale.Dashboard.Features.Data.DataPage>
@if(Model.Context.CanWriteProjectData){
<dialog id="new-collection" class="ts-dialog" closedby="any" aria-labelledby="new-collection-title" aria-describedby="new-collection-description" data-init="@(Model.Dialog=="new-collection" ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="new-collection-title">New collection</h2><p class="ts-dialog-description" id="new-collection-description">Create an empty collection in @Model.Database.Name.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="new-collection">@Icons.Render("X",18)</button></header><form method="post" action="/api/v1/dashboard/data/collections" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="collection" value="@Model.Collection" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />@foreach(var key in new[]{"view","q","sort","order","page","cursor"}){var value= key switch {"view" => Model.Layout=="list" ? "list" : "", "q" => Model.Search, "sort" => Model.Sort, "order" => Model.Descending ? "desc" : "", "cursor" => Model.Browse.Cursor, _ => Model.Browse.Page>1 ? Model.Browse.Page.ToString(System.Globalization.CultureInfo.InvariantCulture) : ""};if(value.Length>0){<input type="hidden" name="@key" value="@value" />}}@if(Model.Dialog=="new-collection" && Model.FormError.Length>0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.FormError</p></div>}<div class="ts-field"><label class="ts-label" for="new-collection-name">Name</label><input class="ts-input ts-mono" id="new-collection-name" name="name" autofocus aria-describedby="new-collection-name-hint" pattern="[a-z][a-z0-9_\-]*" maxlength="63" value="@(Model.Dialog=="new-collection" ? Model.QueryName : "")" required /><p class="ts-hint" id="new-collection-name-hint">A lowercase letter, then up to 62 lowercase letters, digits, hyphens, and underscores.</p></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="new-collection">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Create collection</button></div></form></div></dialog>
@if(Model.Collection.Length > 0){<dialog id="delete-collection" class="ts-dialog" closedby="any" aria-labelledby="delete-collection-title" aria-describedby="delete-collection-description" data-init="@(Model.Dialog=="delete-collection" ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="delete-collection-title">Delete @Model.Collection</h2><p class="ts-dialog-description" id="delete-collection-description">This permanently removes the collection and every document in it. Indexes and schemas declared for it stay and apply if it is created again.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="delete-collection">@Icons.Render("X",18)</button></header><form method="post" action="/api/v1/dashboard/data/collections/delete" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="collection" value="@Model.Collection" />@foreach(var key in new[]{"view","q","sort","order","page","cursor"}){var value= key switch {"view" => Model.Layout=="list" ? "list" : "", "q" => Model.Search, "sort" => Model.Sort, "order" => Model.Descending ? "desc" : "", "cursor" => Model.Browse.Cursor, _ => Model.Browse.Page>1 ? Model.Browse.Page.ToString(System.Globalization.CultureInfo.InvariantCulture) : ""};if(value.Length>0){<input type="hidden" name="@key" value="@value" />}}@if(Model.Dialog=="delete-collection" && Model.FormError.Length>0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.FormError</p></div>}<div class="ts-field"><label class="ts-label" for="delete-collection-confirm">Type <span class="ts-mono">@Model.Collection</span> to confirm</label><input class="ts-input ts-mono" id="delete-collection-confirm" name="confirmName" autocomplete="off" required /></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="delete-collection" autofocus>Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Delete collection</button></div></form></div></dialog>}
<dialog id="add-document" class="ts-dialog ts-dialog-wide" closedby="any" data-rejected-draft="@(Model.Dialog == "add-document" && Model.FormError.Length > 0 ? "true" : "false")" data-on:keydown="evt.key === 'Escape' &amp;&amp; !evt.defaultPrevented &amp;&amp; !evt.isComposing &amp;&amp; (evt.preventDefault(), evt.stopPropagation(), !evt.repeat &amp;&amp; el.requestClose())" data-on:cancel="el.querySelector('form') &amp;&amp; (el.dataset.rejectedDraft === 'true' || Array.from(el.querySelectorAll('form textarea[name]:not([readonly]):not(:disabled), form input[name]:not([type=hidden]):not([readonly]):not(:disabled), form select[name]:not(:disabled)')).some(field => field.tagName === 'SELECT' ? Array.from(field.options).some(option => option.selected !== option.defaultSelected) : field.value !== field.defaultValue)) &amp;&amp; !confirm('Close without saving? Any unsaved changes in this dialog will be discarded.') &amp;&amp; evt.preventDefault()" aria-labelledby="add-document-title" aria-describedby="add-document-description" data-init="@(Model.Dialog=="add-document" ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="add-document-title">Add document</h2><p class="ts-dialog-description" id="add-document-description">Create a document in the @Model.Collection collection.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="request-close" commandfor="add-document">@Icons.Render("X",18)</button></header><form method="post" action="/api/v1/dashboard/data/documents" enctype="multipart/form-data" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />@foreach(var key in new[]{"view","q","sort","order","page","cursor"}){var value= key switch {"view" => Model.Layout=="list" ? "list" : "", "q" => Model.Search, "sort" => Model.Sort, "order" => Model.Descending ? "desc" : "", "cursor" => Model.Browse.Cursor, _ => Model.Browse.Page>1 ? Model.Browse.Page.ToString(System.Globalization.CultureInfo.InvariantCulture) : ""};if(value.Length>0){<input type="hidden" name="@key" value="@value" />}}<input type="hidden" name="collection" value="@Model.Collection" /><input type="hidden" name="operation" value="create" />@if(Model.Dialog=="add-document" && Model.FormError.Length>0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.FormError</p></div>}<div class="ts-field"><label class="ts-label" for="new-document-id">Document ID</label><input class="ts-input ts-mono" id="new-document-id" name="id" autofocus maxlength="26" pattern="[0-7][0-9A-HJKMNP-TV-Z]{25}" aria-describedby="new-document-id-hint" value="@(Model.Dialog=="add-document" ? Model.DocumentId : "")" /><p class="ts-hint" id="new-document-id-hint">A 26-character uppercase ULID. Leave empty to generate one.</p></div><div class="ts-field"><label class="ts-label" for="new-document-json">JSON document</label><ts-code-editor class="ts-code-editor" data-language="json"><textarea class="ts-input ts-mono" id="new-document-json" name="document" rows="10" spellcheck="false" autocomplete="off">@(Model.Dialog=="add-document" ? Model.DocumentJson : "{}")</textarea></ts-code-editor></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="request-close" commandfor="add-document">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Add document</button></div></form></div></dialog>
}
@if(Model.Dialog=="edit-document"){
<dialog id="edit-document" class="ts-dialog ts-dialog-wide" closedby="any" data-rejected-draft="@(Model.Dialog == "edit-document" && Model.FormError.Length > 0 ? "true" : "false")" data-on:keydown="evt.key === 'Escape' &amp;&amp; !evt.defaultPrevented &amp;&amp; !evt.isComposing &amp;&amp; (evt.preventDefault(), evt.stopPropagation(), !evt.repeat &amp;&amp; el.requestClose())" data-on:cancel="el.querySelector('form') &amp;&amp; (el.dataset.rejectedDraft === 'true' || Array.from(el.querySelectorAll('form textarea[name]:not([readonly]):not(:disabled), form input[name]:not([type=hidden]):not([readonly]):not(:disabled), form select[name]:not(:disabled)')).some(field => field.tagName === 'SELECT' ? Array.from(field.options).some(option => option.selected !== option.defaultSelected) : field.value !== field.defaultValue)) &amp;&amp; !confirm('Close without saving? Any unsaved changes in this dialog will be discarded.') &amp;&amp; evt.preventDefault()" aria-labelledby="edit-document-title" aria-describedby="edit-document-description" data-init="el.showModal()"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="edit-document-title">@Model.DocumentId</h2><p class="ts-dialog-description" id="edit-document-description">Document in the @Model.Collection collection.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="request-close" commandfor="edit-document">@Icons.Render("X",18)</button></header>@if(Model.Context.CanWriteProjectData){<form method="post" action="/api/v1/dashboard/data/documents" enctype="multipart/form-data" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />@foreach(var key in new[]{"view","q","sort","order","page","cursor"}){var value= key switch {"view" => Model.Layout=="list" ? "list" : "", "q" => Model.Search, "sort" => Model.Sort, "order" => Model.Descending ? "desc" : "", "cursor" => Model.Browse.Cursor, _ => Model.Browse.Page>1 ? Model.Browse.Page.ToString(System.Globalization.CultureInfo.InvariantCulture) : ""};if(value.Length>0){<input type="hidden" name="@key" value="@value" />}}<input type="hidden" name="collection" value="@Model.Collection" /><input type="hidden" name="id" value="@Model.DocumentId" /><input type="hidden" name="version" value="@Model.Version" />@if(Model.FormError.Length>0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.FormError</p></div>}<div class="ts-field"><label class="ts-label" for="operation">Operation</label><select class="ts-select" id="operation" name="operation" autofocus aria-describedby="document-operation-hint"><option value="replace" selected="@(Model.Operation!="patch")">Replace</option><option value="patch" selected="@(Model.Operation=="patch")">Patch</option></select><p class="ts-hint" id="document-operation-hint">Replace writes the whole document; patch applies JSON Merge Patch; null removes fields.</p></div><div class="ts-field"><label class="ts-label" for="document-json">JSON document or patch</label><ts-code-editor class="ts-code-editor" data-language="json"><textarea class="ts-input ts-mono" id="document-json" name="document" rows="14" spellcheck="false" autocomplete="off">@Model.DocumentJson</textarea></ts-code-editor></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="request-close" commandfor="edit-document">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Save document</button></div></form>}else{<pre class="ts-code" tabindex="0" autofocus aria-label="Document JSON">@Model.DocumentJson</pre>}</div></dialog>
}else if(Model.Dialog=="delete-document" && Model.Context.CanWriteProjectData){
<dialog id="delete-document" class="ts-dialog" closedby="any" aria-labelledby="delete-document-title" aria-describedby="delete-document-description" data-init="el.showModal()"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="delete-document-title">Delete @Model.DocumentId?</h2><p class="ts-dialog-description" id="delete-document-description">This removes the document from the @Model.Collection collection.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="delete-document">@Icons.Render("X",18)</button></header><form method="post" action="/api/v1/dashboard/data/documents" enctype="multipart/form-data" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />@foreach(var key in new[]{"view","q","sort","order","page","cursor"}){var value= key switch {"view" => Model.Layout=="list" ? "list" : "", "q" => Model.Search, "sort" => Model.Sort, "order" => Model.Descending ? "desc" : "", "cursor" => Model.Browse.Cursor, _ => Model.Browse.Page>1 ? Model.Browse.Page.ToString(System.Globalization.CultureInfo.InvariantCulture) : ""};if(value.Length>0){<input type="hidden" name="@key" value="@value" />}}<input type="hidden" name="collection" value="@Model.Collection" /><input type="hidden" name="operation" value="delete" /><input type="hidden" name="id" value="@Model.DocumentId" /><input type="hidden" name="version" value="@Model.Version" />@if(Model.FormError.Length>0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.FormError</p></div>}<div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="delete-document" autofocus>Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Delete document</button></div></form></div></dialog>
}
