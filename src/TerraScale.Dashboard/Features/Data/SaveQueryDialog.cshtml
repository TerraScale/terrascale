@inherits RazorSlice<TerraScale.Dashboard.Features.Data.DataPage>
@using System.Text.Json
@if(Model.Context.CanWriteProjectData){<dialog id="save-query" class="ts-dialog" closedby="any" aria-labelledby="save-query-title" data-init="@(Model.Dialog=="save-query" ? "el.showModal()" : "el.close()")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="save-query-title">Save query</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="save-query">@Icons.Render("X",18)</button></header><form method="post" action="/api/v1/dashboard/data/saved-queries" class="ts-form" data-on:submit="evt.preventDefault(); @@post(el.action, {contentType:'form'})">@if(Model.History is {Count:>0}){<input type="hidden" name="history" value="@JsonSerializer.Serialize(Model.History)" />}<input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />@if(Model.FormError.Length>0 && Model.Dialog=="save-query"){@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.DialogErrorView, DialogError>(new("save-query", Model.FormError)))}<div class="ts-field"><label class="ts-label" for="query-name">Name</label><input class="ts-input" id="query-name" name="name" pattern="[\s\S]*\S[\s\S]*" title="Enter a query name" value="@Model.QueryName" required data-max-bytes="128" /></div><div class="ts-field"><label class="ts-label" for="saved-sql">SQL query</label><ts-code-editor class="ts-code-editor" data-language="sql"><textarea class="ts-input ts-mono" id="saved-sql" name="sql" rows="6" spellcheck="false" autocapitalize="off" autocomplete="off" required data-max-bytes="16384" >@Model.Sql</textarea></ts-code-editor></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="save-query">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Save query</button></div></form></div></dialog>}
