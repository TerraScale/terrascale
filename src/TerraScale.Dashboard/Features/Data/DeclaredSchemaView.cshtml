@inherits RazorSlice<TerraScale.Dashboard.Features.Data.DeclaredSchemaPage>
@implements IUsesLayout<TerraScale.Dashboard.Shared.UI.Slices.ShellDocument, ShellModel>
<main class="ts-page ts-db-detail">
@(await RenderPartialAsync<TerraScale.Dashboard.Shared.Databases.DatabaseFrame, DatabaseFrameModel>(new(Model.Database, "schema", Model.Collection)))
@if(Model.Error.Length > 0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p><p class="ts-meta">Request ID: <code>@RequestIdentity.Id</code></p></div>}
@if(Model.Notice.Length > 0){<p class="ts-alert ts-alert-success" role="status">@Model.Notice</p>}
<div class="ts-data-bar"><form class="ts-filters ts-data-scope" method="get" aria-label="Choose collection"><label class="ts-data-collection" for="collection"><span class="ts-sr-only">Collection</span><input class="ts-input ts-input-sm ts-mono" id="collection" name="collection" value="@Model.Collection" placeholder="Collection" required /></label><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Open</button></form></div>
@if(Model.Collection.Length == 0){<div class="ts-empty" role="status"><p class="ts-empty-title">No collection selected.</p><p class="ts-empty-detail">Choose a collection to inspect its schema.</p></div>}
else{
<section class="ts-card" aria-labelledby="declared-schema-title"><header class="ts-card-head"><div class="ts-card-heading"><h1 class="ts-card-title" id="declared-schema-title">Declared validation schema</h1><p class="ts-card-description">Draft 2020-12 JSON Schema for @Model.Collection. Validation applies to future local writes. Applying a schema does not repair or revalidate historical documents or replicated commits.</p></div></header><div class="ts-card-body ts-stack-lg">
@if(Model.Declared is null){<p class="ts-meta">The active schema could not be loaded. Reload this page to inspect it; your submitted draft is kept below.</p>}
else if(Model.Declared.Length == 0){<p class="ts-meta" role="status">No declared validation schema.</p>}
else{<details><summary>Active JSON Schema</summary><pre class="ts-code">@Model.Declared</pre></details>}
@if(Model.Shell.Context.CanManage){
<form method="post" enctype="multipart/form-data" class="ts-form" data-submit-once><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="collection" value="@Model.Collection" /><input type="hidden" name="operation" value="apply" />
<div class="ts-field"><label class="ts-label" for="declared-schema">JSON Schema draft</label><textarea class="ts-input ts-mono" id="declared-schema" name="schema" rows="14" spellcheck="false" maxlength="196608" aria-describedby="schema-hint" required>@(TerraScale.Dashboard.Features.Data.JsonDraft.EscapeC1(Model.Draft))</textarea><p class="ts-hint" id="schema-hint">Use a self-contained JSON Schema object or boolean, up to 64 KiB of compact UTF-8 JSON. Formatting and optional Unicode escapes are normalized before checking size. Rejected changes keep your draft here.</p></div>
<div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Apply validation schema</button>@if(Model.Declared is { Length: > 0 }){<button class="ts-btn ts-btn-danger" type="button" command="show-modal" commandfor="remove-schema">Remove schema</button>}</div></form>
}else{<p class="ts-hint">Only organization owners and admins can apply or remove validation schemas.</p>}
@if(Model.Shell.Context.Role == "owner"){<a class="ts-btn ts-btn-secondary" href="@("/databases/"+Model.Database.Id+"/schema/preview?collection="+Uri.EscapeDataString(Model.Collection))">Preview proposed schema</a>}
</div></section>
<section class="ts-card" aria-labelledby="inferred-schema-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="inferred-schema-title">Inferred fields</h2><p class="ts-card-description">Observed live document fields and declared unique constraints. This is separate from the validation JSON Schema above.</p></div></header><div class="ts-card-body">@if(Model.Inferred.Length > 0){<pre class="ts-code">@Model.Inferred</pre>}else{<p class="ts-meta">Inferred fields are unavailable. Reload to try again.</p>}</div></section>
@if(Model.Shell.Context.CanManage){
<dialog id="remove-schema" class="ts-dialog" closedby="any" aria-labelledby="remove-schema-title" aria-describedby="remove-schema-description" data-init="@(Model.Removing ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="remove-schema-title">Remove validation schema from @Model.Collection?</h2><p class="ts-dialog-description" id="remove-schema-description">Future writes will no longer be checked against this JSON Schema. Documents and unique constraints remain.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="remove-schema">@Icons.Render("X",18)</button></header>
<form method="post" enctype="multipart/form-data" class="ts-form" data-submit-once><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="collection" value="@Model.Collection" /><input type="hidden" name="operation" value="remove" />@if(Model.Removing && Model.Error.Length > 0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}<div class="ts-field"><label class="ts-label" for="remove-schema-confirm">Type @Model.Collection to confirm</label><input class="ts-input ts-mono" id="remove-schema-confirm" name="confirmName" autocomplete="off" required /></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="remove-schema" autofocus>Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Remove schema</button></div></form></div></dialog>
}}
</main>
@functions { public ShellModel LayoutModel => Model.Shell; }
