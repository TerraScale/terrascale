@using System.Globalization
@using TerraScale.Dashboard.Common.Charts
@inherits RazorSlice<TerraScale.Dashboard.Features.Data.DataPage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.Data
@using System.Text.Json
@inject AssetUrls Assets
<main class="ts-page" data-database-id="@Model.Database.Id">
@(await RenderPartialAsync<TerraScale.Dashboard.Common.Databases.DatabaseFrame,DatabaseFrameModel>(new(Model.Database, "sql")))
@if(Model.Error.Length > 0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}
@if(Model.Error.Length > 0 || Model.FormError.Length > 0){<p class="ts-meta">Request ID: <code>@RequestIdentity.Id</code> · <a href="@("/support?relatedRequestId=" + RequestIdentity.Id)">Contact support</a></p>}
@if(Model.CreatedTable.Length > 0){<div class="ts-alert ts-alert-success" role="status"><p class="ts-alert-body">Created table @Model.CreatedTable.</p></div>}
@{ var catalog = Model.Catalog ?? SqlCatalog.Empty; }
<div class="ts-data-sql" data-sql-catalog="sql-catalog" data-sql-diagnostics="sql-diagnostics" data-sql-check="/api/v1/dashboard/data/sql/check"><script type="application/json" id="sql-catalog" nonce="@Model.Shell.Nonce">@(new Microsoft.AspNetCore.Html.HtmlString(JsonSerializer.Serialize(catalog,new JsonSerializerOptions(JsonSerializerDefaults.Web))))</script><script type="application/json" id="sql-diagnostics" nonce="@Model.Shell.Nonce">@(new Microsoft.AspNetCore.Html.HtmlString(JsonSerializer.Serialize(new { sql=Model.Sql, diagnostics=Model.Sql.Trim().Length == 0 ? [] : SqlValidation.Diagnostics(Model.Sql) },new JsonSerializerOptions(JsonSerializerDefaults.Web))))</script><div class="ts-data-sql-grid"><div class="ts-stack-lg"><section class="ts-card" id="sql-editor" aria-labelledby="sql-editor-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="sql-editor-title">Query</h2></div></header><div class="ts-card-body"><form id="sql-query-form" method="post" action="/api/v1/dashboard/data/sql" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><label class="ts-sr-only" for="sql">SQL</label><ts-code-editor class="ts-code-editor" data-language="sql"><textarea class="ts-input ts-mono" id="sql" name="sql" rows="8" spellcheck="false" autocapitalize="off" autocomplete="off" required data-max-bytes="16384" >@Model.Sql</textarea></ts-code-editor><div class="ts-form-actions">@if(Model.History is {Count:>0}){<input type="hidden" name="history" value="@JsonSerializer.Serialize(Model.History)" /><select class="ts-select ts-data-sql-history" data-sql-history aria-label="Recent queries" hidden><option value="">Recent queries</option>@foreach(var statement in Model.History){<option value="@statement">@SqlHistory.Label(statement)</option>}</select>}<button class="ts-btn ts-btn-ghost" type="button" data-sql-format hidden>@Icons.Render("Wand2",16)<span>Format</span></button><button class="ts-btn ts-btn-secondary" type="submit" formaction="/api/v1/dashboard/data/sql/check">@Icons.Render("CircleCheck",16)<span>Check input</span></button><button class="ts-btn ts-btn-primary" type="submit" aria-keyshortcuts="Control+Enter Meta+Enter">@Icons.Render("Play",16)<span>Run query</span></button>@if(Model.Context.CanWriteProjectData){<button class="ts-btn ts-btn-ghost" type="button" command="show-modal" commandfor="save-query">@Icons.Render("Save",16)<span>Save query</span></button>}</div></form></div></section>
@if(Model.SqlNotice.Length > 0){<div class="ts-alert ts-alert-warning" role="status" data-sql-notice><p class="ts-alert-body">@Model.SqlNotice</p></div>}
@if(Model.SqlResult is not null){@(await RenderPartialAsync<TerraScale.Dashboard.Features.Data.SqlResultView,DataPage>(Model))}
</div><div class="ts-stack-lg ts-data-sql-side">@if(Model.FormError.Length > 0 && Model.Dialog.Length==0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-title">@(Model.FormError.StartsWith("SQL outcome unknown", StringComparison.Ordinal) ? "Outcome unknown" : "Query failed")</p><p class="ts-alert-body">@Model.FormError</p></div>}else if(Model.Analysis.Ok){@(await RenderPartialAsync<TerraScale.Dashboard.Features.Data.SqlAnalysisCard,DataPage>(Model))}else if(!string.IsNullOrEmpty(Model.Analysis.Error) && Model.Sql.Trim().Length > 0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Analysis.Error</p></div>}
@(await RenderPartialAsync<TerraScale.Dashboard.Features.Data.SqlCatalogView,DataPage>(Model))
<section class="ts-card ts-card-boxed ts-card-flush" id="saved-queries" aria-labelledby="saved-queries-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="saved-queries-title">Saved queries</h2></div></header><div class="ts-card-body">@if(Model.SavedQueries is not { Count: > 0 }){<div class="ts-empty" role="status"><p class="ts-empty-title">No saved queries yet.</p></div>}else{<ul class="ts-data-queries">@foreach(var query in Model.SavedQueries){<li><a class="ts-data-query" href="@(DatabaseService.Path(Model.Database.Id,"sql")+"?savedQueryId="+Uri.EscapeDataString(query.Id))"><span class="ts-strong">@query.Name</span> <code>@query.Sql</code></a>@if(Model.Context.CanWriteProjectData){<button class="ts-icon-btn" type="button" command="show-modal" commandfor="@("delete-query-"+query.Id)" aria-label="@("Delete "+query.Name)">@Icons.Render("Trash2",15)</button>@(await RenderPartialAsync<TerraScale.Dashboard.Features.Data.QueryDeleteDialog,QueryDeleteModel>(new QueryDeleteModel(Model,query)))}</li>}</ul>}</div></section></div></div></div>
@if(Model.Context.CanWriteProjectData){<dialog id="save-query" class="ts-dialog" closedby="any" aria-labelledby="save-query-title" data-init="@(Model.Dialog=="save-query" ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="save-query-title">Save query</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="save-query">@Icons.Render("X",18)</button></header><form method="post" action="/api/v1/dashboard/data/saved-queries" class="ts-form">@if(Model.History is {Count:>0}){<input type="hidden" name="history" value="@JsonSerializer.Serialize(Model.History)" />}<input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />@if(Model.FormError.Length>0 && Model.Dialog=="save-query"){@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.DialogErrorView, DialogError>(new("save-query", Model.FormError)))}<div class="ts-field"><label class="ts-label" for="query-name">Name</label><input class="ts-input" id="query-name" name="name" pattern="[\s\S]*\S[\s\S]*" title="Enter a query name" value="@Model.QueryName" required data-max-bytes="128" /></div><div class="ts-field"><label class="ts-label" for="saved-sql">SQL query</label><ts-code-editor class="ts-code-editor" data-language="sql"><textarea class="ts-input ts-mono" id="saved-sql" name="sql" rows="6" spellcheck="false" autocapitalize="off" autocomplete="off" required data-max-bytes="16384" >@Model.Sql</textarea></ts-code-editor></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="save-query">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Save query</button></div></form></div></dialog>}
@(await RenderPartialAsync<TerraScale.Dashboard.Features.Data.CreateTableDialog, DataPage>(Model))
</main>
<script type="module" src="@Assets.Url("js/code-editor.js")" nonce="@Model.Shell.Nonce"></script>
<script type="module" src="@Assets.Url("js/create-table.js")" nonce="@Model.Shell.Nonce"></script>
<script type="module" src="@Assets.Url("js/sql-results.js")" nonce="@Model.Shell.Nonce"></script>
@functions { public ShellModel LayoutModel => Model.Shell; }
