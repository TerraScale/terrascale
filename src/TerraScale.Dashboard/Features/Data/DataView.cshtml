@inherits RazorSlice<TerraScale.Dashboard.Features.Data.DataPage>
@implements IUsesLayout<TerraScale.Dashboard.Shared.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.Data
@using System.Text.Json
@inject AssetUrls Assets
<main class="ts-page ts-db-detail" data-database-id="@Model.Database.Id">
@(await RenderPartialAsync<TerraScale.Dashboard.Shared.Databases.DatabaseFrame,DatabaseFrameModel>(new(Model.Database, Model.Section == "history" ? "documents" : Model.Section, Model.Collection)))
@if(Model.Error.Length > 0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}
@if(Model.FormError.Length > 0 && Model.Dialog.Length == 0 && Model.Section != "sql"){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.FormError</p></div>}
@if(Model.Error.Length > 0 || Model.FormError.Length > 0){<p class="ts-meta">Request ID: <code>@RequestIdentity.Id</code> · <a href="@("/support?relatedRequestId=" + RequestIdentity.Id)">Contact support</a></p>}
@if(Model.Section == "documents"){
<div class="ts-data-browser"><nav class="ts-data-nav" aria-label="Collections" data-signals="{collectionSearch: ''}"><div class="ts-data-nav-head"><h2 class="ts-data-nav-title">Collections</h2>@if(Model.Context.CanWrite){<button class="ts-icon-btn" type="button" command="show-modal" commandfor="new-collection" aria-label="New collection" title="New collection">@Icons.Render("Plus",16)</button>}</div>
@if(Model.Collections.Count > 8){<label class="ts-input-group">@Icons.Render("Filter",14)<input class="ts-input ts-input-sm ts-data-nav-filter" type="search" placeholder="Filter collections" aria-label="Filter collections" data-bind="collectionSearch" /></label>}
@if(Model.Collections.Count > 0){<ul class="ts-data-nav-list">@foreach(var collection in Model.Collections){<li data-collection="@collection.Name" data-show="$collectionSearch === '' || el.dataset.collection.toLowerCase().includes($collectionSearch.trim().toLowerCase())"><a class="ts-nav-link ts-data-nav-link" href="@("/databases/"+Uri.EscapeDataString(Model.Database.Id)+"/documents/"+Uri.EscapeDataString(collection.Name))" aria-current="@(Model.Collection == collection.Name ? "page" : null)"><span class="ts-nav-icon" aria-hidden="true">@Icons.Render("Table",16)</span><span class="ts-nav-label ts-truncate">@collection.Name</span> @if(Model.CollectionCounts is not null && Model.CollectionCounts.TryGetValue(collection.Name, out var count)){<span class="ts-meta ts-mono">@count<span class="ts-sr-only"> documents</span></span>}</a></li>}</ul><form class="ts-data-nav-select" method="get" action="@DatabaseService.Path(Model.Database.Id,"documents")"><label class="ts-sr-only" for="collection-select">Collection</label><select class="ts-select ts-input-sm ts-mono" id="collection-select" name="collection">@foreach(var collection in Model.Collections){<option value="@collection.Name" selected="@(collection.Name == Model.Collection)">@Model.CollectionLabel(collection.Name)</option>}</select><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Open</button></form>}else{<p class="ts-meta">No collections yet.</p>}</nav>
<div class="ts-data-browser-main">
@if(Model.Collections.Count == 0 && Model.Error.Length == 0){<div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("Layers", 16)</span><p class="ts-empty-title">This database has no collections yet.</p><p class="ts-empty-detail">Create a collection to start adding documents.</p>@if(Model.Context.CanWrite){<button class="ts-btn ts-btn-primary ts-btn-sm" type="button" command="show-modal" commandfor="new-collection">@Icons.Render("Plus",16)<span>New collection</span></button>}</div>}
else{
<div class="ts-data-bar"><form class="ts-filters ts-data-scope" method="get" action="@Model.BrowsePath()" aria-label="Search documents">@if(Model.Layout == "list"){<input type="hidden" name="view" value="list" />}@if(Model.Sort.Length > 0){<input type="hidden" name="sort" value="@Model.Sort" />}@if(Model.Descending){<input type="hidden" name="order" value="desc" />}<label class="ts-input-group">@Icons.Render("Search",14)<input class="ts-input ts-input-sm ts-data-search" type="search" name="q" value="@Model.Search" placeholder="@("Search "+Model.Collection)" aria-label="Search documents" /></label>@if(Model.Search.Length > 0){<a class="ts-btn ts-btn-ghost ts-btn-sm" href="@Model.BrowsePath(("q",""),("page",""))">Clear</a>}</form><div class="ts-row"><nav class="ts-segmented" aria-label="Document layout"><a class="ts-segment" href="@Model.BrowsePath(("view",""))" aria-current="@(Model.Layout == "grid" ? "page" : null)" aria-label="Grid view">Grid</a><a class="ts-segment" href="@Model.BrowsePath(("view","list"))" aria-current="@(Model.Layout == "list" ? "page" : null)" aria-label="List view">List</a></nav>@if(Model.Context.CanWrite){<button class="ts-btn ts-btn-ghost ts-btn-sm" type="button" command="show-modal" commandfor="delete-collection">@Icons.Render("Trash2",16)<span>Delete collection</span></button><button class="ts-btn ts-btn-primary ts-btn-sm" type="button" command="show-modal" commandfor="add-document">@Icons.Render("Plus",16)<span>Add document</span></button>}</div></div>
<section class="ts-card ts-card-flush" id="documents"><div class="ts-card-body">
@if(Model.Browse.Documents.Count == 0){<div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("FileJson", 16)</span><p class="ts-empty-title">No documents match this collection and filter.</p><p class="ts-empty-detail">Open another collection or add a document.</p></div>}else{
var grid = Model.Grid;
<div class="ts-table-wrap"><table class="ts-table @(Model.Layout == "grid" ? "ts-data-result ts-data-grid" : "ts-data-documents")"><thead><tr><th scope="col" aria-sort="@(Model.Sort.Length == 0 ? Model.Descending ? "descending" : "ascending" : null)"><a class="ts-data-sort" href="@Model.SortPath("")"><span>@(Model.Layout=="grid" ? "id" : "ID")</span>@if(Model.Sort.Length == 0){@Icons.Render(Model.Descending ? "ChevronDown" : "ChevronUp",12)}</a></th>@if(Model.Layout == "list"){<th>Document</th>}else{@foreach(var column in grid.Columns){<th scope="col" class="@(column.Numeric ? "ts-num" : null)" aria-sort="@(Model.Sort == column.Name ? Model.Descending ? "descending" : "ascending" : null)"><a class="ts-data-sort" href="@Model.SortPath(column.Name)"><span>@column.Label</span>@if(Model.Sort == column.Name){@Icons.Render(Model.Descending ? "ChevronDown" : "ChevronUp",12)}</a></th>}}<th class="ts-table-actions"><span class="ts-sr-only">Actions</span></th></tr></thead><tbody>@for(var index = 0; index < Model.Browse.Documents.Count; index++){
var document = Model.Browse.Documents[index];
<tr><td class="ts-data-result-id"><a class="ts-data-doc-id" href="@Model.BrowsePath(("edit",document.Id))">@document.Id</a></td>@if(Model.Layout == "list"){<td><code class="ts-data-json">@document.Document.GetRawText()</code></td>}else{@for(var cellIndex = 0; cellIndex < grid.Columns.Count; cellIndex++){var cell = grid.Rows[index].Cells[cellIndex];<td class="@(grid.Columns[cellIndex].Numeric ? "ts-num" : null)" data-kind="@cell.Kind" title="@cell.Title">@if(cell.Kind == "missing"){<span aria-hidden="true">—</span><span class="ts-sr-only">not set</span>}else{@cell.Text}</td>}}<td class="ts-table-actions"><details class="ts-menu ts-menu-end" data-on:click__outside="el.open = false" data-on:keydown__window="evt.key === 'Escape' &amp;&amp; el.open &amp;&amp; (el.open = false, el.querySelector('summary').focus())"><summary class="ts-icon-btn" aria-label="@("Actions for "+document.Id)">@Icons.Render("MoreHorizontal",16)</summary><div class="ts-menu-panel"><a class="ts-menu-item" href="@Model.BrowsePath(("edit",document.Id))">@Icons.Render(Model.Context.CanWrite ? "Pencil" : "Eye",15)<span>@(Model.Context.CanWrite ? "Edit" : "View")</span></a><a class="ts-menu-item" href="@(DatabaseService.Path(Model.Database.Id,"history",Model.Collection)+"&id="+Uri.EscapeDataString(document.Id))">@Icons.Render("History",15)<span>History</span></a>@if(Model.Context.CanWrite){<div class="ts-menu-separator" role="separator"></div><a class="ts-menu-item ts-menu-item-danger" href="@Model.BrowsePath(("delete",document.Id))">@Icons.Render("Trash2",15)<span>Delete</span></a>}</div></details></td></tr>}</tbody></table></div>
@if(grid.HiddenColumns > 0){<p class="ts-hint">@grid.HiddenColumns more fields are not shown; the list view has every field.</p>}
}

@if(Model.Browse.Matched > 0 || Model.Browse.More){<nav class="ts-pager" aria-label="Document pages"><span class="ts-meta">@Model.Summary</span><div class="ts-row">@if(Model.Browse.Page > 1){<a class="ts-btn ts-btn-secondary ts-btn-sm" href="@Model.BrowsePath(("page",(Model.Browse.Page-1).ToString()))">Previous</a>}@if(Model.Browse.Page < Model.Browse.PageCount){<a class="ts-btn ts-btn-secondary ts-btn-sm" href="@Model.BrowsePath(("page",(Model.Browse.Page+1).ToString()))">Next</a>}</div></nav>}
</div></section>
}
</div></div>
@if(Model.Collection.Length > 0){@(await RenderPartialAsync<TerraScale.Dashboard.Features.Data.DocumentChangesPanel, DataPage>(Model))}
@(await RenderPartialAsync<TerraScale.Dashboard.Features.Data.DocumentDialogs,DataPage>(Model))
}else if(Model.Section == "sql"){
var catalog = Model.Catalog ?? new SqlCatalog([],[]);
<div class="ts-data-sql" data-sql-catalog="sql-catalog" data-sql-diagnostics="sql-diagnostics" data-sql-check="/api/v1/dashboard/data/sql/check"><script type="application/json" id="sql-catalog" nonce="@Model.Shell.Nonce">@(new Microsoft.AspNetCore.Html.HtmlString(JsonSerializer.Serialize(catalog,new JsonSerializerOptions(JsonSerializerDefaults.Web))))</script><script type="application/json" id="sql-diagnostics" nonce="@Model.Shell.Nonce">@(new Microsoft.AspNetCore.Html.HtmlString(JsonSerializer.Serialize(new { sql=Model.Sql, diagnostics=SqlValidation.Diagnostics(Model.Sql) },new JsonSerializerOptions(JsonSerializerDefaults.Web))))</script><div class="ts-data-sql-grid"><div class="ts-stack-lg"><section class="ts-card" id="sql-editor" aria-labelledby="sql-editor-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="sql-editor-title">Query</h2><p class="ts-card-description">Run one SQL statement against this database&#39;s SQL tables (created with CREATE TABLE) as its own transaction, or check its input without running it. Document collections are not SQL tables; browse them in Documents.</p></div></header><div class="ts-card-body"><form method="post" action="/api/v1/dashboard/data/sql" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="collection" value="@Model.Collection" /><label class="ts-sr-only" for="sql">SQL</label><ts-code-editor class="ts-code-editor" data-language="sql"><textarea class="ts-input ts-mono" id="sql" name="sql" rows="8" spellcheck="false" autocapitalize="off" autocomplete="off">@Model.Sql</textarea></ts-code-editor><p class="ts-hint">Ctrl/Cmd+Enter runs the statement. Check input does not validate SQL syntax, tables or permissions.</p><div class="ts-form-actions">@if(Model.History is {Count:>0}){<input type="hidden" name="history" value="@JsonSerializer.Serialize(Model.History)" /><select class="ts-select ts-data-sql-history" data-sql-history aria-label="Recent queries" hidden><option value="">Recent queries</option>@foreach(var statement in Model.History){<option value="@statement">@SqlHistory.Label(statement)</option>}</select>}<button class="ts-btn ts-btn-ghost" type="button" data-sql-format hidden>@Icons.Render("Wand2",16)<span>Format</span></button><button class="ts-btn ts-btn-secondary" type="submit" formaction="/api/v1/dashboard/data/sql/check">@Icons.Render("CircleCheck",16)<span>Check input</span></button><button class="ts-btn ts-btn-primary" type="submit">@Icons.Render("Play",16)<span>Run query</span></button>@if(Model.Context.CanWrite){<button class="ts-btn ts-btn-ghost" type="button" command="show-modal" commandfor="save-query">@Icons.Render("Save",16)<span>Save query</span></button>}</div></form></div></section>
@if(Model.SqlResult is not null){@(await RenderPartialAsync<TerraScale.Dashboard.Features.Data.SqlResultView,DataPage>(Model))}
</div><div class="ts-stack-lg ts-data-sql-side">@if(Model.FormError.Length > 0 && Model.Dialog.Length==0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-title">Query failed</p><p class="ts-alert-body">@Model.FormError</p></div>}else if(Model.Analysis.Ok){@(await RenderPartialAsync<TerraScale.Dashboard.Features.Data.SqlAnalysisCard,DataPage>(Model))}else if(!string.IsNullOrEmpty(Model.Analysis.Error)){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Analysis.Error</p></div>}
<section class="ts-card ts-card-boxed ts-card-flush" id="saved-queries" aria-labelledby="saved-queries-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="saved-queries-title">Saved queries</h2><p class="ts-card-description">Shared with everyone in this project.</p></div></header><div class="ts-card-body">@if(Model.SavedQueries is not { Count: > 0 }){<div class="ts-empty" role="status"><p class="ts-empty-title">No saved queries yet.</p><p class="ts-empty-detail">Save a query to reuse it and share it with collaborators.</p></div>}else{<ul class="ts-data-queries">@foreach(var query in Model.SavedQueries){<li><a class="ts-data-query" href="@(DatabaseService.Path(Model.Database.Id,"sql",Model.Collection)+(Model.Collection.Length==0 ? "?" : "&")+"savedQueryId="+Uri.EscapeDataString(query.Id))"><span class="ts-strong">@query.Name</span> <code>@query.Sql</code></a>@if(Model.Context.CanWrite){<button class="ts-icon-btn" type="button" command="show-modal" commandfor="@("delete-query-"+query.Id)" aria-label="@("Delete "+query.Name)">@Icons.Render("Trash2",15)</button>@(await RenderPartialAsync<TerraScale.Dashboard.Features.Data.QueryDeleteDialog,QueryDeleteModel>(new QueryDeleteModel(Model,query)))}</li>}</ul>}</div></section></div></div></div>
@if(Model.Context.CanWrite){<dialog id="save-query" class="ts-dialog" closedby="any" aria-labelledby="save-query-title" data-init="@(Model.Dialog=="save-query" ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="save-query-title">Save query</h2><p class="ts-dialog-description">Saved queries are available to everyone with access to this project.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="save-query">@Icons.Render("X",18)</button></header><form method="post" action="/api/v1/dashboard/data/saved-queries" class="ts-form">@if(Model.History is {Count:>0}){<input type="hidden" name="history" value="@JsonSerializer.Serialize(Model.History)" />}<input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="collection" value="@Model.Collection" />@if(Model.FormError.Length>0 && Model.Dialog=="save-query"){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.FormError</p></div>}<div class="ts-field"><label class="ts-label" for="query-name">Name</label><input class="ts-input" id="query-name" name="name" maxlength="128" value="@Model.QueryName" required /></div><div class="ts-field"><label class="ts-label" for="saved-sql">SQL query</label><ts-code-editor class="ts-code-editor" data-language="sql"><textarea class="ts-input ts-mono" id="saved-sql" name="sql" rows="6" spellcheck="false" autocapitalize="off" autocomplete="off" required>@Model.Sql</textarea></ts-code-editor></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="save-query">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Save query</button></div></form></div></dialog>}
}else if(Model.Section == "indexes"){
@(await RenderPartialAsync<TerraScale.Dashboard.Features.Data.IndexesView,DataPage>(Model))
}else{
<a class="ts-data-back" href="@Model.BrowsePath()">@Icons.Render("ArrowLeft",15)<span>All documents</span></a><section class="ts-card" id="document-history" aria-labelledby="document-history-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="document-history-title">History of @Model.DocumentId</h2><p class="ts-card-description">Revisions of the document in @Model.Collection, oldest first.</p></div></header><div class="ts-card-body"><div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("History", 16)</span><p class="ts-empty-title">Revision history unavailable.</p><p class="ts-empty-detail">TerraBase does not expose revision history in the published SDK contract.</p></div></div></section>
}
</main>
@if(Model.Section is "documents" or "sql"){
<script type="module" src="@Assets.Url("js/code-editor.js")" nonce="@Model.Shell.Nonce"></script>
}
@if(Model.Section == "sql"){
<script type="module" src="@Assets.Url("js/sql-results.js")" nonce="@Model.Shell.Nonce"></script>
}
@if(Model.Section == "documents"){
<script type="module" src="@Assets.Url("js/document-changes.js")" nonce="@Model.Shell.Nonce"></script>
}
@functions { public ShellModel LayoutModel => Model.Shell; }
