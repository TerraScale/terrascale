@inherits RazorSlice<DataPageModel>
@using System.Globalization
@{
    var shell = Model.Shell;
    var store = shell.Store;
    var isCreate = HttpContext?.Request.Query["create"].ToString() == "1";
    var deleting = Model.DeletingId is { Length: > 0 } did ? store.SavedQueries.FirstOrDefault(q => q.Id == did) : null;
}
@ShellHtml.Top(shell)
<div class="ts-page ts-data">
    <section class="ts-panel ts-panel-pad20">
        <div class="ts-data-intro">
            <h2 class="ts-title-24">Data</h2>
        </div>
        <div class="ts-data-stats">
            <div class="ts-stat-card">
                <span class="ts-text-upper">PROJECT</span>
                <div class="ts-stat-project"><span class="ts-badge ts-badge-neutral">@Model.ShortProject</span></div>
            </div>
            <div class="ts-stat-card">
                <span class="ts-text-upper">SAVED QUERIES</span>
                <strong class="ts-stat-value">@Model.SavedQueryCount</strong>
            </div>
        </div>
    </section>

    @if (Model.Error is { } pageError)
    {
        <div class="ts-alert ts-alert-danger" role="alert" data-code="data_explorer_request_failed">
            @Icons.CircleAlert(19)
            <div>
                <div class="ts-alert-title">@pageError</div>
            </div>
        </div>
    }

    <section class="ts-panel">
        @if (Model.View == "queries")
        {
            <div class="ts-panel-header">
                <h3 class="ts-panel-title">Saved queries</h3>
            </div>
            <div class="ts-panel-pad">
                @if (store.SavedQueries.Length == 0)
                {
                    <div class="ts-empty">
                        <div class="ts-empty-content">
                            <span class="ts-empty-icon-box">@Icons.SearchX(16)</span>
                            <span class="ts-empty-title">No saved queries</span>
                            <span class="ts-ui">Save a project query to make it available to collaborators.</span>
                        </div>
                        <div class="ts-empty-action">
                            <a class="ts-btn ts-btn-secondary ts-btn-lg" href="/data?view=queries&amp;create=1">Save query</a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ts-actions-row">
                        <a class="ts-btn ts-btn-primary ts-btn-lg" href="/data?view=queries&amp;create=1">@Icons.Plus(20) Save query</a>
                    </div>
                    <div class="ts-table-frame">
                        <table class="ts-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Query</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var query in store.SavedQueries)
                                {
                                    <tr>
                                        <td><strong>@query.Name</strong></td>
                                        <td><code class="ts-query-cell">@query.Query</code></td>
                                        <td>
                                            <div class="ts-row-actions">
                                                <a class="ts-icon-btn ts-tip" data-tip="Edit @query.Name" href="/data?view=queries&amp;edit=@query.Id" aria-label="Edit @query.Name">@Icons.Pencil(16)</a>
                                                <a class="ts-icon-btn ts-icon-btn-danger ts-tip" data-tip="Delete @query.Name" href="/data?view=queries&amp;delete=@query.Id" aria-label="Delete @query.Name">@Icons.Trash2(16)</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        else if (Model.View == "table")
        {
            <div class="ts-panel-header">
                <h3 class="ts-panel-title">Collection documents</h3>
            </div>
            <div class="ts-panel-pad ts-explorer-pad">
                <div class="ts-alert ts-alert-info" role="alert" data-code="explorer_no_collections">
                    @Icons.Info(19)
                    <div>
                        <div class="ts-alert-title">Collection listing unavailable</div>
                        <div class="ts-alert-body">The SDK contract does not publish collections.list yet. Enter a collection name in the URL or use the document editor after selecting one.</div>
                    </div>
                </div>
                <form class="ts-explorer-controls" method="get" action="/data">
                    <input type="hidden" name="view" value="table" />
                    <select class="ts-select" name="database" aria-label="Database" data-on:change="evt.target.closest('form').requestSubmit()">
                        <option value="">Choose a database</option>
                        @foreach (var database in Model.Databases)
                        {
                            <option value="@database.Name" selected="@(database.Name == Model.SelectedDatabase)">@database.Name</option>
                        }
                    </select>
                    <label class="ts-field">
                        <span class="ts-label">Collection</span>
                        <input class="ts-input" name="collection" value="@Model.SelectedCollection" />
                    </label>
                    <button class="ts-btn ts-btn-secondary" type="submit">Refresh documents</button>
                </form>
                <p class="ts-context-line">@(Model.SelectedDatabase.Length > 0 && Model.SelectedCollection.Length > 0 ? $"{Model.SelectedDatabase} / {Model.SelectedCollection}" : "Choose a database and collection to load live rows.")</p>
                @if (Model.Documents.Length == 0)
                {
                    <div class="ts-empty ts-empty-mt">
                        <div class="ts-empty-content">
                            <span class="ts-empty-icon-box">@Icons.SearchX(16)</span>
                            <span class="ts-empty-title">No documents loaded</span>
                            <span class="ts-ui">Select a collection to read live documents from TerraBase.</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ts-filter-row">
                        <form class="ts-filter-field" method="get" action="/data">
                            <input type="hidden" name="view" value="table" />
                            <input type="hidden" name="database" value="@Model.SelectedDatabase" />
                            <input type="hidden" name="collection" value="@Model.SelectedCollection" />
                            <label class="ts-field">
                                <span class="ts-label">Filter documents</span>
                                <input class="ts-input" name="q" value="@(HttpContext?.Request.Query["q"].ToString())" placeholder="Search JSON values" />
                            </label>
                        </form>
                        <span class="ts-ui ts-muted">@{
                            var filter = HttpContext?.Request.Query["q"].ToString().Trim() ?? "";
                            var visible = filter.Length == 0
                                ? Model.Documents
                                : [.. Model.Documents.Where(d => d.Json.Contains(filter, StringComparison.OrdinalIgnoreCase))];
                        }Showing @visible.Length / @Model.Documents.Length</span>
                    </div>
                    @if (visible.Length == 0)
                    {
                        <div class="ts-empty">
                            <div class="ts-empty-content">
                                <span class="ts-empty-icon-box">@Icons.SearchX(16)</span>
                                <span class="ts-empty-title">No matching documents</span>
                                <span class="ts-ui">Adjust the document filter to see rows.</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="ts-table-frame">
                            <table class="ts-table">
                                <thead>
                                    <tr>
                                        <th>_id</th>
                                        <th>status</th>
                                        <th>customer</th>
                                        <th>total</th>
                                        <th>JSON</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var document in visible)
                                    {
                                        <tr>
                                            <td class="ts-table-mono">@document.Id</td>
                                            <td class="ts-table-mono">@ExtractField(document.Json, "status")</td>
                                            <td class="ts-table-mono">@ExtractField(document.Json, "customer")</td>
                                            <td class="ts-table-num">@ExtractField(document.Json, "total")</td>
                                            <td>
                                                <details class="ts-json-details">
                                                    <summary>View</summary>
                                                    <pre class="ts-snippet-body">@FormatJson(document.Json)</pre>
                                                </details>
                                            </td>
                                            <td>
                                                <div class="ts-row-actions">
                                                    <a class="ts-btn ts-btn-ghost ts-btn-sm" href="/data?view=editor&amp;database=@Uri.EscapeDataString(Model.SelectedDatabase)&amp;collection=@Uri.EscapeDataString(Model.SelectedCollection)&amp;edit=@document.Id">Edit</a>
                                                    <form method="post" action="/api/v1/dashboard/data/documents">
                                                        <input type="hidden" name="operation" value="delete" />
                                                        <input type="hidden" name="id" value="@document.Id" />
                                                        <input type="hidden" name="database" value="@Model.SelectedDatabase" />
                                                        <input type="hidden" name="collection" value="@Model.SelectedCollection" />
                                                        <button class="ts-btn ts-btn-destructive ts-btn-sm" type="submit">Delete</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        }
        else if (Model.View == "editor")
        {
            var editingDocument = HttpContext?.Request.Query["edit"].ToString() is { Length: > 0 } editId
                ? Model.Documents.FirstOrDefault(d => d.Id == editId)
                : null;
            <div class="ts-panel-header">
                <h3 class="ts-panel-title">Document editor</h3>
            </div>
            <div class="ts-panel-pad">
                <form class="ts-form" method="post" action="/api/v1/dashboard/data/documents" data-signals="{ docOp: 'create' }">
                    <input type="hidden" name="database" value="@Model.SelectedDatabase" />
                    <input type="hidden" name="collection" value="@Model.SelectedCollection" />
                    <label class="ts-field">
                        <span class="ts-label">Database</span>
                        <input class="ts-input" name="databaseDisplay" value="@Model.SelectedDatabase" readonly />
                        <span class="ts-hint">Writes use the selected public TerraBase database.</span>
                    </label>
                    <label class="ts-field">
                        <span class="ts-label">Collection</span>
                        <input class="ts-input" name="collectionDisplay" value="@Model.SelectedCollection" readonly />
                        <span class="ts-hint">Collection listing is unavailable in the published SDK; enter one explicitly.</span>
                    </label>
                    <label class="ts-field ts-field-flush">
                        <span class="ts-label">Operation</span>
                        <select class="ts-select" name="operation" data-on:change="$docOp = evt.target.value">
                            <option value="create">Create (PUT)</option>
                            <option value="update">Update (replace)</option>
                            <option value="patch">Patch (merge)</option>
                            <option value="delete">Delete</option>
                        </select>
                    </label>
                    <label class="ts-field">
                        <span class="ts-label">Document id</span>
                        <input class="ts-input ts-input-mono" name="id" value="@(editingDocument?.Id ?? "")" placeholder="Generated for create" />
                        <span class="ts-hint">Required for update, patch, and delete.</span>
                    </label>
                    <label class="ts-field ts-field-flush" data-show="$docOp !== 'delete'">
                        <span class="ts-label">Document JSON</span>
                        <textarea class="ts-textarea ts-textarea-mono" name="document" rows="8" spellcheck="false" aria-invalid="@(Model.Error is null ? null : "true")">@(editingDocument?.Json ?? "{\n  \"status\": \"active\"\n}")</textarea>
                    </label>
                    <p class="ts-ua-p" data-show="$docOp === 'delete'">The JSON body is ignored for delete.</p>
                    <div><button class="ts-btn ts-btn-primary" type="submit">Apply document operation</button></div>
                </form>
            </div>
        }
        else
        {
            var analysis = Model.SqlAnalysis;
            <div class="ts-panel-header">
                <h3 class="ts-panel-title">SQL console</h3>
            </div>
            <div class="ts-panel-pad">
                <form class="ts-sql-loader" method="get" action="/data">
                    <input type="hidden" name="view" value="sql" />
                    <input type="hidden" name="collection" value="@Model.SqlCollection" />
                    <label class="ts-field">
                        <span class="ts-label">Load a saved query</span>
                        <select class="ts-select" name="savedQueryId" data-on:change="window.location.assign('/data?view=sql&amp;collection=@Model.SqlCollection&amp;savedQueryId=' + evt.target.value)">
                            <option value="">Choose a saved query...</option>
                            @foreach (var query in store.SavedQueries)
                            {
                                <option value="@query.Id">@query.Name</option>
                            }
                        </select>
                    </label>
                </form>
                <form class="ts-form" method="post" action="/api/v1/dashboard/data/sql/check">
                    <label class="ts-field">
                        <span class="ts-label">Collection</span>
                        <input class="ts-input" name="collection" value="@Model.SqlCollection" />
                        <span class="ts-hint">Target collection for the statement above.</span>
                    </label>
                    <label class="ts-field">
                        <span class="ts-label">SQL</span>
                        <textarea class="ts-textarea ts-textarea-mono" name="sql" rows="6" spellcheck="false" placeholder="SELECT * FROM orders WHERE status = $1 LIMIT 25">@Model.Sql</textarea>
                    </label>
                    @if (analysis is { Ok: false })
                    {
                        <div class="ts-alert ts-alert-danger" role="alert" data-code="explorer_sql_invalid">
                            @Icons.CircleAlert(19)
                            <div>
                                <div class="ts-alert-title">@analysis.Error</div>
                            </div>
                        </div>
                    }
                    else if (analysis is { Ok: true })
                    {
                        var explainPrefix = Model.Sql.TrimStart().StartsWith("EXPLAIN", StringComparison.OrdinalIgnoreCase);
                        <div class="ts-alert @(explainPrefix ? "ts-alert-info" : "ts-alert-success")" role="alert" data-code="explorer_sql_valid">
                            @(explainPrefix ? Icons.Info(19) : Icons.CircleCheck(19))
                            <div>
                                <div class="ts-alert-title">@(analysis.Collection is null ? "Read-only statement accepted." : $"Read-only statement accepted on {analysis.Collection}.")</div>
                                <div class="ts-alert-body">Collection @(analysis.Collection ?? Model.SqlCollection); @analysis.ParameterSlots parameter slot(s); @(analysis.HasLimit ? "bounded with LIMIT." : "unbounded: add LIMIT.")</div>
                            </div>
                        </div>
                    }
                    @if (Model.SqlChecked && analysis is { Ok: true })
                    {
                        <div class="ts-alert ts-alert-success" role="alert" data-code="explorer_sql_server_checked">
                            @Icons.CircleCheck(19)
                            <div>
                                <div class="ts-alert-title">Server check passed.</div>
                            </div>
                        </div>
                    }
                    <div><button class="ts-btn ts-btn-primary" type="submit" disabled="@(Model.Sql.Trim().Length == 0 ? "disabled" : null)">Check SQL</button></div>
                </form>
                @if (analysis is { Ok: true })
                {
                    <div class="ts-stack-lg">
                        <label class="ts-field">
                            <span class="ts-label">EXPLAIN preview</span>
                            <textarea class="ts-textarea ts-textarea-mono" rows="4" readonly>@analysis.Explain</textarea>
                        </label>
                        <section class="ts-stack-sm">
                            <h4 class="ts-ua-h4">Index suggestions</h4>
                            @if (analysis.Suggestions.Length == 0)
                            {
                                <p class="ts-ua-p">No missing indexes detected for this statement.</p>
                            }
                            else
                            {
                                <div class="ts-table-frame">
                                    <table class="ts-table">
                                        <thead>
                                            <tr><th>Field</th><th>Reason</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var suggestion in analysis.Suggestions)
                                            {
                                                <tr>
                                                    <td class="ts-table-mono">@suggestion.Field</td>
                                                    <td>@suggestion.Reason</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </section>
                    </div>
                }
            </div>
        }
    </section>

    @if (Model.View == "queries" && Model.Editing is not null)
    {
        <dialog class="ts-dialog" data-autoopen>
            <div class="ts-dialog-content">
                <div class="ts-dialog-header">
                    <h3 class="ts-dialog-title">Edit saved query</h3>
                    <p class="ts-dialog-description">Saved queries are available to everyone with access to this project.</p>
                </div>
            @if (Model.Conflict)
            {
                <div class="ts-alert ts-alert-warning" role="alert">
                    @Icons.TriangleAlert(19)
                    <div>
                        <div class="ts-alert-title">Changed elsewhere</div>
                        <div class="ts-alert-body">Your draft remains unchanged. Reload the latest query before explicitly resubmitting.</div>
                    </div>
                </div>
                <a class="ts-btn ts-btn-secondary" href="/data?view=queries&amp;edit=@Model.Editing.Id">Reload latest</a>
            }
            <form class="ts-form" method="post" action="/api/v1/dashboard/data/saved-queries">
                <input type="hidden" name="view" value="queries" />
                <input type="hidden" name="savedQueryId" value="@Model.Editing.Id" />
                <input type="hidden" name="revision" value="@Model.Editing.Revision" />
                <label class="ts-field">
                    <span class="ts-label">Name</span>
                    <input class="ts-input" name="name" value="@Model.Editing.Name" required />
                </label>
                <label class="ts-field">
                    <span class="ts-label">SQL query</span>
                    <textarea class="ts-textarea ts-textarea-mono" name="query" rows="6" spellcheck="false" required>@Model.Editing.Query</textarea>
                </label>
                <div class="ts-form-actions">
                    <a class="ts-btn ts-btn-secondary" href="/data?view=queries">Cancel</a>
                    <button class="ts-btn ts-btn-primary" type="submit">Save query</button>
                </div>
            </form>
            </div>
        </dialog>
    }
    else if (Model.View == "queries" && isCreate)
    {
        <dialog class="ts-dialog" data-autoopen>
            <div class="ts-dialog-content">
                <div class="ts-dialog-header">
                    <h3 class="ts-dialog-title">Save query</h3>
                    <p class="ts-dialog-description">Saved queries are available to everyone with access to this project.</p>
                </div>
                <form class="ts-form" method="post" action="/api/v1/dashboard/data/saved-queries">
                    <input type="hidden" name="view" value="queries" />
                    <label class="ts-field">
                        <span class="ts-label">Name</span>
                        <input class="ts-input" name="name" required />
                    </label>
                    <label class="ts-field">
                        <span class="ts-label">SQL query</span>
                        <textarea class="ts-textarea ts-textarea-mono" name="query" rows="6" spellcheck="false" required></textarea>
                    </label>
                    <div class="ts-form-actions">
                        <a class="ts-btn ts-btn-secondary" href="/data?view=queries">Cancel</a>
                        <button class="ts-btn ts-btn-primary" type="submit">Save query</button>
                    </div>
                </form>
            </div>
        </dialog>
    }
    else if (Model.View == "queries" && deleting is not null)
    {
        <dialog class="ts-dialog" data-autoopen>
            <div class="ts-dialog-content">
                <div class="ts-dialog-header">
                    <h3 class="ts-dialog-title">Delete saved query</h3>
                    <p class="ts-dialog-description">Delete @deleting.Name? This cannot be undone.</p>
                </div>
                <div class="ts-form-actions">
                    <a class="ts-btn ts-btn-secondary" href="/data?view=queries">Cancel</a>
                    <form method="post" action="/api/v1/dashboard/data/saved-queries/delete">
                        <input type="hidden" name="view" value="queries" />
                        <input type="hidden" name="savedQueryId" value="@deleting.Id" />
                        <button class="ts-btn ts-btn-destructive" type="submit">Delete</button>
                    </form>
                </div>
            </div>
        </dialog>
    }
</div>
@functions
{
    private static string ExtractField(string json, string field)
    {
        var match = System.Text.RegularExpressions.Regex.Match(json, $@"""{field}"":\s*(""(?<q>[^""]*)""|(?<n>[0-9.]+))");
        return match.Success ? match.Groups["q"].Success ? match.Groups["q"].Value : match.Groups["n"].Value : "";
    }

    private static string FormatJson(string json)
    {
        try
        {
            var document = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(document, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (System.Text.Json.JsonException)
        {
            return json;
        }
    }
}
@ShellHtml.Bottom(shell)
