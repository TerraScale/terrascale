@inherits RazorSlice<DataPageModel>
@using System.Globalization
@{
    var shell = Model.Shell;
    var store = shell.Store;
    var isCreate = HttpContext?.Request.Query["create"].ToString() == "1";
    var deleting = Model.DeletingId is { Length: > 0 } did ? Model.SavedQueries.FirstOrDefault(q => q.Id == did) : null;
    (string Id, string Label, string Icon)[] tabs =
    [
        ("queries", "Saved queries", "BookOpen"),
        ("table", "Collection documents", "Table"),
        ("editor", "Document editor", "FileText"),
        ("sql", "SQL console", "Terminal"),
    ];
}
@ShellHtml.Top(shell)
<div class="ts-page ts-data">
    <div class="ts-toolbar">
        <nav class="ts-tabs" aria-label="Data views">
            @foreach (var (id, label, icon) in tabs)
            {
                <a class="ts-tab" href="@Model.ViewHref(id)" aria-current="@(Model.View == id ? "page" : null)" aria-selected="@(Model.View == id ? "true" : "false")">@IconByName(icon, 16) @label</a>
            }
        </nav>
        @if (Model.View is "queries" or "table")
        {
            <form class="ts-filters" method="get" action="/data" role="search" aria-label="Filter @((Model.View == "queries" ? "saved queries" : "documents"))">
                <input type="hidden" name="view" value="@Model.View" />
                @if (Model.View == "table")
                {
                    <label class="ts-filter-field">
                        <span class="ts-sr-only">Database</span>
                        <select class="ts-select" name="database" aria-label="Database">
                            <option value="">Choose a database</option>
                            @foreach (var database in Model.Databases)
                            {
                                <option value="@database.Name" selected="@(database.Name == Model.SelectedDatabase)">@database.Name</option>
                            }
                        </select>
                    </label>
                    <label class="ts-filter-field">
                        <span class="ts-sr-only">Collection</span>
                        <input class="ts-input" name="collection" value="@Model.SelectedCollection" placeholder="Collection" />
                    </label>
                }
                <label class="ts-filter-field ts-data-search">
                    <span class="ts-sr-only">Filter @((Model.View == "queries" ? "saved queries" : "documents"))</span>
                    <input class="ts-input" name="q" value="@Model.Filter" placeholder="@(Model.View == "queries" ? "Search saved queries" : "Search JSON values")" />
                </label>
                <button class="ts-btn ts-btn-secondary" type="submit">Filter</button>
                @if (Model.Filter.Length > 0 || (Model.View == "table" && (Model.SelectedDatabase.Length > 0 || Model.SelectedCollection.Length > 0)))
                {
                    <a class="ts-btn ts-btn-ghost" href="/data?view=@Model.View">Clear</a>
                }
            </form>
        }
    </div>

    @if (Model.Error is { } pageError)
    {
        <div class="ts-alert ts-alert-danger" role="alert" data-code="data_explorer_request_failed">
            <span class="ts-alert-title">@Icons.CircleAlert(16) @pageError</span>
        </div>
    }
    @if (Model.Notice is { } notice)
    {
        <div class="ts-alert ts-alert-success" role="status">
            <span class="ts-alert-title">@Icons.CircleCheck(16) @notice</span>
        </div>
    }

    @if (Model.View == "queries")
    {
        <section class="ts-section" aria-labelledby="data-queries-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="data-queries-title">Saved queries</h2>
                    <p class="ts-meta">Project queries available to everyone with access to this project.</p>
                </div>
                <a class="ts-btn ts-btn-primary" href="/data?view=queries&amp;create=1">@Icons.Plus(16) Save query</a>
            </div>
            @if (Model.ResultTotal == 0)
            {
                <div class="ts-empty">
                    <div class="ts-empty-content">
                        <span class="ts-empty-icon-box">@Icons.SearchX(16)</span>
                        <span class="ts-empty-title">@(Model.Filter.Length > 0 ? "No saved queries match" : "No saved queries")</span>
                        <span class="ts-ui">@(Model.Filter.Length > 0 ? "Adjust the filter to find a saved query." : "Save a project query to make it available to collaborators.")</span>
                    </div>
                </div>
            }
            else
            {
                <div class="ts-table-wrap">
                    <table class="ts-table">
                        <thead>
                            <tr><th>Name</th><th>Query</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var query in Model.VisibleSavedQueries)
                            {
                                <tr>
                                    <td class="ts-table-strong">@query.Name</td>
                                    <td><code class="ts-query-cell">@query.Query</code></td>
                                    <td>
                                        <div class="ts-row-actions">
                                            <a class="ts-icon-btn ts-tip" data-tip="Edit @query.Name" href="/data?view=queries&amp;edit=@query.Id" aria-label="Edit @query.Name">@Icons.Pencil(16)</a>
                                            <a class="ts-icon-btn ts-icon-btn-danger ts-tip" data-tip="Delete @query.Name" href="/data?view=queries&amp;delete=@query.Id" aria-label="Delete @query.Name">@Icons.Trash2(16)</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @Pager(Model, "Saved query pages")
            }
        </section>
    }
    else if (Model.View == "table")
    {
        <section class="ts-section" aria-labelledby="data-documents-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="data-documents-title">Collection documents</h2>
                    <p class="ts-meta">Read live rows from a selected database and collection.</p>
                </div>
                <a class="ts-btn ts-btn-primary" href="/data?view=editor&amp;database=@Uri.EscapeDataString(Model.SelectedDatabase)&amp;collection=@Uri.EscapeDataString(Model.SelectedCollection)">@Icons.Plus(16) Add document</a>
            </div>
            <div class="ts-alert ts-alert-info" role="status" data-code="explorer_no_collections">
                <span class="ts-alert-title">@Icons.Info(16) Collection listing unavailable</span>
                <span class="ts-alert-body">The SDK contract does not publish collections.list yet. Enter a collection name in the toolbar or use the document editor after selecting one.</span>
            </div>
            <p class="ts-context-line">@(Model.SelectedDatabase.Length > 0 && Model.SelectedCollection.Length > 0 ? $"{Model.SelectedDatabase} / {Model.SelectedCollection}" : "Choose a database and collection to load live rows.")</p>
            @if (Model.Documents.Length == 0)
            {
                <div class="ts-empty">
                    <div class="ts-empty-content">
                        <span class="ts-empty-icon-box">@Icons.SearchX(16)</span>
                        <span class="ts-empty-title">No documents loaded</span>
                        <span class="ts-ui">Select a collection to read live documents from TerraBase.</span>
                    </div>
                </div>
            }
            else if (Model.ResultTotal == 0)
            {
                <div class="ts-empty">
                    <div class="ts-empty-content">
                        <span class="ts-empty-icon-box">@Icons.SearchX(16)</span>
                        <span class="ts-empty-title">No matching documents</span>
                        <span class="ts-ui">Adjust the document filter to see rows.</span>
                    </div>
                </div>
            }
            else
            {
                <div class="ts-table-wrap">
                    <table class="ts-table">
                        <thead>
                            <tr><th>_id</th><th>status</th><th>customer</th><th>total</th><th>JSON</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var document in Model.VisibleDocuments)
                            {
                                <tr>
                                    <td class="ts-table-strong ts-table-mono">@document.Id</td>
                                    <td class="ts-table-mono">@ExtractField(document.Json, "status")</td>
                                    <td class="ts-table-mono">@ExtractField(document.Json, "customer")</td>
                                    <td class="ts-table-num">@ExtractField(document.Json, "total")</td>
                                    <td>
                                        <details class="ts-json-details">
                                            <summary>View</summary>
                                            <pre class="ts-snippet-body">@FormatJson(document.Json)</pre>
                                        </details>
                                    </td>
                                    <td>
                                        <div class="ts-row-actions">
                                            <a class="ts-btn ts-btn-ghost ts-btn-sm" href="/data?view=editor&amp;database=@Uri.EscapeDataString(Model.SelectedDatabase)&amp;collection=@Uri.EscapeDataString(Model.SelectedCollection)&amp;edit=@document.Id">Edit</a>
                                            <form method="post" action="/api/v1/dashboard/data/documents">
                                                <input type="hidden" name="operation" value="delete" />
                                                <input type="hidden" name="id" value="@document.Id" />
                                                <input type="hidden" name="database" value="@Model.SelectedDatabase" />
                                                <input type="hidden" name="collection" value="@Model.SelectedCollection" />
                                                <button class="ts-btn ts-btn-destructive ts-btn-sm" type="submit">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @Pager(Model, "Document pages")
            }
        </section>
    }
    else if (Model.View == "editor")
    {
        var editingDocument = HttpContext?.Request.Query["edit"].ToString() is { Length: > 0 } editId
            ? Model.Documents.FirstOrDefault(d => d.Id == editId)
            : null;
        <section class="ts-section" aria-labelledby="data-editor-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="data-editor-title">Document editor</h2>
                    <p class="ts-meta">Create, replace, merge or delete a document in the selected collection.</p>
                </div>
            </div>
            <form class="ts-form ts-data-form" method="post" action="/api/v1/dashboard/data/documents" data-signals="{ docOp: 'create' }">
                <input type="hidden" name="database" value="@Model.SelectedDatabase" />
                <input type="hidden" name="collection" value="@Model.SelectedCollection" />
                <label class="ts-field">
                    <span class="ts-label">Database</span>
                    <input class="ts-input" name="databaseDisplay" value="@Model.SelectedDatabase" readonly />
                    <span class="ts-hint">Writes use the selected public TerraBase database.</span>
                </label>
                <label class="ts-field">
                    <span class="ts-label">Collection</span>
                    <input class="ts-input" name="collectionDisplay" value="@Model.SelectedCollection" readonly />
                    <span class="ts-hint">Collection listing is unavailable in the published SDK; enter one explicitly.</span>
                </label>
                <label class="ts-field">
                    <span class="ts-label">Operation</span>
                    <select class="ts-select" name="operation" data-on:change="$docOp = evt.target.value">
                        <option value="create">Create (PUT)</option>
                        <option value="update">Update (replace)</option>
                        <option value="patch">Patch (merge)</option>
                        <option value="delete">Delete</option>
                    </select>
                </label>
                <label class="ts-field">
                    <span class="ts-label">Document id</span>
                    <input class="ts-input ts-input-mono" name="id" value="@(editingDocument?.Id ?? "")" placeholder="Generated for create" />
                    <span class="ts-hint">Required for update, patch, and delete.</span>
                </label>
                <label class="ts-field" data-show="$docOp !== 'delete'">
                    <span class="ts-label">Document JSON</span>
                    <textarea class="ts-textarea ts-textarea-mono" name="document" rows="8" spellcheck="false" aria-invalid="@(Model.Error is null ? null : "true")">@(editingDocument?.Json ?? "{\n  \"status\": \"active\"\n}")</textarea>
                </label>
                <p class="ts-ua-p" data-show="$docOp === 'delete'">The JSON body is ignored for delete.</p>
                <div><button class="ts-btn ts-btn-primary" type="submit">Apply document operation</button></div>
            </form>
        </section>
    }
    else
    {
        var analysis = Model.SqlAnalysis;
        <section class="ts-section" aria-labelledby="data-sql-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="data-sql-title">SQL console</h2>
                    <p class="ts-meta">Check read-only SQL before sending it to a collection.</p>
                </div>
            </div>
            <form class="ts-sql-loader" method="get" action="/data">
                <input type="hidden" name="view" value="sql" />
                <input type="hidden" name="collection" value="@Model.SqlCollection" />
                <label class="ts-field">
                    <span class="ts-label">Load a saved query</span>
                    <select class="ts-select" name="savedQueryId" data-on:change="window.location.assign('/data?view=sql&amp;collection=@Model.SqlCollection&amp;savedQueryId=' + evt.target.value)">
                        <option value="">Choose a saved query...</option>
                        @foreach (var query in Model.SavedQueries)
                        {
                            <option value="@query.Id">@query.Name</option>
                        }
                    </select>
                </label>
            </form>
            <form class="ts-form ts-data-form" method="post" action="/api/v1/dashboard/data/sql/check">
                <label class="ts-field">
                    <span class="ts-label">Collection</span>
                    <input class="ts-input" name="collection" value="@Model.SqlCollection" />
                    <span class="ts-hint">Target collection for the statement above.</span>
                </label>
                <label class="ts-field">
                    <span class="ts-label">SQL</span>
                    <textarea class="ts-textarea ts-textarea-mono" name="sql" rows="6" spellcheck="false" placeholder="SELECT * FROM orders WHERE status = $1 LIMIT 25">@Model.Sql</textarea>
                </label>
                @if (analysis is { Ok: false })
                {
                    <div class="ts-alert ts-alert-danger" role="alert" data-code="explorer_sql_invalid">
                        <span class="ts-alert-title">@Icons.CircleAlert(16) @analysis.Error</span>
                    </div>
                }
                else if (analysis is { Ok: true })
                {
                    var explainPrefix = Model.Sql.TrimStart().StartsWith("EXPLAIN", StringComparison.OrdinalIgnoreCase);
                    <div class="ts-alert @(explainPrefix ? "ts-alert-info" : "ts-alert-success")" role="status" data-code="explorer_sql_valid">
                        <span class="ts-alert-title">@(explainPrefix ? Icons.Info(16) : Icons.CircleCheck(16)) @(analysis.Collection is null ? "Read-only statement accepted." : $"Read-only statement accepted on {analysis.Collection}.")</span>
                        <span class="ts-alert-body">Collection @(analysis.Collection ?? Model.SqlCollection); @analysis.ParameterSlots parameter slot(s); @(analysis.HasLimit ? "bounded with LIMIT." : "unbounded: add LIMIT.")</span>
                    </div>
                }
                @if (Model.SqlChecked && analysis is { Ok: true })
                {
                    <div class="ts-alert ts-alert-success" role="status" data-code="explorer_sql_server_checked">
                        <span class="ts-alert-title">@Icons.CircleCheck(16) Server check passed.</span>
                    </div>
                }
                <div><button class="ts-btn ts-btn-primary" type="submit" disabled="@(Model.Sql.Trim().Length == 0 ? "disabled" : null)">Check SQL</button></div>
            </form>
            @if (analysis is { Ok: true })
            {
                <div class="ts-stack-lg">
                    <label class="ts-field">
                        <span class="ts-label">EXPLAIN preview</span>
                        <textarea class="ts-textarea ts-textarea-mono" rows="4" readonly>@analysis.Explain</textarea>
                    </label>
                    <section class="ts-stack-sm" aria-labelledby="data-suggestions-title">
                        <h3 class="ts-section-h3" id="data-suggestions-title">Index suggestions</h3>
                        @if (analysis.Suggestions.Length == 0)
                        {
                            <p class="ts-ua-p">No missing indexes detected for this statement.</p>
                        }
                        else
                        {
                            <div class="ts-table-wrap">
                                <table class="ts-table">
                                    <thead><tr><th>Field</th><th>Reason</th></tr></thead>
                                    <tbody>
                                        @foreach (var suggestion in analysis.Suggestions)
                                        {
                                            <tr><td class="ts-table-mono">@suggestion.Field</td><td>@suggestion.Reason</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                </div>
            }
        </section>
    }

    @if (Model.View == "queries" && Model.Editing is not null)
    {
        <dialog class="ts-dialog" data-autoopen>
            <div class="ts-dialog-content">
                <div class="ts-dialog-header">
                    <h3 class="ts-dialog-title">Edit saved query</h3>
                    <p class="ts-dialog-description">Saved queries are available to everyone with access to this project.</p>
                </div>
                @if (Model.Conflict)
                {
                    <div class="ts-alert ts-alert-warning" role="alert">
                        <span class="ts-alert-title">@Icons.TriangleAlert(16) Changed elsewhere</span>
                        <span class="ts-alert-body">Your draft remains unchanged. Reload the latest query before explicitly resubmitting.</span>
                    </div>
                    <a class="ts-btn ts-btn-secondary" href="/data?view=queries&amp;edit=@Model.Editing.Id">Reload latest</a>
                }
                <form class="ts-form" method="post" action="/api/v1/dashboard/data/saved-queries">
                    <input type="hidden" name="view" value="queries" />
                    <input type="hidden" name="savedQueryId" value="@Model.Editing.Id" />
                    <input type="hidden" name="revision" value="@Model.Editing.Revision" />
                    <label class="ts-field"><span class="ts-label">Name</span><input class="ts-input" name="name" value="@Model.Editing.Name" required /></label>
                    <label class="ts-field"><span class="ts-label">SQL query</span><textarea class="ts-textarea ts-textarea-mono" name="query" rows="6" spellcheck="false" required>@Model.Editing.Query</textarea></label>
                    <div class="ts-form-actions"><a class="ts-btn ts-btn-secondary" href="/data?view=queries">Cancel</a><button class="ts-btn ts-btn-primary" type="submit">Save query</button></div>
                </form>
            </div>
        </dialog>
    }
    else if (Model.View == "queries" && isCreate)
    {
        <dialog class="ts-dialog" data-autoopen>
            <div class="ts-dialog-content">
                <div class="ts-dialog-header"><h3 class="ts-dialog-title">Save query</h3><p class="ts-dialog-description">Saved queries are available to everyone with access to this project.</p></div>
                <form class="ts-form" method="post" action="/api/v1/dashboard/data/saved-queries">
                    <input type="hidden" name="view" value="queries" />
                    <label class="ts-field"><span class="ts-label">Name</span><input class="ts-input" name="name" required /></label>
                    <label class="ts-field"><span class="ts-label">SQL query</span><textarea class="ts-textarea ts-textarea-mono" name="query" rows="6" spellcheck="false" required></textarea></label>
                    <div class="ts-form-actions"><a class="ts-btn ts-btn-secondary" href="/data?view=queries">Cancel</a><button class="ts-btn ts-btn-primary" type="submit">Save query</button></div>
                </form>
            </div>
        </dialog>
    }
    else if (Model.View == "queries" && deleting is not null)
    {
        <dialog class="ts-dialog" data-autoopen>
            <div class="ts-dialog-content">
                <div class="ts-dialog-header"><h3 class="ts-dialog-title">Delete saved query</h3><p class="ts-dialog-description">Delete @deleting.Name? This cannot be undone.</p></div>
                <div class="ts-form-actions"><a class="ts-btn ts-btn-secondary" href="/data?view=queries">Cancel</a><form method="post" action="/api/v1/dashboard/data/saved-queries/delete"><input type="hidden" name="view" value="queries" /><input type="hidden" name="savedQueryId" value="@deleting.Id" /><button class="ts-btn ts-btn-destructive" type="submit">Delete</button></form></div>
            </div>
        </dialog>
    }
</div>
@functions
{
    private static Microsoft.AspNetCore.Html.HtmlString IconByName(string name, int size) =>
        (typeof(Icons).GetMethod(name)?.Invoke(null, [size]) as Microsoft.AspNetCore.Html.HtmlString) ?? Icons.Circle(size);

    private static Microsoft.AspNetCore.Html.HtmlString Pager(DataPageModel model, string label)
    {
        var html = new System.Text.StringBuilder($"<nav class=\"ts-pager\" aria-label=\"{label}\"><span class=\"ts-meta\">Showing {model.ResultFirst}–{model.ResultLast} of {model.ResultTotal}</span>");
        if (model.ResultPageCount > 1)
        {
            html.Append("<span class=\"ts-row ts-row-tight\">");
            if (model.Page > 1)
            {
                html.Append($"<a class=\"ts-btn ts-btn-ghost\" href=\"{model.ResultHref(model.Page - 1)}\" rel=\"prev\"><span class=\"ts-usage-flip\">{Icons.ChevronRight(14).Value}</span> Previous</a>");
            }
            for (var page = 1; page <= model.ResultPageCount; page++)
            {
                var ariaCurrent = page == model.Page ? "page" : "false";
                html.Append($"<a class=\"ts-btn ts-btn-ghost ts-pager-page\" href=\"{model.ResultHref(page)}\" aria-current=\"{ariaCurrent}\">{page}</a>");
            }
            if (model.Page < model.ResultPageCount)
            {
                html.Append($"<a class=\"ts-btn ts-btn-ghost\" href=\"{model.ResultHref(model.Page + 1)}\" rel=\"next\">Next {Icons.ChevronRight(14).Value}</a>");
            }
            html.Append("</span>");
        }
        html.Append("</nav>");
        return new Microsoft.AspNetCore.Html.HtmlString(html.ToString());
    }

    private static string ExtractField(string json, string field)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            if (document.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object
                || !document.RootElement.TryGetProperty(field, out var value))
            {
                return "";
            }

            return value.ValueKind switch
            {
                System.Text.Json.JsonValueKind.String => value.GetString() ?? "",
                System.Text.Json.JsonValueKind.Number
                    or System.Text.Json.JsonValueKind.True
                    or System.Text.Json.JsonValueKind.False => value.GetRawText(),
                _ => "",
            };
        }
        catch (System.Text.Json.JsonException)
        {
            return "";
        }
    }

    private static string FormatJson(string json)
    {
        try
        {
            var document = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(document, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (System.Text.Json.JsonException)
        {
            return json;
        }
    }
}
@ShellHtml.Bottom(shell)
