@inherits RazorSlice<HistoryPageModel>
@{
    var shell = Model.Shell;
    var history = Model.History;
    var database = HttpContext?.Request.Query["database"].ToString() ?? "";
    var collection = HttpContext?.Request.Query["collection"].ToString() ?? "";
    var document = HttpContext?.Request.Query["document"].ToString() ?? "";
    (string Id, string Label, string Icon, string Href)[] tabs =
    [
        ("data", "Explorer", "Table", "/data"),
        ("schema", "Schema", "FileText", "/schema"),
        ("indexes", "Indexes", "Table", "/indexes"),
        ("history", "History", "History", "/history"),
    ];
}
@functions
{
    private static Microsoft.AspNetCore.Html.HtmlString IconByName(string name, int size) =>
        (typeof(Icons).GetMethod(name)?.Invoke(null, [size]) as Microsoft.AspNetCore.Html.HtmlString) ?? Icons.Circle(size);
}
@ShellHtml.Top(shell)
<div class="ts-page ts-data ts-history">
    <div class="ts-toolbar">
        <nav class="ts-tabs" aria-label="Data views">
            @foreach (var (id, label, icon, href) in tabs)
            {
                <a class="ts-tab" href="@href" aria-current="@(id == "history" ? "page" : null)" aria-selected="@(id == "history" ? "true" : "false")">@IconByName(icon, 16) @label</a>
            }
        </nav>
        <form class="ts-filters ts-history-filters" method="get" action="/history" role="search" aria-label="Choose history document">
            <label class="ts-filter-field"><span class="ts-sr-only">Database</span><input class="ts-input" name="database" value="@database" placeholder="Database" /></label>
            <label class="ts-filter-field"><span class="ts-sr-only">Collection</span><input class="ts-input" name="collection" value="@collection" placeholder="Collection" /></label>
            <label class="ts-filter-field"><span class="ts-sr-only">Document</span><input class="ts-input" name="document" value="@document" placeholder="Document ID" /></label>
            <button class="ts-btn ts-btn-secondary" type="submit">Load</button>
            @if (database.Length > 0 || collection.Length > 0 || document.Length > 0)
            {
                <a class="ts-btn ts-btn-ghost" href="/history">Clear</a>
            }
        </form>
    </div>

    <section class="ts-section" aria-labelledby="history-title">
        <div class="ts-section-head">
            <div>
                <h2 class="ts-panel-title" id="history-title">Document history</h2>
                <p class="ts-meta">Inspect causal versions and understand deterministic conflict resolution.</p>
            </div>
            @Icons.History(16)
        </div>
        <p class="ts-page-desc">Retained versions include their dot, HLC, causal context, merge policy, and conflict explanation.</p>
    </section>

    @if (history.LimitedByRetention)
    {
        <div class="ts-alert ts-alert-warning" role="status">
            <span class="ts-alert-title">@Icons.TriangleAlert(16) History is limited by retention</span>
            <span class="ts-alert-body">Only the last @history.RetentionDays days are retained. Older versions cannot be recovered from the database.</span>
        </div>
    }

    <section class="ts-section" aria-labelledby="history-unavailable-title">
        <div class="ts-section-head">
            <div>
                <h2 class="ts-panel-title" id="history-unavailable-title">History unavailable</h2>
                <p class="ts-meta">The history producer is not reachable in this environment.</p>
            </div>
        </div>
        <div class="ts-alert ts-alert-danger" role="alert">
            <span class="ts-alert-title">@Icons.CircleAlert(16) Document history could not be loaded</span>
            <span class="ts-alert-body">@history.Message</span>
        </div>
    </section>
</div>
@ShellHtml.Bottom(shell)
