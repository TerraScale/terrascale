@inherits RazorSlice<TerraScale.Dashboard.Features.Data.QueryDeleteModel>
@{ var dialog = "delete-query-" + Model.Query.Id; }
<dialog id="@dialog" class="ts-dialog" closedby="any" aria-labelledby="@(dialog + "-title")" aria-describedby="@(dialog + "-description")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@(dialog + "-title")">Delete @Model.Query.Name?</h2><p class="ts-dialog-description" id="@(dialog + "-description")">Everyone in this project loses this saved query.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@dialog">@Icons.Render("X", 18)</button></header>
<form method="post" action="/api/v1/dashboard/data/saved-queries/delete" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Page.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Page.Database.Id" /><input type="hidden" name="collection" value="@Model.Page.Collection" /><input type="hidden" name="id" value="@Model.Query.Id" />@if (Model.Page.History is { Count: > 0 }) { <input type="hidden" name="history" value="@System.Text.Json.JsonSerializer.Serialize(Model.Page.History)" /> }
<div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="@dialog">Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Delete query</button></div></form></div></dialog>
