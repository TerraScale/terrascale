@inherits RazorSlice<TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationPage>
@using TerraScale.Dashboard.Features.AuthenticationManagement
@{
    var data = Model.Data!; var brand = data.EmailBranding; var table = data.Tables["emails"];
    string template = HttpContext!.Request.Query["template"].ToString(), selectedLocale = HttpContext.Request.Query["locale"].ToString();
    var name = brand.BrandName ?? data.Branding.Name;
    var row = table.Rows.FirstOrDefault(item => item.Cells[0] == template && item.Cells[2] == selectedLocale) ?? table.Rows.FirstOrDefault(item => item.Cells[0] == template) ?? table.Rows[0];
    string Cell(string column) => Array.IndexOf(table.Columns, column) is var index and >= 0 && index < row.Cells.Length ? row.Cells[index] : "";
    // Sample values for the preview only; ts-auth fills the real ones when it sends.
    string Fill(string text) => text.Replace("{{ app_name }}", name).Replace("{{ user.name }}", "Ada").Replace("{{ organization.name }}", "Acme Inc.").Replace("{{ inviter.name }}", "Grace Hopper");
}
<section class="ts-card ts-card-boxed" id="auth-email-sender" aria-labelledby="auth-email-sender-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-email-sender-title">Sender and branding</h2><p class="ts-card-description">Every field is optional: empty keeps the default.</p></div></header><div class="ts-card-body"><form class="ts-idp-form-2" method="post" action="/api/v1/auth-management/emails"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
@foreach (var field in new[] { ("brand_name", "Product name", brand.BrandName, "text", "Shown as {{ app_name }} and as the logo's alt text.", ""), ("sender_name", "Sender name", brand.SenderName, "text", "", ""), ("reply_to", "Reply-to", brand.ReplyTo, "email", "", ""), ("support_email", "Support email", brand.SupportEmail, "email", "", "help@example.com"), ("logo_url", "Logo URL (light backgrounds)", brand.LogoUrl, "url", "HTTPS PNG, JPEG or GIF. Needs width and height.", ""), ("logo_dark_url", "Logo URL (dark backgrounds)", brand.LogoDarkUrl, "url", "", "Uses the light logo when empty"), ("logo_width", "Logo width", brand.LogoWidth?.ToString(System.Globalization.CultureInfo.InvariantCulture), "number", "", "120"), ("logo_height", "Logo height", brand.LogoHeight?.ToString(System.Globalization.CultureInfo.InvariantCulture), "number", "", "32"), ("icon_url", "Icon URL", brand.IconUrl, "url", "", "https://assets.example.com/icon.png"), ("website_url", "Website URL", brand.WebsiteUrl, "url", "", ""), ("support_url", "Support URL", brand.SupportUrl, "url", "", "https://example.com/help"), ("footer_text", "Footer text", brand.FooterText, "text", "", "") }) {
<div class="@(field.Item1 == "footer_text" ? "ts-field ts-idp-span" : "ts-field")"><label class="ts-label" for="@("auth-email-" + field.Item1)">@field.Item2</label><input class="@(field.Item4 == "number" ? "ts-input ts-mono" : "ts-input")" id="@("auth-email-" + field.Item1)" type="@field.Item4" name="@field.Item1" value="@field.Item3" placeholder="@field.Item6" readonly disabled />@if (field.Item5.Length > 0) { <p class="ts-hint">@field.Item5</p> }</div>
}
@foreach (var color in new[] { ("primary_color", "Primary color", brand.PrimaryColor), ("accent_color", "Accent color", brand.AccentColor) }) {
<div class="ts-field"><label class="ts-label" for="@("auth-email-" + color.Item1)">@color.Item2</label><span class="ts-idp-color-row"><input class="ts-idp-color" type="color" value="@(color.Item3 ?? "#2158e8")" aria-label="@(color.Item2 + " picker")" disabled /><input class="ts-input ts-mono" id="@("auth-email-" + color.Item1)" name="@color.Item1" value="@color.Item3" placeholder="Default" readonly disabled /></span></div>
}
@foreach (var choice in new[] { ("Button style", brand.ButtonStyle ?? "pill", new[] { "pill", "square" }), ("Email theme", brand.Theme ?? "light", new[] { "light", "dark" }) }) {
<div class="ts-field"><span class="ts-label">@choice.Item1</span><div class="ts-segmented" role="group" aria-label="@choice.Item1">@foreach (var option in choice.Item3) { <button class="ts-segment" type="button" aria-pressed="@(option == choice.Item2 ? "true" : "false")" disabled>@(char.ToUpperInvariant(option[0]) + option[1..])</button> }</div></div>
}
<div class="ts-form-actions ts-idp-span"><button class="ts-btn ts-btn-primary" type="submit" aria-describedby="auth-emails-readonly" disabled>Save branding</button></div></form></div></section>
<section class="ts-card ts-card-boxed" id="auth-emails" aria-labelledby="auth-emails-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-emails-title">Templates</h2><p class="ts-card-description">Edit the copy of each email per locale. Empty fields keep the default wording.</p></div><div class="ts-card-actions"><form class="ts-filters" method="get" action="/auth/emails/preview"><label class="ts-sr-only" for="auth-email-kind">Email</label><select class="ts-select" id="auth-email-kind" name="template" data-on:change="el.form.requestSubmit()">@foreach (var item in table.Rows.DistinctBy(item => item.Cells[0])) { <option value="@item.Cells[0]" selected="@(item.Cells[0] == row.Cells[0])">@item.Cells[0]</option> }</select><label class="ts-sr-only" for="auth-email-locale">Locale</label><select class="ts-select" id="auth-email-locale" name="locale" data-on:change="el.form.requestSubmit()">@foreach (var locale in table.Rows.Select(item => item.Cells[2]).Distinct()) { <option value="@locale" selected="@(locale == row.Cells[2])">@locale</option> }</select><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Preview</button></form></div></header>
<div class="ts-card-body ts-idp-email"><form class="ts-form" method="post" action="/api/v1/auth-management/emails"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><p class="ts-meta"><span class="ts-badge ts-badge-tone" data-tone="@row.Tone"><span class="ts-dot" aria-hidden="true"></span>@row.Status</span> wording</p>
@foreach (var field in new[] { ("Subject", "Also the document title."), ("Preheader", "Inbox preview line."), ("Heading", ""), ("Body", "A blank line starts a paragraph, a newline breaks a line."), ("Button", "Link emails only."), ("Footnote", "The security note at the end of the card.") }) {
if (field.Item1 == "Button" && Cell("Button").Length == 0) { continue; }
var id = "auth-email-" + field.Item1.ToLowerInvariant();
<div class="ts-field"><label class="ts-label" for="@id">@(field.Item1 == "Button" ? "Button label" : field.Item1)</label>@if (field.Item1 == "Body") { <textarea class="ts-input" id="@id" name="body" rows="4" readonly disabled>@Cell("Body")</textarea> } else { <input class="ts-input" id="@id" name="@field.Item1.ToLowerInvariant()" value="@Cell(field.Item1)" readonly disabled /> }@if (field.Item2.Length > 0) { <p class="ts-hint">@field.Item2</p> }</div>
}
<div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit" aria-describedby="auth-emails-readonly" disabled>Save template</button><button class="ts-btn ts-btn-ghost" type="button" aria-describedby="auth-emails-readonly" disabled>Reset to default</button></div></form>
<figure class="ts-idp-email-preview" aria-label="@("Preview of " + row.Cells[0])"><div class="ts-idp-email-meta"><span><strong>From:</strong> @(brand.SenderName ?? name)</span>@if (brand.ReplyTo is { } replyTo) { <span><strong>Reply-to:</strong> @replyTo</span> }<span><strong>Subject:</strong> @Fill(Cell("Subject"))</span></div><div class="ts-idp-email-brand"><span aria-hidden="true"></span>@name</div><div class="ts-idp-email-card"><p class="ts-idp-email-heading">@Fill(Cell("Heading"))</p><p>@Fill(Cell("Body"))</p>@if (Cell("Button").Length > 0) { <span class="ts-idp-email-button">@Fill(Cell("Button"))</span> }<p class="ts-idp-email-foot">@Fill(Cell("Footnote"))</p></div>@if (brand.FooterText is { } footer) { <figcaption class="ts-idp-email-meta">@footer</figcaption> }</figure></div><p class="ts-meta" id="auth-emails-readonly">@AuthenticationConsole.ReadOnly</p></section>
