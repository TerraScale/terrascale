@inherits RazorSlice<TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationPage>
@using TerraScale.Dashboard.Features.AuthenticationManagement
@inject AssetUrls Assets
@{
    var data = Model.Data; var name = data?.Branding.Name ?? "TerraScale";
    var page = HttpContext!.Request.Query["page"].ToString() is "sign-up" or "reset" ? HttpContext.Request.Query["page"].ToString() : "sign-in";
    var host = data is null ? "" : data.Issuer.Replace("https://", "", StringComparison.Ordinal);
}
<div class="ts-idp-branding"><section class="ts-card ts-card-boxed" id="auth-branding" aria-labelledby="auth-branding-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-branding-title">Hosted page branding</h2><p class="ts-card-description">@Model.Section.Description</p></div></header><div class="ts-card-body"><form class="ts-form" method="post" action="/api/v1/auth-management/instance"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><div class="ts-field"><label class="ts-label" for="auth-instance-name">Application name</label><input class="ts-input" id="auth-instance-name" name="name" value="@data?.Branding.Name" required maxlength="128" disabled /><p class="ts-hint">Shown in page titles, emails, and the sign-in heading.</p></div><div class="ts-field"><label class="ts-label" for="auth-logo-url">Logo URL</label><input class="ts-input" id="auth-logo-url" type="url" name="logo_url" placeholder="https://assets.example.com/logo.svg" value="@data?.Branding.LogoUrl" disabled /><p class="ts-hint">An HTTPS image, ideally a square SVG or PNG.</p></div><div class="ts-field"><label class="ts-label" for="auth-theme-color">Theme color</label><span class="ts-idp-color-row"><input class="ts-idp-color" id="auth-theme-color" type="color" name="theme_color" value="@data?.Branding.ThemeColor" disabled /><input class="ts-input ts-mono" value="@data?.Branding.ThemeColor" aria-label="Theme color hex" placeholder="Default" readonly disabled /></span><p class="ts-hint">Used for buttons and links on the hosted pages.</p></div><div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit" disabled>Save branding</button><button class="ts-btn ts-btn-secondary" type="button" disabled>Reset to TerraScale</button></div></form></div></section>
<figure class="ts-idp-preview"><div class="ts-idp-preview-bar"><nav class="ts-segmented" aria-label="Preview page">@foreach (var item in new[] { ("sign-in", "Sign in"), ("sign-up", "Sign up"), ("reset", "Reset") }) { <a class="ts-segment" href="@("/auth/branding?page=" + item.Item1)" aria-current="@(item.Item1 == page ? "page" : null)">@item.Item2</a> }</nav>@if (host.Length > 0) { <span class="ts-idp-preview-url ts-mono">@Icons.Render("LockKeyhole", 13)@(host + "/" + page)</span> }</div>
<div class="ts-idp-preview-card" aria-hidden="true"><span class="ts-idp-preview-brand"><img src="@Assets.Url("brand/logo-icon-blue.svg")" alt="" width="24" height="24" />@name</span><span class="ts-idp-preview-title">@(page switch { "sign-up" => "Create your " + name + " account", "reset" => "Reset your password", _ => "Sign in to " + name })</span>
@if (page != "reset") { <span class="ts-idp-preview-sso"><img src="@Assets.Url("brand/github.svg")" alt="" width="16" height="16" />Continue with GitHub</span><span class="ts-idp-preview-sso"><img src="@Assets.Url("brand/google.svg")" alt="" width="16" height="16" />Continue with Google</span><span class="ts-idp-preview-divider">or</span> }
<span class="ts-idp-preview-input">you@company.com</span><span class="ts-btn ts-btn-primary ts-idp-preview-button">@(page == "reset" ? "Send reset link" : "Continue")</span><span class="ts-idp-preview-link">@(page == "sign-in" ? "Use single sign-on (SSO)" : page == "sign-up" ? "Already have an account? Sign in" : "Back to sign in")</span></div>
<figcaption class="ts-meta">@(data is null ? "Live preview unavailable. This shows the default TerraScale brand, not your application." : data.Branding.LogoUrl is null ? name + " has no logo yet, so hosted pages show the default TerraScale mark." : "The dashboard preview shows the TerraScale mark; hosted pages show your logo.")</figcaption></figure></div>
