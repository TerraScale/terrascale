@inherits RazorSlice<TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationPage>
@inject AssetUrls Assets
<dialog id="auth-directory-export" class="ts-dialog" closedby="any" aria-labelledby="auth-directory-export-title"><div class="ts-dialog-content">
<header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="auth-directory-export-title">Export users</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="auth-directory-export">@Icons.Render("X", 18)</button></header>
<form class="ts-form" method="post" action="/api/v1/auth-management/users/export" id="auth-export-form">
<input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
<input type="hidden" name="project_id" value="@Model.Context.Project?.Id" />
<input type="hidden" name="after" id="auth-export-after" value="" />
<div class="ts-field"><label class="ts-label" for="auth-export-format">Format</label><select class="ts-select" id="auth-export-format" name="format" required><option value="json">JSON</option><option value="csv">CSV</option></select></div>
<p class="ts-meta" role="status" id="auth-export-status"></p><div class="ts-alert ts-alert-danger" role="alert" id="auth-export-error" hidden><p class="ts-alert-body"></p></div>
<div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="auth-directory-export">Cancel</button><button class="ts-btn ts-btn-secondary" type="reset" hidden>Start over</button><button class="ts-btn ts-btn-primary" type="submit">Download</button></div>
</form></div></dialog>
<script type="module" src="@Assets.Url("js/auth-directory-export.js")" nonce="@Model.Shell.Nonce"></script>
