@inherits RazorSlice<TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationPage>
@inject AssetUrls Assets
<details class="ts-stack" id="auth-directory-export">
<summary class="ts-strong">Export users</summary>
<form class="ts-form" method="post" action="/api/v1/auth-management/users/export" id="auth-export-form">
<input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
<input type="hidden" name="project_id" value="@Model.Context.Project?.Id" />
<input type="hidden" name="after" id="auth-export-after" value="" />
<div class="ts-field"><label class="ts-label" for="auth-export-format">Format</label><select class="ts-select" id="auth-export-format" name="format"><option value="json">JSON</option><option value="csv">CSV</option></select></div>
<p class="ts-meta" role="status" id="auth-export-status"></p>
<div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Download</button><button class="ts-btn ts-btn-secondary" type="reset" hidden>Start over</button></div>
</form></details>
<script type="module" src="@Assets.Url("js/auth-directory-export.js")" nonce="@Model.Shell.Nonce"></script>
