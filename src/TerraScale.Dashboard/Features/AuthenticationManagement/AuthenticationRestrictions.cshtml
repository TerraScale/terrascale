@using TerraScale.Dashboard.Features.AuthenticationManagement
@inherits RazorSlice<AuthenticationPage>
@{
    var settings = Model.Settings;
    var restrictions = settings?.Restrictions;
    var manage = Model.Context.CanManageProject;
}

@if (settings is null)
{
<section class="ts-card ts-card-boxed ts-card-flush"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-restrictions-title">Restrictions</h2></div></header><div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">Restrictions are unavailable.</p></div></div></section>
}
else
{
<form class="ts-form" method="post" action="/api/v1/auth-management/restrictions" data-on:submit="@("@post(el.action, {contentType:'form'})")">
<input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
<section class="ts-card ts-card-boxed ts-card-flush ts-idp-settings"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-restrictions-title">Restrictions</h2></div></header>
<div class="ts-card-body"><fieldset class="ts-form" disabled="@(!manage)">
<fieldset class="ts-chips"><legend class="ts-label">Sign-up mode</legend>@foreach (var mode in new[] { ("public", "Public"), ("restricted", "Invitation only"), ("waitlist", "Waitlist") }) { <label class="ts-chip"><input type="radio" name="sign_up_mode" value="@mode.Item1" checked="@(settings.Methods.SignUpMode == mode.Item1)" disabled="@(!manage)" /><span>@mode.Item2</span></label> }</fieldset>
<div class="ts-field"><label class="ts-label" for="signup-allowlist">Allowlist</label><textarea class="ts-input ts-mono" id="signup-allowlist" name="allowlist" rows="5" placeholder="person@example.com&#10;example.com" disabled="@(!manage)">@string.Join(Environment.NewLine, restrictions?.Allowlist ?? [])</textarea></div>
<div class="ts-field"><label class="ts-label" for="signup-blocklist">Blocklist</label><textarea class="ts-input ts-mono" id="signup-blocklist" name="blocklist" rows="5" placeholder="person@example.com&#10;example.com" disabled="@(!manage)">@string.Join(Environment.NewLine, restrictions?.Blocklist ?? [])</textarea></div>
</fieldset></div></section>
<section class="ts-card ts-card-boxed ts-card-flush ts-idp-settings"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title">Email protection</h2></div><div class="ts-card-actions"></div></header><div class="ts-card-body"><fieldset class="ts-form" disabled="@(!manage)">
<label class="ts-check"><input type="checkbox" name="block_disposable_emails" checked="@(restrictions?.BlockDisposableEmails == true)" disabled="@(!manage)" /><span>Block disposable email domains</span></label>
<label class="ts-check"><input type="checkbox" name="block_email_aliases" checked="@(restrictions?.BlockEmailAliases == true)" disabled="@(!manage)" /><span>Block + aliases</span></label>
</fieldset></div>
@if (manage) { <footer class="ts-card-foot"><button class="ts-btn ts-btn-primary" type="submit">Save restrictions</button></footer> }
</section>
</form>
}
