@inherits RazorSlice<TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationPage>
@implements IUsesLayout<TerraScale.Dashboard.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.AuthenticationManagement
@inject AssetUrls Assets
@{
    var current = Model.Section; var data = Model.Data;
    bool Done(string key) => data is not null && (key == "clients" ? data.Tables["clients"].Rows.Length > 0 : key == "sign-in" ? data.Enabled.Count > 0 : data.Branding.LogoUrl is not null);
    void Methods(string page)
    {
        var labels = data?.Enabled is null ? null : Strategies.Where(group => group.Page == page).SelectMany(group => group.Items).Where(item => data.Enabled.Contains(item.Key)).Select(item => item.Label).ToArray();
        if (labels is null) { <span class="ts-meta">Unavailable</span> return; }
        if (labels.Length == 0) { <span class="ts-meta">None enabled</span> return; }
        <span class="ts-idp-badges">@foreach (var label in labels) { <span class="ts-idp-badge">@label</span> }</span>
    }
    void Table(AuthenticationTable table, string search = "", int take = int.MaxValue)
    {
        var rows = table.Rows.Where(row => search.Length == 0 || row.Cells.Append(row.Status).Any(cell => cell.Contains(search, StringComparison.OrdinalIgnoreCase))).Take(take).ToArray();
        if (rows.Length == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No matches</p><p class="ts-empty-detail">Nothing matches “@search”.</p></div> return; }
        <div class="ts-table-wrap"><table class="ts-table"><thead><tr>@foreach (var column in table.Columns) { <th>@column</th> }</tr></thead><tbody>@foreach (var row in rows) { <tr>@for (var index = 0; index < row.Cells.Length; index++) { var cell = row.Cells[index]; var column = table.Columns[index]; <td class="@(index == 0 ? "ts-table-strong" : column is "Username" or "Slug" or "Client ID" or "Prefix" or "Claims" or "SCIM base URL" ? "ts-mono" : null)">@if (column == "Location" && Regions.Country(cell) is { Length: > 0 } country) { <span class="ts-db-region"><img class="ts-db-region-flag" src="@Assets.Url("flags/" + country + ".svg")" alt="" aria-hidden="true" /><span class="ts-mono">@cell.ToLowerInvariant()</span></span> } else if (column == "Role") { <span class="ts-badge">@cell</span> } else { @cell }</td> }@if (row.Status.Length > 0) { <td><span class="ts-badge ts-badge-tone" data-tone="@row.Tone"><span class="ts-dot" aria-hidden="true"></span>@row.Status</span></td> }</tr> }</tbody></table></div>
    }
}
<main class="ts-page ts-idp" data-auth-section="@current.Key">
<h1 class="ts-sr-only">@Model.Heading</h1><div class="ts-page-actions"></div>
<form class="ts-idp-mobile-nav" method="get" action="/auth"><label class="ts-sr-only" for="auth-section-select">Authentication section</label><select class="ts-select" id="auth-section-select" name="section" data-on:change="el.form.requestSubmit()">@foreach(var section in AuthenticationSection.All){<option value="@(section.Key)" selected="@(section.Key == current.Key)">@(section.Title)</option>}</select><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Open</button></form>
<div class="ts-idp-layout"><nav aria-label="Authentication sections">@foreach (var group in NavGroups()) { <div class="ts-nav-group">@if (group[0].Group.Length > 0) { <div class="ts-nav-group-label">@group[0].Group</div> }<ul class="ts-nav">@foreach (var section in group) { <li><a class="ts-nav-link" href="@("/auth/" + section.Key)" aria-current="@(section.Key == current.Key ? "page" : null)"><span class="ts-nav-icon" aria-hidden="true">@Icons.Render(section.Icon, 16)</span><span class="ts-nav-label">@(section.Title)</span></a></li> }</ul></div> }</nav><div class="ts-stack-lg ts-idp-content">
@if (data is null) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationConsole.Unavailable</p></div> }
@if (!Model.Context.CanManage && current.Key is not ("overview" or "quickstart" or "audit")) { <div class="ts-alert ts-alert-info" role="status"><p class="ts-alert-body">You can view this configuration. Organization owners and admins can change it.</p></div> }
@if (current.Key == "overview") {
<dl class="ts-stats ts-idp-stats" aria-label="Identity totals">@foreach (var (key, hue) in new[] { ("users", 5), ("organizations", 1), ("connections", 3), ("clients", 2), ("webhooks", 4) }) { <div class="ts-stat"><dt class="ts-stat-label"><span class="ts-idp-stat-dot" data-hue="@hue" aria-hidden="true"></span>@AuthenticationSection.Find(key)!.Title</dt><dd class="ts-stat-value">@(data is null ? "—" : data.Tables[key].Rows.Length.ToString(System.Globalization.CultureInfo.InvariantCulture))</dd><dd class="ts-stat-detail">@(data is null ? "Unavailable" : "In this instance")</dd></div> }</dl>
<div class="ts-grid-2 ts-idp-overview"><section class="ts-card" id="auth-checklist" aria-labelledby="auth-checklist-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-checklist-title">Set up authentication</h2><p class="ts-card-description">@(data is null ? "Setup progress is unavailable." : new[] { "clients", "sign-in", "branding" }.Count(Done) + " of 3 steps done.")</p></div></header><div class="ts-card-body"><ol class="ts-idp-checklist">@foreach (var step in new[] { (Key: "clients", Title: "Register an OAuth application", Detail: "Create a client with the redirect URI your app handles.", Icon: "Boxes"), (Key: "sign-in", Title: "Configure sign-in", Detail: "Choose how users sign in to your application.", Icon: "LockKeyhole"), (Key: "branding", Title: "Customize hosted pages", Detail: "Set your application's name, logo, and color.", Icon: "Wand2") }) { var stepDone = Done(step.Key); var pending = data is not null && !stepDone; <li class="ts-idp-check"><span class="ts-idp-tile" aria-hidden="true">@Icons.Render(step.Icon, 16)</span><div class="ts-list-main"><span class="ts-strong">@step.Title</span><span class="ts-meta">@step.Detail</span></div>@if (stepDone) { <span class="ts-idp-check-icon" role="img" aria-label="Done">@Icons.Render("Check", 16)</span> }<a class="ts-btn @(pending ? "ts-btn-primary" : "ts-btn-secondary") ts-btn-sm" href="@("/auth/" + step.Key)">@(pending ? "Start" : "View")</a></li> }</ol></div></section><div class="ts-stack"><section class="ts-card" id="auth-experience" aria-labelledby="auth-experience-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-experience-title">Sign-in experience</h2><p class="ts-card-description">What users see on the hosted sign-in page.</p></div><div class="ts-card-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="/auth/sign-in">Configure</a></div></header><div class="ts-card-body"><dl class="ts-kv ts-idp-experience"><dt>Sign-in methods</dt><dd>@{ Methods("sign-in"); }</dd><dt>Multi-factor</dt><dd>@{ Methods("mfa"); }</dd><dt>SSO</dt><dd>@(data?.Sso ?? "Unavailable")</dd></dl></div></section><section class="ts-card" id="auth-instance" aria-labelledby="auth-instance-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-instance-title">Instance</h2><p class="ts-card-description">Share these with the applications that sign users in.</p></div></header><div class="ts-card-body"><dl class="ts-kv ts-idp-endpoints"><dt>Project</dt><dd class="ts-strong">@Model.Context.Project?.Name</dd><dt>Issuer</dt>@if (data is null) { <dd>Unavailable</dd> } else { <dd><span class="ts-idp-copy ts-idp-issuer"><code class="ts-idp-copy-value" id="auth-issuer">@data.Issuer</code><button class="ts-icon-btn" type="button" aria-label="Copy issuer" title="Copy issuer" data-signals="{_issuerCopy: ''}" data-on:click="(navigator.clipboard?.writeText(document.getElementById('auth-issuer').textContent) ?? Promise.reject()).then(() => { $_issuerCopy = 'Copied'; setTimeout(() => $_issuerCopy = '', 2000) }, () => $_issuerCopy = 'Copy failed')">@Icons.Render("Copy", 14)</button><span class="ts-sr-only" role="status" data-text="$_issuerCopy"></span></span></dd> }<dt>Sign-in page</dt>@if (data is null) { <dd>Unavailable</dd> } else { <dd><a href="@(data.Issuer + "/sign-in")">@(data.Issuer + "/sign-in")</a></dd> }</dl></div></section></div></div>
<section class="ts-card" id="auth-activity" aria-labelledby="auth-activity-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-activity-title">Recent changes</h2><p class="ts-card-description">The latest authentication changes in this project.</p></div><div class="ts-card-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="/auth/audit">Audit log</a></div></header><div class="ts-card-body">@if (data is null) { <div class="ts-empty" role="status"><p class="ts-empty-title">Authentication activity unavailable</p></div> } else { Table(data.Tables["audit"], take: 5); }</div></section>
}
else if (current.Key == "branding") {
@(await RenderPartialAsync<AuthenticationBrandingView, AuthenticationPage>(Model))
}
else if (current.Key is "sign-in" or "mfa") {
@foreach (var group in Strategies.Where(group => group.Page == current.Key)) {
<section class="ts-card ts-idp-setting-card" id="@("auth-" + group.Id)" aria-labelledby="@("auth-" + group.Id + "-title")"><header class="ts-idp-setting-head"><span class="ts-idp-tile" aria-hidden="true">@Icons.Render(group.Icon, 16)</span><div class="ts-card-heading"><h2 class="ts-card-title" id="@("auth-" + group.Id + "-title")">@group.Title</h2><p class="ts-card-description">@group.Description</p></div></header><ul class="ts-idp-settings">@foreach (var item in group.Items) { <li class="ts-idp-setting"><div class="ts-idp-setting-text"><p class="ts-strong" id="@("setting-" + item.Key)">@item.Label</p><p class="ts-meta">@item.Description</p></div><form class="ts-idp-switch-form" method="post" action="/api/v1/auth-management/settings"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="setting" value="@item.Key" />@if (data is null) { <button class="ts-switch" type="submit" aria-label="Setting unavailable" aria-labelledby="@("setting-" + item.Key)" aria-describedby="auth-settings-unavailable" disabled></button> } else { <button class="ts-switch" type="submit" role="switch" aria-checked="@(data.Enabled.Contains(item.Key) ? "true" : "false")" aria-labelledby="@("setting-" + item.Key)" aria-describedby="auth-settings-unavailable" disabled></button> }</form></li> }</ul></section>
}<p class="ts-meta" id="auth-settings-unavailable">@(data is null ? "This project has a ts-auth tenant, but its customer management API and matching project credential binding are unavailable to the dashboard." : AuthenticationConsole.ReadOnly)</p>
}
else if (current.Key == "danger") {
<section class="ts-card ts-idp-danger" id="auth-danger" aria-labelledby="auth-danger-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-danger-title">@current.Title</h2><p class="ts-card-description">@current.Description</p></div></header><div class="ts-card-body"><ul class="ts-idp-settings"><li class="ts-idp-setting"><div class="ts-idp-setting-text"><p class="ts-strong">Sign out all users</p><p class="ts-meta">Ends every active session now. Users must sign in again; issued access tokens stay valid until their short expiry.</p></div><button class="ts-btn ts-btn-danger ts-btn-sm" type="button" aria-describedby="auth-danger-unavailable" disabled>Sign out all users</button></li><li class="ts-idp-setting"><div class="ts-idp-setting-text"><p class="ts-strong">Reset emails to defaults</p><p class="ts-meta">Clears the sender, branding and every template override in every locale. ts-auth sends its default emails again.</p></div><button class="ts-btn ts-btn-danger ts-btn-sm" type="button" aria-describedby="auth-danger-unavailable" disabled>Reset emails</button></li></ul><p class="ts-meta" id="auth-danger-unavailable">@(data is null ? AuthenticationConsole.Unavailable : AuthenticationConsole.ReadOnly)</p></div></section>
}
else if (current.Fields is not null) {
<section class="ts-card" id="@("auth-" + current.Key)" aria-labelledby="@("auth-" + current.Key + "-title")"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="@("auth-" + current.Key + "-title")">@current.Title</h2><p class="ts-card-description">@current.Description</p></div><div class="ts-card-actions"><form class="ts-filters" method="get" action="@("/auth/" + current.Key)" role="search" aria-label="@("Search " + current.Title.ToLowerInvariant())"><input class="ts-input ts-input-sm" type="search" name="q" value="@Model.Search" placeholder="@("Search " + current.Title.ToLowerInvariant())" aria-label="@("Search " + current.Title.ToLowerInvariant())" disabled="@(data is null)" /></form>@if (Model.Context.CanManage) { <button class="ts-btn ts-btn-primary ts-btn-sm" type="button" command="show-modal" commandfor="auth-create" disabled>@Icons.Render("Plus", 15)<span>Add @current.Noun</span></button> }</div></header><div class="ts-card-body">@if (data is not null) { Table(data.Tables[current.Key], Model.Search); } else {<div class="ts-idp-empty"><span class="ts-idp-tile" aria-hidden="true">@Icons.Render(current.Icon, 16)</span><p class="ts-empty-title">@current.Title unavailable</p><p class="ts-empty-detail">@TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationConsole.Unavailable</p></div>}</div></section>
@if (Model.Context.CanManage) {
<dialog id="auth-create" class="ts-dialog" aria-labelledby="auth-create-title"><form class="ts-dialog-content" method="post" action="@("/api/v1/auth-management/" + current.Key)"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="auth-create-title">Add @current.Noun</h2><p class="ts-dialog-description">@current.Description</p></div><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><div class="ts-form">
@foreach (var field in current.Fields) {
if (field.Type == "choices") { <fieldset class="ts-field ts-idp-choices" disabled><legend class="ts-label">@field.Label</legend><div class="ts-idp-choice-grid">@foreach (var choice in field.Options ?? []) { <label class="ts-check"><input type="checkbox" name="@field.Key" value="@choice" /><span class="ts-mono">@choice</span></label> }</div>@if (field.Hint.Length > 0) { <p class="ts-hint">@field.Hint</p> }</fieldset> }
else { <div class="ts-field"><label class="ts-label" for="@("auth-create-" + field.Key)">@field.Label@if (!field.Required) { <span class="ts-idp-optional">Optional</span> }</label>
@if (field.Type == "textarea") { <textarea class="ts-input @(field.Key == "redirect_uris" ? "" : "ts-mono")" id="@("auth-create-" + field.Key)" name="@field.Key" placeholder="@field.Placeholder" required="@field.Required" rows="4" disabled></textarea> }
else if (field.Type is "organization" or "user" or "select") { <select class="ts-select" id="@("auth-create-" + field.Key)" name="@field.Key" required="@field.Required" disabled>@if (field.Options is not null) { @foreach (var choice in field.Options) { <option value="@choice">@choice</option> } }else { <option value="">@(field.Required ? "Choose " + field.Label.ToLowerInvariant() : "Instance-wide")</option> }</select> }
else { <input class="ts-input" id="@("auth-create-" + field.Key)" type="@(field.Type == "role" ? "text" : field.Type)" name="@field.Key" placeholder="@field.Placeholder" required="@field.Required" autocomplete="off" disabled /> }
@if (field.Hint.Length > 0) { <p class="ts-hint">@field.Hint</p> }</div> }
}</div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="auth-create">Cancel</button><button class="ts-btn ts-btn-primary" type="submit" disabled>Add @current.Noun</button></div></form></dialog>
}}
else if (data is not null && current.Key == "quickstart") {
<section class="ts-card" id="auth-quickstart" aria-labelledby="auth-quickstart-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-quickstart-title">Connect your application</h2><p class="ts-card-description">@current.Description</p></div><div class="ts-card-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="/auth/clients">OAuth applications</a></div></header><div class="ts-card-body ts-stack"><p class="ts-meta">Register an OAuth application with your redirect URI, point your OIDC library at the issuer, then sign users in with the authorization code flow, PKCE and scopes <span class="ts-mono">openid profile email</span>.</p><dl class="ts-kv"><dt>Issuer</dt><dd class="ts-mono">@data.Issuer</dd><dt>Discovery</dt><dd class="ts-mono">/.well-known/openid-configuration</dd><dt>Authorize</dt><dd class="ts-mono">/oauth2/authorize</dd><dt>Token</dt><dd class="ts-mono">/oauth2/token</dd><dt>JWKS</dt><dd class="ts-mono">/.well-known/jwks.json</dd></dl>
<pre class="ts-code" aria-label="Node.js example"><code>import * as client from 'openid-client';

const config = await client.discovery(new URL('@data.Issuer'), '@data.ClientId');
const verifier = client.randomPKCECodeVerifier();
const url = client.buildAuthorizationUrl(config, {
  redirect_uri: 'https://app.example.com/callback',
  scope: 'openid profile email',
  code_challenge: await client.calculatePKCECodeChallenge(verifier),
  code_challenge_method: 'S256',
});</code></pre></div></section>
}
else if (data is not null && current.Key == "emails") {
@(await RenderPartialAsync<AuthenticationEmailsView, AuthenticationPage>(Model))
}
else if (data is not null) {
@if (current.Key == "sessions") { <dl class="ts-kv"><dt>Session ends when</dt><dd>The user signs out, an admin revokes it, or the password changes or is reset</dd><dt>Password change</dt><dd>Invalidates every session issued before it</dd><dt>Access tokens</dt><dd>Short-lived; refresh with the session</dd></dl> }
<section class="ts-card" id="@("auth-" + current.Key)" aria-labelledby="@("auth-" + current.Key + "-title")"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="@("auth-" + current.Key + "-title")">@(current.Key == "sessions" ? "Active sessions" : current.Title)</h2><p class="ts-card-description">@(current.Key == "sessions" ? "Most recent first." : current.Description)</p></div></header><div class="ts-card-body">@{ Table(data.Tables[current.Key]); }</div></section>
}
else {
<section class="ts-card" id="@("auth-" + current.Key)" aria-labelledby="@("auth-" + current.Key + "-title")"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="@("auth-" + current.Key + "-title")">@(current.Key == "quickstart" ? "Connect your application" : current.Title)</h2><p class="ts-card-description">@current.Description</p></div></header><div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">@current.Title unavailable</p><p class="ts-empty-detail">@TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationConsole.Unavailable</p></div></div></section>
}
</div></div></main>
@functions {
public ShellModel LayoutModel => Model.Shell;
private static List<List<AuthenticationSection>> NavGroups()
{
    var groups = new List<List<AuthenticationSection>>();
    foreach (var section in AuthenticationSection.All)
    {
        if (groups.Count == 0 || groups[^1][0].Group != section.Group) groups.Add([]);
        groups[^1].Add(section);
    }
    return groups;
}
private sealed record Strategy(string Key, string Label, string Description);
private sealed record Group(string Id, string Page, string Title, string Description, string Icon, Strategy[] Items);
private static readonly Group[] Strategies = [
new("email", "sign-in", "Email address", "Every user has an email address; ts-auth sends verification, reset, and sign-in messages to it.", "Mail", [new("email_verification", "Verify at sign-up", "New users confirm their address from an emailed link before their identity is established."), new("email_passcode", "Email verification code", "Sign in with a one-time code sent to the user's email address."), new("magic_link", "Email magic link", "Sign in by opening a single-use link sent to the user's email address.")]),
new("password", "sign-in", "Password", "Passwords are hashed with Argon2id; a change or reset invalidates sessions issued before it.", "LockKeyhole", [new("password", "Sign in with a password", "Users set a password at sign-up and can reset it from an emailed link.")]),
new("username", "sign-in", "Username", "A unique handle users can type instead of their email address.", "UserRound", [new("username", "Allow usernames", "Users pick a username at sign-up and can use it as their identifier.")]),
new("passkeys", "sign-in", "Passkeys", "Phishing-resistant WebAuthn credentials stored on the user's devices.", "Fingerprint", [new("passkeys", "Sign in with a passkey", "Discoverable credentials with sign-count clone detection; users manage them from their account page.")]),
new("totp", "mfa", "Authenticator application", "Time-based one-time passwords (RFC 6238) from apps such as 1Password or Google Authenticator.", "Smartphone", [new("totp", "Authenticator app (TOTP)", "Users enroll from their account page; enrolled users complete a step-up challenge at every sign-in.")]),
new("recovery", "mfa", "Recovery codes", "One-time codes that stand in for a lost authenticator. Only their digests are stored.", "KeyRound", [new("recovery_codes", "Recovery codes", "Issued when a user enrolls an authenticator app; each code works once.")])];
}
