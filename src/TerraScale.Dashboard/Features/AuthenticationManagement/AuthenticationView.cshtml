@inherits RazorSlice<TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationPage>
@implements IUsesLayout<TerraScale.Dashboard.Shared.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.AuthenticationManagement
@{
    var current = Model.Section; var settings = Model.Settings; var manage = Model.Context.CanManage;
    string Date(DateTimeOffset value) => value.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture);
    void Card(string title, string description) { <header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="@("auth-" + current.Key + "-title")">@title</h2><p class="ts-card-description">@description</p></div></header> }
    void Action(string path, string label, string confirm = "") { <form method="post" action="@("/api/v1/auth-management/" + path)" data-on:submit="@(confirm.Length == 0 ? null : "confirm('" + confirm + "') || evt.preventDefault()")"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><button class="ts-btn @(confirm.Length == 0 ? "ts-btn-secondary" : "ts-btn-danger") ts-btn-sm" type="submit">@label</button></form> }
    void Empty(string title) { <div class="ts-empty" role="status"><p class="ts-empty-title">@title</p></div> }
    void Pager(string path) { if (Model.Next is null && Model.After.Length == 0) { return; } <nav class="ts-pager" aria-label="@(current.Title + " pages")"><div class="ts-row">@if (Model.After.Length > 0) { <a class="ts-btn ts-btn-secondary ts-btn-sm" href="@path">First page</a> }@if (Model.Next is not null) { <a class="ts-btn ts-btn-secondary ts-btn-sm" href="@(path + (path.Contains('?') ? "&" : "?") + "after=" + Uri.EscapeDataString(Model.Next))">Next page</a> }</div></nav> }
}
<main class="ts-page ts-idp" data-auth-section="@current.Key">
<h1 class="ts-sr-only">@Model.Heading</h1><div class="ts-page-actions"></div>
<form class="ts-idp-mobile-nav" method="get" action="/auth"><label class="ts-sr-only" for="auth-section-select">Authentication section</label><select class="ts-select" id="auth-section-select" name="section" data-on:change="el.form.requestSubmit()">@foreach(var section in AuthenticationSection.All){<option value="@(section.Key)" selected="@(section.Key == current.Key)">@(section.Title)</option>}</select><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Open</button></form>
<div class="ts-idp-layout"><nav aria-label="Authentication sections">@foreach (var group in AuthenticationSection.All.GroupBy(section => section.Group)) { <div class="ts-nav-group">@if (group.Key.Length > 0) { <div class="ts-nav-group-label">@group.Key</div> }<ul class="ts-nav">@foreach (var section in group) { <li><a class="ts-nav-link" href="@("/auth/" + section.Key)" aria-current="@(section.Key == current.Key ? "page" : null)"><span class="ts-nav-icon" aria-hidden="true">@Icons.Render(section.Icon, 16)</span><span class="ts-nav-label">@(section.Title)</span></a></li> }</ul></div> }</nav><div class="ts-stack-lg ts-idp-content">
@if (Model.Error.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert" id="auth-error"><p class="ts-alert-body">@Model.Error</p></div> }
@if (!manage && current.Key != "overview") { <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">You can view this configuration. Organization owners and admins can change it.</p></div> }
@if (Model.Created is { } created) {
<section class="ts-alert ts-alert-success" role="status" id="auth-created" data-init="history.replaceState(null, '', '/auth/clients')"><h2 class="ts-alert-title">Created @created.Name</h2><p class="ts-alert-body">Client ID <code>@created.ClientId</code>.@if (created.ClientSecret is not null) { <text> Copy the client secret now: it is shown only once.</text> }</p>@if (created.ClientSecret is { } secret) { <div class="ts-row"><code class="ts-apikeys-secret-value" id="auth-client-secret">@secret</code><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-signals="{_copied: false}" data-on:click="navigator.clipboard.writeText(el.previousElementSibling.textContent).then(() => $_copied = true)">@Icons.Render("Copy", 14)<span data-text="$_copied ? 'Copied' : 'Copy'">Copy</span></button></div> }</section>
}
<section class="ts-card" id="@("auth-" + current.Key)" aria-labelledby="@("auth-" + current.Key + "-title")">
@if (current.Key == "overview") {
Card("Project authentication", "Point your OpenID Connect library at this issuer; users sign in on the hosted pages.");
<div class="ts-card-body">@if (settings is null) { Empty("Authentication details unavailable"); } else {
<dl class="ts-stats ts-idp-stats" aria-label="Identity totals"><div class="ts-stat"><dt class="ts-stat-label">Users</dt><dd class="ts-stat-value" id="auth-count-users">@settings.Counts.Users</dd></div><div class="ts-stat"><dt class="ts-stat-label">OAuth applications</dt><dd class="ts-stat-value" id="auth-count-clients">@settings.Counts.Clients</dd></div></dl>
<dl class="ts-kv ts-idp-endpoints"><dt>Project</dt><dd class="ts-strong">@Model.Context.Project?.Name</dd><dt>Issuer</dt><dd><code id="auth-issuer">@settings.Issuer</code></dd><dt>Discovery</dt><dd><code>@settings.DiscoveryUrl</code></dd><dt>Hosted sign-in</dt><dd><a id="auth-sign-in-url" href="@settings.SignInUrl" rel="noopener" target="_blank">@settings.SignInUrl</a></dd></dl> }</div>
}
else if (current.Key == "users") {
Card("Users", current.Description);
<div class="ts-card-body"><form class="ts-filters" method="get" action="/auth/users" role="search" aria-label="Search users"><input class="ts-input ts-input-sm" type="search" name="q" value="@Model.Search" placeholder="Search by email" aria-label="Search by email" /><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Search</button></form>
@if (Model.Users is not { Count: > 0 } users) { Empty(Model.Search.Length > 0 ? "No users match this search" : "No users yet"); } else {
<div class="ts-table-wrap" tabindex="0" role="region" aria-label="Users"><table class="ts-table"><thead><tr><th>Email</th><th>Created</th><th>Status</th><th><span class="ts-sr-only">Actions</span></th></tr></thead><tbody>@foreach (var user in users) { <tr><td class="ts-table-strong">@user.Email</td><td class="ts-idp-nowrap">@Date(user.CreatedAt)</td><td><span class="ts-badge ts-badge-tone" data-tone="@(user.Disabled ? "warning" : "success")"><span class="ts-dot" aria-hidden="true"></span>@(user.Disabled ? "Disabled" : "Active")</span></td><td><div class="ts-row"><a class="ts-btn ts-btn-ghost ts-btn-sm" href="@("/auth/sessions?user=" + user.Id)">Sessions</a>@if (manage) { Action("users/" + user.Id + (user.Disabled ? "/enable" : "/disable"), user.Disabled ? "Enable" : "Disable"); Action("users/" + user.Id + "/delete", "Delete", "Delete this user? This cannot be undone."); }</div></td></tr> }</tbody></table></div> }
@{ Pager(Model.Search.Length > 0 ? "/auth/users?q=" + Uri.EscapeDataString(Model.Search) : "/auth/users"); }</div>
}
else if (current.Key == "sessions") {
Card(Model.User.Length > 0 ? "Sessions of one user" : "Live sessions", current.Description);
<div class="ts-card-body">@if (Model.User.Length > 0) { <p><a href="/auth/sessions">Show every session</a></p> }
@if (Model.Sessions is not { Count: > 0 } live) { Empty("No live sessions"); } else {
<div class="ts-table-wrap" tabindex="0" role="region" aria-label="Sessions"><table class="ts-table"><thead><tr><th>User</th><th>Signed in</th><th>Expires</th><th><span class="ts-sr-only">Actions</span></th></tr></thead><tbody>@foreach (var item in live) { <tr><td class="ts-table-strong">@item.Email</td><td class="ts-idp-nowrap">@Date(item.CreatedAt)</td><td class="ts-idp-nowrap">@Date(item.ExpiresAt)</td><td>@if (manage) { Action("sessions/" + item.Id + "/revoke", "Revoke", "Revoke this session?"); }</td></tr> }</tbody></table></div> }
@{ Pager(Model.User.Length > 0 ? "/auth/sessions?user=" + Uri.EscapeDataString(Model.User) : "/auth/sessions"); }</div>
}
else if (current.Key == "clients") {
Card("OAuth applications", current.Description);
<div class="ts-card-body">@if (Model.Clients is not { Count: > 0 } clients) { Empty("No OAuth applications yet"); } else {
<div class="ts-table-wrap" tabindex="0" role="region" aria-label="OAuth applications"><table class="ts-table"><thead><tr><th>Application</th><th>Client ID</th><th>Type</th><th>Redirect URIs</th><th><span class="ts-sr-only">Actions</span></th></tr></thead><tbody>@foreach (var client in clients) { <tr><td class="ts-table-strong">@client.Name</td><td class="ts-mono">@client.ClientId</td><td><span class="ts-badge">@client.Type</span></td><td class="ts-mono">@string.Join(", ", client.RedirectUris)</td><td>@if (manage) { Action("clients/" + client.ClientId + "/delete", "Delete", "Delete this application? Its users can no longer sign in through it."); }</td></tr> }</tbody></table></div> }
@if (manage) {
<form class="ts-form" method="post" action="/api/v1/auth-management/clients" id="auth-create-client"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><h3 class="ts-strong">Add an application</h3>
<div class="ts-field"><label class="ts-label" for="auth-client-name">Application name</label><input class="ts-input" id="auth-client-name" name="name" required maxlength="64" placeholder="Web app" autocomplete="off" /></div>
<div class="ts-field"><label class="ts-label" for="auth-client-type">Client type</label><select class="ts-select" id="auth-client-type" name="type"><option value="public">Public (browser, mobile, CLI; PKCE without a secret)</option><option value="confidential">Confidential (server; gets a client secret)</option></select></div>
<div class="ts-field"><label class="ts-label" for="auth-client-uris">Redirect URIs</label><textarea class="ts-input ts-mono" id="auth-client-uris" name="redirect_uris" rows="3" required placeholder="https://app.example.com/callback"></textarea><p class="ts-hint">One per line, up to 10. HTTPS, or HTTP on localhost and loopback addresses.</p></div>
<div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Add application</button></div></form> }</div>
}
else if (current.Key == "sign-in") {
Card("Sign-in methods", current.Description);
<div class="ts-card-body">@if (settings is null) { Empty("Sign-in methods unavailable"); } else {
<form class="ts-form" method="post" action="/api/v1/auth-management/settings"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><ul class="ts-idp-settings">@foreach (var (name, label, detail, on) in new[] { ("passcode", "Email passcode", "Sign in with a one-time code sent to the user's email address.", settings.Methods.Passcode), ("password", "Password", "Users set a password at sign-up and can reset it by email.", settings.Methods.Password), ("sign_up", "Self sign-up", "Anyone can create an account on the hosted pages. Off hides sign-up.", settings.Methods.SignUp) }) { <li class="ts-idp-setting"><div class="ts-idp-setting-text"><label class="ts-strong" for="@("auth-method-" + name)">@label</label><p class="ts-meta">@detail</p></div><input class="ts-switch" type="checkbox" role="switch" id="@("auth-method-" + name)" name="@name" checked="@on" disabled="@(!manage)" /></li> }</ul><p class="ts-hint">Keep email passcode or password on: users need one way to sign in.</p>@if (manage) { <div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Save sign-in methods</button></div> }</form> }</div>
}
else {
Card("Hosted page branding", current.Description);
<div class="ts-card-body">@if (settings is null) { Empty("Branding unavailable"); } else {
<form class="ts-form" method="post" action="/api/v1/auth-management/branding"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><fieldset class="ts-stack" disabled="@(!manage)">
<div class="ts-field"><label class="ts-label" for="auth-brand-name">Application name</label><input class="ts-input" id="auth-brand-name" name="name" value="@settings.Branding.Name" maxlength="64" /><p class="ts-hint">Shown in the sign-in heading. Empty uses the project name.</p></div>
<div class="ts-field"><label class="ts-label" for="auth-brand-logo">Logo URL</label><input class="ts-input" id="auth-brand-logo" type="url" name="logo_url" value="@settings.Branding.LogoUrl" placeholder="https://assets.example.com/logo.svg" /><p class="ts-hint">An https image. Empty shows no logo.</p></div>
<div class="ts-field"><label class="ts-label" for="auth-brand-color">Theme color</label><input class="ts-input ts-mono" id="auth-brand-color" name="theme_color" value="@settings.Branding.ThemeColor" placeholder="#2158e8" pattern="#[0-9a-fA-F]{6}" /><p class="ts-hint">A #rrggbb color for buttons and links. Empty uses the default.</p></div>
@if (manage) { <div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Save branding</button></div> }</fieldset></form> }</div>
}
</section>
</div></div></main>
@functions {
public ShellModel LayoutModel => Model.Shell;
}
