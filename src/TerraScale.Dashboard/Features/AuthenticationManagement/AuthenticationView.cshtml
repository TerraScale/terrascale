@inherits RazorSlice<TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationPage>
@implements IUsesLayout<TerraScale.Dashboard.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.AuthenticationManagement
@inject AssetUrls Assets
@{ var current = Model.Section; }
<main class="ts-page ts-idp" data-auth-section="@current.Key">
<h1 class="ts-idp-title">@Model.Heading</h1><div class="ts-page-actions"></div>
<form class="ts-idp-mobile-nav" method="get" action="/auth"><label class="ts-sr-only" for="auth-section-select">Authentication section</label><select class="ts-select" id="auth-section-select" name="section" data-on:change="el.form.requestSubmit()">@foreach(var section in AuthenticationSection.All){<option value="@(section.Key)" selected="@(section.Key == current.Key)">@(section.Title)</option>}</select><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Open</button></form>
<div class="ts-idp-layout"><nav aria-label="Authentication sections">@foreach (var group in NavGroups()) { <div class="ts-nav-group">@if (group[0].Group.Length > 0) { <div class="ts-nav-group-label">@group[0].Group</div> }<ul class="ts-nav">@foreach (var section in group) { <li><a class="ts-nav-link" href="@("/auth/" + section.Key)" aria-current="@(section.Key == current.Key ? "page" : null)"><span class="ts-nav-icon" aria-hidden="true">@Icons.Render(section.Icon, 16)</span><span class="ts-nav-label">@(section.Title)</span></a></li> }</ul></div> }</nav><div class="ts-stack-lg ts-idp-content">
<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationConsole.Unavailable</p></div>
@if (!Model.Context.CanManage && current.Key is not ("overview" or "quickstart" or "audit")) { <div class="ts-alert ts-alert-info" role="status"><p class="ts-alert-body">You can view this configuration. Organization owners and admins can change it.</p></div> }
@if (current.Key == "overview") {
<dl class="ts-stats" aria-label="Identity totals">@foreach (var label in new[] { "Users", "Organizations", "SSO connections", "OAuth applications", "Webhooks" }) { <div class="ts-stat"><dt class="ts-stat-label">@label</dt><dd class="ts-stat-value">—</dd><dd class="ts-stat-detail">Unavailable</dd></div> }</dl>
<div class="ts-grid-2 ts-idp-overview"><section class="ts-card" id="auth-checklist" aria-labelledby="auth-checklist-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-checklist-title">Set up authentication</h2><p class="ts-card-description">Setup progress is unavailable.</p></div></header><div class="ts-card-body"><ol class="ts-idp-checklist">@foreach (var step in new[] { (Key: "clients", Title: "Register an OAuth application", Detail: "Create a client with the redirect URI your app handles.", Icon: "Boxes"), (Key: "sign-in", Title: "Configure sign-in", Detail: "Choose how users sign in to your application.", Icon: "LockKeyhole"), (Key: "branding", Title: "Customize hosted pages", Detail: "Set your application's name, logo, and color.", Icon: "Wand2") }) { <li class="ts-idp-check"><span class="ts-idp-tile" aria-hidden="true">@Icons.Render(step.Icon, 16)</span><div class="ts-list-main"><span class="ts-strong">@step.Title</span><span class="ts-meta">@step.Detail</span></div><a class="ts-btn ts-btn-secondary ts-btn-sm" href="@("/auth/" + step.Key)">View</a></li> }</ol></div></section><div class="ts-stack"><section class="ts-card" id="auth-experience" aria-labelledby="auth-experience-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-experience-title">Sign-in experience</h2><p class="ts-card-description">What users see on the hosted sign-in page.</p></div><div class="ts-card-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="/auth/sign-in">Configure</a></div></header><div class="ts-card-body"><div class="ts-idp-experience"><p class="ts-label">Sign-in methods</p><p class="ts-meta">Unavailable</p><p class="ts-label">Multi-factor</p><p class="ts-meta">Unavailable</p><p class="ts-label">SSO</p><p class="ts-meta">Unavailable</p></div></div></section><section class="ts-card" id="auth-instance" aria-labelledby="auth-instance-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-instance-title">Instance</h2><p class="ts-card-description">Share these with the applications that sign users in.</p></div></header><div class="ts-card-body"><dl class="ts-kv ts-idp-endpoints"><dt>Project</dt><dd class="ts-strong">@Model.Context.Project?.Name</dd><dt>Issuer</dt><dd>Unavailable</dd><dt>Sign-in page</dt><dd>Unavailable</dd></dl></div></section></div></div>
<section class="ts-card" id="auth-activity" aria-labelledby="auth-activity-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-activity-title">Recent changes</h2><p class="ts-card-description">The latest authentication changes in this project.</p></div><div class="ts-card-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="/auth/audit">Audit log</a></div></header><div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">Authentication activity unavailable</p></div></div></section>
}
else if (current.Key == "branding") {
<div class="ts-idp-branding"><section class="ts-card" id="auth-branding" aria-labelledby="auth-branding-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-branding-title">Hosted page branding</h2><p class="ts-card-description">@current.Description</p></div></header><div class="ts-card-body"><form class="ts-form" method="post" action="/api/v1/auth-management/instance"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><div class="ts-field"><label class="ts-label" for="auth-instance-name">Application name</label><input class="ts-input" id="auth-instance-name" name="name" required maxlength="128" disabled /><p class="ts-hint">Shown in page titles, emails, and the sign-in heading.</p></div><div class="ts-field"><label class="ts-label" for="auth-logo-url">Logo URL</label><input class="ts-input" id="auth-logo-url" type="url" name="logo_url" placeholder="https://assets.example.com/logo.svg" disabled /><p class="ts-hint">An HTTPS image, ideally a square SVG or PNG.</p></div><div class="ts-field"><label class="ts-label" for="auth-theme-color">Theme color</label><input class="ts-idp-color" id="auth-theme-color" type="color" name="theme_color" disabled /><p class="ts-hint">Used for buttons and links on the hosted pages.</p></div><div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit" disabled>Save branding</button></div></form></div></section><figure class="ts-idp-preview"><div class="ts-idp-preview-card" aria-hidden="true"><img class="ts-brand-logo" src="@Assets.Url("brand/logo-terrascale-blue.svg")" alt="" /><span class="ts-idp-preview-input"></span><span class="ts-idp-preview-button"></span></div><figcaption class="ts-meta">Live preview unavailable. This shows the default TerraScale brand, not your application.</figcaption></figure></div>
}
else if (current.Key is "sign-in" or "mfa") {
@foreach (var group in Strategies.Where(group => group.Page == current.Key)) {
<section class="ts-card ts-idp-setting-card" id="@("auth-" + group.Id)" aria-labelledby="@("auth-" + group.Id + "-title")"><header class="ts-idp-setting-head"><span class="ts-idp-tile" aria-hidden="true">@Icons.Render(group.Icon, 16)</span><div class="ts-card-heading"><h2 class="ts-card-title" id="@("auth-" + group.Id + "-title")">@group.Title</h2><p class="ts-card-description">@group.Description</p></div></header><ul class="ts-idp-settings">@foreach (var item in group.Items) { <li class="ts-idp-setting"><div class="ts-idp-setting-text"><p class="ts-strong" id="@("setting-" + item.Key)">@item.Label</p><p class="ts-meta">@item.Description</p></div><form class="ts-idp-switch-form" method="post" action="/api/v1/auth-management/settings"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="setting" value="@item.Key" /><button class="ts-switch" type="submit" aria-label="Setting unavailable" aria-labelledby="@("setting-" + item.Key)" aria-describedby="auth-settings-unavailable" disabled></button></form></li> }</ul></section>
}<p class="ts-meta" id="auth-settings-unavailable">This project has a ts-auth tenant, but its customer management API and matching project credential binding are unavailable to the dashboard.</p>
}
else if (current.Key == "danger") {
<section class="ts-card ts-idp-danger" id="auth-danger" aria-labelledby="auth-danger-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-danger-title">@current.Title</h2><p class="ts-card-description">@current.Description</p></div></header><div class="ts-card-body"><ul class="ts-idp-settings"><li class="ts-idp-setting"><div class="ts-idp-setting-text"><p class="ts-strong">Sign out all users</p><p class="ts-meta">Ends every active session now. Users must sign in again; issued access tokens stay valid until their short expiry.</p></div><button class="ts-btn ts-btn-danger ts-btn-sm" type="button" aria-describedby="auth-danger-unavailable" disabled>Sign out all users</button></li><li class="ts-idp-setting"><div class="ts-idp-setting-text"><p class="ts-strong">Reset emails to defaults</p><p class="ts-meta">Clears the sender, branding and every template override in every locale. ts-auth sends its default emails again.</p></div><button class="ts-btn ts-btn-danger ts-btn-sm" type="button" aria-describedby="auth-danger-unavailable" disabled>Reset emails</button></li></ul><p class="ts-meta" id="auth-danger-unavailable">@TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationConsole.Unavailable</p></div></section>
}
else if (current.Fields is not null) {
<section class="ts-card" id="@("auth-" + current.Key)" aria-labelledby="@("auth-" + current.Key + "-title")"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="@("auth-" + current.Key + "-title")">@current.Title</h2><p class="ts-card-description">@current.Description</p></div><div class="ts-card-actions"><form class="ts-filters" method="get" action="@("/auth/" + current.Key)" role="search" aria-label="@("Search " + current.Title.ToLowerInvariant())"><input class="ts-input ts-input-sm" type="search" name="q" value="@Model.Search" placeholder="@("Search " + current.Title.ToLowerInvariant())" aria-label="@("Search " + current.Title.ToLowerInvariant())" disabled /></form>@if (Model.Context.CanManage) { <button class="ts-btn ts-btn-primary ts-btn-sm" type="button" command="show-modal" commandfor="auth-create" disabled>@Icons.Render("Plus", 15)<span>Add @current.Noun</span></button> }</div></header><div class="ts-card-body"><div class="ts-idp-empty"><span class="ts-idp-tile" aria-hidden="true">@Icons.Render(current.Icon, 16)</span><p class="ts-empty-title">@current.Title unavailable</p><p class="ts-empty-detail">@TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationConsole.Unavailable</p></div></div></section>
@if (Model.Context.CanManage) {
<dialog id="auth-create" class="ts-dialog" aria-labelledby="auth-create-title"><form class="ts-dialog-content" method="post" action="@("/api/v1/auth-management/" + current.Key)"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="auth-create-title">Add @current.Noun</h2><p class="ts-dialog-description">@current.Description</p></div><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><div class="ts-form">
@foreach (var field in current.Fields) {
if (field.Type == "choices") { <fieldset class="ts-field ts-idp-choices" disabled><legend class="ts-label">@field.Label</legend><div class="ts-idp-choice-grid">@foreach (var choice in field.Options ?? []) { <label class="ts-check"><input type="checkbox" name="@field.Key" value="@choice" /><span class="ts-mono">@choice</span></label> }</div>@if (field.Hint.Length > 0) { <p class="ts-hint">@field.Hint</p> }</fieldset> }
else { <div class="ts-field"><label class="ts-label" for="@("auth-create-" + field.Key)">@field.Label@if (!field.Required) { <span class="ts-idp-optional">Optional</span> }</label>
@if (field.Type == "textarea") { <textarea class="ts-input @(field.Key == "redirect_uris" ? "" : "ts-mono")" id="@("auth-create-" + field.Key)" name="@field.Key" placeholder="@field.Placeholder" required="@field.Required" rows="4" disabled></textarea> }
else if (field.Type is "organization" or "user" or "select") { <select class="ts-select" id="@("auth-create-" + field.Key)" name="@field.Key" required="@field.Required" disabled>@if (field.Options is not null) { @foreach (var choice in field.Options) { <option value="@choice">@choice</option> } }else { <option value="">@(field.Required ? "Choose " + field.Label.ToLowerInvariant() : "Instance-wide")</option> }</select> }
else { <input class="ts-input" id="@("auth-create-" + field.Key)" type="@(field.Type == "role" ? "text" : field.Type)" name="@field.Key" placeholder="@field.Placeholder" required="@field.Required" autocomplete="off" disabled /> }
@if (field.Hint.Length > 0) { <p class="ts-hint">@field.Hint</p> }</div> }
}</div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="auth-create">Cancel</button><button class="ts-btn ts-btn-primary" type="submit" disabled>Add @current.Noun</button></div></form></dialog>
}}
else {
<section class="ts-card" id="@("auth-" + current.Key)" aria-labelledby="@("auth-" + current.Key + "-title")"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="@("auth-" + current.Key + "-title")">@(current.Key == "quickstart" ? "Connect your application" : current.Title)</h2><p class="ts-card-description">@current.Description</p></div></header><div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">@current.Title unavailable</p><p class="ts-empty-detail">@TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationConsole.Unavailable</p></div></div></section>
}
</div></div></main>
@functions {
public ShellModel LayoutModel => Model.Shell;
private static List<List<AuthenticationSection>> NavGroups()
{
    var groups = new List<List<AuthenticationSection>>();
    foreach (var section in AuthenticationSection.All)
    {
        if (groups.Count == 0 || groups[^1][0].Group != section.Group) groups.Add([]);
        groups[^1].Add(section);
    }
    return groups;
}
private sealed record Strategy(string Key, string Label, string Description);
private sealed record Group(string Id, string Page, string Title, string Description, string Icon, Strategy[] Items);
private static readonly Group[] Strategies = [
new("email", "sign-in", "Email address", "Every user has an email address; ts-auth sends verification, reset, and sign-in messages to it.", "Mail", [new("email_verification", "Verify at sign-up", "New users confirm their address from an emailed link before their identity is established."), new("email_passcode", "Email verification code", "Sign in with a one-time code sent to the user's email address."), new("magic_link", "Email magic link", "Sign in by opening a single-use link sent to the user's email address.")]),
new("password", "sign-in", "Password", "Passwords are hashed with Argon2id; a change or reset invalidates sessions issued before it.", "LockKeyhole", [new("password", "Sign in with a password", "Users set a password at sign-up and can reset it from an emailed link.")]),
new("username", "sign-in", "Username", "A unique handle users can type instead of their email address.", "UserRound", [new("username", "Allow usernames", "Users pick a username at sign-up and can use it as their identifier.")]),
new("passkeys", "sign-in", "Passkeys", "Phishing-resistant WebAuthn credentials stored on the user's devices.", "Fingerprint", [new("passkeys", "Sign in with a passkey", "Discoverable credentials with sign-count clone detection; users manage them from their account page.")]),
new("totp", "mfa", "Authenticator application", "Time-based one-time passwords (RFC 6238) from apps such as 1Password or Google Authenticator.", "Smartphone", [new("totp", "Authenticator app (TOTP)", "Users enroll from their account page; enrolled users complete a step-up challenge at every sign-in.")]),
new("recovery", "mfa", "Recovery codes", "One-time codes that stand in for a lost authenticator. Only their digests are stored.", "KeyRound", [new("recovery_codes", "Recovery codes", "Issued when a user enrolls an authenticator app; each code works once.")])];
}
