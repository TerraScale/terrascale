@using TerraScale.Dashboard.Features.AuthenticationManagement
@using System.Globalization
@inherits RazorSlice<AuthenticationPage>
<header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-invitations-title">Invitations</h2></div></header>
<div class="ts-card-body">
@if (Model.Invitations is not { Count: > 0 } invitations)
{
<div class="ts-empty" role="status"><p class="ts-empty-title">No invitations yet.</p></div>
}
else
{
<ul class="ts-rows">@foreach (var invitation in invitations) {
<li><div class="ts-stack-sm"><span class="ts-rows-title">@invitation.Email</span><time class="ts-rows-meta" datetime="@invitation.ExpiresAt.ToString("O", CultureInfo.InvariantCulture)">@invitation.ExpiresAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</time></div>
<span class="ts-badge">@(invitation.Status == "pending" ? "Pending" : invitation.Status == "accepted" ? "Accepted" : invitation.Status == "revoked" ? "Revoked" : invitation.Status)</span>
<span class="ts-rows-actions">@if (Model.Context.CanManageProject && invitation.Status == "pending") {
<form method="post" action="@($"/api/v1/auth-management/invitations/{invitation.Id}/revoke")" data-on:submit="@("@post(el.action, {contentType:'form'})")"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Revoke</button></form>
}</span></li> }</ul>
}
@if (Model.Next is { } next) { <a class="ts-btn ts-btn-secondary" href="@("/auth/invitations?after=" + Uri.EscapeDataString(next))">Next page</a> }
</div>
