@using TerraScale.Dashboard.Features.AuthenticationManagement
@inherits RazorSlice<AuthenticationPage>
@foreach (var hook in Model.Webhooks ?? []) {
<section class="ts-card" aria-label="@("Deliveries to " + hook.Url)"><header class="ts-card-head"><h3 class="ts-card-title ts-break">@hook.Url</h3></header><div class="ts-card-body">
@if (!Model.Deliveries.TryGetValue(hook.Id, out var deliveries) || deliveries.Count == 0) { <p class="ts-empty-title">No deliveries yet.</p> }
else { <div class="ts-table-wrap" tabindex="0" role="region" aria-label="Recent deliveries"><table class="ts-table ts-table-stacked"><thead><tr><th scope="col">Event</th><th scope="col">Status</th><th scope="col">Attempts</th><th scope="col">Response</th><th scope="col"><span class="ts-sr-only">Actions</span></th></tr></thead><tbody>
@foreach (var delivery in deliveries) { var attempt = delivery.RecentAttempts.FirstOrDefault();
<tr data-webhook-delivery="@delivery.Id"><td class="ts-mono ts-break">@delivery.EventId</td><td>@delivery.Status</td><td>@delivery.Attempts</td><td>@if (attempt is not null) { <span>@attempt.Status · @(attempt.ResponseCode?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "No response") · @attempt.LatencyMs ms</span>@if (attempt.ResponseBody is { Length: > 0 } response) { <details><summary>Response body</summary><pre class="ts-break">@response</pre></details> } }</td><td>@if (Model.Context.CanManageProject && delivery.Status != "sending" && hook.DisabledAt is null) { <form method="post" action="@("/api/v1/auth-management/webhooks/" + hook.Id + "/deliveries/" + delivery.Id + "/replay")"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Replay</button></form> }</td></tr>
}
</tbody></table></div> }
</div></section>
}
