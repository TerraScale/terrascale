@inherits RazorSlice<TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationPage>
@inject AssetUrls Assets
@{
    var brand = Model.Settings!.Branding;
    var methods = Model.Settings.Methods;
    var manage = Model.Context.CanManageProject;
    string Field(string name, string? saved) => Model.Draft is { } draft ? draft[name].ToString() : saved ?? "";
    var theme = Field("default_theme", brand.DefaultTheme ?? "system");
    var size = (brand.TitleSize ?? 24).ToString(System.Globalization.CultureInfo.InvariantCulture);
    var footer = string.Join("\n", (brand.FooterLinks ?? [new("Status", "https://status.terrascale.tech"), new("Docs", "https://docs.terrascale.tech"), new("Privacy", "https://docs.terrascale.tech/legal/privacy"), new("Terms", "https://docs.terrascale.tech/legal/terms")]).Select(link => link.Label + " | " + link.Url));
}
<div class="ts-card ts-card-boxed">
<header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-branding-title">Branding</h2></div></header>
<fieldset class="ts-form" form="auth-branding-form" disabled="@(!manage)">
<div class="ts-field"><label class="ts-label" for="auth-brand-name">App name</label><input class="ts-input" form="auth-branding-form" id="auth-brand-name" name="name" data-saved="@(brand.Name ?? "")" value="@Field("name", brand.Name)" maxlength="64" placeholder="@Model.Context.Project?.Name" autocomplete="off" /></div>
<div class="ts-field"><label class="ts-label" for="auth-brand-logo">Logo URL</label><input class="ts-input" form="auth-branding-form" id="auth-brand-logo" type="url" name="logo_url" data-saved="@(brand.LogoUrl ?? "")" value="@Field("logo_url", brand.LogoUrl)" maxlength="2048" pattern="[Hh][Tt][Tt][Pp][Ss]://.+" title="The logo must be an https URL." placeholder="https://assets.example.com/logo.svg" autocomplete="off" spellcheck="false" /></div>
<div class="ts-form-grid">
<div class="ts-field"><label class="ts-label" for="auth-brand-mode">Default theme</label><select class="ts-select" form="auth-branding-form" id="auth-brand-mode" name="default_theme" data-saved="@(brand.DefaultTheme ?? "system")">@foreach (var mode in new[] { "light", "dark", "system" }) { <option value="@mode" selected="@(theme == mode)">@char.ToUpperInvariant(mode[0])@mode[1..]</option> }</select></div>
<div class="ts-field"><label class="ts-label" for="auth-brand-title-size">Title size (px)</label><div class="ts-idp-range"><input type="range" min="20" max="40" step="1" value="@Field("title_size", size)" aria-label="Title size slider" data-brand-size /><input class="ts-input ts-mono" form="auth-branding-form" id="auth-brand-title-size" type="number" inputmode="numeric" name="title_size" data-saved="@size" min="20" max="40" step="1" required value="@Field("title_size", size)" /></div></div>
</div>
<div class="ts-form-grid ts-idp-colors">
@foreach (var (name, label, saved, placeholder) in new[] { ("theme_color", "Accent color", brand.ThemeColor, "#2158e8"), ("background_color", "Background color", brand.BackgroundColor, "Theme default"), ("text_color", "Text color", brand.TextColor, "Theme default") }) {
<div class="ts-field"><label class="ts-label" for="@("auth-brand-" + name)">@label</label><input class="ts-input ts-mono" form="auth-branding-form" id="@("auth-brand-" + name)" name="@name" data-saved="@(saved ?? "")" value="@Field(name, saved)" placeholder="@placeholder" pattern="#[0-9a-fA-F]{6}" title="Colors must look like #2158e8." maxlength="7" autocomplete="off" spellcheck="false" /></div>
}
</div>
<div class="ts-field"><label class="ts-label" for="auth-brand-email-message">Email message</label><textarea class="ts-input" form="auth-branding-form" id="auth-brand-email-message" name="email_message" data-saved="@(brand.EmailMessage ?? "")" rows="3" maxlength="500">@Field("email_message", brand.EmailMessage)</textarea></div>
<div class="ts-field"><label class="ts-label" for="auth-brand-footer">Footer links</label><textarea class="ts-input ts-mono" form="auth-branding-form" id="auth-brand-footer" name="footer_links" data-saved="@footer" rows="4" maxlength="10379" spellcheck="false" autocomplete="off" placeholder="Docs | https://docs.example.com">@Field("footer_links", footer)</textarea></div>
</fieldset>
</div>
<div class="ts-idp-brand-preview" role="region" aria-label="Live preview">
<div class="ts-idp-brand-toolbar"><div class="ts-segmented" role="group" aria-label="Preview page">@foreach (var (page, label) in new[] { ("sign-in", "Sign in"), ("sign-up", "Sign up"), ("reset", "Reset") }) { <button class="ts-segment" type="button" data-brand-page="@(page)" hidden="@(page == "sign-up" && !methods.SignUp || page == "reset" && !methods.Password)" aria-pressed="@(page == "sign-in" ? "true" : "false")">@label</button> }</div><div class="ts-segmented" role="group" aria-label="Preview theme">@foreach (var (mode, label) in new[] { ("", "As set"), ("light", "Light"), ("dark", "Dark") }) { <button class="ts-segment" type="button" data-brand-mode="@mode" aria-pressed="@(mode == "" ? "true" : "false")">@label</button> }</div></div>
<div id="auth-brand-preview" class="ts-idp-brand-canvas"><div class="ts-idp-brand-card">
<div class="ts-idp-brand-logo"><img data-brand-logo data-default-src="@Assets.Url("brand/logo-icon-blue.svg")" alt="" referrerpolicy="no-referrer" hidden /><span data-brand-initial></span><span data-brand-name></span></div>
<h3 data-brand-heading>Sign in</h3>
<div class="ts-field"><label class="ts-label" for="auth-preview-email">Email</label><input class="ts-input" id="auth-preview-email" disabled placeholder="you@company.com" /></div>
<div class="ts-field" data-brand-form="sign-up" hidden><label class="ts-label" for="auth-preview-password">Password</label><input class="ts-input" id="auth-preview-password" type="password" placeholder="10+ characters" disabled /></div>
<div class="ts-stack" data-brand-form="sign-in">
@if (methods.Passcode) { <button class="ts-btn ts-btn-primary ts-btn-block" type="button" disabled>Email me a sign-in code @Icons.Render("ArrowRight", 16)</button> }
@if (methods.Password) { <button class="ts-btn @(methods.Passcode ? "ts-btn-secondary" : "ts-btn-primary") ts-btn-block" type="button" disabled>@(methods.Passcode ? "Use a password instead" : "Continue with a password")</button> }
</div>
<button class="ts-btn ts-btn-primary ts-btn-block" data-brand-form="sign-up" type="button" disabled hidden>Create account</button>
<button class="ts-btn ts-btn-primary ts-btn-block" data-brand-form="reset" type="button" disabled hidden>Email me a reset code</button>
</div><nav class="ts-idp-brand-footer" aria-label="Preview footer" data-brand-footer></nav><p class="ts-idp-brand-powered">Powered by <b>TerraScale</b></p></div>
</div>
<style id="auth-brand-preview-style" nonce="@Model.Shell.Nonce"></style>
<script type="module" src="@Assets.Url("js/auth-branding.js")" nonce="@Model.Shell.Nonce" data-auth-branding></script>
