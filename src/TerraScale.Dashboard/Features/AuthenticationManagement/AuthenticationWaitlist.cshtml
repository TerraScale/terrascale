@using TerraScale.Dashboard.Features.AuthenticationManagement
@using System.Globalization
@inherits RazorSlice<AuthenticationPage>
<header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-waitlist-title">Waitlist</h2></div></header>
<div class="ts-card-body">
@if (Model.Waitlist is not { Count: > 0 } waitlist)
{
<div class="ts-empty" role="status"><p class="ts-empty-title">The waitlist is empty.</p></div>
}
else
{
<ul class="ts-rows">@foreach (var entry in waitlist) {
<li><div class="ts-stack-sm"><span class="ts-rows-title">@entry.Email</span><time class="ts-rows-meta" datetime="@entry.CreatedAt.ToString("O", CultureInfo.InvariantCulture)">@entry.CreatedAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</time></div>
<span class="ts-badge">@(entry.Status == "pending" ? "Pending" : entry.Status == "approved" ? "Approved" : entry.Status == "rejected" ? "Rejected" : entry.Status)</span>
<span class="ts-rows-actions">@if (Model.Context.CanManageProject && entry.Status == "pending") {
@foreach (var action in new[] { "approve", "reject" }) {
<form method="post" action="@($"/api/v1/auth-management/waitlist/{entry.Id}/{action}")" data-on:submit="@("@post(el.action, {contentType:'form'})")"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">@(action == "approve" ? "Approve" : "Reject")</button></form>
}
}</span></li> }</ul>
}
@if (Model.Next is { } next) { <a class="ts-btn ts-btn-secondary" href="@("/auth/waitlist?after=" + Uri.EscapeDataString(next))">Next page</a> }
</div>
