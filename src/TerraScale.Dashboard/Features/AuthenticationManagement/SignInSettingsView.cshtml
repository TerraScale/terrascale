@inherits RazorSlice<TerraScale.Dashboard.Features.AuthenticationManagement.AuthenticationPage>
@{
    var selected = Model.Draft is { } draft ? draft.ContainsKey("organization_picker") : Model.Settings?.OrganizationPicker == true;
    var canSet = Model.Context.CanSetOrganizationPicker && Model.Settings is not null;
}
<header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="auth-settings-title">Settings</h2></div></header>
<form class="ts-form" method="post" action="/api/v1/auth-management/organization-picker" data-on:submit="@("@post(el.action, {contentType:'form'})")">
<input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
<div class="ts-card-body"><fieldset class="ts-form" disabled="@(!canSet)">
<label class="ts-check"><input class="ts-switch" type="checkbox" role="switch" name="organization_picker" checked="@selected" /><span>Organization picker at sign-in</span></label>
</fieldset></div>
@if (canSet) { <footer class="ts-card-foot"><button class="ts-btn ts-btn-primary" type="submit">Save settings</button></footer> }
</form>
