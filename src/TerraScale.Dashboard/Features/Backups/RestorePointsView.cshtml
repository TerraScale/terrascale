@inherits RazorSlice<TerraScale.Dashboard.Features.Backups.RestorePointsModel>
@using TerraScale.Dashboard.Features.Backups
@using TerraScale.Dashboard.Features.Databases
@{ var now = DateTimeOffset.UtcNow; }
@foreach(var backup in Model.Items){
<li><span class="ts-dot" data-tone="@(backup.Status == "ready" ? "success" : backup.Status == "failed" ? "danger" : "info")" aria-hidden="true"></span><div class="ts-stack-sm"><span class="ts-rows-title">@BackupHealth.RowTitle(backup.CreatedAt, now)</span><span class="ts-rows-meta">@(backup.Trigger == "manual" ? "Manual" : "Scheduled")</span></div><span class="ts-badge @(backup.Status == "ready" ? "ts-badge-success" : backup.Status == "failed" ? "ts-badge-danger" : "ts-badge-info")">@(backup.Status == "ready" ? "Ready" : backup.Status == "failed" ? "Failed" : "Running")</span><span class="ts-rows-size">@(backup.Status == "ready" ? TerraScale.Dashboard.Common.Formatting.MetricFormat.Bytes(backup.SizeBytes) : "—")</span><div class="ts-rows-actions">
@if(Model.CanRestore && backup.Status == "ready"){<button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" command="show-modal" commandfor="@("restore-" + backup.Id)">Restore…</button>
<dialog id="@("restore-" + backup.Id)" class="ts-dialog" closedby="any" aria-labelledby="@("restore-" + backup.Id + "-title")" data-init="@(Model.RestoreId == backup.Id && Model.Error.Length > 0 ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@("restore-" + backup.Id + "-title")">Restore backup</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@("restore-" + backup.Id)">@Icons.Render("X",18)</button></header>
@if(Model.RestoreId == backup.Id && Model.Error.Length > 0){@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.DialogErrorView, DialogError>(new("restore-" + backup.Id, Model.Error)))}
<dl class="ts-kv"><div><dt>Database</dt><dd>@Model.Database.Name</dd></div><div><dt>Backup taken</dt><dd class="ts-mono">@BackupHealth.Utc(backup.CreatedAt)</dd></div><div><dt>Size</dt><dd>@TerraScale.Dashboard.Common.Formatting.MetricFormat.Bytes(backup.SizeBytes)</dd></div></dl>
<form method="post" action="/api/v1/dashboard/backups/restore" data-submit-once class="ts-form" aria-label="Restore into a new database"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="backupId" value="@backup.Id" /><div class="ts-field"><label class="ts-label" for="@("restore-" + backup.Id + "-name")">New database name</label><input class="ts-input" id="@("restore-" + backup.Id + "-name")" name="name" value="@(Model.RestoreId == backup.Id ? Model.Name : "")" pattern="@(@"[\s]*(?:" + DatabaseService.NameInputPattern + @")?[\s]*")" title="@DatabaseService.NameHint" placeholder="@(Model.Database.Name + "-restore")" /></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="@("restore-" + backup.Id)">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Restore as new database</button></div></form></div></dialog>}
</div></li>
}
