@inherits RazorSlice<TerraScale.Dashboard.Features.Backups.WholeDatabaseRecoveryPage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.Backups
@using TerraScale.Dashboard.Features.Databases
<main class="ts-page">
@(await RenderPartialAsync<TerraScale.Dashboard.Common.Databases.DatabaseFrame, DatabaseFrameModel>(new(Model.Database, "backups")))
@if(Model.Restore is not null){@(await RenderPartialAsync<TerraScale.Dashboard.Features.Backups.WholeDatabaseRestoreStatusView, TerraScale.Dashboard.Features.Backups.WholeDatabaseRecoveryPage>(Model))}
<section class="ts-card" aria-labelledby="pitr-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="pitr-title">Restore database at UTC time</h2></div></header><div class="ts-card-body ts-stack-lg">
@if(Model.Error.Length > 0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p><p class="ts-meta">Request ID: <code>@RequestIdentity.Id</code></p></div>}
<form method="get" class="ts-form" aria-label="Select PITR source bucket"><div class="ts-field"><label class="ts-label" for="pitr-destination">Backup source</label><select class="ts-select" id="pitr-destination" name="destination"><option value="platform" selected="@(Model.Destination == "platform" ? "selected" : null)">Platform</option><option value="customer" selected="@(Model.Destination == "customer" ? "selected" : null)">Customer</option></select></div><button class="ts-btn ts-btn-secondary" type="submit">Read retained window</button></form>
@if(Model.Available is { } available){<dl class="ts-db-facts"><div><dt>Databases used</dt><dd>@available.DatabasesInUse of @(available.DatabaseLimit == int.MaxValue ? "unlimited" : available.DatabaseLimit.ToString(System.Globalization.CultureInfo.InvariantCulture))</dd></div></dl>}
@if(Model.Available?.Window is not { } window){<p role="status">@(Model.Error.Length > 0 ? "The retained window is unavailable." : "No retained PITR history is available for this source bucket yet.")</p>}

<form method="post" class="ts-form" aria-label="Plan whole-database recovery"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="destination" value="@Model.Destination" /><input type="hidden" name="confirmName" value="@Model.ConfirmName" />
<div class="ts-field"><label class="ts-label" for="pitr-point">Time (UTC)</label><input class="ts-input" id="pitr-point" name="point" type="datetime-local" step="0.001" value="@Model.Point" min="@(Model.Available?.Window is { } bounds ? TerraScale.Dashboard.Features.Backups.RecoveryPoint.Input(bounds.Earliest) : null)" max="@(Model.Available?.Window is { } end ? TerraScale.Dashboard.Features.Backups.RecoveryPoint.Input(end.Latest) : null)" required /></div>
<div class="ts-field"><label class="ts-label" for="pitr-name">New database name</label><input class="ts-input" id="pitr-name" name="name" value="@Model.Name" pattern="@DatabaseService.NameInputPattern" title="@DatabaseService.NameHint" maxlength="63" placeholder="@(Model.Database.Name + "-restore")" /></div><button class="ts-btn ts-btn-secondary" type="submit" name="operation" value="plan">Preview plan</button></form>
@if(Model.Plan is { } plan){<section aria-labelledby="pitr-plan-title"><h3 id="pitr-plan-title">Advisory plan</h3><dl class="ts-db-facts"><div><dt>Source bucket</dt><dd>@Model.Destination</dd></div><div><dt>Chosen UTC time</dt><dd>@Model.Point</dd></div><div><dt>Snapshot UTC</dt><dd>@TerraScale.Dashboard.Features.Backups.RecoveryPoint.Input(plan.SnapshotAt)</dd></div><div><dt>Applicable segments</dt><dd>@plan.SegmentCount</dd></div><div><dt>Latest segment UTC</dt><dd>@(plan.LatestSegmentAt is { } latest ? TerraScale.Dashboard.Features.Backups.RecoveryPoint.Input(latest) : "None")</dd></div><div><dt>New database</dt><dd>@Model.Name</dd></div></dl>
<form method="post" class="ts-form" aria-label="Confirm restore as a new database" data-submit-once><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="destination" value="@Model.Destination" /><input type="hidden" name="point" value="@Model.Point" /><input type="hidden" name="name" value="@Model.Name" /><div class="ts-field"><label class="ts-label" for="pitr-confirm">Type @Model.Name to confirm the new database name</label><input class="ts-input" id="pitr-confirm" name="confirmName" value="@Model.ConfirmName" autocomplete="off" required maxlength="63" /></div><button class="ts-btn ts-btn-primary" type="submit" name="operation" value="restore">Restore as new database</button></form>
<form method="post" class="ts-form" aria-label="Confirm restore in place" data-submit-once><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="destination" value="@Model.Destination" /><input type="hidden" name="point" value="@Model.Point" /><div class="ts-field"><label class="ts-label" for="pitr-confirm-database">Type @Model.Database.Name to restore it in place</label><input class="ts-input" id="pitr-confirm-database" name="confirmDatabase" value="@Model.ConfirmDatabase" autocomplete="off" required maxlength="63" /></div><button class="ts-btn ts-btn-danger" type="submit" name="operation" value="rewind">Restore in place</button></form></section>}
<a class="ts-link" href="@DatabaseService.Path(Model.Database.Id, "backups")">Back to backups</a>
</div></section></main>
@functions { public ShellModel LayoutModel => Model.Shell; }
