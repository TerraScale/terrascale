@inherits RazorSlice<TerraScale.Dashboard.Features.Backups.BackupPage>
@using TerraScale.Dashboard.Features.Backups
@using TerraScale.Dashboard.Features.Databases
@using TerraScale.Dashboard.Common.Live
@{ var canManage = Model.Shell.Context.CanManage && Model.Database.Status == "ready"; var state = new BackupListState(Model.Error, Model.RestoreId, Model.Name, Model.VisibleThrough); }
<section class="ts-card ts-card-boxed ts-card-flush" id="restore-points" aria-labelledby="restore-points-title" @LiveView.Initializer(Model.Shell.Context, state.Path(Model.Shell.CsrfToken, Model.Shell.Context, DatabaseService.Path(Model.Database.Id, "backups/live")))><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="restore-points-title">Restore points</h2></div>@if(canManage && Model.Listing is not { Backups.Count: 0 }){<div class="ts-card-actions"><form method="post" action="/api/v1/dashboard/backups" data-submit-once data-on:submit="evt.preventDefault(); @@post(el.action, {contentType:'form'})"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><button class="ts-btn ts-btn-primary" type="submit">@Icons.Render("Archive",16)<span>Back up now</span></button></form></div>}</header>
<div class="ts-card-body">
@if(Model.Listing is null){<div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">Restore points for @Model.Database.Name are unavailable.</p><a class="ts-link" href="@DatabaseService.Path(Model.Database.Id, "backups")">Retry</a></div>}
else if(Model.Listing.Backups.Count == 0){<div class="ts-empty" role="status"><p class="ts-empty-title">No restore points yet.</p>@if(canManage){<form method="post" action="/api/v1/dashboard/backups" data-submit-once data-on:submit="evt.preventDefault(); @@post(el.action, {contentType:'form'})"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><button class="ts-btn ts-btn-primary ts-btn-sm" type="submit">Back up now</button></form>}</div>}
else{<ul class="ts-rows" id="restore-points-list">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Backups.RestorePointsView, TerraScale.Dashboard.Features.Backups.RestorePointsModel>(state.Points(Model)))</ul>}
</div></section>
