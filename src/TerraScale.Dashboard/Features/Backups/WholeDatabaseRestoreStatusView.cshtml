@inherits RazorSlice<TerraScale.Dashboard.Features.Backups.WholeDatabaseRecoveryPage>
@using TerraScale.Dashboard.Features.Backups
@using TerraScale.Dashboard.Features.Databases
@{ var restore = Model.Restore!; }
<section class="ts-card" id="restore-status" aria-labelledby="restore-status-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="restore-status-title">Restore</h2></div></header><div class="ts-card-body">
@if(restore.Status == "running"){<p class="ts-meta">Restoring…</p><span hidden data-on-interval__duration.3s="@("@get('" + DatabaseService.Path(Model.Database.Id, "point-in-time") + "?restore=" + restore.OperationId + "')")"></span>}
else if(restore.Status == "completed" && restore.TargetDatabaseId is { } target){<p><a class="ts-link" href="@DatabaseService.Path(target)">@restore.TargetName</a></p>}
else if(restore.Status == "completed"){<p class="ts-meta">Restore completed: @(restore.TargetName ?? "")</p>}
else{<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@restore.Failure</p></div>}
</div></section>
