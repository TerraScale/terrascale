@inherits RazorSlice<TerraScale.Dashboard.Features.Backups.BackupPage>
@{ var policy = Model.Listing?.Policy; var canManage = Model.Shell.Context.CanManage && Model.Database.Status == "ready"; var canRestore = canManage && Model.Shell.Context.Organization?.CanProvision(Model.Shell.Context.UserId) == true; }
<section class="ts-card" id="backup-policy" aria-labelledby="backup-policy-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="backup-policy-title">Backup policy</h2><p class="ts-card-description">Cron schedules and how long snapshots are kept.</p></div></header><div class="ts-card-body">
@if(policy is null){<p class="ts-meta">Provider backup scheduling is unavailable.</p>}
else{<div class="ts-db-setting"><div class="ts-list-main"><span class="ts-strong">Scheduled backups</span><span class="ts-meta">@(policy.Disabled ? "Scheduled backups paused" : policy.FullBackupCron.Length == 0 ? "No full backup schedule" : "Scheduled full backups enabled")</span></div>
@if(canManage){<form method="post" action="/api/v1/dashboard/backups/policy"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="fullBackupCron" value="@policy.FullBackupCron" /><input type="hidden" name="incrementalBackupCron" value="" /><input type="hidden" name="retentionDays" value="@policy.RetentionDays" /><input type="hidden" name="disabled" value="@(policy.Disabled ? "0" : "1")" /><button type="submit" class="ts-switch" role="switch" aria-checked="@(policy.Disabled ? "false" : "true")" aria-label="Scheduled backups"></button></form>}
else{<span class="ts-meta">Requires management access</span>}
</div>
@if(canManage){<form method="post" action="/api/v1/dashboard/backups/policy" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="disabled" value="@(policy.Disabled ? "1" : "0")" /><div class="ts-field"><label class="ts-label" for="full-cron">Full backup schedule</label><input class="ts-input ts-mono" id="full-cron" name="fullBackupCron" value="@(Model.FullBackupCron ?? policy.FullBackupCron)" placeholder="0 2 * * *" /></div><div class="ts-field"><label class="ts-label" for="incremental-cron">Incremental schedule</label><input class="ts-input ts-mono" id="incremental-cron" disabled placeholder="Unavailable" /><input type="hidden" name="incrementalBackupCron" value="" /><p class="ts-hint">The backup provider does not expose incremental schedules.</p></div><div class="ts-field"><label class="ts-label" for="retention">Retention days</label><input class="ts-input" id="retention" name="retentionDays" type="number" min="1" max="35" value="@(Model.RetentionDays ?? policy.RetentionDays.ToString(System.Globalization.CultureInfo.InvariantCulture))" required /></div><div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Save policy</button></div></form>}
else{<p class="ts-meta">Schedule: <span class="ts-mono">@policy.FullBackupCron</span> · Retention: @policy.RetentionDays days</p>}
}
</div></section>
<section class="ts-card ts-card-flush" id="restore-points" aria-labelledby="restore-points-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="restore-points-title">Restore points</h2><p class="ts-card-description">Restore a snapshot into a new database.</p></div>
@if(canManage && Model.Listing is not null){<form method="post" action="/api/v1/dashboard/backups"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><button class="ts-btn ts-btn-primary ts-btn-sm" type="submit">@Icons.Render("Archive",16)<span>Create backup</span></button></form>}
</header>
@if(Model.Listing is null){<div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">Restore points unavailable.</p><p class="ts-empty-detail">@Model.Unavailable</p></div></div>}
else if(Model.Listing.Backups.Count == 0){<div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">No restore points yet.</p><p class="ts-empty-detail">Create a backup to capture the current state of this database.</p></div></div>}
else{<div class="ts-table-wrap"><table class="ts-table"><thead><tr><th>Created</th><th>Status</th><th class="ts-num">Size</th><th>Actions</th></tr></thead><tbody>
@foreach(var backup in Model.Listing.Backups){<tr><td class="ts-mono">@backup.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</td><td><span class="ts-badge @(backup.Status == "ready" ? "ts-badge-success" : backup.Status == "failed" ? "ts-badge-danger" : "")">@backup.Status</span></td><td class="ts-num">@DatabasesPage.Bytes(backup.SizeBytes)</td><td>
@if(canRestore && backup.Status == "ready"){<button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" command="show-modal" commandfor="@("restore-" + backup.Id)">@Icons.Render("RotateCcw",15)<span>Restore</span></button>
<dialog id="@("restore-" + backup.Id)" class="ts-dialog" closedby="any" aria-labelledby="@("restore-" + backup.Id + "-title")" data-init="@(Model.RestoreId == backup.Id && Model.Error.Length > 0 ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@("restore-" + backup.Id + "-title")">Restore backup</h2><p class="ts-dialog-description">Restore the @backup.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture) backup of @Model.Database.Name.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@("restore-" + backup.Id)">@Icons.Render("X",18)</button></header>
@if(Model.RestoreId == backup.Id && Model.Error.Length > 0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}
<dl class="ts-db-facts"><div><dt>Database</dt><dd>@Model.Database.Name</dd></div><div><dt>Backup taken</dt><dd>@backup.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</dd></div><div><dt>Size</dt><dd>@DatabasesPage.Bytes(backup.SizeBytes)</dd></div></dl>
<form method="post" action="/api/v1/dashboard/backups/restore" class="ts-form" aria-label="Restore into a new database"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="backupId" value="@backup.Id" /><div class="ts-field"><label class="ts-label" for="@("restore-" + backup.Id + "-name")">New database name</label><input class="ts-input" id="@("restore-" + backup.Id + "-name")" name="name" value="@(Model.RestoreId == backup.Id ? Model.Name : "")" pattern="[a-z0-9]([a-z0-9\-]{0,61}[a-z0-9])?" maxlength="63" title="Lowercase letters, digits, and hyphens" required /><p class="ts-hint">Leaves @Model.Database.Name unchanged.</p></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="@("restore-" + backup.Id)">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Restore as new database</button></div></form><p class="ts-meta">Overwriting this database is unavailable.</p></div></dialog>}
else if(canRestore){<span class="ts-meta">Not restorable</span>}
else{<span class="ts-meta">Requires provisioning access</span>}
</td></tr>}
</tbody></table></div>}
</section>
