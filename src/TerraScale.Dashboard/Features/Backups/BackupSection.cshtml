@inherits RazorSlice<TerraScale.Dashboard.Features.Backups.BackupPage>
@using TerraScale.Dashboard.Features.Backups
@using TerraScale.Dashboard.Features.Databases
@inject AssetUrls Assets
@{ var policy = Model.Listing?.Policy; var canManage = Model.Shell.Context.CanManage && Model.Database.Status == "ready"; var now = DateTimeOffset.UtcNow; var failedNewest = policy is not null && policy.FullBackupCron.Length > 0 && policy.LastFailedAt is { } f && (policy.LastSucceededAt is not { } s || f > s); }
<div id="backup-page">
<script type="module" src="@Assets.Url("js/backup-timeline.js")" nonce="@Model.Shell.Nonce"></script>
@if(Model.Restore is not null){@(await RenderPartialAsync<TerraScale.Dashboard.Features.Backups.RestoreStatusView, TerraScale.Dashboard.Features.Backups.BackupPage>(Model))}
<header class="ts-page-header"><h1 class="ts-page-title" id="backups-title">Backups</h1>
@if(canManage){<div class="ts-page-actions"><form method="post" action="/api/v1/dashboard/backups" data-submit-once data-on:submit="evt.preventDefault(); @@post(el.action, {contentType:'form'})"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><button class="ts-btn ts-btn-primary" type="submit">@Icons.Render("Archive",16)<span>Back up now</span></button></form></div>}
</header>
@if(policy is null){<div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">Backup schedules couldn't be loaded.</p><a class="ts-link" href="@DatabaseService.Path(Model.Database.Id, "backups")">Retry</a></div>}
@if(failedNewest){<div class="ts-alert ts-alert-danger" role="status"><p class="ts-alert-body">Scheduled backup failed <time datetime="@policy!.LastFailedAt!.Value.ToString("O",System.Globalization.CultureInfo.InvariantCulture)" title="@BackupHealth.Utc(policy.LastFailedAt.Value)">@BackupHealth.Relative(policy.LastFailedAt.Value, now)</time>@(policy.LastError?.Message is { Length: > 0 } message ? ": " + message : "")</p></div>}
<dl class="ts-stats" aria-label="Backup health">
<div class="ts-stat"><dt class="ts-stat-label">Last backup</dt><dd class="ts-stat-value">@(policy is null ? "—" : failedNewest ? "Failed" : policy.LastSucceededAt is { } lastOk ? BackupHealth.Relative(lastOk, now) : "—")</dd>@if(policy is not null && !failedNewest && policy.LastSucceededAt is { } lastOkTime){<dd class="ts-stat-meta">@BackupHealth.Utc(lastOkTime)</dd>}@if(failedNewest && policy!.LastFailedAt is { } failed){<dd class="ts-stat-meta">@BackupHealth.Utc(failed)</dd>}</div>
<div class="ts-stat"><dt class="ts-stat-label">Next backup</dt><dd class="ts-stat-value">@(policy is null ? "—" : policy.NextDueAt is { } due ? BackupHealth.Relative(due, now) : "—")</dd>@if(policy is not null){<dd class="ts-stat-meta">@(policy.FullBackupCron.Length == 0 ? "No schedule" : BackupSchedule.Words(policy.FullBackupCron))</dd>}</div>
<div class="ts-stat"><dt class="ts-stat-label">Restorable window</dt><dd class="ts-stat-value">@(policy is null ? "—" : policy.RetentionDays.ToString(System.Globalization.CultureInfo.InvariantCulture) + " days")</dd>@if(Model.Recovery?.Available?.Window is { } pitrWindow){<dd class="ts-stat-meta">Since @BackupHealth.Utc(pitrWindow.Earliest)</dd>}</div>
<div class="ts-stat"><dt class="ts-stat-label">Restore points</dt><dd class="ts-stat-value">@(Model.Listing is null ? "—" : Model.Listing.Backups.Count.ToString(System.Globalization.CultureInfo.InvariantCulture))</dd>@if(Model.Listing is not null && Model.Listing.Backups.Count > 0){<dd class="ts-stat-meta">@TerraScale.Dashboard.Common.Formatting.MetricFormat.Bytes(Model.Listing.Backups.Sum(backup => backup.SizeBytes)) total</dd>}</div>
</dl>
<div class="ts-columns">
<div class="ts-columns-main">
@(await RenderPartialAsync<TerraScale.Dashboard.Features.Backups.PitrCardView, TerraScale.Dashboard.Features.Backups.PitrCardModel>(new(Model.Shell, Model.Database, Model.Recovery ?? new WholeDatabaseRecoveryPage(Model.Shell, Model.Database), Model.Listing?.Backups ?? [], Model.Bucket?.Destination is not null)))
<section class="ts-card ts-card-flush" id="restore-points" aria-labelledby="restore-points-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="restore-points-title">Restore points</h2></div></header>
@if(Model.Listing is null){<div class="ts-card-body"><div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">Restore points for @Model.Database.Name are unavailable.</p><a class="ts-link" href="@DatabaseService.Path(Model.Database.Id, "backups")">Retry</a></div></div>}
else if(Model.Listing.Backups.Count == 0){<div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">No restore points yet.</p></div></div>}
else{<ul class="ts-rows" id="restore-points-list">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Backups.RestorePointsView, TerraScale.Dashboard.Features.Backups.RestorePointsModel>(new(Model.Shell, Model.Database, Model.Error, Model.RestoreId, Model.Name, [.. Model.Listing.Backups.Take(RestorePointsModel.PageSize)], null)))</ul>
@if(Model.Listing.Backups.Count > RestorePointsModel.PageSize){<div class="ts-rows-more" id="restore-points-more"><button class="ts-btn ts-btn-ghost ts-btn-sm" type="button" data-on:click="@@get('/api/v1/dashboard/backups?databaseId=@(Model.Database.Id)&limit=@(RestorePointsModel.PageSize)&after=@(Model.Listing.Backups[RestorePointsModel.PageSize - 1].Id)', {contentType:'form'}).then(() => el.closest('#restore-points-more')?.remove())">Show older restore points</button></div>}}
</section>
</div>
<div class="ts-columns-side">
<section class="ts-card" id="backup-schedule" aria-labelledby="backup-schedule-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="backup-schedule-title">Schedule</h2></div></header>
@if(policy is null || !canManage){<div class="ts-card-body"><p class="ts-meta">@(policy is null ? "Unavailable." : "Requires organization management access.")</p></div>}
else{var choice = BackupSchedule.Parse(Model.FullBackupCron ?? policy.FullBackupCron);<form method="post" action="/api/v1/dashboard/backups/policy" class="ts-stack-lg" data-on:submit="evt.preventDefault(); @@post(el.action, {contentType:'form'})"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />
<fieldset class="ts-chips" id="schedule-chips"><legend class="ts-label">Full backup</legend>
<label class="ts-chip"><input type="radio" name="schedulePreset" value="every6" checked="@(choice is EveryHours(6) ? "checked" : null)"><span>Every 6 h</span></label>
<label class="ts-chip"><input type="radio" name="schedulePreset" value="every12" checked="@(choice is EveryHours(12) ? "checked" : null)"><span>Every 12 h</span></label>
<label class="ts-chip"><input type="radio" name="schedulePreset" value="daily" checked="@(choice is Daily ? "checked" : null)"><span>Daily</span></label>
<label class="ts-chip"><input type="radio" name="schedulePreset" value="weekly" checked="@(choice is Weekly ? "checked" : null)"><span>Weekly</span></label>
<label class="ts-chip"><input type="radio" name="schedulePreset" value="custom" checked="@(choice is CustomSchedule ? "checked" : null)"><span>Custom</span></label>
</fieldset>
<div class="ts-field" data-show="el.closest('form').elements['schedulePreset'].value === 'daily'"><label class="ts-label" for="schedule-hour">At (UTC)</label><select class="ts-select" id="schedule-hour" name="hour">@for(var hour = 0; hour < 24; hour++){<option value="@hour" selected="@(choice is Daily(var at) && at == hour ? "selected" : null)">@BackupSchedule.HourLabel(hour)</option>}</select></div>
<div class="ts-field" data-show="el.closest('form').elements['schedulePreset'].value === 'weekly'"><label class="ts-label" for="schedule-hour-weekly">At (UTC)</label><select class="ts-select" id="schedule-hour-weekly" name="weeklyHour">@for(var hour = 0; hour < 24; hour++){<option value="@hour" selected="@(choice is Weekly(var at, _) && at == hour ? "selected" : null)">@BackupSchedule.HourLabel(hour)</option>}</select><label class="ts-label" for="schedule-day">Day</label><select class="ts-select" id="schedule-day" name="day">@for(var day = 0; day < 7; day++){<option value="@day" selected="@(choice is Weekly(_, var on) && on == day ? "selected" : null)">@BackupSchedule.Weekdays[day]</option>}</select></div>
<div class="ts-field" data-show="el.closest('form').elements['schedulePreset'].value === 'custom'"><label class="ts-label" for="full-cron">Cron</label><input class="ts-input ts-mono" id="full-cron" name="fullBackupCron" value="@(choice is CustomSchedule(var cron) ? cron : "")" placeholder="0 2 * * *" maxlength="256" /></div>
<p class="ts-stat-meta ts-mono" id="schedule-cron">@BackupSchedule.Cron(choice)</p>
<div class="ts-field"><label class="ts-label" for="retention">Keep restore points for</label><input class="ts-input" id="retention" name="retentionDays" type="number" min="1" max="35" value="@(Model.RetentionDays ?? policy.RetentionDays.ToString(System.Globalization.CultureInfo.InvariantCulture))" required /> <span class="ts-label">Days</span></div>
<footer class="ts-card-foot"><button class="ts-btn ts-btn-primary" type="submit">Save schedule</button></footer>
</form>}
</section>
<section class="ts-card" id="backup-storage" aria-labelledby="backup-storage-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="backup-storage-title">Storage</h2></div>
@if(canManage){<div class="ts-card-actions">@if(Model.Bucket?.Destination is null){<button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" command="show-modal" commandfor="bucket-dialog">Use your bucket</button>}else{<button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" command="show-modal" commandfor="bucket-dialog">Replace</button><button class="ts-btn ts-btn-danger ts-btn-sm" type="button" command="show-modal" commandfor="remove-backup-bucket">Remove</button>}</div>}
</header>
<div class="ts-card-body">
@if(!Model.BucketRead){}
else if(Model.Bucket is null){<div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">Your bucket couldn't be reached.</p></div>}
else if(Model.Bucket.Destination is { } destination){<dl class="ts-kv"><div><dt>Endpoint</dt><dd class="ts-mono">@destination.Endpoint</dd></div><div><dt>Bucket</dt><dd class="ts-mono">@destination.Bucket</dd></div><div><dt>Region</dt><dd>@destination.Region</dd></div><div><dt>Credentials</dt><dd>Saved</dd></div></dl>
@if(canManage){@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.DialogFormErrorView, DialogFormError>(new(new("remove-backup-bucket", "/api/v1/dashboard/backups/destination-remove", "Remove bucket", destination.Bucket, Model.Shell.CsrfToken, new Dictionary<string, string> { ["databaseId"] = Model.Database.Id }, Description: "Saved credentials are deleted."), DialogSubmission.Matches(HttpContext!, "/api/v1/dashboard/backups/destination-remove") ? Model.Error : "")))}}
else if(canManage){<div class="ts-backups-store"><span class="ts-icon-tile">@Icons.Render("HardDrive",16)</span><div class="ts-stack-sm"><span class="ts-strong">TerraScale storage</span></div></div>}
</div></section>
</div>
</div>
@if(canManage){<dialog id="bucket-dialog" class="ts-dialog" closedby="any" aria-labelledby="bucket-dialog-title"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="bucket-dialog-title">@(Model.Bucket?.Destination is null ? "Use your bucket" : "Replace bucket")</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="bucket-dialog">@Icons.Render("X",18)</button></header>
<form method="post" action="/api/v1/dashboard/backups/destination" class="ts-form" data-submit-once data-on:submit="evt.preventDefault(); @@post(el.action, {contentType:'form'})"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />
@if(Model.Error.Length > 0 && Model.BucketRead){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}
<div class="ts-field"><label class="ts-label" for="bucket-endpoint">Endpoint</label><input class="ts-input ts-mono" id="bucket-endpoint" name="endpoint" type="url" placeholder="https://fly.storage.tigris.dev" required maxlength="2048" /></div>
<div class="ts-field"><label class="ts-label" for="bucket-region">Region</label><input class="ts-input" id="bucket-region" name="region" placeholder="auto" required /></div>
<div class="ts-field"><label class="ts-label" for="bucket-name">Bucket</label><input class="ts-input ts-mono" id="bucket-name" name="bucket" required /></div>
<div class="ts-field"><label class="ts-label" for="bucket-key">Access key ID</label><input class="ts-input ts-mono" id="bucket-key" name="accessKeyId" autocomplete="off" required /></div>
<div class="ts-field"><label class="ts-label" for="bucket-secret">Secret key</label><input class="ts-input ts-mono" id="bucket-secret" name="secretKey" type="password" autocomplete="new-password" required minlength="1" maxlength="256" /></div>
<div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="bucket-dialog">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Save bucket</button></div>
</form></div></dialog>}
</div>
