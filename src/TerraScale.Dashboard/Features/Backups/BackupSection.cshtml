@inherits RazorSlice<TerraScale.Dashboard.Features.Backups.BackupPage>
@using TerraScale.Dashboard.Features.Databases
@{ var policy = Model.Listing?.Policy; var canManage = Model.Shell.Context.CanManage && Model.Database.Status == "ready"; var canRestore = canManage && Model.Shell.Context.Organization?.CanProvision(Model.Shell.Context.UserId) == true; }
<section class="ts-card" id="backup-policy" aria-labelledby="backup-policy-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="backup-policy-title">Backup policy</h2><p class="ts-card-description">Cron schedules and how long snapshots are kept.</p></div></header><div class="ts-card-body">
@if(policy is null){<p class="ts-meta">Provider backup scheduling is unavailable.</p>}
else{<div class="ts-db-setting"><div class="ts-list-main"><span class="ts-strong">Scheduled backups</span><span class="ts-meta">@(policy.Disabled ? "Scheduled backups paused" : policy.FullBackupCron.Length == 0 ? "No full backup schedule" : "Scheduled full backups enabled")</span></div>
@if(canManage){<form method="post" action="/api/v1/dashboard/backups/policy"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="fullBackupCron" value="@policy.FullBackupCron" /><input type="hidden" name="incrementalBackupCron" value="" /><input type="hidden" name="retentionDays" value="@policy.RetentionDays" /><input type="hidden" name="disabled" value="@(policy.Disabled ? "0" : "1")" /><button type="submit" class="ts-switch" role="switch" aria-checked="@(policy.Disabled ? "false" : "true")" aria-label="Scheduled backups"></button></form>}
else{<span class="ts-meta">Requires management access</span>}
</div>
@if(canManage){<form method="post" action="/api/v1/dashboard/backups/policy" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="disabled" value="@(policy.Disabled ? "1" : "0")" /><div class="ts-field"><label class="ts-label" for="full-cron">Full backup schedule</label><input class="ts-input ts-mono" id="full-cron" name="fullBackupCron" value="@(Model.FullBackupCron ?? policy.FullBackupCron)" placeholder="0 2 * * *" /></div><div class="ts-field"><label class="ts-label" for="incremental-cron">Incremental schedule</label><input class="ts-input ts-mono" id="incremental-cron" disabled placeholder="Unavailable" /><input type="hidden" name="incrementalBackupCron" value="" /><p class="ts-hint">The backup provider does not expose incremental schedules.</p></div><div class="ts-field"><label class="ts-label" for="retention">Retention days</label><input class="ts-input" id="retention" name="retentionDays" type="number" min="1" max="35" value="@(Model.RetentionDays ?? policy.RetentionDays.ToString(System.Globalization.CultureInfo.InvariantCulture))" required /></div><div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Save policy</button></div></form>}
else{<p class="ts-meta">Schedule: <span class="ts-mono">@policy.FullBackupCron</span> · Retention: @policy.RetentionDays days</p>}
}
</div></section>
<section class="ts-card ts-card-flush" id="restore-points" aria-labelledby="restore-points-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="restore-points-title">Restore points</h2><p class="ts-card-description">Restore a snapshot into a new database.</p></div>
@if(canManage && Model.Listing is not null){<form method="post" action="/api/v1/dashboard/backups" data-submit-once><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><button class="ts-btn ts-btn-primary ts-btn-sm" type="submit">@Icons.Render("Archive",16)<span>Create backup</span></button></form>}
@if(canManage){<a class="ts-btn ts-btn-secondary ts-btn-sm" href="@("/databases/" + Model.Database.Id + "/point-in-time")">Restore database at UTC time</a><a class="ts-btn ts-btn-secondary ts-btn-sm" href="@("/databases/" + Model.Database.Id + "/recovery")">Recover selected records</a>}
</header>
@if(Model.Listing is null){<div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">Restore points unavailable.</p><p class="ts-empty-detail">@Model.Unavailable</p></div></div>}
else if(Model.Listing.Backups.Count == 0){<div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">No restore points yet.</p><p class="ts-empty-detail">Create a backup to capture the current state of this database.</p></div></div>}
else{<div class="ts-table-wrap"><table class="ts-table"><thead><tr><th>Created</th><th>Status</th><th class="ts-num">Size</th><th>Actions</th></tr></thead><tbody>
@foreach(var backup in Model.Listing.Backups){<tr><td class="ts-mono">@backup.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</td><td><span class="ts-badge @(backup.Status == "ready" ? "ts-badge-success" : backup.Status == "failed" ? "ts-badge-danger" : "")">@backup.Status</span></td><td class="ts-num">@DatabasesPage.Bytes(backup.SizeBytes)</td><td>
@if(canRestore && backup.Status == "ready"){<button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" command="show-modal" commandfor="@("restore-" + backup.Id)">@Icons.Render("RotateCcw",15)<span>Restore</span></button>
<dialog id="@("restore-" + backup.Id)" class="ts-dialog" closedby="any" aria-labelledby="@("restore-" + backup.Id + "-title")" data-init="@(Model.RestoreId == backup.Id && Model.Error.Length > 0 ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@("restore-" + backup.Id + "-title")">Restore backup</h2><p class="ts-dialog-description">Restore the @backup.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture) backup of @Model.Database.Name.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@("restore-" + backup.Id)">@Icons.Render("X",18)</button></header>
@if(Model.RestoreId == backup.Id && Model.Error.Length > 0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}
<dl class="ts-db-facts"><div><dt>Database</dt><dd>@Model.Database.Name</dd></div><div><dt>Backup taken</dt><dd>@backup.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</dd></div><div><dt>Size</dt><dd>@DatabasesPage.Bytes(backup.SizeBytes)</dd></div></dl>
<form method="post" action="/api/v1/dashboard/backups/restore" data-submit-once class="ts-form" aria-label="Restore into a new database"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="backupId" value="@backup.Id" /><div class="ts-field"><label class="ts-label" for="@("restore-" + backup.Id + "-name")">New database name</label><input class="ts-input" id="@("restore-" + backup.Id + "-name")" name="name" value="@(Model.RestoreId == backup.Id ? Model.Name : "")" pattern="@DatabaseService.NameInputPattern" maxlength="63" title="@DatabaseService.NameHint" /><p class="ts-hint">@DatabaseService.NameHint Leave blank to automatically choose an available name starting with @(Model.Database.Name + "-restore"). Leaves @Model.Database.Name unchanged.</p></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="@("restore-" + backup.Id)">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Restore as new database</button></div></form><p class="ts-meta">Overwriting this database is unavailable.</p></div></dialog>}
else if(canRestore){<span class="ts-meta">Not restorable</span>}
else{<span class="ts-meta">Requires provisioning access</span>}
</td></tr>}
</tbody></table></div>}
</section>
@if(!Model.ExportRead){}
else if(Model.Export is null){<section class="ts-card" id="customer-bucket" aria-labelledby="customer-bucket-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="customer-bucket-title">Your bucket</h2></div></header><div class="ts-card-body"><p class="ts-meta" role="status">Your bucket and scheduled exports are unavailable. TerraBase did not answer.</p></div></section>}
else{var destination = Model.Export.Destination; var schedule = Model.Export.Schedule; var run = schedule.LastRun; var cron = schedule.Cron ?? "";
<section class="ts-card" id="customer-bucket" aria-labelledby="customer-bucket-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="customer-bucket-title">Your bucket</h2><p class="ts-card-description">An S3-compatible bucket of this project. Backups are copied to it, and scheduled exports are written to it.</p></div></header><div class="ts-card-body">
@if(destination is not null){<dl class="ts-db-facts"><div><dt>Endpoint</dt><dd class="ts-mono">@destination.Endpoint</dd></div><div><dt>Bucket</dt><dd class="ts-mono">@destination.Bucket</dd></div><div><dt>Region</dt><dd>@destination.Region</dd></div><div><dt>Credentials</dt><dd>Saved, never shown again</dd></div></dl>
@if(canManage){@(await RenderPartialAsync<TerraScale.Dashboard.Shared.UI.Slices.ConfirmDialog, ConfirmDialogModel>(new("remove-backup-bucket", "/api/v1/dashboard/backups/destination-remove", "Remove bucket", destination.Bucket, "This removes the project's saved bucket connection and deletes its saved credentials. Reconnecting requires entering the credentials again.", Model.Shell.CsrfToken, new Dictionary<string, string> { ["databaseId"] = Model.Database.Id })))}}
else{<p class="ts-meta">No bucket saved for this project.</p>}
@if(canManage){<form method="post" action="/api/v1/dashboard/backups/destination" class="ts-form" aria-label="Save your bucket"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><div class="ts-form-grid"><div class="ts-field"><label class="ts-label" for="bucket-endpoint">Endpoint</label><input class="ts-input ts-mono" id="bucket-endpoint" name="endpoint" type="url" placeholder="https://fly.storage.tigris.dev" required /></div><div class="ts-field"><label class="ts-label" for="bucket-region">Region</label><input class="ts-input" id="bucket-region" name="region" placeholder="auto" required /></div><div class="ts-field"><label class="ts-label" for="bucket-name">Bucket</label><input class="ts-input ts-mono" id="bucket-name" name="bucket" minlength="3" maxlength="63" required /></div><div class="ts-field"><label class="ts-label" for="bucket-key">Access key ID</label><input class="ts-input ts-mono" id="bucket-key" name="accessKeyId" autocomplete="off" required /></div><div class="ts-field"><label class="ts-label" for="bucket-secret">Secret key</label><input class="ts-input ts-mono" id="bucket-secret" name="secretKey" type="password" autocomplete="new-password" required /><p class="ts-hint">TerraBase seals the key and checks it can write to the bucket. It is never shown again.</p></div></div><div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">@(destination is null ? "Save bucket" : "Replace bucket")</button></div></form>}
</div></section>
<section class="ts-card" id="scheduled-export" aria-labelledby="scheduled-export-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="scheduled-export-title">Scheduled export to your bucket</h2><p class="ts-card-description">One NDJSON file of every live document, <code>{"collection","id","document"}</code> per line, the format imports accept.</p></div></header><div class="ts-card-body">
@if(run is { Status: "failed" }){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-title">The last scheduled export failed</p><p class="ts-alert-body">@(run.Error ?? "TerraBase did not report the reason.")</p></div>}
@if(canManage && destination is not null){<form method="post" action="/api/v1/dashboard/backups/export-schedule" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><div class="ts-field"><label class="ts-label" for="export-cron">Schedule</label><select class="ts-select" id="export-cron" name="cron">
@foreach(var choice in new[] { ("", "Off"), ("0 3 * * *", "Daily at 03:00 UTC"), ("0 3 * * 0", "Weekly, Sunday at 03:00 UTC") }.Concat(cron is "" or "0 3 * * *" or "0 3 * * 0" ? [] : new[] { (cron, "Custom: " + cron + " (UTC)") })){<option value="@choice.Item1" selected="@(cron == choice.Item1 ? "selected" : null)">@choice.Item2</option>}
</select></div><div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Save schedule</button></div></form>}
else{<p class="ts-meta">Schedule: @(cron switch { "" => "Off", "0 3 * * *" => "Daily at 03:00 UTC", "0 3 * * 0" => "Weekly, Sunday at 03:00 UTC", _ => cron + " (UTC)" })@(destination is null ? " · Save your bucket first." : "")</p>}
@if(run is null){<p class="ts-meta" role="status">No scheduled export has run yet.</p>}
else{<dl class="ts-db-facts"><div><dt>Last run</dt><dd class="ts-mono">@run.StartedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</dd></div><div><dt>Status</dt><dd><span class="ts-badge @(run.Status == "succeeded" ? "ts-badge-success" : "ts-badge-danger")">@run.Status</span></dd></div><div><dt>Documents</dt><dd>@run.Documents.ToString("N0",System.Globalization.CultureInfo.InvariantCulture)</dd></div><div><dt>Object key</dt><dd class="ts-mono">@(run.Key ?? "None")</dd></div></dl>}
</div></section>}
