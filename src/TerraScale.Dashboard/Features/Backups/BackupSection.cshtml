@inherits RazorSlice<TerraScale.Dashboard.Features.Backups.BackupPage>
@using TerraScale.Dashboard.Features.Databases
@{ var policy = Model.Listing?.Policy; var canManage = Model.Shell.Context.CanManage && Model.Database.Status == "ready"; var canRestore = canManage && Model.Shell.Context.Organization?.CanProvision(Model.Shell.Context.UserId) == true; var now = DateTimeOffset.UtcNow; }
@if(Model.Restore is not null){@(await RenderPartialAsync<TerraScale.Dashboard.Features.Backups.RestoreStatusView, TerraScale.Dashboard.Features.Backups.BackupPage>(Model))}
<section class="ts-card" id="backup-policy" aria-labelledby="backup-policy-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="backup-policy-title">Backup policy</h2></div></header><div class="ts-card-body">
@if(policy is null){<div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">Backup schedules couldn't be loaded.</p><a class="ts-link" href="@DatabaseService.Path(Model.Database.Id, "backups")">Retry</a></div>}
else{<div class="ts-db-setting"><div class="ts-list-main"><span class="ts-strong">Scheduled backups</span><span class="ts-meta">@(policy.FullBackupCron.Length == 0 ? "No full backup schedule" : "Scheduled full backups enabled")</span></div></div>
@if(policy.FullBackupCron.Length > 0 && policy.LastFailedAt is { } failed && (policy.LastSucceededAt is not { } succeededBefore || failed > succeededBefore)){<div class="ts-alert ts-alert-danger" id="backup-health" role="status"><p class="ts-alert-body">Scheduled backup failed <time datetime="@failed.ToString("O",System.Globalization.CultureInfo.InvariantCulture)" title="@TerraScale.Dashboard.Features.Backups.BackupHealth.Utc(failed)">@TerraScale.Dashboard.Features.Backups.BackupHealth.Relative(failed, now)</time>@(policy.LastError?.Message is { Length: > 0 } message ? ": " + message : "")</p></div>}
else if(policy.FullBackupCron.Length > 0 && policy.LastSucceededAt is { } succeeded && policy.NextDueAt is { } due){<p class="ts-meta" id="backup-health">Last backup <time datetime="@succeeded.ToString("O",System.Globalization.CultureInfo.InvariantCulture)" title="@TerraScale.Dashboard.Features.Backups.BackupHealth.Utc(succeeded)">@TerraScale.Dashboard.Features.Backups.BackupHealth.Relative(succeeded, now)</time> · Next <time datetime="@due.ToString("O",System.Globalization.CultureInfo.InvariantCulture)" title="@TerraScale.Dashboard.Features.Backups.BackupHealth.Utc(due)">@TerraScale.Dashboard.Features.Backups.BackupHealth.Relative(due, now)</time></p>}
@if(canManage){<form method="post" action="/api/v1/dashboard/backups/policy" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><div class="ts-field"><label class="ts-label" for="full-cron">Full backup schedule</label><input class="ts-input ts-mono" id="full-cron" name="fullBackupCron" value="@(Model.FullBackupCron ?? policy.FullBackupCron)" placeholder="0 2 * * *" maxlength="256" /></div><div class="ts-field"><label class="ts-label" for="retention">Retention days</label><input class="ts-input" id="retention" name="retentionDays" type="number" min="1" max="35" value="@(Model.RetentionDays ?? policy.RetentionDays.ToString(System.Globalization.CultureInfo.InvariantCulture))" required /></div><div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Save policy</button></div></form>}
else{<p class="ts-meta">Schedule: <span class="ts-mono">@policy.FullBackupCron</span> · Retention: @policy.RetentionDays days</p>}
}
</div></section>
<section class="ts-card ts-card-flush" id="restore-points" aria-labelledby="restore-points-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="restore-points-title">Restore points</h2></div>
@if(canManage && Model.Listing is not null){<form method="post" action="/api/v1/dashboard/backups" data-submit-once><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><button class="ts-btn ts-btn-primary ts-btn-sm" type="submit">@Icons.Render("Archive",16)<span>Create backup</span></button></form>}
@if(canManage){<a class="ts-btn ts-btn-secondary ts-btn-sm" href="@("/databases/" + Model.Database.Id + "/point-in-time")">Restore database at UTC time</a>}
</header>
@if(Model.Listing is null){<div class="ts-card-body"><div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">Restore points for @Model.Database.Name are unavailable.</p><a class="ts-link" href="@DatabaseService.Path(Model.Database.Id, "backups")">Retry</a></div></div>}
else if(Model.Listing.Backups.Count == 0){<div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">No restore points yet.</p></div></div>}
else{<div class="ts-table-wrap"><table class="ts-table"><thead><tr><th>Created</th><th>Status</th><th class="ts-num">Size</th><th>Actions</th></tr></thead><tbody>
@foreach(var backup in Model.Listing.Backups){<tr><td class="ts-mono">@backup.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</td><td><span class="ts-badge @(backup.Status == "ready" ? "ts-badge-success" : backup.Status == "failed" ? "ts-badge-danger" : "")">@backup.Status</span></td><td class="ts-num">@TerraScale.Dashboard.Common.Formatting.MetricFormat.Bytes(backup.SizeBytes)</td><td>
@if(canRestore && backup.Status == "ready"){<button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" command="show-modal" commandfor="@("restore-" + backup.Id)">@Icons.Render("RotateCcw",15)<span>Restore</span></button>
<dialog id="@("restore-" + backup.Id)" class="ts-dialog" closedby="any" aria-labelledby="@("restore-" + backup.Id + "-title")" data-init="@(Model.RestoreId == backup.Id && Model.Error.Length > 0 ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@("restore-" + backup.Id + "-title")">Restore backup</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@("restore-" + backup.Id)">@Icons.Render("X",18)</button></header>
@if(Model.RestoreId == backup.Id && Model.Error.Length > 0){@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.DialogErrorView, DialogError>(new("restore-" + backup.Id, Model.Error)))}
<dl class="ts-db-facts"><div><dt>Database</dt><dd>@Model.Database.Name</dd></div><div><dt>Backup taken</dt><dd>@backup.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</dd></div><div><dt>Size</dt><dd>@TerraScale.Dashboard.Common.Formatting.MetricFormat.Bytes(backup.SizeBytes)</dd></div></dl>
<form method="post" action="/api/v1/dashboard/backups/restore" data-submit-once class="ts-form" aria-label="Restore into a new database"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="backupId" value="@backup.Id" /><div class="ts-field"><label class="ts-label" for="@("restore-" + backup.Id + "-name")">New database name</label><input class="ts-input" id="@("restore-" + backup.Id + "-name")" name="name" value="@(Model.RestoreId == backup.Id ? Model.Name : "")" pattern="@DatabaseService.NameInputPattern" maxlength="63" title="@DatabaseService.NameHint" placeholder="@(Model.Database.Name + "-restore")" /></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="@("restore-" + backup.Id)">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Restore as new database</button></div></form></div></dialog>}
else if(canRestore){<span class="ts-meta">Not restorable</span>}
else{<span class="ts-meta">Requires provisioning access</span>}
</td></tr>}
</tbody></table></div>}
</section>
@if(!Model.BucketRead){}
else if(Model.Bucket is null){<section class="ts-card" id="customer-bucket" aria-labelledby="customer-bucket-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="customer-bucket-title">Your bucket</h2></div></header><div class="ts-card-body"><div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">Your bucket couldn't be reached.</p><a class="ts-link" href="@DatabaseService.Path(Model.Database.Id, "backups")">Retry</a></div></div></section>}
else{var destination = Model.Bucket.Destination;
<section class="ts-card" id="customer-bucket" aria-labelledby="customer-bucket-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="customer-bucket-title">Your bucket</h2></div></header><div class="ts-card-body">
@if(destination is not null){<dl class="ts-db-facts"><div><dt>Endpoint</dt><dd class="ts-mono">@destination.Endpoint</dd></div><div><dt>Bucket</dt><dd class="ts-mono">@destination.Bucket</dd></div><div><dt>Region</dt><dd>@destination.Region</dd></div><div><dt>Credentials</dt><dd>Saved, never shown again</dd></div></dl>
@if(canManage){@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.DialogFormErrorView, DialogFormError>(new(new("remove-backup-bucket", "/api/v1/dashboard/backups/destination-remove", "Remove bucket", destination.Bucket, Model.Shell.CsrfToken, new Dictionary<string, string> { ["databaseId"] = Model.Database.Id }, Description: "Saved credentials are deleted."), DialogSubmission.Matches(HttpContext!, "/api/v1/dashboard/backups/destination-remove") ? Model.Error : "")))}}
else{<p class="ts-meta">No bucket saved for this project.</p>}
@if(canManage){<form method="post" action="/api/v1/dashboard/backups/destination" class="ts-form" aria-label="Save your bucket"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><div class="ts-form-grid"><div class="ts-field"><label class="ts-label" for="bucket-endpoint">Endpoint</label><input class="ts-input ts-mono" id="bucket-endpoint" name="endpoint" type="url" placeholder="https://fly.storage.tigris.dev" required maxlength="2048" pattern="https://.+" title="Enter an HTTPS URL" /></div><div class="ts-field"><label class="ts-label" for="bucket-region">Region</label><input class="ts-input" id="bucket-region" name="region" placeholder="auto" required minlength="1" maxlength="64" /></div><div class="ts-field"><label class="ts-label" for="bucket-name">Bucket</label><input class="ts-input ts-mono" id="bucket-name" name="bucket" minlength="3" maxlength="63" required /></div><div class="ts-field"><label class="ts-label" for="bucket-key">Access key ID</label><input class="ts-input ts-mono" id="bucket-key" name="accessKeyId" autocomplete="off" required minlength="1" maxlength="256" /></div><div class="ts-field"><label class="ts-label" for="bucket-secret">Secret key</label><input class="ts-input ts-mono" id="bucket-secret" name="secretKey" type="password" autocomplete="new-password" required minlength="1" maxlength="256" /></div></div><div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">@(destination is null ? "Save bucket" : "Replace bucket")</button></div></form>}
</div></section>
}
