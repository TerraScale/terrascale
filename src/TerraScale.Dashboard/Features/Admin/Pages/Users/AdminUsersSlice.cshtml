@inherits RazorSlice<AdminUsersPageModel>
@using TerraScale.Dashboard
@{ var shell = Model.Shell; }
@ShellHtml.Top(shell)
<div class="ts-page ts-admin-root">
    <div class="ts-admin-page-head">
        <div class="ts-admin-title-with-icon">
            @Icons.ShieldCheck(20)
            <h2 class="ts-admin-title">Users</h2>
        </div>
        <p class="ts-admin-subtitle">Owner-only user administration.</p>
    </div>
    @(AdminPresentation.Filter("/admin/users", "Users", Model.Query))
    <dl class="ts-kpis ts-admin-kpis" aria-label="User summary">
        @(AdminPresentation.Stat("Users", Model.TotalRows.ToString(), "Users"))
        @(AdminPresentation.Stat("Enabled", Model.EnabledRows.ToString(), "CircleCheck"))
        @(AdminPresentation.Stat("Owners", Model.OwnerRows.ToString(), "ShieldCheck"))
    </dl>
    @(AdminPresentation.TableStart("Users"))
    @if (Model.Rows.Count == 0)
    {
        @(AdminPresentation.TableEmpty("Users"))
    }
    else
    {
        <div class="ts-table-wrap">
            <table class="ts-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Owner</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>
                                <div class="ts-table-strong">@(string.IsNullOrWhiteSpace(row.DisplayName) ? row.Email : row.DisplayName)</div>
                                <div class="ts-table-mono ts-admin-cell-id">@row.UserId</div>
                            </td>
                            <td>@row.Email</td>
                            <td><span class="ts-badge @(row.Enabled ? "ts-badge-success" : "ts-badge-danger")">@(row.Enabled ? "Enabled" : "Disabled")</span></td>
                            <td><span class="ts-badge @(row.Owner ? "ts-badge-warning" : "ts-badge-neutral")">@(row.Owner ? "Owner" : "User")</span></td>
                            <td>@AdminPresentation.Timestamp(row.CreatedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @(AdminPresentation.TableEnd)
    @(AdminPresentation.Pager("/admin/users", Model.Page, Model.TotalPages, Model.TotalRows, Model.Query))
</div>
@ShellHtml.Bottom(shell)
