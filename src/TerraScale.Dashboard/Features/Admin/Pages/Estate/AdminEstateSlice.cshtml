@inherits RazorSlice<AdminEstatePageModel>
@{ var shell = Model.Shell; }
@ShellHtml.Top(shell)
<div class="ts-page ts-admin-root">
    <div class="ts-admin-page-head">
        <div class="ts-admin-title-with-icon">
            @Icons.Network(20)
            <h2 class="ts-admin-title">Estate</h2>
        </div>
        <p class="ts-admin-subtitle">Owner-only region and placement state.</p>
    </div>
    <dl class="ts-kpis ts-admin-kpis" aria-label="Estate summary">
        @(AdminPresentation.Stat("Regions", Model.RegionTotalRows.ToString(), "Globe2"))
        @(AdminPresentation.Stat("Available regions", Model.AvailableRegionCount.ToString(), "CircleCheck"))
        @(AdminPresentation.Stat("Placed databases", Model.HostTotalRows.ToString(), "Database"))
    </dl>
    <div class="ts-toolbar ts-admin-tabs-toolbar">
        <nav class="ts-tabs" aria-label="Estate sections">
            <a class="ts-tab" href="/admin/estate?tab=regions" aria-current="@(Model.Tab == "regions" ? "page" : null)" aria-selected="@(Model.Tab == "regions" ? "true" : "false")">@Icons.Globe2(16) Regions</a>
            <a class="ts-tab" href="/admin/estate?tab=hosts" aria-current="@(Model.Tab == "hosts" ? "page" : null)" aria-selected="@(Model.Tab == "hosts" ? "true" : "false")">@Icons.Database(16) Hosts</a>
            <a class="ts-tab" href="/admin/estate?tab=operations" aria-current="@(Model.Tab == "operations" ? "page" : null)" aria-selected="@(Model.Tab == "operations" ? "true" : "false")">@Icons.Settings(16) Operations</a>
        </nav>
    </div>
    <div class="ts-admin-tab-panel @(Model.Tab == "regions" ? "" : "ts-admin-tab-panel-hidden")">
        @(AdminPresentation.TableStart("Regions"))
        <div class="ts-table-wrap">
            <table class="ts-table">
                <thead>
                    <tr>
                        <th>Region</th>
                        <th>Status</th>
                        <th>Databases</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Regions)
                    {
                        <tr>
                            <td>
                                <div class="ts-table-strong">@row.Name (@row.Code)</div>
                                <div class="ts-table-mono ts-admin-cell-id">@row.Country</div>
                            </td>
                            <td><span class="ts-badge @(row.Available ? "ts-badge-success" : "ts-badge-danger")">@(row.Available ? "Available" : "Unavailable")</span></td>
                            <td>@row.DatabaseCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @(AdminPresentation.TableEnd)
        @(AdminPresentation.Pager("/admin/estate", Model.RegionPage, Model.RegionTotalPages, Model.RegionTotalRows, Model.Query, "regions"))
    </div>
    <div class="ts-admin-tab-panel @(Model.Tab == "hosts" ? "" : "ts-admin-tab-panel-hidden")">
        @(AdminPresentation.Filter("/admin/estate", "Hosts", Model.Query, "hosts"))
        @(AdminPresentation.TableStart("Hosts"))
        @if (Model.Hosts.Count == 0)
        {
            @(AdminPresentation.TableEmpty("Hosts"))
        }
        else
        {
            <div class="ts-table-wrap">
                <table class="ts-table">
                    <thead>
                        <tr>
                            <th>Database</th>
                            <th>Regions</th>
                            <th>Version</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Hosts)
                        {
                            <tr>
                                <td>
                                    <div class="ts-table-strong">@row.Name</div>
                                    <div class="ts-table-mono ts-admin-cell-id">@row.DatabaseId</div>
                                </td>
                                <td>@(string.Join(", ", row.Regions).Length > 0 ? string.Join(", ", row.Regions) : "-")</td>
                                <td><span class="ts-badge ts-badge-info">v@(row.Version)</span></td>
                                <td>@AdminPresentation.Timestamp(row.CreatedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @(AdminPresentation.TableEnd)
        @(AdminPresentation.Pager("/admin/estate", Model.HostPage, Model.HostTotalPages, Model.HostTotalRows, Model.Query, "hosts"))
    </div>

    <div class="ts-admin-dashboard-root ts-admin-tab-panel @(Model.Tab == "operations" ? "" : "ts-admin-tab-panel-hidden")">
        <div class="ts-admin-dashboard-intro">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="estate-operations-title">Estate operations</h2>
                    <p class="ts-meta">Live estate facts from the TerraScale admin SDK. @Model.AvailableSections/@Model.TotalSections sections available.</p>
                </div>
            </div>
        </div>
        <section class="ts-admin-section" aria-labelledby="estate-actions-title">
            <div class="ts-section-head">
                <div>
                    <h3 class="ts-panel-title" id="estate-actions-title">Product actions</h3>
                    <p class="ts-meta">Every action requires an actor, target, and reason.</p>
                </div>
            </div>
            <div class="ts-admin-action-panel">
                <form class="ts-admin-action-form" method="post" action="/api/v1/admin/estate/action">
                    <label>
                        <span class="ts-sr-only">Action</span>
                        <select class="ts-select" name="action">
                            @foreach (var option in new[] { ("pause", "Pause database"), ("resume", "Resume database"), ("guard", "Set guard"), ("spendCap", "Set spend cap"), ("trial", "Adjust trial"), ("refund", "Issue refund"), ("reaperExemption", "Set reaper exemption"), ("flag", "Set feature flag"), ("viewAs", "View as tenant") })
                        {
                                <option value="@option.Item1">@option.Item2</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span class="ts-sr-only">Target</span>
                        <input class="ts-input" name="targetId" placeholder="Tenant, database, or organization ID" required />
                    </label>
                    <label>
                        <span class="ts-sr-only">Value (optional)</span>
                        <input class="ts-input" name="value" placeholder="Value (optional)" />
                    </label>
                    <label>
                        <span class="ts-sr-only">Reason</span>
                        <input class="ts-input" name="reason" placeholder="Reason for this audited action" required minlength="3" maxlength="1000" />
                    </label>
                    <button type="submit" class="ts-btn ts-btn-primary ts-btn-lg">Apply</button>
                </form>
                <p class="ts-admin-action-hint" aria-live="polite">@(Model.Notice ?? "Product controls never perform infrastructure operations.")</p>
            </div>
        </section>
        <details class="ts-admin-facts" open="@(Model.AvailableSections is 0 ? "open" : null)">
            <summary class="ts-section-head">
                <div>
                    <h3 class="ts-panel-title">Estate facts</h3>
                    <p class="ts-meta">SDK live data for the available estate capabilities.</p>
                </div>
                <span class="ts-admin-facts-chevron" aria-hidden="true">@Icons.ChevronDown(16)</span>
            </summary>
            <div class="ts-admin-dashboard-sections">
                @foreach (var (key, title) in TerraScale.Dashboard.Shared.State.DashboardStore.EstateSections)
                {
                    <section class="ts-admin-dashboard-panel" aria-labelledby="@($"estate-{key}-title")">
                        <div class="ts-section-head">
                            <div>
                                <h4 class="ts-panel-title" id="@($"estate-{key}-title")">@title</h4>
                                <p class="ts-meta">SDK live data</p>
                            </div>
                        </div>
                        <div class="ts-admin-fact-list">
                            @if (!Model.Facts.TryGetValue(key, out var facts) || facts.Length == 0)
                            {
                                <div class="ts-empty">
                                    <span class="ts-empty-icon">@Icons.SearchX(16)</span>
                                    <span class="ts-empty-title">No data</span>
                                    <span class="ts-meta">This estate capability is unavailable.</span>
                                </div>
                            }
                            else
                            {
                                @foreach (var fact in facts)
                                {
                                    <div class="ts-admin-fact-row">
                                        <span class="ts-admin-fact-key">@fact.Key</span>
                                        <span class="ts-admin-fact-value">
                                            @fact.Value
                                            @if (fact.Detail is { } detail)
                                            {
                                                <small class="ts-admin-fact-detail">@detail</small>
                                            }
                                        </span>
                                    </div>
                                }
                            }
                        </div>
                    </section>
                }
            </div>
        </details>
    </div>
</div>
@ShellHtml.Bottom(shell)
