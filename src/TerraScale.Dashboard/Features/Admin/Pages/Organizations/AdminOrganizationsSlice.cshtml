@inherits RazorSlice<AdminOrganizationsPageModel>
@{ var shell = Model.Shell; }
@ShellHtml.Top(shell)
<div class="ts-page ts-admin-root">
    <div class="ts-admin-page-head">
        <h2 class="ts-admin-title">Organizations</h2>
        <p class="ts-admin-subtitle">Owner-only organization inventory.</p>
    </div>
    @(AdminPresentation.Filter("/admin/organizations", "Organizations", Model.Query))
    <dl class="ts-kpis ts-admin-kpis" aria-label="Organization summary">
        @(AdminPresentation.Stat("Organizations", Model.TotalRows.ToString(), Icons.Building2))
        @(AdminPresentation.Stat("With owners", Model.WithOwners.ToString(), Icons.UserRound))
    </dl>
    @(AdminPresentation.TableStart("Organizations"))
    @if (Model.Rows.Count == 0)
    {
        @(AdminPresentation.TableEmpty("Organizations"))
    }
    else
    {
        <div class="ts-table-wrap">
            <table class="ts-table">
                <thead>
                    <tr>
                        <th>Organization</th>
                        <th>Status</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>
                                <div class="ts-table-strong">@row.Name</div>
                                <div class="ts-table-mono ts-admin-cell-id">@row.OrganizationId</div>
                            </td>
                            <td><span class="ts-badge ts-badge-neutral">@row.Status</span></td>
                            <td>@AdminPresentation.Timestamp(row.CreatedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @(AdminPresentation.TableEnd)
    @(AdminPresentation.Pager("/admin/organizations", Model.Page, Model.TotalPages, Model.TotalRows, Model.Query))
</div>
@ShellHtml.Bottom(shell)
