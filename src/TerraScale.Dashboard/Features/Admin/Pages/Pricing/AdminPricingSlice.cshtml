@inherits RazorSlice<AdminPricingPageModel>
@using System.Globalization
@{
    var shell = Model.Shell;
}
@ShellHtml.Top(shell)
<div class="ts-page ts-admin-root">
    <div class="ts-admin-page-head">
        <h2 class="ts-admin-title">Pricing</h2>
        <p class="ts-admin-subtitle">Owner-only pricing plan administration.</p>
    </div>
    <dl class="ts-kpis ts-admin-kpis" aria-label="Pricing summary">
        @(AdminPresentation.Stat("Plans", Model.TotalRows.ToString(), "CreditCard"))
        @(AdminPresentation.Stat("Visible", Model.Plans.Count(plan => plan.Visible).ToString(), "Eye"))
    </dl>
    <div class="ts-toolbar ts-admin-tabs-toolbar">
        <nav class="ts-tabs" aria-label="Pricing sections">
            <a class="ts-tab" href="/admin/pricing?tab=plans" aria-current="@(Model.Tab == "plans" ? "page" : null)" aria-selected="@(Model.Tab == "plans" ? "true" : "false")">@Icons.CreditCard(16) Plans</a>
            <a class="ts-tab" href="/admin/pricing?tab=create" aria-current="@(Model.Tab == "create" ? "page" : null)" aria-selected="@(Model.Tab == "create" ? "true" : "false")">@Icons.Plus(16) Create</a>
        </nav>
    </div>
    @if (Model.Tab == "create")
    {
        <section class="ts-admin-section" aria-labelledby="pricing-create-title">
            <div class="ts-section-head">
                <div>
                    <h2 id="pricing-create-title" class="ts-panel-title">Create pricing plan</h2>
                    <p class="ts-meta">Add a plan to the billing catalog with owner-tunable limits.</p>
                </div>
            </div>
            <div class="ts-admin-pricing-controls">
                @PlanForm(null)
            </div>
        </section>
    }
    else
    {
        @(AdminPresentation.Filter("/admin/pricing", "Pricing", Model.Query, "plans"))
        <section class="ts-admin-section" aria-labelledby="pricing-plans-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="pricing-plans-title">Pricing plans</h2>
                    <p class="ts-meta">Owner-visible data returned by the admin API</p>
                </div>
            </div>
            @if (Model.TotalRows == 0)
            {
                @(AdminPresentation.TableEmpty("pricing plans"))
            }
            else
            {
                <div class="ts-table-wrap">
                    <table class="ts-table">
                        <thead>
                            <tr>
                                <th>Plan</th>
                                <th>Key</th>
                                <th>Monthly base</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.PlanRows)
                            {
                                <tr>
                                    <td class="ts-table-strong">@row.Name</td>
                                    <td class="ts-table-mono">@row.Key</td>
                                    <td class="ts-table-num">@((row.MonthlyBaseCents / 100m).ToString("C", CultureInfo.GetCultureInfo("en-US")))</td>
                                    <td><span class="ts-badge @(row.Visible ? "ts-badge-success" : "ts-badge-neutral")">@(row.Visible ? "Visible" : "Hidden")</span></td>
                                    <td>
                                        <div class="ts-row">
                                            <form method="post" action="/api/v1/admin/plans/visibility">
                                                <input type="hidden" name="planId" value="@row.PlanId" />
                                                <input type="hidden" name="visible" value="@(row.Visible ? "false" : "true")" />
                                                <button type="submit" class="ts-btn ts-btn-secondary ts-btn-lg">
                                                    @(row.Visible ? Icons.EyeOff(20) : Icons.Eye(20))
                                                    @(row.Visible ? "Hide" : "Show")
                                                </button>
                                            </form>
                                            <form method="post" action="/api/v1/admin/plans/delete">
                                                <input type="hidden" name="planId" value="@row.PlanId" />
                                                <button type="submit" class="ts-btn ts-btn-destructive ts-btn-lg">
                                                    @Icons.Trash2(20)
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @(AdminPresentation.Pager("/admin/pricing", Model.Page, Model.TotalPages, Model.TotalRows, Model.Query, "plans"))
            <details class="ts-admin-plan-edit">
                <summary class="ts-section-head">
                    <div>
                        <h3 class="ts-admin-edit-heading">Edit pricing plans</h3>
                        <p class="ts-meta">Open a plan when its limits or abuse guards need to change.</p>
                    </div>
                    <span class="ts-admin-facts-chevron" aria-hidden="true">@Icons.ChevronDown(16)</span>
                </summary>
                <div class="ts-admin-edit-list">
                    @foreach (var plan in Model.Plans)
                    {
                        @PlanForm(plan)
                    }
                </div>
            </details>
        </section>
    }
    @if (Model.Notice is { } notice)
    {
        <div class="ts-alert ts-alert-success" role="status">
            <span class="ts-alert-title">@Icons.CircleCheckBig(16) @notice</span>
        </div>
    }
</div>
@ShellHtml.Bottom(shell)

@functions
{
    private static string Text(long? value) => value?.ToString() ?? "";

    private Microsoft.AspNetCore.Html.HtmlString PlanForm(DashboardStore.AdminPlanRow? plan)
    {
        var editing = plan is not null;
        var prefix = plan?.PlanId ?? "create";
        var guards = plan?.Guards;
        return new($"""
            <form class="ts-admin-plan-form" method="post" action="/api/v1/admin/plans/save">
                <input type="hidden" name="planId" value="{E(plan?.PlanId ?? "")}" />
                <fieldset class="ts-admin-fieldset">
                    <legend class="ts-admin-legend">{(editing ? $"Edit: {E(plan!.Name)}" : "Create pricing plan")}</legend>
                    <div class="ts-admin-plan-fields">
                        {Field($"{prefix}-plan-key", "planKey", "Plan key", "text", "startup", plan?.Key ?? "")}
                        {Field($"{prefix}-plan-name", "planName", "Plan name", "text", "Startup", plan?.Name ?? "")}
                        {Field($"{prefix}-monthly-base-cents", "monthlyBaseCents", "Monthly cents", "number", "", plan?.MonthlyBaseCents.ToString() ?? "")}
                        {Field($"{prefix}-max-databases", "maxDatabases", "Databases", "number", "", plan?.MaxDatabases.ToString() ?? "")}
                        {Field($"{prefix}-storage-overage-cents", "storageOverageCents", "Storage overage cents per GB-region", "number", "", Text(plan?.StorageOverageCentsPerGbRegion), "Storage overage is billed per region; the abuse guards below are unbilled.")}
                    </div>
                </fieldset>
                <fieldset class="ts-admin-fieldset">
                    <legend class="ts-admin-legend">Unbilled abuse guards</legend>
                    <p class="ts-admin-help">Set owner-tunable D-64 limits for each database.</p>
                    <div class="ts-admin-plan-fields">
                        {Field($"{prefix}-read-qps", "readQps", "Read and query requests per second", "number", "", guards?.ReadQps.ToString() ?? "")}
                        {Field($"{prefix}-direct-read-bandwidth", "directReadBandwidth", "Direct member read bandwidth bytes per month", "number", "", guards?.DirectReadBandwidthBytesPerMonth.ToString() ?? "")}
                        {Field($"{prefix}-active-views", "activeViews", "Distinct active shared views", "number", "", guards?.ActiveViews.ToString() ?? "")}
                        {Field($"{prefix}-websocket-connections", "websocketConnections", "WebSocket connections", "number", "", guards?.WebsocketConnections.ToString() ?? "")}
                        {Field($"{prefix}-webhook-endpoints", "webhookEndpoints", "Webhook endpoints", "number", "", guards?.WebhookEndpoints.ToString() ?? "")}
                    </div>
                </fieldset>
                <div class="ts-admin-form-actions">
                    <button type="submit" class="ts-btn ts-btn-primary ts-btn-lg">
                        {(editing ? Icons.Save(20) : Icons.Plus(20))}
                        {(editing ? "Save changes" : "Create")}
                    </button>
                </div>
            </form>
            """);
    }

    private static string Field(string id, string name, string label, string type, string placeholder, string value, string? help = null)
    {
        var min = type == "number" ? " min=\"0\"" : "";
        return $"""
            <div class="ts-field">
                <label class="ts-label" for="{E(id)}">{E(label)}</label>
                <input class="ts-input" id="{E(id)}" name="{E(name)}" type="{E(type)}"{min} value="{E(value)}" placeholder="{E(placeholder)}" />
                {(help is null ? "" : $"<span class=\"ts-admin-help\" id=\"{E(id)}-help\">{E(help)}</span>")}
            </div>
            """;
    }

    private static string E(string value) => System.Net.WebUtility.HtmlEncode(value);
}
