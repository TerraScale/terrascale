@inherits RazorSlice<AdminUsagePageModel>
@using System.Globalization
@{ var shell = Model.Shell; }
@ShellHtml.Top(shell)
<div class="ts-page ts-admin-root">
    <div class="ts-admin-page-head">
        <h2 class="ts-admin-title">Usage</h2>
        <p class="ts-admin-subtitle">Owner-only platform usage summary.</p>
    </div>
    <dl class="ts-kpis ts-admin-kpis" aria-label="Platform summary">
        @(AdminPresentation.Stat("Organizations", Model.Overview.Organizations.ToString(), "Building2"))
        @(AdminPresentation.Stat("Projects", Model.Overview.Projects.ToString(), "FolderKanban"))
        @(AdminPresentation.Stat("Databases", Model.Overview.Databases.ToString(), "Database"))
    </dl>
    @(AdminPresentation.TableStart("Usage"))
    @if (Model.TotalRows == 0)
    {
        @(AdminPresentation.TableEmpty("Usage"))
    }
    else
    {
        <div class="ts-table-wrap">
            <table class="ts-table">
                <thead>
                    <tr>
                        <th>Metric</th>
                        <th>Value</th>
                        <th>Unit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.UsageRows)
                    {
                        <tr>
                            <td class="ts-table-strong">@row.Name</td>
                            <td class="ts-table-num">@row.Quantity.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(row.Unit ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @(AdminPresentation.TableEnd)
    @(AdminPresentation.Pager("/admin/usage", Model.Page, Model.TotalPages, Model.TotalRows))
</div>
@ShellHtml.Bottom(shell)
