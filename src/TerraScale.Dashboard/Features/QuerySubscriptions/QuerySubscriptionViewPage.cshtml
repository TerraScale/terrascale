@inherits RazorSlice<TerraScale.Dashboard.Features.QuerySubscriptions.QuerySubscriptionPage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
<main class="ts-page" data-project-id="@Model.Shell.Context.Project?.Id" data-organization-id="@Model.Shell.Context.Organization?.Id">
    <div class="ts-stack-sm"><h1>Query subscriptions</h1><p class="ts-meta">Shared result views saved in this project.</p></div>
    <div class="ts-alert ts-alert-info" role="status">Read-only saved configurations. Live query subscriptions are not available yet: TerraBase does not deliver them.</div>
    <section class="ts-card" id="saved-configurations"><div class="ts-card-head"><h2 class="ts-card-title">Saved configurations</h2><p class="ts-meta">Shared views saved in this project.</p></div>
        @if (Model.Configurations.Subscriptions.Count == 0)
        {
            <div class="ts-empty"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("RadioTower", 16)</span><p class="ts-empty-title">No shared-result configurations yet.</p></div>
        }
        else
        {
            <div class="ts-table-wrap"><table class="ts-table"><thead><tr><th>View</th><th>Database</th><th>SQL</th><th>Preference</th><th>Status</th></tr></thead><tbody>
                @foreach (var config in Model.Configurations.Subscriptions)
                {
                    <tr><td class="ts-strong">@config.Name</td><td>@config.DatabaseName</td><td><code>@config.Query</code></td><td>@(config.Transport == "websocket" ? "WebSocket" : "HTTP + CDN")</td><td><span class="ts-badge ts-badge-neutral">@config.Status</span></td></tr>
                }
            </tbody></table></div>
        }
    </section>
</main>
@functions { public ShellModel LayoutModel => Model.Shell; }
