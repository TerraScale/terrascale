@inherits RazorSlice<AuditPageModel>
@{
    var shell = Model.Shell;
    Microsoft.AspNetCore.Html.HtmlString Icon(string name, int size = 15) => (typeof(Icons).GetMethod(name)?.Invoke(null, [size]) as Microsoft.AspNetCore.Html.HtmlString) ?? Icons.Circle(size);

    string QueryHref(string? range = null, int? page = null)
    {
        var query = new List<string>();
        if (Model.Search.Length > 0) { query.Add("search=" + Uri.EscapeDataString(Model.Search)); }
        if (Model.Action != "all") { query.Add("action=" + Uri.EscapeDataString(Model.Action)); }
        if (Model.Severity != "all") { query.Add("severity=" + Uri.EscapeDataString(Model.Severity)); }
        query.Add("range=" + Uri.EscapeDataString(range ?? Model.Range));
        if (page is > 1) { query.Add("page=" + page.Value); }
        return "/audit?" + string.Join("&", query);
    }

    string ExportHref(string format)
    {
        var query = new List<string> { "format=" + format };
        if (Model.Search.Length > 0) { query.Add("search=" + Uri.EscapeDataString(Model.Search)); }
        if (Model.Action != "all") { query.Add("action=" + Uri.EscapeDataString(Model.Action)); }
        if (Model.Severity != "all") { query.Add("severity=" + Uri.EscapeDataString(Model.Severity)); }
        query.Add("range=" + Uri.EscapeDataString(Model.Range));
        return "/audit/export?" + string.Join("&", query);
    }

    var first = Model.FilteredCount is 0 ? 0 : ((Model.Page - 1) * AuditPageModel.PageSize) + 1;
    var last = Model.FilteredCount is 0 ? 0 : Math.Min(Model.FilteredCount, Model.Page * AuditPageModel.PageSize);
    var infoPercent = Model.FilteredCount is 0 ? 0 : Math.Round(Model.Info * 100.0 / Model.FilteredCount);
    var warnPercent = Model.FilteredCount is 0 ? 0 : Math.Round(Model.Warn * 100.0 / Model.FilteredCount);
    var criticalPercent = Model.FilteredCount is 0 ? 0 : Math.Round(Model.Critical * 100.0 / Model.FilteredCount);
}
@ShellHtml.Top(shell)
<div class="ts-page ts-audit-page">
    <div class="ts-toolbar">
        <nav class="ts-tabs" aria-label="Audit sections">
            <a class="ts-tab" href="/audit" aria-current="page" aria-selected="true">@Icons.ScrollText(16) Audit log</a>
        </nav>
        <form class="ts-filters ts-audit-filters" method="get" action="/audit" role="search" aria-label="Filter audit events">
            <div class="ts-filter-field ts-audit-search-field">
                <label class="ts-sr-only" for="audit-search">Search audit events</label>
                <input class="ts-input" id="audit-search" name="search" type="search" value="@Model.Search" placeholder="Actor, action, resource, or source" />
            </div>
            <div class="ts-filter-field">
                <span class="ts-filter-label ts-sr-only" id="audit-action-label">Action type</span>
                <input type="hidden" name="action" value="@(Model.Action == "all" ? "" : Model.Action)" />
                <details class="ts-menu ts-filter-menu">
                    <summary class="ts-select ts-filter-select" aria-labelledby="audit-action-label audit-action-value"><span id="audit-action-value">@(Model.Action == "all" ? "All actions" : Model.Action)</span></summary>
                    <div class="ts-menu-panel">
                        <button class="ts-menu-item" type="button" data-filter-value="" aria-current="@(Model.Action == "all" ? "true" : null)">All actions</button>
                        @foreach (var option in Model.ActionOptions.Where(option => option != "all"))
                        {
                            <button class="ts-menu-item" type="button" data-filter-value="@option" aria-current="@(option == Model.Action ? "true" : null)">@option</button>
                        }
                    </div>
                </details>
            </div>
            <div class="ts-filter-field">
                <span class="ts-filter-label ts-sr-only" id="audit-severity-label">Severity</span>
                <input type="hidden" name="severity" value="@(Model.Severity == "all" ? "" : Model.Severity)" />
                <details class="ts-menu ts-filter-menu">
                    <summary class="ts-select ts-filter-select" aria-labelledby="audit-severity-label audit-severity-value"><span id="audit-severity-value">@(Model.Severity switch { "all" => "All severities", "info" => "Info", "warn" => "Warning", _ => "Critical severity" })</span></summary>
                    <div class="ts-menu-panel">
                        @foreach (var option in DashboardStore.AuditSeverityOptions)
                        {
                            <button class="ts-menu-item" type="button" data-filter-value="@(option == "all" ? "" : option)" aria-current="@(option == Model.Severity ? "true" : null)">@(option switch { "all" => "All severities", "info" => "Info", "warn" => "Warning", _ => "Critical severity" })</button>
                        }
                    </div>
                </details>
            </div>
            <div class="ts-filter-field">
                <span class="ts-filter-label ts-sr-only" id="audit-range-label">Date range</span>
                <input type="hidden" name="range" value="@Model.Range" />
                <details class="ts-menu ts-filter-menu">
                    <summary class="ts-select ts-filter-select" aria-labelledby="audit-range-label audit-range-value"><span id="audit-range-value">@Model.Range</span></summary>
                    <div class="ts-menu-panel">
                        @foreach (var option in DashboardStore.AuditRangeOptions)
                        {
                            <button class="ts-menu-item" type="button" data-filter-value="@option" aria-current="@(option == Model.Range ? "true" : null)">@option</button>
                        }
                    </div>
                </details>
            </div>
            @if (Model.Search.Length > 0 || Model.Action != "all" || Model.Severity != "all" || Model.Range != "7d")
            {
                <a class="ts-btn ts-btn-ghost" href="/audit">Clear</a>
            }
        </form>
    </div>

    <section class="ts-section ts-audit-section" aria-labelledby="audit-overview-title">
        <div class="ts-section-head">
            <div>
                <h2 class="ts-panel-title" id="audit-overview-title">Audit activity</h2>
                <p class="ts-meta">Security events for the current project, filtered to @Model.Range · retention is managed in Settings</p>
            </div>
            <a class="ts-btn ts-btn-ghost" href="/settings?tab=audit">@Icons.Settings(16) Retention settings</a>
        </div>
        <dl class="ts-kpis" aria-label="Audit totals">
            <div>
                <dt>@Icons.ScrollText(14) Events</dt>
                <dd><span class="ts-kpi-value">@Model.FilteredCount.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span></dd>
                <small class="ts-meta">Showing @first–@last of @Model.AllEvents.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) retained events</small>
            </div>
            <div>
                <dt>@Icons.Shield(14) High risk</dt>
                <dd><span class="ts-kpi-value">@Model.Critical.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span></dd>
                <small class="ts-meta">Critical events in the current view</small>
            </div>
            <div>
                <dt>@Icons.TriangleAlert(14) Warnings</dt>
                <dd><span class="ts-kpi-value">@Model.Warn.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span></dd>
                <small class="ts-meta">Warning events in the current view</small>
            </div>
            <div>
                <dt>@Icons.Info(14) Informational</dt>
                <dd><span class="ts-kpi-value">@Model.Info.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span></dd>
                <small class="ts-meta">Informational events in the current view</small>
            </div>
        </dl>
    </section>

    <section class="ts-section ts-audit-section" aria-labelledby="audit-activity-title">
        <div class="ts-section-head">
            <div>
                <h2 class="ts-panel-title" id="audit-activity-title">Recent activity</h2>
                <p class="ts-meta">Showing @first–@last of @Model.FilteredCount.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) events · exports include every matching event</p>
            </div>
            <div class="ts-row">
                <button class="ts-btn ts-btn-primary" type="button" @(Model.FilteredCount == 0 ? "disabled" : null) data-open-dialog="audit-export-dialog">@Icons.Download(16) Export audit</button>
            </div>
        </div>

        @if (Model.FilteredCount is 0)
        {
            <div class="ts-empty">
                <span class="ts-empty-icon">@Icons.SearchX(16)</span>
                <span class="ts-empty-title">No audit events</span>
                <span class="ts-empty-meta">The TerraScale Dashboard API returned no persisted audit events matching this view.</span>
            </div>
        }
        else
        {
            <div class="ts-table-wrap ts-audit-table-wrap">
                <table class="ts-table ts-audit-table">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Actor</th>
                            <th>Action</th>
                            <th>Resource</th>
                            <th>Source</th>
                            <th>Severity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="ts-table-mono ts-nowrap-meta"><time datetime="@row.Time">@row.TimeLabel</time></td>
                                <td>
                                    <div class="ts-stack-sm">
                                        <span class="ts-table-strong">@row.Actor</span>
                                        <span class="ts-meta">@(row.ActorType == "service" ? "Service" : "User")</span>
                                    </div>
                                </td>
                                <td><span class="ts-row ts-row-tight ts-muted">@(Icon(row.ActionIcon)) <code class="ts-mono">@row.Action</code></span></td>
                                <td>@(row.Target.Length > 0 ? row.Target : "-")</td>
                                <td class="ts-table-mono ts-nowrap-meta">@row.Source</td>
                                <td>
                                    <div class="ts-row ts-row-tight">
                                        <span class="ts-badge ts-badge-@row.SeverityTone">@row.SeverityLabel</span>
                                        @if (row.Failure)
                                        {
                                            <span class="ts-badge ts-badge-danger">Failed</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav class="ts-pager" aria-label="Audit event pages">
                <span class="ts-meta">Showing @first–@last of @Model.FilteredCount.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) events</span>
                @if (Model.PageCount > 1)
                {
                    <div class="ts-row ts-row-tight">
                        @if (Model.Page > 1)
                        {
                            <a class="ts-btn ts-btn-ghost" href="@QueryHref(page: Model.Page - 1)" rel="prev"><span class="ts-audit-flip">@Icons.ChevronRight(14)</span> Previous</a>
                        }
                        @for (var pageNumber = 1; pageNumber <= Model.PageCount; pageNumber++)
                        {
                            <a class="ts-btn ts-btn-ghost ts-pager-page" href="@QueryHref(page: pageNumber)" aria-current="@(pageNumber == Model.Page ? "page" : null)">@pageNumber</a>
                        }
                        @if (Model.Page < Model.PageCount)
                        {
                            <a class="ts-btn ts-btn-ghost" href="@QueryHref(page: Model.Page + 1)" rel="next">Next @Icons.ChevronRight(14)</a>
                        }
                    </div>
                }
            </nav>
        }
    </section>

    <section class="ts-section ts-audit-section" aria-labelledby="audit-breakdown-title">
        <div class="ts-section-head">
            <div>
                <h2 class="ts-panel-title" id="audit-breakdown-title">Severity breakdown</h2>
                <p class="ts-meta">Events in the current filtered view</p>
            </div>
        </div>
        <dl class="ts-stats ts-audit-breakdown">
            <div>
                <dt>@Icons.Info(14) Informational</dt>
                <dd>@Model.Info.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</dd>
                <small class="ts-meta">@infoPercent% of filtered events</small>
                <span class="ts-bar-track" role="img" aria-label="@infoPercent% informational events"><span class="ts-bar-fill" style="width:@infoPercent%"></span></span>
            </div>
            <div>
                <dt>@Icons.TriangleAlert(14) Warning</dt>
                <dd>@Model.Warn.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</dd>
                <small class="ts-meta">@warnPercent% of filtered events</small>
                <span class="ts-bar-track" role="img" aria-label="@warnPercent% warning events"><span class="ts-bar-fill ts-audit-bar-warning" style="width:@warnPercent%"></span></span>
            </div>
            <div>
                <dt>@Icons.Shield(14) Critical severity</dt>
                <dd>@Model.Critical.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</dd>
                <small class="ts-meta">@criticalPercent% of filtered events</small>
                <span class="ts-bar-track" role="img" aria-label="@criticalPercent% critical events"><span class="ts-bar-fill ts-audit-bar-danger" style="width:@criticalPercent%"></span></span>
            </div>
        </dl>
    </section>
</div>

<dialog class="ts-dialog" id="audit-export-dialog">
    <div class="ts-dialog-content" data-signals="{ auditExportFormat: 'csv' }">
        <div class="ts-dialog-header">
            <h3 class="ts-dialog-title">Export audit log</h3>
            <p class="ts-dialog-description">@Model.FilteredCount event@(Model.FilteredCount == 1 ? "" : "s") ready to export. The export includes every event matching the current filters.</p>
        </div>
        <div class="ts-audit-export-grid">
            <button type="button" class="ts-btn ts-btn-secondary ts-audit-export-option" data-class:ts-audit-export-option-active="$auditExportFormat === 'csv'" data-on:click="$auditExportFormat = 'csv'">
                <span class="ts-audit-export-option-label">@Icons.ScrollText(16) CSV</span>
                <span class="ts-audit-export-option-description">Spreadsheet-ready rows with all event fields.</span>
            </button>
            <button type="button" class="ts-btn ts-btn-secondary ts-audit-export-option" data-class:ts-audit-export-option-active="$auditExportFormat === 'json'" data-on:click="$auditExportFormat = 'json'">
                <span class="ts-audit-export-option-label">@Icons.ScrollText(16) JSON</span>
                <span class="ts-audit-export-option-description">Structured records for pipeline ingestion.</span>
            </button>
        </div>
        <div class="ts-dialog-footer">
            <button type="button" class="ts-btn ts-btn-ghost ts-btn-lg" data-close-dialog>Cancel</button>
            <a class="ts-btn ts-btn-primary ts-btn-lg" data-show="$auditExportFormat === 'csv'" href="@ExportHref("csv")">@Icons.Download(16) Export CSV</a>
            <a class="ts-btn ts-btn-primary ts-btn-lg" data-show="$auditExportFormat === 'json'" href="@ExportHref("json")">@Icons.Download(16) Export JSON</a>
        </div>
    </div>
</dialog>
@ShellHtml.Bottom(shell)
