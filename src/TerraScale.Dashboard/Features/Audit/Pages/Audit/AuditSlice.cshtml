@inherits RazorSlice<AuditPageModel>
@{
    var shell = Model.Shell;
    Microsoft.AspNetCore.Html.HtmlString Icon(string name, int size = 15) => (typeof(Icons).GetMethod(name)?.Invoke(null, [size]) as Microsoft.AspNetCore.Html.HtmlString) ?? Icons.Circle(size);
    string RangeHref(string range)
    {
        var query = new System.Collections.Generic.List<string>();
        if (Model.Action != "all") { query.Add("action=" + Uri.EscapeDataString(Model.Action)); }
        if (Model.Search.Length > 0) { query.Add("search=" + Uri.EscapeDataString(Model.Search)); }
        if (Model.Severity != "all") { query.Add("severity=" + Uri.EscapeDataString(Model.Severity)); }
        query.Add("range=" + range);
        return "/audit?" + string.Join("&", query);
    }
    string ExportHref(string format)
    {
        var query = new System.Collections.Generic.List<string> { "format=" + format };
        if (Model.Action != "all") { query.Add("action=" + Uri.EscapeDataString(Model.Action)); }
        if (Model.Search.Length > 0) { query.Add("search=" + Uri.EscapeDataString(Model.Search)); }
        if (Model.Severity != "all") { query.Add("severity=" + Uri.EscapeDataString(Model.Severity)); }
        query.Add("range=" + Model.Range);
        return "/audit/export?" + string.Join("&", query);
    }
    string Percent(int value, int total) => total is 0 ? "0" : Math.Round(value * 100.0 / total).ToString(System.Globalization.CultureInfo.InvariantCulture);
}
@ShellHtml.Top(shell)
<div class="ts-page ts-notes-page">
    <section class="ts-panel ts-panel-20">
        <div class="ts-row-between">
            <h2 class="ts-audit-title">Audit</h2>
            <a class="ts-btn ts-btn-ghost" href="/settings?tab=audit">@Icons.Settings(16) Retention settings</a>
        </div>
        <dl class="ts-audit-kpis">
            <div><dt>Events</dt><dd>@Model.Rows.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
            <div><dt>High risk</dt><dd class="ts-text-danger">@Model.Critical.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
            <div><dt>Warnings</dt><dd class="ts-text-warning">@Model.Warn.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
        </dl>
    </section>

    <section class="ts-panel">
        <div class="ts-panel-header ts-audit-activity-header">
            <h2 class="ts-panel-title">Recent activity</h2>
            <div class="ts-row">
                <a class="ts-btn ts-btn-ghost ts-audit-reset" href="/audit">@Icons.Filter(16) Reset filters</a>
                <button class="ts-btn ts-btn-primary" type="button" @(Model.Rows.Count == 0 ? "disabled" : null) data-on:click="document.querySelector('#audit-export-dialog').showModal()">@Icons.Download(16) Export audit</button>
            </div>
        </div>

        <form method="get" action="/audit" class="ts-audit-form">
            <div class="ts-field">
                <label class="ts-label" for="audit-search">Search</label>
                <div class="ts-audit-search-box">
                    @Icons.Search(16)
                    <input class="ts-input ts-search-input" id="audit-search" name="search" type="search" value="@Model.Search" placeholder="Actor, action, resource, or source" />
                </div>
            </div>
            <div class="ts-field">
                <label class="ts-label" for="audit-action">Action type</label>
                <select class="ts-select" id="audit-action" name="action">
                    @foreach (var option in Model.ActionOptions)
                    {
                        <option value="@option" selected="@(option == Model.Action)">@(option == "all" ? "All actions" : option)</option>
                    }
                </select>
            </div>
            <div class="ts-field">
                <label class="ts-label" for="audit-severity">Severity</label>
                <select class="ts-select" id="audit-severity" name="severity">
                    @foreach (var option in DashboardStore.AuditSeverityOptions)
                    {
                        <option value="@option" selected="@(option == Model.Severity)">@(option switch { "all" => "All severities", "info" => "Info", "warn" => "Warning", _ => "Critical severity" })</option>
                    }
                </select>
            </div>
            <input type="hidden" name="range" value="@Model.Range" />
            <div class="ts-field ts-audit-form-actions">
                <button class="ts-btn ts-btn-secondary" type="submit">Apply filters</button>
            </div>
        </form>

        <div class="ts-row-between ts-audit-range-row">
            <div class="ts-audit-meta-row ts-muted">
                @Icons.Calendar(15)
                <span class="ts-audit-range-label">Range</span>
                <div class="ts-filter-group" role="group" aria-label="Audit date range">
                    @foreach (var option in DashboardStore.AuditRangeOptions)
                    {
                        <a class="ts-filter-link @(Model.Range == option ? "ts-filter-active" : null)" href="@RangeHref(option)" aria-current="@(Model.Range == option ? "page" : null)">@option</a>
                    }
                </div>
            </div>
            <span class="ts-meta">Showing @Model.Rows.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) of @Model.AllEvents.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) events</span>
        </div>

        @if (Model.Rows.Count is 0)
        {
            <div class="ts-padded">
                <div class="ts-empty">
                    <span class="ts-empty-icon">@Icons.SearchX(16)</span>
                    <span class="ts-empty-title">No audit events</span>
                    <span class="ts-empty-meta">The TerraScale Dashboard API returned no persisted audit events matching this view.</span>
                </div>
            </div>
        }
        else
        {
            <div class="ts-table-wrap ts-audit-table-wrap">
                <table class="ts-table ts-audit-table">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Actor</th>
                            <th>Action</th>
                            <th>Resource</th>
                            <th>Source</th>
                            <th>Severity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="ts-table-mono ts-nowrap-meta"><time datetime="@row.Time">@row.TimeLabel</time></td>
                                <td>
                                    <div class="ts-stack-sm">
                                        <span class="ts-table-strong">@row.Actor</span>
                                        <span class="ts-meta">@(row.ActorType == "service" ? "Service" : "User")</span>
                                    </div>
                                </td>
                                <td><span class="ts-row ts-row-tight ts-muted">@(Icon(row.ActionIcon)) <code class="ts-mono">@row.Action</code></span></td>
                                <td>@(row.Target.Length > 0 ? row.Target : "-")</td>
                                <td class="ts-table-mono ts-nowrap-meta">@row.Source</td>
                                <td>
                                    <div class="ts-row ts-row-tight">
                                        <span class="ts-badge ts-badge-@row.SeverityTone">@row.SeverityLabel</span>
                                        @if (row.Failure)
                                        {
                                            <span class="ts-badge ts-badge-danger">Failed</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="ts-panel">
        <div class="ts-panel-header">
            <h2 class="ts-panel-title">Severity breakdown</h2>
            <p class="ts-panel-subtitle">Events in current view</p>
        </div>
        <div class="ts-stack-md ts-padded">
            <div class="ts-severity-box">
                <div class="ts-row-between">
                    <span class="ts-row ts-row-tight">@Icons.ShieldCheck(16) Info</span>
                    <span class="ts-metric-inline">@(Model.Rows.Count(r => r.Severity == "info"))</span>
                </div>
                <div class="ts-progress"><div class="ts-progress-bar ts-progress-bar-info" style="width:@(Percent(Model.Rows.Count(r => r.Severity == "info"), Model.Rows.Count))%"></div></div>
            </div>
            <div class="ts-severity-box">
                <div class="ts-row-between">
                    <span class="ts-row ts-row-tight">@Icons.ShieldAlert(16) Warning</span>
                    <span class="ts-metric-inline">@Model.Warn</span>
                </div>
                <div class="ts-progress"><div class="ts-progress-bar ts-progress-bar-warning" style="width:@(Percent(Model.Warn, Model.Rows.Count))%"></div></div>
            </div>
            <div class="ts-severity-box">
                <div class="ts-row-between">
                    <span class="ts-row ts-row-tight">@Icons.Shield(16) Critical severity</span>
                    <span class="ts-metric-inline">@Model.Critical</span>
                </div>
                <div class="ts-progress"><div class="ts-progress-bar ts-progress-bar-danger" style="width:@(Percent(Model.Critical, Model.Rows.Count))%"></div></div>
            </div>
        </div>
    </section>
</div>

<dialog class="ts-dialog" id="audit-export-dialog">
    <div class="ts-dialog-content" data-signals="{ auditExportFormat: 'csv' }">
        <div class="ts-dialog-header">
            <h3 class="ts-dialog-title">Export audit log</h3>
            <p class="ts-dialog-description">@Model.Rows.Count event@(Model.Rows.Count == 1 ? "" : "s") ready to export.</p>
        </div>
        <div class="ts-audit-export-grid">
            <button type="button" class="ts-btn ts-btn-secondary ts-audit-export-option" data-class:ts-audit-export-option-active="$auditExportFormat === 'csv'" data-on:click="$auditExportFormat = 'csv'">
                <span class="ts-audit-export-option-label">@Icons.ScrollText(16) CSV</span>
                <span class="ts-audit-export-option-description">Spreadsheet-ready rows with all event fields.</span>
            </button>
            <button type="button" class="ts-btn ts-btn-secondary ts-audit-export-option" data-class:ts-audit-export-option-active="$auditExportFormat === 'json'" data-on:click="$auditExportFormat = 'json'">
                <span class="ts-audit-export-option-label">@Icons.ScrollText(16) JSON</span>
                <span class="ts-audit-export-option-description">Structured records for pipeline ingestion.</span>
            </button>
        </div>
        <div class="ts-dialog-footer">
            <button type="button" class="ts-btn ts-btn-ghost ts-btn-lg" data-on:click="document.querySelector('#audit-export-dialog').close()">Cancel</button>
            <a class="ts-btn ts-btn-primary ts-btn-lg" data-show="$auditExportFormat === 'csv'" href="@ExportHref("csv")">@Icons.Download(16) Export CSV</a>
            <a class="ts-btn ts-btn-primary ts-btn-lg" data-show="$auditExportFormat === 'json'" href="@ExportHref("json")">@Icons.Download(16) Export JSON</a>
        </div>
    </div>
</dialog>
@ShellHtml.Bottom(shell)
