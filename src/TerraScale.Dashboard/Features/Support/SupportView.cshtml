@inherits RazorSlice<TerraScale.Dashboard.Features.Support.SupportPage>
@implements IUsesLayout<TerraScale.Dashboard.Shared.UI.Slices.ShellDocument, ShellModel>
<main class="ts-page">
    <header class="ts-row-between"><div class="ts-stack-sm"><h1>Contact support</h1><p class="ts-meta">Send a request to the TerraScale team. We reply by email to @Model.Shell.Context.Account.Email.</p></div></header>
    @if (Model.Error.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
    @if (Model.Sent.Length > 0) { <div class="ts-alert ts-alert-success" role="status" aria-live="polite" id="support-sent"><p class="ts-alert-title">Request @Model.Sent sent</p><p class="ts-alert-body">We emailed you an acknowledgement. Reply to it to add details.</p></div> }
    <div class="ts-grid-2">
        <section class="ts-card" id="support-request" aria-labelledby="support-request-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="support-request-title">New request</h2><p class="ts-card-description">Never include passwords, API keys or customer data.</p></div></header><div class="ts-card-body">
            <form class="ts-form" method="post" action="/api/v1/dashboard/support"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="requestId" value="@Model.Draft.RequestId" />
                <div class="ts-field"><label class="ts-label" for="support-organization">Organization</label><select class="ts-select" id="support-organization" name="organizationId" required>@foreach (var organization in Model.Shell.Context.Organizations) { <option value="@organization.Id" selected="@(organization.Id == Model.Draft.OrganizationId ? "selected" : null)">@organization.Name</option> }</select></div>
                <div class="ts-field"><label class="ts-label" for="support-project">Project (optional)</label><select class="ts-select" id="support-project" name="projectId"><option value="">No specific project</option>@foreach (var organization in Model.Shell.Context.Organizations.Where(item => item.Projects.Count > 0)) { <optgroup label="@organization.Name">@foreach (var project in organization.Projects.Values) { <option value="@project.Id" selected="@(project.Id == Model.Draft.ProjectId ? "selected" : null)">@project.Name</option> }</optgroup> }</select></div>
                <div class="ts-field"><label class="ts-label" for="support-database">Database (optional)</label><select class="ts-select" id="support-database" name="databaseId"><option value="">No specific database</option>@foreach (var project in Model.Shell.Context.Organizations.SelectMany(item => item.Projects.Values).Where(item => item.Databases.Count > 0)) { <optgroup label="@project.Name">@foreach (var database in project.Databases.Values) { <option value="@database.Id" selected="@(database.Id == Model.Draft.DatabaseId ? "selected" : null)">@database.Name</option> }</optgroup> }</select></div>
                <div class="ts-field"><label class="ts-label" for="support-severity">Severity</label><select class="ts-select" id="support-severity" name="severity">@foreach (var (key, title) in Severities) { <option value="@key" selected="@(key == Model.Draft.Severity ? "selected" : null)">@title</option> }</select></div>
                <div class="ts-field"><label class="ts-label" for="support-related-request">Request ID (optional)</label><input class="ts-input ts-mono" id="support-related-request" name="relatedRequestId" value="@Model.Draft.RelatedRequestId" minlength="26" maxlength="26" autocomplete="off" /><p class="ts-hint">Copy X-Request-ID from the response or an authorized Logs entry. An ID grants no access to diagnostics.</p></div>
                <div class="ts-field"><label class="ts-label" for="support-subject">Subject</label><input class="ts-input" id="support-subject" name="subject" value="@Model.Draft.Subject" maxlength="150" autocomplete="off" required /></div>
                <div class="ts-field"><label class="ts-label" for="support-message">What happened?</label><textarea class="ts-input" id="support-message" name="message" rows="8" maxlength="8000" required placeholder="What you did, what you expected, what happened instead, and when (UTC). Include request IDs from error responses.">@Model.Draft.Message</textarea></div>
                <div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Send request</button></div>
            </form>
        </div></section>
        <section class="ts-card" id="support-targets" aria-labelledby="support-targets-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="support-targets-title">Response targets</h2><p class="ts-card-description">First response, Monday to Friday 09:00–18:00 CET. Targets, not an SLA.</p></div></header><div class="ts-card-body"><dl class="ts-kv"><dt>Free</dt><dd>Best effort</dd><dt>Starter</dt><dd>2 business days</dd><dt>Pro</dt><dd>1 business day</dd><dt>Team</dt><dd>8 business hours</dd><dt>Enterprise</dt><dd>Per contract</dd></dl>
            <p class="ts-hint">You can also email <a href="mailto:support@terrascale.tech">support@terrascale.tech</a>. Check <a href="https://status.terrascale.tech" @(ExternalLink.Attributes)>system status@(ExternalLink.Hint)</a> for ongoing incidents, and the <a href="https://docs.terrascale.tech/legal/support" @(ExternalLink.Attributes)>support policy@(ExternalLink.Hint)</a>.</p></div></section>
    </div>
</main>
@functions {
    public ShellModel LayoutModel => Model.Shell;
    private static readonly (string Key, string Title)[] Severities = [("low", "Low: question or minor issue"), ("normal", "Normal: degraded but working"), ("high", "High: a feature is unusable"), ("urgent", "Urgent: production is down")];
}
