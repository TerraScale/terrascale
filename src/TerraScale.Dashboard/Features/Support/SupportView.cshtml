@inherits RazorSlice<TerraScale.Dashboard.Features.Support.SupportPage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
<main class="ts-page">
    <header class="ts-row-between"><h1>Contact support</h1></header>
    @if (Model.Error.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
    @if (Model.Sent.Length > 0) { <div class="ts-alert ts-alert-success" role="status" aria-live="polite" id="support-sent"><p class="ts-alert-title">Request @Model.Sent sent</p><p class="ts-alert-body">We emailed you an acknowledgement. Reply to it to add details.</p></div> }
    <div class="ts-grid-2">
        <section class="ts-card" id="support-request" aria-labelledby="support-request-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="support-request-title">New request</h2></div></header><div class="ts-card-body">
            <form class="ts-form" method="post" action="/api/v1/dashboard/support"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="requestId" value="@Model.Draft.RequestId" />
                <div class="ts-field"><label class="ts-label" for="support-organization">Organization</label><select class="ts-select" id="support-organization" name="organizationId" required>@foreach (var organization in Model.Shell.Context.Organizations) { <option value="@organization.Id" selected="@(organization.Id == Model.Draft.OrganizationId ? "selected" : null)">@organization.Name</option> }</select></div>
                <div class="ts-field"><label class="ts-label" for="support-project">Project</label><select class="ts-select" id="support-project" name="projectId"><option value="">No specific project</option>@foreach (var organization in Model.Shell.Context.Organizations.Where(item => item.Projects.Count > 0)) { <optgroup label="@organization.Name">@foreach (var project in organization.Projects.Values) { <option value="@project.Id" selected="@(project.Id == Model.Draft.ProjectId ? "selected" : null)">@project.Name</option> }</optgroup> }</select></div>
                <div class="ts-field"><label class="ts-label" for="support-database">Database</label><select class="ts-select" id="support-database" name="databaseId"><option value="">No specific database</option>@foreach (var project in Model.Shell.Context.Organizations.SelectMany(item => item.Projects.Values).Where(item => item.Databases.Count > 0)) { <optgroup label="@project.Name">@foreach (var database in project.Databases.Values) { <option value="@database.Id" selected="@(database.Id == Model.Draft.DatabaseId ? "selected" : null)">@database.Name</option> }</optgroup> }</select></div>
                <div class="ts-field"><label class="ts-label" for="support-severity">Severity</label><select class="ts-select" id="support-severity" name="severity">@foreach (var (key, title) in Severities) { <option value="@key" selected="@(key == Model.Draft.Severity ? "selected" : null)">@title</option> }</select></div>
                <div class="ts-field"><label class="ts-label" for="support-related-request">Request ID</label><input class="ts-input ts-mono" id="support-related-request" name="relatedRequestId" value="@Model.Draft.RelatedRequestId" minlength="26" maxlength="26" placeholder="01JBX8Y3Z4N5P6Q7R8S9T0V1W2" autocomplete="off" spellcheck="false" pattern="[0-7][0-9A-HJKMNP-TV-Z]{25}" title="Enter a 26-character uppercase request ID starting with 0–7" /></div>
                <div class="ts-field"><label class="ts-label" for="support-subject">Subject</label><input class="ts-input" id="support-subject" name="subject" value="@Model.Draft.Subject" autocomplete="off" required pattern="[\s\u0085]*[^\p{Cc}]*\S[^\p{Cc}]*[\s\u0085]*" title="Enter a subject without control characters" /></div>
                <div class="ts-field"><label class="ts-label" for="support-message">What happened?</label><textarea class="ts-input" id="support-message" name="message" rows="8" required placeholder="What you did, what you expected, what happened instead, and when (UTC). Never include passwords, API keys or customer data." minlength="1" data-max-length="8000" data-length-reserve-field="relatedRequestId" data-length-reserve="39" >@Model.Draft.Message</textarea></div>
                <div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Send request</button></div>
            </form>
        </div></section>
        <section class="ts-card" id="support-targets" aria-labelledby="support-targets-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="support-targets-title">First response · Mon–Fri 09:00–18:00 CET</h2></div></header><div class="ts-card-body"><dl class="ts-kv"><dt>Free</dt><dd>Best effort</dd><dt>Starter</dt><dd>2 business days</dd><dt>Pro</dt><dd>1 business day</dd><dt>Team</dt><dd>8 business hours</dd><dt>Enterprise</dt><dd>Per contract</dd></dl>
            <div class="ts-row"><a class="ts-link" href="mailto:support@terrascale.tech">support@terrascale.tech</a><a class="ts-link" href="https://status.terrascale.tech" @(ExternalLink.Attributes)>System status@(ExternalLink.Hint)</a><a class="ts-link" href="https://docs.terrascale.tech/legal/support" @(ExternalLink.Attributes)>Support policy@(ExternalLink.Hint)</a></div></div></section>
    </div>
</main>
@functions {
    public ShellModel LayoutModel => Model.Shell;
    private static readonly (string Key, string Title)[] Severities = [("low", "Low: question or minor issue"), ("normal", "Normal: degraded but working"), ("high", "High: a feature is unusable"), ("urgent", "Urgent: production is down")];
}
