@inherits RazorSlice<TerraScale.Dashboard.Features.Imports.ImportsPage>
@implements IUsesLayout<TerraScale.Dashboard.Shared.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.Imports
@inject AssetUrls Assets
@{ var canProvision = Model.Shell.Context.Organization?.CanProvision(Model.Shell.Context.UserId) == true; var culture = System.Globalization.CultureInfo.InvariantCulture; }
<main class="ts-page ts-imports">
<header class="ts-db-head"><nav class="ts-breadcrumb" aria-label="Breadcrumb"><a href="/databases">Databases</a><span aria-hidden="true">/</span><span aria-current="page">Import</span></nav><h1 class="ts-db-title">Import a database</h1></header>
@if(Model.Error.Length > 0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-title">Import not created</p><p class="ts-alert-body">@Model.Error</p></div>}
<div class="ts-split"><section class="ts-card" id="import-start" aria-labelledby="import-start-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="import-start-title">Import from PostgreSQL, Turso or NDJSON</h2><p class="ts-card-description">Upload an export file. TerraScale copies it into a new database and never connects to your source.</p></div></header><div class="ts-card-body ts-stack-lg">
<ol class="ts-import-outline"><li>Export on your own machine, with your own credentials. Nothing in the export is executed.</li><li>Upload it and review the dry-run preview: tables, type mapping, keys, and everything that will differ.</li><li>Confirm that exact preview. Follow progress, cancel or resume, and check the validated counts.</li></ol>
<div class="ts-stack-sm"><div class="ts-snippet" data-signals="{_pgCopy: ''}"><div class="ts-snippet-header ts-row-between"><span>PostgreSQL</span><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-on:click="(navigator.clipboard?.writeText(document.getElementById('import-pg-command').textContent) ?? Promise.reject()).then(() => { $_pgCopy = 'Copied'; setTimeout(() => $_pgCopy = '', 2000) }, () => $_pgCopy = 'Copy failed')">@Icons.Render("Copy", 14)<span data-text="$_pgCopy || 'Copy'">Copy</span></button></div><pre class="ts-snippet-body" id="import-pg-command"><code>pg_dump --format=plain --no-owner --no-privileges --encoding=UTF8 -f dump.sql &lt;database&gt;</code></pre></div><p class="ts-meta">Have a custom-format archive? Convert it with <code>pg_restore -f dump.sql archive.dump</code>. Compressed files and <code>--inserts</code> dumps are not accepted.</p></div>
<div class="ts-stack-sm"><div class="ts-snippet" data-signals="{_tursoCopy: ''}"><div class="ts-snippet-header ts-row-between"><span>Turso or SQLite</span><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-on:click="(navigator.clipboard?.writeText(document.getElementById('import-turso-command').textContent) ?? Promise.reject()).then(() => { $_tursoCopy = 'Copied'; setTimeout(() => $_tursoCopy = '', 2000) }, () => $_tursoCopy = 'Copy failed')">@Icons.Render("Copy", 14)<span data-text="$_tursoCopy || 'Copy'">Copy</span></button></div><pre class="ts-snippet-body" id="import-turso-command"><code>turso db export &lt;database&gt; --output-file turso-export.db
sqlite3 turso-export.db "VACUUM INTO 'export.db'"</code></pre></div><p class="ts-meta">Keep any <code>turso-export.db-wal</code> beside the export while running <code>VACUUM INTO</code>. For a local SQLite file: <code>sqlite3 local.db "VACUUM INTO 'export.db'"</code>. Upload <code>export.db</code>. Alternatively run <code>PRAGMA journal_mode=DELETE</code> on a copy kept together with its <code>-wal</code> file. Files in WAL mode, including <code>.backup</code> copies, are refused: rows still in a <code>-wal</code> file would be missing.</p></div>
<div class="ts-stack-sm"><p class="ts-label">NDJSON</p><p class="ts-meta">One JSON object per line: a TerraScale export (<code>{"collection","id","document"}</code>, ids kept), or plain objects from MongoDB or Firestore with a target collection below, or objects that each name their <code>collection</code>. Plain objects get a new ULID. See <a class="ts-link" href="https://docs.terrascale.tech/guides/import-ndjson">Import from MongoDB or Firestore</a>.</p></div></div></section>
<div class="ts-stack-lg">@if(Model.Unavailable.Length > 0){<div class="ts-alert ts-alert-info" role="status"><p class="ts-alert-title">Import unavailable</p><p class="ts-alert-body">@Model.Unavailable</p></div>}
@if(canProvision){<section class="ts-card ts-card-boxed" aria-label="Upload and preview"><div class="ts-card-body"><form method="post" action="/api/v1/dashboard/imports" class="ts-form" data-import-upload="create" data-signals="{_importFormat: 'postgres_plain'}"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="sourceBytes" value="" /><input type="hidden" name="sourceSha256" value="" />
<fieldset class="ts-field ts-stack-sm ts-import-formats"><legend class="ts-label">Export format</legend>@foreach(var format in ImportService.Formats){<label class="ts-import-format"><input type="radio" name="format" data-bind="_importFormat" value="@ImportService.Wire(format.Key)" checked="@(format.Key == TerraScale.DotNet.TerraBase.TerraBaseImportFormat.PostgresPlain)" required /><span><strong>@format.Label</strong><small>@(format.Key switch { TerraScale.DotNet.TerraBase.TerraBaseImportFormat.PostgresPlain => "pg_dump --format=plain", TerraScale.DotNet.TerraBase.TerraBaseImportFormat.Sqlite => "VACUUM INTO copy", _ => "one JSON object per line" })</small></span></label>}</fieldset>
<div class="ts-field" data-show="$_importFormat === 'ndjson'"><label class="ts-label" for="import-collection">Target collection (optional)</label><input class="ts-input" id="import-collection" name="collection" maxlength="63" pattern="[a-z][a-z0-9_\-]{0,62}" data-attr:disabled="$_importFormat !== 'ndjson'" aria-describedby="import-collection-hint" /><p class="ts-hint" id="import-collection-hint">For ordinary mongoexport objects such as <code>{"name":"Ada"}</code>, enter a collection such as <code>people</code>. Leave blank when every line names its collection. TerraScale export envelopes keep their original collection and ID. JSON arrays and CSV are not accepted.</p></div>
<div class="ts-field"><label class="ts-label" for="import-file">Export file</label><input class="ts-input" id="import-file" type="file" name="file" required aria-describedby="import-file-hint" /><p class="ts-hint" id="import-file-hint">Up to 1 GiB. Your browser computes its SHA-256 fingerprint before uploading.</p></div>
<input type="hidden" name="database" value="@Model.NewDatabase" /><div class="ts-field"><span class="ts-label">Destination</span><p class="ts-meta">A new, empty database named <span class="ts-mono ts-strong">@Model.NewDatabase</span> in this project's home region. Existing databases are never written. It counts toward your plan's database limit, and imported documents count as writes and storage.</p></div>
<p class="ts-hint">Every row gets a deterministic generated ULID, except NDJSON lines exported as <code>{"collection","id","document"}</code>, which keep their id. Source primary keys stay document fields; tables do not need a primary key.</p>
<p class="ts-hint">TerraBase keeps the uploaded file in that region only while the import needs it. It deletes the file when the import completes or its database is deleted. A partial upload is discarded after 1 day without progress (the upload then starts over); an unconfirmed preview is kept 7 days, and a failed or cancelled import's file 7 days.</p>
<progress class="ts-import-progress" max="100" value="0" hidden data-import-progress></progress><p class="ts-meta" role="status" aria-live="polite" data-import-status></p>
<noscript><p class="ts-meta">Uploading needs JavaScript to fingerprint the file.</p></noscript>
<div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit" disabled="@(Model.Unavailable.Length > 0)">@Icons.Render("Upload",16)<span>Upload and preview</span></button></div></form></div></section>}
else{<section class="ts-card"><div class="ts-card-body"><p class="ts-meta">Importing creates a database, which requires provisioning access.</p></div></section>}
</div></div>
<section class="ts-card ts-card-flush" id="import-jobs" aria-labelledby="import-jobs-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="import-jobs-title">Imports</h2><p class="ts-card-description">Each import has its own destination database</p></div></header>
@if(Model.Unavailable.Length > 0){<div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">Imports unavailable.</p><p class="ts-empty-detail">@Model.Unavailable</p></div></div>}
else if(Model.Jobs.Count == 0){<div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">No imports yet.</p><p class="ts-empty-detail">Nothing is copied until you confirm a preview.</p></div></div>}
else{<div class="ts-table-wrap"><table class="ts-table"><thead><tr><th>Destination</th><th>Source</th><th>Status</th><th class="ts-num">Rows written</th><th>Created</th></tr></thead><tbody>
@foreach(var job in Model.Jobs){<tr><td><a href="@ImportEndpoints.JobPath(job.Database)">@job.Database</a></td><td>@ImportService.FormatLabel(job.Source.Format)</td><td><span class="ts-badge ts-badge-tone" data-tone="@ImportService.Tone(job.State)"><span class="ts-dot" aria-hidden="true"></span>@ImportService.Wire(job.State).Replace('_', ' ')</span></td><td class="ts-num">@(job.Progress is { } progress ? progress.RowsWritten.ToString("N0", culture) + " / " + progress.RowsTotal.ToString("N0", culture) : "—")</td><td class="ts-mono">@job.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'", culture)</td></tr>}
</tbody></table></div>}
</section>
</main>
<script type="module" src="@Assets.Url("js/import-upload.js")" nonce="@Model.Shell.Nonce"></script>
@functions { public ShellModel LayoutModel => Model.Shell; }
