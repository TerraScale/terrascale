@inherits RazorSlice<UsagePageModel>
@{
    var shell = Model.Shell;
    Microsoft.AspNetCore.Html.HtmlString Icon(string name, int size = 15) => (typeof(Icons).GetMethod(name)?.Invoke(null, [size]) as Microsoft.AspNetCore.Html.HtmlString) ?? Icons.Circle(size);
    string InvoiceTone(string status) => status == "paid" ? "ts-badge-success" : "ts-badge-warning";
}
@ShellHtml.Top(shell)
<div class="ts-page">
    @if (Model.BillingReturn is "success")
    {
        <div class="ts-alert ts-alert-success" role="status">
            <span class="ts-alert-title">@Icons.CircleCheckBig(16) Billing setup complete</span>
            <span class="ts-alert-body">Stripe returned to TerraScale. Subscription and invoice details will update after the signed webhook is processed.</span>
        </div>
    }
    else if (Model.BillingReturn is "canceled")
    {
        <div class="ts-alert ts-alert-info" role="status">
            <span class="ts-alert-title">@Icons.Info(16) Billing setup canceled</span>
            <span class="ts-alert-body">No plan change was confirmed. Your current billing state is unchanged.</span>
        </div>
    }

    <section class="ts-panel">
        <div class="ts-row-between">
            <p class="ts-muted">Usage period @DashboardStore.FormatUtcDateTime(Model.PeriodStart) to @DashboardStore.FormatUtcDateTime(Model.PeriodEnd)</p>
            <a class="ts-btn ts-btn-secondary ts-btn-sm" href="/usage">@Icons.RefreshCw(14) Refresh</a>
        </div>
        @if (Model.UsagePartial)
        {
            <div class="ts-alert ts-alert-warning" role="alert">
                <span class="ts-alert-title">@Icons.TriangleAlert(16) Usage data is partially loaded</span>
                <span class="ts-alert-body">Some usage sources are temporarily unavailable. Available values remain visible.</span>
            </div>
        }
        <div class="ts-grid ts-usage-summary">
            @foreach (var stat in Model.Stats)
            {
                <div class="ts-card ts-metric">
                    <span class="ts-metric-label">@(Icon(stat.Icon, 16)) @stat.Label</span>
                    <strong class="ts-metric-value ts-metric-value-sm">@stat.Value</strong>
                    <small class="ts-metric-detail">@stat.Detail</small>
                </div>
            }
        </div>
    </section>

    <section class="ts-panel">
        <div class="ts-panel-header ts-usage-head-actions">
            <div>
                <h2 class="ts-panel-title">Organization usage</h2>
                <p class="ts-panel-subtitle">@Model.OrganizationSubtitle</p>
            </div>
            <span class="ts-badge ts-badge-success">Updated @Model.OrganizationUpdatedAt</span>
        </div>
        <div class="ts-stack-md">
            <div class="ts-alert ts-alert-info" role="status">
                <span class="ts-alert-title">@Icons.Info(16) Billing dimensions</span>
                <span class="ts-alert-body">Only logical storage and writes are billed. Reads and egress are unbilled metered facts used for guards and cost attribution.</span>
            </div>
            <div class="ts-grid ts-grid-cards ts-grid-cards-4 ts-usage-stats">
                <div class="ts-card ts-metric">
                    <span class="ts-metric-label"><span class="ts-metric-icon-accent">@(Icon("HardDrive"))</span> Logical storage</span>
                    <strong class="ts-metric-value ts-metric-value-sm">@Model.OrganizationStorage</strong>
                    <small class="ts-metric-detail">Organization total</small>
                </div>
                <div class="ts-card ts-metric">
                    <span class="ts-metric-label"><span class="ts-metric-icon-accent">@(Icon("Activity"))</span> Writes</span>
                    <strong class="ts-metric-value ts-metric-value-sm">@Model.OrganizationWrites</strong>
                    <small class="ts-metric-detail">Current billing period</small>
                </div>
                <div class="ts-card ts-metric">
                    <span class="ts-metric-label"><span class="ts-metric-icon-warning">@(Icon("Activity"))</span> Reads (unbilled)</span>
                    <strong class="ts-metric-value ts-metric-value-sm">Not reported</strong>
                    <small class="ts-metric-detail">Guard and attribution fact</small>
                </div>
                <div class="ts-card ts-metric">
                    <span class="ts-metric-label"><span class="ts-metric-icon-warning">@(Icon("Globe2"))</span> Egress (unbilled)</span>
                    <strong class="ts-metric-value ts-metric-value-sm">Not reported</strong>
                    <small class="ts-metric-detail">Guard and attribution fact</small>
                </div>
            </div>
            <div class="ts-table-wrap">
                <table class="ts-table">
                    <thead>
                        <tr>
                            <th>Plan resource</th>
                            <th>Used</th>
                            <th>Included</th>
                            <th>Remaining / excess</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.PlanResources)
                        {
                            <tr>
                                <td class="ts-table-strong">@row.Resource</td>
                                <td class="ts-table-num">@row.Used</td>
                                <td class="ts-table-num">@row.Included</td>
                                <td class="ts-table-num">@row.Balance</td>
                                <td><span class="ts-badge ts-badge-@(row.Tone)">@row.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="ts-table-wrap">
                <table class="ts-table">
                    <thead>
                        <tr>
                            <th>Project contribution</th>
                            <th>Storage</th>
                            <th>Writes</th>
                            <th>Reads (unbilled)</th>
                            <th>Egress (unbilled)</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.ProjectContributions)
                        {
                            <tr>
                                <td>
                                    <div class="ts-stack-xs">
                                        <span class="ts-table-strong">@row.ProjectName</span>
                                        <span class="ts-meta ts-mono">@row.ProjectId</span>
                                    </div>
                                </td>
                                <td class="ts-table-num">@row.Storage</td>
                                <td class="ts-table-num">@row.Writes</td>
                                <td class="ts-muted">@row.Reads</td>
                                <td class="ts-muted">@row.Egress</td>
                                <td><span class="ts-badge ts-badge-success">Current</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="ts-panel">
        <div class="ts-panel-header ts-usage-head-actions">
            <div>
                <h2 class="ts-panel-title">Storage quota</h2>
                <p class="ts-panel-subtitle">Project storage consumption from the active usage summary</p>
            </div>
            <span class="ts-badge ts-badge-@(Model.StorageTone)">@Model.StoragePercentLabel</span>
        </div>
        <div class="ts-stack-md">
            <div class="ts-progress" role="progressbar" aria-label="@Model.StoragePercentLabel" aria-valuenow="@((int)Model.StoragePercentUsed)" aria-valuemin="0" aria-valuemax="100">
                <div class="ts-progress-bar ts-progress-bar-@(Model.StorageTone)" style="width:@(Math.Min(100, Model.StoragePercentUsed).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
            </div>
            <div class="ts-grid ts-grid-cards ts-grid-cards-3">
                <div class="ts-card ts-quota-metric">
                    <span class="ts-metric-label">Used</span>
                    <strong class="ts-metric-value ts-metric-value-sm">@DashboardStore.FormatBytes(Model.StorageUsedBytes)</strong>
                </div>
                <div class="ts-card ts-quota-metric">
                    <span class="ts-metric-label">Quota</span>
                    <strong class="ts-metric-value ts-metric-value-sm">@DashboardStore.FormatBytes(Model.StorageLimitBytes)</strong>
                </div>
                <div class="ts-card ts-quota-metric">
                    <span class="ts-metric-label">Remaining</span>
                    <strong class="ts-metric-value ts-metric-value-sm">@Model.StorageRemainingLabel</strong>
                </div>
            </div>
        </div>
    </section>

    <section class="ts-panel">
        <div class="ts-panel-header ts-usage-head-actions">
            <div>
                <h2 class="ts-panel-title">Resource usage history</h2>
                <p class="ts-panel-subtitle">Logical storage and writes, with egress retained as an unbilled usage fact</p>
            </div>
            <span class="ts-muted">Select a period below</span>
        </div>
        <div class="ts-stack-md">
            @if (Model.RetentionWarning)
            {
                <div class="ts-alert ts-alert-info" role="status">
                    <span class="ts-alert-title">@Icons.Info(16) History limited by retention</span>
                    <span class="ts-alert-body">@Model.RetentionAlertBody</span>
                </div>
            }
            <div class="ts-usage-controls-end">
                <select class="ts-select" aria-label="Usage history period" data-on:change="window.location.assign('/usage?range=' + evt.target.value)">
                    @foreach (var option in Model.HistoryRanges)
                    {
                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Label</option>
                    }
                </select>
            </div>
            @if (Model.History.Count is 0)
            {
                @EmptyState("No usage history for this period", "Usage snapshots will appear as project resources are observed.")
            }
            else
            {
                <div class="ts-chart-shell">
                    @Charts.LineChart(Model.History, $"Resource usage history, {Model.HistoryRanges.First(r => r.Selected).Label} window")
                </div>
            }
        </div>
    </section>

    <section class="ts-grid ts-usage-charts">
        <div class="ts-panel ts-chart-shell">
            <div class="ts-panel-header ts-usage-head-actions">
                <div>
                    <h3 class="ts-panel-title">Measured usage</h3>
                    <p class="ts-panel-subtitle">Counters returned for the active project period</p>
                </div>
                <span class="ts-muted" aria-hidden="true">@Icons.BarChart3(18)</span>
            </div>
            @if (BarsEmpty(Model.MeasuredUsage))
            {
                @EmptyState("No usage counters returned", "No persisted records are available.")
            }
            else
            {
                <div class="ts-bar-list">
                    @foreach (var slice in Model.MeasuredUsage)
                    {
                        <div class="ts-bar-row">
                            <span class="ts-bar-label">@slice.Label</span>
                            <span class="ts-bar-track"><span class="ts-bar-fill" style="width:@(BarPercent(Model.MeasuredUsage, slice))%"></span></span>
                            <span class="ts-bar-value ts-mono">@(slice.DisplayValue ?? slice.Value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture))</span>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="ts-panel ts-chart-shell ts-render-deferred">
            <div class="ts-panel-header ts-usage-head-actions">
                <div>
                    <h3 class="ts-panel-title">Resource distribution</h3>
                    <p class="ts-panel-subtitle">Resources returned for the active project period</p>
                </div>
                <span class="ts-muted" aria-hidden="true">@Icons.BarChart3(18)</span>
            </div>
            @EmptyState("No resource distribution returned", "No persisted records are available.")
        </div>
        <div class="ts-panel ts-chart-shell ts-render-deferred">
            <div class="ts-panel-header ts-usage-head-actions">
                <div>
                    <h3 class="ts-panel-title">Activity breakdown</h3>
                    <p class="ts-panel-subtitle">Recent project activity; reads and egress are unbilled</p>
                </div>
                <span class="ts-muted" aria-hidden="true">@Icons.BarChart3(18)</span>
            </div>
            @EmptyState("No activity returned", "No persisted records are available.")
        </div>
        <div class="ts-panel ts-chart-shell ts-render-deferred">
            <div class="ts-panel-header ts-usage-head-actions">
                <div>
                    <h3 class="ts-panel-title">Region placement</h3>
                    <p class="ts-panel-subtitle">Counted from database placement records</p>
                </div>
                <span class="ts-muted" aria-hidden="true">@Icons.BarChart3(18)</span>
            </div>
            @if (BarsEmpty(Model.RegionPlacement))
            {
                @EmptyState("No regions saved", "No persisted records are available.")
            }
            else
            {
                <div class="ts-bar-list">
                    @foreach (var slice in Model.RegionPlacement)
                    {
                        <div class="ts-bar-row">
                            <span class="ts-bar-label">@slice.Label</span>
                            <span class="ts-bar-track"><span class="ts-bar-fill" style="width:@(BarPercent(Model.RegionPlacement, slice))%"></span></span>
                            <span class="ts-bar-value ts-mono">@slice.Value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="ts-panel ts-chart-shell ts-render-deferred">
            <div class="ts-panel-header ts-usage-head-actions">
                <div>
                    <h3 class="ts-panel-title">Database coverage</h3>
                    <p class="ts-panel-subtitle">Region count per database</p>
                </div>
                <span class="ts-muted" aria-hidden="true">@Icons.BarChart3(18)</span>
            </div>
            @if (BarsEmpty(Model.DatabaseCoverage))
            {
                @EmptyState("No databases saved", "No persisted records are available.")
            }
            else
            {
                <div class="ts-bar-list">
                    @foreach (var slice in Model.DatabaseCoverage)
                    {
                        <div class="ts-bar-row">
                            <span class="ts-bar-label">@slice.Label</span>
                            <span class="ts-bar-track"><span class="ts-bar-fill" style="width:@(BarPercent(Model.DatabaseCoverage, slice))%"></span></span>
                            <span class="ts-bar-value ts-mono">@slice.Value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <section class="ts-panel">
        <div class="ts-panel-header">
            <h2 class="ts-panel-title">Saved database usage</h2>
            <p class="ts-panel-subtitle">Resource counts from the TerraScale Dashboard API</p>
        </div>
        @if (Model.Databases.Count is 0)
        {
            @EmptyState("No databases saved", "Create a database to populate project usage.")
        }
        else
        {
            <div class="ts-table-wrap">
                <table class="ts-table">
                    <thead>
                        <tr>
                            <th>Database</th>
                            <th>Regions</th>
                            <th>Documents</th>
                            <th>Storage</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Databases)
                        {
                            <tr>
                                <td>
                                    <div class="ts-stack-xs">
                                        <span class="ts-table-strong">@row.Name</span>
                                        <span class="ts-meta ts-mono">@row.Id</span>
                                    </div>
                                </td>
                                <td class="ts-muted">@((row.PrimaryRegion + (row.BackupRegion is null ? "" : ", " + row.BackupRegion)).ToUpperInvariant())</td>
                                <td class="ts-table-num">@DashboardStore.FormatNumber(row.DocumentCount)</td>
                                <td class="ts-table-num">@DashboardStore.FormatBytes(row.SizeMb * 1024L * 1024)</td>
                                <td class="ts-muted">@DashboardStore.FormatUtcDateTime(row.CreatedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="ts-panel">
        <div class="ts-panel-header ts-usage-head-actions">
            <div>
                <h2 class="ts-panel-title">Billing data</h2>
                <p class="ts-panel-subtitle">Billing account and invoice projections</p>
            </div>
            <div class="ts-row ts-row-actions-end">
                @if (Model.HasManagedSubscription)
                {
                    <a class="ts-btn ts-btn-outline ts-btn-lg" href="@Model.BillingPortalHref">@Icons.ExternalLink(16) Manage subscription</a>
                }
                else
                {
                    <select class="ts-select" id="billing-plan" aria-label="Billing plan">
                        @foreach (var plan in Model.CheckoutPlans)
                        {
                            <option value="@plan.Href">@plan.Label</option>
                        }
                    </select>
                    <button type="button" class="ts-btn ts-btn-primary ts-btn-lg" data-on:click="window.location.assign(document.getElementById('billing-plan').value)">
                        @Icons.CreditCard(16) Subscribe
                    </button>
                    <a class="ts-btn ts-btn-outline ts-btn-lg" href="@Model.BillingPortalHref">@Icons.ExternalLink(16) Payment methods</a>
                }
            </div>
        </div>
        <form method="post" action="/api/v1/dashboard/usage/spending-controls" class="ts-stack-md">
            <p class="ts-muted">Databases and branches share organization allowances and the billing anniversary. Selected Regions multiply writes and storage before allowances. Paid excess costs $1 per million write units and $0.20 per GB-month. A spending cap stops chargeable writes; subscription and retained storage costs continue and can exceed the cap. Reads and exports remain available. Document deletes require paid write access when writes are restricted. Revoking consent stops new paid writes and does not erase outstanding charges or existing storage obligations.</p>
            <label class="ts-checkbox-row">
                <input class="ts-checkbox" type="checkbox" name="paidExcess" value="true" checked="@(Model.PaidExcessEnabled ? "checked" : null)" />
                I authorize paid excess at these rates and accept continuing storage costs.
            </label>
            <div class="ts-field">
                <label class="ts-label" for="spendCap">Monthly organization spending cap in USD (blank means no cap)</label>
                <input class="ts-input" id="spendCap" name="spendCap" inputmode="decimal" value="@Model.SpendCap" placeholder="" />
            </div>
            @if (Model.DatabaseCaps.Count > 0)
            {
                <details class="ts-stack-md">
                    <summary>Optional lower database spending caps</summary>
                    <p class="ts-meta">Database caps cannot raise the organization limit. Blank removes the lower database cap.</p>
                    @foreach (var database in Model.DatabaseCaps)
                    {
                        <div class="ts-field">
                            <label class="ts-label" for="dbCap_@database.Id">@database.Name — monthly cap in USD</label>
                            <input class="ts-input" id="dbCap_@database.Id" name="dbCap_@database.Id" inputmode="decimal" value="@database.Cap" />
                        </div>
                    }
                </details>
            }
            <div class="ts-form-actions">
                <button class="ts-btn ts-btn-primary" type="submit">Save spending controls</button>
            </div>
        </form>
        @if (Model.StorageCoverageDeadline is { } deadline)
        {
            <div class="ts-alert ts-alert-warning" role="alert">
                <span class="ts-alert-title">@Icons.TriangleAlert(16) Storage coverage requires attention</span>
                <span class="ts-alert-body">Restore coverage before the deletion grace deadline: @deadline. Reads and exports remain available. Deletion also requires the disclosed advance notices.</span>
            </div>
        }
        @if (Model.SavedControlsMessage is { } message)
        {
            <p class="ts-meta" role="status">@message</p>
        }
        @if (Model.BillingPartial)
        {
            <div class="ts-alert ts-alert-warning" role="alert">
                <span class="ts-alert-title">@Icons.TriangleAlert(16) Billing data is partially loaded</span>
                <span class="ts-alert-body">Some billing details are temporarily unavailable. Available subscription and invoice data remains visible.</span>
            </div>
        }
        <div class="ts-stack-lg">
            @if (Model.BillingActionRequired)
            {
                <div class="ts-alert ts-alert-warning" role="alert">
                    <span class="ts-alert-title">@Icons.TriangleAlert(16) Billing action required</span>
                    <span class="ts-alert-body">Open the billing portal to update payment details and restore full plan access.</span>
                </div>
            }
            <div class="ts-grid ts-billing-grid">
                <div class="ts-card ts-metric">
                    <span class="ts-metric-label">Status</span>
                    <span class="ts-badge ts-badge-@(Model.BillingStatusTone)">@Model.BillingStatus</span>
                </div>
                <div class="ts-card ts-metric">
                    <span class="ts-metric-label">Plan</span>
                    <span class="ts-badge ts-badge-info">@Model.PlanName</span>
                </div>
                <div class="ts-card ts-metric">
                    <span class="ts-metric-label">Price</span>
                    <span class="ts-badge ts-badge-neutral">@Model.Price</span>
                </div>
                <div class="ts-card ts-metric">
                    <span class="ts-metric-label">Frequency</span>
                    <span class="ts-badge ts-badge-neutral">@Model.Frequency</span>
                </div>
                <div class="ts-card ts-metric">
                    <span class="ts-metric-label">Renewal</span>
                    <span class="ts-badge ts-badge-neutral">@Model.Renewal</span>
                </div>
                <div class="ts-card ts-metric">
                    <span class="ts-metric-label">Invoices</span>
                    <span class="ts-badge ts-badge-neutral">@Model.InvoiceCount</span>
                </div>
            </div>

            @if (Model.HasManagedSubscription && Model.PlanImpact.Count > 0)
            {
                <div class="ts-stack-md">
                    <div class="ts-alert ts-alert-info" role="status">
                        <span class="ts-alert-title">@Icons.Info(16) Review plan-change impact before confirming</span>
                        <span class="ts-alert-body">Upgrades take effect immediately and may be prorated. Downgrades begin with the next billing cycle. Plans marked over current usage would start with billable excess unless usage is reduced before the change takes effect.</span>
                    </div>
                    <div class="ts-table-wrap">
                        <table class="ts-table">
                            <thead>
                                <tr>
                                    <th>Target plan</th>
                                    <th>Current usage</th>
                                    <th>Impact</th>
                                    <th>Effective</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.PlanImpact)
                                {
                                    <tr>
                                        <td class="ts-table-strong">@row.PlanName</td>
                                        <td><span class="ts-badge ts-badge-@row.BadgeTone">@row.Badge</span></td>
                                        <td>@row.Impact</td>
                                        <td class="ts-muted">@row.Effective</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (Model.Invoices.Count is 0)
            {
                @EmptyState("No invoices returned", "Invoice projections will appear after webhook processing.")
            }
            else
            {
                <div class="ts-table-wrap">
                    <table class="ts-table">
                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                                <th>Subscription period</th>
                                <th>Issued</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Invoices)
                            {
                                <tr>
                                    <td><span class="ts-row ts-row-tight">@Icons.ReceiptText(14) <span class="ts-mono">@row.InvoiceId[..14]…</span></span></td>
                                    <td class="ts-table-num">@DashboardStore.FormatMoney(row.AmountCents, row.Currency)</td>
                                    <td><span class="ts-badge @InvoiceTone(row.Status)">@row.Status</span></td>
                                    <td>
                                        <div class="ts-row ts-row-tight">
                                            @if (row.HostedInvoiceUrl is { } hosted)
                                            {
                                                <a class="ts-link" href="@hosted" target="_blank" rel="noreferrer">@Icons.ExternalLink(14) Open</a>
                                            }
                                            @if (row.InvoicePdf is { } pdf)
                                            {
                                                <a class="ts-link" href="@pdf" target="_blank" rel="noreferrer">@Icons.FileText(14) PDF</a>
                                            }
                                        </div>
                                    </td>
                                    <td class="ts-muted">@DashboardStore.FormatUtcDateTime(row.PeriodStart) to @DashboardStore.FormatUtcDateTime(row.PeriodEnd)</td>
                                    <td class="ts-muted">@DashboardStore.FormatUtcDateTime(row.IssuedAt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>
@ShellHtml.Bottom(shell)

@functions {
    private static string BarPercent(IReadOnlyList<BarSlice> slices, BarSlice slice)
    {
        var max = slices.Count is 0 ? 1 : slices.Max(s => s.Value);
        return (max is 0 ? 0 : Math.Round(slice.Value / max * 100)).ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    // v1 UsageBreakdown: bars render only when at least one slice has a value.
    private static bool BarsEmpty(IReadOnlyList<BarSlice> slices) => slices.Count is 0 || slices.All(s => s.Value <= 0);

    // v1 EmptyState: SearchX 16px in a 32x32 muted box, title, muted description.
    private static Microsoft.AspNetCore.Html.HtmlString EmptyState(string title, string description) => new(
