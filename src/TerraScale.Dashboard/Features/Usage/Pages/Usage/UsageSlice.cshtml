@inherits RazorSlice<UsagePageModel>
@{
    var shell = Model.Shell;
    Microsoft.AspNetCore.Html.HtmlString Icon(string name, int size = 15) => IconByName(name, size);
    string InvoiceTone(string status) => status switch { "paid" => "ts-badge-success", "open" => "ts-badge-warning", _ => "ts-badge-neutral" };
    var invoices = Model.InvoicePage;
    (string Id, string Label, string Icon)[] tabs = [("overview", "Overview", "BarChart3"), ("billing", "Billing", "CreditCard"), ("settings", "Settings", "Settings")];
    var filtered = Model.ProjectFilter.Length > 0 || Model.DatabaseFilter.Length > 0;
    var savedOk = Model.SavedControlsMessage is "Spending controls saved.";
    var saveError = savedOk ? null : Model.SavedControlsMessage;
    var rangeLabel = Model.HistoryRanges.First(r => r.Selected).Label;
}
@ShellHtml.Top(shell)
<div class="ts-page ts-usage">
    @if (Model.BillingReturn is "success")
    {
        <div class="ts-alert ts-alert-success" role="status">
            <span class="ts-alert-title">@Icons.CircleCheckBig(16) Billing setup complete</span>
            <span class="ts-alert-body">Stripe returned to TerraScale. Subscription and invoice details will update after the signed webhook is processed.</span>
        </div>
    }
    else if (Model.BillingReturn is "canceled")
    {
        <div class="ts-alert ts-alert-info" role="status">
            <span class="ts-alert-title">@Icons.Info(16) Billing setup canceled</span>
            <span class="ts-alert-body">No plan change was confirmed. Your current billing state is unchanged.</span>
        </div>
    }

    <div class="ts-toolbar">
        <nav class="ts-tabs" aria-label="Usage sections">
            @foreach (var (id, label, icon) in tabs)
            {
                <a class="ts-tab" href="/usage?tab=@id" aria-current="@(Model.Tab == id ? "page" : null)" aria-selected="@(Model.Tab == id ? "true" : "false")">@Icon(icon, 16) @label</a>
            }
        </nav>
        @if (Model.Tab is "overview")
        {
            <form class="ts-filters" method="get" action="/usage" role="search" aria-label="Filter usage">
                @FilterMenu("project", "Project", Model.ProjectFilter, "All projects", Model.ProjectOptions)
                @FilterMenu("database", "Database", Model.DatabaseFilter, "All databases", Model.DatabaseOptions)
                @FilterMenu("range", "Period", Model.RangeFilter, null, [.. Model.HistoryRanges.Select(r => (r.Value, r.Label))])
                @if (filtered)
                {
                    <a class="ts-btn ts-btn-ghost" href="/usage?range=@Model.RangeFilter">Clear</a>
                }
            </form>
        }
        else if (Model.Tab is "billing")
        {
            <form class="ts-filters" method="get" action="/usage" role="search" aria-label="Filter payment history">
                <input type="hidden" name="tab" value="billing" />
                @FilterMenu("status", "Invoice status", invoices.Status, "All statuses", UsageInvoicePage.StatusOptions)
                @FilterMenu("issued", "Issued", invoices.Issued, "Any time", UsageInvoicePage.IssuedOptions(DateTime.UtcNow))
                @if (invoices.Status.Length > 0 || invoices.Issued.Length > 0)
                {
                    <a class="ts-btn ts-btn-ghost" href="/usage?tab=billing">Clear</a>
                }
            </form>
        }
    </div>

    @if (Model.Tab is "overview")
    {
        <section class="ts-usage-section" aria-labelledby="usage-allowance-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="usage-allowance-title">Plan allowance</h2>
                    <p class="ts-meta">Organization totals for the current billing period · @Model.PlanName@(Model.Renewal is "Unknown" ? "" : $" · renews {Model.Renewal}")</p>
                </div>
            </div>
            <div class="ts-usage-allowance">
                @foreach (var row in Model.PlanResources)
                {
                    <div class="ts-usage-gauge">
                        <div class="ts-usage-ring">
                            @Charts.Ring(row.Percent, row.Tone, $"{row.Resource}: {DashboardStore.FormatPercent(row.Percent)} of included")
                            <span class="ts-usage-ring-value"><strong>@(Math.Round(row.Percent).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%</strong><small>of plan</small></span>
                        </div>
                        <div class="ts-stack-xs">
                            <span class="ts-metric-label">@(Icon(row.Resource == "Writes" ? "Activity" : "HardDrive", 14)) @row.Resource</span>
                            <span class="ts-usage-gauge-value">@row.Used <small>/ @row.Included</small></span>
                            <span class="ts-meta">@row.Balance</span>
                            <span><span class="ts-badge ts-badge-@(row.Tone)">@(Icon(row.Tone == "success" ? "CircleCheckBig" : "TriangleAlert", 12)) @row.Status</span></span>
                        </div>
                    </div>
                }
                @StatList(Model.Traffic)
            </div>
        </section>

        <div class="ts-columns">
            <section class="ts-usage-section" aria-labelledby="usage-history-title">
                <div class="ts-section-head">
                    <div>
                        <h2 class="ts-panel-title" id="usage-history-title">Workload history</h2>
                        <p class="ts-meta">Organization operations, @rangeLabel.ToLowerInvariant() · hover for exact values</p>
                    </div>
                    @if (Model.HistorySummary.Count > 0)
                    {
                        <dl class="ts-stats ts-usage-figures" aria-label="Totals this period">
                            @for (var i = 0; i < Model.HistorySummary.Count; i++)
                            {
                                <div><dt><span class="ts-chart-swatch ts-cat-@(i + 1)"></span>@Model.HistorySummary[i].Label</dt><dd>@Model.HistorySummary[i].Value</dd></div>
                            }
                        </dl>
                    }
                </div>
                @if (Model.RetentionWarning)
                {
                    <div class="ts-alert ts-alert-info" role="status">
                        <span class="ts-alert-title">@Icons.Info(16) History limited by retention</span>
                        <span class="ts-alert-body">@Model.RetentionAlertBody</span>
                    </div>
                }
                @if (Model.History.Count is 0)
                {
                    @EmptyState("No usage history for this period", "Usage snapshots will appear as project resources are observed.")
                }
                else
                {
                    <div class="ts-chart-shell">
                        @Charts.TimeSeriesChart(Model.HistoryTimes, Model.History, $"Reads, writes and replication, {rangeLabel.ToLowerInvariant()}", Model.RangeFilter is "24h" ? "HH:mm" : "MMM d", height: 200)
                    </div>
                }
            </section>

            <section class="ts-usage-section ts-aside" aria-labelledby="usage-breakdown-title">
                <div>
                    <h2 class="ts-panel-title" id="usage-breakdown-title">@(Model.ProjectFilter.Length > 0 ? "By database" : "By project")</h2>
                    <p class="ts-meta">@(filtered ? "Filtered scope" : "All projects in the organization")</p>
                </div>
                @StatList(Model.Stats)
                @if (Model.ProjectFilter.Length is 0)
                {
                    @if (Model.ProjectContributions.Count is 0)
                    {
                        @EmptyState("No projects saved", "No persisted records are available.")
                    }
                    else
                    {
                        <ul class="ts-usage-share">
                            @foreach (var row in Model.ProjectContributions)
                            {
                                <li>
                                    <div class="ts-usage-share-head">
                                        <a class="ts-table-strong ts-usage-drill" href="/usage?project=@row.ProjectId&amp;range=@Model.RangeFilter" title="Filter by @row.ProjectName">@row.ProjectName</a>
                                        <span class="ts-mono">@row.Storage</span>
                                    </div>
                                    <span class="ts-bar-track"><span class="ts-bar-fill" style="width:@(Share(Model.ProjectContributions.Sum(p => p.StorageBytes), row.StorageBytes))%"></span></span>
                                    <span class="ts-meta">@row.Writes writes</span>
                                </li>
                            }
                        </ul>
                    }
                }
                else if (Model.Databases.Count is 0)
                {
                    @EmptyState("No databases saved", "Create a database to populate project usage.")
                }
                else
                {
                    <ul class="ts-usage-share">
                        @foreach (var row in Model.Databases)
                        {
                            <li>
                                <div class="ts-usage-share-head">
                                    <span class="ts-row ts-row-tight">
                                        <span class="ts-table-strong">@row.Name</span>
                                        <span class="ts-badge ts-badge-neutral ts-mono">@row.PrimaryRegion.ToUpperInvariant()</span>
                                        @if (row.BackupRegion is { } backup)
                                        {
                                            <span class="ts-badge ts-badge-neutral ts-mono" title="Backup region">+ @backup.ToUpperInvariant()</span>
                                        }
                                    </span>
                                    <span class="ts-mono">@DashboardStore.FormatBytes(row.SizeMb * 1024L * 1024)</span>
                                </div>
                                <span class="ts-bar-track"><span class="ts-bar-fill" style="width:@(Share(Model.Databases.Sum(d => (long)d.SizeMb), row.SizeMb))%"></span></span>
                                <span class="ts-meta">@DashboardStore.FormatNumber(row.DocumentCount) documents</span>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    }
    else if (Model.Tab is "billing")
    {
        var summary = Model.Summary;
        <section class="ts-usage-section" aria-labelledby="usage-billing-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="usage-billing-title">Subscription</h2>
                    <p class="ts-meta">Plan changes, payment methods and cancellation are handled in the billing portal</p>
                </div>
                <a class="ts-btn ts-btn-primary" href="@Model.BillingPortalHref">@Icons.ExternalLink(16) Manage subscription</a>
            </div>
            @if (Model.BillingPartial)
            {
                <div class="ts-alert ts-alert-warning" role="alert">
                    <span class="ts-alert-title">@Icons.TriangleAlert(16) Billing data is partially loaded</span>
                    <span class="ts-alert-body">Some billing details are temporarily unavailable. Available subscription and invoice data remains visible.</span>
                </div>
            }
            @if (Model.BillingActionRequired)
            {
                <div class="ts-alert ts-alert-warning" role="alert">
                    <span class="ts-alert-title">@Icons.TriangleAlert(16) Billing action required</span>
                    <span class="ts-alert-body">Open the billing portal to update payment details and restore full plan access.</span>
                </div>
            }
            <dl class="ts-kpis">
                <div>
                    <dt>@Icons.CreditCard(14) Plan</dt>
                    <dd><span class="ts-kpi-value">@Model.PlanName</span> <span class="ts-badge ts-badge-@(Model.BillingStatusTone)">@Model.BillingStatus</span></dd>
                    <small class="ts-meta">@Model.Price / @Model.Frequency.ToLowerInvariant()@(Model.Renewal is "Unknown" ? "" : $" · renews {Model.Renewal}")</small>
                </div>
                <div>
                    <dt>@Icons.ReceiptText(14) Next invoice (estimate)</dt>
                    <dd><span class="ts-kpi-value">@summary.NextInvoice</span></dd>
                    <small class="ts-meta">@summary.NextInvoiceDetail · @summary.NextInvoiceDate</small>
                </div>
                <div>
                    <dt>@Icons.Calendar(14) Billing period</dt>
                    <dd><span class="ts-kpi-value">@summary.PeriodLabel</span></dd>
                    <span class="ts-bar-track" role="img" aria-label="@summary.PeriodElapsedDays of @summary.PeriodDays days elapsed"><span class="ts-bar-fill" style="width:@Share(summary.PeriodDays, summary.PeriodElapsedDays)%"></span></span>
                    <small class="ts-meta">Day @summary.PeriodElapsedDays of @summary.PeriodDays · @(summary.PeriodDays - summary.PeriodElapsedDays) days left</small>
                </div>
                <div>
                    <dt>@Icons.CircleAlert(14) Outstanding balance</dt>
                    <dd><span class="ts-kpi-value">@summary.Outstanding</span></dd>
                    <small class="ts-meta">@(summary.OpenCount is 0 ? "All invoices paid" : $"{summary.OpenCount} open invoice{(summary.OpenCount is 1 ? "" : "s")}") · @summary.PaidTotal paid across @summary.PaidCount</small>
                </div>
            </dl>
            @if (Model.HasManagedSubscription && Model.PlanImpact.Count > 0)
            {
                <div class="ts-alert ts-alert-info" role="status">
                    <span class="ts-alert-title">@Icons.Info(16) Review plan-change impact before confirming</span>
                    <span class="ts-alert-body">Upgrades take effect immediately and may be prorated. Downgrades begin with the next billing cycle. Plans marked over current usage would start with billable excess unless usage is reduced before the change takes effect.</span>
                </div>
                <div class="ts-table-wrap">
                    <table class="ts-table">
                        <thead>
                            <tr>
                                <th>Target plan</th>
                                <th>Current usage</th>
                                <th>Impact</th>
                                <th>Effective</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.PlanImpact)
                            {
                                <tr>
                                    <td class="ts-table-strong">@row.PlanName</td>
                                    <td><span class="ts-badge ts-badge-@row.BadgeTone">@row.Badge</span></td>
                                    <td>@row.Impact</td>
                                    <td class="ts-muted">@row.Effective</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="ts-usage-section ts-usage-divided" aria-labelledby="usage-invoices-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="usage-invoices-title">Payment history</h2>
                    <p class="ts-meta">Invoices issued to this organization, newest first</p>
                </div>
            </div>
            @if (invoices.Total is 0)
            {
                @EmptyState("No invoices match these filters", "Change the status or issued date, or clear the filters.")
            }
            else
            {
                <div class="ts-table-wrap">
                    <table class="ts-table">
                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Issued</th>
                                <th>Period</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in invoices.Rows)
                            {
                                <tr>
                                    <td><span class="ts-row ts-row-tight">@Icons.ReceiptText(14) <span class="ts-mono" title="@row.InvoiceId">@row.InvoiceId[..14]…</span></span></td>
                                    <td>@DashboardStore.FormatDate(row.IssuedAt)</td>
                                    <td class="ts-muted">@DashboardStore.FormatDate(row.PeriodStart) – @DashboardStore.FormatDate(row.PeriodEnd)</td>
                                    <td class="ts-table-num">@DashboardStore.FormatMoney(row.AmountCents, row.Currency)</td>
                                    <td><span class="ts-badge @InvoiceTone(row.Status)">@row.Status</span></td>
                                    <td>
                                        <div class="ts-row ts-row-tight">
                                            @if (row.HostedInvoiceUrl is { } hosted)
                                            {
                                                <a class="ts-link" href="@hosted" target="_blank" rel="noreferrer">@Icons.ExternalLink(14) Open</a>
                                            }
                                            @if (row.InvoicePdf is { } pdf)
                                            {
                                                <a class="ts-link" href="@pdf" target="_blank" rel="noreferrer">@Icons.FileText(14) PDF</a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <nav class="ts-pager" aria-label="Payment history pages">
                    <span class="ts-meta">Showing @invoices.First–@(invoices.First + invoices.Rows.Count - 1) of @invoices.Total</span>
                    @if (invoices.PageCount > 1)
                    {
                        <div class="ts-row ts-row-tight">
                            @if (invoices.Page > 1)
                            {
                                <a class="ts-btn ts-btn-ghost" href="@invoices.Href(invoices.Page - 1)" rel="prev"><span class="ts-usage-flip">@Icons.ChevronRight(14)</span> Previous</a>
                            }
                            @for (var n = 1; n <= invoices.PageCount; n++)
                            {
                                <a class="ts-btn ts-btn-ghost ts-pager-page" href="@invoices.Href(n)" aria-current="@(n == invoices.Page ? "page" : null)">@n</a>
                            }
                            @if (invoices.Page < invoices.PageCount)
                            {
                                <a class="ts-btn ts-btn-ghost" href="@invoices.Href(invoices.Page + 1)" rel="next">Next @Icons.ChevronRight(14)</a>
                            }
                        </div>
                    }
                </nav>
            }
        </section>
    }
    else
    {
        var cappedProjects = Model.CapGroups.Count(g => g.Project.Cap.Length > 0);
        var cappedDatabases = Model.CapGroups.Sum(g => g.Databases.Count(d => d.Cap.Length > 0));
        <section class="ts-usage-section" aria-labelledby="usage-spending-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="usage-spending-title">Spending controls</h2>
                    <p class="ts-meta">Limits that keep usage beyond the plan allowance from turning into surprise charges</p>
                </div>
                <button type="button" class="ts-btn ts-btn-primary" data-open-dialog="spending-controls-dialog">@Icons.Settings(16) Edit spending controls</button>
            </div>
            @if (savedOk)
            {
                <div class="ts-alert ts-alert-success" role="status">
                    <span class="ts-alert-title">@Icons.CircleCheckBig(16) @Model.SavedControlsMessage</span>
                </div>
            }
            @if (Model.StorageCoverageDeadline is { } deadline)
            {
                <div class="ts-alert ts-alert-warning" role="alert">
                    <span class="ts-alert-title">@Icons.TriangleAlert(16) Storage coverage requires attention</span>
                    <span class="ts-alert-body">Restore coverage before the deletion grace deadline: @deadline. Reads and exports remain available. Deletion also requires the disclosed advance notices.</span>
                </div>
            }
            <dl class="ts-kpis">
                <div>
                    <dt>@Icons.ShieldCheck(14) Paid excess</dt>
                    <dd>
                        <span class="ts-kpi-value">@(Model.PaidExcessEnabled ? "Authorized" : "Not authorized")</span>
                        @if (Model.PaidExcessEnabled)
                        {
                            <span class="ts-badge ts-badge-success">@Icons.CircleCheckBig(12) On</span>
                        }
                        else
                        {
                            <span class="ts-badge ts-badge-neutral">Off</span>
                        }
                    </dd>
                    <small class="ts-meta">@(Model.PaidExcessEnabled ? "Writes and storage beyond the allowance bill at published rates" : "Chargeable writes stop at the plan allowance")</small>
                </div>
                <div>
                    <dt>@Icons.Gauge(14) Organization spending cap</dt>
                    <dd><span class="ts-kpi-value">@(Model.SpendCap.Length > 0 ? $"${Model.SpendCap}" : "No cap")</span>@(Model.SpendCap.Length > 0 ? " / month" : "")</dd>
                    @if (Model.CapUsedPercent is { } used)
                    {
                        <span class="ts-bar-track" role="img" aria-label="@DashboardStore.FormatPercent(used) of the cap used"><span class="ts-bar-fill" style="width:@(Math.Min(100, Math.Round(used)).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                        <small class="ts-meta">@Model.ExcessSpend excess this period · @DashboardStore.FormatPercent(used) of the cap</small>
                    }
                    else
                    {
                        <small class="ts-meta">@Model.ExcessSpend excess this period · no upper limit set</small>
                    }
                </div>
                <div>
                    <dt>@Icons.Layers(14) Project and database caps</dt>
                    <dd><span class="ts-kpi-value">@(cappedProjects + cappedDatabases)</span> caps set</dd>
                    <small class="ts-meta">@cappedProjects of @Model.CapGroups.Count projects · @cappedDatabases of @Model.CapGroups.Sum(g => g.Databases.Count) databases</small>
                </div>
            </dl>
        </section>

        <div class="ts-columns">
            <section class="ts-usage-section" aria-labelledby="usage-caps-title">
                <div class="ts-section-head">
                    <div>
                        <h2 class="ts-panel-title" id="usage-caps-title">Caps by project and database</h2>
                        <p class="ts-meta">Monthly limits in USD. Blank shares the limit above it; the tightest cap applies.</p>
                    </div>
                    @if (Model.CapGroups.Count > 0)
                    {
                        <button class="ts-btn ts-btn-primary" type="submit" form="usage-caps-form">@Icons.Save(16) Save caps</button>
                    }
                </div>
                @if (Model.CapGroups.Count is 0)
                {
                    @EmptyState("No projects yet", "Create a project to set a monthly cap for it and its databases.")
                }
                else
                {
                    <form id="usage-caps-form" method="post" action="/api/v1/dashboard/usage/spending-controls" class="ts-table-wrap">
                        <table class="ts-table ts-usage-caps">
                            <thead>
                                <tr>
                                    <th>Project / database</th>
                                    <th>Monthly cap</th>
                                    <th>Applied limit</th>
                                </tr>
                            </thead>
                            @foreach (var group in Model.CapGroups)
                            {
                                <tbody>
                                    @CapRow(group.Project, "projCap_", "FolderKanban")
                                    @foreach (var database in group.Databases)
                                    {
                                        @CapRow(database, "dbCap_", "Database")
                                    }
                                </tbody>
                            }
                        </table>
                    </form>
                }
            </section>

            <section class="ts-usage-section ts-aside" aria-labelledby="usage-limits-title">
                <div>
                    <h2 class="ts-panel-title" id="usage-limits-title">Plan limits and rates</h2>
                    <p class="ts-meta">@Model.PlanName plan, organization-wide</p>
                </div>
                <dl class="ts-settings-list">
                    @foreach (var row in Model.PlanResources)
                    {
                        <div><dt>Included @row.Resource.ToLowerInvariant()</dt><dd>@row.Included</dd></div>
                    }
                    <div><dt>Excess writes</dt><dd>$1 / million</dd></div>
                    <div><dt>Excess storage</dt><dd>$0.20 / GB-month</dd></div>
                    <div><dt>History retention</dt><dd>@Model.RetentionDays days</dd></div>
                </dl>
            </section>
        </div>

        <dialog class="ts-dialog" id="spending-controls-dialog" @(saveError is not null ? "data-autoopen" : null)>
            <div class="ts-dialog-content">
                <div class="ts-dialog-header">
                    <h3 class="ts-dialog-title">Edit spending controls</h3>
                    <p class="ts-dialog-description">Paid excess consent and the organization cap</p>
                </div>
                @if (saveError is not null)
                {
                    <div class="ts-alert ts-alert-danger" role="alert"><span class="ts-alert-title">@Icons.CircleAlert(16) @saveError</span></div>
                }
                <form method="post" action="/api/v1/dashboard/usage/spending-controls" class="ts-stack-md">
                    <p class="ts-meta ts-usage-disclosure">Databases and branches share organization allowances and the billing anniversary. Selected Regions multiply writes and storage before allowances. Paid excess costs $1 per million write units and $0.20 per GB-month. A spending cap stops chargeable writes; subscription and retained storage costs continue and can exceed the cap. Reads and exports remain available. Document deletes require paid write access when writes are restricted. Revoking consent stops new paid writes and does not erase outstanding charges or existing storage obligations.</p>
                    <label class="ts-checkbox-row">
                        <input class="ts-checkbox" type="checkbox" name="paidExcess" value="true" checked="@(Model.PaidExcessEnabled ? "checked" : null)" />
                        I authorize paid excess at these rates and accept continuing storage costs.
                    </label>
                    <div class="ts-field">
                        <label class="ts-label" for="spendCap">Monthly organization spending cap in USD (blank means no cap)</label>
                        <input class="ts-input" id="spendCap" name="spendCap" inputmode="decimal" value="@Model.SpendCap" placeholder="" />
                    </div>
                    <p class="ts-meta">Lower caps for single projects and databases are set in the caps table.</p>
                    <div class="ts-dialog-footer">
                        <button type="button" class="ts-btn ts-btn-ghost" data-close-dialog>Cancel</button>
                        <button class="ts-btn ts-btn-primary" type="submit">Save spending controls</button>
                    </div>
                </form>
            </div>
        </dialog>
    }
</div>
@ShellHtml.Bottom(shell)

@functions {
    private static Microsoft.AspNetCore.Html.HtmlString IconByName(string name, int size) =>
        (typeof(Icons).GetMethod(name)?.Invoke(null, [size]) as Microsoft.AspNetCore.Html.HtmlString) ?? Icons.Circle(size);

    private static string Share(long total, long part) =>
        (total <= 0 ? 0 : Math.Round((double)part / total * 100)).ToString(System.Globalization.CultureInfo.InvariantCulture);

    // Flat stat row: icon + label, value, muted detail; hairline dividers, no box.
    private static Microsoft.AspNetCore.Html.HtmlString StatList(IReadOnlyList<UsageStatCard> stats) => new(
        "<dl class=\"ts-stats\">" + string.Concat(stats.Select(s =>
            $"<div><dt>{IconByName(s.Icon, 14).Value} {E(s.Label)}</dt><dd>{E(s.Value)}</dd><small class=\"ts-meta\">{E(s.Detail)}</small></div>")) + "</dl>");

    // House filter menu (api-keys ts-filter-field): picking an option sets the
    // hidden input and submits the GET form (terrascale.js [data-filter-value]).
    private static Microsoft.AspNetCore.Html.HtmlString FilterMenu(string name, string label, string value, string? allLabel, IReadOnlyList<(string Id, string Name)> options)
    {
        var current = options.FirstOrDefault(o => o.Id == value).Name ?? allLabel ?? "";
        var items = new System.Text.StringBuilder();
        if (allLabel is not null)
        {
            items.Append($"<button class=\"ts-menu-item\" type=\"button\" data-filter-value=\"\"{(value.Length is 0 ? " aria-current=\"true\"" : "")}>{E(allLabel)}</button>");
        }

        foreach (var (id, text) in options)
        {
            items.Append($"<button class=\"ts-menu-item\" type=\"button\" data-filter-value=\"{E(id)}\"{(id == value ? " aria-current=\"true\"" : "")}>{E(text)}</button>");
        }

        return new(
            $"<div class=\"ts-filter-field\"><span class=\"ts-filter-label ts-sr-only\" id=\"usage-{name}-label\">{label}</span>"
            + $"<input type=\"hidden\" name=\"{name}\" value=\"{E(value)}\" />"
            + $"<details class=\"ts-menu ts-filter-menu\"><summary class=\"ts-select ts-filter-select ts-filter-trigger\" aria-labelledby=\"usage-{name}-label usage-{name}-value\"><span id=\"usage-{name}-value\">{E(current)}</span></summary>"
            + $"<div class=\"ts-menu-panel\">{items}</div></details></div>");
    }

    private static string E(string value) => System.Net.WebUtility.HtmlEncode(value);

    // Caps table row: name + detail, a "$" cap input (blank = no own cap), applied limit.
    private static Microsoft.AspNetCore.Html.HtmlString CapRow(UsageCapRow row, string prefix, string icon)
    {
        var id = E(prefix + row.Id);
        var kind = prefix is "projCap_" ? "ts-usage-cap-project" : "ts-usage-cap-database";
        return new(
            $"<tr class=\"{kind}\"><td><span class=\"ts-usage-cap-name\">{IconByName(icon, 14).Value}<span><label class=\"ts-table-strong\" for=\"{id}\">{E(row.Name)}</label><small class=\"ts-meta\">{E(row.Detail)}</small></span></span></td>"
            + $"<td><span class=\"ts-usage-cap\"><span aria-hidden=\"true\">$</span><input class=\"ts-input\" id=\"{id}\" name=\"{id}\" inputmode=\"decimal\" pattern=\"\\d+(\\.\\d{{1,2}})?\" value=\"{E(row.Cap)}\" placeholder=\"No cap\" aria-describedby=\"{id}_applied\" /></span></td>"
            + $"<td id=\"{id}_applied\" class=\"ts-muted\">{E(row.Effective)}</td></tr>");
    }

    // v1 EmptyState: SearchX 16px in a 32x32 muted box, title, muted description.
    private static Microsoft.AspNetCore.Html.HtmlString EmptyState(string title, string description) => new(
        $"<div class=\"ts-empty\"><span class=\"ts-empty-icon\">{Icons.SearchX(16).Value}</span><span class=\"ts-empty-title\">{title}</span><span class=\"ts-meta\">{description}</span></div>");
}
