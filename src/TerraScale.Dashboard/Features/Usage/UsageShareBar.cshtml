@inherits RazorSlice<TerraScale.Dashboard.Features.Usage.UsageShare>
<span class="ts-chart-meter" tabindex="0" role="img" aria-label="@(Model.Name + ": " + Model.Percent + " percent of " + Model.Of)"><svg class="ts-svg-sharebar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true"><rect class="ts-svg-sharebar-track" x="0" y="0" width="100" height="8"></rect><rect class="ts-svg-sharebar-fill" x="0" y="0" width="@Math.Clamp(Model.Percent, 0, 100)" height="8"></rect></svg><span class="ts-chart-tooltip" aria-hidden="true"><span class="ts-chart-tooltip-label">@Model.Name</span><strong>@Model.Percent%</strong></span></span>
