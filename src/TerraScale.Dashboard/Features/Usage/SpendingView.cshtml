@inherits RazorSlice<TerraScale.Dashboard.Features.Usage.UsagePage>
@using TerraScale.Dashboard.Features.Usage
@using TerraScale.Dashboard.Features.Billing
@using System.Globalization
@{ var plan = PlanCatalog.For(Model.Selection.Context.Organization!); }
@if (Model.SpendingAlert)
{
    <section class="ts-card" aria-labelledby="organization-controls-title">
        <header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="organization-controls-title">Spending alert</h2></div></header>
        <div class="ts-card-body">
            <form id="spending-controls" class="ts-spending-form" method="post" action="/api/v1/dashboard/usage/spending-cap" data-submit-once>
                <input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
                <fieldset class="ts-spending-control" disabled="@(Model.Shell.Context.CanManage ? null : "disabled")"><legend class="ts-sr-only">Spending alert</legend>@(await RenderPartialAsync<SpendingFieldView, SpendingField>(new("organization-spend-cap", "spendCap", "Monthly alert (USD), usage charges beyond your plan", Model.Spending.OrganizationCapCents <= 0 ? "" : (Model.Spending.OrganizationCapCents / 100m).ToString("F2", CultureInfo.InvariantCulture))))@if (Model.Shell.Context.CanManage) { <button class="ts-btn ts-btn-primary" type="submit">@Icons.Render("Save", 16)<span>Save spending alert</span></button> }</fieldset>
                @if (!Model.Shell.Context.CanManage) { <p class="ts-meta">Only organization owners and admins can change the spending alert.</p> }
            </form>
        </div>
    </section>
}
@if (!Model.SpendingAlert || Model.InternalBill is null)
{
    <section class="ts-card" aria-labelledby="spending-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="spending-title">Spending and overages</h2></div></header><div class="ts-card-body">
    @if (Model.SpendingAlert || plan is { PriceCents: > 0 })
    {
        <p class="ts-meta">Operation units above @plan!.Name's included allowance are billed at @OperationUnitOverage.Rate operation units. Writes stop at @plan.Allowances.MonthlyWriteCap.ToString("N0", CultureInfo.InvariantCulture) units a month.</p>
    }
    else if (plan is { PriceCents: 0 })
    {
        <p class="ts-meta">Free stops new writes at its included operation allowance; reads keep working. No usage charges. Paid plans bill operation units above their included allowance at @OperationUnitOverage.Rate operation units.</p>
    }
    else
    {
        <p class="ts-meta">Paid plans bill operation units above their included allowance at @OperationUnitOverage.Rate operation units. Choose a plan in billing to see its allowances.</p>
    }
    <p class="ts-meta">@(Model.SpendingAlert ? "Customer hard spending caps are unavailable. The alert above watches usage charges beyond the plan: crossing it sends a notice and never blocks writes." : "Customer hard spending caps are unavailable. Paid overage charges have no customer-set spending limit.")</p>
    <div class="ts-spending-links"><a class="ts-link" href="/organization?tab=billing">Manage billing and upgrade</a>@if (Model.Tab != "overview") { <a class="ts-link" href="@Model.ProjectHref(Model.Selection.Context.Project?.Id ?? "")">View plan usage</a> }</div></div></section>
}
