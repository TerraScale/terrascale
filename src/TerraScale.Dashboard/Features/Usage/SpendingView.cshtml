@inherits RazorSlice<TerraScale.Dashboard.Features.Usage.UsagePage>
@using TerraScale.Dashboard.Features.Usage
@inject AssetUrls Assets
<div class="ts-row-between"><div class="ts-stack-sm"><h2 class="ts-section-title">Spending controls</h2><p class="ts-meta">Manage monthly budgets and operation limits across your organization.</p></div><span class="ts-badge ts-badge-info">@Model.PlanName plan</span></div>
@if (Model.InternalBill is not null) { <div class="ts-alert ts-alert-info" role="alert"><p class="ts-alert-title">Report-only spending cap</p><p class="ts-alert-body">Internal caps only report alerts. They never charge Stripe, restrict writes or suspend services.</p></div> }
@if (!Model.Shell.Context.CanManage) { <div class="ts-alert ts-alert-info" role="alert"><p class="ts-alert-title">View-only access</p><p class="ts-alert-body">Only organization owners and admins can change spending controls.</p></div> }
<form id="spending-controls" class="ts-stack-lg ts-spending-form" method="post" action="/api/v1/dashboard/usage/spending-controls" data-submit-once data-signals="@Signals" data-on:invalid__capture="$spendingProject = el.querySelector('input:invalid')?.closest('[data-project-id]')?.dataset.projectId || $spendingProject"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
<section class="ts-card" id="organization-controls" aria-labelledby="organization-controls-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="organization-controls-title">Organization</h2><p class="ts-card-description">Set the monthly budget shared by all projects and databases.</p></div></header><div class="ts-card-body"><fieldset class="ts-stack" disabled="@(Model.Shell.Context.CanManage ? null : "disabled")"><legend class="ts-sr-only">Organization spending limits</legend><div class="ts-row ts-spending-identity">@Icons.Render("Building2", 20)<strong class="ts-break">@Model.Shell.Context.Organization!.Name</strong></div><div class="ts-spending-control">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Usage.SpendingFieldView, SpendingField>(new("organization-spend-cap", "spendCap", "Price limit (USD)", "USD per month", SpendingService.Dollars(Model.Spending.OrganizationCapCents))))</div>@if (Model.InternalBill is null) { <input type="hidden" name="initial_paidExcess" value="@(Model.Spending.PaidExcess ? "true" : "false")" /><label class="ts-row-between ts-spending-excess" for="paid-excess"><span class="ts-stack-sm"><strong>Allow usage beyond included plan resources</strong><span class="ts-hint" id="paid-excess-hint">Additional usage is billed according to your plan.</span></span><input class="ts-switch" id="paid-excess" type="checkbox" role="switch" name="paidExcess" value="true" checked="@(Model.Spending.PaidExcess ? "checked" : null)" aria-describedby="paid-excess-hint" /></label> }</fieldset></div></section>
<section class="ts-card" id="project-controls" aria-labelledby="project-controls-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="project-controls-title">Project</h2><p class="ts-card-description">Choose a project and configure its price and operation limits.</p></div></header><div class="ts-card-body"><div class="ts-field"><label class="ts-label" for="spending-project">Select project</label><div class="ts-spending-control"><select class="ts-select" id="spending-project" name="project" data-bind="spendingProject" disabled="@(Model.Spending.Projects.Count == 0 ? "disabled" : null)">@if (Model.Spending.Projects.Count == 0) { <option value="">No projects yet</option> }@foreach (var project in Model.Spending.Projects) { <option value="@project.Id" selected="@(project.Id == Model.Selection.Context.Project?.Id ? "selected" : null)">@project.Name</option> }</select></div></div>
@foreach (var project in Model.Spending.Projects) { <div class="ts-stack ts-spending-project" data-project-id="@project.Id" hidden="@(project.Id != Model.Selection.Context.Project?.Id ? "hidden" : null)" data-attr:hidden="$spendingProject !== el.dataset.projectId"><fieldset class="ts-stack" disabled="@(Model.Shell.Context.CanManage ? null : "disabled")"><legend class="ts-sr-only">@project.Name project limits</legend>@(await RenderPartialAsync<TerraScale.Dashboard.Features.Usage.SpendingFieldsView, SpendingFields>(new("project", "proj", project.Id, project.CapCents, project.Operations)))</fieldset><p class="ts-hint">Current effective price limit: <strong>@SpendingService.CapLabel(project.EffectiveCapCents)</strong>. The lowest organization or project price limit applies.</p></div> }
</div></section>
<section class="ts-card" id="database-controls" aria-labelledby="database-controls-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="database-controls-title">Databases</h2><p class="ts-card-description">Fine-tune limits for individual databases in the selected project.</p></div></header><div class="ts-card-body">
@if (Model.Spending.Projects.Count == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No databases yet</p><p class="ts-empty-detail">Create a project and database to configure database spending controls.</p></div> }
@foreach (var project in Model.Spending.Projects)
{
    <div class="ts-stack ts-spending-databases" data-project-id="@project.Id" hidden="@(project.Id != Model.Selection.Context.Project?.Id ? "hidden" : null)" data-attr:hidden="$spendingProject !== el.dataset.projectId">@if (project.Databases.Count == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No databases yet</p><p class="ts-empty-detail">Create a database in this project to configure its spending controls.</p><div class="ts-empty-action"><a class="ts-link" href="@("/databases?project=" + Uri.EscapeDataString(project.Id))">View databases</a></div></div> }@foreach (var database in project.Databases) { <fieldset class="ts-spending-database ts-stack" disabled="@(Model.Shell.Context.CanManage ? null : "disabled")"><legend class="ts-sr-only">@database.Name database limits</legend><div class="ts-row-between"><div class="ts-row ts-spending-identity">@Icons.Render("Database", 18)<h3 class="ts-section-title ts-break">@database.Name</h3></div><span class="ts-db-region">@{ var country = Regions.Country(database.Region); }@if (country.Length > 0) { <img class="ts-db-region-flag" src="@Assets.Url("flags/" + country + ".svg")" alt="" aria-hidden="true" /> }<span class="ts-mono">@database.Region.ToLowerInvariant()</span></span></div>@(await RenderPartialAsync<TerraScale.Dashboard.Features.Usage.SpendingFieldsView, SpendingFields>(new("database", "db", database.Id, database.CapCents, database.Operations)))<p class="ts-hint">Current effective price limit: <strong>@SpendingService.CapLabel(database.EffectiveCapCents)</strong>. The lowest organization, project or database price limit applies.</p></fieldset> }</div>
}
</div></section><div class="ts-row-between ts-spending-actions"><p class="ts-hint">Limits reset monthly. Leave a field empty or enter 0 for no limit.</p>@if (Model.Shell.Context.CanManage) { <button class="ts-btn ts-btn-primary" type="submit">@Icons.Render("Save", 16)<span>Save spending controls</span></button> }</div>
</form>
@functions { private string Signals => System.Text.Json.JsonSerializer.Serialize(new { spendingProject = Model.Selection.Context.Project?.Id ?? "" }); }
