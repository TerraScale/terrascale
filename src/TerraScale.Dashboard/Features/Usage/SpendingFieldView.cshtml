@inherits RazorSlice<TerraScale.Dashboard.Features.Usage.SpendingField>
<input type="hidden" name="@("initial_" + Model.Name)" value="@Model.Value" /><div class="ts-field"><label class="ts-label" for="@Model.Id">@Model.Label</label><input class="ts-input ts-mono" id="@Model.Id" name="@Model.Name" type="text" inputmode="decimal" pattern="\d{1,17}(\.\d{1,2})?" maxlength="20" title="A dollar amount with at most two decimal places, such as 250 or 250.50" value="@Model.Value" placeholder="No limit" /></div>
