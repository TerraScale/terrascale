@inherits RazorSlice<TerraScale.Dashboard.Features.Usage.UsagePage>
@using System.Globalization
@inject AssetUrls Assets
@using TerraScale.Dashboard.Shared.Formatting
<section class="ts-card ts-usage-replication" id="replication" aria-labelledby="replication-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="replication-title">Replication</h2><p class="ts-card-description">Per database and region · @Model.Selection.Range · TerraBase replication_bytes meter</p></div><div class="ts-card-actions"><a class="ts-link" href="@("/analytics?database=" + Uri.EscapeDataString(Model.Selection.DatabaseId) + "&project=" + Uri.EscapeDataString(Model.Selection.Context.Project?.Id ?? "") + "&range=" + Model.Selection.Range)">View analytics →</a></div></header><div class="ts-card-body">
@if (Model.Replication.Error.Length > 0) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Replication unavailable</p><p class="ts-alert-body">@Model.Replication.Error</p></div> }
else if (Model.Replication.Regions.Count == 0 && Model.Replication.Pairs.Count == 0) { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("Network", 16)</span><p class="ts-empty-title">@Model.Replication.Empty</p></div> }
else
{
    <dl class="ts-stats" aria-label="Replication totals">@foreach (var stat in new[] { ("Replicated ops", TerraScale.Dashboard.Shared.Charts.ChartGeometry.Compact(Model.Replication.Operations), "Across database regions", Model.Replication.Operations.ToString("N0", CultureInfo.InvariantCulture)), ("Replication sent", MetricFormat.Bytes(Model.Replication.SentBytes), "Metered separately from client bandwidth", ""), ("Replication received", MetricFormat.Bytes(Model.Replication.ReceivedBytes), "Received at destination regions", ""), ("Worst lag", MetricFormat.Latency(Model.Replication.WorstLagMs), "Current maximum across regions", "") }) { <div class="ts-stat"><dt class="ts-stat-label">@stat.Item1</dt><dd class="ts-stat-value" title="@(stat.Item4.Length > 0 ? stat.Item4 : null)">@stat.Item2</dd><dd class="ts-stat-detail">@stat.Item3</dd></div> }</dl>
    @if (Model.Replication.Pairs.Count == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No replication bandwidth samples for this period.</p></div> }
    @if (Model.Replication.Regions.Count > 0) { <h3 class="ts-usage-sub">Health per database and region</h3><div class="ts-table-wrap" role="region" aria-label="Replication health table" tabindex="0"><table class="ts-table"><caption class="ts-sr-only">Replication health per database and region</caption><thead><tr><th>Database</th><th>Region</th><th>Health</th><th class="ts-num">Replicated ops</th><th class="ts-num">Lag</th><th class="ts-num">Divergence</th><th class="ts-num">Convergence time</th><th>Last applied</th></tr></thead><tbody>@foreach (var row in Model.Replication.Regions.OrderBy(item => item.DatabaseName, StringComparer.Ordinal).ThenBy(item => Regions.Rank(item.Region))) { var regionCode = row.Region.ToString().ToLowerInvariant(); var flag = Regions.Country(regionCode); <tr><th scope="row">@row.DatabaseName</th><td><span class="ts-usage-region">@if (flag.Length > 0) { <img class="ts-usage-flag" src="@Assets.Url("flags/" + flag + ".svg")" alt="" aria-hidden="true" /> }<span class="ts-mono">@regionCode</span></span></td><td><span class="ts-badge @(row.Status is "healthy" or "operational" ? "ts-badge-success" : row.Status is "lagging" or "degraded" ? "ts-badge-warning" : row.Status is "diverged" or "stopped" or "down" ? "ts-badge-danger" : "ts-badge-neutral")">@row.Status</span></td><td class="ts-num" title="@row.ReplicatedOps.ToString("N0", CultureInfo.InvariantCulture)">@TerraScale.Dashboard.Shared.Charts.ChartGeometry.Compact(row.ReplicatedOps)</td><td class="ts-num">@MetricFormat.Latency(row.LagMs)</td><td class="ts-num">@(row.Divergence is { } diverged ? diverged ? "Yes" : "No" : "Not reported")</td><td class="ts-num">@MetricFormat.Latency(row.ConvergenceMs)</td><td>@(row.LastApplied?.UtcDateTime.ToString("MMM d, yyyy HH:mm:ss 'UTC'", CultureInfo.InvariantCulture) ?? "Not reported")</td></tr> }</tbody></table></div> }
    @if (Model.Replication.Pairs.Count > 0) { <h3 class="ts-usage-sub">Bandwidth per region pair</h3><div class="ts-table-wrap" role="region" aria-label="Replication bandwidth table" tabindex="0"><table class="ts-table"><caption class="ts-sr-only">Replication bandwidth per ordered region pair</caption><thead><tr><th>Database</th><th>Region pair</th><th class="ts-num">Sent</th><th class="ts-num">Received</th><th>Share of sent</th></tr></thead><tbody>@foreach (var row in Model.Replication.Pairs.OrderBy(item => item.DatabaseName, StringComparer.Ordinal).ThenBy(item => Regions.Rank(item.FromRegion)).ThenBy(item => Regions.Rank(item.ToRegion))) { var fromCode = row.FromRegion.ToString().ToLowerInvariant(); var toCode = row.ToRegion.ToString().ToLowerInvariant(); var fromFlag = Regions.Country(fromCode); var toFlag = Regions.Country(toCode); <tr><th scope="row">@row.DatabaseName</th><td><span class="ts-usage-pair"><span class="ts-usage-region">@if (fromFlag.Length > 0) { <img class="ts-usage-flag" src="@Assets.Url("flags/" + fromFlag + ".svg")" alt="" aria-hidden="true" /> }<span class="ts-mono">@fromCode</span></span>→<span class="ts-usage-region">@if (toFlag.Length > 0) { <img class="ts-usage-flag" src="@Assets.Url("flags/" + toFlag + ".svg")" alt="" aria-hidden="true" /> }<span class="ts-mono">@toCode</span></span></span></td><td class="ts-num">@MetricFormat.Bytes(row.SentBytes)</td><td class="ts-num">@MetricFormat.Bytes(row.ReceivedBytes)</td><td>@(await RenderPartialAsync<TerraScale.Dashboard.Features.Usage.UsageShareBar, TerraScale.Dashboard.Features.Usage.UsageShare>(new(row.DatabaseName + " " + fromCode + " to " + toCode, Model.Replication.SentBytes > 0 ? (int)Math.Clamp(Math.Round(row.SentBytes * 100m / Model.Replication.SentBytes), 0, 100) : 0, "replication sent in this scope")))</td></tr> }</tbody></table></div> }
}

</div></section>
