@inherits RazorSlice<TerraScale.Dashboard.Features.Usage.UsagePage>
@using TerraScale.Dashboard.Features.Usage
@using TerraScale.Dashboard.Shared.Formatting
@using TerraScale.Dashboard.Features.Billing
@using System.Globalization
@inject AssetUrls Assets
@if (Model.InternalBill is { } bill) { @(await RenderPartialAsync<TerraScale.Dashboard.Features.Billing.InternalBillingView, InternalBillingViewModel>(new(bill, PlanCatalog.Limits(Model.Shell.Context.Organization!)))) }
<section class="ts-card" id="usage-allowance" aria-labelledby="usage-allowance-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="usage-allowance-title">Plan allowance</h2><p class="ts-card-description">Use of the @Model.PlanName plan this month</p></div></header><div class="ts-card-body">
@if (Model.WritesPaused.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.WritesPaused</p>@if (Model.Shell.Context.Organization?.CanManage(Model.Shell.Context.UserId) == true) { <a class="ts-link" href="/organization?tab=billing">Upgrade the plan to keep writing now</a> }</div> }
@if (Model.AllowanceError.Length > 0) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-body">@Model.AllowanceError</p></div> }
<div class="ts-usage-gauges">@foreach (var gauge in Model.Allowances)
{
    <div class="ts-usage-gauge"><div class="ts-stack-sm"><span class="ts-stat-label">@gauge.Name</span><span class="ts-usage-gauge-value" title="@gauge.ExactUsed">@gauge.Used</span><span class="ts-meta" title="@gauge.ExactAllowance">@gauge.Allowance</span></div>@if (gauge.Percent is { } percent) { <span class="ts-chart-meter ts-usage-allowance-meter" data-state="@gauge.Tone" tabindex="0" role="img" aria-label="@gauge.Label"><svg class="ts-svg-sharebar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true"><rect class="ts-svg-sharebar-track" width="100" height="8"></rect><rect class="ts-svg-sharebar-fill" width="@Math.Clamp(percent, 0, 100).ToString("0.###", CultureInfo.InvariantCulture)" height="8"></rect></svg><span class="ts-chart-tooltip" aria-hidden="true"><span class="ts-chart-tooltip-label">@gauge.Name</span><strong>@ValueFormat.PercentLabel(percent)</strong></span></span> }</div>
}</div><p class="ts-meta">@Model.PlanUsageNote</p></div></section>
<section class="ts-card" id="usage-history" aria-labelledby="usage-history-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="usage-history-title">Reads and writes</h2><p class="ts-card-description">@Model.HistoryDescription</p></div><div class="ts-card-actions"><nav class="ts-segmented" aria-label="Reads and writes period">@foreach (var range in new[] { "1h", "24h", "7d", "30d" }) { <a class="ts-segment" href="@("/usage?tab=overview&project=" + Uri.EscapeDataString(Model.Selection.Context.Project?.Id ?? "") + "&database=" + Uri.EscapeDataString(Model.Selection.DatabaseId) + "&range=" + range)" aria-current="@(Model.Selection.Range == range ? "page" : null)">@range</a> }</nav></div>@if (Model.Scope is { } total) { <div class="ts-card-actions"><dl class="ts-usage-figures" aria-label="Totals for this range">@foreach (var counter in new[] { ("Reads", total.Period.Reads, "ts-cat-1"), ("Writes", total.Period.Writes, "ts-cat-2") }) { <div><dt><span class="ts-chart-swatch @counter.Item3"></span>@counter.Item1</dt><dd title="@counter.Item2.ToString("N0", CultureInfo.InvariantCulture)">@TerraScale.Dashboard.Shared.Charts.ChartGeometry.Compact(counter.Item2)</dd></div> }</dl></div> }</header><div class="ts-card-body">@if (Model.History is { } history) { <div class="ts-chart-shell" role="region" aria-label="Reads and writes chart." tabindex="0">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Analytics.AnalyticsLineView, TerraScale.Dashboard.Features.Analytics.AnalyticsLinePlot>(history))</div> } else if (Model.Scope is { Series.Count: 0 }) { <div class="ts-empty" role="status"><p class="ts-empty-title">No activity yet</p><p class="ts-empty-detail">Create a database to start measuring reads and writes.</p></div> } else { <div class="ts-empty" role="status"><p class="ts-empty-title">Reads and writes are not metered here.</p><p class="ts-empty-detail">@Model.UsageSource</p></div> }</div></section>
<section class="ts-card" id="usage-by-project" aria-labelledby="usage-by-project-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="usage-by-project-title">@(Model.Selection.ExplicitProjectFilter ? "By database" : "By project")</h2><p class="ts-card-description">@(Model.Selection.ExplicitProjectFilter ? "Logical storage in the selected project and database scope" : "Logical storage across this organization")</p></div></header><div class="ts-card-body">
@if (Model.Selection.ExplicitProjectFilter && !Model.ScopeStorageMeasured || !Model.Selection.ExplicitProjectFilter && !Model.OrganizationStorageMeasured) { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("HardDrive", 16)</span><p class="ts-empty-title">Storage isn't measured here.</p><p class="ts-empty-detail">@Model.UsageSource</p></div> }
else if (Model.Selection.ExplicitProjectFilter && Model.Databases.Count > 0)
{
    <ul class="ts-usage-share">@foreach (var database in Model.Databases) { <li><div class="ts-row-between"><span class="ts-strong">@database.Spending.Name</span><span class="ts-mono">@(database.LogicalBytes is { } databaseShareBytes ? MetricFormat.Bytes(databaseShareBytes) : "Unavailable")</span></div>@if (database.SharePercent is { } databaseShare) { @(await RenderPartialAsync<TerraScale.Dashboard.Features.Usage.UsageShareBar, TerraScale.Dashboard.Features.Usage.UsageShare>(new(database.Spending.Name, databaseShare, "logical storage in this scope"))) }<span class="ts-meta" title="@database.Documents?.ToString("N0", CultureInfo.InvariantCulture)">@(database.Documents is { } shareDocuments ? ValueFormat.Plural(shareDocuments, "document", number: TerraScale.Dashboard.Shared.Charts.ChartGeometry.Compact(shareDocuments)) : "Unavailable documents")</span></li> }</ul>
}
else if (Model.Selection.ExplicitProjectFilter) { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("Database", 16)</span><p class="ts-empty-title">No databases match this project filter.</p></div> }
@if (!Model.Selection.ExplicitProjectFilter && Model.Projects.Count > 0)
{
    <ul class="ts-usage-share">@foreach (var project in Model.Projects) { <li><div class="ts-row-between"><a class="ts-strong" href="@Model.ProjectHref(project.Spending.Id)" aria-current="@(project.Selected ? "page" : null)">@project.Spending.Name</a><span class="ts-mono">@(project.LogicalBytes is { } projectShareBytes ? MetricFormat.Bytes(projectShareBytes) : "Unavailable")</span></div>@if (project.SharePercent is { } projectShare) { @(await RenderPartialAsync<TerraScale.Dashboard.Features.Usage.UsageShareBar, TerraScale.Dashboard.Features.Usage.UsageShare>(new(project.Spending.Name, projectShare, "logical storage in this organization"))) }<span class="ts-meta">@ValueFormat.Plural(project.Spending.Databases.Count, "database") · Region: @if (project.Spending.Region.Length > 0) { var country = Regions.Country(project.Spending.Region); <span class="ts-db-region">@if (country.Length > 0) { <img class="ts-db-region-flag" src="@Assets.Url("flags/" + country + ".svg")" alt="" aria-hidden="true" /> }<span class="ts-mono">@project.Spending.Region.ToLowerInvariant()</span></span> } else { <span>Not configured</span> }</span></li> }</ul>
}
else if (!Model.Selection.ExplicitProjectFilter) { <div class="ts-empty" role="status"><p class="ts-empty-title">No projects are saved in this organization.</p></div> }
</div></section>
<section class="ts-card" id="usage-summary" aria-labelledby="usage-summary-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="usage-summary-title">Project usage summary</h2><p class="ts-card-description">@Model.UsageSource</p></div></header><div class="ts-card-body">@if (Model.UsageError.Length > 0) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-body">@Model.UsageError</p></div> }<dl class="ts-stats" aria-label="Project usage summary"><div class="ts-stat"><dt class="ts-stat-label">Databases in project</dt><dd class="ts-stat-value">@Model.ActiveDatabases</dd></div><div class="ts-stat"><dt class="ts-stat-label">Regions in project</dt><dd class="ts-stat-value">@Model.RegionCountLabel</dd></div>@if (Model.Scope is { } scope) { @foreach (var stat in new[] { ("Reads", TerraScale.Dashboard.Shared.Charts.ChartGeometry.Compact(scope.Period.Reads), scope.Period.Reads.ToString("N0", CultureInfo.InvariantCulture), Model.Selection.RangeLabel), ("Writes", TerraScale.Dashboard.Shared.Charts.ChartGeometry.Compact(scope.Period.Writes), scope.Period.Writes.ToString("N0", CultureInfo.InvariantCulture), Model.Selection.RangeLabel) }) { <div class="ts-stat"><dt class="ts-stat-label">@stat.Item1</dt><dd class="ts-stat-value" title="@stat.Item3">@stat.Item2</dd><dd class="ts-stat-detail">@stat.Item4</dd></div> } }@if (Model.ScopeLogicalBytes is { } summaryStorageBytes) { <div class="ts-stat"><dt class="ts-stat-label">Logical storage</dt><dd class="ts-stat-value">@MetricFormat.Bytes(summaryStorageBytes)</dd><dd class="ts-stat-detail">Live document bytes</dd></div> }</dl></div></section>
<section class="ts-card ts-card-flush" id="database-usage" aria-labelledby="database-usage-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="database-usage-title">Project databases</h2><p class="ts-card-description">Reads and writes @(char.ToLowerInvariant(Model.Selection.RangeLabel[0]) + Model.Selection.RangeLabel[1..]) and storage</p></div></header><div class="ts-card-body">
@if (Model.Databases.Count > 0) { <div class="ts-table-wrap" tabindex="0" role="region" aria-label="Project databases table. Scroll horizontally to see all columns."><table class="ts-table"><caption class="ts-sr-only">Databases in the selected project with their reads, writes and storage</caption><thead><tr><th scope="col">Database</th><th scope="col">Region</th><th scope="col">Status</th><th scope="col" class="ts-num">Reads</th><th scope="col" class="ts-num">Writes</th><th scope="col" class="ts-num">Documents</th><th scope="col" class="ts-num">Logical storage</th></tr></thead><tbody>@foreach (var database in Model.Databases)
{
    <tr><td class="ts-table-strong">@database.Spending.Name</td><td>@if (database.Spending.Region.Length > 0) { var country = Regions.Country(database.Spending.Region); <span class="ts-db-region">@if (country.Length > 0) { <img class="ts-db-region-flag" src="@Assets.Url("flags/" + country + ".svg")" alt="" aria-hidden="true" /> }<span class="ts-mono">@database.Spending.Region.ToLowerInvariant()</span></span> } else { <span class="ts-meta">Not configured</span> }</td><td><span class="ts-badge @(database.Status is "ready" or "active" or "Ready" or "Active" ? "ts-badge-success" : database.Status.Length == 0 ? "ts-badge-neutral" : "ts-badge-info")">@database.Status</span></td>@if (database.Reading is { } reading) { <td class="ts-num" title="@reading.Period.Reads.ToString("N0", CultureInfo.InvariantCulture)">@TerraScale.Dashboard.Shared.Charts.ChartGeometry.Compact(reading.Period.Reads)</td><td class="ts-num" title="@reading.Period.Writes.ToString("N0", CultureInfo.InvariantCulture)">@TerraScale.Dashboard.Shared.Charts.ChartGeometry.Compact(reading.Period.Writes)</td> } else { <td class="ts-num ts-meta">Not metered</td><td class="ts-num ts-meta">Not metered</td> }<td class="ts-num @(database.Documents is null ? "ts-meta" : "")" title="@database.Documents?.ToString("N0", CultureInfo.InvariantCulture)">@(database.Documents is { } documents ? TerraScale.Dashboard.Shared.Charts.ChartGeometry.Compact(documents) : "Not measured")</td><td class="ts-num @(database.LogicalBytes is null ? "ts-meta" : "")">@(database.LogicalBytes is { } tableStorageBytes ? MetricFormat.Bytes(tableStorageBytes) : "Not measured")</td></tr>
}</tbody></table></div> } else { <div class="ts-empty" role="status"><p class="ts-empty-title">No databases match this project filter.</p></div> }
</div></section>
