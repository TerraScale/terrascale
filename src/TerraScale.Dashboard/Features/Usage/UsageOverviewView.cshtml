@inherits RazorSlice<TerraScale.Dashboard.Features.Usage.UsagePage>
@using TerraScale.Dashboard.Features.Usage
@using TerraScale.Dashboard.Features.Billing
@using System.Globalization
@if (Model.InternalBill is { } bill) { @(await RenderPartialAsync<TerraScale.Dashboard.Features.Billing.InternalBillingView, InternalBill>(bill)) }
<section class="ts-card" id="usage-allowance" aria-labelledby="usage-allowance-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="usage-allowance-title">Plan allowance</h2><p class="ts-card-description">Use of the @Model.PlanName plan this month</p></div></header><div class="ts-card-body">
@if (Model.AllowanceError.Length > 0) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-body">@Model.AllowanceError</p></div> }
<div class="ts-usage-gauges">@foreach (var gauge in Model.Allowances)
{
    <div class="ts-usage-gauge">@if (gauge.Percent is { } percent) { <div class="ts-usage-ring"><span class="ts-chart-meter" tabindex="0" role="img" aria-label="@gauge.Label"><svg class="ts-ring ts-ring-@gauge.Tone" viewBox="0 0 120 120" aria-hidden="true"><circle class="ts-ring-track" cx="60" cy="60" r="52" pathLength="100"></circle><circle class="ts-ring-fill" cx="60" cy="60" r="52" pathLength="100" stroke-dasharray="@(Math.Clamp(percent, 0, 100) + " 100")"></circle></svg><span class="ts-chart-tooltip" aria-hidden="true"><span class="ts-chart-tooltip-label">@gauge.Name</span><strong>@percent%</strong></span></span><span class="ts-usage-ring-value"><strong>@percent%</strong><small>used</small></span></div> }<div class="ts-stack-sm"><span class="ts-stat-label">@gauge.Name</span><span class="ts-usage-gauge-value">@gauge.Used</span><span class="ts-meta">@gauge.Allowance</span></div></div>
}</div><p class="ts-meta">@Model.PlanUsageNote</p></div></section>
<div class="ts-split"><section class="ts-card" id="usage-history" aria-labelledby="usage-history-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="usage-history-title">Reads and writes</h2><p class="ts-card-description">@Model.HistoryDescription</p></div>@if (Model.Scope is { } total) { <div class="ts-card-actions"><dl class="ts-usage-figures" aria-label="Totals for this range">@foreach (var counter in new[] { ("Reads", total.Period.Reads, "ts-cat-1"), ("Writes", total.Period.Writes, "ts-cat-2") }) { <div><dt><span class="ts-chart-swatch @counter.Item3"></span>@counter.Item1</dt><dd>@counter.Item2</dd></div> }</dl></div> }</header><div class="ts-card-body">@if (Model.History is { } history) { <div class="ts-chart-shell ts-usage-chart-shell" role="region" aria-label="Reads and writes chart. Scroll horizontally for the full plot." tabindex="0">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Analytics.AnalyticsLineView, TerraScale.Dashboard.Features.Analytics.AnalyticsLinePlot>(history))</div> } else { <div class="ts-empty" role="status"><p class="ts-empty-title">Reads and writes are not metered here.</p><p class="ts-empty-detail">@Model.UsageSource</p></div> }</div></section>
<section class="ts-card" id="usage-by-project" aria-labelledby="usage-by-project-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="usage-by-project-title">@(Model.Selection.ExplicitProjectFilter ? "By database" : "By project")</h2><p class="ts-card-description">@(Model.Selection.ExplicitProjectFilter ? "Logical storage in the selected project and database scope" : "Logical storage across this organization")</p></div></header><div class="ts-card-body">
@if (Model.Selection.ExplicitProjectFilter && !Model.ScopeStorageMeasured || !Model.Selection.ExplicitProjectFilter && !Model.OrganizationStorageMeasured) { <div class="ts-empty" role="status"><p class="ts-empty-title">Storage isn't measured here.</p><p class="ts-empty-detail">@Model.UsageSource</p></div> }
else if (Model.Selection.ExplicitProjectFilter && Model.Databases.Count > 0)
{
    <ul class="ts-usage-share">@foreach (var database in Model.Databases) { <li><div class="ts-row-between"><span class="ts-strong">@database.Spending.Name</span><span class="ts-mono">@(database.LogicalBytes is { } databaseShareBytes ? UsageFormat.Bytes(databaseShareBytes) : "Unavailable")</span></div>@(await RenderPartialAsync<TerraScale.Dashboard.Features.Usage.UsageShareBar, TerraScale.Dashboard.Features.Usage.UsageShare>(new(database.Spending.Name, database.SharePercent, "logical storage in this scope")))<span class="ts-meta">@(database.Documents?.ToString(CultureInfo.InvariantCulture) ?? "Unavailable") documents</span></li> }</ul>
}
else if (Model.Selection.ExplicitProjectFilter) { <div class="ts-empty" role="status"><p class="ts-empty-title">No databases match this project filter.</p></div> }
else if (Model.Projects.Count > 0)
{
    <ul class="ts-usage-share">@foreach (var project in Model.Projects) { <li><div class="ts-row-between"><a class="ts-strong" href="@Model.ProjectHref(project.Spending.Id)" aria-current="@(project.Selected ? "page" : null)">@project.Spending.Name</a><span class="ts-mono">@(project.LogicalBytes is { } projectShareBytes ? UsageFormat.Bytes(projectShareBytes) : "Unavailable")</span></div>@(await RenderPartialAsync<TerraScale.Dashboard.Features.Usage.UsageShareBar, TerraScale.Dashboard.Features.Usage.UsageShare>(new(project.Spending.Name, project.SharePercent, "logical storage in this organization")))<span class="ts-meta">@project.Spending.Databases.Count databases · Region: @(project.Spending.Region.Length > 0 ? project.Spending.Region : "Not configured") · Effective spending cap: @SpendingService.CapLabel(project.Spending.EffectiveCapCents)</span></li> }</ul>
}
else { <div class="ts-empty" role="status"><p class="ts-empty-title">No projects are saved in this organization.</p></div> }
</div></section></div>
<section class="ts-card" id="usage-summary" aria-labelledby="usage-summary-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="usage-summary-title">Project usage summary</h2><p class="ts-card-description">@Model.UsageSource</p></div></header><div class="ts-card-body">@if (Model.UsageError.Length > 0) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-body">@Model.UsageError</p></div> }<dl class="ts-stats" aria-label="Project usage summary"><div class="ts-stat"><dt class="ts-stat-label">Databases in project</dt><dd class="ts-stat-value">@Model.ActiveDatabases</dd></div><div class="ts-stat"><dt class="ts-stat-label">Regions in project</dt><dd class="ts-stat-value">@Model.RegionCount</dd></div>@if (Model.Scope is { } scope) { @foreach (var stat in new[] { ("Reads", scope.Period.Reads.ToString("N0", CultureInfo.InvariantCulture), Model.Selection.RangeLabel), ("Writes", scope.Period.Writes.ToString("N0", CultureInfo.InvariantCulture), Model.Selection.RangeLabel) }) { <div class="ts-stat"><dt class="ts-stat-label">@stat.Item1</dt><dd class="ts-stat-value">@stat.Item2</dd><dd class="ts-stat-detail">@stat.Item3</dd></div> } }@if (Model.ScopeLogicalBytes is { } summaryStorageBytes) { <div class="ts-stat"><dt class="ts-stat-label">Logical storage</dt><dd class="ts-stat-value">@UsageFormat.Bytes(summaryStorageBytes)</dd><dd class="ts-stat-detail">Live document bytes</dd></div> }</dl></div></section>
<section class="ts-card ts-card-flush" id="database-usage" aria-labelledby="database-usage-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="database-usage-title">Project databases</h2><p class="ts-card-description">Reads and writes @(char.ToLowerInvariant(Model.Selection.RangeLabel[0]) + Model.Selection.RangeLabel[1..]), storage, and spending limits</p></div></header><div class="ts-card-body">
@if (Model.Databases.Count > 0) { <div class="ts-table-wrap" tabindex="0" role="region" aria-label="Project databases table. Scroll horizontally to see all columns."><table class="ts-table"><caption class="ts-sr-only">Databases in the selected project with their reads, writes, storage, and spending limits</caption><thead><tr><th scope="col">Database</th><th scope="col">Region</th><th scope="col">Status</th><th scope="col" class="ts-num">Reads</th><th scope="col" class="ts-num">Writes</th><th scope="col" class="ts-num">Documents</th><th scope="col" class="ts-num">Logical storage</th><th scope="col">Spend cap</th><th scope="col">Effective limit</th></tr></thead><tbody>@foreach (var database in Model.Databases)
{
    <tr><td class="ts-table-strong">@database.Spending.Name</td><td>@database.Spending.Region</td><td><span class="ts-badge @(database.Status is "ready" or "active" or "Ready" or "Active" ? "ts-badge-success" : database.Status.Length == 0 ? "ts-badge-neutral" : "ts-badge-info")">@database.Status</span></td>@if (database.Reading is { } reading) { <td class="ts-num">@reading.Period.Reads.ToString("N0", CultureInfo.InvariantCulture)</td><td class="ts-num">@reading.Period.Writes.ToString("N0", CultureInfo.InvariantCulture)</td> } else { <td class="ts-num ts-meta">Not metered</td><td class="ts-num ts-meta">Not metered</td> }<td class="ts-num @(database.Documents is null ? "ts-meta" : "")">@(database.Documents?.ToString(CultureInfo.InvariantCulture) ?? "Not measured")</td><td class="ts-num @(database.LogicalBytes is null ? "ts-meta" : "")">@(database.LogicalBytes is { } tableStorageBytes ? UsageFormat.Bytes(tableStorageBytes) : "Not measured")</td><td>@if (database.Spending.CapCents > 0) { @("$" + SpendingService.Dollars(database.Spending.CapCents)) } else { <span class="ts-meta">No database cap</span> }</td><td>@SpendingService.CapLabel(database.Spending.EffectiveCapCents)</td></tr>
}</tbody></table></div> } else { <div class="ts-empty" role="status"><p class="ts-empty-title">No databases match this project filter.</p></div> }
</div></section>
