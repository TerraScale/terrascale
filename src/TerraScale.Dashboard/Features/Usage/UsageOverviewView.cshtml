@inherits RazorSlice<TerraScale.Dashboard.Features.Usage.UsagePage>
@using TerraScale.Dashboard.Features.Usage
@using TerraScale.Dashboard.Features.Billing
@using TerraScale.Dashboard.Common.Charts
@using System.Globalization
@inject AssetUrls Assets
@if (Model.Selection.Member)
{
@if (Model.InternalBill is { } bill) { @(await RenderPartialAsync<InternalBillingView, InternalBillingViewModel>(new(bill, PlanCatalog.Limits(Model.Shell.Context.Organization!)))) }
<section class="ts-card" id="usage-allowance" aria-labelledby="usage-allowance-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="usage-allowance-title">@Model.PlanName plan allowance</h2></div></header><div class="ts-card-body">
@if (Model.WritesPaused.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.WritesPaused</p>@if (Model.Shell.Context.Organization?.CanManage(Model.Shell.Context.UserId) == true) { <a class="ts-link" href="/organization?tab=billing">Upgrade the plan to keep writing now</a> }</div> }
@if (Model.AllowanceError.Length > 0) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-body">@Model.AllowanceError</p></div> }
<dl class="ts-usage-meters">@foreach (var gauge in Model.Allowances)
{
    <div class="ts-usage-meter">
        <dt class="ts-stat-label">@gauge.Name</dt>
        <dd class="ts-usage-meter-figure"><span class="ts-usage-meter-value" data-measured="@(gauge.Measured ? "true" : "false")" title="@gauge.ExactUsed">@gauge.Used.Value<span class="ts-usage-unit">@gauge.Used.Unit</span></span><span class="ts-usage-meter-limit" title="@gauge.ExactAllowance">@(gauge.Percent is null ? "" : "of ")@gauge.Allowance</span>@if (gauge.Percent is { } share) { <span class="ts-usage-meter-percent">@ValueFormat.PercentLabel(share)</span> }</dd>
        <dd class="ts-usage-meter-bar">@if (gauge.Percent is not null) { <span class="ts-chart-meter ts-usage-allowance-meter" data-state="@gauge.Tone" tabindex="0" role="img" aria-label="@gauge.Label"><svg class="ts-svg-sharebar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true"><rect class="ts-svg-sharebar-track" width="100" height="8"></rect><rect class="ts-svg-sharebar-fill" width="@gauge.Fill.ToString("0.###", CultureInfo.InvariantCulture)" height="8"></rect></svg><span class="ts-chart-tooltip" aria-hidden="true"><strong>@(gauge.ExactUsed ?? gauge.Used.Value + " " + gauge.Used.Unit) of @(gauge.ExactAllowance ?? gauge.Allowance)</strong></span></span> }</dd>
    </div>
}</dl></div></section>
}
<section class="ts-card" id="usage-history" aria-labelledby="usage-history-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="usage-history-title">Reads and writes</h2>@if (Model.Scope is { } window) { <p class="ts-meta" id="usage-period"><time datetime="@window.Period.From.ToString("O", CultureInfo.InvariantCulture)">@ValueFormat.UtcDate(window.Period.From)</time> – <time datetime="@window.Period.To.ToString("O", CultureInfo.InvariantCulture)">@ValueFormat.UtcDate(window.Period.To)</time></p> }</div>@if (Model.Scope is { } total) { <div class="ts-card-actions"><dl class="ts-usage-figures" aria-label="Totals for this range">@foreach (var counter in new[] { ("Reads", total.Period.Reads, "ts-cat-1"), ("Writes", total.Period.Writes, "ts-cat-2") }) { <div><dt><span class="ts-chart-swatch @counter.Item3"></span>@counter.Item1</dt><dd title="@counter.Item2.ToString("N0", CultureInfo.InvariantCulture)">@ChartGeometry.Compact(counter.Item2)</dd></div> }</dl></div> }</header><div class="ts-card-body">@if (Model.History is { } history) { <div class="ts-chart-shell" role="region" aria-label="Reads and writes chart." tabindex="0"><div class="ts-skeleton ts-skeleton-chart" aria-hidden="true" hidden data-attr:hidden="!$_navPending"></div><div data-show="!$_navPending">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Analytics.AnalyticsLineView, TerraScale.Dashboard.Features.Analytics.AnalyticsLinePlot>(history))</div></div> } else if (Model.Scope is { Series.Count: 0 }) { <div class="ts-empty" role="status"><p class="ts-empty-title">No activity yet.</p><a class="ts-btn ts-btn-secondary" href="/databases">Create a database</a></div> } else { <div class="ts-empty" role="status"><p class="ts-empty-title">@Model.UsageSource</p></div> }</div></section>
<section class="ts-card" id="usage-by-project" aria-labelledby="usage-by-project-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="usage-by-project-title">@(Model.Selection.ExplicitProjectFilter ? "By database" : "By project")</h2></div></header><div class="ts-card-body">
@if (Model.Selection.ExplicitProjectFilter && !Model.ScopeStorageMeasured || !Model.Selection.ExplicitProjectFilter && !Model.OrganizationStorageMeasured) { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("HardDrive", 16)</span><p class="ts-empty-title">Storage isn't measured here.</p></div> }
else if (Model.Selection.ExplicitProjectFilter && Model.Databases.Count > 0)
{
    <ul class="ts-usage-share">@foreach (var database in Model.Databases) { <li><span class="ts-usage-share-name"><span class="ts-strong">@database.Spending.Name</span></span>@{ Share(database.Spending.Name, database.SharePercent, database.LogicalBytes, "logical storage in this scope"); }</li> }</ul>
}
else if (Model.Selection.ExplicitProjectFilter && Model.ActiveDatabases == 0) { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("Database", 16)</span><p class="ts-empty-title">No databases yet.</p><a class="ts-btn ts-btn-primary" href="/databases?create=1">New database</a></div> }
else if (Model.Selection.ExplicitProjectFilter) { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("Database", 16)</span><p class="ts-empty-title">No databases match this project filter.</p><a class="ts-btn ts-btn-secondary" href="@("/usage?tab=overview&range=" + Uri.EscapeDataString(Model.Selection.Range))">Clear filter</a></div> }
@if (!Model.Selection.ExplicitProjectFilter && Model.Projects.Count > 0)
{
    <ul class="ts-usage-share">@foreach (var project in Model.Projects) { <li><span class="ts-usage-share-name"><a class="ts-strong" href="@Model.ProjectHref(project.Spending.Id)" aria-current="@(project.Selected ? "page" : null)">@project.Spending.Name</a><span class="ts-meta">@ValueFormat.Plural(project.Spending.Databases.Count, "database") · Region: @if (project.Spending.Region.Length > 0) { var country = Regions.Country(project.Spending.Region); <span class="ts-db-region">@if (country.Length > 0) { <img class="ts-db-region-flag" src="@Assets.Url("flags/" + country + ".svg")" alt="" aria-hidden="true" /> }<span class="ts-mono">@project.Spending.Region.ToLowerInvariant()</span></span> } else { <span>Not configured</span> }</span></span>@{ Share(project.Spending.Name, project.SharePercent, project.LogicalBytes, "logical storage in this organization"); }</li> }</ul>
}
else if (!Model.Selection.ExplicitProjectFilter) { <div class="ts-empty" role="status"><p class="ts-empty-title">No projects are saved in this organization.</p><a class="ts-btn ts-btn-secondary" href="/organization?tab=projects">Create a project</a></div> }
</div></section>
<section class="ts-card" id="usage-summary" aria-labelledby="usage-summary-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="usage-summary-title">Project usage summary</h2></div></header><div class="ts-card-body">@if (Model.UsageError.Length > 0) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-body">@Model.UsageError</p></div> }<dl class="ts-stats ts-usage-summary" aria-label="Project usage summary"><div class="ts-stat"><dt class="ts-stat-label">Databases</dt><dd class="ts-stat-value">@Model.ActiveDatabases.ToString("N0", CultureInfo.InvariantCulture)</dd></div><div class="ts-stat"><dt class="ts-stat-label">Regions</dt><dd class="ts-stat-value" data-measured="@(Model.RegionCount is null ? "false" : "true")">@Model.RegionCountLabel</dd></div>@if (Model.Scope is { } scope) { @foreach (var stat in new[] { ("Reads", scope.Period.Reads), ("Writes", scope.Period.Writes) }) { <div class="ts-stat"><dt class="ts-stat-label">@stat.Item1</dt><dd class="ts-stat-value" title="@stat.Item2.ToString("N0", CultureInfo.InvariantCulture)">@ChartGeometry.Compact(stat.Item2)</dd></div> } }@if (Model.ScopeLogicalBytes is { } summaryStorageBytes) { var storage = UsageFigure.Bytes(summaryStorageBytes); <div class="ts-stat"><dt class="ts-stat-label">Logical storage</dt><dd class="ts-stat-value">@storage.Value<span class="ts-usage-unit">@storage.Unit</span></dd></div> }</dl></div></section>
<section class="ts-card ts-card-flush" id="database-usage" aria-labelledby="database-usage-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="database-usage-title">Project databases</h2></div></header><div class="ts-card-body">
@if (Model.Databases.Count > 0) { <div class="ts-table-wrap" tabindex="0" role="region" aria-label="Project databases table. Scroll horizontally to see all columns."><table class="ts-table"><caption class="ts-sr-only">Databases in the selected project with their reads, writes and storage</caption><thead><tr><th scope="col">Database</th><th scope="col">Region</th><th scope="col">Status</th><th scope="col" class="ts-num">Reads</th><th scope="col" class="ts-num">Writes</th><th scope="col" class="ts-num">Logical storage</th></tr></thead><tbody>@foreach (var database in Model.Databases)
{
    <tr><td class="ts-table-strong">@database.Spending.Name</td><td>@if (database.Spending.Region.Length > 0) { var country = Regions.Country(database.Spending.Region); <span class="ts-db-region">@if (country.Length > 0) { <img class="ts-db-region-flag" src="@Assets.Url("flags/" + country + ".svg")" alt="" aria-hidden="true" /> }<span class="ts-mono">@database.Spending.Region.ToLowerInvariant()</span></span> } else { <span class="ts-meta">Not configured</span> }</td><td><span class="ts-badge @(database.Status is "ready" or "active" or "Ready" or "Active" ? "ts-badge-success" : database.Status.Length == 0 ? "ts-badge-neutral" : "ts-badge-info")">@database.Status</span></td>@if (database.Reading is { } reading) { <td class="ts-num" title="@reading.Period.Reads.ToString("N0", CultureInfo.InvariantCulture)">@ChartGeometry.Compact(reading.Period.Reads)</td><td class="ts-num" title="@reading.Period.Writes.ToString("N0", CultureInfo.InvariantCulture)">@ChartGeometry.Compact(reading.Period.Writes)</td> } else { <td class="ts-num ts-meta">Not metered</td><td class="ts-num ts-meta">Not metered</td> }<td class="ts-num @(database.LogicalBytes is null ? "ts-meta" : "")">@(database.LogicalBytes is { } tableStorageBytes ? MetricFormat.Bytes(tableStorageBytes) : "Not measured")</td></tr>
}</tbody></table></div> } else if (Model.ActiveDatabases == 0) { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("Database", 16)</span><p class="ts-empty-title">No databases yet.</p><a class="ts-btn ts-btn-primary" href="/databases?create=1">New database</a></div> } else { <div class="ts-empty" role="status"><p class="ts-empty-title">No databases match this project filter.</p><a class="ts-btn ts-btn-secondary" href="@("/usage?tab=overview&range=" + Uri.EscapeDataString(Model.Selection.Range))">Clear filter</a></div> }
</div></section>
@functions {
    private void Share(string name, double? percent, long? bytes, string of)
    {
        <span class="ts-usage-share-bar">@if (percent is { } share) { <span class="ts-chart-meter" tabindex="0" role="img" aria-label="@(name + ": " + ValueFormat.PercentLabel(share) + " of " + of)"><svg class="ts-svg-sharebar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true"><rect class="ts-svg-sharebar-track" width="100" height="8"></rect><rect class="ts-svg-sharebar-fill" width="@Math.Clamp(share, 0, 100).ToString("0.###", CultureInfo.InvariantCulture)" height="8"></rect></svg><span class="ts-chart-tooltip" aria-hidden="true"><span class="ts-chart-tooltip-label">@name</span><strong>@ValueFormat.PercentLabel(share)</strong></span></span> }</span>
        <span class="ts-usage-share-percent">@(percent is { } label ? ValueFormat.PercentLabel(label) : "")</span>
        <span class="ts-usage-share-value" data-measured="@(bytes is null ? "false" : "true")">@if (bytes is { } measured) { var figure = UsageFigure.Bytes(measured); @figure.Value<span class="ts-usage-unit">@figure.Unit</span> } else { @("Unavailable") }</span>
    }
}
