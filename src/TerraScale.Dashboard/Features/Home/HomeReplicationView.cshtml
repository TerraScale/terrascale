@inherits RazorSlice<TerraScale.Dashboard.Features.Home.HomePage>
@using TerraScale.Dashboard.Features.Home
@using TerraScale.Dashboard.Shared.Formatting
<section class="ts-card" id="home-replication" aria-labelledby="home-replication-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="home-replication-title">Replication</h2><p class="ts-card-description">Selected project · @Model.Range</p></div></header><div class="ts-card-body">
@if (Model.Measurement.ReplicationError.Length > 0) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Replication unavailable</p><p class="ts-alert-body">@Model.Measurement.ReplicationError</p></div> }
else if (Model.Measurement.Replication is not { } data) { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("Network", 16)</span><p class="ts-empty-title">@Model.Measurement.ReplicationEmpty</p></div> }
else
{
    <dl class="ts-stats" aria-label="Replication health">@foreach (var stat in new[] { ("Healthy", data.Healthy), ("Lagging", data.Lagging), ("Diverged", data.Diverged), ("Stopped", data.Stopped) }) { <div class="ts-stat"><dt class="ts-stat-label">@stat.Item1</dt><dd class="ts-stat-value">@stat.Item2</dd><dd class="ts-stat-detail">Database regions</dd></div> }</dl>
    <dl class="ts-stats" aria-label="Replication bandwidth and lag">@foreach (var stat in new[] { ("Worst lag", MetricFormat.Latency(data.WorstLagMs), "Current maximum"), ("Replication bandwidth", MetricFormat.Bytes(data.WireBytes), "Wire bytes during " + Model.Range), ("Received", MetricFormat.Bytes(data.ReceivedBytes), "During " + Model.Range) }) { <div class="ts-stat"><dt class="ts-stat-label">@stat.Item1</dt><dd class="ts-stat-value">@stat.Item2</dd><dd class="ts-stat-detail">@stat.Item3</dd></div> }</dl>
    <dl class="ts-stats" aria-label="Replication bandwidth by direction">@foreach (var pair in data.Directions) { <div class="ts-stat"><dt class="ts-stat-label">@pair.FromRegion → @pair.ToRegion</dt><dd class="ts-stat-value">@MetricFormat.Bytes(pair.WireBytes)</dd><dd class="ts-stat-detail">Wire bytes across project databases</dd></div> }</dl>
}
<div class="ts-row"><a class="ts-link" href="/usage?range=@Model.Range#replication">View usage replication →</a><a class="ts-link" href="@("/analytics?database=&project=" + Uri.EscapeDataString(Model.Shell.Context.Project?.Id ?? "") + "&range=" + Uri.EscapeDataString(Model.Range))">View analytics →</a></div>
</div></section>
