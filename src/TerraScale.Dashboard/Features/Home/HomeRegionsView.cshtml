@inherits RazorSlice<TerraScale.Dashboard.Features.Home.HomePage>
@inject AssetUrls Assets
@if (Model.Measurement.RegionsPending)
{
    <section class="ts-card" id="home-regions" aria-labelledby="home-regions-title" data-init="@("@get('" + WorkspaceUrl.For(Model.Shell.Context, "/overview/regions") + "', {retry: 'never', retryMaxCount: 0})")"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="home-regions-title">Regions</h2></div></header><div class="ts-card-body"><div class="ts-empty" role="status" aria-busy="true"><p class="ts-empty-title">Loading region health and latency…</p></div></div></section>
}
else
{
<section class="ts-card" id="home-regions" aria-labelledby="home-regions-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="home-regions-title">Regions</h2></div></header><div class="ts-card-body">
            @if (Model.Measurement.RegionError.Length > 0) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Region measurements unavailable</p><p class="ts-alert-body">@Model.Measurement.RegionError</p><div class="ts-row"><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-on:click="@("@get('" + WorkspaceUrl.For(Model.Shell.Context, "/overview/regions") + "', {retry: 'never', retryMaxCount: 0})")">Retry regions</button></div></div> }
            @if (Model.Measurement.Regions.Count == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No database regions in this @(Model.RegionScope).</p></div> }
            else { <div class="ts-home-regions">@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.RegionMap, RegionMapModel>(RegionMapModel.ReadOnly("home-region-map", Model.Measurement.Regions.Select(region => region.Code)) with { LabelledBy = "home-regions-title" }))<div class="ts-table-wrap" role="region" aria-label="@($"{Model.RegionScope} regions table")" tabindex="0"><table class="ts-table"><caption class="ts-sr-only">@Model.RegionScope region health, latency and database counts</caption><thead><tr><th>Region</th><th>Health</th><th class="ts-num">Status probe</th><th class="ts-num">Databases</th></tr></thead><tbody>@foreach (var region in Model.Measurement.Regions.OrderBy(item => Regions.Rank(item.Code))) { <tr><th scope="row"><span class="ts-home-region-code">@if (Regions.Country(region.Code) is { Length: > 0 } known) { <img class="ts-home-region-flag" src="@Assets.Url($"flags/{known}.svg")" alt="" aria-hidden="true" /> }<span class="ts-mono">@region.Code</span></span></th><td><span class="ts-badge @(region.Status == "healthy" ? "ts-badge-success" : region.Status is "lagging" or "degraded" ? "ts-badge-warning" : "ts-badge-neutral")">@region.Status</span></td><td class="ts-num">@region.Latency</td><td class="ts-num">@region.Databases</td></tr> }</tbody></table></div></div> }
        </div></section>
}
