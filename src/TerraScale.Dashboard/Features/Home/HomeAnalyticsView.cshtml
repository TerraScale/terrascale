@inherits RazorSlice<TerraScale.Dashboard.Features.Home.HomePage>
@using TerraScale.Dashboard.Features.Home
<section class="ts-card" id="analytics-summary" aria-labelledby="analytics-summary-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="analytics-summary-title">Key analytics</h2><p class="ts-card-description">Selected project · @Model.Range</p></div><div class="ts-card-actions"><form class="ts-filters" method="get" action="/" aria-label="Filter overview analytics" data-submit-once><label class="ts-filter-inline" for="overview-range"><span class="ts-filter-inline-label">Range</span><select class="ts-select" id="overview-range" name="range">@foreach (var range in HomePage.Ranges) { <option value="@range" selected="@(range == Model.Range ? "selected" : null)">@range</option> }</select></label><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Apply</button></form></div></header><div class="ts-card-body">
@if (Model.Measurement.AnalyticsError.Length > 0) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Analytics unavailable</p><p class="ts-alert-body">@Model.Measurement.AnalyticsError</p></div> }
else if (Model.Measurement.Analytics is not { } data) { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("BarChart3", 16)</span><p class="ts-empty-title">@Model.Measurement.AnalyticsEmpty</p></div> }
else
{
    <dl class="ts-stats" aria-label="Key analytics">@foreach (var stat in new[] { ("Requests", data.Requests.ToString(), "In the selected period"), ("Errors", data.Errors.ToString(), "In the selected period"), ("Worst p95 latency", HomeMetricFormat.Latency(data.WorstP95Ms), "Across database regions in the latest bucket"), ("Storage", data.StorageBytes is { } storage ? HomeMetricFormat.Bytes(storage) : "Not reported", "Database regions in the latest bucket") }) { <div class="ts-stat"><dt class="ts-stat-label">@stat.Item1</dt><dd class="ts-stat-value">@stat.Item2</dd><dd class="ts-stat-detail">@stat.Item3</dd></div> }</dl>
    <dl class="ts-stats" aria-label="Operations and bandwidth">@foreach (var stat in new[] { ("Operations", data.Operations.ToString(), "In the selected period"), ("Client bandwidth", HomeMetricFormat.Bytes(data.ClientBytes), "Sent + received"), ("Replication bandwidth", HomeMetricFormat.Bytes(data.ReplicationBytes), "Separate replication_bytes meter") }) { <div class="ts-stat"><dt class="ts-stat-label">@stat.Item1</dt><dd class="ts-stat-value">@stat.Item2</dd><dd class="ts-stat-detail">@stat.Item3</dd></div> }</dl>
}
</div></section>
@if (Model.Measurement.RequestPoints.Count > 0) { @(await RenderPartialAsync<TerraScale.Dashboard.Features.Home.HomeRequestChartView, TerraScale.Dashboard.Features.Home.HomeRequestChart>(HomeRequestChart.For(Model))) }
<a class="ts-link" href="/analytics?range=@Model.Range">Explore analytics →</a>
