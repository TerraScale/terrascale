@inject AssetUrls Assets
@using System.Globalization
@using TerraScale.Dashboard.Common.Charts
@inherits RazorSlice<TerraScale.Dashboard.Features.Home.HomePage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.Home
<main class="ts-page ts-home"><header class="ts-home-header"><h1 class="ts-home-header-title">@(Model.Tab == "connect" ? "Connect" : "Overview")</h1><div class="ts-page-actions"><a class="ts-btn ts-btn-secondary" href="/api-keys">@Icons.Render("KeyRound", 16)<span>API keys</span></a><a class="ts-btn ts-btn-primary" href="/databases?create=1">@Icons.Render("Plus", 16)<span>New database</span></a></div></header>
    <div class="ts-toolbar ts-home-toolbar"><nav class="ts-tabs" aria-label="Overview sections"><a class="ts-tab" href="/" aria-current="@(Model.Tab != "connect" ? "page" : null)"><span>Overview</span></a><a class="ts-tab" href="/?tab=connect" aria-current="@(Model.Tab == "connect" ? "page" : null)"><span>Connect</span></a></nav></div>
    @if (Model.Tab == "connect")
    {
        <ul class="ts-grid ts-home-connect">@foreach (var option in ConnectOptions)
        {
            <li class="ts-home-connect-item"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render(option.Icon, 16)</span><div class="ts-row-between"><span class="ts-strong">@option.Title</span><span class="ts-badge @(option.Available ? "ts-badge-success" : "ts-badge-neutral")">@(option.Available ? "Available" : "Preview")</span></div></li>
        }</ul>
        <section class="ts-card" id="sdk-connect" aria-labelledby="sdk-connect-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="sdk-connect-title">Connect your application</h2></div><div class="ts-card-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="https://docs.terrascale.tech/getting-started/" @(ExternalLink.Attributes)>Quickstart@(ExternalLink.Hint)</a></div></header><div class="ts-card-body ts-stack">
            <dl class="ts-kv"><dt>API URL</dt><dd><code>@HomeConnectSnippets.ApiUrl</code> · <a class="ts-link" href="@(HomeConnectSnippets.ApiUrl + "/scalar")" @(ExternalLink.Attributes)>API reference@(ExternalLink.Hint)</a> · <a class="ts-link" href="@(HomeConnectSnippets.ApiUrl + "/openapi/v1.json")" @(ExternalLink.Attributes)>OpenAPI@(ExternalLink.Hint)</a></dd><dt>Project ID</dt><dd><code>@ProjectId</code></dd><dt>Database</dt><dd>@if (DatabaseName is { } name) { <code>@name</code> } else { <span>—</span> }</dd></dl>
            @if (DatabaseName is not null)
            {
                <form method="get" action="/" class="ts-form"><input type="hidden" name="tab" value="connect" /><input type="hidden" name="organizationId" value="@Model.Shell.Context.Organization?.Id" /><input type="hidden" name="projectId" value="@ProjectId" /><div class="ts-field"><label class="ts-label" for="connect-database">Database</label><select class="ts-select" id="connect-database" name="database">@foreach (var database in DatabaseNames) { <option value="@database" selected="@(database == DatabaseName)">@database</option> }</select></div><button type="submit" class="ts-btn ts-btn-secondary">Update snippets</button></form>
            <ol class="ts-home-steps"><li class="ts-home-step"><span class="ts-icon-tile" aria-hidden="true">01</span><div class="ts-stack-sm"><span class="ts-strong">Create an API key with sql:read and sql:write</span><a class="ts-link" href="/api-keys?create=key&scopes=sql:read,sql:write">Open API keys →</a></div></li><li class="ts-home-step"><span class="ts-icon-tile" aria-hidden="true">02</span><div class="ts-stack-sm"><span class="ts-strong">Exchange it for an access token</span>@{ Snippet("token", "Bash", HomeConnectSnippets.TokenExchange); }</div></li><li class="ts-home-step"><span class="ts-icon-tile" aria-hidden="true">03</span><div class="ts-stack-sm"><span class="ts-strong">Create the posts table</span><p class="ts-meta">The access token lasts 60 seconds; re-run step 02 if more than a minute has passed.</p>@{ Snippet("table", "Bash", HomeConnectSnippets.CreateTable(ProjectId, DatabaseName ?? "YOUR_DATABASE_NAME")); }</div></li><li class="ts-home-step"><span class="ts-icon-tile" aria-hidden="true">04</span><div class="ts-stack-sm"><span class="ts-strong">Query it from your application</span>@{ var homeSdks = HomeConnectSnippets.For(ProjectId, DatabaseName ?? "YOUR_DATABASE_NAME"); }
            <div class="sdk-tabs" role="tablist" aria-label="SDK language" data-sdk-tabs>@foreach (var sdk in homeSdks)
            { <button type="button" role="tab" id="@("home-sdk-tab-" + sdk.Id)" aria-controls="@("home-sdk-panel-" + sdk.Id)" aria-selected="@(sdk.Id == homeSdks[0].Id ? "true" : "false")" tabindex="@(sdk.Id == homeSdks[0].Id ? "0" : "-1")"><img src="@Assets.Url("language-icons/" + (sdk.Id == "js" ? "javascript" : sdk.Id) + ".svg")" width="16" height="16" alt="" aria-hidden="true" />@sdk.Label</button> }</div>
            @foreach (var sdk in homeSdks)
            { <div class="ts-stack-sm" role="tabpanel" id="@("home-sdk-panel-" + sdk.Id)" aria-labelledby="@("home-sdk-tab-" + sdk.Id)" tabindex="0" hidden="@(sdk.Id == homeSdks[0].Id ? null : "hidden")">@if (sdk.Install.Length > 0) { Snippet(sdk.Id + "-install", "Install", sdk.Install); }@{ Snippet(sdk.Id, sdk.Label, sdk.Code); }</div> }</div></li><li class="ts-home-step"><span class="ts-icon-tile" aria-hidden="true">05</span><div class="ts-stack-sm"><span class="ts-strong">Or connect with psql</span><a class="ts-link" href="https://docs.terrascale.tech/guides/postgres-clients" @(ExternalLink.Attributes)>Postgres guide →@(ExternalLink.Hint)</a>@{ Snippet("psql", "psql", HomeConnectSnippets.Postgres(ProjectId, DatabaseName ?? "YOUR_DATABASE_NAME")); }</div></li></ol>
            }
            else
            {
                <div class="ts-empty" role="status"><p class="ts-empty-title">Create your first database to get connection snippets.</p><a class="ts-btn ts-btn-primary" href="/databases?create=1">Create a database</a></div>
            }
        </div></section>
        <section class="ts-card" id="mcp-config" aria-labelledby="mcp-config-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="mcp-config-title">MCP client configuration</h2></div><div class="ts-card-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="https://docs.terrascale.tech/guides/mcp" @(ExternalLink.Attributes)>MCP guide@(ExternalLink.Hint)</a></div></header><div class="ts-card-body">@if (Model.Measurement.CredentialsError.Length > 0) { <p class="ts-meta" role="status">@Model.Measurement.CredentialsError</p> }<ol class="ts-home-steps"><li class="ts-home-step"><span class="ts-icon-tile" aria-hidden="true">01</span><div class="ts-stack-sm"><span class="ts-strong">Create a personal access token</span><a class="ts-link" href="/profile?tab=access-tokens">Open access tokens →</a></div></li><li class="ts-home-step"><span class="ts-icon-tile" aria-hidden="true">02</span><div class="ts-stack-sm"><span class="ts-strong">Add the server with the token as a bearer credential</span><pre class="ts-code"><code>@McpConfig</code></pre></div></li></ol></div></section>
    }
    else
    {
        <dl class="ts-stats" aria-label="Workspace metrics">@foreach (var stat in new[] { ("Databases", Model.Databases.ToString(), 1), ("Organization members", Model.Members?.ToString() ?? "Unavailable", 3), ("Unread alerts", Model.Shell.Unread.ToString(), 5) })
        { <div class="ts-stat"><dt class="ts-stat-label"><span class="ts-home-kpi-dot" data-hue="@stat.Item3" aria-hidden="true"></span>@stat.Item1</dt><dd class="ts-stat-value">@stat.Item2</dd></div> }</dl>
        <div class="ts-split ts-home-overview"><section class="ts-card" id="home-activity" aria-labelledby="home-activity-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="home-activity-title">Activity</h2></div><div class="ts-card-actions">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Home.HomeRangeLinks, string>(Model.Range))</div></header><div class="ts-card-body">
        @if (Model.Measurement.Activity.Count > 0)
        {
            var chart = TerraScale.Dashboard.Features.Home.OperationChart.For(Model);
            <p class="ts-home-activity-total"><span class="ts-chart-swatch" aria-hidden="true"></span>@Model.Measurement.ActivityLabel<strong title="@((Model.Measurement.Reads + Model.Measurement.Writes).ToString("N0", CultureInfo.InvariantCulture))">@ChartGeometry.Compact(Model.Measurement.Reads + Model.Measurement.Writes)</strong></p><div class="ts-chart-shell" role="region" aria-label="@chart.Label" tabindex="0">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Home.ActivityChart, TerraScale.Dashboard.Features.Home.OperationChart>(chart))</div>
        }
        else { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("Activity", 16)</span><p class="ts-empty-title">@(Model.Measurement.ActivityNote.Length > 0 ? Model.Measurement.ActivityNote : "No activity yet.")</p></div> }
        <a class="ts-link ts-meta" href="/organization?tab=audit">View audit events →</a></div></section>
        <section class="ts-card" id="getting-started" aria-labelledby="getting-started-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="getting-started-title">Getting started</h2></div></header><div class="ts-card-body">@if (Model.Measurement.CredentialsError.Length > 0) { <p class="ts-meta" role="status">@Model.Measurement.CredentialsError</p> }<ol class="ts-home-steps">@foreach (var step in new[] { (Number: 1, Title: "Create a database", Href: "/databases?create=1", Cta: "Open databases", Done: Model.Databases > 0), (Number: 2, Title: "Create an API key", Href: "/api-keys", Cta: "Open API keys", Done: Model.Measurement.ActiveCredentials > 0) })
        { <li class="ts-home-step @(step.Done ? "ts-home-step-done" : "")"><span class="ts-home-step-number" aria-hidden="true">@if (step.Done) { @Icons.Render("Check", 14) } else { @step.Number }</span><div class="ts-stack-sm"><div class="ts-row-between"><span class="ts-strong">@step.Title</span><span class="ts-badge @(step.Done ? "ts-badge-success" : "ts-badge-neutral")">@(step.Done ? "Done" : "Open")</span></div><a class="ts-link" href="@step.Href">@step.Cta →</a></div></li> }</ol><a class="ts-btn ts-btn-secondary ts-btn-block" href="/?tab=connect">@Icons.Render("Zap", 16)<span>Connect your AI or platform</span></a></div></section></div>
        @(await RenderPartialAsync<TerraScale.Dashboard.Features.Home.HomeAnalyticsView, TerraScale.Dashboard.Features.Home.HomePage>(Model))
        <div class="ts-stack-lg">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Home.HomeRegionsView, TerraScale.Dashboard.Features.Home.HomePage>(Model))</div>
    }
</main>
@functions {
    public ShellModel LayoutModel => Model.Shell;
    private static readonly (string Icon, string Title, bool Available)[] ConnectOptions = [("Bot", "AI assistants", true), ("FileJson", "SDKs", true), ("Globe", "REST API", true), ("Terminal", "CLI and CI", false)];
    private string ProjectId => Model.Shell.Context.Project?.Id ?? "";
    private string[] DatabaseNames => Model.Shell.Context.Project?.Databases.Values.Select(item => item.Name).Order(StringComparer.Ordinal).ToArray() ?? [];
    private string? DatabaseName
    {
        get
        {
            var requested = HttpContext!.Request.Query["database"].ToString();
            return DatabaseNames.Contains(requested, StringComparer.Ordinal) ? requested : DatabaseNames.FirstOrDefault();
        }
    }
    private void Snippet(string id, string label, string code)
    {
        var key = id.Replace("-", "");
        var signal = "$_" + key + "Copy";
        <div class="ts-snippet" data-signals="@("{_" + key + "Copy: ''}")"><div class="ts-snippet-header ts-row-between"><span>@label</span><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" aria-label="@("Copy " + label)" aria-describedby="@("connect-" + id + "-status")" data-on:click="@("Promise.resolve().then(() => navigator.clipboard.writeText(document.getElementById('connect-" + id + "').textContent)).then(() => { " + signal + " = 'Copied'; setTimeout(() => " + signal + " = '', 2000) }, () => { const snippet = document.getElementById('connect-" + id + "'); snippet.focus(); const range = document.createRange(); range.selectNodeContents(snippet); const selection = window.getSelection(); selection.removeAllRanges(); selection.addRange(range); " + signal + " = 'Copy failed — text selected, press Ctrl+C'; })")">@Icons.Render("Copy", 14)<span data-text="@(signal + " === 'Copied' ? 'Copied' : 'Copy'")">Copy</span></button></div><pre class="ts-snippet-body" id="@("connect-" + id)" tabindex="0"><code>@code</code></pre><span class="ts-sr-only" id="@("connect-" + id + "-status")" role="status" aria-live="polite" aria-atomic="true" data-text="@signal"></span></div>
    }
    private string McpConfig => System.Text.Json.JsonSerializer.Serialize(new { mcpServers = new { terrascale = new { type = "http", url = "https://mcp.terrascale.tech/", headers = new { Authorization = "Bearer <your-access-token>" } } } }, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
}
