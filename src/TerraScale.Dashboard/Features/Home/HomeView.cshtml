@inherits RazorSlice<TerraScale.Dashboard.Features.Home.HomePage>
@implements IUsesLayout<TerraScale.Dashboard.Shared.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.Home
<main class="ts-page ts-home"><header class="ts-home-header"><div class="ts-stack-sm"><h1 class="ts-home-header-title">@(Model.Tab == "connect" ? "Connect" : "Overview")</h1><p class="ts-meta">@(Model.Tab == "connect" ? "Connect an assistant or platform to " : "Activity, setup and regions for ")@(Model.Shell.Context.Project?.Name)</p></div><div class="ts-page-actions"><a class="ts-btn ts-btn-secondary" href="/api-keys">@Icons.Render("KeyRound", 16)<span>API keys</span></a><a class="ts-btn ts-btn-primary" href="/databases">@Icons.Render("Plus", 16)<span>New database</span></a></div></header>
    <div class="ts-toolbar ts-home-toolbar"><nav class="ts-tabs" aria-label="Overview sections"><a class="ts-tab" href="/" aria-current="@(Model.Tab != "connect" ? "page" : null)"><span>Overview</span></a><a class="ts-tab" href="/?tab=connect" aria-current="@(Model.Tab == "connect" ? "page" : null)"><span>Connect</span></a></nav></div>
    @if (Model.Tab == "connect")
    {
        <ul class="ts-grid ts-home-connect">@foreach (var option in ConnectOptions)
        {
            <li class="ts-home-connect-item"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render(option.Icon, 16)</span><div class="ts-stack-sm"><div class="ts-row-between"><span class="ts-strong">@option.Title</span><span class="ts-badge @(option.Available ? "ts-badge-success" : "ts-badge-neutral")">@(option.Available ? "Available" : "Preview")</span></div><p class="ts-meta">@option.Description</p></div></li>
        }</ul>
        <section class="ts-card" id="sdk-connect" aria-labelledby="sdk-connect-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="sdk-connect-title">Connect your application</h2><p class="ts-card-description">Call TerraBase from your code with an API key. Snippets are prefilled for this project.</p></div><div class="ts-card-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="https://docs.terrascale.tech/getting-started/">Quickstart</a></div></header><div class="ts-card-body ts-stack">
            <dl class="ts-kv"><dt>API URL</dt><dd><code>@HomeConnectSnippets.ApiUrl</code> · <a class="ts-link" href="@(HomeConnectSnippets.ApiUrl + "/scalar")">API reference</a> · <a class="ts-link" href="@(HomeConnectSnippets.ApiUrl + "/openapi/v1.json")">OpenAPI</a></dd><dt>Project ID</dt><dd><code>@ProjectId</code></dd><dt>Database</dt><dd>@if (DatabaseName is { } name) { <code>@name</code> } else { <span>None yet · <a class="ts-link" href="/databases">create a database</a></span> }</dd></dl>
            <ol class="ts-home-steps"><li class="ts-home-step"><span class="ts-icon-tile" aria-hidden="true">01</span><div class="ts-stack-sm"><span class="ts-strong">Create an API key</span><p class="ts-meta">Choose <strong>Read and write</strong> access for this database so you can create its first collection.</p><a class="ts-link" href="/api-keys">Open API keys →</a></div></li><li class="ts-home-step"><span class="ts-icon-tile" aria-hidden="true">02</span><div class="ts-stack-sm"><span class="ts-strong">Exchange it for a short-lived access token</span>@{ Snippet("token", "Shell", HomeConnectSnippets.TokenExchange); }</div></li><li class="ts-home-step"><span class="ts-icon-tile" aria-hidden="true">03</span><div class="ts-stack-sm"><span class="ts-strong">Create the posts collection</span><p class="ts-meta">A new database has no collections. Run this once before listing documents; <code>409 name_taken</code> means it already exists. Access tokens last at most 60 seconds; repeat the exchange when needed.</p>@{ Snippet("collection", "Shell", HomeConnectSnippets.CreateCollection(ProjectId, DatabaseName ?? "YOUR_DATABASE_NAME")); }</div></li><li class="ts-home-step"><span class="ts-icon-tile" aria-hidden="true">04</span><div class="ts-stack-sm"><span class="ts-strong">List the first documents of the collection</span>@foreach (var sdk in HomeConnectSnippets.For(ProjectId, DatabaseName ?? "YOUR_DATABASE_NAME"))
            { <details class="ts-home-sdk" open="@(sdk.Id == "js")"><summary class="ts-strong">@sdk.Label</summary><div class="ts-stack-sm">@if (sdk.Id is "csharp" or "rust") { <p class="ts-meta">@(sdk.Id == "csharp" ? "NuGet publication is pending." : "crates.io publication is pending.") <a class="ts-link" href="@(sdk.Id == "csharp" ? "https://docs.terrascale.tech/getting-started/csharp" : "https://docs.terrascale.tech/guides/sdks#rust")">Install from source →</a></p> }@if (sdk.Install.Length > 0) { Snippet(sdk.Id + "-install", "Install", sdk.Install); }@{ Snippet(sdk.Id, sdk.Label, sdk.Code); }</div></details> }</div></li><li class="ts-home-step"><span class="ts-icon-tile" aria-hidden="true">05</span><div class="ts-stack-sm"><span class="ts-strong">Or connect with psql and Postgres drivers</span><p class="ts-meta">The API key itself is the password; no token exchange. <a class="ts-link" href="https://docs.terrascale.tech/guides/postgres-clients">Postgres guide →</a></p>@{ Snippet("psql", "psql", HomeConnectSnippets.Postgres(DatabaseName ?? "YOUR_DATABASE_NAME")); }</div></li></ol>
        </div></section>
        <section class="ts-card" id="mcp-config" aria-labelledby="mcp-config-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="mcp-config-title">MCP client configuration</h2><p class="ts-card-description">Add this server to your assistant's MCP settings. Assistants act as you, with your dashboard permissions.</p></div></header><div class="ts-card-body">@if (Model.Measurement.CredentialsError.Length > 0) { <p class="ts-meta" role="status">@Model.Measurement.CredentialsError</p> }<ol class="ts-home-steps"><li class="ts-home-step"><span class="ts-icon-tile" aria-hidden="true">01</span><div class="ts-stack-sm"><span class="ts-strong">Create a personal access token</span><p class="ts-meta">Tokens expire and can be revoked at any time from your profile.</p><a class="ts-link" href="/profile?tab=access-tokens">Open access tokens →</a></div></li><li class="ts-home-step"><span class="ts-icon-tile" aria-hidden="true">02</span><div class="ts-stack-sm"><span class="ts-strong">Add the server with the token as a bearer credential</span><pre class="ts-code"><code>@McpConfig</code></pre></div></li></ol></div></section>
    }
    else
    {
        <dl class="ts-stats" aria-label="Workspace metrics">@foreach (var stat in new[] { ("Databases", Model.Databases.ToString(), Model.Databases == 0 ? "none saved" : "saved project databases", 1), ("Organization members", Model.Members?.ToString() ?? "Unavailable", Model.Members is null ? "Requires organization membership" : Model.Members == 1 ? "active organization member" : "active organization members", 3), ("Unread alerts", Model.Shell.Unread.ToString(), Model.TotalNotifications + " notifications loaded", 5) })
        { <div class="ts-stat"><dt class="ts-stat-label"><span class="ts-home-kpi-dot" data-hue="@stat.Item4" aria-hidden="true"></span>@stat.Item1</dt><dd class="ts-stat-value">@stat.Item2</dd><dd class="ts-stat-detail">@stat.Item3</dd></div> }</dl>
        <div class="ts-split ts-home-overview"><section class="ts-card" id="home-activity" aria-labelledby="home-activity-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="home-activity-title">Activity</h2><p class="ts-card-description">@Model.Measurement.ActivityNote</p></div><div class="ts-card-actions">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Home.HomeRangeLinks, string>(Model.Range))</div></header><div class="ts-card-body">
        @if (Model.Measurement.Activity.Count > 0)
        {
            var chart = TerraScale.Dashboard.Features.Home.OperationChart.For(Model);
            <p class="ts-home-activity-total"><span class="ts-chart-swatch" aria-hidden="true"></span>@Model.Measurement.ActivityLabel<strong>@(Model.Measurement.Reads + Model.Measurement.Writes)</strong></p><div class="ts-chart-shell" role="region" aria-label="@chart.Label" tabindex="0">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Home.ActivityChart, TerraScale.Dashboard.Features.Home.OperationChart>(chart))</div>
        }
        else { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("Activity", 16)</span><p class="ts-empty-title">No measured reads or writes to plot.</p></div> }
        <a class="ts-link ts-meta" href="/organization?tab=audit">View persisted audit events →</a></div></section>
        <section class="ts-card" id="getting-started" aria-labelledby="getting-started-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="getting-started-title">Getting started</h2><p class="ts-card-description">Get a database online and wire it into your stack.</p></div></header><div class="ts-card-body">@if (Model.Measurement.CredentialsError.Length > 0) { <p class="ts-meta" role="status">@Model.Measurement.CredentialsError</p> }<ol class="ts-home-steps">@foreach (var step in new[] { (Number: 1, Title: "Create first database", Description: "Create a logical database in the region closest to your users.", Href: "/databases", Cta: "Open databases", Done: Model.Databases > 0), (Number: 2, Title: "Create an Application credential", Description: "Generate a scoped API key or M2M client for your application.", Href: "/api-keys", Cta: "Open API keys", Done: Model.Measurement.ActiveCredentials > 0) })
        { <li class="ts-home-step @(step.Done ? "ts-home-step-done" : "")"><span class="ts-home-step-number" aria-hidden="true">@if (step.Done) { @Icons.Render("Check", 14) } else { @step.Number }</span><div class="ts-stack-sm"><div class="ts-row-between"><span class="ts-strong">@step.Title</span><span class="ts-badge @(step.Done ? "ts-badge-success" : "ts-badge-neutral")">@(step.Done ? "Done" : "Open")</span></div><p class="ts-meta">@step.Description</p><a class="ts-link" href="@step.Href">@step.Cta →</a></div></li> }</ol><a class="ts-btn ts-btn-secondary ts-btn-block" href="/?tab=connect">@Icons.Render("Zap", 16)<span>Connect your AI or platform</span></a></div></section></div>
        @(await RenderPartialAsync<TerraScale.Dashboard.Features.Home.HomeAnalyticsView, TerraScale.Dashboard.Features.Home.HomePage>(Model))
        <div class="ts-stack-lg">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Home.HomeRegionsView, TerraScale.Dashboard.Features.Home.HomePage>(Model))@(await RenderPartialAsync<TerraScale.Dashboard.Features.Home.HomeReplicationView, TerraScale.Dashboard.Features.Home.HomePage>(Model))</div>
    }
</main>
@functions {
    public ShellModel LayoutModel => Model.Shell;
    private static readonly (string Icon, string Title, string Description, bool Available)[] ConnectOptions = [("Bot", "AI assistants", "Connect Claude, Cursor, and other MCP-compatible assistants to manage your organizations, projects, and databases.", true), ("FileJson", "SDKs", "Query your databases from JavaScript, C#, Go or Rust with the snippets below.", true), ("Globe", "REST API", "Call the project API from any language with an exchanged access token.", true), ("Terminal", "CLI and CI", "Manage databases and run queries from your terminal or pipeline.", false)];
    private string ProjectId => Model.Shell.Context.Project?.Id ?? "";
    private string? DatabaseName => Model.Shell.Context.Project?.Databases.Values.Select(item => item.Name).Order(StringComparer.Ordinal).FirstOrDefault();
    private void Snippet(string id, string label, string code)
    {
        <div class="ts-snippet" data-signals="@("{_" + id.Replace("-", "") + "Copy: ''}")"><div class="ts-snippet-header ts-row-between"><span>@label</span><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-on:click="@("(navigator.clipboard?.writeText(document.getElementById('connect-" + id + "').textContent) ?? Promise.reject()).then(() => { $_" + id.Replace("-", "") + "Copy = 'Copied'; setTimeout(() => $_" + id.Replace("-", "") + "Copy = '', 2000) }, () => $_" + id.Replace("-", "") + "Copy = 'Copy failed')")">@Icons.Render("Copy", 14)<span data-text="@("$_" + id.Replace("-", "") + "Copy || 'Copy'")">Copy</span></button></div><pre class="ts-snippet-body" id="@("connect-" + id)"><code>@code</code></pre></div>
    }
    private string McpConfig => System.Text.Json.JsonSerializer.Serialize(new { mcpServers = new { terrascale = new { type = "http", url = $"{HttpContext!.Request.Scheme}://{HttpContext.Request.Host}/mcp", headers = new { Authorization = "Bearer <your-access-token>" } } } }, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
}
