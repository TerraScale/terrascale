@inherits RazorSlice<TerraScale.Dashboard.Features.Home.HomePage>
@implements IUsesLayout<TerraScale.Dashboard.UI.Slices.ShellDocument, ShellModel>
@inject AssetUrls Assets
<main class="ts-page ts-home"><header class="ts-home-header"><div class="ts-stack-sm"><h1 class="ts-home-header-title">@(Model.Tab == "connect" ? "Connect" : "Overview")</h1><p class="ts-meta">@(Model.Tab == "connect" ? "Connect an assistant or platform to " : "Activity, setup and regions for ")@(Model.Shell.Context.Project?.Name)</p></div><div class="ts-page-actions"><a class="ts-btn ts-btn-secondary" href="/api-keys">@Icons.Render("KeyRound", 16)<span>API keys</span></a><a class="ts-btn ts-btn-primary" href="/databases">@Icons.Render("Plus", 16)<span>New database</span></a></div></header>
    <div class="ts-toolbar ts-home-toolbar"><nav class="ts-tabs" aria-label="Overview sections"><a class="ts-tab" href="/" aria-current="@(Model.Tab != "connect" ? "page" : null)"><span>Overview</span></a><a class="ts-tab" href="/?tab=connect" aria-current="@(Model.Tab == "connect" ? "page" : null)"><span>Connect</span></a></nav></div>
    @if (Model.Tab == "connect")
    {
        <ul class="ts-grid ts-home-connect">@foreach (var option in ConnectOptions)
        {
            <li class="ts-home-connect-item"><span class="ts-home-connect-icon" aria-hidden="true">@Icons.Render(option.Icon, 18)</span><div class="ts-stack-sm"><div class="ts-row-between"><span class="ts-strong">@option.Title</span><span class="ts-badge @(option.Available ? "ts-badge-success" : "ts-badge-neutral")">@(option.Available ? "Available" : "Preview")</span></div><p class="ts-meta">@option.Description</p></div></li>
        }</ul>
        <section class="ts-card" id="mcp-config" aria-labelledby="mcp-config-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="mcp-config-title">MCP client configuration</h2><p class="ts-card-description">Add this server to your assistant's MCP settings. Assistants act as you, with your dashboard permissions.</p></div></header><div class="ts-card-body">@if (Model.Measurement.CredentialsError.Length > 0) { <p class="ts-meta" role="status">@Model.Measurement.CredentialsError</p> }<ol class="ts-home-steps"><li class="ts-home-step"><span class="ts-home-step-number" aria-hidden="true">1</span><div class="ts-stack-sm"><span class="ts-strong">Create a personal access token</span><p class="ts-meta">Tokens expire and can be revoked at any time from your profile.</p><a class="ts-link" href="/profile?tab=access-tokens">Open access tokens →</a></div></li><li class="ts-home-step"><span class="ts-home-step-number" aria-hidden="true">2</span><div class="ts-stack-sm"><span class="ts-strong">Add the server with the token as a bearer credential</span><pre class="ts-code"><code>@McpConfig</code></pre></div></li></ol></div></section>
    }
    else
    {
        <dl class="ts-stats" aria-label="Workspace metrics">@foreach (var stat in new[] { ("Databases", Model.Databases, Model.Databases == 0 ? "none saved" : "saved project databases", 1), ("Organization members", Model.Members, Model.Members == 1 ? "active organization member" : "active organization members", 3), ("Unread alerts", Model.Shell.Unread, Model.TotalNotifications + " notifications loaded", 5) })
        { <div class="ts-stat"><dt class="ts-stat-label"><span class="ts-home-kpi-dot" data-hue="@stat.Item4" aria-hidden="true"></span>@stat.Item1</dt><dd class="ts-stat-value">@stat.Item2</dd><dd class="ts-stat-detail">@stat.Item3</dd></div> }</dl>
        <div class="ts-split ts-home-overview"><section class="ts-card" id="home-activity" aria-labelledby="home-activity-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="home-activity-title">Activity</h2><p class="ts-card-description">@Model.Measurement.ActivityNote</p></div><div class="ts-card-actions">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Home.HomeRangeLinks, string>(Model.Range))</div></header><div class="ts-card-body">
        @if (Model.Measurement.Activity.Count > 0)
        {
            var chart = TerraScale.Dashboard.Features.Home.OperationChart.For(Model);
            <p class="ts-home-activity-total"><span class="ts-chart-swatch" aria-hidden="true"></span>@Model.Measurement.ActivityLabel<strong>@(Model.Measurement.Reads + Model.Measurement.Writes)</strong></p><div class="ts-chart-shell" role="region" aria-label="@chart.Label" tabindex="0">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Home.ActivityChart, TerraScale.Dashboard.Features.Home.OperationChart>(chart))</div>
        }
        else { <div class="ts-empty" role="status"><p class="ts-empty-title">No measured reads or writes to plot.</p></div> }
        <a class="ts-link ts-meta" href="/organization?tab=audit">View persisted audit events →</a></div></section>
        <section class="ts-card" id="getting-started" aria-labelledby="getting-started-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="getting-started-title">Getting started</h2><p class="ts-card-description">Get a database online and wire it into your stack.</p></div></header><div class="ts-card-body">@if (Model.Measurement.CredentialsError.Length > 0) { <p class="ts-meta" role="status">@Model.Measurement.CredentialsError</p> }<ol class="ts-home-steps">@foreach (var step in new[] { (Number: 1, Title: "Create first database", Description: "Create a logical database in the region closest to your users.", Href: "/databases", Cta: "Open databases", Done: Model.Databases > 0), (Number: 2, Title: "Create an Application credential", Description: "Generate a scoped API key or M2M client for your application.", Href: "/api-keys", Cta: "Open API keys", Done: Model.Measurement.ActiveCredentials > 0) })
        { <li class="ts-home-step @(step.Done ? "ts-home-step-done" : "")"><span class="ts-home-step-number" aria-hidden="true">@if (step.Done) { @Icons.Render("Check", 14) } else { @step.Number }</span><div class="ts-stack-sm"><div class="ts-row-between"><span class="ts-strong">@step.Title</span><span class="ts-badge @(step.Done ? "ts-badge-success" : "ts-badge-neutral")">@(step.Done ? "Done" : "Open")</span></div><p class="ts-meta">@step.Description</p><a class="ts-link" href="@step.Href">@step.Cta →</a></div></li> }</ol><a class="ts-btn ts-btn-secondary ts-btn-block" href="/?tab=connect">@Icons.Render("Zap", 16)<span>Connect your AI or platform</span></a></div></section></div>
        <p class="ts-meta ts-measurement-loading" role="status">Loading analytics, replication and regions…</p>
        @(await RenderPartialAsync<TerraScale.Dashboard.Features.Home.HomeAnalyticsView, TerraScale.Dashboard.Features.Home.HomePage>(Model))
        <div class="ts-stack-lg"><section class="ts-card" id="home-regions" aria-labelledby="home-regions-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="home-regions-title">Regions</h2><p class="ts-card-description">Regions used by this organization · ts-status measurements</p></div></header><div class="ts-card-body">
            @if (Model.Measurement.RegionError.Length > 0) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Region measurements unavailable</p><p class="ts-alert-body">@Model.Measurement.RegionError</p></div> }
            @if (Model.Measurement.Regions.Count == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No database regions in this organization.</p></div> }
            else { <div class="ts-home-regions"><div class="ts-region-map ts-home-region-map" aria-hidden="true"><img class="ts-region-map-image" src="@Assets.Url("brand/region-map.svg")" alt="" loading="lazy" decoding="async" />@foreach (var region in Model.Measurement.Regions) { if (MappedRegions.Contains(region.Code)) { <span class="ts-region-node" data-region="@region.Code.ToLowerInvariant()"><span class="ts-region-node-ring"></span><span class="ts-region-node-core"></span></span> } }</div><div class="ts-table-wrap" role="region" aria-label="Organization regions table" tabindex="0"><table class="ts-table"><caption class="ts-sr-only">Organization region health, latency and database counts</caption><thead><tr><th>Region</th><th>Health</th><th class="ts-num">Latency</th><th class="ts-num">Databases</th></tr></thead><tbody>@foreach (var region in Model.Measurement.Regions.OrderBy(item => Regions.Rank(item.Code))) { <tr><th scope="row"><span class="ts-home-region-code">@if (Regions.Country(region.Code) is { Length: > 0 } known) { <img class="ts-home-region-flag" src="@Assets.Url($"flags/{known}.svg")" alt="" aria-hidden="true" /> }<span class="ts-mono">@region.Code</span></span></th><td><span class="ts-badge @(region.Status == "healthy" ? "ts-badge-success" : region.Status is "lagging" or "degraded" ? "ts-badge-warning" : "ts-badge-neutral")">@region.Status</span></td><td class="ts-num">@region.Latency</td><td class="ts-num">@region.Databases</td></tr> }</tbody></table></div></div> }
        </div></section>@(await RenderPartialAsync<TerraScale.Dashboard.Features.Home.HomeReplicationView, TerraScale.Dashboard.Features.Home.HomePage>(Model))</div>
    }
</main>
@functions {
    public ShellModel LayoutModel => Model.Shell;
    private static readonly (string Icon, string Title, string Description, bool Available)[] ConnectOptions = [("Bot", "AI assistants", "Connect Claude, Cursor, and other MCP-compatible assistants to manage your organizations, projects, and databases.", true), ("FileJson", "TypeScript SDK", "Install the SDK and query your databases directly from your application.", false), ("Globe", "REST API", "Call the project API from any language with a scoped credential.", false), ("Terminal", "CLI and CI", "Manage databases and run queries from your terminal or pipeline.", false)];
    private static readonly HashSet<string> MappedRegions = new(StringComparer.OrdinalIgnoreCase) { "gru", "fra", "sjc" };
    private string McpConfig => System.Text.Json.JsonSerializer.Serialize(new { mcpServers = new { terrascale = new { type = "http", url = $"{HttpContext!.Request.Scheme}://{HttpContext.Request.Host}/mcp", headers = new { Authorization = "Bearer <your-access-token>" } } } }, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
}
