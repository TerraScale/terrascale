@inherits RazorSlice<TerraScale.Dashboard.Features.Profile.ProfilePage>
@implements IUsesLayout<TerraScale.Dashboard.Shared.UI.Slices.ShellDocument, ShellModel>
<main class="ts-page">
    <header class="ts-profile-head"><span class="ts-avatar" aria-hidden="true">@Initials</span><div><h1 class="ts-profile-name">@Model.Shell.Context.Account.Name</h1><p class="ts-meta">@Model.Shell.Context.Account.Email</p></div></header><div class="ts-page-actions"></div>
    @if (Model.Error.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
    @if (Model.Status.Length > 0) { <p role="status" aria-live="polite" class="ts-alert ts-alert-success">@Model.Status</p> }
    <dl class="ts-stats" aria-label="Account summary"><div class="ts-stat"><dt class="ts-stat-label">Roles</dt><dd class="ts-stat-value">@(Model.Shell.Context.Role == "" ? 0 : 1)</dd></div><div class="ts-stat"><dt class="ts-stat-label">Listed capabilities</dt><dd class="ts-stat-value">@Model.Permissions.Length</dd></div><div class="ts-stat"><dt class="ts-stat-label">Sessions</dt><dd class="ts-stat-value">@(Model.Sessions?.Count.ToString() ?? "Not loaded")</dd></div></dl>
    <nav class="ts-tabs ts-profile-tabs" aria-label="Profile sections">@foreach (var tab in Tabs) { <a class="ts-tab" href="/profile?tab=@tab.Key" aria-current="@(Model.Tab == tab.Key ? "page" : null)">@tab.Title</a> }</nav>
    @if (Model.Tab == "profile")
    {
        <div class="ts-profile-settings">
            @await RenderPartialAsync(TerraScale.Dashboard.Features.Profile.SignInMethodsView.Create(Model))
            <section class="ts-card" id="profile-details" aria-labelledby="profile-details-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="profile-details-title">Profile details</h2><p class="ts-card-description">Update the account information shown across TerraScale.</p></div></header><div class="ts-card-body"><form class="ts-form" method="post" action="/api/v1/dashboard/profile"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><div class="ts-field"><label class="ts-label" for="displayName">Display name</label><input class="ts-input" id="displayName" name="name" value="@(Model.DraftName ?? Model.Shell.Context.Account.Name)" autocomplete="name" maxlength="128" required /></div><div class="ts-field"><label class="ts-label" for="phoneNumber">Phone number (optional)</label><input class="ts-input" id="phoneNumber" name="phoneNumber" type="tel" value="@(Model.DraftPhone ?? Model.Shell.Context.Account.Phone)" autocomplete="tel" inputmode="tel" /></div><div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Save profile</button></div></form></div></section>
            <section class="ts-card" id="profile-language" aria-labelledby="profile-language-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="profile-language-title">Language</h2><p class="ts-card-description">Choose the language used by onboarding and the Dashboard.</p></div></header><div class="ts-card-body"><form method="post" action="/api/v1/dashboard/profile/language" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><div class="ts-field"><label class="ts-label" for="interfaceLanguage">Interface language</label><select class="ts-select" id="interfaceLanguage" name="locale"><option value="en" selected="@(Model.Shell.Context.Account.Locale == "en" ? "selected" : null)">English</option><option value="pt-BR" selected="@(Model.Shell.Context.Account.Locale == "pt-BR" ? "selected" : null)">Português</option></select></div><div class="ts-form-actions"><button class="ts-btn ts-btn-secondary" type="submit">Save language</button></div></form></div></section>
            <section class="ts-card" id="profile-posture" aria-labelledby="profile-posture-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="profile-posture-title">Security posture</h2><p class="ts-card-description">Current account role and sessions.</p></div></header><div class="ts-card-body"><dl class="ts-kv ts-profile-posture"><dt>Active organization role</dt><dd><span class="ts-badge ts-badge-info">@(Model.Shell.Context.Role == "" ? "Unavailable" : Model.Shell.Context.Role)</span></dd><dt>Active sessions</dt><dd><span class="ts-badge ts-badge-neutral">@(Model.Sessions?.Count.ToString() ?? "Not loaded")</span></dd></dl></div></section>
        <section class="ts-card" id="profile-roles" aria-labelledby="profile-roles-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="profile-roles-title">Roles and permissions</h2><p class="ts-card-description">Common resource capabilities for your current organization and project scope. Billing, platform-admin, and other routes may apply separate checks.</p></div></header><div class="ts-card-body"><div class="ts-grid-2"><section class="ts-stack-sm" aria-labelledby="profile-role-list-title"><h3 class="ts-label" id="profile-role-list-title">Roles</h3>@if (Model.Shell.Context.Role.Length == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No active organization role</p><p class="ts-empty-detail">No role is available for the current organization membership.</p></div> } else { <div class="ts-row ts-profile-claims"><span class="ts-badge ts-badge-neutral">@Model.Shell.Context.Role</span></div> }</section><section class="ts-stack-sm" aria-labelledby="profile-permission-list-title"><h3 class="ts-label" id="profile-permission-list-title">Common capabilities</h3>@if (Model.Permissions.Length == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No scoped permissions</p><p class="ts-empty-detail">No resource capabilities are available for the current organization and project scope.</p></div> } else { <div class="ts-row ts-profile-claims">@foreach (var permission in Model.Permissions) { <span class="ts-badge ts-badge-neutral">@permission</span> }</div> }</section></div></div></section>
        <section class="ts-card" id="profile-context" aria-labelledby="profile-context-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="profile-context-title">Session context</h2><p class="ts-card-description">Authenticated account and selected scope.</p></div></header><div class="ts-card-body"><dl class="ts-kv"><dt>User ID</dt><dd class="ts-mono">@Model.Shell.Context.UserId</dd><dt>Account ID</dt><dd class="ts-mono">@Model.Shell.Context.Account.Id</dd><dt>Email</dt><dd>@Model.Shell.Context.Account.Email</dd><dt>Active organization</dt><dd class="ts-mono">@Model.Shell.Context.Account.ActiveOrganizationId</dd><dt>Dashboard project</dt><dd class="ts-mono">@Model.Shell.Context.Account.ActiveProjectId</dd><dt>Language</dt><dd>@Model.Shell.Context.Account.Locale</dd></dl></div></section>
        </div>
    }
    else if (Model.Tab == "sessions")
    {
        <section class="ts-card ts-card-flush" id="profile-sessions" aria-labelledby="profile-sessions-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="profile-sessions-title">Active sessions</h2><p class="ts-card-description">Read-only local dashboard sessions. Session details are limited to the values available here.</p></div></header><div class="ts-card-body">@if (Model.Sessions is not { Count: > 0 }) { <div class="ts-empty" role="status"><p class="ts-empty-title">No active sessions</p><p class="ts-empty-detail">No active local dashboard sessions were returned.</p></div> } else { <div class="ts-table-wrap" tabindex="0" role="region" aria-label="Active sessions table. Scroll horizontally to see all columns."><table class="ts-table"><caption class="ts-sr-only">Active local dashboard sessions with their current status and expiry.</caption><thead><tr><th scope="col">Status</th><th scope="col">Session ID</th><th scope="col">Expires</th></tr></thead><tbody>@foreach (var session in Model.Sessions ?? Array.Empty<TerraScale.Dashboard.Platform.Identity.DashboardSessionInfo>()) { <tr><td><span class="ts-badge @(session.Current ? "ts-badge-info" : "ts-badge-neutral")">@(session.Current ? "Current session" : "Active")</span></td><td class="ts-table-mono">@session.Id</td><td>@session.ExpiresAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</td></tr> }</tbody></table></div> }</div></section>
    }
    else if (Model.Tab == "security")
    {
        <section class="ts-card" id="profile-sign-in" aria-labelledby="profile-sign-in-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="profile-sign-in-title">Password</h2><p class="ts-card-description">Your password is managed by TerraScale sign-in, not the dashboard. Change it with a password reset.</p></div></header><div class="ts-card-body"><div class="ts-form-actions"><a class="ts-btn ts-btn-secondary" href="@AccountUrl">Change password</a></div></div></section>
        <section class="ts-card" id="profile-mfa" aria-labelledby="profile-mfa-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="profile-mfa-title">Two-factor authentication</h2><p class="ts-card-description">Two-factor authentication, its recovery codes and turning it off are managed by TerraScale sign-in.</p></div></header><div class="ts-card-body">
            @if (Model.Mfa is not { } mfa) { <p class="ts-meta" role="status">Two-factor status is unavailable right now.</p><div class="ts-form-actions"><a class="ts-btn ts-btn-secondary" href="@TerraScale.Dashboard.Features.Auth.TsAuthGateway.ManageMfaUrl">Manage two-factor</a></div> }
            else if (mfa.Enabled) { <dl class="ts-kv"><dt>Status</dt><dd><span class="ts-badge ts-badge-success">Enabled</span></dd><dt>Recovery codes remaining</dt><dd class="ts-num">@mfa.RecoveryCodesRemaining</dd></dl><div class="ts-form-actions"><a class="ts-btn ts-btn-secondary" href="@mfa.ManageUrl">Manage two-factor</a></div> }
            else { <dl class="ts-kv"><dt>Status</dt><dd><span class="ts-badge ts-badge-warning">Not enabled</span></dd></dl><div class="ts-form-actions"><a class="ts-btn ts-btn-primary" href="@mfa.ManageUrl">Set up two-factor</a></div> }
        </div></section>
    }
    else if (Model.Tab == "danger")
    {
        <section class="ts-card ts-card-flush" id="profile-danger" aria-labelledby="profile-danger-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="profile-danger-title">Revoke access tokens</h2><p class="ts-card-description">Assistants using a revoked token lose access immediately. This cannot be undone.</p></div></header><div class="ts-card-body">
            @if (Model.Tokens is not { Count: > 0 }) { <div class="ts-empty" role="status"><p class="ts-empty-title">No access tokens</p><p class="ts-empty-detail">No live personal access tokens need revoking.</p></div> }
            else
            {
                <div class="ts-table-wrap" tabindex="0" role="region" aria-label="Revocable access tokens table. Scroll horizontally to see all columns."><table class="ts-table"><caption class="ts-sr-only">Your live personal access tokens with their revoke action.</caption><thead><tr><th scope="col">Name</th><th scope="col">Token</th><th scope="col">Expires</th><th scope="col"><span class="ts-sr-only">Actions</span></th></tr></thead><tbody>@foreach (var token in Model.Tokens)
                {
                    <tr><td class="ts-strong">@token.Name</td><td class="ts-table-mono">tspat_…@token.LastFour</td><td>@token.ExpiresAt.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</td><td><button class="ts-btn ts-btn-danger ts-btn-sm" type="button" command="show-modal" commandfor="revoke-@token.Id"><span>Revoke</span></button><dialog id="revoke-@token.Id" class="ts-dialog" closedby="any" aria-labelledby="revoke-@token.Id-title"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="revoke-@token.Id-title">Revoke “@token.Name”?</h2><p class="ts-dialog-description">Assistants using this token lose access immediately. This cannot be undone.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="revoke-@token.Id">@Icons.Render("X", 18)</button></header><form method="post" action="/api/v1/dashboard/profile/access-tokens/@token.Id/revoke"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><div class="ts-dialog-actions"><button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="revoke-@token.Id">Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Revoke token</button></div></form></div></dialog></td></tr>
                }</tbody></table></div>
            }
        </div></section>
        <section class="ts-card" id="profile-delete-account" aria-labelledby="profile-delete-account-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="profile-delete-account-title">Delete account</h2><p class="ts-card-description">Permanently deletes your sign-in, sessions, access tokens and memberships, and every organization you alone belong to, including your Personal organization. Their projects, databases and data are automatically erased from all replicas. Retained backups may remain until their retention period expires. Active paid plans of those organizations end immediately, without a refund. Organizations shared with other members keep their data and plans. This cannot be undone.</p></div></header><div class="ts-card-body"><div class="ts-form-actions"><button class="ts-btn ts-btn-danger" type="button" command="show-modal" commandfor="delete-account">@Icons.Render("Trash2", 15)<span>Delete account</span></button></div><dialog id="delete-account" class="ts-dialog" closedby="any" aria-labelledby="delete-account-title"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="delete-account-title">Delete your account?</h2><p class="ts-dialog-description">Every organization you alone belong to, including your Personal organization, is deleted. Its projects, databases and data are automatically erased from all replicas. Retained backups may remain until their retention period expires. Paid plans of those organizations end immediately, without a refund. Shared organizations keep their data and plans; transfer ownership first if you are their only owner. This cannot be undone.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="delete-account">@Icons.Render("X", 18)</button></header><form method="post" action="/api/v1/dashboard/profile/delete" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><div class="ts-field"><label class="ts-label" for="delete-account-email">Enter “@Model.Shell.Context.Account.Email” to confirm</label><input class="ts-input" id="delete-account-email" name="email" type="email" autocomplete="off" required /></div><div class="ts-dialog-actions"><button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="delete-account">Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Delete account</button></div></form></div></dialog></div></section>
    }
    else
    {
        @if (Model.CreatedToken is { } created)
        {
            <div class="ts-alert ts-alert-success" role="status" aria-live="polite" id="access-token-created" data-init="history.replaceState(null, '', '/profile?tab=access-tokens')"><p class="ts-alert-title">Access token “@created.Token.Name” created</p><p class="ts-alert-body">Copy the token now. It is shown only once and cannot be displayed again.</p><label class="ts-label" for="access-token-secret">New access token</label><input class="ts-input ts-mono" id="access-token-secret" value="@created.Secret" readonly autocomplete="off" spellcheck="false" /></div>
        }
            <section class="ts-card ts-card-flush" id="profile-access-tokens" aria-labelledby="profile-access-tokens-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="profile-access-tokens-title">Personal access tokens</h2><p class="ts-card-description">Tokens let AI assistants act as you through the TerraScale MCP server, with the same permissions you have in the dashboard.</p></div></header><div class="ts-card-body">
                @if (Model.Tokens is not { Count: > 0 }) { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("KeyRound", 16)</span><p class="ts-empty-title">No access tokens</p><p class="ts-empty-detail">Create a token to connect Claude, Cursor, or another MCP client.</p></div> }
                else
                {
                    <div class="ts-table-wrap" tabindex="0" role="region" aria-label="Access tokens table. Scroll horizontally to see all columns."><table class="ts-table"><caption class="ts-sr-only">Your live personal access tokens with their expiry.</caption><thead><tr><th scope="col">Name</th><th scope="col">Token</th><th scope="col">Created</th><th scope="col">Expires</th></tr></thead><tbody>@foreach (var token in Model.Tokens)
                    {
                        <tr><td class="ts-strong">@token.Name</td><td class="ts-table-mono">tspat_…@token.LastFour</td><td>@token.CreatedAt.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</td><td>@token.ExpiresAt.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</td></tr>
                    }</tbody></table></div>
                }
            </div></section>
            <div class="ts-grid-2">
            <section class="ts-card" id="profile-access-token-create" aria-labelledby="profile-access-token-create-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="profile-access-token-create-title">Create access token</h2><p class="ts-card-description">Name the token after the assistant or machine that will use it.</p></div></header><div class="ts-card-body"><form class="ts-form" method="post" action="/api/v1/dashboard/profile/access-tokens"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><div class="ts-field"><label class="ts-label" for="accessTokenName">Token name</label><input class="ts-input" id="accessTokenName" name="name" maxlength="64" placeholder="Claude on work laptop" autocomplete="off" required /></div><div class="ts-field"><label class="ts-label" for="accessTokenExpiry">Expiration</label><select class="ts-select" id="accessTokenExpiry" name="expiresInDays"><option value="7">7 days</option><option value="30">30 days</option><option value="90" selected>90 days</option><option value="365">1 year</option></select></div><p class="ts-field-hint">A token acts as you until it expires, so creating one confirms your sign-in with TerraScale first.</p><div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Create token</button></div></form></div></section>
            <section class="ts-card" id="profile-mcp-config" aria-labelledby="profile-mcp-config-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="profile-mcp-config-title">Connect an MCP client</h2><p class="ts-card-description">Add the TerraScale server to your assistant's MCP settings and send the token as a bearer credential.</p></div></header><div class="ts-card-body"><div class="ts-snippet" data-signals="{_mcpCopy: ''}"><div class="ts-snippet-header ts-row-between"><span>mcp.json</span><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-on:click="(navigator.clipboard?.writeText(document.getElementById('profile-mcp-json').textContent) ?? Promise.reject()).then(() => { $_mcpCopy = 'Copied'; setTimeout(() => $_mcpCopy = '', 2000) }, () => $_mcpCopy = 'Copy failed')">@Icons.Render("Copy", 14)<span data-text="$_mcpCopy || 'Copy'">Copy</span></button></div><pre class="ts-snippet-body" id="profile-mcp-json"><code>@McpConfig</code></pre></div></div></section>
        </div>
    }
</main>
@functions {
    public ShellModel LayoutModel => Model.Shell;
    private string McpConfig => System.Text.Json.JsonSerializer.Serialize(new { mcpServers = new { terrascale = new { type = "http", url = $"{HttpContext!.Request.Scheme}://{HttpContext.Request.Host}/mcp", headers = new { Authorization = "Bearer " + (Model.CreatedToken?.Secret ?? "<your-access-token>") } } } }, new System.Text.Json.JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
    private string Initials => string.Concat(Model.Shell.Context.Account.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();
    private static readonly string AccountUrl = "https://auth.terrascale.tech/ui/terrascale/reset?next=" + Uri.EscapeDataString(TerraScale.Dashboard.Features.Auth.TsAuthGateway.AccountSecurityReturn);
    private static readonly (string Key, string Title)[] Tabs = [("profile", "Profile"), ("security", "Security"), ("sessions", "Sessions"), ("access-tokens", "Access tokens"), ("danger", "Danger")];
}
