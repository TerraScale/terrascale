@inherits RazorSlice<TerraScale.Dashboard.Features.Profile.ProfilePage>
@using TerraScale.Dashboard.Features.Auth
<section class="ts-card" id="profile-sign-in-methods" aria-labelledby="profile-methods-title">
    <header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="profile-methods-title">Sign-in methods</h2></div></header>
    <div class="ts-card-body ts-stack-sm">
        @if (Model.Providers is null)
        {
            <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">Sign-in methods are unavailable.</p><a class="ts-link" href="/profile#profile-sign-in-methods">Retry</a></div>
        }
        else if (Model.Providers.Count == 0)
        {
            <div class="ts-empty" role="status"><p class="ts-empty-title">Sign in with email only.</p></div>
        }
        else
        {
            <ul class="ts-profile-methods" aria-label="Linked sign-in providers">
                @foreach (var provider in Model.Providers)
                {
                    <li class="ts-profile-method"><div><span class="ts-strong">@TsAuthGateway.ProviderName(provider)</span> <span class="ts-badge ts-badge-success">Linked</span></div><a class="ts-btn ts-btn-secondary ts-btn-sm" href="/profile?unlink=@provider#profile-sign-in-methods" aria-label="Unlink @TsAuthGateway.ProviderName(provider)">Unlink</a></li>
                }
            </ul>
            @if (Model.ConfirmProvider is { } selected && Model.Providers.Contains(selected))
            {
                <form method="post" action="/api/v1/dashboard/profile/providers/@selected/unlink" class="ts-form ts-profile-method-confirm" aria-labelledby="unlink-provider-title">
                    <input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
                    <h3 class="ts-card-title" id="unlink-provider-title">Unlink @TsAuthGateway.ProviderName(selected)?</h3>
                    <p class="ts-meta">This signs you out on every device and revokes existing tokens. Sign in again using email or another linked provider.</p>
                    <div>@if (Model.CodeWait is { } wait) { <button class="ts-btn ts-btn-secondary" type="submit" form="unlink-code-form" disabled>Email me a code (wait @wait s)</button> } else { <button class="ts-btn ts-btn-secondary" type="submit" form="unlink-code-form">Email me a code</button> }</div>
                    <div class="ts-field"><label class="ts-label" for="unlink-provider-code">Email code</label><input class="ts-input ts-mono" id="unlink-provider-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[\s\u0085]*[0-9]{6}[\s\u0085]*" placeholder="123456" required title="Enter the 6-digit code" /></div>
                    <div class="ts-form-actions"><a class="ts-btn ts-btn-secondary" href="/profile#profile-sign-in-methods">Cancel</a><button class="ts-btn ts-btn-danger" type="submit">Unlink @TsAuthGateway.ProviderName(selected) and sign out</button></div>
                </form>
                <form id="unlink-code-form" method="post" action="/api/v1/dashboard/profile/providers/@selected/code" hidden><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /></form>
            }
        }
    </div>
</section>
