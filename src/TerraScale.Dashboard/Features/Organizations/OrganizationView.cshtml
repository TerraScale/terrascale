@inherits RazorSlice<TerraScale.Dashboard.Features.Organizations.OrganizationPage>
@implements IUsesLayout<TerraScale.Dashboard.UI.Slices.ShellDocument, ShellModel>
@if (Model.Tab is "members" or "invitations")
{
    @(await RenderPartialAsync<TerraScale.Dashboard.Features.Organizations.Members.OrganizationAccessPage, TerraScale.Dashboard.Features.Organizations.OrganizationPage>(Model))
}
else
{
<main class="ts-page @(Model.Tab == "audit" ? "ts-audit-page" : "")">
    <h1 class="ts-sr-only">@(Model.Shell.Context.Organization?.Name ?? "Organization")</h1><div class="ts-page-actions"></div>
    @if (Model.Error.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
    @if (Model.InvitationLink.Length > 0) { <section class="ts-alert ts-alert-success" aria-labelledby="invitation-link-title" data-init="history.replaceState(null, '', '/organization?tab=members')"><p class="ts-alert-title" id="invitation-link-title">Invitation created</p><p class="ts-alert-body">Copy this link and send it to the invitee. It works once and expires in seven days.</p><a id="invitation-link" class="ts-link ts-break" href="@Model.InvitationLink" rel="noreferrer">@Model.InvitationLink</a></section> }
    <nav class="ts-tabs" aria-label="Organization sections">@foreach (var tab in Tabs) { <a class="ts-tab" href="@tab.Url" aria-current="@(Model.Tab == tab.Key || Model.Tab == "invitations" && tab.Key == "members" ? "page" : null)"><span>@tab.Label</span></a> }</nav>
    @if (Model.Shell.Context.Organization is not { } org)
    { <div class="ts-empty" role="status"><p class="ts-empty-title">Select an organization</p><p class="ts-empty-detail">Choose an organization from the workspace menu.</p></div> }
    else if (Model.Tab == "billing")
    {
        @(await RenderPartialAsync<TerraScale.Dashboard.Features.Billing.BillingSummary, TerraScale.Dashboard.Features.Billing.BillingPage>(Model.Billing!))
    }
    else if (Model.Tab == "organization")
    {
        <dl class="ts-stats" aria-label="Organization summary">@foreach (var stat in new[] { ("Projects", org.Projects.Count.ToString(), "Projects in this workspace"), ("Members", org.Members.Count.ToString(), "People with organization access"), ("Invitations", Model.InvitationRows.Count.ToString(), "Current and historical invitations"), ("Created", org.CreatedAt.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture), "Organization record") }) { <div class="ts-stat"><dt class="ts-stat-label">@stat.Item1</dt><dd class="ts-stat-value">@stat.Item2</dd><dd class="ts-stat-detail">@stat.Item3</dd></div> }</dl>
        <div class="ts-split"><section class="ts-card" id="organization-details" aria-labelledby="organization-details-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="organization-details-title">Organization details</h2><p class="ts-card-description">Current tenant context</p></div><div class="ts-card-actions"><a class="ts-btn ts-btn-primary" href="/organization?newOrganization=organization">@Icons.Render("Plus", 16)<span>Create organization</span></a></div></header><div class="ts-card-body"><dl class="ts-kv"><dt>Name</dt><dd>@org.Name</dd><dt>Status</dt><dd><span class="ts-badge ts-badge-success">@TerraScale.Dashboard.Features.Organizations.OrganizationPage.RoleLabel(org.Status)</span></dd><dt>Organization ID</dt><dd class="ts-mono">@org.Id</dd><dt>Current project</dt><dd class="ts-mono">@(Model.Shell.Context.Project?.Id ?? "Not selected")</dd><dt>Created</dt><dd>@org.CreatedAt.ToString("MMM d, yyyy HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</dd><dt>Signed-in user</dt><dd>@Model.Shell.Context.Account.Email</dd></dl><div class="ts-alert ts-alert-success" role="status"><p class="ts-alert-body">Organization access is enforced by the API session and project context.</p></div>
        @if (Model.CanManage) { <button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" command="show-modal" commandfor="rename-organization">@Icons.Render("Pencil", 14)<span>Edit name</span></button><dialog id="rename-organization" class="ts-dialog" closedby="any" aria-labelledby="rename-organization-title"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="rename-organization-title">Rename organization</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="rename-organization">@Icons.Render("X", 18)</button></header><form method="post" action="/api/v1/dashboard/organization/rename" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><div class="ts-field"><label class="ts-label" for="organizationName">Organization name</label><input class="ts-input" id="organizationName" name="name" value="@org.Name" required /></div><div class="ts-dialog-actions"><button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="rename-organization">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Save name</button></div></form></div></dialog> }
        </div></section><div class="ts-stack"><section class="ts-card" id="organization-ownership" aria-labelledby="organization-ownership-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="organization-ownership-title">Ownership</h2><p class="ts-card-description">Leave, transfer, or delete this organization.</p></div></header><div class="ts-card-body">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Organizations.Lifecycle.OrganizationOwnershipView, TerraScale.Dashboard.Features.Organizations.OrganizationPage>(Model))</div></section></div></div>
    }
    else if (Model.Tab == "projects")
    {
        <section class="ts-card ts-card-flush" id="projects" aria-labelledby="projects-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="projects-title">Projects</h2><p class="ts-card-description">@(org.Kind == "personal" ? "Personal workspace" : "Business workspace") · Projects returned by the TerraScale Dashboard API</p></div>@if (Model.CanProvision) { <div class="ts-card-actions"><button class="ts-btn ts-btn-primary ts-btn-sm" type="button" command="show-modal" commandfor="create-project">@Icons.Render("Plus", 16)<span>Create project</span></button></div> }</header><div class="ts-card-body">
        @if (org.Projects.Count == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No projects returned</p><p class="ts-empty-detail">The API did not return projects for this organization.</p></div> }
        else { <div class="ts-table-wrap" tabindex="0" role="region" aria-label="Organization projects"><table class="ts-table"><thead><tr><th>Project</th><th>Slug</th><th>Status</th><th>Backup region</th><th>Created</th><th class="ts-table-actions">Actions</th></tr></thead><tbody>@foreach (var project in org.Projects.Values.OrderBy(item => item.Name))
        { @(await RenderPartialAsync<TerraScale.Dashboard.Features.Organizations.Projects.OrganizationProjectRow, TerraScale.Dashboard.Features.Organizations.Projects.ProjectDialogModel>(new(Model, project))) }
        </tbody></table></div> }</div></section>

    }
    else if (Model.Tab is "members" or "invitations")
    {
        @(await RenderPartialAsync<TerraScale.Dashboard.Features.Organizations.OrganizationMembers, TerraScale.Dashboard.Features.Organizations.OrganizationPage>(Model))
    }
    else if (Model.Tab == "audit") { @(await RenderPartialAsync<TerraScale.Dashboard.Features.Organizations.Audit.OrganizationAuditView, TerraScale.Dashboard.Features.Organizations.OrganizationPage>(Model)) }
    @if (Model.Tab == "projects" && Model.CanProvision) { @(await RenderPartialAsync<TerraScale.Dashboard.Features.Organizations.Projects.ProjectDialog, TerraScale.Dashboard.Features.Organizations.Projects.ProjectDialogModel>(new(Model))) }
    @if (Model.OpenCreateOrganization) { @(await RenderPartialAsync<TerraScale.Dashboard.Features.Organizations.Wizard.OrganizationWizardView, TerraScale.Dashboard.Features.Organizations.OrganizationPage>(Model)) }
</main>
}
@functions {
    public ShellModel LayoutModel => Model.Shell;
    private static readonly (string Key, string Label, string Url)[] Tabs = [("organization", "Organization", "/organization"), ("members", "Members", "/organization?tab=members"), ("projects", "Projects", "/organization?tab=projects"), ("billing", "Billing", "/organization?tab=billing"), ("audit", "Audit", "/organization?tab=audit")];
}
