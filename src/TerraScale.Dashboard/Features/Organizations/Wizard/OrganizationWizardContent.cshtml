@inherits RazorSlice<TerraScale.Dashboard.Features.Organizations.Wizard.OrganizationWizardModel>
<div class="ts-stack-lg"><div class="ts-stack-sm"><div class="ts-row-between ts-meta"><span>Step @Model.Step of 3</span><span>@Model.Progress%</span></div><div class="ts-progress" role="progressbar" aria-label="New organization setup progress" aria-valuenow="@Model.Progress" aria-valuemin="0" aria-valuemax="100"><div class="ts-progress-bar" data-progress="@Model.Progress"></div></div><nav aria-label="New organization steps"><ol class="ts-org-steps">@foreach (var step in new[] { ("organization", "Organization", 1), ("payment", "Billing", 2), ("project", "Project", 3) }) { <li class="ts-org-step @(Model.Step == step.Item3 ? "ts-org-step-current" : Model.Step > step.Item3 ? "ts-org-step-complete" : "")" aria-current="@(Model.Step == step.Item3 ? "step" : null)"><span class="ts-org-step-icon" aria-hidden="true">@if (Model.Step > step.Item3) { @Icons.Render("Check", 14) } else { @step.Item3 }</span><span class="ts-org-step-label">@step.Item2</span><span class="ts-sr-only">@(Model.Step == step.Item3 ? "Current" : Model.Step > step.Item3 ? "Completed" : "Not started")</span></li> }</ol></nav></div>
@if (Model.Page.PaymentCanceled) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Payment setup canceled</p><p class="ts-alert-body">No organization was created. Choose a plan to try checkout again.</p></div> }
@if (Model.Page.Error.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Page.Error</p></div> }
@if (Model.Page.PendingCheckoutDraftId.Length > 0)
{
    <form class="ts-form" method="post" action="/api/v1/dashboard/organization/new-organization"><input type="hidden" name="_csrf" value="@Model.Page.Shell.CsrfToken" /><input type="hidden" name="step" value="cancel-checkout" /><input type="hidden" name="draft_id" value="@Model.Page.PendingCheckoutDraftId" /><button class="ts-btn ts-btn-danger" type="submit">Cancel pending checkout</button></form>
}
else
{
<section class="ts-stack" aria-labelledby="@Model.Id("organization-step-title")"><header class="ts-stack-sm"><h3 class="ts-section-title" id="@Model.Id("organization-step-title")">@(Model.Step == 2 ? "Set up billing" : Model.Step == 3 ? "Create the first project" : "Create organization")</h3></header><form class="ts-form" method="post" action="/api/v1/dashboard/organization/new-organization"><input type="hidden" name="_csrf" value="@Model.Page.Shell.CsrfToken" /><input type="hidden" name="step" value="@(Model.Step == 2 ? "payment-method" : Model.Step == 3 ? "project" : "organization")" /><input type="hidden" name="organizationID" value="@Model.Page.Shell.Context.Organization?.Id" />
@if (Model.Step == 2)
{
    <input type="hidden" name="name" value="@Model.Page.OrganizationDraftName" />
    <input type="hidden" name="interval" value="@Model.Page.OrganizationDraftInterval" />
    <fieldset><legend class="ts-label">Choose a plan</legend><div class="ts-org-plans">@foreach (var plan in PlanCatalog.Plans.Where(plan => plan.PriceCents > 0)) { <label class="ts-org-plan" for="@Model.Id("organization-plan-" + plan.Key)"><input type="radio" id="@Model.Id("organization-plan-" + plan.Key)" name="plan" value="@plan.Key" checked="@(plan.Key == (Model.Page.OrganizationDraftPlan.Length > 0 ? Model.Page.OrganizationDraftPlan : "starter") ? "checked" : null)" required /><span class="ts-strong">@plan.Name</span><span class="ts-org-plan-price"><strong>@plan.Price</strong> @plan.PriceUnit</span><span>@plan.BillingDescription</span>@foreach (var allowance in new[] { plan.StorageAllowance, plan.OperationsAllowance, plan.EgressAllowance, plan.DatabaseAllowance, plan.MemberAllowance }) { <span>@allowance</span> }</label> }</div></fieldset><p class="ts-meta">Enterprise: @PlanCatalog.EnterpriseBilling <a href="https://terrascale.tech/contact" @(ExternalLink.Attributes)>Contact sales@(ExternalLink.Hint)</a>.</p>
}
else
{
    <div class="ts-field"><label class="ts-label" for="@Model.Id("new-organization-name")">@(Model.Step == 3 ? "Project name" : "Organization name")</label><input class="ts-input" id="@Model.Id("new-organization-name")" name="name" value="@(Model.Step == 3 ? Model.Page.ProjectDraftName : Model.Page.OrganizationDraftName)" minlength="1" maxlength="128" pattern="(?=.*[\p{L}\p{Nd}])[^\p{Cc}]+" placeholder="@(Model.Step == 3 ? "Production" : "Acme Labs")" autocomplete="@(Model.Step == 3 ? "off" : "organization")" required /></div>
    @if (Model.Step == 3)
    {
        <div class="ts-field"><span class="ts-label" id="@Model.Id("wizard-project-regions-label")">Regions</span>@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.RegionMap, RegionMapModel>(RegionMapModel.Select(Model.Id("wizard-project-regions"), Model.Page.Regions, Model.Page.Regions.Where((Model.Page.ProjectDraftRegions ?? Model.Page.Regions).Contains)) with { LabelledBy = Model.Id("wizard-project-regions-label"), Minimum = "A project needs one region." }))</div>
    }
}
<div class="ts-form-actions"><button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">@(Model.Step == 2 ? "Continue to checkout" : Model.Step == 3 ? "Create project" : "Continue to billing")</button></div></form></section>
}
</div>
