@inherits RazorSlice<TerraScale.Dashboard.Features.Organizations.Wizard.OrganizationWizardModel>
<div class="ts-stack-lg"><div class="ts-stack-sm"><div class="ts-row-between ts-meta"><span>Step @Model.Step of 3</span><span>@Model.Progress%</span></div><div class="ts-progress" role="progressbar" aria-label="New organization setup progress" aria-valuenow="@Model.Progress" aria-valuemin="0" aria-valuemax="100"><div class="ts-progress-bar" data-progress="@Model.Progress"></div></div><nav aria-label="New organization steps"><ol class="ts-org-steps">@foreach (var step in new[] { ("organization", "Organization", 1), ("payment", "Billing", 2), ("project", "Project", 3) }) { <li class="ts-org-step @(Model.Step == step.Item3 ? "ts-org-step-current" : Model.Step > step.Item3 ? "ts-org-step-complete" : "")" aria-current="@(Model.Step == step.Item3 ? "step" : null)"><span class="ts-org-step-icon" aria-hidden="true">@if (Model.Step > step.Item3) { @Icons.Render("Check", 14) } else { @step.Item3 }</span><span class="ts-org-step-label">@step.Item2</span><span class="ts-sr-only">@(Model.Step == step.Item3 ? "Current" : Model.Step > step.Item3 ? "Completed" : "Not started")</span></li> }</ol></nav></div>
@if (Model.Page.PaymentCanceled) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Payment setup canceled</p><p class="ts-alert-body">No payment method was changed. Choose a plan to try checkout again.</p></div> }
@if (Model.Page.Error.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Page.Error</p></div> }
<section class="ts-stack" aria-labelledby="@Model.Id("organization-step-title")"><header class="ts-stack-sm"><h3 class="ts-section-title" id="@Model.Id("organization-step-title")">@(Model.Step == 2 ? "Set up billing" : Model.Step == 3 ? "Create the first project" : "Create organization")</h3><p class="ts-muted">@(Model.Step == 2 ? "This business organization needs its own paid billing before it can create projects. Your Personal allowance stays separate." : Model.Step == 3 ? "Choose a name and deployment placement for this organization’s first project." : "A business organization has its own paid billing, members and projects.")</p></header><form class="ts-form" method="post" action="/api/v1/dashboard/organization/new-organization"><input type="hidden" name="_csrf" value="@Model.Page.Shell.CsrfToken" /><input type="hidden" name="step" value="@(Model.Step == 2 ? "payment-method" : Model.Step == 3 ? "project" : "organization")" /><input type="hidden" name="organizationID" value="@Model.Page.Shell.Context.Organization?.Id" />
@if (Model.Step == 2)
{
    <fieldset><legend class="ts-label">Choose a plan</legend><div class="ts-org-plans">@foreach (var plan in PlanCatalog.Plans.Where(plan => plan.PriceCents > 0)) { <label class="ts-org-plan" for="@Model.Id("organization-plan-" + plan.Key)"><input type="radio" id="@Model.Id("organization-plan-" + plan.Key)" name="plan" value="@plan.Key" checked="@(plan.Key == "starter" ? "checked" : null)" required /><span class="ts-strong">@plan.Name</span><span class="ts-org-plan-price"><strong>@plan.Price</strong> @plan.PriceUnit</span><span class="ts-meta">@plan.BillingDescription</span>@foreach (var allowance in new[] { plan.StorageAllowance, plan.OperationsAllowance, plan.EgressAllowance, plan.DatabaseAllowance, plan.MemberAllowance }) { <span class="ts-meta">@allowance</span> }@if (plan.TrialDays > 0) { <span class="ts-badge ts-badge-success">@plan.TrialDays-day free trial</span> }</label> }</div></fieldset><p class="ts-meta">Enterprise: @PlanCatalog.EnterpriseBilling <a href="https://terrascale.tech/contact" @(ExternalLink.Attributes)>Contact sales@(ExternalLink.Hint)</a>. Continue to Stripe Checkout to add a payment method. Projects can be created once Stripe confirms billing.</p>
}
else
{
    <div class="ts-field"><label class="ts-label" for="@Model.Id("new-organization-name")">@(Model.Step == 3 ? "Project name" : "Organization name")</label><input class="ts-input" id="@Model.Id("new-organization-name")" name="name" maxlength="128" placeholder="@(Model.Step == 3 ? "Production" : "Acme Labs")" autocomplete="@(Model.Step == 3 ? "off" : "organization")" required /></div>
    @if (Model.Step == 3)
    {
        <fieldset class="ts-org-placement"><legend class="ts-label">Project regions</legend><div class="ts-field"><label class="ts-label" for="@Model.Id("wizard-project-regions")">Allowed regions</label>@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.RegionPicker, RegionMapField>(new(Model.Id("wizard-project-regions"), string.Join(' ', Model.Page.Regions), Available: Model.Page.Regions)))<select class="ts-select" id="@Model.Id("wizard-project-regions")" name="regions" multiple size="@Math.Max(1, Model.Page.Regions.Count)" required>@foreach (var region in Model.Page.Regions.OrderBy(Regions.Rank)) { <option value="@region" selected>@(Regions.Name(region) is { Length: > 0 } name ? $"{region.ToLowerInvariant()} · {name}" : region.ToLowerInvariant())</option> }</select><p class="ts-hint">Use your browser’s native picker to select one or more regions. This control also works without the map.</p></div>@foreach (var field in new[] { ("region", "Primary region"), ("backupRegion", "Backup region") }) { <div class="ts-field"><label class="ts-label" for="@Model.Id("wizard-project-" + field.Item1)">@field.Item2</label><select class="ts-select" id="@Model.Id("wizard-project-" + field.Item1)" name="@field.Item1" required>@foreach (var region in Model.Page.Regions.OrderBy(Regions.Rank)) { <option value="@region" selected="@(region == Model.Page.Regions.FirstOrDefault() ? "selected" : null)">@(Regions.Name(region) is { Length: > 0 } name ? $"{region.ToLowerInvariant()} · {name}" : region.ToLowerInvariant())</option> }</select></div> }</fieldset>
    }
}
<div class="ts-form-actions"><button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">@(Model.Step == 2 ? "Continue to checkout" : Model.Step == 3 ? "Create project" : "Create organization")</button></div></form></section></div>
