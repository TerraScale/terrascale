@inherits RazorSlice<TerraScale.Dashboard.Features.Organizations.OrganizationPage>
<dialog id="create-organization" class="ts-dialog ts-org-wizard" data-page-url="@Model.Shell.ReturnUrl" data-init="el.showModal()" data-on:close="history.replaceState(null, '', el.dataset.pageUrl)" aria-labelledby="create-organization-title"><div class="ts-dialog-content"><div class="ts-row-between ts-org-wizard-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="create-organization-title">Create organization</h2></div><button class="ts-icon-btn" type="button" aria-label="Close create organization" command="close" commandfor="create-organization">@Icons.Render("X", 18)</button></div>@(await RenderPartialAsync<TerraScale.Dashboard.Features.Organizations.Wizard.OrganizationWizardContent, TerraScale.Dashboard.Features.Organizations.Wizard.OrganizationWizardModel>(new(Model, "modal")))</div></dialog>
<noscript><section class="ts-card" id="create-organization-fallback" aria-labelledby="create-organization-fallback-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="create-organization-fallback-title">Create organization</h2></div><div class="ts-card-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="/organization">Close setup</a></div></header><div class="ts-card-body">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Organizations.Wizard.OrganizationWizardContent, TerraScale.Dashboard.Features.Organizations.Wizard.OrganizationWizardModel>(new(Model, "fallback")))</div></section></noscript>
