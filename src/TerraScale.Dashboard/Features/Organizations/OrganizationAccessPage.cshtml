@inherits RazorSlice<TerraScale.Dashboard.Features.Organizations.OrganizationPage>
@using TerraScale.Dashboard.Features.Organizations
<main id="access-page" class="ts-page ts-org-page ts-access-page">
    <header class="ts-org-header"><div><h1 class="ts-org-title">@(Model.Shell.Context.Organization?.Name ?? "Organization")</h1>@if (Model.Shell.Context.Organization is { } headerOrg) { <p class="ts-meta ts-org-subtitle">@(headerOrg.Kind == "personal" ? "Personal organization" : "Business organization")</p> }</div></header><div class="ts-page-actions"></div>
    @if (Model.Error.Length > 0) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Could not update access</p><p class="ts-alert-body">@Model.Error</p></div> }
    @if (Model.InvitationLink.Length > 0)
    {
        <section class="ts-alert ts-alert-success" aria-labelledby="invitation-link-title" data-init="@("history.replaceState(null, '', '/organization?tab=" + Model.Tab + "')")">
            <p class="ts-alert-title" id="invitation-link-title">Invitation created</p><p class="ts-alert-body">Copy this link and send it to the invitee. It works once and expires in seven days; resending the invitation replaces it.</p>
            <div class="ts-row"><a id="invitation-link" class="ts-link ts-break" href="@Model.InvitationLink" rel="noreferrer" data-text="el.href">@Model.InvitationLink</a><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-signals="{_copy: ''}" data-on:click="(navigator.clipboard?.writeText(document.getElementById('invitation-link').href) ?? Promise.reject()).then(() => { $_copy = 'Copied'; setTimeout(() => $_copy = '', 2000) }, () => $_copy = 'Copy failed: select the link')">@Icons.Render("Copy", 14)<span data-text="$_copy || 'Copy link'">Copy link</span></button></div>
        </section>
    }
    <nav class="ts-tabs" aria-label="Organization sections">@foreach (var tab in Tabs) { <a class="ts-tab" href="@tab.Url" aria-current="@(tab.Key == "members" ? "page" : null)">@Icons.Render(tab.Icon, 16)<span>@tab.Label</span></a> }</nav>
    <div class="ts-toolbar ts-access-toolbar">
        <form id="access-filter-form" method="get" action="/organization" class="ts-filters ts-access-filters" role="search" aria-label="Filter members" data-on:submit="@@get('/organization', {contentType:'form'})">
            <input type="hidden" name="tab" value="members" /><button class="ts-sr-only" type="submit">Apply filters</button><input type="hidden" name="role" value="@(Model.Filter.Role == "all" ? "" : Model.Filter.Role)" />
            <div class="ts-filter-field ts-access-search"><label class="ts-sr-only" for="member-search">Filter members</label><input class="ts-input" id="member-search" name="q" type="search" placeholder="Search members" value="@Model.Filter.Query" /></div>
            <div class="ts-filter-field"><span class="ts-sr-only" id="member-role-filter-label">Organization role</span><details class="ts-menu ts-menu-end" data-on:click__outside="el.open = false" data-on:click="evt.target.closest('.ts-menu-panel [type=submit]') &amp;&amp; (el.open = false, el.querySelector('summary').focus())" data-on:keydown__window="evt.key === 'Escape' &amp;&amp; el.open &amp;&amp; (el.open = false, el.querySelector('summary').focus())"><summary class="ts-select" aria-labelledby="member-role-filter-label member-role-filter-value"><span id="member-role-filter-value">@OrganizationPage.RoleFilterLabel(Model.Filter.Role)</span></summary><div class="ts-menu-panel">@foreach (var role in new[] { "all", "owner", "admin", "member", "viewer" }) { <button class="ts-menu-item" type="submit" name="role" value="@(role == "all" ? "" : role)" aria-current="@(Model.Filter.Role == role ? "true" : null)"><span class="ts-menu-label">@OrganizationPage.RoleFilterLabel(role)</span>@if (Model.Filter.Role == role) { <span class="ts-menu-check" aria-hidden="true">@Icons.Render("Check", 15)</span> }</button> }</div></details></div>
            @if (Model.Filter.Query.Length > 0 || Model.Filter.Role != "all") { <a class="ts-btn ts-btn-ghost ts-btn-sm" href="/organization?tab=members">Clear</a> }
        </form>
        @if (Model.CanManage) { <a class="ts-btn ts-btn-primary" href="#team-invite">@Icons.Render("UserPlus", 16)<span>Invite member</span></a> }
    </div>
    @(await RenderPartialAsync<TerraScale.Dashboard.Features.Organizations.OrganizationMembers, OrganizationPage>(Model))
</main>
@functions {
    private static readonly (string Key, string Label, string Url, string Icon)[] Tabs = [("organization", "Organization", "/organization", "Building2"), ("members", "Members", "/organization?tab=members", "Users"), ("projects", "Projects", "/organization?tab=projects", "FolderKanban"), ("billing", "Billing", "/organization?tab=billing", "CreditCard"), ("audit", "Audit", "/organization?tab=audit", "ScrollText"), ("danger", "Danger zone", "/organization?tab=danger", "TriangleAlert")];
}
