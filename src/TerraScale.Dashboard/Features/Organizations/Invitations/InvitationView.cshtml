@inherits RazorSlice<TerraScale.Dashboard.Features.Organizations.Invitations.InvitationPage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.Document, DocumentModel>
@inject AssetUrls Assets
<main class="ts-login" aria-labelledby="invitation-title">
    <section class="ts-login-hero ts-auth-hero" aria-hidden="true">
        @(await RenderPartialAsync<TerraScale.Dashboard.Features.Auth.AuthRegionMap>())
    </section>
    <div class="ts-login-column">
        <div class="ts-login-panel">
            <div class="ts-login-stack">
                <span class="ts-login-brand"><img src="@Assets.Url("brand/logo-icon-blue.svg")" alt="" width="25" height="28" decoding="async" /><span class="ts-login-brand-word">TerraScale</span></span>
@if (Model.Pending is null && Model.Session is null)
{
                <div class="ts-auth-heading"><p class="ts-eyebrow">Invitation</p><h1 class="ts-auth-title" id="invitation-title">Sign in to view this invitation</h1><p class="ts-auth-subtitle">Sign in with the invited email to see and answer it. New to TerraScale? Create an account with that email, then open this link again.</p></div>
                <div class="ts-stack-sm"><a class="ts-btn ts-btn-primary ts-btn-lg ts-btn-block" href="@Model.Login">Sign in</a><a class="ts-btn ts-btn-secondary ts-btn-lg ts-btn-block" href="/onboarding">Create account</a></div>
}
else if (Model.Pending is not { } pending)
{
                <div class="ts-auth-heading"><p class="ts-eyebrow">Invitation</p><h1 class="ts-auth-title" id="invitation-title">This invitation is no longer valid</h1><p class="ts-auth-subtitle">The link has expired, was canceled, or has already been used. Ask an organization owner or admin to send you a new invitation.</p></div>
                <a class="ts-btn ts-btn-primary ts-btn-lg ts-btn-block" href="@(Model.Session is null ? "/login" : "/")">@(Model.Session is null ? "Sign in" : "Go to dashboard")</a>
}
else
{
                <div class="ts-auth-heading">
    @if (pending.Project is { } project)
    {
                    <p class="ts-eyebrow">Project invitation</p><h1 class="ts-auth-title" id="invitation-title">Join @project.Name</h1><p class="ts-auth-subtitle">This invitation grants @pending.Invitation.Role access to @project.Name in @pending.Organization.Name. Your organization role is unchanged.</p>
    }
    else
    {
                    <p class="ts-eyebrow">Organization invitation</p><h1 class="ts-auth-title" id="invitation-title">Join @pending.Organization.Name</h1><p class="ts-auth-subtitle">You have been invited to join this organization as a @pending.Invitation.Role.</p>
    }
                    <p class="ts-meta">Invitation for @pending.Invitation.Email · Expires @pending.Invitation.ExpiresAt.UtcDateTime.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</p></div>
    @if (Model.Error.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
    @if (Model.CanRespond)
    {
                <form method="post" action="@Model.Path/respond" class="ts-stack-sm"><input type="hidden" name="_csrf" value="@Model.CsrfToken" /><button class="ts-btn ts-btn-primary ts-btn-lg ts-btn-block" type="submit" name="action" value="accept">Accept invitation</button><button class="ts-btn ts-btn-secondary ts-btn-lg ts-btn-block" type="submit" name="action" value="decline">Decline</button></form>
    }
    else if (Model.Session is { } session)
    {
                <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-body">This invitation is for @pending.Invitation.Email, but you are signed in as @session.Email. Sign out, then sign in with the invited email to answer it.</p></div><form method="post" action="@Model.Path/switch-account"><input type="hidden" name="_csrf" value="@Model.CsrfToken" /><button class="ts-btn ts-btn-primary ts-btn-lg ts-btn-block" type="submit">Sign out and switch account</button></form>
    }
    else
    {
                <p class="ts-muted">Sign in with @pending.Invitation.Email to accept this invitation. New to TerraScale? Create an account with that email, then open this link again.</p><div class="ts-stack-sm"><a class="ts-btn ts-btn-primary ts-btn-lg ts-btn-block" href="@Model.Login">Sign in</a><a class="ts-btn ts-btn-secondary ts-btn-lg ts-btn-block" href="/onboarding">Create account</a></div>
    }
}
            </div>
        </div>
    </div>
</main>
@functions { public DocumentModel LayoutModel => Model.Document; }
