@inherits RazorSlice<TerraScale.Dashboard.Features.Organizations.ProjectSettingsPage>
@implements IUsesLayout<TerraScale.Dashboard.Shared.UI.Slices.ShellDocument, ShellModel>
<main class="ts-page" aria-labelledby="project-settings-title">
    <header class="ts-page-header"><h1 id="project-settings-title">Project settings</h1><p>These permissions apply to the selected project only. Project admin access allows renaming this project; organization settings require a separate organization role.</p></header>
    <a class="ts-link" href="@(WorkspaceUrl.For(Model.Shell.Context, "/project/members", replace: true))">Explicit project grants</a>
    @if (Model.Renamed) { <p class="ts-alert ts-alert-success" role="status">Project renamed.</p> }
    @if (Model.Error.Length > 0) { <p class="ts-alert ts-alert-danger" id="project-settings-error" role="alert">@Model.Error <a class="ts-link" href="@Model.Url">Reload project settings</a></p> }
    <section class="ts-card ts-card-boxed" aria-labelledby="project-details-title" data-signals="{_renamingProject: false}" data-on:submit="!evt.defaultPrevented &amp;&amp; ($_renamingProject = true)" data-on:pageshow__window="$_renamingProject = false" data-on:keydown__window="evt.key === 'Escape' &amp;&amp; ($_renamingProject = false)">
        <h2 id="project-details-title">Selected project</h2>
        <dl class="ts-kv"><dt>Name</dt><dd>@Model.Shell.Context.Project!.Name</dd><dt>Project ID</dt><dd class="ts-mono">@Model.Shell.Context.Project.Id</dd><dt>Your effective project role</dt><dd>@Model.Shell.Context.Project.Role</dd></dl>
        @if (Model.CanRename)
        {
            <form class="ts-form" method="post" action="@(WorkspaceUrl.For(Model.Shell.Context, "/api/v1/dashboard/project/rename", replace: true))" data-submit-once data-attr:aria-busy="$_renamingProject ? 'true' : 'false'">
                <input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
                <div class="ts-field"><label class="ts-label" for="project-name">Project name</label><input class="ts-input" id="project-name" name="name" value="@Model.Name" required maxlength="128" aria-describedby="project-name-help@(Model.Error.Length > 0 ? " project-settings-error" : "")" /><p class="ts-hint" id="project-name-help">Use 1–128 characters including a letter or digit. The project ID stays the same.</p></div>
                <button class="ts-btn ts-btn-primary" type="submit">Rename project</button>
                <p role="status" aria-live="polite" data-text="$_renamingProject ? 'Renaming project…' : ''"></p>
            </form>
        }
        else { <p>Read-only settings. A project admin can rename this project.</p> }
    </section>
</main>
@functions {
    public ShellModel LayoutModel => Model.Shell;
}
