@inherits RazorSlice<TerraScale.Dashboard.Features.Organizations.Projects.ProjectDialogModel>
<dialog id="@Model.Id" class="ts-dialog ts-dialog-wide" closedby="any" aria-labelledby="@Model.Id-title" data-page-url="@(Model.Open ? Model.Page.Shell.ReturnUrl : null)" data-init="@(Model.Open ? "el.showModal()" : "void 0")" data-on:close="el.dataset.pageUrl &amp;&amp; history.replaceState(null, '', el.dataset.pageUrl)"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@Model.Id-title">@Model.Title</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@Model.Id">@Icons.Render("X", 18)</button></header>@if (Model.Project is null && Model.Page.Error.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Page.Error</p></div> }<form method="post" action="@Model.Action" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Page.Shell.CsrfToken" /><div class="ts-field"><label class="ts-label" for="@Model.NameId">Project name</label>@if (Model.Project is null) { <input class="ts-input" id="@Model.NameId" name="name" value="@Model.Page.ProjectDraftName" placeholder="Analytics" maxlength="128" required /> } else { <input class="ts-input" id="@Model.NameId" name="name" value="@Model.Project.Name" required /> }</div><fieldset class="ts-org-placement"><legend class="ts-label">Default database regions</legend><div class="ts-field"><label class="ts-label" for="@Model.RegionsId">Allowed regions</label>@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.RegionPicker, RegionMapField>(new(Model.RegionsId, string.Join(' ', Model.Selected), Available: Model.Page.Regions)))<select class="ts-select" id="@Model.RegionsId" name="regions" multiple size="@Math.Max(1, Model.Page.Regions.Count)" required="@(Model.Project is null)">@foreach (var region in Model.Page.Regions) { <option value="@region" selected="@(Model.Selected.Contains(region) ? "selected" : null)">@(Regions.Name(region) is { Length: > 0 } name ? $"{region.ToLowerInvariant()} · {name}" : region.ToLowerInvariant())</option> }</select></div><div class="ts-field"><label class="ts-label" for="@Model.PrimaryId">Primary region</label><select class="ts-select" id="@Model.PrimaryId" name="region">@foreach (var region in Model.Page.Regions.OrderBy(Regions.Rank)) { <option value="@region" selected="@(region == Model.Primary ? "selected" : null)">@(Regions.Name(region) is { Length: > 0 } name ? $"{region.ToLowerInvariant()} · {name}" : region.ToLowerInvariant())</option> }</select></div><div class="ts-field"><label class="ts-label" for="@Model.BackupId">Backup region</label><select class="ts-select" id="@Model.BackupId" name="backupRegion">@foreach (var region in Model.Page.Regions.OrderBy(Regions.Rank)) { <option value="@region" selected="@(region == Model.Backup ? "selected" : null)">@(Regions.Name(region) is { Length: > 0 } name ? $"{region.ToLowerInvariant()} · {name}" : region.ToLowerInvariant())</option> }</select></div></fieldset><div class="ts-dialog-footer"><button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="@Model.Id">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">@(Model.Project is null ? "Create project" : "Save project")</button></div></form></div></dialog>
