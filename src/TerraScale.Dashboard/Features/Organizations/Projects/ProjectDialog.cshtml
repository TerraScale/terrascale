@inherits RazorSlice<TerraScale.Dashboard.Features.Organizations.Projects.ProjectDialogModel>
<dialog id="@Model.Id" class="ts-dialog ts-dialog-wide" closedby="any" aria-labelledby="@Model.Id-title" data-page-url="@(Model.Open ? Model.Page.Shell.ReturnUrl : null)" data-init="@(Model.Open ? "el.showModal()" : "void 0")" data-on:close="el.dataset.pageUrl &amp;&amp; history.replaceState(null, '', el.dataset.pageUrl)"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@Model.Id-title">@Model.Title</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@Model.Id">@Icons.Render("X", 18)</button></header>@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.DialogErrorView, DialogError>(new(Model.Id, DialogSubmission.Matches(HttpContext!, Model.Action) ? Model.Page.Error : "")))<form method="post" action="@(Model.Action + "?tab=projects")" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Page.Shell.CsrfToken" /><div class="ts-field"><label class="ts-label" for="@Model.NameId">Project name</label>@if (Model.Project is null) { <input class="ts-input" id="@Model.NameId" name="name" value="@Model.Page.ProjectDraftName" placeholder="Analytics" required pattern="[\s\u0085]*(?=[^\p{Cc}]*[\p{L}\p{N}])[^\p{Cc}]+[\s\u0085]*" title="Use 1–128 characters including a letter or digit" /> } else { <input class="ts-input" id="@Model.NameId" name="name" value="@Model.Name" required pattern="[\s\u0085]*(?=[^\p{Cc}]*[\p{L}\p{N}])[^\p{Cc}]+[\s\u0085]*" title="Use 1–128 characters including a letter or digit" /> }</div><div class="ts-field"><span class="ts-label" id="@(Model.RegionsId)-label">Regions</span>@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.RegionMap, RegionMapModel>(RegionMapModel.Select(Model.RegionsId, Model.Page.Regions, Model.Page.Regions.Where(region => DialogSubmission.Matches(HttpContext!, Model.Action) ? HttpContext!.Request.Form["regions"].Contains(region) : Model.Selected.Contains(region))) with { LabelledBy = Model.RegionsId + "-label", Minimum = "A project needs one region." }))</div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="@Model.Id">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">@(Model.Project is null ? "Create project" : "Save project")</button></div></form></div></dialog>
