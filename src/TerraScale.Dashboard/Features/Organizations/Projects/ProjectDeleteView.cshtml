@inherits RazorSlice<TerraScale.Dashboard.Features.Organizations.Projects.ProjectDialogModel>
@if (Model.Project is { } project)
{
    <dialog id="delete-project-@project.Id" class="ts-dialog" closedby="any" aria-labelledby="delete-project-@project.Id-title"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="delete-project-@project.Id-title">Delete @project.Name?</h2><p class="ts-dialog-description">Delete this project's databases before deleting the project. This cannot be undone.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="delete-project-@project.Id">@Icons.Render("X", 18)</button></header><form method="post" action="@("/api/v1/dashboard/organization/projects/" + Uri.EscapeDataString(project.Id) + "/delete")" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Page.Shell.CsrfToken" /><div class="ts-field"><label class="ts-label" for="delete-project-confirmation-@project.Id">Enter “@project.Name” to confirm</label><input class="ts-input" id="delete-project-confirmation-@project.Id" name="confirmation" autocomplete="off" required /></div><div class="ts-dialog-actions"><button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="delete-project-@project.Id">Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Delete project</button></div></form></div></dialog>
}
