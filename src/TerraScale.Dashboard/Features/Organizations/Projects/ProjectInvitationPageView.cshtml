@inherits RazorSlice<TerraScale.Dashboard.Features.Organizations.Projects.ProjectInvitationPage>
@using TerraScale.Dashboard.Features.Organizations.Projects
<main id="project-invitations-page" class="ts-page" aria-labelledby="project-invitations-title" data-signals="{_invitationPending: false}" data-on:submit="!evt.defaultPrevented &amp;&amp; ($_invitationPending = true)" data-on:pageshow__window="$_invitationPending = false" data-on:keydown__window="evt.key === 'Escape' &amp;&amp; ($_invitationPending = false)">
    <header class="ts-page-header"><div class="ts-page-heading"><h1 class="ts-page-title" id="project-invitations-title">Project invitations</h1><p class="ts-meta">@Model.Shell.Context.Project!.Name · your role: @Model.Shell.Context.Project.Role</p></div><div class="ts-page-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="@(WorkspaceUrl.For(Model.Shell.Context, "/project", replace: true))">Project settings</a></div></header>
    @if (Model.Notice.Length > 0) { <p class="ts-alert ts-alert-success" role="status">@Model.Notice</p> }
    @if (Model.Error.Length > 0) { <p class="ts-alert ts-alert-danger" role="alert">@Model.Error <a class="ts-link" href="@Model.Url">Open the first page</a></p> }
    else if (Model.Invitations.Count == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No project invitations on this page.</p></div> }
    else
    {
        <div class="ts-table-wrap" tabindex="0" role="region" aria-label="Project invitations"><table class="ts-table ts-table-stacked"><thead><tr><th>Email</th><th>Project role</th><th>Status</th><th>Created</th><th>Expires</th><th class="ts-table-actions">Actions</th></tr></thead><tbody>
        @foreach (var invitation in Model.Invitations)
        {
            <tr data-project-invitation="@invitation.Id"><td class="ts-break" data-label="Email">@invitation.Email</td><td data-label="Project role">@invitation.Role</td><td data-label="Status">@invitation.Status</td><td data-label="Created"><time datetime="@invitation.CreatedAt.ToString("O")">@invitation.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</time></td><td data-label="Expires"><time datetime="@invitation.ExpiresAt.ToString("O")">@invitation.ExpiresAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</time></td><td class="ts-table-actions">
            @if (invitation.Status is "pending" or "expired")
            {
                <div class="ts-row"><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" command="show-modal" commandfor="revoke-invitation-@invitation.Id">Revoke invitation</button></div>
                <dialog class="ts-dialog" id="revoke-invitation-@invitation.Id" aria-labelledby="revoke-invitation-title-@invitation.Id" closedby="any"><div class="ts-dialog-content">
                    <header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="revoke-invitation-title-@invitation.Id">Revoke project invitation?</h2><p class="ts-dialog-description">@invitation.Email · @invitation.Role</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="revoke-invitation-@invitation.Id">@Icons.Render("X", 18)</button></header><p class="ts-meta">Its acceptance link stops working.</p>
                    <form class="ts-form" method="post" action="@Model.PostUrl" data-submit-once data-on:submit="evt.preventDefault(); @@post(el.action, {contentType:'form'})" data-attr:aria-busy="$_invitationPending ? 'true' : 'false'">
                        <input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="invitationId" value="@invitation.Id" /><input type="hidden" name="after" value="@Model.After" />
                        <div class="ts-dialog-footer"><p class="ts-meta" role="status" aria-live="polite" data-text="$_invitationPending ? 'Revoking project invitation…' : ''"></p><button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="revoke-invitation-@invitation.Id">Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Confirm revocation</button></div>
                    </form>
                </div></dialog>
            }
            </td></tr>
        }
        </tbody></table></div>
    }
    <nav aria-label="Project invitation pages">
        @if (Model.HasPrevious) { <a class="ts-link" href="@Model.Url">First page</a> }
        @if (Model.Next is not null) { <a class="ts-link" rel="next" href="@(Model.Url + "&after=" + Uri.EscapeDataString(Model.Next))">Next page</a> }
    </nav>
</main>
