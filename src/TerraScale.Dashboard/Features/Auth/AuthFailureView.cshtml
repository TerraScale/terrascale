@inherits RazorSlice<TerraScale.Dashboard.Features.Auth.AuthFailurePage>
@implements IUsesLayout<TerraScale.Dashboard.UI.Slices.Document, DocumentModel>
@inject AssetUrls Assets
<main class="ts-login">
    <section class="ts-login-hero ts-auth-hero" aria-hidden="true">
        @(await RenderPartialAsync<TerraScale.Dashboard.Features.Auth.AuthRegionMap>())
    </section>
    <div class="ts-login-column">
        <div class="ts-login-panel">
            <div class="ts-login-stack">
                <div class="ts-login-heading">
                    <span class="ts-login-brand"><img src="@Assets.Url("brand/logo-icon-blue.svg")" alt="" width="25" height="28" decoding="async" /><span class="ts-login-brand-word">TerraScale</span></span>
                    <div class="ts-auth-heading"><h1 class="ts-auth-title">Sign in</h1><p class="ts-auth-subtitle">Sign-in through ts-auth did not finish.</p></div>
                </div>
                <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">@Model.Message</p><p class="ts-alert-body">Reference: <code>@Model.Reference</code></p></div>
                <div class="ts-form"><a class="ts-btn ts-btn-primary ts-btn-lg ts-btn-block" href="@Model.RetryUrl">Try again</a><a class="ts-btn ts-btn-secondary ts-btn-block" href="@Model.CodeUrl">Sign in with an emailed code</a></div>
                <p class="ts-meta">Still failing? Check <a class="ts-link" href="https://status.terrascale.tech">TerraScale status</a>, and quote the reference when you contact us.</p>
            </div>
        </div>
        <footer class="ts-login-footer"><div class="ts-auth-locale"><label class="ts-sr-only" for="auth-locale">Language</label><select id="auth-locale" class="ts-select ts-input-sm" aria-label="Language"><option value="en" selected>English</option><option value="pt-BR">Português</option></select></div></footer>
    </div>
</main>
@functions { public DocumentModel LayoutModel => Model.Document; }
