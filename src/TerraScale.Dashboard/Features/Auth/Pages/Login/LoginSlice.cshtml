@inherits RazorSlice<LoginPageModel>
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · TerraScale</title>
    @DocumentHtml.Assets(datastar: false)
</head>
<body>
<main class="ts-login">
    <div class="ts-login-map" aria-hidden="true">
        <div class="ts-login-map-glow"></div>
        <div class="ts-login-map-frame">
            <img class="ts-region-map" src="@AssetUrls.Url("/brand/region-map.svg")" alt="" decoding="async" />
            @RegionMap.Highlight(["SFO", "GRU", "FRA"])
        </div>
    </div>
    <div class="ts-login-column">
        <div class="ts-auth-card">
            <div class="ts-auth-brand">
                <img class="ts-brand-logo" src="@AssetUrls.Url("/brand/logo-terrascale-blue.svg")" alt="TerraScale" decoding="async" />
            </div>
            <div class="ts-auth-heading">
                <h1 class="ts-auth-title">Sign in</h1>
                <p class="ts-auth-subtitle">Access your databases and cloud operations.</p>
            </div>
            @if (Model.Error is { } error)
            {
                <div class="ts-auth-feedback ts-auth-feedback-error" role="alert">
                    @Icons.CircleAlert(16)
                    <span>@error</span>
                </div>
            }
            <form class="ts-auth-form" method="post" action="/api/v1/auth/password/login" novalidate>
                <input type="hidden" name="redirectTo" value="/" />
                <div class="ts-field">
                    <div class="ts-field-head">
                        <label class="ts-label" for="email">Email</label>
                    </div>
                    <input class="ts-input" type="email" id="email" name="email" autocomplete="email" required placeholder="name@company.com" />
                </div>
                <div class="ts-field">
                    <div class="ts-field-head">
                        <label class="ts-label" for="password">Password</label>
                        <a class="ts-inline-link" href="/reset-password">Forgot password</a>
                    </div>
                    <div class="ts-input-group">
                        <input class="ts-input" type="password" id="password" name="password" autocomplete="current-password" required placeholder="Enter your password" />
                        <button class="ts-input-adornment" type="button" data-toggle-type="password" aria-label="Show password">@Icons.Eye(18)</button>
                    </div>
                </div>
                <div class="ts-auth-submit-row">
                    <a class="ts-btn ts-btn-outline ts-btn-lg ts-auth-create" href="/onboarding">Create account</a>
                    <button class="ts-btn ts-btn-primary ts-btn-lg ts-auth-submit" type="submit">Sign in</button>
                </div>
            </form>
            <div class="ts-auth-divider" aria-hidden="true"><span></span><span class="ts-auth-divider-label">Or continue with</span><span></span></div>
            <div class="ts-auth-providers">
                <form method="post" action="/api/v1/auth/passkey/login">
                    <button class="ts-btn ts-btn-outline ts-auth-provider" type="submit" aria-label="Continue with passkey" title="Continue with passkey">@Icons.Fingerprint(18) Passkey</button>
                </form>
                <button class="ts-btn ts-btn-outline ts-auth-provider" type="button" disabled aria-label="Continue with Google" title="Sign-in with this provider is currently unavailable"><img src="@AssetUrls.Url("/brand/google.svg")" alt="" aria-hidden="true" /></button>
                <button class="ts-btn ts-btn-outline ts-auth-provider" type="button" disabled aria-label="Continue with GitHub" title="Sign-in with this provider is currently unavailable"><img src="@AssetUrls.Url("/brand/github.svg")" alt="" aria-hidden="true" /></button>
            </div>
        </div>
        <div class="ts-auth-locale-footer">
            <label class="ts-sr-only" for="auth-locale">Language</label>
            <select id="auth-locale" class="ts-auth-locale" aria-label="Language">
                <option value="en" selected>English</option>
                <option value="pt-BR">Português</option>
            </select>
        </div>
    </div>
</main>
<script src="@AssetUrls.Url("/js/terrascale.js")" defer></script>
</body>
</html>
