@inherits RazorSlice<AgentApprovePageModel>
@FlowHtml.Document("Approve agent access | TerraScale")
<main class="ts-flow-root ts-agent-root">
    <section class="ts-flow-panel ts-flow-panel-wide ts-flow-panel-compact">
        <div class="ts-flow-header">
            <span class="ts-flow-icon-badge" aria-hidden="true">@Icons.Bot(22)</span>
            <div class="ts-flow-header-content">
                <h1 class="ts-flow-title">Approve agent access</h1>
                <p class="ts-flow-subtitle">Review what this agent is requesting before allowing it to act for your account.</p>
            </div>
        </div>
        @if (Model.Outcome is { } outcome)
        {
            if (outcome == "approved")
            {
                <div class="ts-alert ts-alert-success" role="status">
                    <span class="ts-alert-title">@Icons.CircleCheckBig(16) Access approved</span>
                    <span class="ts-alert-body">The agent can now use the approved capability.</span>
                </div>
            }
            else
            {
                <div class="ts-alert ts-alert-success" role="status">
                    <span class="ts-alert-title">@Icons.CircleCheckBig(16) Access denied</span>
                    <span class="ts-alert-body">The agent will not receive access to this request.</span>
                </div>
            }
        }
        else if (Model.Error is { Length: > 0 } pageError)
        {
            <div class="ts-alert @(pageError == "Sign in before reviewing this approval request." ? "ts-alert-warning" : "ts-alert-danger")" role="alert">
                <span class="ts-alert-title">@Icons.CircleAlert(16) @pageError</span>
            </div>
        }
        else if (Model.Request is { } request)
        {
            <div class="ts-flow-details-stack">
                <section class="ts-flow-section" aria-labelledby="agent-approval-request">
                    <h2 id="agent-approval-request" class="ts-flow-section-heading">Request details</h2>
                    <dl class="ts-flow-details">
                        <div class="ts-flow-detail">
                            <dt>AGENT</dt>
                            <dd>@request.AgentName</dd>
                        </div>
                        <div class="ts-flow-detail">
                            <dt>EXPIRES</dt>
                            <dd>@Icons.Clock3(14) @request.ExpiresAt</dd>
                        </div>
                        @if (request.BindingMessage is { } message)
                        {
                            <div class="ts-flow-detail ts-flow-detail-wide">
                                <dt>MESSAGE</dt>
                                <dd>@message</dd>
                            </div>
                        }
                    </dl>
                </section>

                <section class="ts-flow-section ts-flow-section-tight" aria-labelledby="agent-approval-capabilities">
                    <div class="ts-flow-section-heading-row">
                        @Icons.ShieldCheck(17)
                        <h2 id="agent-approval-capabilities" class="ts-flow-section-heading">Requested capabilities</h2>
                    </div>
                    @if (request.Capabilities.Length > 0)
                    {
                        <ul class="ts-capability-list" aria-label="Requested capabilities">
                            @foreach (var capability in request.Capabilities)
                            {
                                <li class="ts-capability">
                                    <span>@capability</span>
                                    @if (request.Reasons.TryGetValue(capability, out var reason))
                                    {
                                        <span class="ts-capability-reason">@reason</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="ts-muted ts-ui">Capability details will be validated by TerraScale when you submit this request.</p>
                    }
                </section>

                @if (request.ConstraintsJson is { } constraints)
                {
                    <section class="ts-flow-section ts-flow-section-tight" aria-labelledby="agent-approval-constraints">
                        <h2 id="agent-approval-constraints" class="ts-flow-section-heading">Constraints</h2>
                        <pre class="ts-flow-pre">@constraints</pre>
                    </section>
                }

                <div class="ts-flow-section">
                    <form class="ts-flow-form" method="post" action="/agent/approve/submit">
                        <input type="hidden" name="action" value="approve" />
                        <div class="ts-field">
                            <label class="ts-label" for="agentApprovalCode">Approval code</label>
                            <input class="ts-input" type="text" id="agentApprovalCode" name="code" maxlength="256" autocomplete="one-time-code" spellcheck="false" value="@Model.UserCode" required />
                        </div>
                        <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">@Icons.Check(20) Approve access</button>
                    </form>
                    <form class="ts-flow-form ts-flow-form-denial" method="post" action="/agent/approve/submit">
                        <input type="hidden" name="action" value="deny" />
                        <div class="ts-field">
                            <label class="ts-label" for="denyReason">Reason for denying (optional)</label>
                            <input class="ts-input" type="text" id="denyReason" name="reason" maxlength="280" />
                        </div>
                        <button class="ts-btn ts-btn-destructive ts-btn-lg" type="submit">@Icons.X(20) Deny access</button>
                    </form>
                </div>
            </div>
        }
    </section>
</main>
@FlowHtml.End()
