@inherits RazorSlice<TerraScale.Dashboard.Features.Auth.DevicePage>
@implements IUsesLayout<TerraScale.Dashboard.UI.Slices.Document, DocumentModel>
@inject AssetUrls Assets
<main class="ts-login">
    <section class="ts-login-hero ts-auth-hero" aria-hidden="true">
        @(await RenderPartialAsync<TerraScale.Dashboard.Features.Auth.AuthRegionMap>())
    </section>
    <div class="ts-login-column">
        <div class="ts-login-panel">
            <div class="ts-login-stack">
                <div class="ts-login-heading">
                    <span class="ts-login-brand"><img src="@Assets.Url("brand/logo-icon-blue.svg")" alt="" width="25" height="28" decoding="async" /><span class="ts-login-brand-word">TerraScale</span></span>
                    <div class="ts-auth-heading"><h1 class="ts-auth-title">Approve CLI access</h1><p class="ts-auth-subtitle">Connect the TerraScale CLI to your account.</p></div>
                </div>
                @if (Model.Error.Length != 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
                @if (Model.Result == "approve")
                { <div class="ts-alert ts-alert-success" role="status"><p class="ts-alert-title">CLI authorized</p><p class="ts-alert-body">Return to your terminal. The CLI will receive its credential automatically. You can close this page.</p></div> }
                else if (Model.Result == "deny")
                { <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-title">Request denied</p><p class="ts-alert-body">No credential was issued. The waiting CLI will receive your decision.</p></div> }
                else if (Model.Pending && Model.Authenticated)
                {
                    <p class="ts-meta">Signed in as @Model.Email</p>
                    <p class="ts-auth-subtitle">Only approve a code from a CLI login you started. Verify that this code matches your terminal:</p>
                    <p class="ts-mono"><strong>@Model.Code</strong></p>
                    <p class="ts-meta">The CLI will have your dashboard permissions for 30 days. You can revoke its token in your profile.</p>
                    <form class="ts-form" method="post" action="/cli/approve/submit" data-submit-once><input type="hidden" name="_csrf" value="@Model.CsrfToken" /><input type="hidden" name="user_code" value="@Model.Code" /><div class="ts-field"><label class="ts-label" for="cliPassword">Confirm your current password</label>
                        <div class="ts-input-group" data-signals="{_cliPasswordReveal: false, _cliPasswordFilled: false}"><input class="ts-input" type="password" id="cliPassword" name="password" autocomplete="current-password" required data-attr:type="$_cliPasswordReveal ? 'text' : 'password'" data-on:input="$_cliPasswordFilled = el.value !== ''; $_cliPasswordFilled || ($_cliPasswordReveal = false)" /><button class="ts-input-adornment" type="button" data-password-toggle aria-controls="cliPassword" aria-pressed="false" aria-label="Show password" hidden data-attr:hidden="!$_cliPasswordFilled" data-attr:aria-pressed="String($_cliPasswordReveal)" data-attr:aria-label="$_cliPasswordReveal ? 'Hide password' : 'Show password'" data-on:click="$_cliPasswordReveal = !$_cliPasswordReveal">@Icons.Render("Eye")</button></div>
                    </div><button class="ts-btn ts-btn-primary ts-btn-block" name="decision" value="approve" type="submit">Authorize CLI</button><button class="ts-btn ts-btn-secondary ts-btn-block" name="decision" value="deny" type="submit" formnovalidate>Deny request</button></form>
                }
                else if (Model.Pending)
                {
                    <p class="ts-auth-subtitle">Code:</p>
                    <p class="ts-mono"><strong>@Model.Code</strong></p>
                    <p class="ts-auth-subtitle">Sign in, then confirm this code to authorize the CLI.</p>
                    <a class="ts-btn ts-btn-primary ts-btn-block" href="@Model.SignInUrl">Sign in to approve</a>
                }
                else
                {
                    <form class="ts-form" method="get" action="/cli/approve"><div class="ts-field"><label class="ts-label" for="cliCode">Code shown in your terminal</label><input class="ts-input" id="cliCode" name="user_code" value="@Model.Code" autocomplete="off" autocapitalize="characters" maxlength="9" placeholder="ABCD-EFGH" required /></div><button class="ts-btn ts-btn-primary ts-btn-block" type="submit">Continue</button></form>
                }
            </div>
        </div>
        <footer class="ts-login-footer"><div class="ts-auth-locale"><label class="ts-sr-only" for="auth-locale">Language</label><select id="auth-locale" class="ts-select ts-input-sm" aria-label="Language"><option value="en" selected>English</option><option value="pt-BR">Português</option></select></div><a href="https://docs.terrascale.tech/legal/terms">Terms</a><a href="https://docs.terrascale.tech/legal/privacy">Privacy</a><a href="https://status.terrascale.tech">Status</a></footer>
    </div>
</main>
@functions { public DocumentModel LayoutModel => Model.Document; }
