@inherits RazorSlice<TerraScale.Dashboard.Features.Auth.ConsentPage>
@implements IUsesLayout<TerraScale.Dashboard.UI.Slices.Document, DocumentModel>
@inject AssetUrls Assets
<main class="ts-login">
    <section class="ts-login-hero ts-auth-hero" aria-hidden="true">
        @(await RenderPartialAsync<TerraScale.Dashboard.Features.Auth.AuthRegionMap>())
    </section>
    <div class="ts-login-column">
        <div class="ts-login-panel">
            <div class="ts-login-stack">
                <div class="ts-login-heading">
                    <span class="ts-login-brand"><img src="@Assets.Url("brand/logo-icon-blue.svg")" alt="" width="25" height="28" decoding="async" /><span class="ts-login-brand-word">TerraScale</span></span>
                    <div class="ts-auth-heading"><h1 class="ts-auth-title">@Model.Title</h1><p class="ts-auth-subtitle">@Model.Description</p></div>
                </div>
                <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-title">Request unavailable</p><p class="ts-alert-body">@Model.Message</p></div>
            </div>
            <p class="ts-auth-footer"><a class="ts-link" href="/login">← Back to sign in</a></p>
        </div>
        <footer class="ts-login-footer"><div class="ts-auth-locale"><label class="ts-sr-only" for="auth-locale">Language</label><select id="auth-locale" class="ts-select ts-input-sm" aria-label="Language"><option value="en" selected>English</option><option value="pt-BR">Português</option></select></div><a href="https://docs.terrascale.tech/legal/terms">Terms</a><a href="https://docs.terrascale.tech/legal/privacy">Privacy</a><a href="https://status.terrascale.tech">Status</a></footer>
    </div>
</main>
@functions { public DocumentModel LayoutModel => Model.Document; }
