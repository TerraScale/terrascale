@inherits RazorSlice<TerraScale.Dashboard.Features.Auth.AuthPage>
@implements IUsesLayout<TerraScale.Dashboard.UI.Slices.Document, DocumentModel>
@inject AssetUrls Assets
<main class="ts-login">
    <section class="ts-login-hero" aria-hidden="true">
        @(await RenderPartialAsync<TerraScale.Dashboard.UI.Slices.RegionMap>())
        <ul class="ts-login-regions"><li><span class="ts-dot"></span>San Francisco</li><li><span class="ts-dot"></span>São Paulo</li></ul>
    </section>
    <div class="ts-login-column">
        <div class="ts-login-panel">
            <div class="ts-login-stack">
                <div class="ts-login-heading">
                    <img class="ts-login-logo ts-logo-on-dark" src="@Assets.Url("brand/logo-terrascale-principal.svg")" alt="TerraScale" decoding="async" /><img class="ts-login-logo ts-logo-on-light" src="@Assets.Url("brand/logo-terrascale-blue.svg")" alt="TerraScale" decoding="async" />
                    <div class="ts-auth-heading"><h1 class="ts-auth-title" id="login-title">@Model.Title</h1><p class="ts-auth-subtitle">@Model.Subtitle</p></div>
                </div>
                @if (Model.Error.Length != 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
                @if (Model.Notice.Length != 0) { <div class="ts-alert ts-alert-success" role="status"><p class="ts-alert-body">@Model.Notice</p></div> }
                @if (Model.Mode == "signup-expired")
                {
                    <a class="ts-btn ts-btn-outline ts-btn-lg ts-btn-block" href="/onboarding">Create account</a>
                }
                else
                {
                <form class="ts-form" method="post" action="@Model.Action" data-submit-once novalidate>
                    <input type="hidden" name="_csrf" value="@Model.CsrfToken" />
                    <input type="hidden" name="redirectTo" value="@Model.ReturnTo" />
                    @if (Model.PromptLogin) { <input type="hidden" name="prompt" value="login" /> }
                    @if (Model.SignUp) { <input type="hidden" name="signUp" value="1" /><input type="hidden" name="name" value="@Model.Name" /> }
                    @if (Model.Mode is "code-verify" or "reset-complete")
                    {
                        <input type="hidden" name="email" value="@Model.Email" />
                        @if (Model.Mode == "code-verify")
                        {
                            @(await RenderPartialAsync<TerraScale.Dashboard.UI.Slices.EmailCodeInput, string>(Model.CodeError))
                        }
                        else
                        {
                            <div class="ts-field"><label class="ts-label" for="code">Code</label><input class="ts-input ts-input-lg" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="64" required aria-invalid="@(Model.CodeError.Length != 0 ? "true" : null)" aria-describedby="@(Model.CodeError.Length != 0 ? "code-error" : null)" />
                            @if (Model.CodeError.Length != 0) { <p class="ts-field-error" id="code-error">@Model.CodeError</p> }</div>
                        }
                    }
                    else
                    {
                        <div class="ts-field">
                            <label class="ts-label" for="email">Email</label>
                            <input class="ts-input ts-input-lg" type="email" id="email" name="email" value="@Model.Email" autocomplete="email" placeholder="name@@company.com" required autofocus="@(Model.Mode == "code" ? "autofocus" : null)" aria-invalid="@(Model.EmailError.Length != 0 ? "true" : null)" aria-describedby="@(Model.EmailError.Length != 0 ? "email-error" : null)" />
                            @if (Model.EmailError.Length != 0) { <p class="ts-field-error" id="email-error">@Model.EmailError</p> }
                        </div>
                    }
                    @if (Model.Mode is "login" or "reset-complete")
                    {
                        <div class="ts-field">
                            <div class="ts-row-between"><label class="ts-label" for="password">@(Model.Mode == "login" ? "Password" : "New password")</label>@if (Model.Mode == "login") { <a class="ts-link ts-meta" href="/reset-password">Forgot password</a> }</div>
                            @(await RenderPartialAsync<TerraScale.Dashboard.UI.Slices.PasswordInput, TerraScale.Dashboard.UI.PasswordField>(new("password", Model.Mode == "login" ? "current-password" : "new-password", Model.PasswordError, Model.Mode == "login" ? "Enter your password" : "", Model.Mode == "reset-complete" ? 12 : 0, Autofocus: Model.Mode == "login" && Model.Error.Length != 0)))
                            @if (Model.PasswordError.Length != 0) { <p class="ts-field-error" id="password-error">@Model.PasswordError</p> }
                        </div>
                    }
                    @if (Model.Mode == "reset-complete")
                    {
                        <div class="ts-field"><label class="ts-label" for="confirmPassword">Confirm new password</label>@(await RenderPartialAsync<TerraScale.Dashboard.UI.Slices.PasswordInput, TerraScale.Dashboard.UI.PasswordField>(new("confirmPassword", "new-password", Model.ConfirmPasswordError)))
                        @if (Model.ConfirmPasswordError.Length != 0) { <p class="ts-field-error" id="confirmPassword-error">@Model.ConfirmPasswordError</p> }</div>
                    }
                    <button class="ts-btn ts-btn-primary ts-btn-lg ts-btn-block" type="submit">@(Model.Mode switch { "login" => "Sign in", "code-verify" => "Continue", "reset-complete" => "Change password", _ => "Email me a code" })</button>
                </form>
                }
                @if (Model.Mode == "login")
                {
                    <div class="ts-auth-divider" aria-hidden="true">Other sign-in options</div>
                    <div class="ts-auth-providers ts-auth-providers-stack">
                        <a class="ts-btn ts-btn-secondary" href="@Model.CodeUrl">Email me a code</a>
                        <a class="ts-btn ts-btn-secondary" href="@Model.SsoUrl">Single sign-on</a>
                    </div>
                }
                @if (Model.Mode == "code-verify" && Model.SignUp && Model.ResendUnavailable)
                {
                    <a class="ts-btn ts-btn-outline ts-btn-lg ts-btn-block" href="@Model.SignUpUrl">Create account again</a>
                }
                else if (Model.Mode == "code-verify" && Model.SignUp)
                {
                    <form class="ts-form" method="post" action="/login/code/resend" data-submit-once data-signals="@($"{{_resendSeconds: {Model.ResendSeconds}, _resendUntil: Date.now() + {Model.ResendSeconds} * 1000}}")" data-on-interval="$_resendSeconds = Math.max(0, Math.ceil(($_resendUntil - Date.now()) / 1000))">
                        <input type="hidden" name="_csrf" value="@Model.CsrfToken" />
                        <button class="ts-btn ts-btn-outline ts-btn-lg ts-btn-block" type="submit" data-attr:disabled="$_resendSeconds > 0 || $_navPending" data-text="$_resendSeconds > 0 ? 'Resend code (' + $_resendSeconds + 's)' : 'Resend code'">@(Model.ResendSeconds > 0 ? $"Resend code ({Model.ResendSeconds}s)" : "Resend code")</button>
                    </form>
                }
                else if (Model.Mode == "code-verify")
                {
                    <form class="ts-form" method="post" action="/login/code" data-submit-once>
                        <input type="hidden" name="_csrf" value="@Model.CsrfToken" /><input type="hidden" name="redirectTo" value="@Model.ReturnTo" /><input type="hidden" name="email" value="@Model.Email" />
                        <button class="ts-btn ts-btn-secondary ts-btn-block" type="submit">Send a new code</button>
                    </form>
                }
            </div>
            @if (Model.Mode == "login") { <p class="ts-auth-footer">New to TerraScale? <a class="ts-link" href="@Model.SignUpUrl">Create account</a></p> }
            else { <p class="ts-auth-footer"><a class="ts-link" href="@Model.LoginUrl">← Back to sign in</a></p> }
        </div>
        <footer class="ts-login-footer"><div class="ts-auth-locale"><label class="ts-sr-only" for="auth-locale">Language</label><select id="auth-locale" class="ts-select ts-input-sm" aria-label="Language"><option value="en" selected>English</option><option value="pt-BR">Português</option></select></div></footer>
    </div>
</main>
@functions {
    public DocumentModel LayoutModel => Model.Document;
}
