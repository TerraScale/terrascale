@inherits RazorSlice<TerraScale.Dashboard.Features.Auth.OrganizationPickerPage>
@implements IUsesLayout<TerraScale.Dashboard.Shared.UI.Slices.Document, DocumentModel>
@inject AssetUrls Assets
<main class="ts-org-picker"><section class="ts-org-picker-card" aria-labelledby="org-picker-title">
<div class="ts-login-heading"><span class="ts-login-brand"><img src="@Assets.Url("brand/logo-icon-blue.svg")" alt="" width="28" height="28" /><span>TerraScale</span></span><h1 class="ts-auth-title" id="org-picker-title">Choose an organization</h1><p class="ts-meta">You belong to @Model.Context.Organizations.Count organizations.</p></div>
<div class="ts-org-picker-user"><span class="ts-avatar">@ShellModel.Initial(Model.Context.Account.Name)</span><div><strong>@Model.Context.Account.Name</strong><p class="ts-meta">@Model.Context.Account.Email</p></div><form method="post" action="/api/v1/auth/logout"><input type="hidden" name="_csrf" value="@Model.CsrfToken" /><button class="ts-btn ts-btn-ghost ts-btn-sm" type="submit">Switch account</button></form></div>
@if(Model.Context.Organizations.Count == 0){<p class="ts-meta">No organizations available. <a href="/organization?newOrganization=organization">Create an organization</a> to get started.</p>}
<ul class="ts-org-picker-list">@foreach(var org in Model.Context.Organizations){<li><form method="post" action="/api/v1/dashboard/switch-organization"><input type="hidden" name="_csrf" value="@Model.CsrfToken" /><input type="hidden" name="organizationId" value="@org.Id" /><input type="hidden" name="returnUrl" value="@Model.ReturnTo" /><button class="ts-org-picker-option" type="submit" aria-current="@(org.Id == Model.Context.Organization?.Id ? "true" : null)"><span class="ts-org-picker-avatar">@ShellModel.Initial(org.Name)</span><span class="ts-org-picker-main"><span class="ts-org-picker-name">@org.Name <span class="ts-badge">@org.RoleFor(Model.Context.UserId)</span></span><span class="ts-meta ts-mono">@org.Slug</span></span>@Icons.Render("ChevronRight", 16)</button></form></li>}</ul>
<a class="ts-btn ts-btn-secondary ts-btn-block" href="/organization?newOrganization=organization">@Icons.Render("Plus", 16) Create organization</a>
</section><footer class="ts-org-picker-footer"><a href="https://status.terrascale.tech" @(ExternalLink.Attributes)>Status@(ExternalLink.Hint)</a><a href="https://docs.terrascale.tech" @(ExternalLink.Attributes)>Docs@(ExternalLink.Hint)</a><a href="https://docs.terrascale.tech/legal/privacy" @(ExternalLink.Attributes)>Privacy@(ExternalLink.Hint)</a><a href="https://docs.terrascale.tech/legal/terms" @(ExternalLink.Attributes)>Terms@(ExternalLink.Hint)</a><label class="ts-sr-only" for="org-picker-theme">Theme</label><select class="ts-select" id="org-picker-theme" data-on:change="document.documentElement.dataset.theme = el.value"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></footer><p class="ts-org-picker-powered">Powered by <b>TerraScale</b></p></main>
@functions { public DocumentModel LayoutModel => Model.Document; }
