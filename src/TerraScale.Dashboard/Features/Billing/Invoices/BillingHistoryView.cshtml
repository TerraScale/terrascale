@inherits RazorSlice<TerraScale.Dashboard.Features.Billing.BillingPage>
@using System.Globalization
@using TerraScale.Dashboard.Features.Billing
@using TerraScale.Dashboard.Features.Billing.Invoices
@{
    var now = Model.History.Now;
    var invoices = Model.History.Invoices;
    var errorMessage = Model.History.Error;
    var invoicePage = Model.History.Page;
    var binding = Model.Binding;
    var subscribed = binding?.SubscriptionId is { Length: > 0 } && binding.Status is not ("canceled" or "incomplete_expired");
    var projectId = Model.Shell.Context.Project?.Id ?? "";
    var clearHref = new InvoiceHistoryPage(invoicePage.Listing, "", "").Href(projectId, 1);
    var filtered = invoicePage.Status.Length > 0 || invoicePage.Issued.Length > 0;
}
<section class="ts-card ts-card-boxed ts-card-flush ts-billing-wide" id="recent-invoices" aria-labelledby="recent-invoices-title">
    <header class="ts-card-head ts-card-head-title-actions"><div class="ts-card-heading"><h2 class="ts-card-title" id="recent-invoices-title">Invoices</h2></div>
        <form class="ts-card-actions ts-billing-history-filters" method="get" action="/organization" role="search" aria-label="Filter invoices">
            <input type="hidden" name="tab" value="billing" /><input type="hidden" name="project" value="@projectId" />
            <label class="ts-sr-only" for="invoice-status">Invoice status</label><select class="ts-select ts-input-sm" id="invoice-status" name="status"><option value="" selected="@(invoicePage.Status == "" ? "selected" : null)">All statuses</option>@foreach (var option in InvoiceHistory.StatusOptions) { <option value="@option.Value" selected="@(invoicePage.Status == option.Value ? "selected" : null)">@option.Label</option> }</select>
            <label class="ts-sr-only" for="invoice-issued">Issued</label><select class="ts-select ts-input-sm" id="invoice-issued" name="issued"><option value="" selected="@(invoicePage.Issued == "" ? "selected" : null)">Any time</option>@foreach (var option in InvoiceHistory.IssuedOptions(now)) { <option value="@option.Value" selected="@(invoicePage.Issued == option.Value ? "selected" : null)">@option.Label</option> }</select>
            <button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Apply</button>@if (filtered) { <a class="ts-btn ts-btn-ghost ts-btn-sm" href="@clearHref">Clear</a> }
        </form>
    </header>
    <div class="ts-card-body">
        @if (errorMessage.Length == 0 && invoices.Any(invoice => invoice.Status == "uncollectible")) { <div class="ts-alert ts-alert-danger ts-billing-inset" role="alert"><p class="ts-alert-title">Failed payment</p><p class="ts-alert-body">An invoice in recorded history is marked uncollectible. Review its payment details.</p>@if (Model.CanManage && subscribed) { <a class="ts-btn ts-btn-danger ts-btn-sm" href="/billing/portal">Manage payment</a> }</div> }
        @if (errorMessage.Length > 0) { <div class="ts-alert ts-alert-warning ts-billing-inset" role="status"><p class="ts-alert-body">@errorMessage</p></div> }
        else if (invoicePage.Listing.Total == 0) { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("ReceiptText", 16)</span>@if (!filtered) { <p class="ts-empty-title">No invoices yet.</p> } else { <p class="ts-empty-title">No invoices match these filters.</p><a class="ts-btn ts-btn-secondary ts-btn-sm" href="@clearHref">Clear filters</a> }</div> }
        else
        {
            <div class="ts-table-wrap" tabindex="0" role="region" aria-label="Invoices"><table class="ts-table ts-billing-invoices"><caption class="ts-sr-only">Invoices for this organization matching the current filters</caption><thead><tr><th scope="col">Date</th><th scope="col" class="ts-billing-number">Invoice</th><th scope="col" class="ts-billing-period">Period</th><th scope="col" class="ts-num">Amount</th><th scope="col">Status</th><th scope="col" class="ts-table-actions"><span class="ts-sr-only">Actions</span></th></tr></thead><tbody>@foreach (var invoice in invoicePage.Listing.Invoices)
            {
                <tr><td class="ts-billing-date"><time datetime="@invoice.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@Date(invoice.CreatedAt)</time><span class="ts-billing-number-narrow ts-table-mono ts-meta">@invoice.Number</span></td><td class="ts-table-mono ts-billing-number">@invoice.Number</td><td class="ts-meta ts-billing-period">@Date(invoice.PeriodStart) – @Date(invoice.PeriodEnd)</td><td class="ts-num ts-table-strong">@MoneyFormat.Money(invoice.AmountCents, invoice.Currency)</td><td><span class="ts-badge ts-badge-@Tone(invoice.Status)">@Label(invoice.Status)</span></td><td class="ts-table-actions"><div class="ts-row ts-row-end">@if (invoice.HostedUrl.Length > 0) { <a class="ts-icon-btn" href="@invoice.HostedUrl" aria-label="Open invoice @invoice.Number" title="Open invoice" @(ExternalLink.Attributes)>@Icons.Render("ExternalLink", 16)</a> }@if (invoice.PdfUrl.Length > 0) { <a class="ts-icon-btn" href="@invoice.PdfUrl" aria-label="Download invoice @invoice.Number PDF" title="Download PDF" @(ExternalLink.Attributes)>@Icons.Render("Download", 16)</a> }</div></td></tr>
            }</tbody></table></div>
            <nav class="ts-pager" aria-label="Invoice pages"><span>Showing @invoicePage.First–@(invoicePage.First + invoicePage.Listing.Invoices.Count - 1) of @invoicePage.Listing.Total</span>@if (invoicePage.Listing.PageCount > 1) { <div class="ts-row">@if (invoicePage.Listing.Page > 1) { <a class="ts-btn ts-btn-ghost ts-btn-sm" href="@invoicePage.Href(projectId, invoicePage.Listing.Page - 1)" rel="prev">Previous</a> }@for (var number = 1; number <= invoicePage.Listing.PageCount; number++) { <a class="ts-btn ts-btn-ghost ts-btn-sm ts-usage-page" href="@invoicePage.Href(projectId, number)" aria-current="@(number == invoicePage.Listing.Page ? "page" : null)">@number</a> }@if (invoicePage.Listing.Page < invoicePage.Listing.PageCount) { <a class="ts-btn ts-btn-ghost ts-btn-sm" href="@invoicePage.Href(projectId, invoicePage.Listing.Page + 1)" rel="next">Next</a> }</div> }</nav>
        }
    </div>
</section>
@functions {
    private static string Date(DateTimeOffset? value) => value?.UtcDateTime.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "-";
    private static string Tone(string status) => status switch { "paid" => "success", "open" => "warning", "uncollectible" => "danger", _ => "neutral" };
    private static string Label(string status) => status.Length == 0 ? status : char.ToUpperInvariant(status[0]) + status[1..].Replace('_', ' ');
}
