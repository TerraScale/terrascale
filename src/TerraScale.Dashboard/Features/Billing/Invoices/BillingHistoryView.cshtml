@inherits RazorSlice<TerraScale.Dashboard.Features.Billing.BillingPage>
@using System.Globalization
@using TerraScale.Dashboard.Features.Billing
@using TerraScale.Dashboard.Features.Billing.Invoices
@using TerraScale.Dashboard.Features.Billing.Plans
@{
    var org = Model.Shell.Context.Organization!;
    var now = Model.History.Now;
    var invoices = Model.History.Invoices;
    var errorMessage = Model.History.Error;
    var invoicePage = Model.History.Page;
    var summary = Model.History.Summary;
    var plan = PlanCatalog.For(org);
    var binding = Model.Binding;
    var subscribed = binding?.SubscriptionId is { Length: > 0 } && binding.Status is not ("canceled" or "incomplete_expired");
    var planName = org.BillingStatus == "billing_required" && !subscribed ? "No plan" : plan?.Name ?? "Not reported";
    var clearHref = new InvoiceHistoryPage(invoicePage.Listing, "", "").Href(Model.Shell.Context.Project?.Id ?? "", 1);
    var renewalLabel = binding?.RenewalAt?.UtcDateTime.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "";
    var interval = binding?.EffectiveInterval is { Length: > 0 } effective ? effective : binding?.Interval ?? "";
    var price = interval == "annual" ? plan?.AnnualPriceCents ?? 0 : plan?.PriceCents ?? 0;
}
    @if (Model.InternalBill is { } internalBill) { @(await RenderPartialAsync<TerraScale.Dashboard.Features.Billing.InternalBillingView, InternalBillingViewModel>(new(internalBill, PlanCatalog.Limits(org)))) }
    <div class="ts-toolbar">
        <form class="ts-filters ts-billing-history-filters" method="get" action="/organization" role="search" aria-label="Filter payment history">
            <input type="hidden" name="tab" value="billing" /><input type="hidden" name="project" value="@(Model.Shell.Context.Project?.Id ?? "")" />
            <label class="ts-field" for="invoice-status"><span class="ts-label">Invoice status</span><select class="ts-select" id="invoice-status" name="status"><option value="" selected="@(invoicePage.Status == "" ? "selected" : null)">All statuses</option>@foreach (var option in InvoiceHistory.StatusOptions) { <option value="@option.Value" selected="@(invoicePage.Status == option.Value ? "selected" : null)">@option.Label</option> }</select></label>
            <label class="ts-field" for="invoice-issued"><span class="ts-label">Issued</span><select class="ts-select" id="invoice-issued" name="issued"><option value="" selected="@(invoicePage.Issued == "" ? "selected" : null)">Any time</option>@foreach (var option in InvoiceHistory.IssuedOptions(now)) { <option value="@option.Value" selected="@(invoicePage.Issued == option.Value ? "selected" : null)">@option.Label</option> }</select></label>
            <button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Apply</button>@if (invoicePage.Status.Length > 0 || invoicePage.Issued.Length > 0) { <a class="ts-btn ts-btn-ghost ts-btn-sm" href="@clearHref">Clear</a> }
        </form>
    </div>
    <section class="ts-card" id="billing-invoice-summary" aria-labelledby="billing-invoice-summary-title">
        <header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="billing-invoice-summary-title">Invoice summary</h2><p class="ts-card-description">Invoice information reported for this organization</p></div></header>
        <div class="ts-card-body">
            @if (errorMessage.Length > 0) { <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">@errorMessage</p></div> }
            else
            {
                <dl class="ts-stats ts-usage-billing-kpis ts-stats-compact">
                    <div class="ts-stat"><dt class="ts-stat-label">Plan</dt><dd class="ts-stat-value">@planName</dd><dd class="ts-stat-detail">Billing status: @(org.BillingStatus.Length > 0 ? org.BillingStatus : "Not reported") · @InvoiceHistory.Plural(invoices.Count, "recorded invoice")
                    @if (renewalLabel.Length > 0) { <text> · Renews @renewalLabel</text> }
                    @if (price > 0) { <text> · @BillingPlanPresentation.Money(price) / @interval</text> }
                    </dd></div>
                    <div class="ts-stat"><dt class="ts-stat-label">Next invoice</dt><dd class="ts-stat-value">@summary.NextInvoice</dd><dd class="ts-stat-detail">@summary.NextDetail</dd></div>
                    <div class="ts-stat"><dt class="ts-stat-label">Billing period</dt><dd class="ts-stat-value">@summary.Period</dd>@if (summary.HasPeriod) { <dd><span class="ts-chart-meter" tabindex="0" role="img" aria-label="Billing period elapsed: @summary.PeriodPercent percent of the recorded billing period"><svg class="ts-svg-sharebar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true"><rect class="ts-svg-sharebar-track" x="0" y="0" width="100" height="8"></rect><rect class="ts-svg-sharebar-fill" x="0" y="0" width="@summary.PeriodPercent" height="8"></rect></svg><span class="ts-chart-tooltip" aria-hidden="true"><span class="ts-chart-tooltip-label">Billing period elapsed</span><strong>@summary.PeriodPercent%</strong></span></span></dd> }<dd class="ts-stat-detail">@summary.PeriodDetail</dd></div>
                    <div class="ts-stat"><dt class="ts-stat-label">Outstanding balance</dt><dd class="ts-stat-value">@summary.Outstanding</dd><dd class="ts-stat-detail">@summary.OutstandingDetail</dd></div>
                </dl>
            }
        </div>
    </section>
    @(await RenderPartialAsync<TerraScale.Dashboard.Features.Billing.Plans.BillingPlanDialogs, TerraScale.Dashboard.Features.Billing.BillingPage>(Model))
    <section class="ts-card ts-card-flush" id="recent-invoices" aria-labelledby="recent-invoices-title">
        <header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="recent-invoices-title">Payment history</h2><p class="ts-card-description">Invoices recorded for this organization, newest first</p></div></header>
        <div class="ts-card-body">
            @if (errorMessage.Length == 0 && invoices.Any(invoice => invoice.Status == "uncollectible")) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-title">Failed payment</p><p class="ts-alert-body">An invoice in recorded history is marked uncollectible. Review its payment details.</p>@if (Model.CanManage && subscribed) { <a class="ts-btn ts-btn-danger ts-btn-sm" href="/billing/portal">Manage payment</a> }</div> }
            @if (errorMessage.Length > 0) { <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">@errorMessage</p></div> }
            else if (invoicePage.Listing.Total == 0) { <div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("ReceiptText", 16)</span><p class="ts-empty-title">@(invoicePage.Status.Length == 0 && invoicePage.Issued.Length == 0 ? "No invoices yet" : "No invoices match these filters")</p><p class="ts-empty-detail">@(invoicePage.Status.Length == 0 && invoicePage.Issued.Length == 0 ? "Your invoices will appear here after your first billed payment." : "Change the status or issued date, or clear the filters.")</p></div> }
            else
            {
                <div class="ts-table-wrap" tabindex="0" role="region" aria-label="Recent invoices table. Scroll horizontally to see all columns."><table class="ts-table"><caption class="ts-sr-only">Invoices for this organization matching the current filters</caption><thead><tr><th scope="col">Invoice</th><th scope="col">Issued</th><th scope="col">Period</th><th scope="col" class="ts-num">Amount</th><th scope="col">Status</th><th scope="col" class="ts-table-actions">Actions</th></tr></thead><tbody>@foreach (var invoice in invoicePage.Listing.Invoices)
                {
                    <tr><td class="ts-table-strong ts-mono">@invoice.Number</td><td><time datetime="@invoice.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@Date(invoice.CreatedAt)</time></td><td class="ts-meta">@Date(invoice.PeriodStart) – @Date(invoice.PeriodEnd)</td><td class="ts-num">@invoice.Currency.ToUpperInvariant() @InvoiceHistory.Amount(invoice.AmountCents, invoice.Currency)</td><td><span class="ts-badge ts-badge-@Tone(invoice.Status)">@invoice.Status</span></td><td class="ts-table-actions">@if (invoice.HostedUrl.Length > 0) { <a class="ts-btn ts-btn-ghost ts-btn-sm" href="@invoice.HostedUrl" @(ExternalLink.Attributes)>Open@(ExternalLink.Hint)</a> }@if (invoice.PdfUrl.Length > 0) { <a class="ts-btn ts-btn-ghost ts-btn-sm" href="@invoice.PdfUrl" @(ExternalLink.Attributes)>PDF@(ExternalLink.Hint)</a> }</td></tr>
                }</tbody></table></div>
                <nav class="ts-pager" aria-label="Payment history pages"><span>Showing @invoicePage.First–@(invoicePage.First + invoicePage.Listing.Invoices.Count - 1) of @invoicePage.Listing.Total</span>@if (invoicePage.Listing.PageCount > 1) { <div class="ts-row">@if (invoicePage.Listing.Page > 1) { <a class="ts-btn ts-btn-ghost ts-btn-sm" href="@invoicePage.Href(Model.Shell.Context.Project?.Id ?? "", invoicePage.Listing.Page - 1)" rel="prev">Previous</a> }@for (var number = 1; number <= invoicePage.Listing.PageCount; number++) { <a class="ts-btn ts-btn-ghost ts-btn-sm ts-usage-page" href="@invoicePage.Href(Model.Shell.Context.Project?.Id ?? "", number)" aria-current="@(number == invoicePage.Listing.Page ? "page" : null)">@number</a> }@if (invoicePage.Listing.Page < invoicePage.Listing.PageCount) { <a class="ts-btn ts-btn-ghost ts-btn-sm" href="@invoicePage.Href(Model.Shell.Context.Project?.Id ?? "", invoicePage.Listing.Page + 1)" rel="next">Next</a> }</div> }</nav>
            }
        </div>
    </section>
@functions {
    private static string Date(DateTimeOffset? value) => value?.UtcDateTime.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "-";
    private static string Tone(string status) => status switch { "paid" => "success", "open" => "warning", "uncollectible" => "danger", _ => "neutral" };
}
