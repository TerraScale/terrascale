@inherits RazorSlice<TerraScale.Dashboard.Features.Billing.BillingPage>
@using TerraScale.Dashboard.Features.Billing.Plans
@{
    var data = Model.PlanChanges;
    var owner = Model.CanManage;
}
@if (data.State?.PendingPlanKey is { Length: > 0 } pending) { <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-title">Awaiting payment</p><p class="ts-alert-body">Stripe is confirming the change to @BillingPlanPresentation.Name(pending). Your current plan stays active until confirmation.</p>@if (owner && data.State.PaymentUrl.Length > 0) { <a class="ts-btn ts-btn-primary ts-btn-sm" href="@data.State.PaymentUrl" @(ExternalLink.Attributes)>Complete payment@(ExternalLink.Hint)</a> }</div> }
@if (data.State?.ScheduledPlanKey is { Length: > 0 } scheduled)
{
    <div class="ts-alert ts-alert-info ts-billing-scheduled" role="status"><div><p class="ts-alert-title">Change scheduled</p><p class="ts-alert-body">Your plan will change to @BillingPlanPresentation.Name(scheduled) @BillingPlanPresentation.Scheduled(data.State.ScheduledAt).</p></div>@if (owner) { <form method="post" action="/billing/change/undo"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Undo scheduled change</button></form> }</div>
}
