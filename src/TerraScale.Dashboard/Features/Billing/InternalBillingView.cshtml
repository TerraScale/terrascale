@inherits RazorSlice<TerraScale.Dashboard.Features.Billing.InternalBillingViewModel>
@using System.Globalization
@using TerraScale.Dashboard.Features.Billing
@using TerraScale.Dashboard.Features.Usage
@using TerraScale.Dashboard.Common.Formatting
<section class="ts-card" id="internal-bill" aria-labelledby="internal-bill-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="internal-bill-title">Internal computed bill</h2><p class="ts-card-description">Report-only estimate from every project's UTC month-to-date usage. Reads are free. Storage uses the current logical size for a full month, not historical byte-seconds. No Stripe charges.</p></div></header><div class="ts-card-body">
@if (!Model.Bill.Available) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Internal bill unavailable</p><p class="ts-alert-body">@Model.Bill.Error</p></div> }
else
{
    <div class="ts-internal-grid"><dl class="ts-kv"><div><dt>Period</dt><dd>@Model.Bill.PeriodStart.UtcDateTime.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) – @Model.Bill.PeriodEnd.UtcDateTime.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) (UTC)</dd></div><div><dt>Base plan</dt><dd>@MoneyFormat.Money(Model.Bill.BaseCents)</dd></div><div><dt>Reads / writes</dt><dd><span title="@Model.Bill.Reads.ToString("N0", CultureInfo.InvariantCulture)">@TerraScale.Dashboard.Common.Charts.ChartGeometry.Compact(Model.Bill.Reads)</span> / <span title="@Model.Bill.Writes.ToString("N0", CultureInfo.InvariantCulture)">@TerraScale.Dashboard.Common.Charts.ChartGeometry.Compact(Model.Bill.Writes)</span></dd></div><div><dt>Write overage</dt><dd>@MoneyFormat.Money(Model.Bill.WriteCents) (@MoneyFormat.Money(Model.Bill.WriteCentsPerMillion) per million beyond the allowance)</dd></div><div><dt>Storage estimate</dt><dd>@MoneyFormat.Money(Model.Bill.StorageCents) (@MoneyFormat.Money(Model.Bill.StorageCentsPerGBMonth) per GB-month beyond the allowance)</dd></div><div><dt>Total estimate</dt><dd>@MoneyFormat.Money(Model.Bill.TotalCents)</dd></div><div><dt>Organization cap</dt><dd>@(Model.Bill.SpendCapCents <= 0 ? "No limit" : MoneyFormat.Money(Model.Bill.SpendCapCents)) · report only; services remain active</dd></div></dl>
    <div class="ts-stack">@foreach (var meter in new[] { (Name: "Organization cap · report only", Value: Model.Bill.TotalCents, Limit: Model.Bill.SpendCapCents, Label: MoneyFormat.Money(Model.Bill.TotalCents) + " / " + (Model.Bill.SpendCapCents <= 0 ? "No limit" : MoneyFormat.Money(Model.Bill.SpendCapCents)), Title: ""), (Name: "Writes · included allowance", Value: Model.Bill.Writes, Limit: Model.Allowances.MonthlyOperations, Label: TerraScale.Dashboard.Common.Charts.ChartGeometry.Compact(Model.Bill.Writes) + " / " + (Model.Allowances.MonthlyOperations > 0 ? TerraScale.Dashboard.Common.Charts.ChartGeometry.Compact(Model.Allowances.MonthlyOperations) : "No included allowance"), Title: Model.Bill.Writes.ToString("N0", CultureInfo.InvariantCulture) + " / " + (Model.Allowances.MonthlyOperations > 0 ? Model.Allowances.MonthlyOperations.ToString("N0", CultureInfo.InvariantCulture) : "No included allowance")), (Name: "Storage", Value: Model.Bill.LogicalBytes, Limit: Model.Allowances.StorageBytes, Label: MetricFormat.Bytes(Model.Bill.LogicalBytes) + " / " + (Model.Allowances.StorageBytes > 0 ? MetricFormat.Bytes(Model.Allowances.StorageBytes) : "No included allowance"), Title: "") })
    { <div class="ts-stack-sm ts-internal-meter" data-state="@(meter.Limit > 0 && meter.Value >= meter.Limit ? "warning" : "neutral")"><div class="ts-row-between"><span class="ts-meta">@meter.Name</span><span class="ts-mono" title="@(meter.Title.Length > 0 ? meter.Title : null)">@meter.Label</span></div>@if (meter.Limit > 0) { <svg class="ts-svg-sharebar" viewBox="0 0 100 8" preserveAspectRatio="none" role="img" aria-label="@(meter.Name + ": " + meter.Label)"><rect class="ts-svg-sharebar-track" width="100" height="8"></rect><rect class="ts-svg-sharebar-fill" width="@(Math.Clamp(meter.Value * 100m / meter.Limit, 0, 100).ToString(CultureInfo.InvariantCulture))" height="8"></rect></svg> }</div> }</div></div>
    @if (Model.Bill.CapReached) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Report-only spending cap reached</p><p class="ts-alert-body">@Model.Bill.Alert</p></div> }
}
</div></section>
