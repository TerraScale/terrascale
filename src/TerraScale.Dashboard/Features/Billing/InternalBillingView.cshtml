@inherits RazorSlice<TerraScale.Dashboard.Features.Billing.InternalBill>
@using System.Globalization
@using TerraScale.Dashboard.Features.Billing
<section class="ts-card" id="internal-bill" aria-labelledby="internal-bill-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="internal-bill-title">Internal computed bill</h2><p class="ts-card-description">Report-only estimate from every project's UTC month-to-date usage. Reads are free. Storage uses the current logical size for a full month, not historical byte-seconds. No Stripe charges.</p></div></header><div class="ts-card-body">
@if (!Model.Available) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Internal bill unavailable</p><p class="ts-alert-body">@Model.Error</p></div> }
else
{
    <dl class="ts-kv"><div><dt>Period</dt><dd>@Model.PeriodStart.UtcDateTime.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) – @Model.PeriodEnd.UtcDateTime.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) (UTC)</dd></div><div><dt>Base plan</dt><dd>@InternalBill.Money(Model.BaseCents)</dd></div><div><dt>Reads / writes</dt><dd>@Model.Reads / @Model.Writes</dd></div><div><dt>Write overage</dt><dd>@InternalBill.Money(Model.WriteCents) (@InternalBill.Money(Model.WriteCentsPerMillion) per million beyond the allowance)</dd></div><div><dt>Storage estimate</dt><dd>@InternalBill.Money(Model.StorageCents) (@InternalBill.Money(Model.StorageCentsPerGiBMonth) per GiB-month beyond the allowance)</dd></div><div><dt>Total estimate</dt><dd>@InternalBill.Money(Model.TotalCents)</dd></div><div><dt>Organization cap</dt><dd>@SpendingService.CapLabel(Model.SpendCapCents) · report only; services remain active</dd></div></dl>
    @if (Model.CapReached) { <div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Report-only spending cap reached</p><p class="ts-alert-body">@Model.Alert</p></div> }
}
</div></section>
