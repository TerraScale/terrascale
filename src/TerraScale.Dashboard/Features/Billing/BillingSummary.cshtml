@inherits RazorSlice<TerraScale.Dashboard.Features.Billing.BillingPage>
@using System.Globalization
@using TerraScale.Dashboard.Features.Billing
@{
    var org = Model.Shell.Context.Organization!;
    var binding = Model.Binding;
    var plan = PlanCatalog.For(org);
    var owner = Model.CanManage;
    var subscribed = binding?.SubscriptionId is { Length: > 0 } && binding.Status is not ("canceled" or "incomplete_expired");
    var awaiting = org.BillingStatus == "billing_required" && !subscribed;
    var free = plan?.Key == "free" && !subscribed;
    var planName = awaiting || plan is null ? "No plan" : plan.Name;
    var status = org.BillingStatus == "billing_required" ? "Payment required" : binding?.Status == "trialing" ? "Trialing" : org.BillingStatus == "active" ? "Active" : org.BillingStatus;
    var effectiveInterval = !subscribed ? null : binding?.EffectiveInterval is { Length: > 0 } currentInterval ? currentInterval : binding?.Interval;
    var priceInterval = binding?.EffectiveInterval is { Length: > 0 } bound ? bound : binding?.Interval ?? "";
    var price = priceInterval == "annual" ? plan?.AnnualPriceCents ?? 0 : plan?.PriceCents ?? 0;
    var statusClass = binding?.Status == "trialing" ? "ts-badge-info" : awaiting ? "ts-badge-warning" : org.BillingStatus is "" or "active" ? "ts-badge-success" : "ts-badge-neutral";
    var ending = Model.PlanChanges.State is { CancelAtPeriodEnd: true };
    var pendingCheckout = Model.PlanChanges.Binding is { CheckoutId.Length: > 0, SubscriptionId.Length: 0, Status: "pending" };
    var summary = Model.History.Summary;
    var historyError = Model.History.Error;
}
<div class="ts-billing">
    @if (org.PaymentGraceUntil is { } deadline) { <div class="ts-alert ts-alert-warning" role="status" id="billing-payment-grace"><p class="ts-alert-body">Payment failed. Paid plan grace deadline: @deadline.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture) UTC. Update your payment method in Manage payment.</p></div> }
    @if (binding is { TaxLocationStatus: not ("" or "supported" or "not_collecting") }) { <div class="ts-alert ts-alert-warning" role="status" id="billing-tax-location"><p class="ts-alert-body">Complete your billing address in Manage payment to calculate tax.</p></div> }
    @if (Model.Error.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
    @if (Model.PlanChanges.Error.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.PlanChanges.Error</p></div> }
    @if (HttpContext!.Request.Query["payment"] == "canceled") { <div class="ts-alert ts-alert-info" role="status"><p class="ts-alert-title">Checkout canceled</p><p class="ts-alert-body">Review your current plan below. Choose a plan to try again, or cancel the pending checkout before choosing a different plan.</p></div> }
    @if (HttpContext!.Request.Query["payment"] == "blocked") { <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-title">Checkout did not open</p><p class="ts-alert-body">Finish or cancel the pending checkout first. If this organization already has a subscription, change its plan below or in Manage payment.</p></div> }
    <div class="ts-billing-layout">
        <section class="ts-card ts-card-boxed ts-billing-wide" id="billing-summary" aria-labelledby="billing-summary-title">
            <header class="ts-card-head ts-card-head-title-actions"><div class="ts-card-heading"><h2 class="ts-card-title" id="billing-summary-title">Current plan</h2></div>
                <div class="ts-card-actions">@if (Model.InternalBill is not null) { <span class="ts-badge ts-badge-info">Internal</span> }@if (owner) { @if (pendingCheckout) { <form method="post" action="/billing/checkout/cancel"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><button class="ts-btn ts-btn-danger ts-btn-sm" type="submit">Cancel checkout</button></form> }<button class="ts-btn ts-btn-primary ts-btn-sm" type="button" command="show-modal" commandfor="change-billing-plan">@(subscribed ? "Change plan" : "Choose plan")</button> }</div>
            </header>
            <div class="ts-card-body">
                <div class="ts-billing-current">
                    <div class="ts-billing-plan"><span class="ts-billing-plan-icon" aria-hidden="true">@Icons.Render("CreditCard", 18)</span><span class="ts-billing-plan-name">@planName</span><span class="ts-badge @statusClass"><span class="ts-dot" aria-hidden="true"></span>@status</span></div>
                    <dl class="ts-billing-facts">@if (price > 0 && priceInterval.Length > 0) { <div><dt>Price</dt><dd>@MoneyFormat.Money(price) / @priceInterval</dd></div> }<div><dt>Billing interval</dt><dd>@(effectiveInterval is "monthly" ? "Monthly" : effectiveInterval is "annual" ? "Annual" : "Not applicable")</dd></div><div><dt>@(ending ? "Ends" : "Renewal")</dt><dd>@(binding?.RenewalAt?.UtcDateTime.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture) ?? "Not scheduled")</dd></div>@if (Model.InternalBill is not null || free) { <div><dt>Stripe charges</dt><dd>None</dd></div> }</dl>
                </div>
                @(await RenderPartialAsync<TerraScale.Dashboard.Features.Billing.Plans.BillingPlanActions, TerraScale.Dashboard.Features.Billing.BillingPage>(Model))
                @if (awaiting) { <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-title">Choose a plan</p><p class="ts-alert-body">Projects and databases can’t be created in @org.Name until a plan is active.</p></div> }
                @if (!owner) { <p class="ts-meta">@(Model.InternalBill is not null ? "Internal billing reports usage without Stripe charges." : "Only the organization owner can manage billing.")</p> }
            </div>
        </section>
        @if (Model.InternalBill is { } internalBill)
        {
            <div class="ts-billing-wide">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Billing.InternalBillingView, InternalBillingViewModel>(new(internalBill, PlanCatalog.Limits(org))))</div>
        }
            <section class="ts-card ts-card-boxed" id="billing-invoice-summary" aria-labelledby="billing-invoice-summary-title">
                <header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="billing-invoice-summary-title">This period</h2></div></header>
                <div class="ts-card-body">
                    @if (Model.InternalBill is null && !awaiting && plan is not null && (free || subscribed)) { <p class="ts-billing-usage" id="billing-usage">@UsageThisPeriod(plan, plan.PriceCents == 0 ? null : Model.OverageUnits ?? -1)</p> }
                    @if (historyError.Length > 0) { <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">@historyError</p></div> }
                    else
                    {
                        <dl class="ts-billing-figures">
                            <div><dt>Next invoice</dt><dd>@summary.NextInvoice</dd></div>
                            <div><dt>Billing period</dt><dd>@summary.Period</dd>@if (summary.HasPeriod) { <dd><span class="ts-chart-meter" tabindex="0" role="img" aria-label="Billing period: @summary.PeriodProgress"><svg class="ts-svg-sharebar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true"><rect class="ts-svg-sharebar-track" x="0" y="0" width="100" height="8"></rect><rect class="ts-svg-sharebar-fill" x="0" y="0" width="@summary.PeriodPercent" height="8"></rect></svg><span class="ts-chart-tooltip" aria-hidden="true"><span class="ts-chart-tooltip-label">@summary.PeriodProgress</span><strong>@summary.PeriodPercent%</strong></span></span></dd> }</div>
                            <div><dt>Outstanding balance</dt><dd>@summary.Outstanding</dd></div>
                        </dl>
                    }
                </div>
            </section>
        @(await RenderPartialAsync<TerraScale.Dashboard.Features.Billing.BillingDetailsView, TerraScale.Dashboard.Features.Billing.BillingPage>(Model))
        @(await RenderPartialAsync<TerraScale.Dashboard.Features.Billing.Invoices.BillingHistoryView, TerraScale.Dashboard.Features.Billing.BillingPage>(Model))
        @if (Model.InternalBill is null)
        {
            <section class="ts-card ts-billing-wide ts-billing-plans" id="available-plans" aria-labelledby="available-plans-title">
                <header class="ts-card-head ts-card-head-title-actions"><div class="ts-card-heading"><h2 class="ts-card-title" id="available-plans-title">Available plans</h2></div><div class="ts-card-actions"><a class="ts-link" href="https://docs.terrascale.tech/pricing#what-is-billed" @(ExternalLink.Attributes)>How billing works@(ExternalLink.Hint)</a></div></header>
                <div class="ts-billing-grid">@foreach (var candidate in PlanCatalog.ComparisonPlans)
                {
                    var selectable = Model.Plans.FirstOrDefault(item => item.Key == candidate.Key);
                    var freeCandidate = candidate.Key == "free";
                    var interval = freeCandidate ? "" : selectable is not null && selectable.Id == org.PlanId && selectable.SupportsInterval(effectiveInterval ?? "") ? effectiveInterval! : selectable?.CheckoutInterval ?? "";
                    var current = freeCandidate ? free && !awaiting : subscribed && selectable?.Id == org.PlanId && effectiveInterval == interval;
                    var canReview = owner && subscribed && selectable is not null && (!freeCandidate || org.Kind == "personal" && Model.PlanChanges.State is not null);
                    var action = current ? "Current plan" : awaiting ? "Choose " + candidate.Name : candidate.PriceCents > (plan?.PriceCents ?? 0) ? "Upgrade to " + candidate.Name : "Switch to " + candidate.Name;
                    var primary = !current && (awaiting || candidate.PriceCents > (plan?.PriceCents ?? 0));
                    <article class="ts-plan @(current ? "ts-plan-current" : "")" aria-labelledby="plan-@candidate.Key" aria-current="@(current ? "true" : null)">
                        <header class="ts-plan-head"><h3 id="plan-@candidate.Key" class="ts-plan-name">@candidate.Name</h3>@if (current) { <span class="ts-badge ts-badge-info">Current</span> }</header>
                        <div class="ts-plan-pricing"><p class="ts-plan-price">@candidate.Price<small>@candidate.PriceUnit</small></p><p class="ts-meta">@candidate.BillingDescription</p></div>
                        <ul class="ts-plan-features">@foreach (var feature in candidate.Features) { <li>@Icons.Render("Check", 14)<span>@feature</span></li> }@if (!subscribed && binding?.TrialUsed != true && selectable is { TrialDays: > 0 }) { <li>@Icons.Render("Check", 14)<span>@(selectable!.TrialDays)-day free trial</span></li> }</ul>
                        <div class="ts-plan-action">
                        @if (candidate.Key == "enterprise") { <a class="ts-btn ts-btn-block ts-btn-secondary" href="https://terrascale.tech/contact" @(ExternalLink.Attributes)>Contact sales@(ExternalLink.Hint)</a> }
                        else if (canReview) { <form method="get" action="/organization"><input type="hidden" name="tab" value="billing" /><input type="hidden" name="review" value="1" /><input type="hidden" name="plan" value="@candidate.Key" /><input type="hidden" name="interval" value="@interval" /><button class="ts-btn ts-btn-block @(primary ? "ts-btn-primary" : "ts-btn-secondary")" type="submit" disabled="@current">@action</button></form> }
                        else if (owner && !subscribed && selectable is { PriceCents: > 0 }) { <form method="post" action="/billing/checkout"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="plan" value="@candidate.Key" /><input type="hidden" name="interval" value="@interval" /><input type="hidden" name="return" value="/organization?tab=billing" /><button class="ts-btn ts-btn-block @(primary ? "ts-btn-primary" : "ts-btn-secondary")" type="submit">@action</button></form> }
                        else if (freeCandidate) { <p class="ts-meta">@(current ? "Current plan" : org.Kind != "personal" ? "Available for Personal workspaces only." : "Free is available at renewal for subscribed Personal workspaces.")</p> }
                        </div>
                    </article>
                }</div>
            </section>
        }
    </div>
    @(await RenderPartialAsync<TerraScale.Dashboard.Features.Billing.Plans.BillingPlanDialogs, TerraScale.Dashboard.Features.Billing.BillingPage>(Model))
</div>
@functions {
    private static string UsageThisPeriod(BillingPlan plan, long? overage) => overage switch
    {
        null => string.Create(CultureInfo.InvariantCulture, $"{plan.Name} stops new writes at its {plan.Allowances.MonthlyOperations:N0} operation units a month; reads keep working. No usage charges."),
        < 0 => "Usage this period could not be loaded.",
        0 => string.Create(CultureInfo.InvariantCulture, $"Usage this period: {MoneyFormat.Money(0)} so far, within {plan.Name}'s {plan.Allowances.MonthlyOperations:N0} included operation units. Units above them cost {OperationUnitOverage.Rate}."),
        { } units => string.Create(CultureInfo.InvariantCulture, $"Usage this period: {MoneyFormat.Money(OperationUnitOverage.Cents(units))} so far, for {units:N0} operation units over {plan.Name}'s {plan.Allowances.MonthlyOperations:N0} included units, at {OperationUnitOverage.Rate}. Billed on your next invoice.")
    };
}
