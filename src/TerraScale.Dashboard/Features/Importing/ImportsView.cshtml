@inherits RazorSlice<TerraScale.Dashboard.Features.Importing.ImportsPage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.Importing
@inject AssetUrls Assets
@{ var canProvision = Model.Shell.Context.Organization?.CanProvision(Model.Shell.Context.UserId) == true; var culture = System.Globalization.CultureInfo.InvariantCulture; }
<main class="ts-page ts-imports">
<header class="ts-db-head"><nav class="ts-breadcrumb" aria-label="Breadcrumb"><a href="/databases">Databases</a><span aria-hidden="true">/</span><span aria-current="page">Import</span></nav><h1 class="ts-db-title">Import a database</h1></header>
@if(Model.Error.Length > 0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-title">Import not created</p><p class="ts-alert-body">@Model.Error</p></div>}
<div class="ts-split"><section class="ts-card" id="import-start" aria-labelledby="import-start-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="import-start-title">Export commands</h2></div></header><div class="ts-card-body ts-stack-lg">
<div class="ts-stack-sm"><div class="ts-snippet" data-signals="{_pgCopy: ''}"><div class="ts-snippet-header ts-row-between"><span>PostgreSQL</span><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-on:click="(navigator.clipboard?.writeText(document.getElementById('import-pg-command').textContent) ?? Promise.reject()).then(() => { $_pgCopy = 'Copied'; setTimeout(() => $_pgCopy = '', 2000) }, () => $_pgCopy = 'Copy failed')">@Icons.Render("Copy", 14)<span data-text="$_pgCopy || 'Copy'">Copy</span></button></div><pre class="ts-snippet-body" id="import-pg-command"><code>pg_dump --format=plain --no-owner --no-privileges --encoding=UTF8 -f dump.sql &lt;database&gt;</code></pre></div></div>
<div class="ts-stack-sm"><div class="ts-snippet" data-signals="{_tursoCopy: ''}"><div class="ts-snippet-header ts-row-between"><span>Turso or SQLite</span><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-on:click="(navigator.clipboard?.writeText(document.getElementById('import-turso-command').textContent) ?? Promise.reject()).then(() => { $_tursoCopy = 'Copied'; setTimeout(() => $_tursoCopy = '', 2000) }, () => $_tursoCopy = 'Copy failed')">@Icons.Render("Copy", 14)<span data-text="$_tursoCopy || 'Copy'">Copy</span></button></div><pre class="ts-snippet-body" id="import-turso-command"><code>turso db export &lt;database&gt; --output-file turso-export.db
sqlite3 turso-export.db "VACUUM INTO 'export.db'"</code></pre></div></div>
<a class="ts-link" href="https://docs.terrascale.tech/guides/import-ndjson" @(ExternalLink.Attributes)>NDJSON from MongoDB or Firestore@(ExternalLink.Hint)</a></div></section>
<div class="ts-stack-lg">@if(Model.Unavailable.Length > 0){<div class="ts-alert ts-alert-info" role="status"><p class="ts-alert-title">Import unavailable</p><p class="ts-alert-body">@Model.Unavailable</p></div>}
@if(canProvision){<section class="ts-card ts-card-boxed" aria-label="Upload and preview"><div class="ts-card-body"><form method="post" action="/api/v1/dashboard/imports" class="ts-form" data-import-upload="create" data-signals="{_importFormat: 'postgres_plain'}"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="sourceBytes" value="" /><input type="hidden" name="sourceSha256" value="" />
<fieldset class="ts-field ts-stack-sm"><legend class="ts-label">Export format</legend>@foreach(var format in ImportService.Formats){<label class="ts-import-format"><input type="radio" name="format" data-bind="_importFormat" value="@ImportService.Wire(format.Key)" checked="@(format.Key == TerraScale.TerraBase.Contracts.Import.TerraBaseImportFormat.PostgresPlain)" required /><span><strong>@format.Label</strong></span></label>}</fieldset>
<div class="ts-field" data-show="$_importFormat === 'ndjson'"><label class="ts-label" for="import-collection">Target collection</label><input class="ts-input" id="import-collection" name="collection" maxlength="63" pattern="[a-z][a-z0-9_\-]{0,62}" data-attr:disabled="$_importFormat !== 'ndjson'" placeholder="people" /></div>
<div class="ts-field"><label class="ts-label" for="import-file">Export file</label><input class="ts-input" id="import-file" type="file" name="file" required /></div>
<input type="hidden" name="database" value="@Model.NewDatabase" /><dl class="ts-kv"><div><dt>New database</dt><dd class="ts-mono">@Model.NewDatabase</dd></div></dl>
<progress class="ts-import-progress" max="100" value="0" hidden data-import-progress></progress><p class="ts-meta" role="status" aria-live="polite" data-import-status></p>
<noscript><p class="ts-meta">Uploading needs JavaScript to fingerprint the file.</p></noscript>
<div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit" disabled="@(Model.Unavailable.Length > 0)">@Icons.Render("Upload",16)<span>Upload and preview</span></button></div></form></div></section>}
else{<section class="ts-card"><div class="ts-card-body"><p class="ts-meta">Importing creates a database, which requires provisioning access.</p></div></section>}
</div></div>
<section class="ts-card ts-card-flush" id="import-jobs" aria-labelledby="import-jobs-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="import-jobs-title">Imports</h2></div></header>
@if(Model.Unavailable.Length > 0){<div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">Imports unavailable.</p></div></div>}
else if(Model.Jobs.Count == 0){<div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">No imports yet.</p></div></div>}
else{<div class="ts-table-wrap"><table class="ts-table"><thead><tr><th>Destination</th><th>Source</th><th>Status</th><th class="ts-num">Rows written</th><th>Created</th></tr></thead><tbody>
@foreach(var job in Model.Jobs){<tr><td><a href="@ImportEndpoints.JobPath(job.Database)">@job.Database</a></td><td>@ImportService.FormatLabel(job.Source.Format)</td><td><span class="ts-badge ts-badge-tone" data-tone="@ImportService.Tone(job.State)"><span class="ts-dot" aria-hidden="true"></span>@ImportService.Wire(job.State).Replace('_', ' ')</span></td><td class="ts-num">@(job.Progress is { } progress ? progress.RowsWritten.ToString("N0", culture) + " / " + progress.RowsTotal.ToString("N0", culture) : "—")</td><td class="ts-mono">@job.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'", culture)</td></tr>}
</tbody></table></div>}
</section>
</main>
<script type="module" src="@Assets.Url("js/import-upload.js")" nonce="@Model.Shell.Nonce"></script>
@functions { public ShellModel LayoutModel => Model.Shell; }
