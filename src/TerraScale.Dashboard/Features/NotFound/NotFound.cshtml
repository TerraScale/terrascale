@inherits RazorSlice<DocumentModel>
@implements IUsesLayout<TerraScale.Dashboard.UI.Slices.Document, DocumentModel>
@inject AssetUrls Assets
<main class="ts-notfound" aria-labelledby="notfound-title">
    <header><a href="/" aria-label="TerraScale dashboard"><img class="ts-brand-logo" src="@Assets.Url("brand/logo-terrascale-principal.svg")" alt="TerraScale" width="183" height="44" decoding="async" /></a></header>
    <div class="ts-empty ts-notfound-inner">
        <img class="ts-notfound-mark" src="@Assets.Url("brand/logo-icon-blue.svg")" alt="" aria-hidden="true" width="32" height="36" decoding="async" />
        <p class="ts-notfound-number" aria-hidden="true">404</p>
        <h1 class="ts-empty-title" id="notfound-title">We can’t find that page.</h1>
        <p class="ts-empty-detail">The page you’re looking for has moved, or never existed.</p>
        <div class="ts-row">
            <a class="ts-btn ts-btn-primary" href="/">@Icons.Render("Home", 16)<span>Back to dashboard</span></a>
            <a class="ts-btn ts-btn-secondary" href="https://terrascale.tech/contact">@Icons.Render("Mail", 16)<span>Contact support</span></a>
        </div>
    </div>
</main>
@functions {
    public DocumentModel LayoutModel => Model;
}
