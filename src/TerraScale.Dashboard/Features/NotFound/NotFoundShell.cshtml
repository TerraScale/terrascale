@inherits RazorSlice<ShellModel>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
<main class="ts-page ts-notfound-shell" aria-labelledby="notfound-title">
    <div class="ts-notfound-copy">
        <span class="ts-notfound-num" aria-hidden="true">404</span>
        <h1 class="ts-auth-title" id="notfound-title">We can’t find that page.</h1>
        <p class="ts-meta">Request ID: <code>@RequestIdentity.Id</code></p>
        <div class="ts-row">
            <a class="ts-btn ts-btn-primary ts-btn-lg" href="/">@Icons.Render("Home")<span>Back to dashboard</span></a>
            <a class="ts-btn ts-btn-secondary ts-btn-lg" href="/support">@Icons.Render("CircleHelp")<span>Contact support</span></a>
        </div>
    </div>
</main>
@functions {
    public ShellModel LayoutModel => Model;
}
