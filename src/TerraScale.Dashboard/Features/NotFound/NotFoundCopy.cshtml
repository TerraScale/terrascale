@inherits RazorSlice
<div class="ts-notfound-copy">
    <span class="ts-notfound-num" aria-hidden="true">404</span>
    <p class="ts-eyebrow">Page not found</p>
    <h1 class="ts-auth-title" id="notfound-title">We can’t find that page.</h1>
    <p class="ts-auth-subtitle">The page you’re looking for has moved, or never existed. Let’s get you back on track.</p>
    <p class="ts-meta">Request ID: <code>@RequestIdentity.Id</code></p>
    <div class="ts-row">
        <a class="ts-btn ts-btn-primary ts-btn-lg" href="/">@Icons.Render("Home")<span>Back to dashboard</span></a>
        <a class="ts-btn ts-btn-secondary ts-btn-lg" href="https://terrascale.tech/contact">@Icons.Render("Mail")<span>Contact support</span></a>
    </div>
</div>
