@inherits RazorSlice<AccessPageModel>
@{
    var shell = Model.Shell;
    var query = HttpContext?.Request?.Query;
    var search = query is null ? "" : query["q"].ToString();
    var roleFilter = query is null ? "all" : query["role"].ToString() is "owner" or "member" ? query["role"].ToString() : "all";
    var createIntent = query is not null && query["create"].Count > 0;
    var pendingInvitations = Model.Invitations.Count(invitation => invitation.Status == "pending");
    var tabLinks = new[]
    {
        (Id: "overview", Label: "Overview", Icon: "Users"),
        (Id: "members", Label: "Members", Icon: "UserRound"),
        (Id: "projects", Label: "Projects", Icon: "FolderKanban"),
        (Id: "invitations", Label: "Invitations", Icon: "MailPlus"),
    };

    string TabHref(string id) => id == "overview" ? "/access" : $"/access?tab={id}";

    string PageHref(int page)
    {
        var parameters = new List<string>();
        if (Model.Tab != "overview")
        {
            parameters.Add($"tab={Uri.EscapeDataString(Model.Tab)}");
        }

        if (Model.Tab == "members")
        {
            if (search.Length > 0) parameters.Add($"q={Uri.EscapeDataString(search)}");
            if (roleFilter != "all") parameters.Add($"role={Uri.EscapeDataString(roleFilter)}");
        }

        if (page > 1) parameters.Add($"page={page}");
        return parameters.Count is 0 ? "/access" : "/access?" + string.Join("&", parameters);
    }

    Microsoft.AspNetCore.Html.HtmlString Pager()
    {
        var pageLinks = string.Concat(Enumerable.Range(1, Model.PageCount).Select(page =>
            $"<a class=\"ts-btn ts-btn-ghost ts-pager-page\" href=\"{System.Net.WebUtility.HtmlEncode(PageHref(page))}\" aria-current=\"{(page == Model.Page ? "page" : "false")}\">{page}</a>"));
        var previous = Model.Page > 1
            ? $"<a class=\"ts-btn ts-btn-ghost\" href=\"{System.Net.WebUtility.HtmlEncode(PageHref(Model.Page - 1))}\" rel=\"prev\"><span class=\"ts-access-pager-flip\">{Icons.ChevronRight(14).Value}</span> Previous</a>"
            : "";
        var next = Model.Page < Model.PageCount
            ? $"<a class=\"ts-btn ts-btn-ghost\" href=\"{System.Net.WebUtility.HtmlEncode(PageHref(Model.Page + 1))}\" rel=\"next\">Next {Icons.ChevronRight(14).Value}</a>"
            : "";
        return new($"<nav class=\"ts-pager ts-access-pager\" aria-label=\"{Model.Tab} pages\"><span class=\"ts-meta\">Showing {Model.FirstItem}–{Model.LastItem} of {Model.TotalItems}</span><span class=\"ts-row ts-row-tight\">{previous}{pageLinks}{next}</span></nav>");
    }
}
@ShellHtml.Top(shell)
<div class="ts-page ts-access-page">
    @if (Model.Error is { } error)
    {
        <div class="ts-alert ts-alert-warning" role="alert">
            <span class="ts-alert-title">@Icons.TriangleAlert(16) @error</span>
        </div>
    }

    <div class="ts-toolbar">
        <nav class="ts-tabs" aria-label="Team sections">
            @foreach (var tab in tabLinks)
            {
                <a class="ts-tab" href="@TabHref(tab.Id)" aria-current="@(Model.Tab == tab.Id ? "page" : null)" aria-selected="@(Model.Tab == tab.Id ? "true" : "false")">@((typeof(Icons).GetMethod(tab.Icon)?.Invoke(null, [16]) as Microsoft.AspNetCore.Html.HtmlString) ?? Icons.Circle(16)) @tab.Label</a>
            }
        </nav>
        @if (Model.Tab == "members")
        {
            <form class="ts-filters ts-access-filters" method="get" action="/access" role="search" aria-label="Filter members">
                <input type="hidden" name="tab" value="members" />
                <div class="ts-filter-field ts-access-search-field">
                    <label class="ts-sr-only" for="access-member-search">Filter members</label>
                    <div class="ts-access-search-box">
                        @Icons.Search(16)
                        <input class="ts-input" id="access-member-search" type="search" name="q" value="@search" placeholder="Search members" />
                    </div>
                </div>
                <div class="ts-filter-field">
                    <span class="ts-filter-label ts-sr-only" id="access-role-label">Organization role</span>
                    <input type="hidden" name="role" value="@(roleFilter == "all" ? "" : roleFilter)" />
                    <details class="ts-menu ts-menu-end ts-filter-menu">
                        <summary class="ts-select ts-filter-select ts-filter-trigger" aria-labelledby="access-role-label access-role-value"><span id="access-role-value">@(roleFilter == "owner" ? "Organization owner" : roleFilter == "member" ? "Member" : "All roles")</span></summary>
                        <div class="ts-menu-panel">
                            <button class="ts-menu-item" type="button" data-filter-value="" aria-current="@(roleFilter == "all" ? "true" : null)">All roles</button>
                            <button class="ts-menu-item" type="button" data-filter-value="owner" aria-current="@(roleFilter == "owner" ? "true" : null)">Organization owner</button>
                            <button class="ts-menu-item" type="button" data-filter-value="member" aria-current="@(roleFilter == "member" ? "true" : null)">Member</button>
                        </div>
                    </details>
                </div>
                @if (Model.FiltersActive)
                {
                    <a class="ts-btn ts-btn-ghost" href="/access?tab=members">Clear</a>
                }
            </form>
        }
    </div>

    @if (Model.Tab == "overview")
    {
        <section class="ts-section" aria-labelledby="team-overview-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="team-overview-title">Team overview</h2>
                    <p class="ts-meta">People, projects and invitations for the active organization</p>
                </div>
                @if (Model.CanManageOrganization)
                {
                    <a class="ts-btn ts-btn-primary" href="/access?tab=invitations&amp;create=1">@Icons.MailPlus(16) Invite member</a>
                }
            </div>
            <dl class="ts-kpis" aria-label="Team totals">
                <div>
                    <dt>@Icons.Users(14) Organization members</dt>
                    <dd><span class="ts-kpi-value">@Model.Members.Count</span></dd>
                    <small class="ts-meta">People with organization access</small>
                </div>
                <div>
                    <dt>@Icons.FolderKanban(14) Projects</dt>
                    <dd><span class="ts-kpi-value">@Model.Projects.Count</span></dd>
                    <small class="ts-meta">Projects visible to this account</small>
                </div>
                <div>
                    <dt>@Icons.Mail(14) Pending invitations</dt>
                    <dd><span class="ts-kpi-value">@pendingInvitations</span></dd>
                    <small class="ts-meta">Awaiting a response</small>
                </div>
            </dl>
        </section>

        <section class="ts-section" aria-labelledby="organization-members-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="organization-members-title">Organization members</h2>
                    <p class="ts-meta">Users returned by the TerraScale Dashboard API</p>
                </div>
                <a class="ts-btn ts-btn-ghost" href="/access?tab=members">View and filter members @Icons.ArrowRight(16)</a>
            </div>
            @if (!Model.HasMembers)
            {
                @EmptyState(Model.CanManageOrganization ? "No members returned" : "Organization owner access required", Model.CanManageOrganization ? "The API did not return organization members for this account." : "Only organization owners can view the complete organization member list.")
            }
            else
            {
                <ul class="ts-access-summary-list" aria-label="Organization member summary">
                    @foreach (var member in Model.Members.Take(5))
                    {
                        <li>
                            <div class="ts-access-member-cell">
                                <span class="ts-access-avatar" aria-hidden="true">@member.Initials</span>
                                <div class="ts-access-identity">
                                    <div class="ts-access-member-name">@(member.DisplayName.Length > 0 ? member.DisplayName : member.Email)</div>
                                    <div class="ts-access-member-email">@member.Email</div>
                                </div>
                            </div>
                            <span class="ts-badge @(member.IsOrganizationOwner ? "ts-badge-success" : "ts-badge-neutral")">@member.RoleLabel</span>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="ts-section" aria-labelledby="invitations-summary-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="invitations-summary-title">Invitations and role changes</h2>
                    <p class="ts-meta">Persistent access mutations</p>
                </div>
                <a class="ts-btn ts-btn-ghost" href="/access?tab=invitations">Manage access @Icons.ArrowRight(16)</a>
            </div>
            @if (Model.CanManageOrganization)
            {
                <form class="ts-access-invite-form ts-access-overview-invite" method="post" action="/api/v1/access/invitations">
                    <div class="ts-field">
                        <label class="ts-label" for="invite-email">Invite email</label>
                        <input class="ts-input" id="invite-email" name="email" type="email" placeholder="teammate@example.com" required autofocus="@(createIntent ? "" : null)" />
                    </div>
                    <button class="ts-btn ts-btn-primary" type="submit">@Icons.MailPlus(16) Send invite</button>
                </form>
                <p class="ts-meta">@pendingInvitations pending invitation@(pendingInvitations == 1 ? "" : "s") and @Model.TeamMembers.Count project access record@(Model.TeamMembers.Count == 1 ? "" : "s").</p>
                @if (Model.Invitations.Count > 0)
                {
                    <ul class="ts-access-summary-list ts-access-invitation-summary" aria-label="Invitation summary">
                        @foreach (var invitation in Model.Invitations.Take(3))
                        {
                            <li>
                                <span class="ts-table-strong">@invitation.Email</span>
                                <span class="ts-badge @(invitation.Status == "pending" ? "ts-badge-info" : "ts-badge-neutral")">@invitation.StatusLabel</span>
                                @if (invitation.Status == "pending")
                                {
                                    <form method="post" action="/api/v1/access/invitations/@invitation.InvitationId/revoke">
                                        <button class="ts-btn ts-btn-ghost ts-btn-sm" type="submit" title="Cancel invitation for @invitation.Email">@Icons.Trash2(15) Cancel</button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
            }
            else
            {
                <div class="ts-alert ts-alert-info" role="status">
                    <span class="ts-alert-title">@Icons.Info(16) Owner access required</span>
                    <span class="ts-alert-body">Organization and project owners manage invitations, roles, and project access.</span>
                </div>
            }
        </section>
    }
    else if (Model.Tab == "members")
    {
        <section class="ts-section" aria-labelledby="members-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="members-title">Organization members</h2>
                    <p class="ts-meta">Users returned by the TerraScale Dashboard API</p>
                </div>
            </div>
            @if (!Model.HasMembers)
            {
                @EmptyState(Model.CanManageOrganization ? "No members returned" : "Organization owner access required", Model.CanManageOrganization ? "The API did not return organization members for this account." : "Only organization owners can view the complete organization member list.")
            }
            else if (Model.Members.Count == 0)
            {
                @EmptyState("No members match", "Adjust the search or role filter to see another organization member.")
                @if (Model.FiltersActive)
                {
                    <a class="ts-btn ts-btn-secondary ts-btn-sm ts-access-empty-action" href="/access?tab=members">Clear filters</a>
                }
            }
            else
            {
                <div class="ts-table-wrap">
                    <table class="ts-table">
                        <thead>
                            <tr><th>Member</th><th>User ID</th><th>Organization role</th><th>Joined</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var member in Model.Members)
                            {
                                <tr>
                                    <td>
                                        <div class="ts-access-member-cell">
                                            <span class="ts-access-avatar" aria-hidden="true">@member.Initials</span>
                                            <div class="ts-access-identity">
                                                <div class="ts-access-member-name">@(member.DisplayName.Length > 0 ? member.DisplayName : member.Email)</div>
                                                <div class="ts-access-member-email">@member.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><code class="ts-access-mono-meta">@member.Id</code></td>
                                    <td><span class="ts-badge @(member.IsOrganizationOwner ? "ts-badge-success" : "ts-badge-neutral")">@member.RoleLabel</span></td>
                                    <td><span class="ts-access-meta-text">@member.JoinedAtText</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.PageCount > 1)
                {
                    @Pager()
                }
            }
        </section>
    }
    else if (Model.Tab == "projects")
    {
        <section class="ts-section" aria-labelledby="projects-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="projects-title">Project access context</h2>
                    <p class="ts-meta">Projects visible to the current account</p>
                </div>
            </div>
            @if (Model.Projects.Count == 0)
            {
                @EmptyState("No projects returned", "The API did not return accessible projects for this organization.")
            }
            else
            {
                <div class="ts-table-wrap">
                    <table class="ts-table">
                        <thead><tr><th>Project</th><th>Status</th><th>Created</th></tr></thead>
                        <tbody>
                            @foreach (var project in Model.Projects)
                            {
                                <tr>
                                    <td><div class="ts-access-min-width"><p class="ts-access-text-strong">@project.Name</p><p class="ts-meta">@project.Id</p></div></td>
                                    <td><span class="ts-badge @(project.IsCurrent ? "ts-badge-success" : "ts-badge-neutral")">@(project.IsCurrent ? "Current" : "Available")</span></td>
                                    <td><span class="ts-muted ts-ui">@project.CreatedAtText</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.PageCount > 1)
                {
                    @Pager()
                }
            }
        </section>
    }
    else
    {
        <section class="ts-section" aria-labelledby="invitations-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="invitations-title">Invitations and role changes</h2>
                    <p class="ts-meta">Invite organization members and manage project access</p>
                </div>
            </div>
            @if (Model.CanManageOrganization)
            {
                <form class="ts-access-invite-form" method="post" action="/api/v1/access/invitations">
                    <div class="ts-field">
                        <label class="ts-label" for="invite-email">Invite email</label>
                        <input class="ts-input" id="invite-email" name="email" type="email" placeholder="teammate@example.com" required autofocus="@(createIntent ? "" : null)" />
                    </div>
                    <button class="ts-btn ts-btn-primary" type="submit">@Icons.MailPlus(16) Send invite</button>
                </form>
            }
            else if (!Model.CanManageProject)
            {
                <div class="ts-alert ts-alert-info" role="status">
                    <span class="ts-alert-title">@Icons.Info(16) Owner access required</span>
                    <span class="ts-alert-body">Organization and project owners manage invitations, roles, and project access.</span>
                </div>
            }

            @if (Model.CanManageOrganization || Model.CanManageProject)
            {
                <div class="ts-access-two-column">
                    @if (Model.CanManageOrganization)
                    {
                        <section class="ts-section" aria-labelledby="pending-invitations-title">
                            <div class="ts-section-head">
                                <div>
                                    <h3 class="ts-panel-title" id="pending-invitations-title">Pending invitations</h3>
                                    <p class="ts-meta">Organization invitations and their current status</p>
                                </div>
                            </div>
                            @if (Model.Invitations.Count == 0)
                            {
                                @EmptyState("No invitations", "No organization invitations are pending or recently changed.")
                            }
                            else
                            {
                                <div class="ts-table-wrap">
                                    <table class="ts-table">
                                        <thead><tr><th>Invitee</th><th>Role</th><th>Status</th><th aria-label="Actions"></th></tr></thead>
                                        <tbody>
                                            @foreach (var invitation in Model.Invitations)
                                            {
                                                <tr>
                                                    <td><div class="ts-access-min-width"><p class="ts-access-truncate ts-access-text-strong">@invitation.Email</p><p class="ts-meta">Expires @invitation.ExpiresAtText</p></div></td>
                                                    <td><span class="ts-badge ts-badge-neutral">@invitation.Role</span></td>
                                                    <td><span class="ts-badge @(invitation.Status == "pending" ? "ts-badge-info" : "ts-badge-neutral")">@invitation.StatusLabel</span></td>
                                                    <td>
                                                        @if (invitation.Status == "pending")
                                                        {
                                                            <form method="post" action="/api/v1/access/invitations/@invitation.InvitationId/revoke">
                                                                <button class="ts-btn ts-btn-ghost ts-btn-sm" type="submit" title="Cancel invitation for @invitation.Email">@Icons.Trash2(15) Cancel</button>
                                                            </form>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (Model.PageCount > 1)
                                {
                                    @Pager()
                                }
                            }
                        </section>
                    }

                    @if (Model.CanManageProject)
                    {
                        <section class="ts-section" aria-labelledby="project-team-title">
                            <div class="ts-section-head">
                                <div>
                                    <h3 class="ts-panel-title" id="project-team-title">Project team</h3>
                                    <p class="ts-meta">Users with access through project roles</p>
                                </div>
                            </div>
                            @if (Model.TeamMembers.Count == 0)
                            {
                                @EmptyState("No project team members", "No users currently have project access through Access roles.")
                            }
                            else
                            {
                                <div class="ts-table-wrap">
                                    <table class="ts-table">
                                        <thead><tr><th>Member</th><th>Role</th><th>Joined</th><th aria-label="Actions"></th></tr></thead>
                                        <tbody>
                                            @foreach (var member in Model.TeamMembers)
                                            {
                                                <tr>
                                                    <td><div class="ts-access-min-width"><p class="ts-access-truncate ts-access-text-strong">@(member.DisplayName.Length > 0 ? member.DisplayName : member.Email)</p><p class="ts-access-truncate ts-meta">@member.Email</p></div></td>
                                                    <td>
                                                        <form method="post" action="/api/v1/access/members/@member.UserId/role">
                                                            <select class="ts-select ts-access-role-select" aria-label="Role for @member.Email" name="role" data-on:change="evt.target.closest('form').requestSubmit()">
                                                                @foreach (var option in new[] { "owner", "member", "viewer" })
                                                                {
                                                                    <option value="@option" selected="@(member.Role == option ? "selected" : null)">@(option == "owner" ? "Owner" : option == "member" ? "Member" : "Viewer")</option>
                                                                }
                                                            </select>
                                                        </form>
                                                    </td>
                                                    <td><span class="ts-muted ts-ui">@member.JoinedAtText</span></td>
                                                    <td>
                                                        <form method="post" action="/api/v1/access/members/@member.UserId/revoke">
                                                            <button class="ts-btn ts-btn-ghost ts-btn-sm" type="submit" title="Revoke project access for @member.Email">@Icons.Trash2(15) Revoke</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </section>
                    }
                </div>
            }
        </section>
    }
</div>
@ShellHtml.Bottom(shell)

@functions {
    private static Microsoft.AspNetCore.Html.HtmlString EmptyState(string title, string description) => new(
        $"<div class=\"ts-empty\"><span class=\"ts-empty-icon\">{Icons.SearchX(16).Value}</span><span class=\"ts-empty-title\">{title}</span><span class=\"ts-meta\">{description}</span></div>");
}
