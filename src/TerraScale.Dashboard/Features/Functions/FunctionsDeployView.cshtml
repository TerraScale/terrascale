@inherits RazorSlice<TerraScale.Dashboard.Features.Functions.FunctionsPage>
<div id="function-notice-wrap">@if(Model.Notice.Length > 0){<div class="ts-alert ts-alert-success" role="status"><p class="ts-alert-body" id="function-notice">@Model.Notice</p></div>}@if(Model.Error.Length > 0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}</div>
@(await RenderPartialAsync<TerraScale.Dashboard.Features.Functions.FunctionsStatsView,TerraScale.Dashboard.Features.Functions.FunctionsPage>(Model))
@(await RenderPartialAsync<TerraScale.Dashboard.Features.Functions.FunctionsCodeView,TerraScale.Dashboard.Features.Functions.FunctionsPage>(Model))
@(await RenderPartialAsync<TerraScale.Dashboard.Features.Functions.FunctionsSideView,TerraScale.Dashboard.Features.Functions.FunctionSide>(new(Model, Model.Selected?.Cron ?? "")))
