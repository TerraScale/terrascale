@inherits RazorSlice<TerraScale.Dashboard.Features.Functions.FunctionsPage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.Functions
@inject AssetUrls Assets
@{
    var list = DatabaseService.Path(Model.Database.Id, "functions");
    var canWrite = Model.Shell.Context.CanWriteProjectData;
    var writeReason = "Write access is required to deploy functions.";
    var selected = Model.Selected;
}
<main class="ts-page" data-database-id="@Model.Database.Id">
    @(await RenderPartialAsync<TerraScale.Dashboard.Common.Databases.DatabaseFrame, DatabaseFrameModel>(new(Model.Database, "functions", Databases: Model.Shell.Context.Project?.Databases.Values)))
    <h1 class="ts-sr-only" id="functions-title">Functions</h1>
    @if (Model.Error.Length > 0 && Model.DeleteName.Length == 0 && !Model.NoAccess)
    {
        <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p><a class="ts-link" href="@list">Reload functions</a></div>
    }
    @if (Model.Form is { } form)
    {
        <section class="ts-card ts-card-boxed" aria-labelledby="function-editor-title">
            <header class="ts-card-head">
                <div class="ts-card-heading"><h2 class="ts-card-title" id="function-editor-title">New function</h2></div>
                <div class="ts-card-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="@list">Cancel</a></div>
            </header>
            <div class="ts-card-body">
                <form method="post" action="/api/v1/dashboard/functions/deploy" class="ts-form ts-stack" id="function-deploy-form" data-submit-once>
                    <input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
                    <input type="hidden" name="databaseId" value="@Model.Database.Id" />
                    <input type="hidden" name="editing" value="0" />
                    <div class="ts-field"><label class="ts-label" for="function-name">Name</label><input class="ts-input ts-mono" id="function-name" name="name" value="@form.Name" required maxlength="63" pattern="@FunctionBackend.NameInputPattern" title="Start with a lowercase letter and use up to 63 lowercase letters, digits, underscores or hyphens." autocomplete="off" spellcheck="false" /></div>
                    <div class="ts-field"><label class="ts-label" for="function-cron">Cron</label><input class="ts-input ts-mono" id="function-cron" name="cron" value="@form.Cron" maxlength="128" autocomplete="off" spellcheck="false" /></div>
                    <div class="ts-field">
                        <label class="ts-label" for="function-editor">Source</label>
                        <ts-code-editor class="ts-code-editor" data-language="javascript" data-submit-shortcut="false" data-sql-schema="/api/v1/dashboard/data/schema?databaseId=@Model.Database.Id"><textarea class="ts-input ts-mono" id="function-editor" name="source" rows="16" required spellcheck="false" autocapitalize="off" autocomplete="off">@form.Source</textarea></ts-code-editor>
                        @if (form.Error.Length > 0)
                        {
                            <p class="ts-field-error" id="function-deploy-error" role="alert">@form.Error</p>
                        }
                    </div>
                </form>
            </div>
            <footer class="ts-card-foot"><button class="ts-btn ts-btn-primary" type="submit" form="function-deploy-form">Deploy function</button></footer>
        </section>
    }
    @if (selected is { } && Model.Form is null)
    {
        <div class="ts-columns">
            <div class="ts-columns-main ts-stack">
                <div id="function-notice-wrap">
                    @if (Model.Notice.Length > 0)
                    {
                        <div class="ts-alert ts-alert-success" role="status"><p class="ts-alert-body" id="function-notice">@Model.Notice</p></div>
                    }
                </div>
                @(await RenderPartialAsync<FunctionsStatsView, FunctionsPage>(Model))
                @(await RenderPartialAsync<FunctionsCodeView, FunctionsPage>(Model))
                @(await RenderPartialAsync<FunctionsTestView, FunctionsPage>(Model))
                @(await RenderPartialAsync<FunctionsSecretsView, FunctionsPage>(Model))
            </div>
            <div class="ts-columns-side">
                @(await RenderPartialAsync<FunctionsSideView, FunctionSide>(new(Model, selected.Cron ?? "")))
            </div>
        </div>
    }
    @if (selected is null && Model.Form is null && !Model.NoAccess && Model.Functions.Count > 0)
    {
        <section class="ts-card ts-card-boxed ts-card-flush" aria-labelledby="functions-list-title">
            <header class="ts-card-head">
                <div class="ts-card-heading"><h2 class="ts-card-title" id="functions-list-title">Functions</h2></div>
                <div class="ts-card-actions">
                    @if (canWrite)
                    {
                        <a class="ts-btn ts-btn-primary ts-btn-sm" href="@(list + "?edit=new")">@Icons.Render("Zap", 14)<span>New function</span></a>
                    }
                    else
                    {
                        <button class="ts-btn ts-btn-primary ts-btn-sm" type="button" disabled title="@writeReason">@Icons.Render("Zap", 14)<span>New function</span></button>
                    }
                </div>
            </header>
            <div class="ts-card-body">
                <ul class="ts-rows" id="functions">
                    @foreach (var function in Model.Functions)
                    {
                        <li><span class="ts-dot" data-tone="success" aria-hidden="true"></span><div class="ts-stack-sm"><span class="ts-rows-title ts-mono">@function.Name</span><span class="ts-rows-meta">@Runs(function) · Updated @ValueFormat.UtcDate(function.UpdatedAt)</span></div><span class="ts-badge ts-badge-tone" data-tone="success">deployed</span><div class="ts-rows-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="@(list + "?function=" + Uri.EscapeDataString(function.Name))">Open</a></div></li>
                    }
                </ul>
            </div>
        </section>
    }
    @if (Model.NoAccess)
    {
        <section class="ts-card ts-card-boxed" aria-labelledby="functions-title"><div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">Functions require read and write access to this project.</p><a class="ts-btn ts-btn-secondary" href="/organization?tab=members">View organization members</a></div></div></section>
    }
    @if (Model.Functions.Count == 0 && !Model.NoAccess && Model.Form is null)
    {
        <section class="ts-card ts-card-boxed" aria-labelledby="functions-title"><div class="ts-card-body"><div class="ts-empty" role="status"><p class="ts-empty-title">No functions yet.</p>@if (canWrite){<a class="ts-btn ts-btn-primary ts-btn-sm" href="@(list + "?edit=new")">New function</a>}<a class="ts-link" href="https://docs.terrascale.tech/guides/functions" @(ExternalLink.Attributes)>Deploy a function@(ExternalLink.Hint)</a></div></div></section>
    }
    @{
        var deleteName = Model.DeleteName.Length > 0 ? Model.DeleteName : selected?.Name;
    }
    @if (deleteName is not null && (Model.Shell.Context.CanWriteProjectData || Model.DeleteName.Length > 0))
    {
        <dialog class="ts-dialog" id="delete-function" data-init="@(Model.DeleteName.Length > 0 ? "el.showModal()" : "void 0")" closedby="any" aria-labelledby="delete-function-title">
            <div class="ts-dialog-content">
                <header class="ts-dialog-head">
                    <div class="ts-dialog-header">
                        <h2 class="ts-dialog-title" id="delete-function-title">Delete @deleteName?</h2>
                        <p class="ts-dialog-description">This deletes the function with its schedule and logs. Calls to its invoke URL fail from then on.</p>
                    </div>
                    <button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="delete-function">@Icons.Render("X", 18)</button>
                </header>
                <form method="post" action="/api/v1/dashboard/functions/delete" class="ts-form" data-submit-once>
                    <input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
                    <input type="hidden" name="databaseId" value="@Model.Database.Id" />
                    <input type="hidden" name="name" value="@deleteName" />
                    @if (Model.DeleteName.Length > 0)
                    {
                        <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>
                    }
                    <div class="ts-dialog-footer">
                        <button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="delete-function">Cancel</button>
                        <button class="ts-btn ts-btn-danger" type="submit">Delete function</button>
                    </div>
                </form>
            </div>
        </dialog>
    }
    @if (Model.Form is not null || selected is not null)
    {
        <script type="module" src="@Assets.Url("js/code-editor.js")" nonce="@Model.Shell.Nonce"></script>
    }
</main>
@functions {
    public ShellModel LayoutModel => Model.Shell;
    private static string Runs(FunctionRecord function) =>
        function.Cron is { Length: > 0 } value ? "Cron " + value + " UTC" : "HTTPS calls";
}
