@inherits RazorSlice<TerraScale.Dashboard.Features.Functions.FunctionsPage>
@{
    var canWrite = Model.Shell.Context.CanWriteProjectData;
}
@if(Model.Selected is { } selected){
<section class="ts-card" id="function-secrets" aria-labelledby="function-secrets-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="function-secrets-title">Secrets</h2></div></header><div class="ts-card-body ts-stack">
@if(Model.Secrets is null){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">Secrets are unavailable.</p></div>}
else if(Model.Secrets.Count == 0){<p class="ts-meta" id="function-secrets-empty">No secrets.</p>}
else{<ul class="ts-rows" id="function-secret-list">@foreach(var secret in Model.Secrets){<li><div class="ts-stack-sm"><span class="ts-rows-title ts-mono">@secret.Name</span><span class="ts-rows-meta">Updated @ValueFormat.UtcDate(secret.UpdatedAt)</span></div><span class="ts-mono ts-meta" aria-label="Hidden value">••••••••</span>@if(canWrite){<div class="ts-rows-actions"><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" aria-label="@("Replace " + secret.Name)" data-on:click="@("document.getElementById('function-secret-name').value = '" + secret.Name + "'; document.getElementById('function-secret-value').focus()")">Replace</button><form method="post" action="/api/v1/dashboard/functions/secrets/delete" data-submit-once><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="name" value="@selected.Name" /><input type="hidden" name="secret" value="@secret.Name" /><button class="ts-btn ts-btn-danger ts-btn-sm" type="submit" aria-label="@("Delete " + secret.Name)">Delete</button></form></div>}</li>}</ul>}
@if(canWrite){<form method="post" action="/api/v1/dashboard/functions/secrets/set" class="ts-form ts-stack" id="function-secret-form" data-submit-once><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="name" value="@selected.Name" />
<div class="ts-field"><label class="ts-label" for="function-secret-name">Name</label><input class="ts-input ts-mono" id="function-secret-name" name="secret" value="@Model.SecretName" required maxlength="64" pattern="@TerraScale.Dashboard.Features.Functions.FunctionBackend.SecretInputPattern" title="Start with an uppercase letter or underscore and use up to 64 uppercase letters, digits or underscores." autocomplete="off" spellcheck="false" autocapitalize="characters" /></div>
<div class="ts-field"><label class="ts-label" for="function-secret-value">Value</label><input class="ts-input ts-mono" id="function-secret-value" name="value" type="password" required autocomplete="new-password" spellcheck="false" />@if(Model.SecretError.Length > 0){<p class="ts-field-error" id="function-secret-error" role="alert">@Model.SecretError</p>}</div>
</form>}
</div>@if(canWrite){<footer class="ts-card-foot"><button class="ts-btn ts-btn-primary" type="submit" form="function-secret-form">Save secret</button></footer>}</section>
}
