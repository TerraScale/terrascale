@inherits RazorSlice<TerraScale.Dashboard.Features.Functions.FunctionsPage>
@using System.Globalization
<section class="ts-card" id="function-test" aria-labelledby="function-test-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="function-test-title">Test</h2></div><div class="ts-card-actions"><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit" form="function-run-form">Run</button></div></header><div class="ts-card-body">
<form method="post" action="/api/v1/dashboard/functions/invoke" id="function-run-form" class="ts-form ts-stack" data-on:submit="@("@post('/api/v1/dashboard/functions/invoke', {contentType:'form'})")"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="name" value="@(Model.Selected?.Name)" /><input type="hidden" name="trigger" value="@Model.LogsTrigger" /><input type="hidden" name="status" value="@Model.LogsStatus" />
<div class="ts-field"><label class="ts-label" for="function-query">Query parameters</label><input class="ts-input ts-mono" id="function-query" name="query" value="@Model.RunQuery" placeholder="a=1&amp;b=2" spellcheck="false" autocapitalize="off" autocomplete="off" /></div>
<div class="ts-field"><label class="ts-label" for="function-event">Event JSON</label><textarea class="ts-input ts-mono" id="function-event" name="event" rows="4" spellcheck="false" autocapitalize="off" autocomplete="off">@(Model.RunEvent.Length > 0 ? Model.RunEvent : "{}")</textarea>@if(Model.RunError.Length > 0){<p class="ts-field-error" id="function-event-error" role="alert">@Model.RunError</p>}</div>
@if(Model.RunResult.Length > 0){<div class="ts-field"><span class="ts-label">Result</span><pre class="ts-code" id="function-result">@Model.RunResult</pre></div>}
</form>
</div></section>
<section class="ts-card ts-card-boxed ts-card-flush" id="function-logs-card" aria-labelledby="function-logs-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="function-logs-title">Latest invocations</h2></div><div class="ts-card-actions"><form class="ts-filters" method="get" action="@DatabaseService.Path(Model.Database.Id, "functions")"><input type="hidden" name="function" value="@(Model.Selected?.Name)" /><input type="hidden" name="window" value="@Model.Window" /><label class="ts-sr-only" for="function-logs-trigger">Trigger</label><select class="ts-select" id="function-logs-trigger" name="trigger" data-on:change="el.form.requestSubmit()"><option value="" selected="@(Model.LogsTrigger.Length == 0)">All triggers</option><option value="http" selected="@(Model.LogsTrigger == "http")">HTTP</option><option value="cron" selected="@(Model.LogsTrigger == "cron")">Cron</option></select><label class="ts-sr-only" for="function-logs-status">Status</label><select class="ts-select" id="function-logs-status" name="status" data-on:change="el.form.requestSubmit()"><option value="" selected="@(Model.LogsStatus.Length == 0)">All</option><option value="ok" selected="@(Model.LogsStatus == "ok")">Succeeded</option><option value="error" selected="@(Model.LogsStatus == "error")">Failed</option></select></form></div></header><div class="ts-card-body">
@if(Model.Logs.Count == 0){<div class="ts-empty" role="status"><p class="ts-empty-title">@(Model.Stats?.Invocations == 0 ? "No invocations in this window yet. Run it from the Test tab or call its HTTPS URL." : "No invocations match these filters.")</p></div>}else{
<ul class="ts-functions-invocations" id="function-logs">
@foreach(var log in Model.Logs){<li><details><summary><span class="ts-functions-invocation-summary">
<time datetime="@log.At.ToString("O", CultureInfo.InvariantCulture)">@log.At.UtcDateTime.ToString("MMM d HH:mm:ss 'UTC'", CultureInfo.InvariantCulture)</time>
<span>@log.Trigger</span><span class="ts-badge ts-badge-tone" data-tone="@(log.Status == "ok" ? "success" : "danger")">@(log.Status == "ok" ? "Succeeded" : "Failed")</span>
<span>HTTP @(log.HttpStatus?.ToString(CultureInfo.InvariantCulture) ?? "—")</span><span>@log.DurationMs.ToString("0.##", CultureInfo.InvariantCulture) ms</span>
<span>SQL calls @log.SqlCalls.ToString(CultureInfo.InvariantCulture)</span><span>SQL @log.SqlMs.ToString(CultureInfo.InvariantCulture) ms</span>
<span>Rows read @log.RowsRead.ToString(CultureInfo.InvariantCulture)</span><span>Rows written @log.RowsWritten.ToString(CultureInfo.InvariantCulture)</span><span>Response @log.ResponseBytes.ToString(CultureInfo.InvariantCulture) B</span>
</span></summary><div class="ts-stack-sm">
@if(log.Lines.Count > 0){<pre class="ts-code" aria-label="Console output">@string.Join("\n", log.Lines)</pre>}
@if(log.Error is { Length: > 0 } error){<pre class="ts-code ts-functions-error" aria-label="Invocation error">@error</pre>}
@if(log.Lines.Count == 0 && log.Error is not { Length: > 0 }){<p>No console output.</p>}
</div></details></li>}
</ul>}
</div></section>
