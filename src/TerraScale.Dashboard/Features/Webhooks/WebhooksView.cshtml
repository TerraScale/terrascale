@inherits RazorSlice<TerraScale.Dashboard.Features.Webhooks.WebhooksPage>
@implements IUsesLayout<TerraScale.Dashboard.Shared.UI.Slices.ShellDocument, ShellModel>
<main class="ts-page ts-db-detail">
@(await RenderPartialAsync<TerraScale.Dashboard.Shared.Databases.DatabaseFrame,DatabaseFrameModel>(new(Model.Database, "webhooks", Model.Collection)))
@if(Model.Created is { } created){
<section class="ts-card" aria-labelledby="webhook-created-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="webhook-created-title">Webhook created</h2><p class="ts-card-description">Store this signing secret securely now. It cannot be retrieved again. Decode it as base64url bytes to verify signatures.</p></div></header><div class="ts-card-body ts-stack"><p class="ts-break">@created.Url</p><pre class="ts-code" id="webhook-secret" data-on:pagehide__window="el.textContent = ''">@created.Secret</pre><p class="ts-hint">Never log the secret. If it is lost, delete this webhook and create it again.</p><a class="ts-btn ts-btn-primary" href="@DatabaseService.Path(Model.Database.Id,"webhooks",Model.Collection)">Continue to webhooks</a></div></section>
}else{
<form method="get" action="@DatabaseService.Path(Model.Database.Id,"webhooks")" class="ts-filters" aria-label="Choose collection"><label class="ts-filter-field" for="webhook-collection">Collection<input class="ts-input ts-mono" id="webhook-collection" name="collection" value="@Model.Collection" required /></label><button type="submit" class="ts-btn ts-btn-secondary">Open</button></form>
@if(Model.Error.Length > 0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p><a class="ts-link" href="@DatabaseService.Path(Model.Database.Id,"webhooks",Model.Collection)">Reload webhooks</a></div>}
else if(Model.Collection.Length == 0){<div class="ts-empty" role="status"><p class="ts-empty-title">Create a collection before adding webhooks.</p></div>}
else{
<section class="ts-card ts-card-flush" aria-labelledby="webhooks-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="webhooks-title">Webhooks for @Model.Collection</h2><p class="ts-card-description">Receive document change identities from registration onward. Deliveries are at least once; verify signatures and deduplicate delivery IDs.</p></div></header><div class="ts-card-body">
@if(Model.Hooks.Count == 0){<div class="ts-empty" role="status"><p class="ts-empty-title">No webhooks yet.</p></div>}else{
<div class="ts-table-wrap"><table class="ts-table" id="webhooks"><thead><tr><th scope="col">Endpoint</th><th scope="col">Status</th><th scope="col">Created</th><th scope="col">Actions</th></tr></thead><tbody>
@foreach(var hook in Model.Hooks){<tr><td class="ts-break">@hook.Url</td><td>@hook.Status @if(hook.Status=="feed_gap"){<p class="ts-hint">Reconcile current data, delete this webhook and create it again to resume.</p>}</td><td>@ValueFormat.UtcDate(hook.CreatedAt)</td><td><a class="ts-btn ts-btn-secondary ts-btn-sm" href="@(DatabaseService.Path(Model.Database.Id,"webhooks",Model.Collection)+"&webhook="+Uri.EscapeDataString(hook.Id))">Delivery log</a>
@if(Model.Shell.Context.CanWriteProjectData){@(await RenderPartialAsync<TerraScale.Dashboard.Shared.UI.Slices.ConfirmDialog, ConfirmDialogModel>(new("delete-webhook-" + hook.Id, "/api/v1/dashboard/webhooks/delete", "Delete webhook", hook.Url, "Future attempts stop; an in-flight delivery may complete.", Model.Shell.CsrfToken, new Dictionary<string, string> { ["databaseId"] = Model.Database.Id, ["collection"] = Model.Collection, ["id"] = hook.Id })))}</td></tr>}
</tbody></table></div>}
@if(Model.Shell.Context.CanWriteProjectData){<form method="post" action="/api/v1/dashboard/webhooks" data-submit-once class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="collection" value="@Model.Collection" /><div class="ts-field"><label class="ts-label" for="webhook-url">HTTPS endpoint</label><input class="ts-input" id="webhook-url" name="url" type="url" maxlength="2048" placeholder="https://receiver.example/events" autocomplete="off" required /><p class="ts-hint">Public HTTPS on port 443, without credentials or fragments. Existing documents are not backfilled.</p></div><button type="submit" class="ts-btn ts-btn-primary">Create webhook</button></form>}
</div></section>
@if(Model.Selected.Length > 0){<section class="ts-card ts-card-flush" aria-labelledby="deliveries-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="deliveries-title">Delivery log</h2><p class="ts-card-description">Latest 100 retained records, oldest first. Failed deliveries retry indefinitely with backoff capped at one hour.</p></div><a class="ts-btn ts-btn-secondary ts-btn-sm" href="@(DatabaseService.Path(Model.Database.Id,"webhooks",Model.Collection)+"&webhook="+Uri.EscapeDataString(Model.Selected))">Refresh deliveries</a></header><div class="ts-card-body">
@if(Model.Deliveries.Count == 0){<div class="ts-empty" role="status"><p class="ts-empty-title">No deliveries yet.</p></div>}else{
<div class="ts-table-wrap" tabindex="0" role="region" aria-label="Delivery records"><table class="ts-table" id="webhook-deliveries"><thead><tr><th scope="col">Delivery</th><th scope="col">Created</th><th scope="col">Status</th><th scope="col">Attempts</th><th scope="col">Last attempt</th><th scope="col">Next attempt</th><th scope="col">HTTP</th><th scope="col">Error</th></tr></thead><tbody>@foreach(var delivery in Model.Deliveries){<tr><td class="ts-mono">@delivery.Id</td><td>@ValueFormat.UtcDate(delivery.CreatedAt)</td><td>@delivery.Status</td><td>@delivery.Attempts</td><td>@(delivery.LastAttemptAt is { } last ? ValueFormat.UtcDate(last) : "—")</td><td>@(delivery.NextAttemptAt is { } next ? ValueFormat.UtcDate(next) : "—")</td><td>@(delivery.HttpStatus?.ToString() ?? "—")</td><td>@(delivery.ErrorCode ?? "—")</td></tr>}</tbody></table></div>}
</div></section>}
}
}
</main>
@functions { public ShellModel LayoutModel => Model.Shell; }
