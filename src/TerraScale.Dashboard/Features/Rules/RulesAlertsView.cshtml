@inherits RazorSlice<TerraScale.Dashboard.Features.Rules.RulesPage>
<div class="ts-stack" id="rules-alerts"><input type="hidden" name="version" form="rules-form" value="@Model.LoadedVersion" />@if(Model.Error.Length > 0){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body" id="rules-error">@Model.Error</p>@if(Model.Stale){<a class="ts-link" href="@Model.Path">Reload rules</a>}</div>}@if(Model.Notice.Length > 0){<div class="ts-alert ts-alert-success" role="status"><p class="ts-alert-body" id="rules-notice">@Model.Notice</p></div>}</div>
