@inherits RazorSlice<AuthenticationPageModel>
@{ var shell = Model.Shell; var empty = Model.Resources.Length == 0; }
@ShellHtml.Top(shell)
<div class="ts-page ts-auth-console">
  <section class="ts-auth-header ts-panel">
    <div><div class="ts-eyebrow">@Icons.ShieldCheck(14) IDENTITY PLATFORM</div><h2 class="ts-auth-hero-title">@Model.Current.Title</h2><p class="ts-page-desc">@((IHtmlContent)new HtmlString(Model.Current.Description))</p><div class="ts-auth-instance-line"><span class="ts-meta">Project instance</span><code>@Model.InstanceSlug</code><span class="ts-badge ts-badge-success">Connected</span></div></div>
    <div class="ts-auth-header-actions"><a class="ts-btn ts-btn-secondary" href="/auth/quickstart">@Icons.Terminal(15) Quickstart</a><a class="ts-btn ts-btn-primary" href="/auth/settings">@Icons.Settings(15) Instance settings</a></div>
  </section>
  @if (Model.Toast is { Length: > 0 } toast) { <div class="ts-alert ts-alert-success" role="status">@Icons.CircleCheck(16)<span>@toast</span></div> }
  @if (Model.Error is { Length: > 0 } error) { <div class="ts-alert ts-alert-danger" role="alert">@Icons.CircleAlert(16)<span>@error</span></div> }
  @if (Model.Section == "overview") { @Overview(Model) }
  else if (Model.Section == "settings") { @Settings(Model) }
  else if (Model.Section == "quickstart") { @Quickstart(Model) }
  else if (Model.Section == "billing") { @Billing(Model) }
  else { @ResourcePage(Model) }
</div>
@ShellHtml.Bottom(shell)

@functions {
  public static IHtmlContent Overview(AuthenticationPageModel model)
  {
    var resources = model.AllResources;
    return new HtmlString($"""
      <section class="ts-auth-stat-grid">
        {Stat("Users", resources.Count(r => r.Section == "users"), "/auth/users", "Users", "cyan")}
        {Stat("Organizations", resources.Count(r => r.Section == "organizations"), "/auth/organizations", "Organizations", "purple")}
        {Stat("Connections", resources.Count(r => r.Section == "connections"), "/auth/connections", "OIDC + SAML ready", "amber")}
        {Stat("Webhooks", resources.Count(r => r.Section == "webhooks"), "/auth/webhooks", "Signed delivery", "green")}
      </section>
      <section class="ts-grid ts-grid-two ts-auth-overview-grid">
        <section class="ts-panel"><div class="ts-panel-header"><h3 class="ts-panel-title">Build your identity stack</h3><p class="ts-panel-subtitle">Every ts-auth capability is available as a typed management API.</p></div><div class="ts-auth-checklist">
          {Check("Connect your application", "Create a scoped management key and copy the instance issuer.", "/auth/keys", true)}
          {Check("Add your first user", "Create a test identity before wiring your sign-in screen.", "/auth/users", resources.Any(r => r.Section == "users"))}
          {Check("Register a client", "Use PKCE for browsers and public clients.", "/auth/clients", resources.Any(r => r.Section == "clients"))}
          {Check("Configure delivery", "Send signed user and session events to your backend.", "/auth/webhooks", resources.Any(r => r.Section == "webhooks"))}
        </div></section>
        <section class="ts-panel"><div class="ts-panel-header"><h3 class="ts-panel-title">Explore ts-auth</h3><p class="ts-panel-subtitle">The pieces you need for a complete identity system.</p></div><div class="ts-auth-link-grid">
          {Link("Users and organizations", "Profiles, roles, memberships and invitations.", "/auth/users", "Users")}
          {Link("Enterprise sign-in", "OIDC, SAML, SCIM and domain enrollment.", "/auth/connections", "GlobeLock")}
          {Link("Token infrastructure", "OAuth clients, JWT templates and key rotation.", "/auth/clients", "KeyRound")}
          {Link("Security evidence", "Durable audit events and webhook deliveries.", "/auth/audit", "ScrollText")}
        </div></section>
      </section>
      <section class="ts-panel"><div class="ts-panel-header ts-panel-header-row"><div><h3 class="ts-panel-title">Instance endpoint</h3><p class="ts-panel-subtitle">Use this issuer for OIDC discovery, JWKS and hosted sign-in.</p></div><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-copy="{model.Issuer}">{Icons.Copy(14)} Copy issuer</button></div><div class="ts-auth-code-block"><code>{model.Issuer}</code><span class="ts-auth-code-note">/.well-known/openid-configuration</span></div></section>
    """);
  }

  public static IHtmlContent ResourcePage(AuthenticationPageModel model)
  {
    var section = model.Current;
    var rows = string.Join("", model.Resources.Select(resource => Row(section, resource)));
    var create = section.CanCreate ? $"<button class=\"ts-btn ts-btn-primary\" type=\"button\" data-open-dialog=\"#auth-create-dialog\">{Icons.Plus(15)} Add {section.Singular}</button>" : "";
    var secret = model.Secret is { Length: > 0 } value ? $"<div class=\"ts-alert ts-alert-warning ts-auth-secret\" role=\"status\">{Icons.KeyRound(16)}<span><strong>Copy this management key now.</strong><code>{System.Net.WebUtility.HtmlEncode(value)}</code><small>It will not be shown again.</small></span><button class=\"ts-btn ts-btn-secondary ts-btn-sm\" type=\"button\" data-copy=\"{System.Net.WebUtility.HtmlEncode(value)}\">Copy key</button></div>" : "";
    var search = $"<form method=\"get\" class=\"ts-auth-toolbar\"><label class=\"ts-auth-search\">{Icons.Search(15)}<input class=\"ts-input\" type=\"search\" name=\"q\" value=\"{System.Net.WebUtility.HtmlEncode(model.Search)}\" placeholder=\"Search {section.Title.ToLowerInvariant()}\" aria-label=\"Search {section.Title}\" /></label>{(model.Search.Length > 0 ? "<a class=\"ts-btn ts-btn-ghost ts-btn-sm\" href=\"" + section.Href + "\">Clear</a>" : "")}</form>";
    var body = model.Resources.Length == 0 ? $"<div class=\"ts-empty\"><span class=\"ts-empty-icon-box\">{Icons.SearchX(18)}</span><span class=\"ts-empty-title\">No {section.Title.ToLowerInvariant()} yet</span><span>{(model.Search.Length > 0 ? "Try a different search." : $"Use the button above to create your first {section.Singular}.")}</span></div>" : $"<div class=\"ts-table-wrap ts-table-flush\"><table class=\"ts-table\"><thead><tr><th>Name</th>{string.Join("", section.Columns.Select(column => $"<th>{column.Replace('_', ' ')}</th>"))}<th>Status</th><th></th></tr></thead><tbody>{rows}</tbody></table></div>";
    var detail = model.Selected is { } selected ? Detail(section, model, selected) : "";
    return new HtmlString($"<section class=\"ts-panel\"><div class=\"ts-panel-header ts-panel-header-row\"><div><h2 class=\"ts-panel-title\">{section.Title}</h2><p class=\"ts-panel-subtitle\">{section.Description}</p></div>{create}</div>{secret}{search}{body}{detail}</section>{CreateDialog(section, model.CreateRequested, model.FormValues)}");
  }

  public static IHtmlContent Billing(AuthenticationPageModel model) => new HtmlString($"<section class=\"ts-grid ts-grid-two\"><section class=\"ts-panel\"><div class=\"ts-panel-header\"><h2 class=\"ts-panel-title\">Identity plan</h2><p class=\"ts-panel-subtitle\">Scale your identity platform as your product grows.</p></div><div class=\"ts-auth-billing-card\"><span class=\"ts-badge ts-badge-success\">Current plan</span><strong>{System.Net.WebUtility.HtmlEncode(model.Instance.Plan)}</strong><p>Demo mode includes the complete management surface. Production billing connects to ts-auth's Stripe-backed plan and quota APIs.</p><a class=\"ts-btn ts-btn-primary\" href=\"/settings?tab=billing\">Review project billing {Icons.ArrowRight(14)}</a></div></section><section class=\"ts-panel\"><div class=\"ts-panel-header\"><h2 class=\"ts-panel-title\">Usage signals</h2><p class=\"ts-panel-subtitle\">Keep an eye on the resources that affect your plan.</p></div><div class=\"ts-auth-billing-list\"><div><span>Users</span><strong>{model.Count("users")}</strong></div><div><span>Organizations</span><strong>{model.Count("organizations")}</strong></div><div><span>OAuth clients</span><strong>{model.Count("clients")}</strong></div><div><span>Webhook endpoints</span><strong>{model.Count("webhooks")}</strong></div></div></section></section>");

  private static string Detail(AuthSection section, AuthenticationPageModel model, AuthResource resource)
  {
    var fields = string.Join("", section.Fields.Select(field => $"<div><span>{field.Label}</span><code>{System.Net.WebUtility.HtmlEncode(resource.Value(field.Key))}</code></div>"));
    return $"<section class=\"ts-auth-detail\"><div><span class=\"ts-eyebrow\">{Icons.Fingerprint(14)} RESOURCE DETAIL</span><h3>{System.Net.WebUtility.HtmlEncode(resource.Name)}</h3><span class=\"ts-meta ts-mono\">{resource.Id}</span></div><a class=\"ts-btn ts-btn-ghost ts-btn-sm\" href=\"{section.Href}{(model.Search.Length > 0 ? "?q=" + Uri.EscapeDataString(model.Search) : "")}\">Close</a><div class=\"ts-auth-detail-grid\">{fields}</div></section>";
  }

  public static IHtmlContent Settings(AuthenticationPageModel model)
  {
    return new HtmlString($"""
      <section class="ts-grid ts-grid-two">
        <section class="ts-panel"><div class="ts-panel-header"><h3 class="ts-panel-title">Hosted UI branding</h3><p class="ts-panel-subtitle">These values appear on sign-in, account and consent pages.</p></div><form method="post" action="/api/v1/auth-management/instance" class="ts-auth-settings-form"><div class="ts-field"><label class="ts-label" for="auth-name">Instance name</label><input class="ts-input" id="auth-name" name="name" value="{System.Net.WebUtility.HtmlEncode(model.InstanceName)}" required /></div><div class="ts-field"><label class="ts-label" for="auth-logo">Logo URL</label><input class="ts-input" id="auth-logo" name="logo_url" type="url" value="{System.Net.WebUtility.HtmlEncode(model.Instance.LogoUrl)}" placeholder="https://assets.example.com/logo.svg" /><span class="ts-field-help">Absolute HTTPS URL. SVG and PNG are supported.</span></div><div class="ts-field"><label class="ts-label" for="auth-color">Theme color</label><input class="ts-input ts-input-color" id="auth-color" name="theme_color" value="{System.Net.WebUtility.HtmlEncode(model.Instance.ThemeColor)}" /><span class="ts-field-help">A six-digit hex color such as #3B82F6.</span></div><div class="ts-auth-setting-actions"><span class="ts-meta">Changes apply to new hosted pages immediately.</span><button class="ts-btn ts-btn-primary" type="submit">{Icons.Save(15)} Save branding</button></div></form></section>
        <section class="ts-panel"><div class="ts-panel-header"><h3 class="ts-panel-title">API contract</h3><p class="ts-panel-subtitle">The management API is scoped to this project's instance.</p></div><div class="ts-auth-contract-list"><div><span>{Icons.LockKeyhole(17)}</span><span><strong>Management keys</strong><small>Scoped bearer keys are shown once and hashed at rest.</small></span><a class="ts-inline-link" href="/auth/keys">Manage</a></div><div><span>{Icons.ShieldCheck(17)}</span><span><strong>Issuer</strong><small>{model.Issuer}</small></span><button class="ts-btn ts-btn-ghost ts-btn-sm" type="button" data-copy="{model.Issuer}">Copy</button></div><div><span>{Icons.Webhook(17)}</span><span><strong>Signed events</strong><small>HMAC signatures with retry and dead-letter tracking.</small></span><a class="ts-inline-link" href="/auth/webhooks">Configure</a></div></div></section>
      </section>
      """);
  }

  public static IHtmlContent Quickstart(AuthenticationPageModel model)
  {
    var code = "curl -X GET \\\n  -H 'Authorization: Bearer sk_live_…' \\\n  https://auth.terrascale.tech/v1/" + model.InstanceSlug + "/users";
    return new HtmlString($"""<section class="ts-grid ts-grid-two"><section class="ts-panel"><div class="ts-panel-header"><h3 class="ts-panel-title">Connect in minutes</h3><p class="ts-panel-subtitle">The same API contract works from every official SDK.</p></div><ol class="ts-auth-steps"><li><span>1</span><div><strong>Create a management key</strong><small>Give it only the route families your deployment needs.</small><a href="/auth/keys">Create a key {Icons.ArrowRight(14)}</a></div></li><li><span>2</span><div><strong>Point your SDK at the issuer</strong><small>Use OIDC discovery instead of hard-coding token endpoints.</small><code>{model.Issuer}</code></div></li><li><span>3</span><div><strong>Verify the first user</strong><small>Use the hosted flow or your own UI with the OAuth 2.1 endpoints.</small><a href="/auth/users">Create a test user {Icons.ArrowRight(14)}</a></div></li></ol></section><section class="ts-panel"><div class="ts-panel-header"><h3 class="ts-panel-title">Management API</h3><p class="ts-panel-subtitle">Every write is audited and every secret is returned once.</p></div><pre class="ts-code-block"><code>{code}</code></pre><div class="ts-auth-sdk-links"><a href="/auth/keys">API keys {Icons.ArrowRight(14)}</a><a href="/auth/audit">Audit events {Icons.ArrowRight(14)}</a></div></section></section>""");
  }

  private static string Stat(string label, int value, string href, string foot, string tone) => $"<a class=\"ts-auth-stat-card\" href=\"{href}\"><span class=\"ts-auth-stat-icon ts-auth-tone-{tone}\">{Icons.Users(18)}</span><span class=\"ts-meta\">{label}</span><strong>{value}</strong><span class=\"ts-auth-stat-foot\">{foot} {Icons.ArrowUpRight(13)}</span></a>";
  private static string Check(string title, string detail, string href, bool done) => $"<a class=\"ts-auth-check {(done ? "is-done" : "")}\" href=\"{href}\"><span>{(done ? Icons.Check(14).Value : "4")}</span><span><strong>{title}</strong><small>{detail}</small></span>{Icons.ChevronRight(15)}</a>";
  private static string Link(string title, string detail, string href, string icon) => $"<a class=\"ts-auth-explore-link\" href=\"{href}\"><span>{icon switch { "GlobeLock" => Icons.GlobeLock(17), "KeyRound" => Icons.KeyRound(17), "ScrollText" => Icons.ScrollText(17), _ => Icons.Users(17) }}</span><span><strong>{title}</strong><small>{detail}</small></span>{Icons.ArrowRight(14)}</a>";
  private static string Row(AuthSection section, AuthResource resource)
  {
    var cells = string.Join("", section.Columns.Select(column => $"<td class=\"ts-meta ts-break-all\">{System.Net.WebUtility.HtmlEncode(resource.Value(column))}</td>"));
    var delete = $"<form method=\"post\" action=\"/api/v1/auth-management/{section.Key}/{resource.Id}/delete\"><button class=\"ts-btn ts-btn-ghost ts-btn-sm\" type=\"submit\" data-confirm=\"Delete this {section.Singular}?\">{Icons.Trash2(15)}<span class=\"ts-sr-only\">Delete {resource.Name}</span></button></form>";
    var action = section.Key switch
    {
      "users" => $"<form method=\"post\" action=\"/api/v1/auth-management/users/{resource.Id}/actions/block\"><button class=\"ts-btn ts-btn-ghost ts-btn-sm\" type=\"submit\">{(resource.Status == "Blocked" ? "Unblock" : "Block")}</button></form>",
      "webhooks" => $"<form method=\"post\" action=\"/api/v1/auth-management/webhooks/{resource.Id}/actions/test\"><button class=\"ts-btn ts-btn-ghost ts-btn-sm\" type=\"submit\">Send test</button></form>",
      "deliveries" when resource.Status == "Failed" => $"<form method=\"post\" action=\"/api/v1/auth-management/deliveries/{resource.Id}/actions/replay\"><button class=\"ts-btn ts-btn-ghost ts-btn-sm\" type=\"submit\">Replay</button></form>",
      "directories" => $"<form method=\"post\" action=\"/api/v1/auth-management/directories/{resource.Id}/actions/rotate\"><button class=\"ts-btn ts-btn-ghost ts-btn-sm\" type=\"submit\">Rotate token</button></form>",
      _ => ""
    };
    var removal = section.CanDelete ? delete : "";
    return $"<tr><td><a class=\"ts-auth-resource-link\" href=\"{section.Href}?id={Uri.EscapeDataString(resource.Id)}\"><strong>{System.Net.WebUtility.HtmlEncode(resource.Name)}</strong></a><div class=\"ts-meta ts-mono\">{resource.Id}</div></td>{cells}<td><span class=\"ts-badge ts-badge-success\">{System.Net.WebUtility.HtmlEncode(resource.Status)}</span></td><td><div class=\"ts-auth-row-actions\">{action}{removal}</div></td></tr>";
  }
  private static string CreateDialog(AuthSection section, bool autoOpen = false, IReadOnlyDictionary<string, string>? values = null)
  {
    if (!section.CanCreate) return "";
    var fields = string.Join("", section.Fields.Select(field => Field(field, values)));
    return $"<dialog class=\"ts-dialog\" id=\"auth-create-dialog\"{(autoOpen ? " data-autoopen" : "")}><div class=\"ts-dialog-content\"><div class=\"ts-dialog-header\"><h3 class=\"ts-dialog-title\">Add {section.Singular}</h3><p class=\"ts-dialog-description\">This creates a demo resource with the same validation rules as the ts-auth management API.</p></div><form method=\"post\" action=\"/api/v1/auth-management/{section.Key}\" class=\"ts-form\">{fields}<div class=\"ts-dialog-footer\"><button class=\"ts-btn ts-btn-secondary\" type=\"button\" data-close-dialog>Cancel</button><button class=\"ts-btn ts-btn-primary\" type=\"submit\">Create {section.Singular}</button></div></form></div></dialog>";
  }
  private static string Field(AuthField field, IReadOnlyDictionary<string, string>? values)
  {
    var label = $"<label class=\"ts-label\" for=\"auth-field-{field.Key}\">{field.Label}{(field.Required ? "" : " <span class=\"ts-meta\">(optional)</span>")}</label>";
    var value = System.Net.WebUtility.HtmlEncode(values?.GetValueOrDefault(field.Key) ?? field.Default);
    var input = field.Type switch
    {
      "textarea" or "json" or "claims" or "uris" or "origins" => $"<textarea class=\"ts-textarea\" id=\"auth-field-{field.Key}\" name=\"{field.Key}\" {(field.Required ? "required" : "")}>{value}</textarea>",
      "select" => $"<select class=\"ts-select\" id=\"auth-field-{field.Key}\" name=\"{field.Key}\">{string.Join("", (field.Options ?? []).Select(option => $"<option value=\"{option}\" {(option == field.Default ? "selected" : "")}>{option}</option>"))}</select>",
      _ => $"<input class=\"ts-input\" id=\"auth-field-{field.Key}\" name=\"{field.Key}\" type=\"{(field.Type is "slug" or "template" ? "text" : field.Type)}\" value=\"{value}\" {(field.Required ? "required" : "")} />",
    };
    return $"<div class=\"ts-field\">{label}{input}<span class=\"ts-field-help\">{field.Hint}</span></div>";
  }
}
