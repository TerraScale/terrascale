@inherits RazorSlice<AuthenticationPageModel>
@{ var shell = Model.Shell; }
@ShellHtml.Top(shell)
<div class="ts-page ts-auth-console">
    @if (Model.Toast is { Length: > 0 } toast)
    {
        <div class="ts-alert ts-alert-success" role="status">@Icons.CircleCheck(16)<span>@toast</span></div>
    }
    @if (Model.Error is { Length: > 0 } error)
    {
        <div class="ts-alert ts-alert-danger" role="alert">@Icons.CircleAlert(16)<span>@error</span></div>
    }

    <div class="ts-toolbar ts-auth-toolbar">
        <nav class="ts-tabs ts-auth-tabs" aria-label="Authentication areas">
            @foreach (var group in Model.NavigationGroups)
            {
                <a class="ts-tab" href="@group.Href" aria-current="@(Model.CurrentGroup.Key == group.Key ? "page" : null)" aria-selected="@(Model.CurrentGroup.Key == group.Key ? "true" : "false")">@Icon(group.Icon, 16) @group.Title</a>
            }
        </nav>
        <details class="ts-menu ts-auth-area-menu">
            <summary class="ts-select ts-auth-area-trigger" aria-label="Choose an authentication area"><span>@Model.CurrentGroup.Title</span>@Icons.ChevronDown(14)</summary>
            <div class="ts-menu-panel" aria-label="Authentication areas">
                <span class="ts-auth-menu-heading">Authentication areas</span>
                @foreach (var group in Model.NavigationGroups)
                {
                    <a class="ts-menu-item" href="@group.Href" aria-current="@(Model.CurrentGroup.Key == group.Key ? "page" : null)">
                        <span class="ts-menu-item-icon">@Icon(group.Icon, 16)</span>
                        <span class="ts-menu-label">@group.Title</span>
                    </a>
                }
            </div>
        </details>
        @if (Model.CurrentGroupSections.Count > 1)
        {
            <details class="ts-menu ts-menu-end ts-auth-resource-menu">
                <summary class="ts-select ts-auth-resource-trigger" aria-label="Choose a @Model.CurrentGroup.Title section"><span>@Model.Current.Title</span>@Icons.ChevronDown(14)</summary>
                <div class="ts-menu-panel" aria-label="@Model.CurrentGroup.Title sections">
                    <span class="ts-auth-menu-heading">@Model.CurrentGroup.Title</span>
                    @foreach (var authSection in Model.CurrentGroupSections)
                    {
                        <a class="ts-menu-item" href="@authSection.Href" aria-current="@(Model.Section == authSection.Key ? "page" : null)">
                            <span class="ts-menu-item-icon">@Icon(authSection.Icon, 16)</span>
                            <span class="ts-menu-label">@authSection.Title</span>
                        </a>
                    }
                </div>
            </details>
        }
        @if (Model.Current.Columns.Length > 0)
        {
            <form class="ts-filters ts-auth-filters" method="get" action="@Model.Current.Href" role="search" aria-label="Search @Model.Current.Title">
                <label class="ts-auth-search ts-filter-field">
                    <span class="ts-sr-only">Search @Model.Current.Title</span>
                    @Icons.Search(15)
                    <input class="ts-input" type="search" name="q" value="@Model.Search" placeholder="Search @Model.Current.Title.ToLowerInvariant()" aria-label="Search @Model.Current.Title" />
                </label>
                @if (Model.Search.Length > 0)
                {
                    <a class="ts-btn ts-btn-ghost ts-btn-sm" href="@Model.Current.Href">Clear</a>
                }
            </form>
        }
    </div>

    @if (Model.Section == "overview")
    {
        <section class="ts-section ts-auth-overview-section" aria-labelledby="auth-session-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="auth-session-title">Current session access</h2>
                    <p class="ts-meta">Claims returned by auth for the current Dashboard session.</p>
                </div>
                <button type="button" class="ts-btn ts-btn-outline" aria-haspopup="dialog" data-on:click="document.getElementById('auth-session-dialog').showModal()">@Icons.ShieldCheck(16) View session access</button>
            </div>
            <dialog class="ts-dialog" id="auth-session-dialog">
                <div class="ts-dialog-content">
                    <div class="ts-dialog-header">
                        <h3 class="ts-dialog-title">Current session access</h3>
                        <p class="ts-dialog-description">Claims returned by auth</p>
                    </div>
                    <div class="ts-stack-lg">
                        <div class="ts-stack-sm">
                            <h4 class="ts-access-claim-title">@Icons.ShieldCheck(15) Roles</h4>
                            @if (Model.Roles.Count == 0)
                            {
                                @EmptyState("No roles returned", "No claim values were returned.")
                            }
                            else
                            {
                                <div class="ts-access-claim-values">
                                    @foreach (var role in Model.Roles)
                                    {
                                        <span class="ts-badge ts-badge-neutral">@role</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="ts-stack-sm">
                            <h4 class="ts-access-claim-title">@Icons.ShieldCheck(15) Permissions</h4>
                            @if (Model.Permissions.Count == 0)
                            {
                                @EmptyState("No permissions returned", "No claim values were returned.")
                            }
                            else
                            {
                                <div class="ts-access-claim-values">
                                    @foreach (var permission in Model.Permissions)
                                    {
                                        <span class="ts-badge ts-badge-neutral">@permission</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="ts-access-status-success">@Icons.ShieldCheck(16)<span>Access is enforced by API authorization, not Dashboard UI state.</span></div>
                    </div>
                    <form class="ts-dialog-footer" method="dialog"><button class="ts-btn ts-btn-secondary" type="submit">Close</button></form>
                </div>
            </dialog>
        </section>
        @Overview(Model)
    }
    else if (Model.Section == "settings")
    {
        @Settings(Model)
    }
    else if (Model.Section == "quickstart")
    {
        @Quickstart(Model)
    }
    else if (Model.Section == "billing")
    {
        @Billing(Model)
    }
    else
    {
        @ResourcePage(Model)
    }
</div>
@ShellHtml.Bottom(shell)

@functions {
    private static IHtmlContent Icon(string name, int size) =>
        (typeof(Icons).GetMethod(name)?.Invoke(null, [size]) as IHtmlContent) ?? Icons.Circle(size);

    private static string E(string value) => System.Net.WebUtility.HtmlEncode(value);

    private static string StatusTone(string status) => status.ToLowerInvariant() switch
    {
        "active" or "success" => "ts-badge-success",
        "pending" or "invited" or "expiring" => "ts-badge-warning",
        "failed" or "blocked" or "revoked" or "error" => "ts-badge-danger",
        _ => "ts-badge-neutral",
    };

    public static IHtmlContent Overview(AuthenticationPageModel model)
    {
        var resources = model.AllResources;
        return new HtmlString($"""
            <section class="ts-section ts-auth-overview-section" aria-labelledby="auth-overview-title">
                <div class="ts-section-head">
                    <div><h2 class="ts-panel-title" id="auth-overview-title">Identity workspace</h2><p class="ts-meta">Resources available through the ts-auth management API.</p></div>
                </div>
                <dl class="ts-kpis ts-auth-overview-kpis" aria-label="Identity resource counts">
                    {Stat("Users", resources.Count(r => r.Section == "users"), "/auth/users", "Profiles and access")}
                    {Stat("Organizations", resources.Count(r => r.Section == "organizations"), "/auth/organizations", "Customer groups")}
                    {Stat("Connections", resources.Count(r => r.Section == "connections"), "/auth/connections", "OIDC and SAML")}
                    {Stat("Webhooks", resources.Count(r => r.Section == "webhooks"), "/auth/webhooks", "Signed delivery")}
                </dl>
            </section>
            <section class="ts-section ts-auth-overview-section" aria-labelledby="auth-checklist-title">
                <div class="ts-section-head"><div><h2 class="ts-panel-title" id="auth-checklist-title">Build your identity stack</h2><p class="ts-meta">Every ts-auth capability is available as a typed management API.</p></div></div>
                <div class="ts-auth-checklist">
                    {Check("Connect your application", "Create a scoped management key and copy the instance issuer.", "/auth/keys", true)}
                    {Check("Add your first user", "Create a test identity before wiring your sign-in screen.", "/auth/users", resources.Any(r => r.Section == "users"))}
                    {Check("Register a client", "Use PKCE for browsers and public clients.", "/auth/clients", resources.Any(r => r.Section == "clients"))}
                    {Check("Configure delivery", "Send signed user and session events to your backend.", "/auth/webhooks", resources.Any(r => r.Section == "webhooks"))}
                </div>
            </section>
            """);
    }

    public static IHtmlContent ResourcePage(AuthenticationPageModel model)
    {
        var section = model.Current;
        var rows = string.Join("", model.Resources.Select(resource => Row(section, resource)));
        var create = section.CanCreate ? $"<button class=\"ts-btn ts-btn-primary\" type=\"button\" data-open-dialog=\"#auth-create-dialog\">{Icons.Plus(15)} Add {E(section.Singular)}</button>" : "";
        var secret = model.Secret is { Length: > 0 } value
            ? $"<div class=\"ts-alert ts-alert-warning ts-auth-secret\" role=\"status\">{Icons.KeyRound(16)}<span><strong>Copy this management key now.</strong><code>{E(value)}</code><small>It will not be shown again.</small></span><button class=\"ts-btn ts-btn-secondary ts-btn-sm\" type=\"button\" data-copy=\"{E(value)}\">Copy key</button></div>"
            : "";
        var detail = model.Selected is { } selected ? Detail(section, model, selected) : "";
        var body = model.Total == 0
            ? $"<div class=\"ts-empty\"><span class=\"ts-empty-icon\">{Icons.SearchX(18)}</span><span class=\"ts-empty-title\">No {E(section.Title.ToLowerInvariant())} {(model.Search.Length > 0 ? "match" : "yet")}</span><span class=\"ts-empty-meta\">{(model.Search.Length > 0 ? "Try a different search." : $"Use the button above to create your first {E(section.Singular)}.")}</span>{(model.Search.Length > 0 ? $"<a class=\"ts-btn ts-btn-secondary\" href=\"{section.Href}\">Clear search</a>" : "")}</div>"
            : $"<div class=\"ts-table-wrap ts-table-flush ts-auth-table-wrap\"><table class=\"ts-table\"><thead><tr><th>Name</th>{string.Join("", section.Columns.Select(column => $"<th>{E(column.Replace('_', ' '))}</th>"))}<th>Status</th><th></th></tr></thead><tbody>{rows}</tbody></table></div>";
        var pager = model.Total == 0 ? "" : $"<nav class=\"ts-pager\" aria-label=\"{E(section.Title)} pages\"><span class=\"ts-meta\">Showing {model.First}–{model.Last} of {model.Total}</span>{(model.PageCount > 1 ? $"<div class=\"ts-row ts-row-tight\">{(model.Page > 1 ? $"<a class=\"ts-btn ts-btn-ghost\" href=\"{model.Href(model.Page - 1)}\" rel=\"prev\">Previous</a>" : "")}{string.Concat(Enumerable.Range(1, model.PageCount).Select(page => $"<a class=\"ts-btn ts-btn-ghost ts-pager-page\" href=\"{model.Href(page)}\" aria-current=\"{(page == model.Page ? "page" : "false")}\">{page}</a>"))}{(model.Page < model.PageCount ? $"<a class=\"ts-btn ts-btn-ghost\" href=\"{model.Href(model.Page + 1)}\" rel=\"next\">Next</a>" : "")}</div>" : "")}</nav>";
        return new HtmlString($"<section class=\"ts-section ts-auth-resource-section\" aria-labelledby=\"auth-resource-title\"><div class=\"ts-section-head\"><div><h2 class=\"ts-panel-title\" id=\"auth-resource-title\">{E(section.Title)}</h2><p class=\"ts-meta\">{E(section.Description)}</p></div>{create}</div>{secret}{body}{pager}{detail}</section>{CreateDialog(section, model.CreateRequested, model.FormValues)}");
    }

    public static IHtmlContent Billing(AuthenticationPageModel model) => new HtmlString($"""
        <section class="ts-section ts-auth-special-section" aria-labelledby="auth-plan-title">
            <div class="ts-section-head"><div><h2 class="ts-panel-title" id="auth-plan-title">Identity plan</h2><p class="ts-meta">Scale your identity platform as your product grows.</p></div></div>
            <div class="ts-auth-billing-content"><span class="ts-badge ts-badge-success">Current plan</span><strong>{E(model.Instance.Plan)}</strong><p>Demo mode includes the complete management surface. Production billing connects to ts-auth's Stripe-backed plan and quota APIs.</p><a class="ts-btn ts-btn-primary" href="/settings?tab=billing">Review project billing {Icons.ArrowRight(14)}</a></div>
        </section>
        <section class="ts-section ts-auth-special-section" aria-labelledby="auth-signals-title">
            <div class="ts-section-head"><div><h2 class="ts-panel-title" id="auth-signals-title">Usage signals</h2><p class="ts-meta">Keep an eye on the resources that affect your plan.</p></div></div>
            <dl class="ts-settings-list"><div><dt>Users</dt><dd>{model.Count("users")}</dd></div><div><dt>Organizations</dt><dd>{model.Count("organizations")}</dd></div><div><dt>OAuth clients</dt><dd>{model.Count("clients")}</dd></div><div><dt>Webhook endpoints</dt><dd>{model.Count("webhooks")}</dd></div></dl>
        </section>
        """);

    public static IHtmlContent Settings(AuthenticationPageModel model) => new HtmlString($"""
        <section class="ts-section ts-auth-special-section" aria-labelledby="auth-branding-title">
            <div class="ts-section-head"><div><h2 class="ts-panel-title" id="auth-branding-title">Hosted UI branding</h2><p class="ts-meta">These values appear on sign-in, account and consent pages.</p></div></div>
            <form method="post" action="/api/v1/auth-management/instance" class="ts-auth-settings-form"><div class="ts-field"><label class="ts-label" for="auth-name">Instance name</label><input class="ts-input" id="auth-name" name="name" value="{E(model.InstanceName)}" required /></div><div class="ts-field"><label class="ts-label" for="auth-logo">Logo URL</label><input class="ts-input" id="auth-logo" name="logo_url" type="url" value="{E(model.Instance.LogoUrl)}" placeholder="https://assets.example.com/logo.svg" /><span class="ts-field-help">Absolute HTTPS URL. SVG and PNG are supported.</span></div><div class="ts-field"><label class="ts-label" for="auth-color">Theme color</label><input class="ts-input ts-input-color" id="auth-color" name="theme_color" value="{E(model.Instance.ThemeColor)}" /><span class="ts-field-help">A six-digit hex color such as #3B82F6.</span></div><div class="ts-auth-setting-actions"><span class="ts-meta">Changes apply to new hosted pages immediately.</span><button class="ts-btn ts-btn-primary" type="submit">{Icons.Save(15)} Save branding</button></div></form>
        </section>
        <section class="ts-section ts-auth-special-section" aria-labelledby="auth-contract-title">
            <div class="ts-section-head"><div><h2 class="ts-panel-title" id="auth-contract-title">API contract</h2><p class="ts-meta">The management API is scoped to this project's instance.</p></div></div>
            <div class="ts-auth-contract-list"><div><span>{Icons.LockKeyhole(17)}</span><span><strong>Management keys</strong><small>Scoped bearer keys are shown once and hashed at rest.</small></span><a class="ts-inline-link" href="/auth/keys">Manage</a></div><div><span>{Icons.ShieldCheck(17)}</span><span><strong>Issuer</strong><small>{E(model.Issuer)}</small></span><button class="ts-btn ts-btn-ghost ts-btn-sm" type="button" data-copy="{E(model.Issuer)}">Copy</button></div><div><span>{Icons.Webhook(17)}</span><span><strong>Signed events</strong><small>HMAC signatures with retry and dead-letter tracking.</small></span><a class="ts-inline-link" href="/auth/webhooks">Configure</a></div></div>
        </section>
        """);

    public static IHtmlContent Quickstart(AuthenticationPageModel model)
    {
        var code = "curl -X GET \\\n+  -H 'Authorization: Bearer sk_live_…' \\\n+  https://auth.terrascale.tech/v1/" + model.InstanceSlug + "/users";
        return new HtmlString($"""
            <section class="ts-section ts-auth-special-section" aria-labelledby="auth-quickstart-title"><div class="ts-section-head"><div><h2 class="ts-panel-title" id="auth-quickstart-title">Connect in minutes</h2><p class="ts-meta">The same API contract works from every official SDK.</p></div></div><ol class="ts-auth-steps"><li><span>1</span><div><strong>Create a management key</strong><small>Give it only the route families your deployment needs.</small><a href="/auth/keys">Create a key {Icons.ArrowRight(14)}</a></div></li><li><span>2</span><div><strong>Point your SDK at the issuer</strong><small>Use OIDC discovery instead of hard-coding token endpoints.</small><code>{E(model.Issuer)}</code></div></li><li><span>3</span><div><strong>Verify the first user</strong><small>Use the hosted flow or your own UI with the OAuth 2.1 endpoints.</small><a href="/auth/users">Create a test user {Icons.ArrowRight(14)}</a></div></li></ol></section>
            <section class="ts-section ts-auth-special-section" aria-labelledby="auth-api-title"><div class="ts-section-head"><div><h2 class="ts-panel-title" id="auth-api-title">Management API</h2><p class="ts-meta">Every write is audited and every secret is returned once.</p></div></div><pre class="ts-code-block"><code>{E(code)}</code></pre><div class="ts-auth-sdk-links"><a href="/auth/keys">API keys {Icons.ArrowRight(14)}</a><a href="/auth/audit">Audit events {Icons.ArrowRight(14)}</a></div></section>
            <section class="ts-section ts-auth-special-section" aria-labelledby="auth-endpoint-title"><div class="ts-section-head"><div><h2 class="ts-panel-title" id="auth-endpoint-title">Instance endpoint</h2><p class="ts-meta">Use this issuer for OIDC discovery, JWKS and hosted sign-in.</p></div><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-copy="{E(model.Issuer)}">{Icons.Copy(14)} Copy issuer</button></div><div class="ts-auth-code-block"><code>{E(model.Issuer)}</code><span class="ts-auth-code-note">/.well-known/openid-configuration</span></div></section>
            """);
    }

    private static string Stat(string label, int value, string href, string detail) => $"<div><dt>{Icons.Users(14)} <a class=\"ts-auth-stat-link\" href=\"{href}\">{E(label)}</a></dt><dd><span class=\"ts-kpi-value\">{value}</span></dd><small class=\"ts-meta\">{E(detail)}</small></div>";

    private static string Check(string title, string detail, string href, bool done) => $"<a class=\"ts-auth-check {(done ? "is-done" : "")}\" href=\"{href}\"><span>{(done ? Icons.Check(14).Value : "4")}</span><span><strong>{E(title)}</strong><small>{E(detail)}</small></span>{Icons.ChevronRight(15)}</a>";

    private static string Row(AuthSection section, AuthResource resource)
    {
        var cells = string.Join("", section.Columns.Select(column => $"<td class=\"ts-meta ts-break-all\">{E(resource.Value(column))}</td>"));
        var delete = $"<form method=\"post\" action=\"/api/v1/auth-management/{section.Key}/{resource.Id}/delete\"><button class=\"ts-btn ts-btn-ghost ts-btn-sm\" type=\"submit\" data-confirm=\"Delete this {E(section.Singular)}?\">{Icons.Trash2(15)}<span class=\"ts-sr-only\">Delete {E(resource.Name)}</span></button></form>";
        var action = section.Key switch
        {
            "users" => $"<form method=\"post\" action=\"/api/v1/auth-management/users/{resource.Id}/actions/block\"><button class=\"ts-btn ts-btn-ghost ts-btn-sm\" type=\"submit\">{(resource.Status == "Blocked" ? "Unblock" : "Block")}</button></form>",
            "webhooks" => $"<form method=\"post\" action=\"/api/v1/auth-management/webhooks/{resource.Id}/actions/test\"><button class=\"ts-btn ts-btn-ghost ts-btn-sm\" type=\"submit\">Send test</button></form>",
            "deliveries" when resource.Status == "Failed" => $"<form method=\"post\" action=\"/api/v1/auth-management/deliveries/{resource.Id}/actions/replay\"><button class=\"ts-btn ts-btn-ghost ts-btn-sm\" type=\"submit\">Replay</button></form>",
            "directories" => $"<form method=\"post\" action=\"/api/v1/auth-management/directories/{resource.Id}/actions/rotate\"><button class=\"ts-btn ts-btn-ghost ts-btn-sm\" type=\"submit\">Rotate token</button></form>",
            _ => "",
        };
        var removal = section.CanDelete ? delete : "";
        return $"<tr><td><a class=\"ts-auth-resource-link ts-table-strong\" href=\"{section.Href}?id={Uri.EscapeDataString(resource.Id)}\">{E(resource.Name)}</a><div class=\"ts-meta ts-mono\">{E(resource.Id)}</div></td>{cells}<td><span class=\"ts-badge {StatusTone(resource.Status)}\">{E(resource.Status)}</span></td><td><div class=\"ts-auth-row-actions\">{action}{removal}</div></td></tr>";
    }

    private static string Detail(AuthSection section, AuthenticationPageModel model, AuthResource resource)
    {
        var close = section.Href + (model.Search.Length > 0 ? "?q=" + Uri.EscapeDataString(model.Search) : "");
        var fields = string.Join("", section.Fields.Select(field => $"<div><span>{E(field.Label)}</span><code>{E(resource.Value(field.Key).Length > 0 ? resource.Value(field.Key) : "Not reported")}</code></div>"));
        return $"<section class=\"ts-auth-detail\" aria-labelledby=\"auth-detail-title\"><div><span class=\"ts-eyebrow\">{Icons.Fingerprint(14)} RESOURCE DETAIL</span><h3 id=\"auth-detail-title\">{E(resource.Name)}</h3><span class=\"ts-meta ts-mono\">{E(resource.Id)}</span></div><a class=\"ts-btn ts-btn-ghost ts-btn-sm\" href=\"{close}\">Close</a><div class=\"ts-auth-detail-grid\">{fields}</div></section>";
    }

    private static string CreateDialog(AuthSection section, bool autoOpen = false, IReadOnlyDictionary<string, string>? values = null)
    {
        if (!section.CanCreate) return "";
        var fields = string.Join("", section.Fields.Select(field => Field(field, values)));
        return $"<dialog class=\"ts-dialog\" id=\"auth-create-dialog\"{(autoOpen ? " data-autoopen" : "")}><div class=\"ts-dialog-content\"><div class=\"ts-dialog-header\"><h3 class=\"ts-dialog-title\">Add {E(section.Singular)}</h3><p class=\"ts-dialog-description\">This creates a demo resource with the same validation rules as the ts-auth management API.</p></div><form method=\"post\" action=\"/api/v1/auth-management/{section.Key}\" class=\"ts-form\">{fields}<div class=\"ts-dialog-footer\"><button class=\"ts-btn ts-btn-secondary\" type=\"button\" data-close-dialog>Cancel</button><button class=\"ts-btn ts-btn-primary\" type=\"submit\">Create {E(section.Singular)}</button></div></form></div></dialog>";
    }

    private static string Field(AuthField field, IReadOnlyDictionary<string, string>? values)
    {
        var label = $"<label class=\"ts-label\" for=\"auth-field-{field.Key}\">{E(field.Label)}{(field.Required ? "" : " <span class=\"ts-meta\">(optional)</span>")}</label>";
        var value = E(values?.GetValueOrDefault(field.Key) ?? field.Default);
        var input = field.Type switch
        {
            "textarea" or "json" or "claims" or "uris" or "origins" => $"<textarea class=\"ts-textarea\" id=\"auth-field-{field.Key}\" name=\"{field.Key}\" {(field.Required ? "required" : "")}>{value}</textarea>",
            "select" => $"<select class=\"ts-select\" id=\"auth-field-{field.Key}\" name=\"{field.Key}\">{string.Join("", (field.Options ?? []).Select(option => $"<option value=\"{E(option)}\" {(option == field.Default ? "selected" : "")}>{E(option)}</option>"))}</select>",
            _ => $"<input class=\"ts-input\" id=\"auth-field-{field.Key}\" name=\"{field.Key}\" type=\"{(field.Type is "slug" or "template" ? "text" : field.Type)}\" value=\"{value}\" {(field.Required ? "required" : "")} />",
        };
        return $"<div class=\"ts-field\">{label}{input}<span class=\"ts-field-help\">{E(field.Hint)}</span></div>";
    }

    private static HtmlString EmptyState(string title, string description) => new($"<div class=\"ts-empty\"><span class=\"ts-empty-icon\">{Icons.SearchX(16).Value}</span><span class=\"ts-empty-title\">{E(title)}</span><span class=\"ts-empty-meta\">{E(description)}</span></div>");
}
