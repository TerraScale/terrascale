@inherits RazorSlice<TerraScale.Dashboard.Features.Onboarding.OnboardingPage>
@implements IUsesLayout<TerraScale.Dashboard.UI.Slices.Document, DocumentModel>
@inject AssetUrls Assets
<main class="ts-login">
    <section class="ts-login-hero" aria-hidden="true">
        @(await RenderPartialAsync<TerraScale.Dashboard.UI.Slices.RegionMap>())
        <ul class="ts-login-regions"><li><span class="ts-dot"></span>San Francisco</li><li><span class="ts-dot"></span>São Paulo</li></ul>
    </section>
    <div class="ts-login-column">
    <div class="@(Model.Step == "payment-method" ? "ts-onboarding ts-onboarding-wide" : "ts-onboarding")">
    <header class="ts-onboarding-header"><img class="ts-brand-logo" src="@Assets.Url("brand/logo-terrascale-blue.svg")" alt="TerraScale" decoding="async" /><h1 class="ts-sr-only">Activate your TerraScale account</h1></header>
    <div class="ts-onboarding-progress">
        <div class="ts-row-between ts-meta"><span class="ts-eyebrow">Step @Model.CurrentStep of 3</span><span>@Model.Progress%</span></div>
        <div class="ts-progress" role="progressbar" aria-label="Account setup progress" aria-valuenow="@Model.Progress" aria-valuemin="0" aria-valuemax="100"><div class="ts-progress-bar" data-progress="@Model.Progress"></div></div>
        <ol class="ts-onboarding-steps" aria-label="Onboarding progress">
            @foreach (var step in Model.Steps)
            {
                <li class="@("ts-onboarding-step" + (step.Current ? " ts-onboarding-step-current" : "") + (step.Completed ? " ts-onboarding-step-complete" : ""))" aria-current="@(step.Current ? "step" : null)"><span class="ts-onboarding-step-icon" aria-hidden="true">@(step.Completed ? "✓" : step.Number)</span><span>@step.Label</span><span class="ts-sr-only">@step.State</span></li>
            }
        </ol>
    </div>
    <div class="ts-onboarding-card">
        @if (Model.Step == "payment-method" && Model.PaymentCanceled)
        {
            <div class="ts-alert ts-alert-warning" role="status"><strong class="ts-alert-title">Payment setup canceled</strong><p class="ts-alert-body">Your earlier account progress is still saved. No payment method was changed; you can continue on the Free plan or try checkout again.</p></div>
        }
        @if (Model.Error.Length != 0 && Model.ErrorField.Length == 0)
        { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
        @if (Model.Registration)
        {
            <div class="ts-onboarding-heading"><h2 class="ts-section-title" id="create-account-title">Create your account</h2><p class="ts-meta">Your Personal workspace is ready as soon as your account is created.</p></div>
            <form class="ts-form" method="post" action="/onboarding" data-submit-once aria-labelledby="create-account-title">
                <input type="hidden" name="_csrf" value="@Model.CsrfToken" />
                @if (Model.Plan.Length != 0) { <input type="hidden" name="plan" value="@Model.Plan" /> }
                @if (Model.ReturnTo.Length != 0) { <input type="hidden" name="returnTo" value="@Model.ReturnTo" /> }
                <div class="ts-field"><label class="ts-label" for="displayName">Full name</label><input class="ts-input" id="displayName" name="displayName" value="@Model.DisplayName" autocomplete="name" maxlength="128" required aria-invalid="@Invalid("displayName")" aria-describedby="@ErrorId("displayName")" />
                    @if (Model.FieldError("displayName").Length != 0) { <p class="ts-field-error" id="displayName-error">@Model.Error</p> }
                </div>
                <div class="ts-field"><label class="ts-label" for="email">Email</label><input class="ts-input" id="email" name="email" type="email" value="@Model.Email" autocomplete="email" placeholder="name@@company.com" required aria-invalid="@Invalid("email")" aria-describedby="@ErrorId("email")" />
                    @if (Model.FieldError("email").Length != 0) { <p class="ts-field-error" id="email-error">@Model.Error</p> }
                </div>
                <div class="ts-form-grid">
                    <div class="ts-field"><label class="ts-label" for="password">Password</label>@(await RenderPartialAsync<TerraScale.Dashboard.UI.Slices.PasswordInput, PasswordField>(new("password", "new-password", Model.FieldError("password"), MinLength: 12, HintId: "password-hint")))<p class="ts-field-hint" id="password-hint">Use at least 12 characters.</p>
                        @if (Model.FieldError("password").Length != 0) { <p class="ts-field-error" id="password-error">@Model.Error</p> }
                    </div>
                    <div class="ts-field"><label class="ts-label" for="confirmPassword">Confirm password</label>@(await RenderPartialAsync<TerraScale.Dashboard.UI.Slices.PasswordInput, PasswordField>(new("confirmPassword", "new-password", Model.FieldError("confirmPassword"))))
                        @if (Model.FieldError("confirmPassword").Length != 0) { <p class="ts-field-error" id="confirmPassword-error">@Model.Error</p> }
                    </div>
                </div>
                <div class="ts-field"><label class="ts-check"><input type="checkbox" id="terms" name="terms" value="true" checked="@(Model.AcceptedTerms ? "checked" : null)" required aria-invalid="@Invalid("terms")" aria-describedby="@ErrorId("terms")" /><span>I accept the Terms of Service</span></label>
                    @if (Model.FieldError("terms").Length != 0) { <p class="ts-field-error" id="terms-error">@Model.Error</p> }
                </div>
                <div class="ts-onboarding-footer"><p class="ts-meta">Already have an account? <a class="ts-link" href="@Model.SignInUrl">Sign in</a></p><button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Create account <span aria-hidden="true">→</span></button></div>
            </form>
        }
        else if (Model.Step == "account-information")
        {
            <div class="ts-onboarding-heading"><h2 class="ts-section-title" id="account-information-title">Review your account information</h2><p class="ts-meta">Signed in as @Model.Email</p></div>
            <form class="ts-form" method="post" action="/onboarding/step" data-submit-once aria-labelledby="account-information-title">
                <input type="hidden" name="_csrf" value="@Model.CsrfToken" /><input type="hidden" name="step" value="account-information" />
                <div class="ts-field"><label class="ts-label" for="displayName">Full name</label><input class="ts-input" id="displayName" name="displayName" value="@Model.DisplayName" maxlength="128" autocomplete="name" required /></div>
                <div class="ts-field"><label class="ts-label" for="accountEmail">Email</label><input class="ts-input" id="accountEmail" type="email" value="@Model.Email" readonly aria-describedby="accountEmail-hint" /><p class="ts-field-hint" id="accountEmail-hint">Your sign-in email cannot be changed during account setup.</p></div>
                <div class="ts-onboarding-footer"><span></span><button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Save and continue <span aria-hidden="true">→</span></button></div>
            </form>
        }
        else if (Model.Step == "payment-method")
        {
            <form class="ts-form" method="post" action="/onboarding/step" data-submit-once aria-labelledby="payment-method-title">
                <input type="hidden" name="_csrf" value="@Model.CsrfToken" /><input type="hidden" name="step" value="payment-method" /><input type="hidden" name="return" value="/onboarding" />
                <div class="ts-row-between ts-onboarding-payment-head">
                    <div class="ts-onboarding-heading"><h2 class="ts-section-title" id="payment-method-title">Choose your plan</h2><p class="ts-meta">Payment setup is optional for your Personal workspace. Stripe collects your card and confirms the subscription.</p></div>
                    <fieldset class="ts-segmented" aria-label="Billing interval"><legend class="ts-sr-only">Billing interval</legend><label><input type="radio" name="interval" value="monthly" checked required /><span>Monthly</span></label><label><input type="radio" name="interval" value="annual" /><span>Annual</span><span class="ts-badge ts-badge-blue">2 months free</span></label></fieldset>
                </div>
                <fieldset class="ts-onboarding-plans"><legend class="ts-sr-only">Select a plan</legend>
                    @foreach (var plan in Model.Plans ?? [])
                    {
                        <label class="ts-onboarding-plan"><input class="ts-onboarding-plan-radio" type="radio" name="plan" value="@plan.Key" checked="@(plan.Key == Model.Plan ? "checked" : null)" required /><span class="ts-row-between"><span class="ts-onboarding-plan-name">@plan.Name</span><span class="ts-onboarding-plan-check" aria-hidden="true">✓</span></span><span class="ts-onboarding-plan-price" data-interval="monthly">@plan.MonthlyPrice<span class="ts-meta"> / month</span></span><span class="ts-onboarding-plan-price" data-interval="annual">@plan.AnnualPrice<span class="ts-meta"> / year</span></span><span class="ts-meta">@plan.DatabaseAllowance · @plan.StorageAllowance · @plan.MemberAllowance</span><span class="ts-meta">@plan.ReadsAllowance · @plan.WritesAllowance</span><span class="ts-badge ts-badge-blue">@plan.TrialDays-day trial</span></label>
                    }
                </fieldset>
                <p class="ts-meta">Continue to Stripe Checkout or stay on Free without payment.</p>
                <div class="ts-onboarding-footer"><button class="ts-btn ts-btn-secondary ts-btn-lg" type="submit" name="bypass" value="1" formnovalidate>Continue on Free</button><button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Continue to checkout <span aria-hidden="true">→</span></button></div>
            </form>
        }
        else
        {
            <div class="ts-onboarding-heading"><h2 class="ts-section-title" id="project-title">Create your first project</h2><p class="ts-meta">Choose where your project's data will live.</p></div>
            <form class="ts-form" method="post" action="/onboarding/step" data-submit-once aria-labelledby="project-title">
                <input type="hidden" name="_csrf" value="@Model.CsrfToken" /><input type="hidden" name="step" value="project" />
                <div class="ts-field"><label class="ts-label" for="projectName">Project name</label><input class="ts-input" id="projectName" name="name" maxlength="100" value="Personal" autocomplete="organization" required /></div>
                <div class="ts-field"><label class="ts-label" for="region">Primary region</label>
                    @(await RenderPartialAsync<TerraScale.Dashboard.UI.Slices.RegionPicker, RegionMapField>(new("region", "GRU", Available: ["GRU", "SFO"])))
                    <select class="ts-select" id="region" name="region" required aria-describedby="region-hint"><option value="GRU" selected>GRU · São Paulo</option><option value="SFO">SFO · San Francisco</option></select><p class="ts-field-hint" id="region-hint">You can add regions to your project later.</p>
                </div>
                <div class="ts-onboarding-footer"><span></span><button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Create project and open Dashboard <span aria-hidden="true">→</span></button></div>
            </form>
        }
    </div>
    </div>
    </div>
</main>
@functions {
    public DocumentModel LayoutModel => Model.Document;
    private string? Invalid(string field) => Model.FieldError(field).Length == 0 ? null : "true";
    private string? ErrorId(string field) => Model.FieldError(field).Length == 0 ? null : field + "-error";
}
