@inherits RazorSlice<OnboardingOrganizationCardView>
<div class="ts-onboarding-card">
    <header class="ts-onboarding-step-header">
        <h2 class="ts-onboarding-step-title">@Model.Title</h2>
        <p class="ts-onboarding-step-subtitle">@Model.Subtitle</p>
        <div class="ts-onboarding-step-actions">
            <span class="ts-onboarding-step-icon" aria-hidden="true">@Icons.Building2(20)</span>
        </div>
    </header>
    <div class="ts-onboarding-content">
        @if (Model.StepDone)
        {
            <div class="ts-alert ts-alert-success" role="status">
                <span class="ts-onboarding-alert-icon" aria-hidden="true">@Icons.CircleCheck(19)</span>
                <div class="ts-onboarding-alert-stack">
                    <span class="ts-alert-title">Organization created</span>
                    <span class="ts-alert-body">Your organization is ready for billing and projects.</span>
                </div>
            </div>
            <div class="ts-onboarding-form-footer">
                <a class="ts-btn ts-btn-primary ts-btn-lg" href="@Model.ContinueHref">Continue</a>
            </div>
        }
        else
        {
            <form class="ts-onboarding-field-list" method="post" action="@Model.Action">
                <input type="hidden" name="step" value="@Model.StepValue" />
                <div class="ts-field">
                    <label class="ts-label" for="organizationName">Organization name</label>
                    <input class="ts-input" id="organizationName" name="name" placeholder="Acme Labs" required />
                </div>
                <div class="ts-onboarding-form-footer">
                    <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Create organization</button>
                </div>
            </form>
        }
    </div>
</div>
