@inherits RazorSlice<OnboardingProgressView>
@{
    var stateLabels = new Dictionary<string, string>
    {
        ["pending"] = "Pending",
        ["current"] = "Current",
        ["completed"] = "Completed",
        ["blocked"] = "Blocked",
        ["not-started"] = "Not started",
        ["in-progress"] = "In progress",
        ["awaiting-validation"] = "Awaiting validation",
        ["unavailable"] = "Unavailable",
        ["expired"] = "Expired",
        ["ready-for-project"] = "Ready for project",
    };
}
@* Each step's top rule is a progress segment, so the list doubles as the bar;
   the meta line carries the progressbar semantics. *@
<div class="ts-onboarding-progress" role="progressbar" aria-label="@Model.BarAriaLabel" aria-valuenow="@Model.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
    <span>@Model.Label @Model.CurrentStep OF @Model.TotalSteps</span>
    <span class="ts-tabular">@Model.ProgressPercent%</span>
</div>
<ol class="ts-onboarding-steps" aria-label="@Model.AriaLabel">
    @foreach (var step in Model.Steps)
    {
        var current = step.Key == Model.ActiveStep;
        var complete = step.State == "completed";
        var blocked = step.State == "blocked";
        var classes = "ts-onboarding-step"
            + (current ? " ts-onboarding-step-current" : "")
            + (blocked ? " ts-onboarding-step-blocked" : "")
            + (complete ? " ts-onboarding-step-complete" : "");
        <li class="@classes" aria-current="@(current ? "step" : null)">
            @if (complete)
            {
                @Icons.CircleCheck(14)
            }
            else
            {
                @(typeof(Icons).GetMethod(step.Icon)?.Invoke(null, [14]) as Microsoft.AspNetCore.Html.HtmlString ?? Icons.Circle(14))
            }
            <span>@step.Label</span>
            <span class="ts-sr-only">@(stateLabels.TryGetValue(step.State, out var label) ? label : step.State)</span>
        </li>
    }
</ol>
