@inherits RazorSlice<OnboardingProjectCardView>
<div class="ts-onboarding-card">
    <header class="ts-onboarding-step-header">
        <h2 class="ts-onboarding-step-title">Create your first project</h2>
        <p class="ts-onboarding-step-subtitle">Products inherit these primary regions.</p>
        <div class="ts-onboarding-step-actions">
            <span class="ts-onboarding-step-icon" aria-hidden="true">@Icons.Database(20)</span>
        </div>
    </header>
    <form class="ts-onboarding-content ts-onboarding-content-wide" method="post" action="@Model.Action">
        <input type="hidden" name="step" value="@Model.StepValue" />
        <div class="ts-field">
            <label class="ts-label" for="projectName">Project name</label>
            <input class="ts-input" id="projectName" name="name" placeholder="Production" maxlength="128" required />
        </div>
        <div class="ts-field">
            <span class="ts-label" id="regionLabel">Primary regions</span>
            <div class="ts-onboarding-region-map" role="radiogroup" aria-labelledby="regionLabel">
                <img class="ts-onboarding-region-dots" src="@AssetUrls.Url("/brand/region-map.svg")" alt="" decoding="async" />
                @foreach (var region in Model.Regions)
                {
                    var left = (region.X / RegionMap.Width * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                    var top = (region.Y / RegionMap.Height * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                    // Pins in the northern third flip the hover label below the
                    // marker so the frame's overflow clip cannot cut it off at
                    // the top edge; pins near the side edges anchor the label to
                    // that edge instead of centring it past the clip.
                    var labelBelow = region.Y < RegionMap.Height / 3;
                    var edge = region.X / RegionMap.Width;
                    var classes = "ts-onboarding-region-pin"
                        + (region.Live ? "" : " ts-onboarding-region-pin-disabled")
                        + (labelBelow ? " ts-onboarding-region-pin-label-below" : "")
                        + (edge < 0.25 ? " ts-onboarding-region-pin-label-start" : "")
                        + (edge > 0.75 ? " ts-onboarding-region-pin-label-end" : "");
                    <label class="@classes" style="left:@(left)%;top:@(top)%">
                        <input class="ts-onboarding-region-input" type="radio" name="region" value="@region.Code" aria-label="@region.Name (@region.Code.ToUpperInvariant()) — @(region.Live ? "Available" : "Unavailable"), @region.LatencyMs ms" @(region.Code == Model.DefaultRegion ? "checked" : null) @(region.Live ? null : "disabled") />
                        <span class="ts-onboarding-region-dot" aria-hidden="true"></span>
                        <span class="ts-onboarding-region-label" aria-hidden="true">
                            <img class="ts-onboarding-region-flag" src="/brand/flags/@(region.Country.ToLowerInvariant()).svg" alt="" decoding="async" />
                            <span class="ts-onboarding-region-label-name">@region.Name</span>
                            <span class="ts-onboarding-region-label-ping">@region.LatencyMs ms</span>
                        </span>
                    </label>
                }
            </div>
        </div>
        <div class="ts-onboarding-form-footer">
            <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Create project and open Dashboard</button>
        </div>
    </form>
</div>
