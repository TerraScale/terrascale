@inherits RazorSlice<OnboardingPaymentCardView>
<section class="ts-onboarding-section" aria-labelledby="onboarding-payment-title" data-signals="{ plan: 'starter', interval: 'monthly' }">
    <header class="ts-section-head">
        <div>
            <h2 class="ts-panel-title" id="onboarding-payment-title">Register a payment method</h2>
            <p class="ts-meta">@Model.Subtitle</p>
        </div>
        @if (!Model.StepDone)
        {
            <span class="ts-onboarding-interval" role="group" aria-label="Billing interval">
                <button type="button" class="ts-onboarding-interval-option" aria-pressed="true" data-attr:aria-pressed="$interval === 'monthly' ? 'true' : 'false'" data-on:click="$interval = 'monthly'">Monthly</button>
                <button type="button" class="ts-onboarding-interval-option" aria-pressed="false" data-attr:aria-pressed="$interval === 'annual' ? 'true' : 'false'" data-on:click="$interval = 'annual'">Annual <span class="ts-onboarding-interval-badge">2 months free</span></button>
            </span>
        }
    </header>
    <form class="ts-onboarding-form" method="post" action="@Model.Action">
        <input type="hidden" name="step" value="@Model.StepValue" />
        @* The selected plan and billing interval are client-side signals; mirror
           them into the posted form so billing never diverges from the plan the
           user chose and Stripe Checkout receives the matching interval. *@
        <input type="hidden" name="plan" data-bind="plan" />
        <input type="hidden" name="interval" data-bind="interval" />
        @if (Model.StepDone)
        {
            <div class="ts-alert ts-alert-success ts-onboarding-form-full" role="status">
                <span class="ts-onboarding-alert-icon" aria-hidden="true">@Icons.CircleCheck(19)</span>
                <div class="ts-onboarding-alert-stack">
                    <span class="ts-alert-title">Payment method registered</span>
                    <span class="ts-alert-body">@Model.SuccessBody</span>
                </div>
            </div>
        }
        else
        {
            <div class="ts-onboarding-plans ts-onboarding-form-full" role="radiogroup" aria-label="Billing plan">
                @foreach (var plan in Model.Plans)
                {
                    <button type="button" role="radio" class="ts-onboarding-plan ts-onboarding-plan-@plan.Key" aria-checked="@(plan.Key == "starter" ? "true" : "false")" data-attr:aria-checked="$plan === '@plan.Key' ? 'true' : 'false'" data-on:click="$plan = '@plan.Key'">
                        <span class="ts-onboarding-plan-header">
                            <span class="ts-onboarding-plan-name">@plan.Name</span>
                            <span class="ts-onboarding-plan-check" aria-hidden="true">@Icons.Check(12)</span>
                        </span>
                        <span class="ts-meta">@plan.Description</span>
                        <span class="ts-onboarding-plan-trial">$0.00 <small>first month</small></span>
                        <span class="ts-onboarding-plan-price-row" data-show="$interval === 'monthly'">
                            <span>$@(plan.MonthlyUsd.ToString("0"))</span>
                            <span> / month</span>
                        </span>
                        <span class="ts-onboarding-plan-price-row" data-show="$interval === 'annual'">
                            <span>$@(plan.AnnualUsd.ToString("0"))</span>
                            <span> / year</span>
                        </span>
                        <span class="ts-onboarding-plan-features">
                            @foreach (var feature in plan.Features)
                            {
                                <span class="ts-onboarding-plan-feature">@Icons.Check(14) @feature</span>
                            }
                        </span>
                    </button>
                }
            </div>
            <p class="ts-meta ts-onboarding-form-full">@Model.Notice</p>
        }
        <div class="ts-onboarding-form-footer">
            @if (Model.AllowBypass)
            {
                <button class="ts-btn ts-btn-secondary ts-btn-lg" type="submit" name="bypass" value="1">@Icons.ArrowRight(16) Continue without payment</button>
            }
            <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">@Icons.CreditCard(16) Continue to secure payment setup</button>
        </div>
    </form>
</section>
