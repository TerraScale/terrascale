@inherits RazorSlice<OnboardingPageModel>
@{
    var stateLabels = new Dictionary<string, string>
    {
        ["pending"] = "PENDING",
        ["current"] = "CURRENT",
        ["completed"] = "COMPLETED",
        ["blocked"] = "BLOCKED",
        ["not-started"] = "NOT STARTED",
        ["in-progress"] = "IN PROGRESS",
        ["awaiting-validation"] = "AWAITING VALIDATION",
        ["unavailable"] = "UNAVAILABLE",
        ["expired"] = "EXPIRED",
        ["ready-for-project"] = "READY FOR PROJECT",
    };
    var activeState = Model.Steps.First(s => s.Key == Model.ActiveStep).State;
    var stepDone = activeState == "completed";
    var rejected = activeState == "rejected";
    var wide = Model.ActiveStep is "payment-validation" or "project";
    var defaultRegion = Model.Regions.FirstOrDefault(r => r.Live)?.Code ?? "";
}
@FlowHtml.Document("Activate your TerraScale account | TerraScale")
<main class="ts-onboarding-root @(wide ? "ts-onboarding-root-wide" : null)">
    <div class="ts-onboarding-container @(wide ? "ts-onboarding-container-wide" : null) @(Model.Registration ? "ts-onboarding-registration" : null)">
        @* Account creation (anonymous registration) keeps only the TerraScale
           wordmark in the header; the title stays as an sr-only h1 so the
           document outline and accessibility checks keep working. *@
        <header class="ts-onboarding-header @(Model.Registration ? "ts-onboarding-header-brand" : null)">
            @if (Model.Registration)
            {
                <img class="ts-onboarding-brand-logo" src="/brand/logo-terrascale-blue.svg" alt="TerraScale" decoding="async" />
                <h1 class="ts-sr-only">Activate your TerraScale account</h1>
            }
            else
            {
                <span class="ts-onboarding-lock" aria-hidden="true">@Icons.LockKeyhole(22)</span>
                <div>
                    <p class="ts-onboarding-setup">TERRASCALE SETUP</p>
                    <h1 class="ts-onboarding-title">Activate your TerraScale account</h1>
                    <p class="ts-onboarding-description">Complete all five steps to activate billing, create the owning organization, and release your first project Dashboard. Your confirmed progress is saved after every step.</p>
                </div>
            }
        </header>
        <div class="ts-onboarding-progress">
            <div class="ts-onboarding-progress-meta">
                <span>ACTIVATION STEP @Model.CurrentStep OF @Model.TotalSteps</span>
                <span>@Model.ProgressPercent%</span>
            </div>
            <div class="ts-onboarding-progress-frame">
                <div class="ts-progress" role="progressbar" aria-label="Account setup progress" aria-valuenow="@Model.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                    <div class="ts-progress-bar" style="width:@(Model.ProgressPercent)%"></div>
                </div>
            </div>
        </div>
        <ol class="ts-onboarding-steps @(wide ? null : "ts-onboarding-steps-compact")" aria-label="Onboarding progress">
            @foreach (var step in Model.Steps)
            {
                var current = step.Key == Model.ActiveStep;
                var complete = step.State == "completed";
                var blocked = step.State == "blocked";
                var classes = "ts-onboarding-step"
                    + (current ? " ts-onboarding-step-current" : "")
                    + (blocked ? " ts-onboarding-step-blocked" : "")
                    + (complete ? " ts-onboarding-step-complete" : "");
                <li class="@classes" aria-current="@(current ? "step" : null)">
                    @if (complete)
                    {
                        @Icons.Check(18)
                    }
                    else
                    {
                        @(typeof(Icons).GetMethod(step.Icon)?.Invoke(null, [18]) as Microsoft.AspNetCore.Html.HtmlString ?? Icons.Circle(18))
                    }
                    <span>@step.Label</span>
                    <span class="ts-onboarding-step-state">@(stateLabels.TryGetValue(step.State, out var label) ? label : step.State)</span>
                </li>
            }
        </ol>
        @if (Model.PaymentCanceled)
        {
            <div class="ts-alert ts-alert-warning" role="alert">
                <span class="ts-onboarding-alert-icon" aria-hidden="true">@Icons.TriangleAlert(19)</span>
                <div class="ts-onboarding-alert-stack">
                    <span class="ts-alert-title">Payment setup canceled</span>
                    <span class="ts-alert-body">Your earlier account progress is still saved. No payment method was changed; you can safely try again.</span>
                </div>
            </div>
        }
        @if (Model.Registration)
        {
            <div class="ts-onboarding-card">
                <form class="ts-onboarding-form" method="post" action="/onboarding/register" novalidate data-signals="{ passwordVisible: false, confirmPasswordVisible: false }">
                    @if (Model.RegistrationError is { } registrationError)
                    {
                        <div class="ts-onboarding-form-full" role="alert">
                            <div class="ts-alert ts-alert-danger">
                                <span class="ts-onboarding-alert-icon" aria-hidden="true">@Icons.CircleAlert(19)</span>
                                <div class="ts-onboarding-alert-stack">
                                    <span class="ts-alert-title">@registrationError</span>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="ts-field">
                        <label class="ts-label" for="displayName">Full name</label>
                        <input class="ts-input" id="displayName" name="displayName" autocomplete="name" maxlength="128" required />
                    </div>
                    <div class="ts-field">
                        <label class="ts-label" for="email">Email</label>
                        <input class="ts-input" type="email" id="email" name="email" placeholder="name@company.com" autocomplete="email" required />
                    </div>
                    <div class="ts-field">
                        <label class="ts-label" for="password">Password</label>
                        <div class="ts-input-group">
                            <input class="ts-input" type="password" id="password" name="password" placeholder="Enter your password" autocomplete="new-password" required data-attr-type="passwordVisible ? 'text' : 'password'" />
                            <button class="ts-input-adornment" type="button" aria-label="Show password" aria-pressed="false" data-attr-aria-pressed="passwordVisible" data-attr-aria-label="passwordVisible ? 'Hide password' : 'Show password'" data-on-click="passwordVisible = !passwordVisible">
                                <span data-show="!passwordVisible">@Icons.Eye(18)</span>
                                <span data-show="passwordVisible">@Icons.EyeOff(18)</span>
                            </button>
                        </div>
                    </div>
                    <div class="ts-field">
                        <label class="ts-label" for="confirmPassword">Confirm password</label>
                        <div class="ts-input-group">
                            <input class="ts-input" type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required data-attr-type="confirmPasswordVisible ? 'text' : 'password'" />
                            <button class="ts-input-adornment" type="button" aria-label="Show password" aria-pressed="false" data-attr-aria-pressed="confirmPasswordVisible" data-attr-aria-label="confirmPasswordVisible ? 'Hide password' : 'Show password'" data-on-click="confirmPasswordVisible = !confirmPasswordVisible">
                                <span data-show="!confirmPasswordVisible">@Icons.Eye(18)</span>
                                <span data-show="confirmPasswordVisible">@Icons.EyeOff(18)</span>
                            </button>
                        </div>
                    </div>
                    <div class="ts-onboarding-terms">
                        <label class="ts-onboarding-terms-label">
                            <input class="ts-checkbox" type="checkbox" name="terms" value="true" required />
                            <span>I accept the Terms of Service</span>
                        </label>
                    </div>
                    <div class="ts-onboarding-form-footer">
                        <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">@Icons.ArrowRight(20) Save</button>
                        <p class="ts-onboarding-secondary">Already have an account? <a class="ts-link" href="/login">Sign in</a></p>
                    </div>
                </form>
            </div>
        }
        else if (Model.ActiveStep == "account-information")
        {
            <div class="ts-onboarding-card">
                <header class="ts-onboarding-step-header">
                    <h2 class="ts-onboarding-step-title">Review your account information</h2>
                    <p class="ts-onboarding-step-subtitle">Signed in as @Model.Email</p>
                    <div class="ts-onboarding-step-actions">
                        <span class="ts-onboarding-step-icon" aria-hidden="true">@Icons.UserRound(20)</span>
                    </div>
                </header>
                <form class="ts-onboarding-form" method="post" action="/onboarding/step">
                    <input type="hidden" name="step" value="account-information" />
                    <div class="ts-field">
                        <label class="ts-label" for="displayName">Full name</label>
                        <input class="ts-input" id="displayName" name="displayName" value="@Model.DisplayName" required autocomplete="name" />
                    </div>
                    <div class="ts-field ts-onboarding-form-full">
                        <label class="ts-label" for="email">Email</label>
                        <input class="ts-input" id="email" type="email" value="@Model.Email" readonly />
                        <span class="ts-hint">Your sign-in email cannot be changed during account setup.</span>
                    </div>
                    <div class="ts-onboarding-form-footer">
                        <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Save and continue</button>
                    </div>
                </form>
            </div>
        }
        else if (Model.ActiveStep == "organization")
        {
            <div class="ts-onboarding-card">
                <header class="ts-onboarding-step-header">
                    <h2 class="ts-onboarding-step-title">Create your first organization</h2>
                    <p class="ts-onboarding-step-subtitle">Billing and future projects use this authenticated tenant boundary.</p>
                    <div class="ts-onboarding-step-actions">
                        <span class="ts-onboarding-step-icon" aria-hidden="true">@Icons.Building2(20)</span>
                    </div>
                </header>
                <div class="ts-onboarding-content">
                    @if (stepDone)
                    {
                        <div class="ts-alert ts-alert-success" role="status">
                            <span class="ts-onboarding-alert-icon" aria-hidden="true">@Icons.CircleCheck(19)</span>
                            <div class="ts-onboarding-alert-stack">
                                <span class="ts-alert-title">Organization created</span>
                                <span class="ts-alert-body">Your organization is ready for billing and projects.</span>
                            </div>
                        </div>
                        <div class="ts-onboarding-form-footer">
                            <a class="ts-btn ts-btn-primary ts-btn-lg" href="/onboarding?step=payment-method">Continue</a>
                        </div>
                    }
                    else
                    {
                        <form class="ts-onboarding-field-list" method="post" action="/onboarding/step">
                            <input type="hidden" name="step" value="organization" />
                            <div class="ts-field">
                                <label class="ts-label" for="organizationName">Organization name</label>
                                <input class="ts-input" id="organizationName" name="name" placeholder="Acme Labs" required />
                            </div>
                            <div class="ts-onboarding-form-footer">
                                <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Create organization</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        }
        else if (Model.ActiveStep == "payment-method")
        {
            <div class="ts-onboarding-card" data-signals="{ plan: 'starter', interval: 'monthly' }">
                <header class="ts-onboarding-step-header">
                    <h2 class="ts-onboarding-step-title">Register a payment method</h2>
                    <p class="ts-onboarding-step-subtitle">Checkout is bound to your authenticated organization and configured payment provider.</p>
                    <div class="ts-onboarding-step-actions">
                        <span class="ts-onboarding-step-icon" aria-hidden="true">@Icons.CreditCard(20)</span>
                        <span class="ts-onboarding-interval ts-onboarding-interval-header" role="group" aria-label="Billing interval">
                            <button type="button" class="ts-onboarding-interval-option" aria-pressed="true" data-attr-aria-pressed="interval === 'monthly'" data-on-click="interval = 'monthly'">Monthly</button>
                            <button type="button" class="ts-onboarding-interval-option" aria-pressed="false" data-attr-aria-pressed="interval === 'annual'" data-on-click="interval = 'annual'">Annual <span class="ts-onboarding-interval-badge">2 months free</span></button>
                        </span>
                    </div>
                </header>
                <form class="ts-onboarding-content" method="post" action="/onboarding/step">
                    <input type="hidden" name="step" value="payment-method" />
                    @if (stepDone)
                    {
                        <div class="ts-alert ts-alert-success" role="status">
                            <span class="ts-onboarding-alert-icon" aria-hidden="true">@Icons.CircleCheck(19)</span>
                            <div class="ts-onboarding-alert-stack">
                                <span class="ts-alert-title">Payment method registered</span>
                                <span class="ts-alert-body">Continue to validation.</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="ts-onboarding-plans" role="radiogroup" aria-label="Billing plan">
                            @foreach (var plan in Model.Plans)
                            {
                                <button type="button" role="radio" class="ts-onboarding-plan ts-onboarding-plan-@plan.Key" aria-checked="@(plan.Key == "starter" ? "true" : "false")" data-attr-aria-checked="plan === '@plan.Key'" data-on-click="plan = '@plan.Key'">
                                    <span class="ts-onboarding-plan-header">
                                        <span class="ts-onboarding-plan-name">@plan.Name</span>
                                        <span class="ts-onboarding-plan-check" aria-hidden="true">@Icons.Check(13)</span>
                                    </span>
                                    <span class="ts-onboarding-plan-description">@plan.Description</span>
                                    <span class="ts-onboarding-plan-price-row" data-show="interval === 'monthly'">
                                        <span class="ts-onboarding-plan-strike" aria-hidden="true">$@(plan.MonthlyUsd.ToString("0"))</span>
                                        <span class="ts-onboarding-plan-per"> / month</span>
                                    </span>
                                    <span class="ts-onboarding-plan-price-row" data-show="interval === 'annual'">
                                        <span class="ts-onboarding-plan-strike" aria-hidden="true">$@(plan.AnnualUsd.ToString("0"))</span>
                                        <span class="ts-onboarding-plan-per"> / year</span>
                                    </span>
                                    <span class="ts-onboarding-plan-trial">$0.00</span>
                                    <span class="ts-onboarding-plan-divider" aria-hidden="true"></span>
                                    <span class="ts-onboarding-plan-features">
                                        @foreach (var feature in plan.Features)
                                        {
                                            <span class="ts-onboarding-plan-feature">
                                                <span class="ts-onboarding-plan-feature-check" aria-hidden="true">@Icons.Check(11)</span>
                                                <span>@feature</span>
                                            </span>
                                        }
                                    </span>
                                </button>
                            }
                        </div>
                        <div class="ts-onboarding-interval-switch">
                            <span class="ts-onboarding-interval-switch-label">Billing interval</span>
                            <span class="ts-onboarding-interval" role="group" aria-label="Billing interval">
                                <button type="button" class="ts-onboarding-interval-option" aria-pressed="true" data-attr-aria-pressed="interval === 'monthly'" data-on-click="interval = 'monthly'">Monthly</button>
                                <button type="button" class="ts-onboarding-interval-option" aria-pressed="false" data-attr-aria-pressed="interval === 'annual'" data-on-click="interval = 'annual'">Annual <span class="ts-onboarding-interval-badge">2 months free</span></button>
                            </span>
                        </div>
                        <p class="ts-onboarding-provider-notice">No card today? Continue on the Free plan with X operations per month. Add a payment method now and your first month is free.</p>
                    }
                    <div class="ts-onboarding-form-footer">
                        <button class="ts-btn ts-btn-secondary ts-btn-lg" type="submit" name="bypass" value="1">@Icons.ArrowRight(20) Continue without payment</button>
                        <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">@Icons.CreditCard(20) Continue to secure payment setup</button>
                    </div>
                </form>
            </div>
        }
        else if (Model.ActiveStep == "payment-validation")
        {
            <div class="ts-onboarding-card">
                <header class="ts-onboarding-step-header">
                    <h2 class="ts-onboarding-step-title">Validate your payment method</h2>
                    <p class="ts-onboarding-step-subtitle">TerraScale waits for a signed provider event before activating billing.</p>
                    <div class="ts-onboarding-step-actions">
                        <span class="ts-onboarding-step-icon" aria-hidden="true">@Icons.CircleCheckBig(20)</span>
                    </div>
                </header>
                <div class="ts-onboarding-content">
                    @if (Model.PaymentValidated)
                    {
                        <div class="ts-alert ts-alert-success" role="status">
                            <span class="ts-onboarding-alert-icon" aria-hidden="true">@Icons.CircleCheck(19)</span>
                            <div class="ts-onboarding-alert-stack">
                                <span class="ts-alert-title">Payment method validated</span>
                                <span class="ts-alert-body">Billing validation is complete for this organization.</span>
                            </div>
                        </div>
                        <div class="ts-onboarding-form-footer">
                            <a class="ts-btn ts-btn-primary ts-btn-lg" href="/onboarding?step=project">Continue</a>
                        </div>
                    }
                    else
                    {
                        @if (rejected)
                        {
                            <div class="ts-alert ts-alert-danger" role="alert">
                                <span class="ts-onboarding-alert-icon" aria-hidden="true">@Icons.CircleAlert(19)</span>
                                <div class="ts-onboarding-alert-stack">
                                    <span class="ts-alert-title">The provider could not approve this payment method.</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ts-alert ts-alert-info" role="status">
                                <span class="ts-onboarding-alert-icon" aria-hidden="true">@Icons.Info(19)</span>
                                <div class="ts-onboarding-alert-stack">
                                    <span class="ts-alert-title">Validation pending</span>
                                    <span class="ts-alert-body">TerraScale is waiting for a conclusive provider result. You can check again or safely restart secure payment setup for this organization.</span>
                                </div>
                            </div>
                        }
                        <div class="ts-onboarding-form-footer">
                            <a class="ts-btn ts-btn-secondary ts-btn-lg" href="/checkout/@OnboardingPageEndpoint.DemoCheckoutSession">@Icons.RotateCcw(20) Register another method</a>
                            <a class="ts-btn ts-btn-primary ts-btn-lg" href="/onboarding?step=payment-validation">@Icons.CircleCheckBig(20) Check validation status</a>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="ts-onboarding-card">
                <header class="ts-onboarding-step-header">
                    <h2 class="ts-onboarding-step-title">Create your first project</h2>
                    <p class="ts-onboarding-step-subtitle">Products inherit these primary regions.</p>
                    <div class="ts-onboarding-step-actions">
                        <span class="ts-onboarding-step-icon" aria-hidden="true">@Icons.Database(20)</span>
                    </div>
                </header>
                <form class="ts-onboarding-content ts-onboarding-content-wide" method="post" action="/onboarding/step">
                    <input type="hidden" name="step" value="project" />
                    <div class="ts-field">
                        <label class="ts-label" for="projectName">Project name</label>
                        <input class="ts-input" id="projectName" name="name" placeholder="Production" required />
                    </div>
                    <div class="ts-field">
                        <span class="ts-label" id="regionLabel">Primary regions</span>
                        <div class="ts-onboarding-region-map" role="radiogroup" aria-labelledby="regionLabel">
                            <img class="ts-onboarding-region-dots" src="/brand/region-map.svg" alt="" decoding="async" />
                            @foreach (var region in Model.Regions)
                            {
                                var left = (region.X / RegionMap.Width * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                var top = (region.Y / RegionMap.Height * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                <label class="ts-onboarding-region-pin @(region.Live ? null : "ts-onboarding-region-pin-disabled")" style="left:@(left)%;top:@(top)%">
                                    <input class="ts-onboarding-region-input" type="radio" name="region" value="@region.Code" aria-label="@region.Name (@region.Code.ToUpperInvariant()) — @(region.Live ? "Available" : "Unavailable")" @(region.Code == defaultRegion ? "checked" : null) @(region.Live ? null : "disabled") />
                                    <span class="ts-onboarding-region-dot" aria-hidden="true"></span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="ts-onboarding-form-footer">
                        <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Create project and open Dashboard</button>
                    </div>
                </form>
            </div>
        }
    </div>
</main>
@FlowHtml.End()
