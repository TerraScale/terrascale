@inherits RazorSlice<OnboardingPageModel>
@{
    var activeState = Model.Steps.First(s => s.Key == Model.ActiveStep).State;
    var stepDone = activeState == "completed";
    var rejected = activeState == "rejected";
    var wide = Model.ActiveStep is "payment-validation" or "project";
    var defaultRegion = Model.Regions.FirstOrDefault(r => r.Live)?.Code ?? "";
}
@FlowHtml.Document("Activate your TerraScale account | TerraScale")
<main class="ts-onboarding-root @(wide ? "ts-onboarding-root-wide" : null)">
    <div class="ts-onboarding-container @(wide ? "ts-onboarding-container-wide" : null)">
        @* Account creation (anonymous registration) keeps only the TerraScale
           wordmark in the header; the title stays as an sr-only h1 so the
           document outline and accessibility checks keep working. *@
        <header class="ts-onboarding-header @(Model.Registration ? "ts-onboarding-header-brand" : null)">
            @if (Model.Registration)
            {
                <img class="ts-brand-logo" src="/brand/logo-terrascale-blue.svg" alt="TerraScale" decoding="async" />
                <h1 class="ts-sr-only">Activate your TerraScale account</h1>
            }
            else
            {
                <span class="ts-onboarding-lock" aria-hidden="true">@Icons.LockKeyhole(22)</span>
                <div>
                    <p class="ts-onboarding-setup">TERRASCALE SETUP</p>
                    <h1 class="ts-onboarding-title">Activate your TerraScale account</h1>
                    <p class="ts-onboarding-description">Complete all five steps to activate billing, create the owning organization, and release your first project Dashboard. Your confirmed progress is saved after every step.</p>
                </div>
            }
        </header>
        @(await RenderPartialAsync<OnboardingProgress, OnboardingProgressView>(new(
            Steps: Model.Steps,
            ActiveStep: Model.ActiveStep,
            CurrentStep: Model.CurrentStep,
            TotalSteps: Model.TotalSteps,
            ProgressPercent: Model.ProgressPercent,
            Label: "ACTIVATION STEP",
            Compact: !wide,
            AriaLabel: "Onboarding progress",
            BarAriaLabel: "Account setup progress")))
        @if (Model.PaymentCanceled)
        {
            <div class="ts-alert ts-alert-warning" role="alert">
                <span class="ts-onboarding-alert-icon" aria-hidden="true">@Icons.TriangleAlert(19)</span>
                <div class="ts-onboarding-alert-stack">
                    <span class="ts-alert-title">Payment setup canceled</span>
                    <span class="ts-alert-body">Your earlier account progress is still saved. No payment method was changed; you can safely try again.</span>
                </div>
            </div>
        }
        @if (Model.Registration)
        {
            <div class="ts-onboarding-card">
                <form class="ts-onboarding-form" method="post" action="/onboarding/register" novalidate data-signals="{ passwordVisible: false, confirmPasswordVisible: false }">
                    @if (Model.RegistrationError is { } registrationError)
                    {
                        <div class="ts-onboarding-form-full" role="alert">
                            <div class="ts-alert ts-alert-danger">
                                <span class="ts-onboarding-alert-icon" aria-hidden="true">@Icons.CircleAlert(19)</span>
                                <div class="ts-onboarding-alert-stack">
                                    <span class="ts-alert-title">@registrationError</span>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="ts-field">
                        <label class="ts-label" for="displayName">Full name</label>
                        <input class="ts-input" id="displayName" name="displayName" autocomplete="name" maxlength="128" required />
                    </div>
                    <div class="ts-field">
                        <label class="ts-label" for="email">Email</label>
                        <input class="ts-input" type="email" id="email" name="email" placeholder="name@company.com" autocomplete="email" required />
                    </div>
                    <div class="ts-field">
                        <label class="ts-label" for="password">Password</label>
                        <div class="ts-input-group">
                            <input class="ts-input" type="password" id="password" name="password" placeholder="Enter your password" autocomplete="new-password" required data-attr-type="passwordVisible ? 'text' : 'password'" />
                            <button class="ts-input-adornment" type="button" aria-label="Show password" aria-pressed="false" data-attr-aria-pressed="passwordVisible" data-attr-aria-label="passwordVisible ? 'Hide password' : 'Show password'" data-on-click="passwordVisible = !passwordVisible">
                                <span data-show="!passwordVisible">@Icons.Eye(18)</span>
                                <span data-show="passwordVisible">@Icons.EyeOff(18)</span>
                            </button>
                        </div>
                    </div>
                    <div class="ts-field">
                        <label class="ts-label" for="confirmPassword">Confirm password</label>
                        <div class="ts-input-group">
                            <input class="ts-input" type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required data-attr-type="confirmPasswordVisible ? 'text' : 'password'" />
                            <button class="ts-input-adornment" type="button" aria-label="Show password" aria-pressed="false" data-attr-aria-pressed="confirmPasswordVisible" data-attr-aria-label="confirmPasswordVisible ? 'Hide password' : 'Show password'" data-on-click="confirmPasswordVisible = !confirmPasswordVisible">
                                <span data-show="!confirmPasswordVisible">@Icons.Eye(18)</span>
                                <span data-show="confirmPasswordVisible">@Icons.EyeOff(18)</span>
                            </button>
                        </div>
                    </div>
                    <div class="ts-onboarding-terms">
                        <label class="ts-onboarding-terms-label">
                            <input class="ts-checkbox" type="checkbox" name="terms" value="true" required />
                            <span>I accept the Terms of Service</span>
                        </label>
                    </div>
                    <div class="ts-onboarding-form-footer">
                        <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">@Icons.ArrowRight(20) Save</button>
                        <p class="ts-onboarding-secondary">Already have an account? <a class="ts-link" href="/login">Sign in</a></p>
                    </div>
                </form>
            </div>
        }
        else if (Model.ActiveStep == "account-information")
        {
            <div class="ts-onboarding-card">
                <header class="ts-onboarding-step-header">
                    <h2 class="ts-onboarding-step-title">Review your account information</h2>
                    <p class="ts-onboarding-step-subtitle">Signed in as @Model.Email</p>
                    <div class="ts-onboarding-step-actions">
                        <span class="ts-onboarding-step-icon" aria-hidden="true">@Icons.UserRound(20)</span>
                    </div>
                </header>
                <form class="ts-onboarding-form" method="post" action="/onboarding/step">
                    <input type="hidden" name="step" value="account-information" />
                    <div class="ts-field">
                        <label class="ts-label" for="displayName">Full name</label>
                        <input class="ts-input" id="displayName" name="displayName" value="@Model.DisplayName" required autocomplete="name" />
                    </div>
                    <div class="ts-field ts-onboarding-form-full">
                        <label class="ts-label" for="email">Email</label>
                        <input class="ts-input" id="email" type="email" value="@Model.Email" readonly />
                        <span class="ts-hint">Your sign-in email cannot be changed during account setup.</span>
                    </div>
                    <div class="ts-onboarding-form-footer">
                        <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">Save and continue</button>
                    </div>
                </form>
            </div>
        }
        else if (Model.ActiveStep == "organization")
        {
            @(await RenderPartialAsync<OnboardingOrganizationCard, OnboardingOrganizationCardView>(new(
                Action: "/onboarding/step",
                StepValue: "organization",
                Title: "Create your first organization",
                Subtitle: "Billing and future projects use this authenticated tenant boundary.",
                ContinueHref: "/onboarding?step=payment-method",
                StepDone: stepDone)))
        }
        else if (Model.ActiveStep == "payment-method")
        {
            @(await RenderPartialAsync<OnboardingPaymentCard, OnboardingPaymentCardView>(new(
                Action: "/onboarding/step",
                StepValue: "payment-method",
                Plans: Model.Plans,
                StepDone: stepDone)))
        }
        else if (Model.ActiveStep == "payment-validation")
        {
            <div class="ts-onboarding-card">
                <header class="ts-onboarding-step-header">
                    <h2 class="ts-onboarding-step-title">Validate your payment method</h2>
                    <p class="ts-onboarding-step-subtitle">TerraScale waits for a signed provider event before activating billing.</p>
                    <div class="ts-onboarding-step-actions">
                        <span class="ts-onboarding-step-icon" aria-hidden="true">@Icons.CircleCheckBig(20)</span>
                    </div>
                </header>
                <div class="ts-onboarding-content">
                    @if (Model.PaymentValidated)
                    {
                        <div class="ts-alert ts-alert-success" role="status">
                            <span class="ts-onboarding-alert-icon" aria-hidden="true">@Icons.CircleCheck(19)</span>
                            <div class="ts-onboarding-alert-stack">
                                <span class="ts-alert-title">Payment method validated</span>
                                <span class="ts-alert-body">Billing validation is complete for this organization.</span>
                            </div>
                        </div>
                        <div class="ts-onboarding-form-footer">
                            <a class="ts-btn ts-btn-primary ts-btn-lg" href="/onboarding?step=project">Continue</a>
                        </div>
                    }
                    else
                    {
                        @if (rejected)
                        {
                            <div class="ts-alert ts-alert-danger" role="alert">
                                <span class="ts-onboarding-alert-icon" aria-hidden="true">@Icons.CircleAlert(19)</span>
                                <div class="ts-onboarding-alert-stack">
                                    <span class="ts-alert-title">The provider could not approve this payment method.</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ts-alert ts-alert-info" role="status">
                                <span class="ts-onboarding-alert-icon" aria-hidden="true">@Icons.Info(19)</span>
                                <div class="ts-onboarding-alert-stack">
                                    <span class="ts-alert-title">Validation pending</span>
                                    <span class="ts-alert-body">TerraScale is waiting for a conclusive provider result. You can check again or safely restart secure payment setup for this organization.</span>
                                </div>
                            </div>
                        }
                        <div class="ts-onboarding-form-footer">
                            <a class="ts-btn ts-btn-secondary ts-btn-lg" href="/checkout/@OnboardingPageEndpoint.DemoCheckoutSession">@Icons.RotateCcw(20) Register another method</a>
                            <a class="ts-btn ts-btn-primary ts-btn-lg" href="/onboarding?step=payment-validation">@Icons.CircleCheckBig(20) Check validation status</a>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            @(await RenderPartialAsync<OnboardingProjectCard, OnboardingProjectCardView>(new(
                Action: "/onboarding/step",
                StepValue: "project",
                Regions: Model.Regions,
                DefaultRegion: defaultRegion)))
        }
    </div>
</main>
@FlowHtml.End()
