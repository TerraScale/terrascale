@inherits RazorSlice<TerraScale.Dashboard.Features.Databases.DatabaseDetailPage>
@using TerraScale.Dashboard.Features.Databases
@if(Model.Conflicts is { } conflicts){
<section class="ts-card ts-card-boxed" id="conflicts" aria-labelledby="conflicts-title">
<header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="conflicts-title">Conflicts</h2></div><div class="ts-card-actions"><a class="ts-link" href="https://docs.terrascale.tech/guides/multi-region-writes-and-conflicts" @(ExternalLink.Attributes)>Conflict rules@(ExternalLink.Hint)</a><form id="conflict-filters" class="ts-filters" method="get" data-on:keydown="evt.key === 'Enter' &amp;&amp; (evt.preventDefault(), el.requestSubmit())" action="@DatabaseService.Path(Model.Database.Id, "conflicts")" aria-label="Filter conflicts" data-on:submit="evt.preventDefault(); const url = new URL(el.getAttribute('action'), window.location.origin); url.search = new URLSearchParams(new FormData(el)).toString(); history.replaceState(null, '', url); @@get(url.toString(), {retryMaxCount: 0})">
<div class="ts-field"><label class="ts-label" for="conflict-table">Table</label><input class="ts-input ts-mono" id="conflict-table" data-on:change="el.form.requestSubmit()" name="table" value="@conflicts.Table" maxlength="256" placeholder="All tables" /></div>
<div class="ts-field"><label class="ts-label" for="conflict-since">Since (UTC)</label><input class="ts-input" type="datetime-local" id="conflict-since" data-on:change="el.form.requestSubmit()" name="since" value="@conflicts.Since" step="any" /></div>
<div class="ts-field"><label class="ts-label" for="conflict-until">Until (UTC)</label><input class="ts-input" type="datetime-local" id="conflict-until" data-on:change="el.form.requestSubmit()" name="until" value="@conflicts.Until" step="any" /></div>
</form></div></header>
@(await RenderPartialAsync<DatabaseConflictResults, DatabaseDetailPage>(Model))
</section>
}
