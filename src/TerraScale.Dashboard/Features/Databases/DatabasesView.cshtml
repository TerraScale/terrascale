@using TerraScale.Dashboard.Common.Charts
@inherits RazorSlice<TerraScale.Dashboard.Features.Databases.DatabasesPage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.Databases
@inject AssetUrls Assets
<main class="ts-page ts-databases" data-project-id="@Model.Context.Project?.Id" data-organization-id="@Model.Context.Organization?.Id">
<h1 class="ts-sr-only">Databases</h1>
@if(HttpContext!.Request.Query["invitation"] == "declined"){<p class="ts-alert ts-alert-success" role="status">Invitation declined. Your access has not changed.</p>}
@if(Model.Notice.Length > 0){<div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">@Model.Notice</p></div>}
@if(Model.Error.Length > 0 && !Model.OpenCreate){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}
@if(Model.All.Count > 0){<dl class="ts-stats" aria-label="Database totals">
<div class="ts-stat"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Databases</dt><dd class="ts-stat-value">@Model.All.Count</dd></div>
<div class="ts-stat" data-tone="success"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Ready</dt><dd class="ts-stat-value">@Model.Ready</dd></div>
<div class="ts-stat" data-tone="warning"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Provisioning</dt><dd class="ts-stat-value">@Model.Progress</dd></div>
@if(Model.Failed > 0){<div class="ts-stat" data-tone="danger"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Failed</dt><dd class="ts-stat-value">@Model.Failed</dd></div>}
<div class="ts-stat"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Regions</dt><dd class="ts-stat-value">@Model.Regions.Count</dd></div>
</dl>}
<section class="ts-card ts-card-flush" id="project-databases" aria-labelledby="project-databases-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="project-databases-title">Project databases</h2>@if(Model.Metrics?.Message is { Length: > 0 } metricsMessage){<p class="ts-meta" role="status">@metricsMessage</p>}</div><div class="ts-card-actions ts-card-actions-shrinkable">@if(Model.CanProvision){<button class="ts-btn ts-btn-primary ts-btn-sm" type="button" command="show-modal" commandfor="create-database">@Icons.Render("Plus",16)<span>New database</span></button>}<nav class="ts-segmented" aria-label="Database metrics range">@foreach(var value in new[]{"1h","24h","7d","30d"}){<a class="ts-segment" href="@Model.RangePath(value)" aria-current="@(value == Model.Range ? "page" : null)">@value</a>}</nav><form class="ts-filters ts-db-search" method="get" action="/databases" role="search" aria-label="Search databases"><input type="hidden" name="range" value="@Model.Range" /><input class="ts-input ts-input-sm" type="search" name="q" value="@Model.Search" placeholder="Search databases..." aria-label="Search databases" />@if(Model.Search.Length > 0){<a class="ts-btn ts-btn-ghost ts-btn-sm" href="@Model.ClearPath">Clear</a>}</form></div></header><div class="ts-card-body">
@if(Model.Databases.Count > 0){<div class="ts-table-wrap"><table class="ts-table ts-db-table" role="table"><thead role="rowgroup"><tr role="row"><th role="columnheader">Name</th><th role="columnheader">Status</th>@foreach(var cell in Model.Cells("")){<th role="columnheader" class="ts-num">@cell.Label</th>}<th role="columnheader">Expires</th><th role="columnheader">Regions</th></tr></thead><tbody role="rowgroup">@foreach(var database in Model.Databases){<tr role="row"><td role="cell"><a class="ts-db-name" href="@DatabaseService.Path(database.Id)"><span class="ts-db-icon" aria-hidden="true">@Icons.Render("Database",18)</span><span class="ts-list-main"><span class="ts-strong">@database.Name</span><span class="ts-meta">Created @database.CreatedAt.UtcDateTime.ToString("MMM d, yyyy",System.Globalization.CultureInfo.InvariantCulture)</span></span></a></td><td role="cell"><span class="ts-badge ts-badge-tone" data-tone="@DatabasesPage.Tone(database.Status)"><span class="ts-dot" aria-hidden="true"></span>@database.Status</span></td>@foreach(var cell in Model.Cells(database.Id)){<td role="cell" class="ts-num" data-label="@cell.Label">@if(cell.Value is null){<span class="ts-meta" aria-hidden="true">—</span><span class="ts-sr-only">Not reported</span>}else{<span class="ts-db-metric">@if(cell.Trend?.Paths.FirstOrDefault()?.Path is { Length: > 0 } trend){<svg class="ts-db-spark @cell.Hue" viewBox="48 10 660 162" preserveAspectRatio="none" role="img" aria-label="@(cell.Label + " trend, " + Model.Range)"><title>@(cell.Label + " trend, " + Model.Range)</title><path d="@trend"></path></svg>}<span class="ts-mono" title="@cell.Title">@cell.Value</span></span>}</td>}<td role="cell" data-label="Expires">@if(database.ExpiresAt is { } expiry){<time datetime="@expiry.ToString("O",System.Globalization.CultureInfo.InvariantCulture)">@expiry.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</time>}else{<span>Never</span>}</td><td role="cell"><span class="ts-db-chips">@foreach(var region in Model.Serving(database).OrderBy(Regions.Rank)){var match = Model.Choices.FirstOrDefault(option => string.Equals(option.Code, region, StringComparison.OrdinalIgnoreCase));var label = region.ToLowerInvariant();var flag = Regions.Flag(Regions.Country(label) is { Length: > 0 } known ? known : match?.Country ?? "");<span class="ts-db-region" data-region="@label" title="@match?.Name">@if(flag.Length > 0){<img class="ts-db-region-flag" src="@Assets.Url("flags/" + flag + ".svg")" alt="" aria-hidden="true" />}<span class="ts-mono">@label</span></span>}</span></td></tr>}</tbody></table></div>}
else{<div class="ts-empty" role="status"><p class="ts-empty-title">@(Model.Search.Length > 0 ? "No databases match this filter." : "No databases yet.")</p>@if(Model.Search.Length > 0){<a class="ts-btn ts-btn-secondary ts-btn-sm" href="@Model.ClearPath">Clear search</a>}else if(Model.CanProvision){<button class="ts-btn ts-btn-primary" type="button" command="show-modal" commandfor="create-database">@Icons.Render("Plus",16)<span>New database</span></button>}</div>}
</div></section>
@if(Model.CanProvision){<dialog id="create-database" class="ts-dialog ts-db-create-dialog" closedby="any" aria-labelledby="create-database-title" data-init="@(Model.OpenCreate ? "el.showModal()" : "void 0")"><div class="ts-dialog-content" data-region-surface><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="create-database-title">New database</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="create-database">@Icons.Render("X",18)</button></header>
<form method="post" action="/api/v1/dashboard/databases" class="ts-db-create-form" data-submit-once data-signals="{_nameInvalid: false, _creating: false}" data-class:ts-db-creating="$_creating" data-attr:inert="$_creating"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
@if(Model.Error.Length > 0 && Model.OpenCreate){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-title">Database not created</p><p class="ts-alert-body">@Model.Error</p></div>}
<div class="ts-db-create-top"><div class="ts-field"><label class="ts-label" for="database-name">Database name</label><input class="ts-input ts-input-lg" id="database-name" name="name" value="@Model.Name" pattern="@DatabaseService.NameInputPattern" maxlength="63" required autofocus autocomplete="off" spellcheck="false" placeholder="orders" title="@DatabaseService.NameHint" aria-describedby="database-name-error" data-on:change="$_nameInvalid = !el.validity.valid" data-on:input="$_nameInvalid &amp;&amp; ($_nameInvalid = !el.validity.valid)" data-attr:aria-invalid="$_nameInvalid ? 'true' : 'false'" /><p class="ts-field-error" id="database-name-error" hidden data-attr:hidden="!$_nameInvalid">@DatabaseService.NameHint</p></div>
<div class="ts-db-create-headline" aria-hidden="true" data-on:submit__window="evt.target === el.closest('form') &amp;&amp; !evt.defaultPrevented &amp;&amp; !$_creating &amp;&amp; ($_creating = true, el.closest('dialog').querySelector('[command=close]').focus())" data-on:pageshow__window="$_creating = false" data-on:keydown__window="evt.key === 'Escape' &amp;&amp; ($_creating = false)"><span class="ts-db-create-mark">@Icons.Render("Database",20)</span><p class="ts-db-create-state">Creating database</p></div></div>
@if(Model.Catalog.Count > 0){
@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.RegionMap, RegionMapModel>(Model.RegionMap))
}else if(Model.Choices is [var serving, ..]){
<div class="ts-field"><label class="ts-label" for="database-region">Region</label><select class="ts-input" id="database-region" name="regions"><option value="@serving.Code">@DatabasesPage.RegionDisplay(serving.Code)</option></select></div>
}
@if(Model.RegionsError.Length > 0){<p class="ts-field-error" role="alert">@Model.RegionsError</p>}
<div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="create-database">Cancel</button><button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">@Icons.Render("Plus",16)<span>Create database</span></button></div></form><p class="ts-sr-only" role="status" data-text="$_creating ? 'Creating database.' : ''"></p></div></dialog>}
</main>
@functions {
    public ShellModel LayoutModel => Model.Shell;
}
