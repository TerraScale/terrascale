@inherits RazorSlice<TerraScale.Dashboard.Features.Databases.DatabaseDetailPage>
@using TerraScale.Dashboard.Features.Databases
@using TerraScale.Dashboard.Common.Live
@if(Model.Conflicts is { } conflicts){
<div id="conflict-results" class="ts-card-body ts-stack-lg" @(LiveView.Initializer(Model.Shell.Context, conflicts.Path(Model.Database.Id).Replace("/conflicts?", "/conflicts/live?", StringComparison.Ordinal) + "&before=" + Uri.EscapeDataString(conflicts.Before)))>

@if(conflicts.Error.Length > 0){<div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-body">@conflicts.Error</p><a class="ts-link" href="@conflicts.Path(Model.Database.Id, conflicts.Before)" data-on:click="evt.preventDefault(); history.replaceState(null, '', el.href); @@get(el.href, {retryMaxCount: 0})">Retry</a></div>}
else if(conflicts.Listing is { Conflicts.Count: 0 }){<div class="ts-empty" role="status"><p class="ts-empty-title">No conflicts match these filters.</p><a class="ts-btn ts-btn-secondary ts-btn-sm" href="@DatabaseService.Path(Model.Database.Id, "conflicts")" data-on:click="evt.preventDefault(); history.replaceState(null, '', el.href); @@get(el.href, {retryMaxCount: 0})">Show recent conflicts</a></div>}
else if(conflicts.Listing is { } listing){
<div class="ts-table-wrap" role="region" aria-label="Recent conflicts" tabindex="0"><table class="ts-table"><thead><tr><th scope="col">Recorded (UTC)</th><th scope="col">Table / row key</th><th scope="col">Column</th><th scope="col">Winning write</th><th scope="col">Losing write</th><th scope="col">Reason</th></tr></thead><tbody>
@foreach(var conflict in listing.Conflicts){
<tr data-conflict-id="@conflict.Id"><td><time datetime="@conflict.CreatedAt">@conflict.CreatedAt</time></td><td><span class="ts-mono">@(conflict.TableName ?? "—")</span><div class="ts-mono">@(conflict.RowKey?.GetRawText() ?? "—")</div></td><td class="ts-mono">@(conflict.ColumnName ?? (conflict.Loser.State == "superseded" ? "Row" : "Transaction"))</td>
@foreach(var write in new[]{conflict.Winner, conflict.Loser}){
<td><code>@write.DisplayValue</code><div class="ts-mono">@(write.Region ?? "—") · @(write.Node ?? "—")</div><div><code title="HLC">@(write.Hlc ?? "—")</code></div><details><summary><span class="ts-badge ts-badge-tone" data-tone="@(write.TransactionState == "reverted" ? "danger" : write.TransactionState == "confirmed" ? "success" : "neutral")">@(write.TransactionState ?? "No recorded write")</span></summary><dl class="ts-kv"><div><dt>Transaction</dt><dd><code>@(write.TransactionId ?? "—")</code></dd></div>@if(write.State == "superseded"){<div><dt>Write</dt><dd>superseded</dd></div>}</dl></details></td>
}
<td><details><summary>@conflict.Kind</summary><p>@conflict.Message</p>@if(conflict.Loser.State == "superseded"){<p>The greater column HLC wins: milliseconds, logical counter, then node ID in ordinal order. Other columns can still apply.</p>}else{<p>No changes from this transaction were committed.</p>}</details></td></tr>
}
</tbody></table></div>
@if(listing.NextBefore is { } next){<a class="ts-btn ts-btn-secondary ts-btn-sm" href="@conflicts.Path(Model.Database.Id, next)" data-on:click="evt.preventDefault(); history.replaceState(null, '', el.href); @@get(el.href, {retryMaxCount: 0})">Older conflicts</a>}
@if(conflicts.Before.Length > 0){<a class="ts-link" href="@conflicts.Path(Model.Database.Id)" data-on:click="evt.preventDefault(); history.replaceState(null, '', el.href); @@get(el.href, {retryMaxCount: 0})">Newest conflicts</a>}
}
</div>
}
