@inherits RazorSlice<TerraScale.Dashboard.Features.Databases.DatabaseDetailPage>
@using TerraScale.Dashboard.Features.Databases
<section class="ts-card ts-card-boxed" id="replication" aria-labelledby="replication-title">
<header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="replication-title">Replication</h2></div></header>
<div class="ts-card-body">
<span hidden data-on-interval__duration.10s="@("@get('" + DatabaseService.Path(Model.Database.Id, "replication") + "')")"></span>
@if(Model.Replication is { Error.Length: > 0 } failed){<div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-body">@failed.Error</p></div>}
@if(Model.Replication?.Status is { } replication){
@if(replication.Replicas.Count == 0){<div class="ts-empty" role="status"><p class="ts-empty-title">This database runs in one region.</p>@if(Model.CanPlace){<div class="ts-empty-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="#regions">Add a region</a></div>}</div>}
else{<div class="ts-table-wrap" role="region" aria-label="Region sync" tabindex="0"><table class="ts-table"><thead><tr><th scope="col">Region</th><th scope="col" class="ts-num">Lag</th><th scope="col">Last synced</th><th scope="col">Last verified</th></tr></thead><tbody>
@foreach(var row in DatabaseReplication.Rows(replication)){<tr data-region="@row.Region"><th scope="row">@DatabasesPage.RegionDisplay(row.Region)</th>@if(row.Observation is { } observed){<td class="ts-num">@TerraScale.Dashboard.Common.Formatting.MetricFormat.Latency(observed.LagMs)</td><td>@if(observed.LastPulledAt is { } pulled){<time datetime="@pulled.ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@DatabaseReplication.Timestamp(pulled)</time>}else{<span>—</span>}</td><td>@if(observed.LastVerified is { } verified){<time datetime="@verified.ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@DatabaseReplication.Timestamp(verified)</time>}else{<span>not yet verified</span>}</td>}else{<td class="ts-num">—</td><td>—</td><td>—</td>}</tr>}
</tbody></table></div>}
}
</div></section>
