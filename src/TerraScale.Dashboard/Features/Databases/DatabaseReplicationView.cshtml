@inherits RazorSlice<TerraScale.Dashboard.Features.Databases.DatabaseReplicationModel>
@using System.Globalization
@using TerraScale.Dashboard.Common.Charts
@inject AssetUrls Assets
@using TerraScale.Dashboard.Common.Formatting
<section class="ts-card ts-card-boxed" id="replication" aria-labelledby="replication-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="replication-title">Replication</h2><p class="ts-card-description">Per database and region · @Model.Range · TerraBase replication_bytes meter</p></div></header><div class="ts-card-body">
@if(Model.Reading.Error.Length > 0){<div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Replication unavailable</p><p class="ts-alert-body">@Model.Reading.Error</p></div>}
else if(Model.Reading.Regions.Count == 0 && Model.Reading.Pairs.Count == 0){<div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("Network", 16)</span><p class="ts-empty-title">@Model.Reading.Empty</p></div>}
else{
<dl class="ts-stats" aria-label="Replication totals">@foreach(var stat in new[]{("Replicated ops",ChartGeometry.Compact(Model.Reading.Operations),"Across database regions",Model.Reading.Operations.ToString("N0",CultureInfo.InvariantCulture)),("Replication bandwidth", MetricFormat.Bytes(Model.Reading.WireBytes), "Wire bytes counted once per directed pair", ""), ("Replication sent",MetricFormat.Bytes(Model.Reading.SentBytes),"Metered separately from client bandwidth",""),("Replication received",MetricFormat.Bytes(Model.Reading.ReceivedBytes),"Received at destination regions",""),("Worst lag",MetricFormat.Latency(Model.Reading.WorstLagMs),"Current maximum across regions","")}){<div class="ts-stat"><dt class="ts-stat-label">@stat.Item1</dt><dd class="ts-stat-value" title="@(stat.Item4.Length > 0 ? stat.Item4 : null)">@stat.Item2</dd><dd class="ts-stat-detail">@stat.Item3</dd></div>}</dl>
@if(Model.Reading.Pairs.Count == 0){<div class="ts-empty" role="status"><p class="ts-empty-title">No replication bandwidth samples for this period.</p></div>}
@if(Model.Reading.Regions.Count > 0){<div class="ts-table-wrap" role="region" aria-label="Replication health table" tabindex="0"><table class="ts-table"><caption class="ts-sr-only">Replication health per database and region</caption><thead><tr><th>Database</th><th>Region</th><th>Health</th><th class="ts-num">Replicated ops</th><th class="ts-num">Lag</th><th class="ts-num">Divergence</th><th class="ts-num">Convergence time</th><th>Last applied</th></tr></thead><tbody>@foreach(var row in Model.Reading.Regions.OrderBy(item => Regions.Rank(item.Region))){<tr><th scope="row">@row.DatabaseName</th><td>@{var code = row.Region.ToLowerInvariant();var country = Regions.Country(code);}<span class="ts-db-region">@if(country.Length > 0){<img class="ts-db-region-flag" src="@Assets.Url("flags/" + country + ".svg")" alt="" aria-hidden="true" />}<span class="ts-mono">@code</span></span></td><td><span class="ts-badge ts-badge-@TerraScale.Dashboard.Features.Databases.DatabaseReplicationModel.Tone(row.Status)">@row.Status</span></td><td class="ts-num" title="@row.ReplicatedOps.ToString("N0", CultureInfo.InvariantCulture)">@ChartGeometry.Compact(row.ReplicatedOps)</td><td class="ts-num">@MetricFormat.Latency(row.LagMs)</td><td class="ts-num">@(row.Divergence?.ToString(CultureInfo.InvariantCulture) ?? "Not reported")</td><td class="ts-num">@MetricFormat.Latency(row.ConvergenceMs)</td><td>@(row.LastApplied?.UtcDateTime.ToString("MMM d, yyyy HH:mm:ss 'UTC'",CultureInfo.InvariantCulture) ?? "Not reported")</td></tr>}</tbody></table></div>}
@if(Model.Reading.Pairs.Count > 0){<div class="ts-table-wrap" role="region" aria-label="Replication bandwidth table" tabindex="0"><table class="ts-table"><caption class="ts-sr-only">Replication bandwidth per ordered region pair</caption><thead><tr><th>Database</th><th>Region pair</th><th class="ts-num">Sent</th><th class="ts-num">Received</th><th class="ts-num">Wire bytes</th></tr></thead><tbody>@foreach(var row in Model.Reading.Pairs.OrderBy(item => Regions.Rank(item.FromRegion)).ThenBy(item => Regions.Rank(item.ToRegion))){<tr><th scope="row">@row.DatabaseName</th><td><span class="ts-db-chips">@for(var end = 0; end < 2; end++){var code = (end == 0 ? row.FromRegion : row.ToRegion).ToLowerInvariant();var country = Regions.Country(code);@if(end == 1){<span aria-hidden="true">→</span>}<span class="ts-db-region">@if(country.Length > 0){<img class="ts-db-region-flag" src="@Assets.Url("flags/" + country + ".svg")" alt="" aria-hidden="true" />}<span class="ts-mono">@code</span></span>}</span></td><td class="ts-num">@MetricFormat.Bytes(row.SentBytes)</td><td class="ts-num">@MetricFormat.Bytes(row.ReceivedBytes)</td><td class="ts-num">@MetricFormat.Bytes(row.WireBytes)</td></tr>}</tbody></table></div>}
}
<a class="ts-link" href="@Model.AnalyticsPath">View analytics →</a>
</div></section>
