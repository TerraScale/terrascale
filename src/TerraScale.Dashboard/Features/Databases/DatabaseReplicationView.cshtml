@inherits RazorSlice<TerraScale.Dashboard.Features.Databases.DatabaseDetailPage>
@using TerraScale.Dashboard.Features.Databases
@using TerraScale.Dashboard.Common.Live
<section class="ts-card ts-card-boxed" id="replication" aria-labelledby="replication-title" @LiveView.Initializer(Model.Shell.Context, DatabaseService.Path(Model.Database.Id, "replication/live"))>
<header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="replication-title">Region sync</h2></div></header>
<div class="ts-card-body">
@if(Model.Replication is { Error.Length: > 0 } failed){<div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-body">@failed.Error</p></div>}
@if(Model.Replication?.Status is { } replication){
@if(replication.Regions.Count <= 1){<div class="ts-empty" role="status"><p class="ts-empty-title">This database runs in one region.</p>@if(Model.CanPlace){<div class="ts-empty-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="#regions">Add a region</a></div>}</div>}
else{<div class="ts-table-wrap" role="region" aria-label="Region sync" tabindex="0"><table class="ts-table"><thead><tr><th scope="col">Region</th><th scope="col" class="ts-num">Lag</th><th scope="col">Status</th></tr></thead><tbody>
@foreach(var row in DatabaseReplication.Rows(replication)){<tr data-region="@row.Region"><th scope="row">@DatabasesPage.RegionDisplay(row.Region)</th><td class="ts-num">@TerraScale.Dashboard.Common.Formatting.MetricFormat.Latency(row.LagMs)</td><td>@(row.Healthy ? "In sync" : "Catching up")</td></tr>}
</tbody></table></div>}
}
</div></section>
