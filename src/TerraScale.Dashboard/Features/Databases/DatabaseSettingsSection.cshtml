@inherits RazorSlice<TerraScale.Dashboard.Features.Databases.DatabaseSettingsPage>
@using System.Globalization
<main class="ts-page ts-db-detail" id="database-settings" data-database-id="@Model.Database.Id" data-title="@(Model.Shell.Title + " · TerraScale")" data-init="document.title = el.dataset.title">
@(await RenderPartialAsync<TerraScale.Dashboard.Common.Databases.DatabaseFrame,DatabaseFrameModel>(new(Model.Database, "settings")))
<header class="ts-page-header"><h1 class="ts-page-title">Settings</h1><div class="ts-page-actions"></div></header>
<div class="ts-columns"><div class="ts-columns-main">
<section class="ts-card ts-card-boxed ts-card-flush" id="database-general" aria-labelledby="database-settings-title">
<header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="database-settings-title">General</h2></div></header>
@if(Model.CanRename){
<form method="post" action="/api/v1/dashboard/databases/rename" class="ts-form" aria-label="Rename database" aria-describedby="rename-warning" data-on:submit="evt.preventDefault(); @@post(el.action, {contentType: 'form'})">
<input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />
<div class="ts-card-body ts-stack-lg">
@if(Model.Renamed){<div class="ts-alert ts-alert-success" role="status"><p class="ts-alert-title">Database renamed to @Model.Database.Name</p></div>}
@if(Model.Error.Length > 0){<div class="ts-alert ts-alert-danger" role="alert" id="rename-error"><p class="ts-alert-body">@Model.Error</p></div>}
<div class="ts-alert ts-alert-warning" id="rename-warning"><p class="ts-alert-title">Update name-based connection strings</p><p class="ts-alert-body">The previous name stops resolving. There is no alias or redirect. Conflicting requests accepted in different regions can change the final name.</p></div>
<div class="ts-field"><label class="ts-label" for="rename-name">Name</label><input class="ts-input" id="rename-name" name="name" value="@Model.Name" pattern="@(@"[\s]*" + DatabaseService.NameInputPattern + @"[\s]*")" required autocomplete="off" spellcheck="false" placeholder="orders" title="@DatabaseService.NameHint" /></div>
<div class="ts-field"><label class="ts-label" for="rename-confirm">Type @Model.Database.Name to confirm</label><input class="ts-input" id="rename-confirm" name="confirmName" value="@Model.Confirmation" required autocomplete="off" spellcheck="false" maxlength="63" /></div>
</div><footer class="ts-card-foot"><button class="ts-btn ts-btn-ghost" type="reset">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Save</button></footer>
</form>
}else{<div class="ts-card-body"><dl class="ts-kv"><div><dt>Name</dt><dd>@Model.Database.Name</dd></div></dl></div>}
</section>
<section class="ts-card ts-card-boxed ts-card-flush" id="database-expiry" aria-labelledby="database-expiry-title" data-signals="@("{_expiry: '" + Model.ExpiryPreset + "', _ttlHours: '" + Model.TtlHours + "'}")">
<header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="database-expiry-title">Database expiry</h2></div></header>
@if(Model.CanManage){
<form method="post" action="/v1/databases/ttl" class="ts-form" data-on:submit="evt.preventDefault(); @@post(el.action, {contentType: 'form'})">
<input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="action" value="@(Model.TtlHours.Length == 0 ? "clear" : "set")" data-attr:value="$_expiry === '' ? 'clear' : 'set'" />
<div class="ts-card-body ts-stack-lg">
@if(Model.ExpiryError.Length > 0){<div class="ts-alert ts-alert-danger" role="alert" id="expiry-error"><p class="ts-alert-body">@Model.ExpiryError</p></div>}
@if(Model.ExpirySaved){<div class="ts-alert ts-alert-success" id="expiry-saved" role="status"><p class="ts-alert-body">Database expiry saved.</p></div>}
<fieldset class="ts-chips"><legend class="ts-label">Delete database after</legend>
@foreach(var option in DatabaseSettingsPage.ExpiryOptions){<label class="ts-chip"><input type="radio" name="expiryPreset" value="@option.Hours" checked="@(Model.ExpiryPreset == option.Hours)" data-bind:_expiry data-on:change="$_ttlHours = el.value === 'custom' ? $_ttlHours : el.value" /><span>@option.Label</span></label>}
</fieldset>
<div class="ts-field" data-show="$_expiry === 'custom'"><label class="ts-label" for="database-ttl">Hours</label><input class="ts-input" id="database-ttl" name="ttlHours" type="number" value="@Model.TtlHours" data-bind:_ttlHours min="@DatabaseTtl.MinimumHours" max="8760" step="any" data-attr:required="$_expiry === 'custom'" data-attr:disabled="$_expiry === ''" /></div>
<dl class="ts-kv"><div><dt>Expires</dt><dd id="expiry-current">@if(Model.Database.ExpiresAt is { } expiry){<time datetime="@expiry.ToString("O",CultureInfo.InvariantCulture)">@expiry.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",CultureInfo.InvariantCulture)</time>}else{<span>Never</span>}</dd></div></dl>
</div><footer class="ts-card-foot"><button class="ts-btn ts-btn-primary" type="submit">Save expiry</button></footer></form>
}else{<div class="ts-card-body"><dl class="ts-kv"><div><dt>Expires</dt><dd>@(Model.Database.ExpiresAt?.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",CultureInfo.InvariantCulture) ?? "Never")</dd></div></dl></div>}
</section>
</div><aside class="ts-columns-side">
<section class="ts-card ts-card-boxed" aria-labelledby="database-details-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="database-details-title">Details</h2></div></header><div class="ts-card-body">
<dl class="ts-kv"><div><dt>Database ID</dt><dd><div class="ts-stack-sm" data-signals="{_idCopied: ''}"><code id="settings-database-id">@Model.Database.Id</code><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" aria-label="Copy database ID" data-on:click="navigator.clipboard.writeText(document.getElementById('settings-database-id').textContent).then(() => $_idCopied = 'Copied', () => $_idCopied = 'Copy failed')">@Icons.Render("Copy",14)<span>Copy</span></button><span role="status" data-text="$_idCopied"></span></div></dd></div>
<div><dt>Created</dt><dd><time datetime="@Model.Database.CreatedAt.ToString("O",CultureInfo.InvariantCulture)">@Model.Database.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",CultureInfo.InvariantCulture)</time></dd></div>
<div><dt>Regions</dt><dd>@string.Join(", ", DatabaseService.ServingRegions(Model.Database).Select(DatabasesPage.RegionDisplay))</dd></div><div><dt>Status</dt><dd>@Model.Database.Status</dd></div></dl>
</div></section>
</aside></div></main>
