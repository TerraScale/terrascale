@inherits RazorSlice<TerraScale.Dashboard.Features.Databases.DatabaseSettingsPage>
@implements IUsesLayout<TerraScale.Dashboard.Shared.UI.Slices.ShellDocument, ShellModel>
<main class="ts-page ts-db-detail" data-database-id="@Model.Database.Id">
@(await RenderPartialAsync<TerraScale.Dashboard.Shared.Databases.DatabaseFrame,DatabaseFrameModel>(new(Model.Database, "settings")))
<section class="ts-card ts-card-boxed" aria-labelledby="database-settings-title">
<header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="database-settings-title">Settings</h2><p class="ts-card-description">Rename this database</p></div></header>
<div class="ts-card-body ts-stack-lg">
@if(Model.Renamed){<div class="ts-alert ts-alert-success" role="status"><p class="ts-alert-title">Database renamed to @Model.Database.Name</p><p class="ts-alert-body">Update your applications to use the new database name. <a class="ts-link" href="@(DatabaseService.Path(Model.Database.Id) + "#connect")">View connection details</a>.</p></div>}
@if(Model.Error.Length > 0){<div class="ts-alert ts-alert-danger" role="alert" id="rename-error"><p class="ts-alert-body">@Model.Error</p></div>}
<dl class="ts-kv"><div><dt>Database ID</dt><dd class="ts-mono">@Model.Database.Id</dd></div><div><dt>Current name</dt><dd class="ts-mono">@Model.Database.Name</dd></div></dl>
<div class="ts-alert ts-alert-warning" id="rename-warning"><p class="ts-alert-title">Connection strings change immediately</p><p class="ts-alert-body">The previous name immediately stops resolving. There is no alias or redirect. Update database names in your connection strings and application configuration after renaming. The database ID, data, API keys and placement stay the same.</p></div>
@if(Model.Shell.Context.CanManage && Model.Database.Status == "ready" && !PlatformDatabases.IsPlatform(Model.Shell.Context.Organization?.Id)){
<form method="post" action="/api/v1/dashboard/databases/rename" class="ts-form" aria-label="Rename database" aria-describedby="rename-warning" data-signals="{_renaming: false}" data-on:submit="$_renaming ? evt.preventDefault() : ($_renaming = true)" data-on:pageshow__window="$_renaming = false" data-attr:aria-busy="$_renaming">
<input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />
<div class="ts-field"><label class="ts-label" for="rename-name">New database name</label><input class="ts-input" id="rename-name" name="name" value="@Model.Name" pattern="(?!(con|prn|aux|nul|com[0-9]|lpt[0-9])$)[a-z][a-z0-9_\-]{0,62}" maxlength="63" required autocomplete="off" spellcheck="false" aria-describedby="rename-name-hint" data-attr:readonly="$_renaming" /><p class="ts-hint" id="rename-name-hint">Start with a lowercase letter, then lowercase letters, digits, underscores or hyphens; up to 63 characters. Device names such as con, nul, com0–com9 and lpt0–lpt9 are reserved. Must be unique in this project.</p></div>
<div class="ts-field"><label class="ts-label" for="rename-confirm">Type @Model.Database.Name to confirm</label><input class="ts-input" id="rename-confirm" name="confirmName" value="@Model.Confirmation" required autocomplete="off" spellcheck="false" data-attr:readonly="$_renaming" /></div>
<div class="ts-row"><button class="ts-btn ts-btn-primary" type="submit" data-attr:disabled="$_renaming" data-text="$_renaming ? 'Renaming…' : 'Rename database'">Rename database</button><a class="ts-btn ts-btn-ghost" href="@DatabaseService.Path(Model.Database.Id)">Cancel</a></div>
<p class="ts-meta" role="status" data-text="$_renaming ? 'Renaming database. Please wait for the result.' : ''"></p>
</form>
}else{<p class="ts-meta" role="status">Renaming requires organization management access and a ready customer database.</p>}
</div></section></main>
@functions { public ShellModel LayoutModel => Model.Shell; }
