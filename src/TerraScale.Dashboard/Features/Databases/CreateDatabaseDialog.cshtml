@using TerraScale.Dashboard.Common.UI.Slices
@inherits RazorSlice<DatabasesPage>
@using TerraScale.Dashboard.Features.Databases
@if(Model.CanProvision){<dialog id="create-database" class="ts-dialog ts-db-create-dialog" closedby="any" aria-labelledby="create-database-title" data-preserve-attr="open" data-create-succeeded="@(Model.CreatedName.Length > 0 ? "true" : "false")" data-init="@(Model.OpenCreate ? "el.showModal()" : "void 0")"><div class="ts-dialog-content" data-region-surface><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="create-database-title">New database</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="create-database">@Icons.Render("X",18)</button></header>
<form method="post" action="@("/api/v1/dashboard/databases?range=" + Model.Range + "&q=" + Uri.EscapeDataString(Model.Search))" data-on:submit="evt.preventDefault(); @@post(el.getAttribute('action'), {contentType:'form'}).then(() => { const dialog = el.closest('dialog'); if (dialog.dataset.createSucceeded === 'true') dialog.close() })" data-indicator:_creating class="ts-db-create-form" data-submit-once data-signals="{_nameInvalid: false, _creating: false}" data-class:ts-db-creating="$_creating" data-attr:inert="$_creating"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
@if(Model.Error.Length > 0 && Model.OpenCreate){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-title">Database not created</p><p class="ts-alert-body">@Model.Error</p></div>}
<div class="ts-db-create-top"><div class="ts-field"><label class="ts-label" for="database-name">Database name</label><input class="ts-input ts-input-lg" id="database-name" name="name" value="@Model.Name" pattern="@DatabaseService.NameInputPattern" maxlength="63" required autofocus autocomplete="off" spellcheck="false" placeholder="orders" title="@DatabaseService.NameHint" aria-describedby="database-name-error" data-on:change="$_nameInvalid = !el.validity.valid" data-on:input="$_nameInvalid &amp;&amp; ($_nameInvalid = !el.validity.valid)" data-attr:aria-invalid="$_nameInvalid ? 'true' : 'false'" /><p class="ts-field-error" id="database-name-error" hidden data-attr:hidden="!$_nameInvalid">@DatabaseService.NameHint</p></div>
<div class="ts-db-create-headline" aria-hidden="true"><span class="ts-db-create-mark">@Icons.Render("Database",20)</span><p class="ts-db-create-state">Creating database</p></div></div>
@(await RenderPartialAsync<RegionMap, RegionMapModel>(Model.RegionMap))
@if(Model.RegionsError.Length > 0){<p class="ts-field-error" role="alert">@Model.RegionsError</p>}
<div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="create-database">Cancel</button><button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">@Icons.Render("Plus",16)<span>Create database</span></button></div></form><p class="ts-sr-only" role="status" data-text="$_creating ? 'Creating database.' : ''"></p></div></dialog>}
