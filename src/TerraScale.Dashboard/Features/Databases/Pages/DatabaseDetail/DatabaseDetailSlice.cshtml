@inherits RazorSlice<DatabaseDetailPageModel>
@{
    var shell = Model.Shell;
    var db = Model.Database;
    var requestedTab = HttpContext?.Request.Query["tab"].ToString();
    var activeTab = requestedTab is "placement" or "backups" or "branches" or "import" ? requestedTab : "overview";
    string TabHref(string tab) => $"/databases/{db.Id}?tab={tab}";
}
@ShellHtml.Top(shell)
<div class="ts-page ts-db-detail-page">
    <div class="ts-toolbar">
        <nav class="ts-tabs" aria-label="Database detail sections">
            @foreach (var tab in new[] { (Id: "overview", Label: "Overview"), (Id: "placement", Label: "Placement"), (Id: "backups", Label: "Backups"), (Id: "branches", Label: "Branches"), (Id: "import", Label: "Import and export") })
            {
                var icon = tab.Id == "overview" ? Icons.BarChart3(16) : tab.Id == "placement" ? Icons.MapPin(16) : tab.Id == "backups" ? Icons.Archive(16) : tab.Id == "branches" ? Icons.GitBranch(16) : Icons.Upload(16);
                <a class="ts-tab" href="@TabHref(tab.Id)" aria-current="@(activeTab == tab.Id ? "page" : null)" aria-selected="@(activeTab == tab.Id ? "true" : "false")">@icon @tab.Label</a>
            }
        </nav>
    </div>

    <section class="ts-section ts-db-detail-identity" aria-labelledby="database-title">
        <div class="ts-section-head">
            <div>
                <h1 class="ts-panel-title" id="database-title">@db.Name</h1>
                <p class="ts-meta">Database lifecycle and persisted placement</p>
            </div>
            <a class="ts-btn ts-btn-ghost" href="/databases" aria-label="Back to databases">@Icons.ArrowLeft(16) Back to databases</a>
        </div>
        <p class="ts-db-id-line">@Icons.Database(14) <span class="ts-mono">@db.Id</span></p>
    </section>

    @if (activeTab is "overview" or "placement")
    {
        <section class="ts-section ts-db-detail-section" aria-labelledby="placement-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="placement-title">Placement and latency</h2>
                    <p class="ts-meta">Placement is inherited from the project and cannot be widened later</p>
                </div>
                <span class="ts-db-detail-section-icon" aria-hidden="true">@Icons.LockKeyhole(18)</span>
            </div>
            <div class="ts-db-detail-body">
                <div class="ts-db-summary-grid">
                    <div class="ts-summary-field">
                        <span class="ts-summary-label">Database status</span>
                        <span class="ts-summary-value">@db.Status</span>
                    </div>
                    @if (db.Provisioning)
                    {
                        <div class="ts-summary-field">
                            <span class="ts-summary-label">Provisioning operation</span>
                            <span class="ts-summary-value ts-mono">@db.OperationId</span>
                        </div>
                    }
                    <div class="ts-summary-field">
                        <span class="ts-summary-label">Placement lock</span>
                        <span class="ts-summary-value">@Model.PlacementLock</span>
                    </div>
                    <div class="ts-summary-field">
                        <span class="ts-summary-label">Placement status</span>
                        <span class="ts-summary-value">@Model.PlacementStatus</span>
                    </div>
                    <div class="ts-summary-field">
                        <span class="ts-summary-label">Generation</span>
                        <span class="ts-summary-value">@Model.PlacementGeneration</span>
                    </div>
                    <div class="ts-summary-field">
                        <span class="ts-summary-label">Replication</span>
                        <span class="ts-summary-value">@db.Replication</span>
                    </div>
                </div>
                <div class="ts-alert ts-alert-info" role="note">
                    <div class="ts-stack-xs">
                        <span class="ts-alert-title">@Icons.Info(16) Placement lock is immutable</span>
                        <span class="ts-alert-body">The selected regions and backup region are enforced by the TerraScale API for backups, restores, branches, and exports.</span>
                    </div>
                </div>
                <div class="ts-table-wrap ts-db-detail-table-wrap">
                    <table class="ts-table">
                        <thead>
                            <tr>
                                <th>Region</th>
                                <th>Estimated round trip</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Latency)
                            {
                                <tr>
                                    <td><span class="ts-icon-label">@Icons.Gauge(15) @DatabasesPageModel.RegionDisplay(row.Region)</span></td>
                                    <td><span class="ts-summary-value">@row.Estimate</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="ts-meta">Estimates captured @DashboardStore.FormatUtcDateTime(Model.LatencyCapturedAt) · Nearest region: @Model.NearestRegion.ToUpperInvariant()</p>
            </div>
        </section>
    }

    @if (activeTab == "backups")
    {
        <section class="ts-section ts-db-detail-section" aria-labelledby="backups-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="backups-title">Backups</h2>
                    <p class="ts-meta">Enable or disable scheduled backups for this database</p>
                </div>
                <span class="ts-db-detail-section-icon" aria-hidden="true">@Icons.Archive(18)</span>
            </div>
            <div class="ts-db-detail-body">
                <form class="ts-row-between ts-db-detail-setting" method="post" action="/api/v1/dashboard/databases/backup-policy">
                    <input type="hidden" name="databaseId" value="@db.Id" />
                    <input type="hidden" name="enabled" value="@(Model.BackupsEnabled ? "false" : "true")" />
                    <span class="ts-stack-xs">
                        <span class="ts-summary-value">Scheduled backups</span>
                        <span class="ts-meta">@(Model.BackupsEnabled ? "Backups run on the configured schedule." : "No scheduled backups run for this database.")</span>
                    </span>
                    <button type="submit" class="ts-switch" role="switch" aria-checked="@(Model.BackupsEnabled ? "true" : "false")" aria-label="Scheduled backups"></button>
                </form>
                @if (Model.BackupsEnabled)
                {
                    <p class="ts-meta">Schedule: <span class="ts-mono">@Model.BackupCron</span> · Retention: @Model.BackupRetentionDays days</p>
                }
            </div>
        </section>
    }

    @if (activeTab == "branches")
    {
        <section class="ts-section ts-db-detail-section" aria-labelledby="branches-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="branches-title">Branches</h2>
                    <p class="ts-meta">Cloud development and preview branches use an isolated database incarnation</p>
                </div>
                <span class="ts-db-detail-section-icon" aria-hidden="true">@Icons.GitBranch(18)</span>
            </div>
            <div class="ts-db-detail-body">
                <div class="ts-db-summary-grid">
                    <div class="ts-summary-field">
                        <span class="ts-summary-label">Admission</span>
                        <span class="ts-summary-value">local</span>
                    </div>
                    <div class="ts-summary-field">
                        <span class="ts-summary-label">Physical clone</span>
                        <span class="ts-summary-value">@(Model.BranchPhysicalClone ? "Available" : "Unavailable")</span>
                    </div>
                    <div class="ts-summary-field">
                        <span class="ts-summary-label">Promotion</span>
                        <span class="ts-summary-value">@(Model.BranchPromotion ? "Available" : "Unavailable")</span>
                    </div>
                    <div class="ts-summary-field">
                        <span class="ts-summary-label">Merge</span>
                        <span class="ts-summary-value">@(Model.BranchMerge ? "Available" : "Unavailable")</span>
                    </div>
                </div>
                <p class="ts-muted ts-ui">The injected test adapter provides project-scoped database branches.</p>
                @if (Model.BranchRequested)
                {
                    <div class="ts-alert ts-alert-success" role="status">
                        <div class="ts-stack-xs">
                            <span class="ts-alert-title">@Icons.CircleCheckBig(16) Branch request accepted</span>
                            <span class="ts-alert-body">The branch operation is running in TerraBase.</span>
                        </div>
                    </div>
                }
                <div class="ts-row">
                    <form method="post" action="/api/v1/dashboard/databases/branch">
                        <input type="hidden" name="databaseId" value="@db.Id" />
                        <button type="submit" class="ts-btn ts-btn-secondary ts-btn-lg" @(Model.BranchPhysicalClone ? "" : "disabled")>
                            @Icons.GitBranch(16)
                            <span>Create preview branch</span>
                        </button>
                    </form>
                    <button type="button" class="ts-btn ts-btn-secondary ts-btn-lg" disabled>
                        @Icons.GitBranch(16)
                        <span>View diff (contract unavailable)</span>
                    </button>
                </div>
            </div>
        </section>
    }

    @if (activeTab == "import")
    {
        <section class="ts-section ts-db-detail-section" aria-labelledby="import-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="import-title">Import and export</h2>
                    <p class="ts-meta">Lossless JSONL and CSV controls will appear when the SDK contract is published</p>
                </div>
                <span class="ts-icon-label" aria-hidden="true">@Icons.Upload(16) @Icons.Download(16)</span>
            </div>
            <div class="ts-db-detail-body">
                <div class="ts-alert ts-alert-info" role="note">
                    <div class="ts-stack-xs">
                        <span class="ts-alert-title">@Icons.Info(16) No local import or export</span>
                        <span class="ts-alert-body">The published TerraScale SDK does not currently expose database import or lossless export operations. These controls stay disabled so data cannot be silently transformed or stored in the Worker.</span>
                    </div>
                </div>
                <div class="ts-row">
                    <button type="button" class="ts-btn ts-btn-secondary ts-btn-lg" disabled>
                        @Icons.Upload(16)
                        <span>Import JSONL / CSV</span>
                    </button>
                    <button type="button" class="ts-btn ts-btn-secondary ts-btn-lg" disabled>
                        @Icons.Download(16)
                        <span>Export lossless JSONL</span>
                    </button>
                </div>
            </div>
        </section>
    }
</div>
@ShellHtml.Bottom(shell)
