@inherits RazorSlice<TerraScale.Dashboard.Features.Databases.DatabaseReplicationModel>
@using TerraScale.Dashboard.Features.Databases
@using TerraScale.Dashboard.Features.Home
@using System.Globalization
@inject AssetUrls Assets
@using TerraScale.Dashboard.Common.Formatting
@{
    var replicas = Model.Replicas;
    var database = Model.Database!;
    var home = database.Region;
    var mapped = replicas.Where(row => DatabaseReplicationModel.Hubs.ContainsKey(row.Region)).ToArray();
}
<section class="ts-card ts-card-boxed" id="topology" aria-labelledby="topology-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="topology-title">Replication topology</h2><p class="ts-card-description">@database.Name replicates from its home region <span class="ts-mono">@home.ToLowerInvariant()</span> to every replica region. Labels show current lag reported by TerraBase.</p></div></header>
@if(replicas.Count == 0){<div class="ts-empty" role="status"><p class="ts-empty-title">No replication measurements for this database yet.</p><p class="ts-empty-detail">The topology appears when TerraBase reports replication for its regions.</p></div>}
else{<div class="ts-db-topology"><div class="ts-region-map ts-analytics-map" aria-hidden="true"><img class="ts-region-map-image" src="@Assets.Url("brand/region-map.svg")" alt="" loading="lazy" decoding="async" />
@if(DatabaseReplicationModel.Hubs.ContainsKey(home)){<svg class="ts-region-overlay" viewBox="0 0 136 80" preserveAspectRatio="xMidYMid meet">@foreach(var row in mapped.Where(row => !row.Region.Equals(home, StringComparison.OrdinalIgnoreCase))){<path class="ts-region-arc" d="@Model.Arc(row.Region)" />}</svg>}
@foreach(var row in mapped){<span class="ts-region-node" data-region="@row.Region.ToUpperInvariant()">@if(Regions.Country(row.Region) is { Length: > 0 } flag){<img class="ts-region-node-flag" src="@Assets.Url("flags/" + flag + ".svg")" alt="" />}<span class="ts-region-node-core"></span><span class="ts-region-node-label"><strong>@Regions.Name(row.Region)</strong>@MetricFormat.Latency(row.LagMs)</span></span>}
</div>
<ul class="ts-stack" aria-label="Replica regions">@foreach(var row in replicas){<li class="ts-card ts-card-boxed"><div class="ts-db-region">@if(Regions.Country(row.Region) is { Length: > 0 } flag){<img class="ts-db-region-flag" src="@Assets.Url("flags/" + flag + ".svg")" alt="" aria-hidden="true" />}<strong>@Regions.Name(row.Region)</strong><span class="ts-mono">@row.Region.ToLowerInvariant()</span>@if(row.Region.Equals(home, StringComparison.OrdinalIgnoreCase)){<span class="ts-badge ts-badge-neutral">Home</span>}<span class="ts-badge ts-badge-@DatabaseReplicationModel.Tone(row.Status)">@row.Status</span></div><dl class="ts-kv"><dt>Lag</dt><dd>@MetricFormat.Latency(row.LagMs)</dd><dt>Worst p95 latency (@Model.Range)</dt><dd>@MetricFormat.Latency(Model.P95(row.Region))</dd></dl></li>}</ul></div>}
</section>
