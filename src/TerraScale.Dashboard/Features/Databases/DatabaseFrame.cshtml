@inherits RazorSlice<TerraScale.Dashboard.Features.Databases.DatabaseFrameModel>
@using TerraScale.Dashboard.Features.Databases
<header class="ts-db-head"><nav class="ts-breadcrumb" aria-label="Breadcrumb"><a href="/databases">Databases</a><span aria-hidden="true">/</span><span aria-current="page">@Model.Database.Name</span></nav><div class="ts-db-identity"><span class="ts-db-icon ts-db-icon-lg" aria-hidden="true">@Icons.Render("Database",24)</span><h1 class="ts-db-title">@Model.Database.Name</h1><span class="ts-badge" data-state="@DatabasesPage.State(Model.Database.Status)"><span class="ts-dot" aria-hidden="true"></span>@Model.Database.Status</span><span class="ts-db-chips">@foreach(var region in DatabaseService.Regions(Model.Database)){<span class="ts-db-chip">@DatabasesPage.RegionDisplay(region)</span>}</span></div></header>
<nav class="ts-tabs" aria-label="Database sections">@foreach(var tab in DatabaseFrameModel.Tabs){<a class="ts-tab" href="@DatabaseService.Path(Model.Database.Id, tab.Key, tab.Key is "documents" or "sql" or "schema" or "indexes" ? Model.Collection : "")" aria-current="@(Model.Tab == tab.Key ? "page" : null)"><span>@tab.Label</span></a>}</nav>
