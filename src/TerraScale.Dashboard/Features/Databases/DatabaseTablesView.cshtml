@inherits RazorSlice<DatabaseDetailPage>
@using System.Globalization
@using System.Text.Json
@using TerraScale.Dashboard.Features.Databases
@using TerraScale.Dashboard.Common.Charts
@using TerraScale.Dashboard.Common.Live
<div id="tables-browser" @LiveView.Initializer(Model.Context, DatabaseService.Path(Model.Database.Id, "tables/live") + "?table=" + Uri.EscapeDataString(Model.Table.Length > 0 ? Model.Table : HttpContext!.Request.Query["table"].ToString()))>
@if(Model.Tables is { } listing){
@if(listing.Tables.Count == 0){<section class="ts-card" id="tables"><div class="ts-card-body"><div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("Table", 16)</span><p class="ts-empty-title">No tables yet.</p><div class="ts-empty-actions">@if(Model.Context.CanWriteProjectData){<button class="ts-btn ts-btn-primary ts-btn-sm" type="button" command="show-modal" commandfor="create-table">@Icons.Render("Plus",16)<span>New table</span></button>}<a class="ts-btn ts-btn-secondary ts-btn-sm" href="@DatabaseService.Path(Model.Database.Id, "sql")">@Icons.Render("Play",16)<span>Open SQL editor</span></a></div></div></div></section>}
else{
var shown = listing.Tables.FirstOrDefault(table => table.Name == Model.Table);
var sqlPath = DatabaseService.Path(Model.Database.Id, "sql");
var tablesPath = DatabaseService.Path(Model.Database.Id, "tables");
<div class="ts-studio" id="tables">
<aside class="ts-studio-rail" aria-label="Database explorer">
<nav class="ts-studio-rail-section" aria-label="Tables"><div class="ts-studio-rail-head"><h2 class="ts-studio-rail-title">Tables</h2>@if(Model.Context.CanWriteProjectData){<button class="ts-icon-btn ts-studio-rail-add" type="button" command="show-modal" commandfor="create-table" aria-label="New table" title="New table">@Icons.Render("Plus",14)</button>}else{<span class="ts-tip" data-tip="Write access is required to change data or schema. Your role can run read-only statements."><button class="ts-icon-btn ts-studio-rail-add" type="button" disabled aria-label="New table" title="Write access is required to change data or schema. Your role can run read-only statements.">@Icons.Render("Plus",14)</button></span>}</div>
<ul class="ts-studio-rail-list">@foreach(var table in listing.Tables){<li data-table="@table.Name"><a class="ts-studio-rail-link" href="@Model.TablePath(table.Name)" aria-current="@(Model.Table == table.Name ? "page" : null)"><span class="ts-studio-rail-icon" aria-hidden="true">@Icons.Render("Table",14)</span><span class="ts-truncate ts-mono">@table.Name</span> <span class="ts-studio-rail-count" title="@table.Rows.ToString("N0", CultureInfo.InvariantCulture)">@ChartGeometry.Compact(table.Rows)<span class="ts-sr-only">@(table.Rows == 1 ? " row" : " rows")</span></span></a></li>
@if(ReferenceEquals(table, shown)){<li class="ts-studio-rail-columns"><ul aria-label="@(table.Name + " columns")">@foreach(var column in table.Schema){<li><a class="ts-studio-column" href="@(sqlPath + "?queryTable=" + Uri.EscapeDataString(table.Name) + "&column=" + Uri.EscapeDataString(column.Name))"><span class="ts-truncate">@column.Name</span>@if(column.PrimaryKey > 0){<span class="ts-studio-column-key" aria-hidden="true">@Icons.Render("KeyRound",12)</span><span class="ts-sr-only">, primary key</span>}<span class="ts-studio-column-type" title="@column.Decltype">@DatabaseTables.CompactType(column.Decltype)</span></a></li>}</ul></li>}}</ul>
<form class="ts-studio-rail-select" method="get" action="@tablesPath"><label class="ts-sr-only" for="table-select">Table</label><select class="ts-select ts-input-sm ts-mono" id="table-select" name="table" data-on:change="el.form.requestSubmit()">@foreach(var table in listing.Tables){<option value="@table.Name" selected="@(table.Name == Model.Table)">@table.Name</option>}</select><noscript><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Open</button></noscript></form>@if(listing.Truncated){<p class="ts-meta" role="status">Showing the first 100 tables.</p>}</nav>
@if(Model.SavedQueries is { Count: > 0 } saved){<nav class="ts-studio-rail-section" aria-labelledby="tables-saved-queries-title"><div class="ts-studio-rail-head"><h2 class="ts-studio-rail-title" id="tables-saved-queries-title">Saved queries</h2></div><ul class="ts-studio-rail-list">@foreach(var query in saved){<li><a class="ts-studio-rail-link" href="@(sqlPath + "?savedQueryId=" + Uri.EscapeDataString(query.Id))"><span class="ts-studio-rail-icon" aria-hidden="true">@Icons.Render("ScrollText",14)</span><span class="ts-truncate">@query.Name</span></a></li>}</ul></nav>}
</aside>
@if(shown is not null){
string[] primary = [.. shown.Schema.Where(column => column.PrimaryKey > 0).OrderBy(column => column.PrimaryKey).Select(column => column.Name)];
var editable = Model.Context.CanWriteProjectData && primary.Length > 0;
<section class="ts-studio-main" aria-labelledby="table-columns-title">
<div class="ts-studio-tabs" id="table-tabs" role="group" aria-label="Open tabs" data-ignore-morph data-tables-path="@tablesPath"><span class="ts-studio-tab-item"><a class="ts-studio-tab" href="@Model.TablePath(shown.Name)" aria-current="page" data-open-table="@shown.Name"><span class="ts-studio-rail-icon" aria-hidden="true">@Icons.Render("Table",14)</span><span class="ts-truncate ts-mono">@shown.Name</span></a></span><a class="ts-studio-tab-add" href="@sqlPath" aria-label="New SQL query" title="New SQL query">@Icons.Render("Plus",14)</a></div>
<header class="ts-studio-bar"><h2 class="ts-sr-only" id="table-columns-title">@shown.Name</h2>
<label class="ts-sr-only" for="table-filter">Filter rows</label><input class="ts-input ts-input-sm ts-studio-filter" id="table-filter" type="search" placeholder="@("Filter " + shown.Name + "…")" autocomplete="off" spellcheck="false" data-ignore-morph />
<div class="ts-segmented" role="group" aria-label="View" data-ignore-morph><button class="ts-segment" type="button" data-table-view="data" aria-pressed="true">Data</button><button class="ts-segment" type="button" data-table-view="schema" aria-pressed="false">Schema</button></div>
<div class="ts-studio-actions">@if(Model.Context.CanWriteProjectData){<button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" command="show-modal" commandfor="insert-row">@Icons.Render("Plus",14)<span>Add row</span></button>}<a class="ts-btn ts-btn-secondary ts-btn-sm" href="@(sqlPath + "?queryTable=" + Uri.EscapeDataString(shown.Name))"><span>Open as SQL</span>@Icons.Render("ArrowUpRight",14)</a></div></header>
<div class="ts-studio-panel" id="table-rows" data-csrf="@Model.Shell.CsrfToken" data-database-id="@Model.Database.Id" data-table-name="@shown.Name" data-can-write="@(Model.Context.CanWriteProjectData ? "1" : "0")" data-editable="@(editable ? "1" : "0")" data-primary-key="@JsonSerializer.Serialize(primary)" data-columns="@JsonSerializer.Serialize(shown.Schema, new JsonSerializerOptions(JsonSerializerDefaults.Web))">
@if(Model.Preview is not { Rows.Count: > 0 } preview){<div class="ts-empty" role="status"><p class="ts-empty-title">No rows yet.</p></div>}
else{
string?[] types = [.. preview.Columns.Select(column => column.Decltype is { Length: > 0 } declared ? declared : shown.Schema.FirstOrDefault(item => item.Name == column.Name)?.Decltype)];
bool[] numbers = [.. preview.Columns.Select((_, index) => DatabaseTables.NumericType(types[index]) || preview.Rows.All(row => row[index].ValueKind is JsonValueKind.Number or JsonValueKind.Null) && preview.Rows.Any(row => row[index].ValueKind == JsonValueKind.Number))];
<div class="ts-table-wrap ts-data-result-wrap" role="region" tabindex="0" aria-labelledby="table-columns-title"><table class="ts-table ts-data-result ts-studio-grid"><thead><tr>@for(var index = 0; index < preview.Columns.Count; index++){<th scope="col" class="@(numbers[index] ? "ts-num" : null)" data-column="@preview.Columns[index].Name" data-type="@types[index]">@preview.Columns[index].Name<span class="ts-studio-col-type">@DatabaseTables.CompactType(types[index])</span></th>}@if(editable){<th scope="col" class="ts-studio-row-actions"><span class="ts-sr-only">Actions</span></th>}</tr></thead><tbody>@for(var rowIndex = 0; rowIndex < preview.Rows.Count; rowIndex++){var row = preview.Rows[rowIndex];<tr>@for(var index = 0; index < row.Count; index++){var cell = row[index];<td class="@(numbers[index] ? "ts-num" : null)" data-kind="@(cell.ValueKind == JsonValueKind.Null ? "null" : cell.ValueKind == JsonValueKind.Number ? "number" : "string")" tabindex="@(editable ? rowIndex == 0 && index == 0 ? "0" : "-1" : null)">@(cell.ValueKind == JsonValueKind.Null ? "NULL" : cell.ValueKind == JsonValueKind.String ? cell.GetString() : cell.GetRawText())</td>}@if(editable){<td class="ts-studio-row-actions"><button class="ts-icon-btn ts-studio-row-delete" type="button" data-delete-row aria-label="Delete row">@Icons.Render("Trash2",14)</button></td>}</tr>}</tbody></table></div>}
</div>
<div class="ts-studio-panel" id="table-columns"><div class="ts-table-wrap" role="region" tabindex="0" aria-label="@(shown.Name + " schema")"><table class="ts-table ts-studio-grid"><thead><tr><th scope="col">Column</th><th scope="col">Type</th><th scope="col">Constraints</th><th scope="col">Default</th></tr></thead><tbody>@foreach(var column in shown.Schema){<tr><td class="ts-mono">@column.Name</td><td class="ts-mono ts-studio-schema-type">@(string.IsNullOrEmpty(column.Decltype) ? "—" : column.Decltype)</td><td class="ts-studio-schema-meta">@(column.PrimaryKey > 0 && column.NotNull ? "Primary key, not null" : column.PrimaryKey > 0 ? "Primary key" : column.NotNull ? "Not null" : "—")</td><td class="ts-mono ts-studio-schema-meta">@(column.DefaultValue ?? "—")</td></tr>}</tbody></table></div></div>
<footer class="ts-studio-commit" id="table-commit"><div class="ts-studio-commit-state"><span class="ts-meta" data-table-count>@(Model.Preview is { Rows.Count: > 0 } counted && shown.Rows > counted.Rows.Count ? "First " + counted.Rows.Count.ToString(CultureInfo.InvariantCulture) + " of " + shown.Rows.ToString("N0", CultureInfo.InvariantCulture) + " rows" : ValueFormat.Plural(shown.Rows, "row"))</span><p class="ts-meta" id="table-commit-status" role="status" aria-live="polite" data-ignore-morph></p></div><span class="ts-studio-commit-name ts-mono ts-truncate">@shown.Name</span>
@if(Model.Context.CanWriteProjectData){<div class="ts-studio-commit-dirty" data-ignore-morph><code class="ts-studio-commit-sql ts-truncate" data-commit-sql></code><span class="ts-meta" data-commit-count></span><div class="ts-studio-actions"><button class="ts-btn ts-btn-ghost ts-btn-sm" type="button" data-commit-discard>Discard</button><button class="ts-btn ts-btn-primary ts-btn-sm" type="button" data-commit-apply>Commit</button></div></div>}</footer>
</section>}
</div>}
}
</div>
