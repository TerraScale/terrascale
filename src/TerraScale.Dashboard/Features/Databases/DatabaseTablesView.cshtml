@inherits RazorSlice<DatabaseDetailPage>
@using System.Globalization
@using System.Text.Json
@using TerraScale.Dashboard.Features.Databases
@using TerraScale.Dashboard.Common.Charts
@using TerraScale.Dashboard.Common.Live
<div id="tables-browser" @LiveView.Initializer(Model.Context, DatabaseService.Path(Model.Database.Id, "tables/live") + "?table=" + Uri.EscapeDataString(HttpContext!.Request.Query["table"].ToString()))>
@if(Model.Tables is { } listing){
@if(listing.Tables.Count == 0){<section class="ts-card" id="tables"><div class="ts-card-body"><div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("Table", 16)</span><p class="ts-empty-title">No tables yet.</p>@if(Model.Context.CanWriteProjectData){<button class="ts-btn ts-btn-primary ts-btn-sm" type="button" command="show-modal" commandfor="create-table">@Icons.Render("Plus",16)<span>New table</span></button>}<a class="ts-btn ts-btn-secondary ts-btn-sm" href="@DatabaseService.Path(Model.Database.Id, "sql")">@Icons.Render("Play",16)<span>Open SQL editor</span></a></div></div></section>}
else{
<div class="ts-data-browser" id="tables"><nav class="ts-data-nav" aria-label="Tables"><div class="ts-data-nav-head"><h2 class="ts-data-nav-title">Tables</h2><div class="ts-card-actions">@if(Model.Context.CanWriteProjectData){<button class="ts-btn ts-btn-primary ts-btn-sm" type="button" command="show-modal" commandfor="create-table">@Icons.Render("Plus",16)<span>New table</span></button>}else{<span class="ts-tip" data-tip="Write access is required to change data or schema. Your role can run read-only statements."><button class="ts-btn ts-btn-primary ts-btn-sm" type="button" disabled title="Write access is required to change data or schema. Your role can run read-only statements.">@Icons.Render("Plus",16)<span>New table</span></button></span>}</div></div><ul class="ts-data-nav-list">@foreach(var table in listing.Tables){<li data-table="@table.Name"><a class="ts-nav-link ts-data-nav-link" href="@Model.TablePath(table.Name)" aria-current="@(Model.Table == table.Name ? "page" : null)"><span class="ts-nav-icon" aria-hidden="true">@Icons.Render("Table",16)</span><span class="ts-nav-label ts-truncate ts-mono">@table.Name</span> <span class="ts-meta ts-mono" title="@table.Rows.ToString("N0", CultureInfo.InvariantCulture)">@ChartGeometry.Compact(table.Rows)<span class="ts-sr-only"> rows</span></span></a></li>}</ul><form class="ts-data-nav-select" method="get" action="@DatabaseService.Path(Model.Database.Id, "tables")"><label class="ts-sr-only" for="table-select">Table</label><select class="ts-select ts-input-sm ts-mono" id="table-select" name="table">@foreach(var table in listing.Tables){<option value="@table.Name" selected="@(table.Name == Model.Table)">@table.Name</option>}</select><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Open</button></form>@if(listing.Truncated){<p class="ts-meta" role="status">Showing the first 100 tables.</p>}</nav>
<div class="ts-data-browser-main">
@if(listing.Tables.FirstOrDefault(table => table.Name == Model.Table) is { } shown){
<section class="ts-card ts-card-boxed" id="table-columns" aria-labelledby="table-columns-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title ts-mono" id="table-columns-title">@shown.Name</h2></div><div class="ts-card-actions"><span class="ts-meta">@ValueFormat.Plural(shown.Rows, "row")</span></div></header><div class="ts-card-body"><dl class="ts-kv">@foreach(var column in shown.Columns){<div><dt class="ts-mono">@column.Name</dt><dd class="ts-mono">@(string.IsNullOrEmpty(column.Decltype) ? "—" : column.Decltype)</dd></div>}</dl></div></section>
<section class="ts-card ts-card-flush" id="table-rows" aria-labelledby="table-rows-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="table-rows-title">Rows</h2></div></header><div class="ts-card-body">
@if(Model.Preview is not { Rows.Count: > 0 } preview){<div class="ts-empty" role="status"><p class="ts-empty-title">No rows yet.</p></div>}
else{<div class="ts-table-wrap ts-data-result-wrap" role="region" tabindex="0" aria-labelledby="table-rows-title"><table class="ts-table ts-data-result"><thead><tr>@foreach(var column in preview.Columns){<th scope="col">@column.Name</th>}</tr></thead><tbody>@foreach(var row in preview.Rows){<tr>@foreach(var cell in row){<td class="@(cell.ValueKind == JsonValueKind.Number ? "ts-num" : null)" data-kind="@(cell.ValueKind == JsonValueKind.Null ? "null" : cell.ValueKind == JsonValueKind.Number ? "number" : "string")">@(cell.ValueKind == JsonValueKind.String ? cell.GetString() : cell.GetRawText())</td>}</tr>}</tbody></table></div>
@if(shown.Rows > preview.Rows.Count){<p class="ts-meta">@("First " + preview.Rows.Count.ToString(CultureInfo.InvariantCulture) + " of " + shown.Rows.ToString("N0", CultureInfo.InvariantCulture) + " rows")</p>}}
</div></section>}
</div></div>}
}
</div>
