@inherits RazorSlice<TerraScale.Dashboard.Features.Databases.DatabaseDetailPage>
@implements IUsesLayout<TerraScale.Dashboard.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.Databases
@inject AssetUrls Assets
<main class="ts-page ts-db-detail" data-database-id="@Model.Database.Id">
@(await RenderPartialAsync<TerraScale.Dashboard.Features.Databases.DatabaseFrame,DatabaseFrameModel>(new(Model.Database, Model.Tab)))
@if(Model.Error.Length > 0 && !Model.OpenDelete){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}
@if(Model.Created){<div class="ts-alert ts-db-created ts-alert-@Model.CreatedState.Tone" data-status="@Model.Database.Status"><span class="ts-db-created-mark" aria-hidden="true">@Icons.Render(Model.CreatedState.Tone == "success" ? "Check" : "Database",18)</span><div class="ts-list-main"><p class="ts-alert-title">@Model.CreatedState.Title</p><p class="ts-alert-body">@Model.CreatedState.Body</p></div></div>}
@if(Model.Tab == "overview"){
<dl class="ts-stats" aria-label="Database summary"><div class="ts-stat" data-tone="violet"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Collections</dt><dd class="ts-stat-value">@(Model.ContentsAvailable ? Model.Contents.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) : "—")</dd><dd class="ts-stat-detail">@(Model.ContentsAvailable ? "In this database" : "Not reported by provider")</dd></div><div class="ts-stat" data-tone="blue"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Documents</dt><dd class="ts-stat-value">@(Model.ContentsAvailable ? Model.Contents.Sum(item=>item.Documents).ToString(System.Globalization.CultureInfo.InvariantCulture) : "—")</dd><dd class="ts-stat-detail">@(Model.ContentsAvailable ? DatabasesPage.Bytes(Model.Contents.Sum(item=>item.Bytes)) + " across all collections" : "Not reported by provider")</dd></div><div class="ts-stat" data-tone="teal"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Restore points</dt><dd class="ts-stat-value">@(Model.Backups?.Listing?.Backups.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</dd><dd class="ts-stat-detail">@(Model.Backups?.Listing is null ? "Not reported by provider" : "Available snapshots")</dd></div><div class="ts-stat" data-tone="slate"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Created</dt><dd class="ts-stat-value">@Model.Database.CreatedAt.UtcDateTime.ToString("MMM d",System.Globalization.CultureInfo.InvariantCulture)</dd><dd class="ts-stat-detail">@Model.Database.CreatedAt.UtcDateTime.ToString("yyyy · HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</dd></div></dl>
<section class="ts-card" id="placement" aria-labelledby="placement-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="placement-title">Placement and latency</h2><p class="ts-card-description">Configured regions for this database</p></div></header><div class="ts-card-body"><dl class="ts-db-facts"><div><dt>Placement lock</dt><dd>@Model.Placement</dd></div><div><dt>Placement status</dt><dd>Not reported</dd></div><div><dt>Generation</dt><dd>Not reported</dd></div><div><dt>Replication</dt><dd>@Model.Replication</dd></div></dl><div class="ts-alert ts-alert-info" role="status"><p class="ts-alert-title">Configured regions</p><p class="ts-alert-body">The dashboard records the database regions. Replication measurements are shown below.</p></div>
@if(Model.Context.CanManage){<form method="post" action="/api/v1/dashboard/databases/regions" class="ts-form" aria-label="Change regions"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><fieldset class="ts-field ts-db-regions"><legend class="ts-label">Regions</legend><div class="ts-db-region-grid" id="database-placement">@foreach(var region in Model.Choices){<label class="ts-db-region-card"><input type="checkbox" name="region" value="@region.Code" checked="@DatabaseService.Regions(Model.Database).Contains(region.Code)" required="@(region.Code == Model.Database.Region)" />@if(region.Country.Length > 0){<img src="@Assets.Url("flags/" + region.Country + ".svg")" alt="" aria-hidden="true" />}<span class="ts-db-region-text"><span class="ts-db-region-name">@region.Name</span><span class="ts-meta ts-mono">@region.Code</span></span>@if(region.Code==Model.Database.Region){<span class="ts-badge ts-badge-info">Home</span>}</label>}</div><p class="ts-hint">@(Model.RegionsError.Length > 0 ? Model.RegionsError : DatabasesPage.RegionDisplay(Model.Database.Region) + " is the home region and stays selected. " + (Model.Choices.Count == DatabaseService.Regions(Model.Database).Count ? DatabasesPage.SingleRegionNotice : "Add a region to replicate the database there; remove one to stop serving it there."))</p></fieldset><div class="ts-row"><button class="ts-btn ts-btn-secondary" type="submit">Save regions</button></div></form>}
@if(Model.PlacementLabels.Count > 0){<div class="ts-table-wrap"><table class="ts-table"><thead><tr><th>Region</th><th class="ts-num">Estimated round trip</th></tr></thead><tbody>@foreach(var label in Model.PlacementLabels){<tr><td>@label</td><td class="ts-num">Not measured</td></tr>}</tbody></table></div>}
<p class="ts-meta">No provider latency measurements are available.</p></div></section>
<p class="ts-meta ts-measurement-loading" role="status">Loading replication measurements…</p>
@if(Model.Measurements is { } measurements){@(await RenderPartialAsync<TerraScale.Dashboard.Features.Databases.DatabaseReplicationView,DatabaseReplicationModel>(new(measurements,Model.Context.Project!.Id,Model.Database.Id,Model.Range)))}
@if(Model.Context.CanManage){<section class="ts-db-danger" aria-labelledby="danger-zone-title"><div class="ts-list-main"><h2 class="ts-section-title" id="danger-zone-title">Danger zone</h2><p class="ts-meta">Permanently remove this database and its data.</p></div><button class="ts-btn ts-btn-danger" type="button" command="show-modal" commandfor="delete-database">@Icons.Render("Trash2",15)<span>Delete database</span></button></section><dialog id="delete-database" class="ts-dialog" closedby="any" aria-labelledby="delete-database-title" data-init="@(Model.OpenDelete ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="delete-database-title">Delete @Model.Database.Name</h2><p class="ts-dialog-description">This permanently removes the database and all of its data.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="delete-database">@Icons.Render("X",18)</button></header><form method="post" action="/api/v1/dashboard/databases/delete" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />@if(Model.Error.Length > 0 && Model.OpenDelete){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}<div class="ts-field"><label class="ts-label" for="confirm-name">Type @Model.Database.Name to confirm</label><input class="ts-input" id="confirm-name" name="confirmName" required autocomplete="off" /></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="delete-database">Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Delete database</button></div></form></div></dialog>}
 }else if(Model.Tab == "branches"){
<section class="ts-card" id="branches" aria-labelledby="branches-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="branches-title">Branches</h2><p class="ts-card-description">Create a database branch in the selected project</p></div></header><div class="ts-card-body"><dl class="ts-db-facts"><div><dt>Branch creation</dt><dd>Snapshot copy in TerraBase</dd></div><div><dt>Physical clone</dt><dd>Not reported</dd></div><div><dt>Promotion</dt><dd>Unavailable</dd></div><div><dt>Merge</dt><dd>Unavailable</dd></div></dl><div class="ts-row">@if(Model.Context.CanManage && Model.Database.Status=="ready"){<form method="post" action="/api/v1/dashboard/databases/branch"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><button type="submit" class="ts-btn ts-btn-primary">@Icons.Render("GitBranch",16)<span>Create preview branch</span></button></form><button class="ts-btn ts-btn-secondary" type="button" command="show-modal" commandfor="name-branch">@Icons.Render("Pencil",15)<span>Choose a branch name</span></button>}<button type="button" class="ts-btn ts-btn-secondary" disabled>View diff (contract unavailable)</button></div></div></section>
@if(Model.Context.CanManage && Model.Database.Status=="ready"){<dialog id="name-branch" class="ts-dialog" closedby="any" aria-labelledby="name-branch-title" aria-describedby="name-branch-description"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="name-branch-title">Create branch</h2><p class="ts-dialog-description" id="name-branch-description">Copy @Model.Database.Name into a new database with the name you choose.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="name-branch">@Icons.Render("X",18)</button></header><form method="post" action="/api/v1/dashboard/databases/branch" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><div class="ts-field"><label class="ts-label" for="branch-name">New database name</label><input class="ts-input" id="branch-name" name="name" pattern="[a-z0-9]([a-z0-9\-]{0,61}[a-z0-9])?" maxlength="63" required /><p class="ts-hint">Lowercase letters, digits, and hyphens.</p></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="name-branch">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Create branch</button></div></form></div></dialog>}
}else if(Model.Tab == "import"){
<section class="ts-card" id="import" aria-labelledby="import-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="import-title">Import and export</h2><p class="ts-card-description">Lossless JSONL and CSV controls will appear when the SDK contract is published</p></div></header><div class="ts-card-body"><div class="ts-alert ts-alert-info" role="status"><p class="ts-alert-title">No local import or export</p><p class="ts-alert-body">The published TerraScale SDK does not expose database import or lossless export operations.</p></div><div class="ts-row"><button type="button" class="ts-btn ts-btn-secondary" disabled>@Icons.Render("Upload",16)<span>Import JSONL / CSV</span></button><button type="button" class="ts-btn ts-btn-secondary" disabled>@Icons.Render("Download",16)<span>Export lossless JSONL</span></button></div></div></section>
}else{
@if(Model.Backups is { } backupPage){@(await RenderPartialAsync<TerraScale.Dashboard.Features.Backups.BackupSection,TerraScale.Dashboard.Features.Backups.BackupPage>(backupPage))}
}
</main>
@functions { public ShellModel LayoutModel => Model.Shell; }
