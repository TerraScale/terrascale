@using TerraScale.Dashboard.Common.Charts
@inherits RazorSlice<TerraScale.Dashboard.Features.Databases.DatabaseDetailPage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.Databases
@inject AssetUrls Assets
<main class="ts-page" data-database-id="@Model.Database.Id">
@(await RenderPartialAsync<TerraScale.Dashboard.Common.Databases.DatabaseFrame,DatabaseFrameModel>(new(Model.Database, Model.Tab, Serving: Model.Serving)))
@if(Model.Error.Length > 0 && !Model.OpenBranch && !Model.OpenGrant && !(Model.OpenDelete && Model.Context.CanManage && Model.Tab == "danger")){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}
@if(Model.Created){<div class="ts-alert ts-db-created ts-alert-@Model.CreatedState.Tone" data-status="@Model.Database.Status"><span class="ts-db-created-mark" aria-hidden="true">@Icons.Render(Model.CreatedState.Tone == "success" ? "Check" : "Database",18)</span><div class="ts-list-main"><p class="ts-alert-title">@Model.CreatedState.Title</p><p class="ts-alert-body">@Model.CreatedState.Body</p></div></div>}
@if(Model.Tab == "overview"){
<dl class="ts-stats" aria-label="Database summary"><div class="ts-stat"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Tables</dt><dd class="ts-stat-value">@(Model.Tables?.Tables.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</dd></div><div class="ts-stat"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Rows</dt><dd class="ts-stat-value" title="@(Model.Tables?.Rows.ToString("N0", System.Globalization.CultureInfo.InvariantCulture))">@(Model.Tables is { } counted ? ChartGeometry.Compact(counted.Rows) : "—")</dd></div><div class="ts-stat"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Storage</dt><dd class="ts-stat-value">@(Model.StorageBytes is { } bytes ? TerraScale.Dashboard.Common.Formatting.MetricFormat.Bytes(bytes) : "—")</dd></div><div class="ts-stat"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Restore points</dt><dd class="ts-stat-value">@(Model.Backups?.Listing?.Backups.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</dd></div><div class="ts-stat"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Created</dt><dd class="ts-stat-value"><time datetime="@Model.Database.CreatedAt.UtcDateTime.ToString("O",System.Globalization.CultureInfo.InvariantCulture)" title="@Model.Database.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)">@Model.Database.CreatedAt.UtcDateTime.ToString("MMM d",System.Globalization.CultureInfo.InvariantCulture)</time></dd></div></dl>
<section class="ts-card ts-card-boxed" id="connect" aria-labelledby="connect-title">
<header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="connect-title">Connect</h2></div><div class="ts-card-actions"><a class="ts-link" href="/api-keys">Create an API key →</a><a class="ts-link" href="https://docs.terrascale.tech/guides/authentication" @(ExternalLink.Attributes)>Authentication guide@(ExternalLink.Hint)</a></div></header>
<div class="ts-card-body ts-stack-lg">
@foreach(var connection in DatabaseConnections.For(Model.Database.ProjectId, Model.Database.Name)){
var signal = "$_dbConnect" + connection.Id;
<div class="ts-stack-sm" data-signals="@("{_dbConnect" + connection.Id + ": ''}")">
<div class="ts-snippet">
<div class="ts-snippet-header ts-row-between"><span id="@("db-connect-" + connection.Id + "-label")">@connection.Label</span><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" aria-label="@("Copy " + connection.Label)" aria-describedby="@("db-connect-" + connection.Id + "-status")" data-on:click="@(signal + " = 'Copying…'; Promise.resolve().then(() => navigator.clipboard.writeText(el.closest('.ts-snippet').querySelector('code').textContent)).then(() => " + signal + " = 'Copied', () => " + signal + " = 'Copy failed. Select and copy it manually.')")">@Icons.Render("Copy",14)<span>Copy</span></button></div>
<pre class="ts-snippet-body" tabindex="0" aria-labelledby="@("db-connect-" + connection.Id + "-label")"><code id="@("db-connect-" + connection.Id)">@connection.Text</code></pre>
</div>
<p class="ts-meta"><a class="ts-link" href="@("https://docs.terrascale.tech/" + connection.Guide)" @(ExternalLink.Attributes)>@(connection.Label + " guide") →@(ExternalLink.Hint)</a></p>
<p class="ts-meta" id="@("db-connect-" + connection.Id + "-status")" role="status" aria-live="polite" aria-atomic="true" data-text="@signal"></p>
</div>
}
@{ var sdks = DatabaseConnections.Sdks(Model.Database.ProjectId, Model.Database.Name); }
<div class="ts-stack-sm" id="db-connect-sdk" data-signals="@("{_dbSdk: '" + sdks[0].Id + "', _dbSdkCopy: ''}")">
<div class="ts-snippet">
<div class="ts-snippet-header ts-row-between"><nav class="ts-segmented" aria-label="SDK">@foreach(var sdk in sdks){<button class="ts-segment" type="button" data-sdk="@sdk.Id" data-attr:aria-current="@("$_dbSdk === '" + sdk.Id + "' ? 'true' : null")" data-on:click="@("$_dbSdk = '" + sdk.Id + "'; $_dbSdkCopy = ''")">@sdk.Label</button>}</nav><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" aria-label="Copy SDK snippet" aria-describedby="db-connect-sdk-status" data-on:click="$_dbSdkCopy = 'Copying…'; Promise.resolve().then(() => navigator.clipboard.writeText(document.querySelector('#db-connect-sdk code[data-sdk=&quot;' + $_dbSdk + '&quot;]').textContent)).then(() => $_dbSdkCopy = 'Copied', () => $_dbSdkCopy = 'Copy failed. Select and copy it manually.')">@Icons.Render("Copy",14)<span>Copy</span></button></div>
@foreach(var sdk in sdks){<pre class="ts-snippet-body" tabindex="0" aria-label="@(sdk.Label + " SDK")" hidden="@(sdk.Id == sdks[0].Id ? null : "hidden")" data-attr:hidden="@("$_dbSdk !== '" + sdk.Id + "'")"><code data-sdk="@sdk.Id">@sdk.Code</code></pre>}
</div>
<p class="ts-meta" id="db-connect-sdk-status" role="status" aria-live="polite" aria-atomic="true" data-text="$_dbSdkCopy"></p>
</div>
</div></section>
var activity = Model.Activity!;
<section class="ts-card" id="activity" aria-labelledby="activity-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="activity-title">Activity</h2></div><div class="ts-card-actions"><a class="ts-link" href="@("/analytics?database=" + Uri.EscapeDataString(Model.Database.Id) + "&range=" + Model.Range)">View analytics →</a></div></header><div class="ts-card-body"><div class="ts-grid ts-grid-2">
@foreach(var card in activity.Cards){<section class="ts-card ts-card-boxed" aria-label="@card.Title"><header class="ts-card-head"><div class="ts-card-heading"><h3 class="ts-card-title">@card.Title</h3></div><div class="ts-card-actions"><nav class="ts-segmented" aria-label="@(card.Title + " range")">@foreach(var value in new[]{"1h","24h","7d","30d"}){<a class="ts-segment" href="@Model.RangePath(card.Key,value)" aria-current="@(value == card.Range ? "page" : null)">@value</a>}</nav></div></header><div class="ts-card-body">
@if(card.Plot is { Paths.Count: > 0 } plot){<ul class="ts-chart-legend" aria-label="Chart series">@foreach(var path in plot.Paths){<li class="ts-chart-legend-item"><svg class="ts-chart-swatch @path.Class" viewBox="0 0 32 8" aria-hidden="true"><line x1="0" x2="32" y1="4" y2="4" stroke-dasharray="@path.Dash"></line></svg><span class="ts-mono">@path.Name</span></li>}</ul><div class="ts-chart-shell" role="region" aria-label="@(card.Title + " chart")" tabindex="0">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Analytics.AnalyticsLineView,TerraScale.Dashboard.Features.Analytics.AnalyticsLinePlot>(plot))</div>}
else if(card.Failed){<div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Activity unavailable</p><p class="ts-alert-body">@card.Message</p></div>}
else{<div class="ts-empty" role="status"><p class="ts-empty-title">@card.Message</p></div>}
</div></section>}
</div></div></section>
}else if(Model.Tab == "tables"){
@if(Model.Tables is { } listing){
@if(listing.Tables.Count == 0){<section class="ts-card" id="tables"><div class="ts-card-body"><div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("Table", 16)</span><p class="ts-empty-title">No tables yet.</p><a class="ts-btn ts-btn-primary ts-btn-sm" href="@DatabaseService.Path(Model.Database.Id, "sql")">@Icons.Render("Play",16)<span>Open SQL editor</span></a></div></div></section>}
else{
<div class="ts-data-browser" id="tables"><nav class="ts-data-nav" aria-label="Tables"><div class="ts-data-nav-head"><h2 class="ts-data-nav-title">Tables</h2></div><ul class="ts-data-nav-list">@foreach(var table in listing.Tables){<li data-table="@table.Name"><a class="ts-nav-link ts-data-nav-link" href="@Model.TablePath(table.Name)" aria-current="@(Model.Table == table.Name ? "page" : null)"><span class="ts-nav-icon" aria-hidden="true">@Icons.Render("Table",16)</span><span class="ts-nav-label ts-truncate ts-mono">@table.Name</span> <span class="ts-meta ts-mono" title="@table.Rows.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)">@ChartGeometry.Compact(table.Rows)<span class="ts-sr-only"> rows</span></span></a></li>}</ul><form class="ts-data-nav-select" method="get" action="@DatabaseService.Path(Model.Database.Id, "tables")"><label class="ts-sr-only" for="table-select">Table</label><select class="ts-select ts-input-sm ts-mono" id="table-select" name="table">@foreach(var table in listing.Tables){<option value="@table.Name" selected="@(table.Name == Model.Table)">@table.Name</option>}</select><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Open</button></form>@if(listing.Truncated){<p class="ts-meta" role="status">Showing the first 100 tables.</p>}</nav>
<div class="ts-data-browser-main">
@if(listing.Tables.FirstOrDefault(table => table.Name == Model.Table) is { } shown){
<section class="ts-card ts-card-boxed" id="table-columns" aria-labelledby="table-columns-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title ts-mono" id="table-columns-title">@shown.Name</h2></div><div class="ts-card-actions"><span class="ts-meta">@ValueFormat.Plural(shown.Rows, "row")</span></div></header><div class="ts-card-body"><dl class="ts-kv">@foreach(var column in shown.Columns){<div><dt class="ts-mono">@column.Name</dt><dd class="ts-mono">@(string.IsNullOrEmpty(column.Decltype) ? "—" : column.Decltype)</dd></div>}</dl></div></section>
<section class="ts-card ts-card-flush" id="table-rows" aria-labelledby="table-rows-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="table-rows-title">Rows</h2></div></header><div class="ts-card-body">
@if(Model.Preview is not { Rows.Count: > 0 } preview){<div class="ts-empty" role="status"><p class="ts-empty-title">No rows yet.</p></div>}
else{<div class="ts-table-wrap ts-data-result-wrap" role="region" tabindex="0" aria-labelledby="table-rows-title"><table class="ts-table ts-data-result"><thead><tr>@foreach(var column in preview.Columns){<th scope="col">@column.Name</th>}</tr></thead><tbody>@foreach(var row in preview.Rows){<tr>@foreach(var cell in row){<td class="@(cell.ValueKind == System.Text.Json.JsonValueKind.Number ? "ts-num" : null)" data-kind="@(cell.ValueKind == System.Text.Json.JsonValueKind.Null ? "null" : cell.ValueKind == System.Text.Json.JsonValueKind.Number ? "number" : "string")">@(cell.ValueKind == System.Text.Json.JsonValueKind.String ? cell.GetString() : cell.GetRawText())</td>}</tr>}</tbody></table></div>
@if(shown.Rows > preview.Rows.Count){<p class="ts-meta">@("First " + preview.Rows.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) + " of " + shown.Rows.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) + " rows")</p>}}
</div></section>}
</div></div>}
}
}else if(Model.Tab == "grants"){
<section class="ts-card" id="grants" aria-labelledby="grants-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="grants-title">Grants</h2></div>@if(Model.Context.CanManage && Model.Grants is { Count: > 0 }){<div class="ts-card-actions"><button class="ts-btn ts-btn-primary ts-btn-sm" type="button" command="show-modal" commandfor="grant">@Icons.Render("Plus",16)<span>Add grant</span></button></div>}</header><div class="ts-card-body">
@if(Model.Grants is { Count: 0 }){<div class="ts-empty" role="status"><span class="ts-icon-tile" aria-hidden="true">@Icons.Render("ShieldCheck", 16)</span><p class="ts-empty-title">No grants yet.</p>@if(Model.Context.CanManage){<button class="ts-btn ts-btn-primary ts-btn-sm" type="button" command="show-modal" commandfor="grant">@Icons.Render("Plus",16)<span>Add grant</span></button>}</div>}
else if(Model.Grants is { } grants){<div class="ts-table-wrap"><table class="ts-table"><thead><tr><th scope="col">Table</th><th scope="col">Where</th><th scope="col">Columns</th><th scope="col"><span class="ts-sr-only">Actions</span></th></tr></thead><tbody>
@for(var i = 0; i < grants.Count; i++){var grant = grants[i];
<tr data-grant="@grant.Table"><td class="ts-mono">@grant.Table</td><td class="ts-mono ts-break">@(grant.Where ?? "All rows")</td><td class="ts-mono ts-break">@(grant.Columns is { } columns ? string.Join(", ", columns) : "All columns")</td><td>@if(Model.Context.CanManage){<div class="ts-row"><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" command="show-modal" commandfor="@("grant-" + i)" aria-label="@("Edit grant on " + grant.Table)">Edit</button><button class="ts-btn ts-btn-danger ts-btn-sm" type="button" command="show-modal" commandfor="@("remove-grant-" + i)" aria-label="@("Remove grant on " + grant.Table)">Remove</button></div>}</td></tr>
}</tbody></table></div>}
</div></section>
@if(Model.Context.CanManage){
var form = Model.GrantForm;
<datalist id="grant-tables">@foreach(var table in Model.Tables?.Tables ?? []){<option value="@table.Name"></option>}</datalist>
var dialogs = new List<(string Id, string Title, string Table, string Where, string Columns, bool Open)> { ("grant", "Add grant", form?.Table ?? "", form?.Where ?? "", form?.Columns ?? "", Model.OpenGrant) };
for(var i = 0; i < (Model.Grants?.Count ?? 0); i++){var grant = Model.Grants![i]; dialogs.Add(("grant-" + i, "Edit grant on " + grant.Table, grant.Table, grant.Where ?? "", grant.Columns is { } columns ? string.Join(", ", columns) : "", false));}
foreach(var dialog in dialogs){var edit = dialog.Id != "grant";
<dialog id="@dialog.Id" class="ts-dialog" closedby="any" aria-labelledby="@(dialog.Id + "-title")" data-init="@(dialog.Open ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@(dialog.Id + "-title")">@dialog.Title</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@dialog.Id">@Icons.Render("X",18)</button></header>
<form method="post" action="/api/v1/dashboard/databases/grants" data-submit-once class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />
@if(dialog.Open){<div class="ts-alert ts-alert-danger" id="grant-error" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}
@if(edit){<input type="hidden" name="table" value="@dialog.Table" />}else{<div class="ts-field"><label class="ts-label" for="grant-table">Table</label><input class="ts-input ts-mono" id="grant-table" name="table" list="grant-tables" value="@dialog.Table" pattern="[A-Za-z_][A-Za-z0-9_]*" maxlength="63" required autocomplete="off" placeholder="posts" /></div>}
<div class="ts-field"><label class="ts-label" for="@(dialog.Id + "-where")">Where</label><input class="ts-input ts-mono" id="@(dialog.Id + "-where")" name="where" value="@dialog.Where" maxlength="4096" autocomplete="off" placeholder="owner_id = :sub" /></div>
<div class="ts-field"><label class="ts-label" for="@(dialog.Id + "-columns")">Columns</label><input class="ts-input ts-mono" id="@(dialog.Id + "-columns")" name="columns" value="@dialog.Columns" autocomplete="off" placeholder="id, body" /></div>
<div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="@dialog.Id">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Save grant</button></div></form></div></dialog>
}
for(var i = 0; i < (Model.Grants?.Count ?? 0); i++){var grant = Model.Grants![i]; var dialog = "remove-grant-" + i;
<dialog id="@dialog" class="ts-dialog" closedby="any" aria-labelledby="@(dialog + "-title")" aria-describedby="@(dialog + "-description")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@(dialog + "-title")">Remove grant on @grant.Table?</h2><p class="ts-dialog-description" id="@(dialog + "-description")">End users can no longer read this table.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@dialog">@Icons.Render("X",18)</button></header>
<form method="post" action="/api/v1/dashboard/databases/grants/delete" class="ts-form" data-submit-once><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><input type="hidden" name="table" value="@grant.Table" /><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="@dialog" autofocus>Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Remove grant</button></div></form></div></dialog>
}
}
}else if(Model.Tab == "region"){
<section class="ts-card ts-card-boxed" id="placement" aria-labelledby="placement-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="placement-title">Region</h2></div></header><div class="ts-card-body"><dl class="ts-db-facts"><div><dt>Home region</dt><dd>@DatabasesPage.RegionDisplay(Model.Database.Region)</dd></div></dl></div></section>
}else if(Model.Tab == "danger"){
@if(Model.Context.CanManage){<section class="ts-card ts-card-boxed ts-db-danger" aria-labelledby="danger-zone-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="danger-zone-title">Danger zone</h2></div></header><div class="ts-db-danger-row"><div class="ts-list-main"><h3 class="ts-section-title">Delete database</h3></div><button class="ts-btn ts-btn-danger" type="button" command="show-modal" commandfor="delete-database">@Icons.Render("Trash2",15)<span>Delete database</span></button></div></section><dialog id="delete-database" class="ts-dialog" closedby="any" aria-labelledby="delete-database-title" data-init="@(Model.OpenDelete ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="delete-database-title">Delete @Model.Database.Name</h2><p class="ts-dialog-description">This permanently removes the database and all of its data.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="delete-database">@Icons.Render("X",18)</button></header><form method="post" action="/api/v1/dashboard/databases/delete" data-submit-once class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />@if(Model.Error.Length > 0 && Model.OpenDelete){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}<div class="ts-field"><label class="ts-label" for="confirm-name">Type @Model.Database.Name to confirm</label><input class="ts-input" id="confirm-name" name="confirmName" required autocomplete="off" /></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="delete-database">Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Delete database</button></div></form></div></dialog>}else{<div class="ts-alert ts-alert-info" role="status"><p class="ts-alert-body">Only organization members who can manage databases can delete this database.</p></div>}
 }else if(Model.Tab == "branches"){
<section class="ts-card" id="branches" aria-labelledby="branches-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="branches-title">Branches</h2></div></header><div class="ts-card-body ts-stack-lg">
<div class="ts-row">@if(Model.Context.CanManage && Model.Database.Status=="ready"){<form method="post" action="/api/v1/dashboard/databases/branch" data-submit-once><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><button type="submit" class="ts-btn ts-btn-primary">@Icons.Render("GitBranch",16)<span>Create preview branch</span></button></form><button class="ts-btn ts-btn-secondary" type="button" command="show-modal" commandfor="name-branch">@Icons.Render("Pencil",15)<span>Create named branch</span></button>}
<a class="ts-link" href="https://docs.terrascale.tech/guides/migrations" @(ExternalLink.Attributes)>Compare schemas with the CLI@(ExternalLink.Hint)</a></div>
@if(Model.Branches.Count == 0){<p class="ts-meta" role="status">No branches yet.</p>}else{<ul class="ts-db-branches" aria-label="Branches of @Model.Database.Name">@foreach(var branch in Model.Branches){<li class="ts-db-branch"><a class="ts-db-branch-name ts-mono" href="@DatabaseService.Path(branch.Id)">@branch.Name</a><span class="ts-badge @(branch.Status == "ready" ? "ts-badge-success" : branch.Status == "failed" ? "ts-badge-danger" : branch.Status is "provisioning" or "accepted" or "pending" ? "ts-badge-warning" : "ts-badge-neutral")"><span class="ts-dot" aria-hidden="true"></span>@branch.Status</span><span class="ts-meta ts-mono">@branch.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</span></li>}</ul>}</div></section>
@if(Model.Context.CanManage && Model.Database.Status=="ready"){
<dialog id="name-branch" class="ts-dialog" closedby="any" aria-labelledby="name-branch-title" data-init="@(Model.OpenBranch ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="name-branch-title">Create branch</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="name-branch">@Icons.Render("X",18)</button></header>
<form method="post" action="/api/v1/dashboard/databases/branch" data-submit-once class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />
@if(Model.OpenBranch){<div class="ts-alert ts-alert-danger" id="branch-error" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}
<div class="ts-field"><label class="ts-label" for="branch-name">New database name</label><input class="ts-input" id="branch-name" name="name" value="@Model.BranchName" pattern="@DatabaseService.NameInputPattern" title="@DatabaseService.NameHint" maxlength="63" required autofocus placeholder="@(Model.Database.Name + "-preview")" aria-describedby="@(Model.OpenBranch ? "branch-error" : null)" /></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="name-branch">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Create branch</button></div></form></div></dialog>
}
}else{
@if(Model.Backups is { } backupPage){@(await RenderPartialAsync<TerraScale.Dashboard.Features.Backups.BackupSection,TerraScale.Dashboard.Features.Backups.BackupPage>(backupPage))}
}
</main>
@functions { public ShellModel LayoutModel => Model.Shell; }
