@using TerraScale.Dashboard.Shared.Charts
@inherits RazorSlice<TerraScale.Dashboard.Features.Databases.DatabaseDetailPage>
@implements IUsesLayout<TerraScale.Dashboard.Shared.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.Databases
@inject AssetUrls Assets
<main class="ts-page ts-db-detail" data-database-id="@Model.Database.Id">
@(await RenderPartialAsync<TerraScale.Dashboard.Shared.Databases.DatabaseFrame,DatabaseFrameModel>(new(Model.Database, Model.Tab, Serving: Model.Serving)))
@if(Model.Error.Length > 0 && !Model.OpenBranch && !(Model.OpenDelete && Model.Context.CanManage && Model.Tab == "danger")){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}
@if(Model.Created){<div class="ts-alert ts-db-created ts-alert-@Model.CreatedState.Tone" data-status="@Model.Database.Status"><span class="ts-db-created-mark" aria-hidden="true">@Icons.Render(Model.CreatedState.Tone == "success" ? "Check" : "Database",18)</span><div class="ts-list-main"><p class="ts-alert-title">@Model.CreatedState.Title</p><p class="ts-alert-body">@Model.CreatedState.Body</p></div></div>}
@if(Model.Tab == "overview"){
<dl class="ts-stats" aria-label="Database summary"><div class="ts-stat"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Collections</dt><dd class="ts-stat-value">@(Model.ContentsAvailable ? Model.Contents.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) : "—")</dd><dd class="ts-stat-detail">@(Model.ContentsAvailable ? "In this database" : "Not reported by provider")</dd></div><div class="ts-stat"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Documents</dt><dd class="ts-stat-value" title="@(Model.ContentsAvailable ? Model.Contents.Sum(item=>item.Documents).ToString("N0", System.Globalization.CultureInfo.InvariantCulture) : null)">@(Model.ContentsAvailable ? ChartGeometry.Compact(Model.Contents.Sum(item=>item.Documents)) : "—")</dd><dd class="ts-stat-detail">@(Model.ContentsAvailable ? TerraScale.Dashboard.Shared.Formatting.MetricFormat.Bytes(Model.Contents.Sum(item=>item.Bytes)) + " across all collections" : "Not reported by provider")</dd></div><div class="ts-stat"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Restore points</dt><dd class="ts-stat-value">@(Model.Backups?.Listing?.Backups.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</dd><dd class="ts-stat-detail">@(Model.Backups?.Listing is null ? "Not reported by provider" : "Available snapshots")</dd></div><div class="ts-stat"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Created</dt><dd class="ts-stat-value">@Model.Database.CreatedAt.UtcDateTime.ToString("MMM d",System.Globalization.CultureInfo.InvariantCulture)</dd><dd class="ts-stat-detail">@Model.Database.CreatedAt.UtcDateTime.ToString("yyyy · HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</dd></div></dl>
<section class="ts-card ts-card-boxed" id="connect" aria-labelledby="connect-title">
<header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="connect-title">Connect</h2><p class="ts-card-description">Connection URLs for @Model.Database.Name</p></div><div class="ts-card-actions"><a class="ts-link" href="/api-keys">Create an API key →</a></div></header>
<div class="ts-card-body ts-stack-lg">
<dl class="ts-kv"><div><dt>API URL</dt><dd class="ts-mono">@DatabaseConnections.ApiUrl</dd></div><div><dt>Project ID</dt><dd class="ts-mono">@Model.Database.ProjectId</dd></div><div><dt>Database</dt><dd class="ts-mono">@Model.Database.Name</dd></div></dl>
<p class="ts-meta">For Document HTTP, HTTP SQL and libSQL, <a class="ts-link" href="https://docs.terrascale.tech/guides/authentication" @(ExternalLink.Attributes)>exchange a project API key for an access token@(ExternalLink.Hint)</a>. Send it as Authorization: Bearer &lt;access-token&gt;; renew it according to expires_in. Use documents:read for reads and documents:write for writes. Keep keys and tokens in your server's secret store.</p>
@foreach(var connection in DatabaseConnections.For(Model.Database.ProjectId, Model.Database.Name)){
var signal = "$_dbConnect" + connection.Id;
<div class="ts-stack-sm" data-signals="@("{_dbConnect" + connection.Id + ": ''}")">
<div class="ts-snippet">
<div class="ts-snippet-header ts-row-between"><span id="@("db-connect-" + connection.Id + "-label")">@connection.Label</span><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" aria-label="@("Copy " + connection.Label + " URL")" aria-describedby="@("db-connect-" + connection.Id + "-status")" data-on:click="@(signal + " = 'Copying…'; Promise.resolve().then(() => navigator.clipboard.writeText(el.closest('.ts-snippet').querySelector('code').textContent)).then(() => " + signal + " = 'Copied', () => " + signal + " = 'Copy failed. Select and copy the URL manually.')")">@Icons.Render("Copy",14)<span>Copy</span></button></div>
<pre class="ts-snippet-body" tabindex="0" aria-labelledby="@("db-connect-" + connection.Id + "-label")"><code id="@("db-connect-" + connection.Id)">@connection.Url</code></pre>
</div>
<p class="ts-meta">@connection.Hint <a class="ts-link" href="@("https://docs.terrascale.tech/" + connection.Guide)" @(ExternalLink.Attributes)>@(connection.Label + " guide") →@(ExternalLink.Hint)</a></p>
<p class="ts-meta" id="@("db-connect-" + connection.Id + "-status")" role="status" aria-live="polite" aria-atomic="true" data-text="@signal"></p>
</div>
}
</div></section>
var activity = Model.Activity!;
<section class="ts-card" id="activity" aria-labelledby="activity-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="activity-title">Activity</h2><p class="ts-card-description">Reads, writes, storage and approximate p95 latency per region</p></div><div class="ts-card-actions"><a class="ts-link" href="@("/analytics?database=" + Uri.EscapeDataString(Model.Database.Id) + "&range=" + Model.Range)">View analytics →</a></div></header><div class="ts-card-body"><div class="ts-grid ts-grid-2">
@foreach(var card in activity.Cards){<section class="ts-card ts-card-boxed" aria-label="@card.Title"><header class="ts-card-head"><div class="ts-card-heading"><h3 class="ts-card-title">@card.Title</h3></div><div class="ts-card-actions"><nav class="ts-segmented" aria-label="@(card.Title + " range")">@foreach(var value in new[]{"1h","24h","7d","30d"}){<a class="ts-segment" href="@Model.RangePath(card.Key,value)" aria-current="@(value == card.Range ? "page" : null)">@value</a>}</nav></div></header><div class="ts-card-body">
@if(card.Plot is { Paths.Count: > 0 } plot){<ul class="ts-chart-legend" aria-label="Chart series">@foreach(var path in plot.Paths){<li class="ts-chart-legend-item"><svg class="ts-chart-swatch @path.Class" viewBox="0 0 32 8" aria-hidden="true"><line x1="0" x2="32" y1="4" y2="4" stroke-dasharray="@path.Dash"></line></svg><span class="ts-mono">@path.Name</span></li>}</ul><div class="ts-chart-shell" role="region" aria-label="@(card.Title + " chart")" tabindex="0">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Analytics.AnalyticsLineView,TerraScale.Dashboard.Features.Analytics.AnalyticsLinePlot>(plot))</div>}
else if(card.Failed){<div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Activity unavailable</p><p class="ts-alert-body">@card.Message</p></div>}
else{<div class="ts-empty" role="status"><p class="ts-empty-title">@card.Message</p></div>}
</div></section>}
</div></div></section>
}else if(Model.Tab == "replication"){
@if(Model.Measurements is { } topology){@(await RenderPartialAsync<TerraScale.Dashboard.Features.Databases.DatabaseTopologyView,DatabaseReplicationModel>(new(topology,Model.Context.Project!.Id,Model.Database.Id,Model.Range,Model.Database,Model.Activity)))}
<section class="ts-card ts-card-boxed" id="placement" aria-labelledby="placement-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="placement-title">Placement</h2><p class="ts-card-description">Configured regions for this database</p></div></header><div class="ts-card-body"><dl class="ts-db-facts"><div><dt>Home region</dt><dd>@DatabasesPage.RegionDisplay(Model.Database.Region)</dd></div><div><dt>Configured regions</dt><dd>@Model.Placement</dd></div><div><dt>Placement policy</dt><dd>@(Model.Database.AllRegions ? "All serving regions, including regions added later" : "Explicit regions")</dd></div></dl>
@if(Model.PlacementSaved){<div class="ts-alert ts-alert-success" role="status"><p class="ts-alert-body">Placement saved.</p></div>}
@if(Model.PlacementDraft is not null){<p class="ts-hint">Your submitted selections are kept below. The summary above shows the saved configuration.</p>}
@if(Model.Context.CanManage){<form method="post" action="/api/v1/dashboard/databases/regions" class="ts-form" aria-label="Change regions" data-signals="@("{_allRegions: " + (Model.SelectedAllRegions ? "true" : "false") + ", _regionCount: " + Model.SelectedRegions.Count + "}")"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><div class="ts-field"><label class="ts-check"><input type="checkbox" name="allRegions" value="true" checked="@Model.SelectedAllRegions" aria-describedby="database-all-regions-hint" data-on:change="$_allRegions = el.checked" />All regions: copies follow new regions automatically</label><p class="ts-hint" id="database-all-regions-hint">Keeps copies in every currently serving region and follows regions added later. Clear it to save an explicit selection of regions.</p></div><fieldset class="ts-field ts-db-regions" data-effect="@("el.querySelector('input[required]').setCustomValidity(!$_allRegions && $_regionCount < 2 ? '" + DatabaseService.MinimumRegionsMessage + "' : '')")" disabled="@Model.SelectedAllRegions" aria-describedby="database-placement-hint database-placement-error" data-attr:aria-invalid="!$_allRegions &amp;&amp; $_regionCount &lt; 2" data-attr:disabled="$_allRegions" data-on:change="$_regionCount = el.querySelectorAll('input[type=checkbox]:checked').length"><legend class="ts-label">Regions</legend><div class="ts-db-region-grid" id="database-placement">@foreach(var region in Model.Choices.OrderBy(choice => Regions.Rank(choice.Code))){<label class="ts-db-region-card"><input type="checkbox" name="region" value="@region.Code" checked="@Model.SelectedRegions.Contains(region.Code, StringComparer.OrdinalIgnoreCase)" required="@(region.Code == Model.Database.Region)" />@if(region.Country.Length > 0){<img src="@Assets.Url("flags/" + region.Country + ".svg")" alt="" aria-hidden="true" />}<span class="ts-db-region-text"><span class="ts-db-region-name">@region.Name</span><span class="ts-meta ts-mono">@region.Code</span></span>@if(region.Code==Model.Database.Region){<span class="ts-badge ts-badge-neutral">Home</span>}</label>}</div><p class="ts-field-error" id="database-placement-error" hidden="@(Model.SelectedAllRegions || Model.SelectedRegions.Count >= 2)" data-attr:hidden="$_regionCount >= 2 || $_allRegions" role="alert">@DatabaseService.MinimumRegionsMessage</p><p class="ts-hint" id="database-placement-hint">@(Model.RegionsError.Length > 0 ? Model.RegionsError : DatabasesPage.RegionDisplay(Model.Database.Region) + " is the home region and stays selected. With All regions cleared, keep at least two regions. Selecting every current region does not include future regions. Add a region to replicate the database there; remove one to stop serving it there.")</p></fieldset><div class="ts-row"><button class="ts-btn ts-btn-secondary" type="submit">Save regions</button></div></form>}
</div></section>
<p class="ts-meta ts-measurement-loading" role="status">Loading replication measurements…</p>
@if(Model.Measurements is { } measurements){@(await RenderPartialAsync<TerraScale.Dashboard.Features.Databases.DatabaseReplicationView,DatabaseReplicationModel>(new(measurements,Model.Context.Project!.Id,Model.Database.Id,Model.Range)))}
}else if(Model.Tab == "danger"){
@if(Model.Context.CanManage){<section class="ts-card ts-card-boxed ts-db-danger" aria-labelledby="danger-zone-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="danger-zone-title">Danger zone</h2><p class="ts-card-description">Actions here cannot be undone.</p></div></header><div class="ts-db-danger-row"><div class="ts-list-main"><h3 class="ts-section-title">Delete database</h3><p class="ts-meta">Permanently remove @Model.Database.Name and its data. This cannot be undone.</p></div><button class="ts-btn ts-btn-danger" type="button" command="show-modal" commandfor="delete-database">@Icons.Render("Trash2",15)<span>Delete database</span></button></div><div class="ts-db-danger-row"><div class="ts-list-main"><h3 class="ts-section-title">Overwrite from a backup</h3><p class="ts-meta">Overwriting this database is unavailable. Restore a backup into a new database from Backups instead.</p></div><button class="ts-btn ts-btn-danger" type="button" disabled>Overwrite</button></div></section><dialog id="delete-database" class="ts-dialog" closedby="any" aria-labelledby="delete-database-title" data-init="@(Model.OpenDelete ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="delete-database-title">Delete @Model.Database.Name</h2><p class="ts-dialog-description">This permanently removes the database and all of its data.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="delete-database">@Icons.Render("X",18)</button></header><form method="post" action="/api/v1/dashboard/databases/delete" data-submit-once class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />@if(Model.Error.Length > 0 && Model.OpenDelete){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}<div class="ts-field"><label class="ts-label" for="confirm-name">Type @Model.Database.Name to confirm</label><input class="ts-input" id="confirm-name" name="confirmName" required autocomplete="off" /></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="delete-database">Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Delete database</button></div></form></div></dialog>}else{<div class="ts-alert ts-alert-info" role="status"><p class="ts-alert-body">Only organization members who can manage databases can delete this database.</p></div>}
 }else if(Model.Tab == "branches"){
<section class="ts-card" id="branches" aria-labelledby="branches-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="branches-title">Branches</h2><p class="ts-card-description">Create an independent snapshot of @Model.Database.Name</p></div></header><div class="ts-card-body ts-stack-lg">
<div class="ts-stack-sm"><p>A branch copies the full database snapshot, including its data, schema and indexes. Later writes to the branch and the source are independent.</p>
<p class="ts-meta">The branch stays in this project and follows its access rules. Project-wide credentials can reach it; credentials restricted to the source database do not gain access to the branch.</p>
<p class="ts-meta">Branches count toward your organization's shared database and storage allowances. Storage usage is counted for each serving region. <a class="ts-link" href="https://docs.terrascale.tech/pricing/" @(ExternalLink.Attributes)>View allowances and pricing@(ExternalLink.Hint)</a>.</p></div>
<div class="ts-row">@if(Model.Context.CanManage && Model.Database.Status=="ready"){<form method="post" action="/api/v1/dashboard/databases/branch" data-submit-once><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" /><button type="submit" class="ts-btn ts-btn-primary">@Icons.Render("GitBranch",16)<span>Create preview branch</span></button></form><button class="ts-btn ts-btn-secondary" type="button" command="show-modal" commandfor="name-branch">@Icons.Render("Pencil",15)<span>Choose a branch name</span></button>}
<a class="ts-link" href="https://docs.terrascale.tech/guides/migrations" @(ExternalLink.Attributes)>Compare schemas with the CLI@(ExternalLink.Hint)</a></div>
@if(Model.Branches.Count == 0){<p class="ts-meta" role="status">No branches of this database yet.</p>}else{<ul class="ts-db-branches" aria-label="Branches of @Model.Database.Name">@foreach(var branch in Model.Branches){<li class="ts-db-branch"><a class="ts-db-branch-name ts-mono" href="@DatabaseService.Path(branch.Id)">@branch.Name</a><span class="ts-badge @(branch.Status == "ready" ? "ts-badge-success" : branch.Status == "failed" ? "ts-badge-danger" : branch.Status is "provisioning" or "accepted" or "pending" ? "ts-badge-warning" : "ts-badge-neutral")"><span class="ts-dot" aria-hidden="true"></span>@branch.Status</span><span class="ts-meta ts-mono">@branch.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</span></li>}</ul>}</div></section>
@if(Model.Context.CanManage && Model.Database.Status=="ready"){
<dialog id="name-branch" class="ts-dialog" closedby="any" aria-labelledby="name-branch-title" aria-describedby="name-branch-description" data-init="@(Model.OpenBranch ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="name-branch-title">Create branch</h2><p class="ts-dialog-description" id="name-branch-description">Copy the full snapshot of @Model.Database.Name into a new database in this project. It shares your organization's allowances and project access rules.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="name-branch">@Icons.Render("X",18)</button></header>
<form method="post" action="/api/v1/dashboard/databases/branch" data-submit-once class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />
@if(Model.OpenBranch){<div class="ts-alert ts-alert-danger" id="branch-error" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}
<div class="ts-field"><label class="ts-label" for="branch-name">New database name</label><input class="ts-input" id="branch-name" name="name" value="@Model.BranchName" pattern="@DatabaseService.NameInputPattern" title="@DatabaseService.NameHint" maxlength="63" required autofocus aria-describedby="@(Model.OpenBranch ? "branch-name-hint branch-error" : "branch-name-hint")" /><p class="ts-hint" id="branch-name-hint">@DatabaseService.NameHint</p></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="name-branch">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Create branch</button></div></form></div></dialog>
}
}else if(Model.Tab == "import"){
<section class="ts-card ts-card-boxed" id="import" aria-labelledby="import-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="import-title">Import and export</h2><p class="ts-card-description">Copy every live document out as NDJSON, or import an export into a new database</p></div></header><div class="ts-card-body ts-stack-lg">
<div class="ts-stack-sm"><h3 class="ts-label" id="export-title">Export</h3><p class="ts-meta">One line per live document, <code>{"collection","id","document"}</code>, ordered by collection then id and read from one snapshot. Deleted documents, indexes and schemas are not included. A download that stops early is incomplete: download it again.</p><div class="ts-row"><a class="ts-btn ts-btn-secondary" href="@DatabaseService.Path(Model.Database.Id, "export")" download="@(Model.Database.Name + ".ndjson")" aria-describedby="export-title">@Icons.Render("Download",16)<span>Export NDJSON</span></a></div></div>
<div class="ts-stack-sm"><h3 class="ts-label">Import</h3><p class="ts-meta">An import creates a new database; existing databases are never written. Upload this export, an NDJSON file from MongoDB or Firestore, a PostgreSQL dump or a Turso or SQLite file.</p><a class="ts-link" href="/imports">Import into a new database →</a></div></div></section>
}else{
@if(Model.Backups is { } backupPage){@(await RenderPartialAsync<TerraScale.Dashboard.Features.Backups.BackupSection,TerraScale.Dashboard.Features.Backups.BackupPage>(backupPage))}
}
</main>
@functions { public ShellModel LayoutModel => Model.Shell; }
