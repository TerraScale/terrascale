@using TerraScale.Dashboard.Common.Charts
@inherits RazorSlice<TerraScale.Dashboard.Features.Databases.DatabaseDetailPage>
@using TerraScale.Dashboard.Features.Databases
@inject AssetUrls Assets
<main id="database-detail" class="ts-page" data-database-id="@Model.Database.Id">
@(await RenderPartialAsync<TerraScale.Dashboard.Common.Databases.DatabaseFrame,DatabaseFrameModel>(new(Model.Database, Model.Tab, Model.Serving, Model.Context.Project?.Databases.Values)))
@if(Model.Tab != "backups"){<h1 class="ts-sr-only">@DatabaseFrameModel.Title(Model.Tab)</h1>}
@if(Model.Error.Length > 0 && !Model.OpenBranch && !(Model.OpenDelete && Model.Context.CanManage && Model.Tab == "danger")){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}
@if(Model.Created){<div class="ts-alert ts-db-created ts-alert-@Model.CreatedState.Tone" data-status="@Model.Database.Status"><span class="ts-db-created-mark" aria-hidden="true">@Icons.Render(Model.CreatedState.Tone == "success" ? "Check" : "Database",18)</span><div class="ts-list-main"><p class="ts-alert-title">@Model.CreatedState.Title</p><p class="ts-alert-body">@Model.CreatedState.Body</p></div></div>}
@if(Model.Tab == "overview"){
<dl class="ts-stats" aria-label="Database summary"><div class="ts-stat"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Tables</dt><dd class="ts-stat-value">@(Model.Tables?.Tables.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</dd></div><div class="ts-stat"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Rows</dt><dd class="ts-stat-value" title="@(Model.Tables?.Rows.ToString("N0", System.Globalization.CultureInfo.InvariantCulture))">@(Model.Tables is { } counted ? ChartGeometry.Compact(counted.Rows) : "—")</dd></div><div class="ts-stat"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Storage</dt><dd class="ts-stat-value">@(Model.StorageBytes is { } bytes ? TerraScale.Dashboard.Common.Formatting.MetricFormat.Bytes(bytes) : "—")</dd></div><div class="ts-stat"><dt class="ts-stat-label"><span class="ts-dot" aria-hidden="true"></span>Restore points</dt><dd class="ts-stat-value">@(Model.Backups?.Listing?.Backups.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</dd></div></dl>
<div class="ts-columns ts-db-overview">
<div class="ts-columns-main">
<section class="ts-card" id="activity" aria-labelledby="activity-title"><header class="ts-card-head ts-card-head-title-actions"><div class="ts-card-heading"><h2 class="ts-card-title" id="activity-title">Activity</h2></div><div class="ts-card-actions"><nav class="ts-segmented" aria-label="Activity range">@foreach(var value in TerraScale.Dashboard.Features.Home.HomePage.Ranges){<a class="ts-segment" href="@Model.RangePath(value)" aria-current="@(value == Model.Range ? "page" : null)">@value</a>}</nav><a class="ts-link" href="@("/analytics?database=" + Uri.EscapeDataString(Model.Database.Id) + "&range=" + Model.Range)">View analytics →</a></div></header><div class="ts-card-body"><div class="ts-grid ts-grid-2">
@foreach(var card in Model.Activity?.Cards ?? []){<section class="ts-card ts-card-boxed" aria-label="@card.Title"><header class="ts-card-head"><div class="ts-card-heading"><h3 class="ts-card-title">@card.Title</h3></div></header><div class="ts-card-body">
@if(card.Plot is { Paths.Count: > 0 } plot){<ul class="ts-chart-legend" aria-label="Chart series">@foreach(var path in plot.Paths){<li class="ts-chart-legend-item"><svg class="ts-chart-swatch @path.Class" viewBox="0 0 32 8" aria-hidden="true"><line x1="0" x2="32" y1="4" y2="4" stroke-dasharray="@path.Dash"></line></svg><span class="ts-mono">@path.Name</span></li>}</ul><div class="ts-chart-shell" role="region" aria-label="@(card.Title + " chart")" tabindex="0">@(await RenderPartialAsync<TerraScale.Dashboard.Features.Analytics.AnalyticsLineView,TerraScale.Dashboard.Features.Analytics.AnalyticsLinePlot>(plot))</div>}
else if(card.Failed){<div class="ts-alert ts-alert-warning" role="alert"><p class="ts-alert-title">Activity unavailable</p><p class="ts-alert-body">@card.Message</p></div>}
else{<div class="ts-empty" role="status"><p class="ts-empty-title">@card.Message</p></div>}
</div></section>}
</div></div></section>
</div>
<div class="ts-columns-side">
<section class="ts-card ts-card-boxed" id="overview-regions" aria-labelledby="overview-regions-title"><header class="ts-card-head ts-card-head-title-actions"><div class="ts-card-heading"><h2 class="ts-card-title" id="overview-regions-title">Regions</h2></div><div class="ts-card-actions"><a class="ts-link" href="@DatabaseService.Path(Model.Database.Id, "replication")">Manage regions →</a></div></header><div class="ts-card-body">@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.RegionMap, RegionMapModel>(Model.OverviewMap))</div></section>
<section class="ts-card ts-card-boxed" id="details" aria-labelledby="details-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="details-title">Details</h2></div></header><div class="ts-card-body"><dl class="ts-kv"><div><dt>Created</dt><dd><time datetime="@Model.Database.CreatedAt.ToString("O",System.Globalization.CultureInfo.InvariantCulture)">@Model.Database.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</time></dd></div><div><dt>Expires</dt><dd>@if(Model.Database.ExpiresAt is { } expires){<time datetime="@expires.ToString("O",System.Globalization.CultureInfo.InvariantCulture)">@expires.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</time>}else{<span>Never</span>}</dd></div><div><dt>Database ID</dt><dd><code>@Model.Database.Id</code></dd></div></dl></div></section>
</div>
</div>
}else if(Model.Tab == "connect"){
<section class="ts-card ts-card-boxed" id="connect" aria-labelledby="connect-title">
<header class="ts-card-head ts-card-head-title-actions"><div class="ts-card-heading"><h2 class="ts-card-title" id="connect-title">Connect</h2></div><div class="ts-card-actions"><a class="ts-link" href="https://docs.terrascale.tech/guides/authentication" @(ExternalLink.Attributes)>Authentication guide@(ExternalLink.Hint)</a><a class="ts-btn ts-btn-primary ts-btn-sm" href="/api-keys">@Icons.Render("KeyRound",14)<span>Create API key</span></a></div></header>
<div class="ts-card-body ts-stack-lg">
<div class="ts-stack-sm" data-signals="{_dbEndpointCopy: ''}"><dl class="ts-kv ts-db-endpoint">@foreach(var (field, label, value) in new[]{("api-url", "API URL", DatabaseConnections.ApiUrl), ("database-id", "Database ID", Model.Database.Id)}){<div><dt id="@("db-connect-" + field + "-label")">@label</dt><dd><code id="@("db-connect-" + field)">@value</code><button class="ts-icon-btn" type="button" value="@value" aria-label="@("Copy " + label)" aria-describedby="db-connect-endpoint-status" data-on:click="$_dbEndpointCopy = 'Copying…'; Promise.resolve().then(() => navigator.clipboard.writeText(el.value)).then(() => $_dbEndpointCopy = 'Copied', () => $_dbEndpointCopy = 'Copy failed. Select and copy it manually.')">@Icons.Render("Copy",14)</button></dd></div>}</dl><p class="ts-meta" id="db-connect-endpoint-status" role="status" aria-live="polite" aria-atomic="true" data-text="$_dbEndpointCopy"></p></div>
@foreach(var connection in DatabaseConnections.For(Model.Database.ProjectId, Model.Database.Name)){
var signal = "$_dbConnect" + connection.Id;
<div class="ts-stack-sm" data-signals="@("{_dbConnect" + connection.Id + ": ''}")">
<div class="ts-snippet">
<div class="ts-snippet-header ts-row-between"><span id="@("db-connect-" + connection.Id + "-label")">@connection.Label</span><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" aria-label="@("Copy " + connection.Label)" aria-describedby="@("db-connect-" + connection.Id + "-status")" data-on:click="@(signal + " = 'Copying…'; Promise.resolve().then(() => navigator.clipboard.writeText(el.closest('.ts-snippet').querySelector('code').textContent)).then(() => " + signal + " = 'Copied', () => " + signal + " = 'Copy failed. Select and copy it manually.')")">@Icons.Render("Copy",14)<span>Copy</span></button></div>
<pre class="ts-snippet-body" tabindex="0" aria-labelledby="@("db-connect-" + connection.Id + "-label")"><code id="@("db-connect-" + connection.Id)">@connection.Text</code></pre>
</div>
<p class="ts-meta"><a class="ts-link" href="@("https://docs.terrascale.tech/" + connection.Guide)" @(ExternalLink.Attributes)>@(connection.Label + " guide") →@(ExternalLink.Hint)</a></p>
<p class="ts-meta" id="@("db-connect-" + connection.Id + "-status")" role="status" aria-live="polite" aria-atomic="true" data-text="@signal"></p>
</div>
}
@{ var sdks = DatabaseConnections.Sdks(Model.Database.ProjectId, Model.Database.Name); }
<div class="ts-stack-sm" id="db-connect-sdk" data-signals="@("{_dbSdk: '" + sdks[0].Id + "', _dbSdkCopy: ''}")">
<div class="ts-snippet">
<div class="ts-snippet-header sdk-tabs-header"><div class="sdk-tabs" role="tablist" aria-label="SDK language" data-sdk-tabs>@foreach(var sdk in sdks){<button class="sdk-tab" type="button" role="tab" id="@("db-sdk-tab-" + sdk.Id)" aria-controls="@("db-sdk-panel-" + sdk.Id)" aria-selected="@(sdk.Id == sdks[0].Id ? "true" : "false")" tabindex="@(sdk.Id == sdks[0].Id ? "0" : "-1")" data-sdk="@sdk.Id" data-on:click="@("$_dbSdk = '" + sdk.Id + "'; $_dbSdkCopy = ''")"><img src="@Assets.Url("language-icons/" + (sdk.Id == "js" ? "javascript" : sdk.Id) + ".svg")" width="16" height="16" alt="" aria-hidden="true" />@sdk.Label</button>}</div><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" aria-label="Copy SDK snippet" aria-describedby="db-connect-sdk-status" data-on:click="$_dbSdkCopy = 'Copying…'; Promise.resolve().then(() => navigator.clipboard.writeText(document.querySelector('#db-connect-sdk code[data-sdk=&quot;' + $_dbSdk + '&quot;]').textContent)).then(() => $_dbSdkCopy = 'Copied', () => $_dbSdkCopy = 'Copy failed. Select and copy it manually.')">@Icons.Render("Copy",14)<span>Copy</span></button></div>
@foreach(var sdk in sdks){<pre class="ts-snippet-body" role="tabpanel" id="@("db-sdk-panel-" + sdk.Id)" tabindex="0" aria-labelledby="@("db-sdk-tab-" + sdk.Id)" hidden="@(sdk.Id == sdks[0].Id ? null : "hidden")" data-attr:hidden="@("$_dbSdk !== '" + sdk.Id + "'")"><code data-sdk="@sdk.Id">@sdk.Code</code></pre>}
</div>
<p class="ts-meta" id="db-connect-sdk-status" role="status" aria-live="polite" aria-atomic="true" data-text="$_dbSdkCopy"></p>
</div>
</div></section>
}else if(Model.Tab == "tables"){
@if(Model.CreatedTable.Length > 0){<div class="ts-alert ts-alert-success" role="status"><p class="ts-alert-body">Created table @Model.CreatedTable.</p></div>}
@(await RenderPartialAsync<DatabaseTablesView, DatabaseDetailPage>(Model))
@if(Model.Context.CanWriteProjectData){
@(await RenderPartialAsync<TerraScale.Dashboard.Features.Databases.CreateTableDialog, DatabaseDetailPage>(Model))
<dialog id="insert-row" class="ts-dialog" closedby="any" aria-labelledby="insert-row-title"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="insert-row-title">Add row</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="insert-row">@Icons.Render("X",18)</button></header>
<form id="insert-row-form" method="dialog" class="ts-form" data-insert-row><div class="ts-alert ts-alert-danger" role="alert" data-insert-error hidden><p class="ts-alert-body"></p></div><div class="ts-form" data-insert-fields></div>
<div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="insert-row">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Add row</button></div></form></div></dialog>
<dialog id="delete-row" class="ts-dialog" closedby="any" aria-labelledby="delete-row-title"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="delete-row-title">Delete row</h2><p class="ts-dialog-description">This permanently deletes the row.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="delete-row">@Icons.Render("X",18)</button></header>
<form id="delete-row-form" method="dialog" class="ts-form" data-delete-row-form><div class="ts-alert ts-alert-danger" role="alert" data-delete-error hidden><p class="ts-alert-body"></p></div><code class="ts-studio-delete-sql" data-delete-sql></code>
<div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="delete-row">Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Delete row</button></div></form></div></dialog>
<template id="table-row-delete-template"><button class="ts-icon-btn ts-studio-row-delete" type="button" data-delete-row aria-label="Delete row">@Icons.Render("Trash2",14)</button></template>
}
}else if(Model.Tab == "conflicts"){
@(await RenderPartialAsync<DatabaseConflictsView, DatabaseDetailPage>(Model))
}else if(Model.Tab == "replication"){
<section class="ts-card ts-card-boxed" id="regions" aria-labelledby="regions-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="regions-title">Regions</h2></div></header><div class="ts-card-body">
@if(Model.RegionsForm is { Notice.Length: 0 } && Model.Error.Length == 0){<div class="ts-alert ts-alert-success" id="regions-saved" role="status"><p class="ts-alert-body">Regions saved.</p></div>}
@if(Model.RegionsForm is { Notice.Length: > 0 } pending){<div class="ts-alert ts-alert-warning" id="regions-pending" role="status"><p class="ts-alert-body">@pending.Notice</p></div>}
@if(Model.CanPlace){
<form method="post" action="/api/v1/dashboard/databases/placement" class="ts-form" data-on:submit="evt.preventDefault(); @@post(el.action, {contentType: 'form'})"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />
@foreach(var region in Model.Choices){<input type="hidden" name="offered" value="@region.Code" />}
@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.RegionMap, RegionMapModel>(Model.RegionMap))
<footer class="ts-card-foot"><button class="ts-btn ts-btn-primary" type="submit">Save regions</button></footer></form>
}else{
@(await RenderPartialAsync<TerraScale.Dashboard.Common.UI.Slices.RegionMap, RegionMapModel>(Model.RegionMap))
}
</div></section>
@(await RenderPartialAsync<DatabaseReplicationView, DatabaseDetailPage>(Model))
}else if(Model.Tab == "danger"){
@if(Model.Context.CanManage){<section class="ts-card ts-card-boxed ts-db-danger" aria-labelledby="danger-zone-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="danger-zone-title">Delete database</h2><p class="ts-meta">Permanently removes this database and all of its data.</p></div><div class="ts-card-actions"><button class="ts-btn ts-btn-danger" type="button" command="show-modal" commandfor="delete-database">@Icons.Render("Trash2",15)<span>Delete database</span></button></div></header></section><dialog id="delete-database" class="ts-dialog" closedby="any" aria-labelledby="delete-database-title" data-init="@(Model.OpenDelete ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="delete-database-title">Delete @Model.Database.Name</h2><p class="ts-dialog-description">This permanently removes the database and all of its data.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="delete-database">@Icons.Render("X",18)</button></header><form method="post" action="/api/v1/dashboard/databases/delete" data-submit-once class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />@if(Model.Error.Length > 0 && Model.OpenDelete){<div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}<div class="ts-field"><label class="ts-label" for="confirm-name">Type @Model.Database.Name to confirm</label><input class="ts-input" id="confirm-name" name="confirmName" required autocomplete="off" /></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="delete-database">Cancel</button><button class="ts-btn ts-btn-danger" type="submit">Delete database</button></div></form></div></dialog>}else{<div class="ts-alert ts-alert-info" role="status"><p class="ts-alert-body">Requires management access</p></div>}
 }else if(Model.Tab == "branches"){
<section class="ts-card" id="branches" aria-labelledby="branches-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="branches-title">Forks</h2></div>@if(Model.Branches.Count > 0 && Model.Context.CanManage && Model.Database.Status == "ready"){<div class="ts-card-actions"><button class="ts-btn ts-btn-primary ts-btn-sm" type="button" command="show-modal" commandfor="name-branch">@Icons.Render("GitBranch",16)<span>Fork database</span></button></div>}</header><div class="ts-card-body ts-stack-lg">
<dl class="ts-kv"><div><dt>Expires</dt><dd>@if(Model.Database.ExpiresAt is { } expiry){<time datetime="@expiry.ToString("O",System.Globalization.CultureInfo.InvariantCulture)">@expiry.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</time>}else{<span>Never</span>}</dd></div></dl>
@if(Model.Database.BranchedFrom is { Length: > 0 } source && Model.Context.Project!.Databases.TryGetValue(source, out var parent)){<p class="ts-meta">Forked from <a class="ts-link ts-mono" href="@DatabaseService.Path(parent.Id)">@parent.Name</a></p>}
@if(Model.Branches.Count == 0){<div class="ts-empty" role="status"><p class="ts-empty-title">No forks yet.</p>@if(Model.Context.CanManage && Model.Database.Status == "ready"){<div class="ts-empty-actions"><button class="ts-btn ts-btn-primary ts-btn-sm" type="button" command="show-modal" commandfor="name-branch">@Icons.Render("GitBranch",16)<span>Fork database</span></button></div>}</div>}else{<ul class="ts-rows" aria-label="Forks of @Model.Database.Name">@foreach(var branch in Model.Branches){<li><div class="ts-stack-sm"><span class="ts-rows-title ts-mono" >@branch.Name</span><span class="ts-rows-meta"><time datetime="@branch.CreatedAt.ToString("O",System.Globalization.CultureInfo.InvariantCulture)">@branch.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</time></span></div><span class="ts-badge @(branch.Status == "ready" ? "ts-badge-success" : branch.Status == "failed" ? "ts-badge-danger" : branch.Status is "provisioning" or "accepted" or "pending" ? "ts-badge-warning" : "ts-badge-neutral")"><span class="ts-dot" aria-hidden="true"></span>@branch.Status</span><span class="ts-rows-size">Expires @if(branch.ExpiresAt is { } branchExpiry){<time datetime="@branchExpiry.ToString("O",System.Globalization.CultureInfo.InvariantCulture)">@branchExpiry.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture)</time>}else{<text>Never</text>}</span><div class="ts-rows-actions"><a class="ts-btn ts-btn-secondary ts-btn-sm" href="@DatabaseService.Path(branch.Id)">Open</a></div></li>}</ul>}</div></section>
@if(Model.Context.CanManage && Model.Database.Status=="ready"){
<dialog id="name-branch" class="ts-dialog" closedby="any" aria-labelledby="name-branch-title" data-init="@(Model.OpenBranch ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="name-branch-title">Fork database</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="name-branch">@Icons.Render("X",18)</button></header>
<form method="post" action="/api/v1/dashboard/databases/branch" data-submit-once class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="databaseId" value="@Model.Database.Id" />
@if(Model.OpenBranch && Model.Error.Length > 0){<div class="ts-alert ts-alert-danger" id="branch-error" role="alert"><p class="ts-alert-body">@Model.Error</p></div>}
<div class="ts-field"><label class="ts-label" for="branch-name">New database name</label><input class="ts-input" id="branch-name" name="name" value="@Model.BranchName" pattern="@DatabaseService.NameInputPattern" title="@DatabaseService.NameHint" maxlength="63" required autofocus placeholder="@(Model.Database.Name + "-preview")" aria-describedby="@(Model.OpenBranch && Model.Error.Length > 0 ? "branch-error" : null)" /></div><div class="ts-field"><label class="ts-label" for="fork-time">Point in time (UTC)</label><input class="ts-input" id="fork-time" name="pointInTime" type="datetime-local" step="1" value="@Model.PointInTime" /></div><div class="ts-field"><label class="ts-label" for="fork-ttl">TTL (hours)</label><input class="ts-input" id="fork-ttl" name="ttlHours" type="number" min="@DatabaseTtl.MinimumHours" max="8760" step="any" value="@Model.TtlHours" placeholder="24" /></div><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="name-branch">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Fork database</button></div></form></div></dialog>
}
}else{
@if(Model.Backups is { } backupPage){@(await RenderPartialAsync<TerraScale.Dashboard.Features.Backups.BackupSection,TerraScale.Dashboard.Features.Backups.BackupPage>(backupPage))}
}
</main>
