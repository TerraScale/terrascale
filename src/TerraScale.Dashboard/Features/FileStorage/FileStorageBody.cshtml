@inherits RazorSlice<TerraScale.Dashboard.Features.FileStorage.FileStoragePage>
@using TerraScale.Dashboard.Features.FileStorage
@if (Model.Settings)
{
    @(await RenderPartialAsync<BucketSide, BucketSideModel>(BucketSideModel.For(Model)))
}
else
{
    @(await RenderPartialAsync<BucketStats, BucketSideModel>(BucketSideModel.For(Model)))
    @(await RenderPartialAsync<BucketFilesCard, BucketFilesCardModel>(BucketFilesCardModel.For(Model)))
}
