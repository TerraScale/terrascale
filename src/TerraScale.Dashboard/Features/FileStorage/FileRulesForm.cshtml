@inherits RazorSlice<TerraScale.Dashboard.Features.FileStorage.FileRulesFormModel>
<div class="ts-field"><label class="ts-label" for="@(Model.Prefix)-owner">Owner field</label><input class="ts-input ts-mono" id="@(Model.Prefix)-owner" name="owner" value="@Model.Rules.Owner" placeholder="/userId" maxlength="4096" pattern="(\/[^\/]+){1,16}" title="A JSON Pointer into the file metadata, such as /userId." autocomplete="off" spellcheck="false" readonly="@Model.Existing" /></div>
<div class="ts-files-rules">
    @foreach (var (key, legend, policy) in new[] { ("read", "Read access", Model.Rules.Read), ("write", "Write access", Model.Rules.Write) })
    {
        <fieldset class="ts-files-rule">
            <legend class="ts-label">@legend</legend>
            <label class="ts-check"><input type="checkbox" name="@(key + "Owner")" value="1" checked="@policy.Owner" /><span>File owner</span></label>
            <label class="ts-check"><input type="checkbox" name="@(key + "Public")" value="1" checked="@policy.Public" /><span>All authenticated end users</span></label>
            <div class="ts-field"><label class="ts-label" for="@(Model.Prefix + "-" + key + "-roles")">Roles</label><input class="ts-input" id="@(Model.Prefix + "-" + key + "-roles")" name="@(key + "Roles")" value="@string.Join(", ", policy.Roles)" placeholder="@(key == "read" ? "editor, reviewer" : "editor")" maxlength="4160" pattern="[^\x00-\x1F\x7F]*" title="Comma-separated role names." autocomplete="off" spellcheck="false" /></div>
        </fieldset>
    }
</div>
