@inherits RazorSlice<TerraScale.Dashboard.Features.FileStorage.FileConfirmDialogModel>
<dialog id="@Model.Id" class="ts-dialog ts-files-dialog" closedby="any" aria-labelledby="@(Model.Id + "-title")" aria-describedby="@(Model.Id + "-description")" data-init="@(Model.Error is null ? "void 0" : "el.showModal()")">
    <div class="ts-dialog-content">
        <header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@(Model.Id + "-title")">@Model.Title</h2><p class="ts-dialog-description" id="@(Model.Id + "-description")">@Model.Consequence</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@Model.Id">@Icons.Render("X", 18)</button></header>
        <form method="post" action="@Model.Action" class="ts-form" data-submit-once>
            <input type="hidden" name="_csrf" value="@Model.CsrfToken" />
            @foreach (var field in Model.Fields) { <input type="hidden" name="@field.Key" value="@field.Value" /> }
            @if (Model.Error is { } error) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@error</p></div> }
            <div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="@Model.Id">Cancel</button><button class="ts-btn ts-btn-danger" type="submit">@Model.Button</button></div>
        </form>
    </div>
</dialog>
