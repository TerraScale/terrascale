@inherits RazorSlice<TerraScale.Dashboard.Features.FileStorage.FileStoragePage>
@implements IUsesLayout<TerraScale.Dashboard.Shared.UI.Slices.ShellDocument, ShellModel>
@using TerraScale.Dashboard.Features.FileStorage
@using TerraScale.DotNet.TerraBase
@inject AssetUrls Assets
@{
    var canWrite = Model.Shell.Context.CanWriteProjectData;
    var selectedId = Model.Listing?.BucketId;
    var selected = Model.Listing?.Buckets.Items.FirstOrDefault(bucket => bucket.Id == selectedId);
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    var defaults = new TerraBaseFileRules("/userId", new(true, false, []), new(true, false, []));
}
<main class="ts-page" data-project-id="@Model.Shell.Context.Project?.Id" data-organization-id="@Model.Shell.Context.Organization?.Id">
    <header class="ts-stack-sm"><h1>Files</h1><p class="ts-meta">Project buckets with owner and role permissions. Files share your plan's storage allowance with database data.</p></header>
    @if (Model.Error is { } error)
    {
        <div class="ts-alert ts-alert-danger" role="alert"><p>@error</p><a class="ts-link" href="/storage">Reload files</a></div>
    }
    @if (Model.Listing is { } listing)
    {
        <section class="ts-card" aria-label="File buckets"><div class="ts-card-header"><h2 class="ts-card-title">Buckets</h2></div>
            @if (listing.Buckets.Items.Count == 0)
            {
                <div class="ts-empty"><p class="ts-empty-title">No buckets yet</p><p class="ts-meta">Create a bucket to store project files and choose who can read or write them.</p></div>
            }
            else
            {
                <div class="ts-table-wrap"><table class="ts-table"><thead><tr><th>Bucket</th><th>Region</th><th>Owner field</th></tr></thead><tbody>
                @foreach (var bucket in listing.Buckets.Items)
                {
                    <tr><td><a class="ts-link" href="@BucketUrl(bucket.Id, listing.BucketAfter)" aria-current="@(bucket.Id == listing.BucketId ? "page" : null)">@bucket.Name</a></td><td>@bucket.Region</td><td><code>@(bucket.Rules.Owner ?? "None")</code></td></tr>
                }
                </tbody></table></div>
            }
            @if (listing.Buckets.Next is { } nextBucket)
            {
                <div class="ts-card-body"><a class="ts-link" href="@("/storage?bucketAfter=" + Uri.EscapeDataString(nextBucket))">More buckets</a></div>
            }
        </section>
        @if (canWrite)
        {
            <details class="ts-card ts-card-boxed"><summary class="ts-card-header">Create bucket</summary><div class="ts-card-body">
                <form method="post" action="/api/v1/dashboard/storage/bucket" class="ts-form">
                    <input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />
                    <div class="ts-field"><label class="ts-label" for="bucket-name">Bucket name</label><input class="ts-input" id="bucket-name" name="name" required maxlength="63" placeholder="avatars" /></div>
                    @(await RenderPartialAsync<FileRulesForm, FileRulesFormModel>(new("new-bucket", defaults)))
                    <div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Create bucket</button></div>
                </form>
            </div></details>
        }
        @if (listing.BucketId is { } bucketId && listing.Files is { } files)
        {
            <section class="ts-card" aria-label="Stored files"><div class="ts-card-header"><h2 class="ts-card-title">@(selected?.Name ?? "Selected bucket")</h2><p class="ts-meta">Completed files. Deleted and expired upload reservations remain in usage until cleanup succeeds.</p></div>
                @if (files.Items.Count == 0)
                {
                    <div class="ts-empty"><p class="ts-empty-title">No completed files</p><p class="ts-meta">Upload a file to this bucket to get started.</p></div>
                }
                else
                {
                    <div class="ts-table-wrap"><table class="ts-table"><thead><tr><th>Name</th><th>Size</th><th>Type</th><th>Actions</th></tr></thead><tbody>
                    @foreach (var file in files.Items)
                    {
                        <tr><td><span class="ts-strong">@file.Name</span><details><summary>Metadata</summary><pre><code>@file.Metadata.GetRawText()</code></pre></details></td><td class="ts-num">@file.Size.ToString("N0", culture) bytes</td><td>@file.ContentType</td><td>
                            <form method="post" action="/api/v1/dashboard/storage/download"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="bucket" value="@bucketId" /><input type="hidden" name="fileId" value="@file.Id" /><button class="ts-btn ts-btn-ghost" type="submit" aria-label="@("Download " + file.Name)">Download</button></form>
                            @if (canWrite)
                            {
                                <form method="post" action="/api/v1/dashboard/storage/delete"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="bucket" value="@bucketId" /><input type="hidden" name="fileId" value="@file.Id" /><button class="ts-btn ts-btn-ghost" type="submit" aria-label="@("Delete " + file.Name)">Delete file</button></form>
                            }
                        </td></tr>
                    }
                    </tbody></table></div>
                }
                @if (files.Next is { } next)
                {
                    <div class="ts-card-body"><a class="ts-link" href="@(BucketUrl(bucketId, listing.BucketAfter) + "&after=" + Uri.EscapeDataString(next))">More files</a></div>
                }
            </section>
            @if (canWrite)
            {
                <section class="ts-card ts-card-boxed" aria-label="Upload file"><div class="ts-card-header"><h2 class="ts-card-title">Upload file</h2></div><div class="ts-card-body">
                    <form class="ts-form" method="post" action="/api/v1/dashboard/storage/upload" data-file-upload>
                        <input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="bucket" value="@bucketId" />
                        <div class="ts-field"><label class="ts-label" for="storage-file">File</label><input class="ts-input" type="file" id="storage-file" name="file" required /><p class="ts-hint">1 byte–100 MiB. Your browser hashes the file before upload. Contents and metadata cannot be changed afterward.</p></div>
                        <div class="ts-field"><label class="ts-label" for="file-metadata">Metadata</label><textarea class="ts-input" id="file-metadata" name="metadata" rows="4" maxlength="16384" required>{}</textarea><p class="ts-hint">JSON object. Set the owner field to the intended end user's signed subject.</p></div>
                        <p class="ts-meta" role="status" aria-live="polite" data-file-status></p>
                        <noscript><p class="ts-meta">Uploading requires JavaScript to compute the file checksum.</p></noscript>
                        <div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Upload file</button></div>
                    </form>
                </div></section>
                @if (selected is not null)
                {
                    <details class="ts-card ts-card-boxed"><summary class="ts-card-header">Bucket access rules</summary><div class="ts-card-body"><form class="ts-form" method="post" action="/api/v1/dashboard/storage/rules">
                        <input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="bucket" value="@bucketId" />
                        @(await RenderPartialAsync<FileRulesForm, FileRulesFormModel>(new("existing-bucket", selected.Rules, true)))
                        <p class="ts-hint">Changes stop new capabilities. Download URLs already issued remain valid for up to 60 seconds.</p>
                        <div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Save rules</button></div>
                    </form></div></details>
                }
                <details class="ts-card ts-card-boxed"><summary class="ts-card-header">Delete bucket</summary><div class="ts-card-body"><form class="ts-form" method="post" action="/api/v1/dashboard/storage/delete-bucket">
                    <input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="bucket" value="@bucketId" />
                    <p class="ts-meta">Delete every file and wait for storage cleanup first. Only empty buckets can be deleted.</p><div class="ts-form-actions"><button class="ts-btn ts-btn-danger" type="submit">Delete empty bucket</button></div>
                </form></div></details>
            }
        }
        @if (!canWrite)
        {
            <p class="ts-meta">Your organization role permits viewing and downloading files. Uploading, deletion and bucket changes require write access.</p>
        }
    }
</main>
<script type="module" src="@Assets.Url("js/file-storage.js")" nonce="@Model.Shell.Nonce"></script>
@functions {
    public ShellModel LayoutModel => Model.Shell;
    private static string BucketUrl(string bucket, string? after) => "/storage?bucket=" + Uri.EscapeDataString(bucket) + (after is null ? "" : "&bucketAfter=" + Uri.EscapeDataString(after));
}
