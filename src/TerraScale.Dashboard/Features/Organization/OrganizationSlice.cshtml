@inherits RazorSlice<OrganizationPageModel>
@{
    var shell = Model.Shell;
    var t = (string s) => s;
    string InvitationStatusTone(string status) => status.ToLowerInvariant() switch
    {
        "accepted" => "ts-badge-success",
        "pending" => "ts-badge-warning",
        "canceled" or "declined" => "ts-badge-neutral",
        _ => "ts-badge-danger",
    };
    string InvitationStatusText(string status) =>
        status.Length == 0 ? t("Unknown") : $"{status[..1].ToUpperInvariant()}{status[1..].ToLowerInvariant()}";
    // v1 seeds invitation expiry at createdAt + 7 days (organization-data.ts).
    string InvitationExpiresAt(string createdAt) =>
        DateTimeOffset.TryParse(createdAt, out var created) ? DashboardStore.FormatUtcDateTime(created.AddDays(7).ToString("O")) : createdAt;
    bool HasRegion(DashboardProject project, string code) =>
        project.Regions.Any(r => string.Equals(r, code, StringComparison.OrdinalIgnoreCase));
}
@ShellHtml.Top(shell)
<div class="ts-page ts-org">
    <section class="ts-panel ts-org-summary">
        <div class="ts-row-header">
            <div class="ts-row ts-gap-16">
                <span class="ts-avatar ts-avatar-org" aria-hidden="true">@Icons.Building(24)</span>
                <dl class="ts-summary-terms ts-summary-terms-3">
                    <div class="ts-summary-term"><dt>@t("PROJECTS")</dt><dd>@Model.Projects.Length</dd></div>
                    <div class="ts-summary-term"><dt>@t("MEMBERS")</dt><dd>@Model.Users.Length</dd></div>
                    <div class="ts-summary-term"><dt>@t("CURRENT PROJECT")</dt><dd>@(Model.CurrentProjectId.Length > 0 ? Model.CurrentProjectId : t("None"))</dd></div>
                </dl>
            </div>
        </div>
        <form method="post" action="/api/v1/dashboard/organization/switch" class="ts-org-switch-form">
            <div class="ts-field">
                <label class="ts-label" for="activeOrganization">@t("Active organization")</label>
                <select class="ts-select" id="activeOrganization" name="organizationId">
                    <option value="@Model.OrganizationId" selected>@Model.OrganizationName @t("(active)")</option>
                </select>
            </div>
            <div class="ts-form-actions">
                <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit" disabled>@t("Switch organization")</button>
            </div>
        </form>
    </section>

    <section class="ts-grid-two-pane">
        <section class="ts-panel">
            <div class="ts-panel-header">
                <h3 class="ts-panel-title">@t("Projects")</h3>
                <p class="ts-panel-subtitle">@t("Projects returned by the TerraScale Dashboard API")</p>
            </div>
            @if (Model.CanManageOrganization)
            {
                <form method="post" action="/api/v1/dashboard/organization/projects" class="ts-form ts-padded ts-project-form">
                    <div class="ts-field">
                        <label class="ts-label" for="newProjectName">@t("New project")</label>
                        <input class="ts-input" id="newProjectName" name="name" placeholder="Analytics" required />
                    </div>
                    <fieldset class="ts-field ts-project-regions">
                        <legend class="ts-label">@Icons.Globe(16) @t("Project regions")</legend>
                        <div class="ts-region-picker">
                            <img class="ts-region-map" src="/brand/region-map.svg" alt="" decoding="async" />
                            @foreach (var region in Model.RegionCatalog)
                            {
                                <label class="ts-region-pin-btn" style="left:@RegionPins.Left(region.Code);top:@RegionPins.Top(region.Code)">
                                    <input class="ts-sr-only" type="checkbox" name="regions" value="@region.Code" @(region.Code == Model.SuggestedRegion ? "checked" : null) />
                                    <span class="ts-region-pin-dot" aria-hidden="true"></span>
                                </label>
                            }
                        </div>
                        <ul class="ts-sr-only" aria-label='@t("Regions")'>
                            @foreach (var region in Model.RegionCatalog)
                            {
                                <li>@region.Name (@region.Code) — @(region.Code == Model.SuggestedRegion ? t("Selected") : t("Available"))</li>
                            }
                        </ul>
                        <div class="ts-field">
                            <label class="ts-label" for="projectBackupRegion">@t("Backup region")</label>
                            <select class="ts-select" id="projectBackupRegion" name="backupRegion">
                                @foreach (var region in Model.RegionCatalog.Where(r => r.Code == Model.SuggestedRegion))
                                {
                                    <option value="@region.Code" selected>@region.Code</option>
                                }
                            </select>
                        </div>
                        <span class="ts-hint">@t("Databases and authentication inherit this placement.")</span>
                    </fieldset>
                    <div class="ts-form-actions">
                        <button class="ts-btn ts-btn-primary ts-btn-lg ts-btn-full" type="submit">@Icons.Plus(20) @t("Create project")</button>
                    </div>
                </form>
            }
            @if (Model.Projects.Length == 0)
            {
                <div class="ts-padded">
                    <div class="ts-empty">
                        <span class="ts-empty-title">@t("No projects returned")</span>
                        @t("The API did not return projects for this organization.")
                    </div>
                </div>
            }
            else
            {
                <div class="ts-table-wrap">
                    <table class="ts-table">
                        <thead>
                            <tr>
                                <th>@t("Project")</th>
                                <th>@t("Slug")</th>
                                <th>@t("Status")</th>
                                <th>@t("Backup region")</th>
                                <th>@t("Created")</th>
                                <th>@t("Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var project in Model.Projects)
                            {
                                <tr>
                                    <td>
                                        <div class="ts-min-width">
                                            <p class="ts-text-strong">@project.Name</p>
                                            <p class="ts-meta">@project.Id</p>
                                        </div>
                                    </td>
                                    <td class="ts-muted ts-ui">@(project.Slug is { Length: > 0 } slug ? slug : t("None"))</td>
                                    <td>@if (project.Id == Model.CurrentProjectId)
                                        {
                                            <span class="ts-badge ts-badge-success">@t("Current")</span>
                                        }
                                        else
                                        {
                                            <span class="ts-badge ts-badge-neutral">@t("Available")</span>
                                        }</td>
                                    <td><span class="ts-badge ts-badge-info">@project.BackupRegion.ToUpperInvariant()</span></td>
                                    <td class="ts-muted ts-ui">@DashboardStore.FormatUtcDateTime(project.CreatedAt)</td>
                                    <td>
                                        <details class="ts-rename">
                                            <summary class="ts-btn ts-btn-secondary ts-btn-lg">@Icons.Pencil(20) @t("Rename")</summary>
                                            <form method="post" action="/api/v1/dashboard/organization/projects/rename" class="ts-rename-form">
                                                <input type="hidden" name="projectId" value="@project.Id" />
                                                <div class="ts-field">
                                                    <label class="ts-label" for="rename-@project.Id">@t("Rename project")</label>
                                                    <input class="ts-input" id="rename-@project.Id" name="name" value="@project.Name" required />
                                                </div>
                                                <fieldset class="ts-field ts-project-regions">
                                                    <legend class="ts-label">@Icons.Globe(16) @t("Project regions")</legend>
                                                    <div class="ts-region-picker">
                                                        <img class="ts-region-map" src="/brand/region-map.svg" alt="" decoding="async" />
                                                        @foreach (var region in Model.RegionCatalog)
                                                        {
                                                            <label class="ts-region-pin-btn" style="left:@RegionPins.Left(region.Code);top:@RegionPins.Top(region.Code)">
                                                                <input class="ts-sr-only" type="checkbox" name="regions" value="@region.Code" @(HasRegion(project, region.Code) ? "checked" : null) />
                                                                <span class="ts-region-pin-dot" aria-hidden="true"></span>
                                                            </label>
                                                        }
                                                    </div>
                                                    <ul class="ts-sr-only" aria-label='@t("Regions")'>
                                                        @foreach (var region in Model.RegionCatalog)
                                                        {
                                                            <li>@region.Name (@region.Code) — @(HasRegion(project, region.Code) ? t("Selected") : t("Available"))</li>
                                                        }
                                                    </ul>
                                                    <div class="ts-field">
                                                        <label class="ts-label" for="rename-backup-@project.Id">@t("Backup region")</label>
                                                        <select class="ts-select" id="rename-backup-@project.Id" name="backupRegion">
                                                            @foreach (var region in Model.RegionCatalog.Where(r => HasRegion(project, r.Code)))
                                                            {
                                                                <option value="@region.Code" @(string.Equals(region.Code, project.BackupRegion, StringComparison.OrdinalIgnoreCase) ? "selected" : null)>@region.Code</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <span class="ts-hint">@t("Placement changes are applied asynchronously to every project resource.")</span>
                                                </fieldset>
                                                <button class="ts-btn ts-btn-secondary ts-btn-lg" type="submit">@Icons.Pencil(20) @t("Save project")</button>
                                            </form>
                                        </details>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        <section class="ts-panel">
            <div class="ts-panel-header">
                <h3 class="ts-panel-title">@t("Organization details")</h3>
                <p class="ts-panel-subtitle">@t("Current tenant context")</p>
            </div>
            <dl class="ts-stack-12 ts-padded">
                @foreach (var term in new (string Label, string Value)[]
                {
                    (t("Name"), Model.OrganizationName),
                    (t("Status"), Model.OrganizationStatus),
                    (t("Organization ID"), Model.OrganizationId),
                    (t("Created"), DashboardStore.FormatUtcDateTime(Model.OrganizationCreatedAt)),
                    (t("Signed-in user"), Model.SignedInEmail),
                })
                {
                    <div class="ts-context-term">
                        <dt class="ts-context-label">@term.Label</dt>
                        <dd class="ts-context-value">@term.Value</dd>
                    </div>
                }
                <div class="ts-status-success">
                    @Icons.ShieldCheck(16)
                    <span>@t("Organization access is enforced by the API session and project context.")</span>
                </div>
            </dl>
            @if (Model.CanManageOrganization)
            {
                <div class="ts-stack-12 ts-padded">
                    <form method="post" action="/api/v1/dashboard/organization/rename" class="ts-form ts-inline-form">
                        <div class="ts-field">
                            <label class="ts-label" for="organizationName">@t("Organization name")</label>
                            <input class="ts-input" id="organizationName" name="name" value="@Model.OrganizationName" required />
                        </div>
                        <div class="ts-form-actions">
                            <button class="ts-btn ts-btn-secondary ts-btn-lg" type="submit">@Icons.Pencil(20) @t("Save name")</button>
                        </div>
                    </form>
                    <form method="post" action="/api/v1/dashboard/organization/leave" data-confirm='@($"Leave {Model.OrganizationName}? You will immediately lose its project access.")'>
                        <button class="ts-btn ts-btn-secondary ts-btn-lg" type="submit">@Icons.LogOut(20) @t("Leave organization")</button>
                    </form>
                    <div class="ts-org-deletion">
                        <div class="ts-panel-header">
                            <h3 class="ts-panel-title">@t("Organization deletion")</h3>
                            <p class="ts-panel-subtitle">@t("Deletion preserves linked projects and data until the operation completes")</p>
                        </div>
                        <form method="post" action="/api/v1/dashboard/organization/deletion/request" class="ts-org-deletion-form">
                            <div class="ts-field">
                                <label class="ts-label" for="deletionConfirmationName">@($"Enter “{Model.OrganizationName}” to confirm")</label>
                                <input class="ts-input" id="deletionConfirmationName" name="confirmation" autocomplete="off" required @(Model.DeletionRequested ? "disabled" : null) />
                            </div>
                            <div class="ts-form-actions">
                                <button class="ts-btn ts-btn-destructive ts-btn-lg" type="submit" @(Model.DeletionRequested ? "disabled" : null)>@Icons.Trash2(20) @(Model.DeletionRequested ? t("Deletion pending") : t("Request deletion"))</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </section>
    </section>

    <section class="ts-panel">
        <div class="ts-panel-header">
            <h3 class="ts-panel-title">@t("Create organization")</h3>
            <p class="ts-panel-subtitle">@t("Repeat only the onboarding steps a new tenant needs: organization, payment, and project.")</p>
        </div>
        <div class="ts-padded ts-muted ts-ui ts-org-desc">
            @t("Creating another organization opens a guided flow for the tenant, its payment method, and the first project.")
        </div>
        <div class="ts-padded">
            <button type="button" class="ts-btn ts-btn-primary ts-btn-lg ts-btn-full" data-open-dialog="create-organization">@Icons.Plus(20) @t("Create organization")</button>
        </div>
    </section>

    @if (Model.CanManageOrganization)
    {
        <section class="ts-panel">
            <div class="ts-panel-header">
                <h3 class="ts-panel-title">@t("Members")</h3>
                <p class="ts-panel-subtitle">@t("Users returned by the organization users API")</p>
            </div>
            @if (Model.Users.Length == 0)
            {
                <div class="ts-padded">
                    <div class="ts-empty">
                        <span class="ts-empty-title">@t("No members returned")</span>
                        @t("The API did not return organization users for this account.")
                    </div>
                </div>
            }
            else
            {
                <div class="ts-table-wrap">
                    <table class="ts-table">
                        <thead>
                            <tr>
                                <th>@t("User")</th>
                                <th>@t("User ID")</th>
                                <th>@t("Role")</th>
                                <th>@t("Joined")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in Model.Users)
                            {
                                <tr>
                                    <td>
                                        <div class="ts-min-width">
                                            <p class="ts-text-strong">@(member.Name.Length > 0 ? member.Name : member.Email)</p>
                                            <p class="ts-meta">@member.Email</p>
                                        </div>
                                    </td>
                                    <td class="ts-mono ts-meta">@member.UserId</td>
                                    <td>
                                        <div class="ts-member-controls">
                                            <form method="post" action="/api/v1/dashboard/organization/members/role" class="ts-row ts-gap-8">
                                                <input type="hidden" name="userId" value="@member.UserId" />
                                                <select class="ts-select" name="role" aria-label='@t("Organization role for") @member.Email' onchange="this.form.submit()">
                                                    <option value="owner" @(member.Role == "owner" ? "selected" : null) @(member.Role == "owner" ? null : "disabled")>@t("Organization Owner")</option>
                                                    <option value="member" @(member.Role == "owner" ? null : "selected")>@t("Member")</option>
                                                </select>
                                            </form>
                                            @if (member.UserId != Model.SignedInUserId)
                                            {
                                                <form method="post" action="/api/v1/dashboard/organization/members/remove" data-confirm='@($"Remove {member.Email} from this organization and all of its projects?")'>
                                                    <input type="hidden" name="userId" value="@member.UserId" />
                                                    <button class="ts-btn ts-btn-destructive ts-btn-lg" type="submit">@Icons.Trash2(20) @t("Remove")</button>
                                                </form>
                                                @if (member.Role != "owner")
                                                {
                                                    <div class="ts-org-transfer">
                                                        <p>@t("Transfer ownership to") @member.Email. @t("Your role will become admin. Sign in again before starting.")</p>
                                                        @if (Model.OwnershipTransfers.FirstOrDefault(transfer => transfer.TargetUserId == member.UserId) is { } transfer)
                                                        {
                                                            <p role="status">@t("Check your verified email for the confirmation code. Expires at") @DashboardStore.FormatUtcDateTime(transfer.ExpiresAt).</p>
                                                            <form method="post" action="/api/v1/dashboard/organization/members/ownership/confirm" class="ts-field">
                                                                <input type="hidden" name="userId" value="@member.UserId" />
                                                                <label class="ts-label" for="ownership-@member.UserId">@t("Ownership confirmation code")</label>
                                                                <input class="ts-input" id="ownership-@member.UserId" name="code" type="password" maxlength="64" autocomplete="off" required />
                                                                <div class="ts-form-actions ts-form-actions-start">
                                                                    <button class="ts-btn ts-btn-secondary ts-btn-lg" type="submit">@t("Confirm ownership transfer")</button>
                                                                </div>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <form method="post" action="/api/v1/dashboard/organization/members/ownership/request">
                                                                <input type="hidden" name="userId" value="@member.UserId" />
                                                                <button class="ts-btn ts-btn-secondary ts-btn-lg" type="submit">@t("Request ownership transfer")</button>
                                                            </form>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td class="ts-muted ts-ui">@DashboardStore.FormatUtcDateTime(member.LastActiveAt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        <section class="ts-panel">
            <div class="ts-panel-header">
                <h3 class="ts-panel-title">@t("Invitations")</h3>
                <p class="ts-panel-subtitle">@t("Persistent invitation records")</p>
            </div>
            <form method="post" action="/api/v1/dashboard/organization/invitations" class="ts-form-stacked">
                <div class="ts-field">
                    <label class="ts-label" for="invitationEmail">@t("Invitation email")</label>
                    <input class="ts-input" id="invitationEmail" name="email" type="email" placeholder="teammate@example.com" required />
                </div>
                <div class="ts-field">
                    <label class="ts-label" for="invitationProject">@t("Project")</label>
                    <select class="ts-select" id="invitationProject" name="projectId">
                        @foreach (var project in Model.Projects)
                        {
                            <option value="@project.Id">@project.Name</option>
                        }
                    </select>
                </div>
                <div class="ts-form-actions">
                    <button class="ts-btn ts-btn-primary ts-btn-lg ts-btn-full" type="submit">@Icons.Send(20) @t("Send invitation")</button>
                </div>
            </form>
            @if (Model.Invitations.Length == 0)
            {
                <div class="ts-padded">
                    <div class="ts-empty">
                        <span class="ts-empty-title">@t("No invitations returned")</span>
                        @t("The API did not return pending or historical invitations for this organization.")
                    </div>
                </div>
            }
            else
            {
                <div class="ts-table-wrap">
                    <table class="ts-table">
                        <thead>
                            <tr>
                                <th>@t("Email")</th>
                                <th>@t("Role")</th>
                                <th>@t("Status")</th>
                                <th>@t("Expires")</th>
                                <th>@t("Invited by")</th>
                                <th>@t("Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var invitation in Model.Invitations)
                            {
                                <tr>
                                    <td>
                                        <div class="ts-min-width">
                                            <p class="ts-text-strong">@invitation.Email</p>
                                            <p class="ts-meta">@invitation.Id</p>
                                        </div>
                                    </td>
                                    <td class="ts-muted ts-ui">@invitation.Role</td>
                                    <td><span class="ts-badge @InvitationStatusTone(invitation.Status)">@InvitationStatusText(invitation.Status)</span></td>
                                    <td class="ts-muted ts-ui">@InvitationExpiresAt(invitation.CreatedAt)</td>
                                    <td class="ts-muted ts-ui">@(invitation.InvitedByEmail.Length > 0 ? invitation.InvitedByEmail : t("Unknown"))</td>
                                    <td>
                                        @if (invitation.Status == "Pending")
                                        {
                                            <div class="ts-row ts-gap-8">
                                                <form method="post" action="/api/v1/dashboard/organization/invitations/resend">
                                                    <input type="hidden" name="invitationId" value="@invitation.Id" />
                                                    <button class="ts-btn ts-btn-secondary ts-btn-lg" type="submit">@Icons.RefreshCw(20) @t("Resend")</button>
                                                </form>
                                                <form method="post" action="/api/v1/dashboard/organization/invitations/cancel">
                                                    <input type="hidden" name="invitationId" value="@invitation.Id" />
                                                    <button class="ts-btn ts-btn-destructive ts-btn-lg" type="submit">@Icons.Trash2(20) @t("Cancel")</button>
                                                </form>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
    else
    {
        <section class="ts-panel">
            <div class="ts-panel-header">
                <h3 class="ts-panel-title">@t("Members and invitations")</h3>
                <p class="ts-panel-subtitle">@t("Organization owner controls")</p>
            </div>
            <div class="ts-padded">
                <div class="ts-alert ts-alert-info">
                    <span class="ts-alert-title">@t("Organization owner access required")</span>
                    <span class="ts-alert-body">@t("Only organization owners can view members, invitations, and organization roles.")</span>
                </div>
            </div>
        </section>
    }
</div>
@(await RenderPartialAsync<NewOrganizationDialog, NewOrganizationWizardModel>(Model.NewOrganization))
@ShellHtml.Bottom(shell)
