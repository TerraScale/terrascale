@inherits RazorSlice<OrganizationPageModel>
@{
    var shell = Model.Shell;
    var t = (string s) => s;
    bool HasRegion(DashboardProject project, string code) =>
        project.Regions.Any(r => string.Equals(r, code, StringComparison.OrdinalIgnoreCase));
}
@ShellHtml.Top(shell)
<div class="ts-page ts-org">
    @if (Model.Error is { Length: > 0 } error)
    {
        <div class="ts-alert ts-alert-danger" role="alert">
            <span class="ts-alert-title">@Icons.CircleAlert(16) @error</span>
        </div>
    }

    <section class="ts-section ts-org-overview" aria-labelledby="organization-overview-title">
        <div class="ts-section-head">
            <div class="ts-org-identity">
                <span class="ts-avatar ts-avatar-org" aria-hidden="true">@Icons.Building2(22)</span>
                <div>
                    <h2 class="ts-panel-title" id="organization-overview-title">@Model.OrganizationName</h2>
                    <p class="ts-meta">@Model.OrganizationStatus · @(Model.OrganizationKind == OrganizationKind.Personal ? t("Personal workspace") : t("Business workspace"))</p>
                </div>
            </div>
            <button type="button" class="ts-btn ts-btn-primary" data-open-dialog="create-organization">@Icons.Plus(16) @t("Create organization")</button>
        </div>

        <dl class="ts-kpis ts-org-kpis" aria-label="Organization summary">
            <div>
                <dt>@Icons.FolderOpen(14) @t("Projects")</dt>
                <dd><span class="ts-kpi-value">@Model.Projects.Length</span></dd>
                <small class="ts-meta">@t("Projects in this workspace")</small>
            </div>
            <div>
                <dt>@Icons.Users(14) @t("Members")</dt>
                <dd><span class="ts-kpi-value">@Model.Users.Length</span></dd>
                <small class="ts-meta">@t("People with organization access")</small>
            </div>
            <div>
                <dt>@Icons.FolderKanban(14) @t("Current project")</dt>
                <dd><span class="ts-kpi-value ts-org-kpi-text">@(Model.CurrentProjectId.Length > 0 ? Model.CurrentProjectId : t("None"))</span></dd>
                <small class="ts-meta">@t("Project used by the dashboard")</small>
            </div>
            <div>
                <dt>@Icons.Calendar(14) @t("Created")</dt>
                <dd><span class="ts-kpi-value ts-org-kpi-text">@DashboardStore.FormatUtcDateTime(Model.OrganizationCreatedAt)</span></dd>
                <small class="ts-meta">@t("Organization record")</small>
            </div>
        </dl>

        <form method="post" action="/api/v1/dashboard/organization/switch" class="ts-org-switch-form">
            <div class="ts-field">
                <label class="ts-label" for="activeOrganization">@t("Active organization")</label>
                <select class="ts-select" id="activeOrganization" name="organizationId">
                    @foreach (var organization in Model.Organizations.Where(o => !o.Archived))
                    {
                        <option value="@organization.Id" selected="@(organization.Id == Model.OrganizationId ? "selected" : null)">@organization.ActiveOrganizationName (@(organization.Kind == OrganizationKind.Personal ? t("Personal") : t("Business")))</option>
                    }
                </select>
            </div>
            <div class="ts-form-actions">
                <button class="ts-btn ts-btn-secondary" type="submit">@t("Switch organization")</button>
            </div>
        </form>
    </section>

    <section class="ts-section ts-org-projects" aria-labelledby="organization-projects-title">
        <div class="ts-section-head">
            <div>
                <h2 class="ts-panel-title" id="organization-projects-title">@t("Projects")</h2>
                <p class="ts-meta">@(Model.OrganizationKind == OrganizationKind.Personal ? t("Personal workspace · free allowance eligible") : t("Business workspace · paid billing required")) · @t("Projects returned by the TerraScale Dashboard API")</p>
            </div>
            @if (Model.CanManageOrganization)
            {
                <details class="ts-disclosure ts-org-create-project">
                    <summary class="ts-btn ts-btn-primary">@Icons.Plus(16) @t("Create project")</summary>
                    <form method="post" action="/api/v1/dashboard/organization/projects" class="ts-form ts-org-project-form">
                        <div class="ts-field">
                            <label class="ts-label" for="newProjectName">@t("New project")</label>
                            <input class="ts-input" id="newProjectName" name="name" placeholder="Analytics" required />
                        </div>
                        <fieldset class="ts-field ts-project-regions">
                            <legend class="ts-label">@Icons.Globe(16) @t("Project regions")</legend>
                            @RegionMap.Picker(
                                [.. Model.RegionCatalog.Select(region => region.ToMapPin(region.Code == Model.SuggestedRegion))],
                                RegionMap.Selection.Multiple,
                                name: "regions",
                                ariaLabel: t("Regions"))
                            <div class="ts-field">
                                <label class="ts-label" for="projectBackupRegion">@t("Backup region")</label>
                                <select class="ts-select" id="projectBackupRegion" name="backupRegion">
                                    @foreach (var region in Model.RegionCatalog.Where(r => r.Code == Model.SuggestedRegion))
                                    {
                                        <option value="@region.Code" selected>@region.Code</option>
                                    }
                                </select>
                            </div>
                            <span class="ts-hint">@t("Databases and authentication inherit this placement.")</span>
                        </fieldset>
                        <div class="ts-form-actions">
                            <button class="ts-btn ts-btn-primary" type="submit">@Icons.Plus(16) @t("Create project")</button>
                        </div>
                    </form>
                </details>
            }
        </div>
        @if (Model.Projects.Length == 0)
        {
            <div class="ts-empty">
                <span class="ts-empty-icon">@Icons.FolderOpen(16)</span>
                <span class="ts-empty-title">@t("No projects returned")</span>
                <span class="ts-meta">@t("The API did not return projects for this organization.")</span>
            </div>
        }
        else
        {
            <div class="ts-table-wrap">
                <table class="ts-table">
                    <thead>
                        <tr>
                            <th>@t("Project")</th>
                            <th>@t("Slug")</th>
                            <th>@t("Status")</th>
                            <th>@t("Backup region")</th>
                            <th>@t("Created")</th>
                            <th>@t("Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var project in Model.Projects)
                        {
                            <tr>
                                <td>
                                    <div class="ts-min-width">
                                        <p class="ts-table-strong">@project.Name</p>
                                        <p class="ts-meta">@project.Id</p>
                                    </div>
                                </td>
                                <td class="ts-muted ts-ui">@(project.Slug is { Length: > 0 } slug ? slug : t("None"))</td>
                                <td>
                                    @if (project.Id == Model.CurrentProjectId)
                                    {
                                        <span class="ts-badge ts-badge-success">@t("Current")</span>
                                    }
                                    else
                                    {
                                        <span class="ts-badge ts-badge-neutral">@t("Available")</span>
                                    }
                                </td>
                                <td><span class="ts-badge ts-badge-info">@project.BackupRegion.ToUpperInvariant()</span></td>
                                <td class="ts-muted ts-ui">@DashboardStore.FormatUtcDateTime(project.CreatedAt)</td>
                                <td>
                                    <details class="ts-disclosure ts-rename">
                                        <summary class="ts-btn ts-btn-ghost ts-btn-sm">@Icons.Pencil(14) @t("Rename")</summary>
                                        <form method="post" action="/api/v1/dashboard/organization/projects/rename" class="ts-rename-form">
                                            <input type="hidden" name="projectId" value="@project.Id" />
                                            <div class="ts-field">
                                                <label class="ts-label" for="rename-@project.Id">@t("Rename project")</label>
                                                <input class="ts-input" id="rename-@project.Id" name="name" value="@project.Name" required />
                                            </div>
                                            <fieldset class="ts-field ts-project-regions">
                                                <legend class="ts-label">@Icons.Globe(16) @t("Project regions")</legend>
                                                @RegionMap.Picker(
                                                    [.. Model.RegionCatalog.Select(region => region.ToMapPin(HasRegion(project, region.Code)))],
                                                    RegionMap.Selection.Multiple,
                                                    name: "regions",
                                                    ariaLabel: t("Regions"))
                                                <div class="ts-field">
                                                    <label class="ts-label" for="rename-backup-@project.Id">@t("Backup region")</label>
                                                    <select class="ts-select" id="rename-backup-@project.Id" name="backupRegion">
                                                        @foreach (var region in Model.RegionCatalog.Where(r => HasRegion(project, r.Code)))
                                                        {
                                                            <option value="@region.Code" @(string.Equals(region.Code, project.BackupRegion, StringComparison.OrdinalIgnoreCase) ? "selected" : null)>@region.Code</option>
                                                        }
                                                    </select>
                                                </div>
                                                <span class="ts-hint">@t("Placement changes are applied asynchronously to every project resource.")</span>
                                            </fieldset>
                                            <button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">@Icons.Pencil(14) @t("Save project")</button>
                                        </form>
                                    </details>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <div class="ts-org-layout">
        <section class="ts-section" aria-labelledby="organization-details-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="organization-details-title">@t("Organization details")</h2>
                    <p class="ts-meta">@t("Current tenant context")</p>
                </div>
                @if (Model.CanManageOrganization)
                {
                    <details class="ts-disclosure">
                        <summary class="ts-btn ts-btn-secondary ts-btn-sm">@Icons.Pencil(14) @t("Edit name")</summary>
                        <form method="post" action="/api/v1/dashboard/organization/rename" class="ts-form ts-org-name-form">
                            <div class="ts-field">
                                <label class="ts-label" for="organizationName">@t("Organization name")</label>
                                <input class="ts-input" id="organizationName" name="name" value="@Model.OrganizationName" required />
                            </div>
                            <div class="ts-form-actions"><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">@Icons.Save(14) @t("Save name")</button></div>
                        </form>
                    </details>
                }
            </div>
            <dl class="ts-settings-list ts-org-details">
                <div><dt>@t("Name")</dt><dd>@Model.OrganizationName</dd></div>
                <div><dt>@t("Status")</dt><dd><span class="ts-badge ts-badge-success">@Model.OrganizationStatus</span></dd></div>
                <div><dt>@t("Organization ID")</dt><dd class="ts-mono">@Model.OrganizationId</dd></div>
                <div><dt>@t("Created")</dt><dd>@DashboardStore.FormatUtcDateTime(Model.OrganizationCreatedAt)</dd></div>
                <div><dt>@t("Signed-in user")</dt><dd class="ts-break-words">@Model.SignedInEmail</dd></div>
            </dl>
            <div class="ts-status-success">@Icons.ShieldCheck(16) <span>@t("Organization access is enforced by the API session and project context.")</span></div>
            @if (Model.CanManageOrganization)
            {
                <div class="ts-org-management">
                    <form method="post" action="/api/v1/dashboard/organization/leave" data-confirm='@($"Leave {Model.OrganizationName}? You will immediately lose its project access.")'>
                        <button class="ts-btn ts-btn-ghost ts-btn-sm" type="submit">@Icons.LogOut(14) @t("Leave organization")</button>
                    </form>
                    <details class="ts-disclosure ts-danger-disclosure">
                        <summary class="ts-btn ts-btn-ghost ts-btn-sm">@Icons.Trash2(14) @t("Organization deletion")</summary>
                        <p class="ts-meta">@t("Deletion preserves linked projects and data until the operation completes")</p>
                        <form method="post" action="/api/v1/dashboard/organization/deletion/request" class="ts-org-deletion-form">
                            <div class="ts-field">
                                <label class="ts-label" for="deletionConfirmationName">@($"Enter “{Model.OrganizationName}” to confirm")</label>
                                <input class="ts-input" id="deletionConfirmationName" name="confirmation" autocomplete="off" required @(Model.DeletionRequested ? "disabled" : null) />
                            </div>
                            <div class="ts-form-actions"><button class="ts-btn ts-btn-destructive ts-btn-sm" type="submit" @(Model.DeletionRequested ? "disabled" : null)>@Icons.Trash2(14) @(Model.DeletionRequested ? t("Deletion pending") : t("Request deletion"))</button></div>
                        </form>
                    </details>
                </div>
            }
        </section>

    </div>

    <section class="ts-section ts-org-team-summary" aria-labelledby="organization-team-title">
        <div class="ts-section-head">
            <div>
                <h2 class="ts-panel-title" id="organization-team-title">Team</h2>
                <p class="ts-meta">Members, invitations and role changes are managed on the Team page.</p>
            </div>
            <a class="ts-btn ts-btn-secondary" href="/access">Manage team</a>
        </div>
        <dl class="ts-stats" aria-label="Team summary">
            <div>
                <dt>@Icons.Users(14) Members</dt>
                <dd>@Model.Users.Length</dd>
                <small class="ts-meta">People with organization access</small>
            </div>
            <div>
                <dt>@Icons.Mail(14) Invitations</dt>
                <dd>@Model.Invitations.Length</dd>
                <small class="ts-meta">Current and historical invitations</small>
            </div>
        </dl>
    </section>
</div>
@(await RenderPartialAsync<NewOrganizationDialog, NewOrganizationWizardModel>(Model.NewOrganization))
@ShellHtml.Bottom(shell)
