@inherits RazorSlice<OrganizationsNewPageModel>
@{
    var shell = Model.Shell;
    var t = (string s) => s;
    var stepAction = "/organizations/new/step";
}
@ShellHtml.Top(shell)
<div class="ts-page">
    <section class="ts-panel">
        <div class="ts-panel-header">
            <h2 class="ts-panel-title">@t("Create organization")</h2>
            <p class="ts-panel-subtitle ts-panel-subtitle-lg">@t("Repeat only the onboarding steps a new tenant needs: organization, payment, and project.")</p>
        </div>
    </section>

    @* The same step screens as the activation wizard, scoped to the three
       steps a new tenant repeats: organization, payment, and project. *@
    <div class="ts-onboarding-container">
        @(await RenderPartialAsync<OnboardingProgress, OnboardingProgressView>(new(
            Steps: Model.Steps,
            ActiveStep: Model.ActiveStep,
            CurrentStep: Model.CurrentStep,
            TotalSteps: Model.TotalSteps,
            ProgressPercent: Model.ProgressPercent,
            Label: "STEP",
            Compact: Model.Compact,
            AriaLabel: "New organization steps",
            BarAriaLabel: "New organization progress")))

        @if (Model.PaymentCanceled)
        {
            <div class="ts-alert ts-alert-warning" role="alert">
                <span class="ts-onboarding-alert-icon" aria-hidden="true">@Icons.TriangleAlert(19)</span>
                <div class="ts-onboarding-alert-stack">
                    <span class="ts-alert-title">@t("Payment setup canceled")</span>
                    <span class="ts-alert-body">@t("No payment method was changed; you can safely try again.")</span>
                </div>
            </div>
        }

        @if (Model.ActiveStep == "organization")
        {
            @(await RenderPartialAsync<OnboardingOrganizationCard, OnboardingOrganizationCardView>(new(
                Action: stepAction,
                StepValue: "organization",
                Title: t("Create organization"),
                Subtitle: t("Billing and future projects use this authenticated tenant boundary."),
                ContinueHref: "/organizations/new?step=payment",
                StepDone: false)))
        }
        else if (Model.ActiveStep == "payment-method")
        {
            @(await RenderPartialAsync<OnboardingPaymentCard, OnboardingPaymentCardView>(new(
                Action: stepAction,
                StepValue: "payment-method",
                Plans: Model.Plans,
                StepDone: false)))
        }
        else
        {
            @(await RenderPartialAsync<OnboardingProjectCard, OnboardingProjectCardView>(new(
                Action: stepAction,
                StepValue: "project",
                Regions: Model.Regions,
                DefaultRegion: Model.DefaultRegion)))
        }
    </div>
</div>
@ShellHtml.Bottom(shell)
