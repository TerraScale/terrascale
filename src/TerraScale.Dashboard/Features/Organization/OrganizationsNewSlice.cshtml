@inherits RazorSlice<OrganizationsNewPageModel>
@{
    var shell = Model.Shell;
    var t = (string s) => s;
    var steps = new[] { t("Organization"), t("Payment"), t("Database") };
    var checkoutHref = Model.CheckoutHref ?? "/organizations/new?step=payment";
}
@ShellHtml.Top(shell)
<div class="ts-page">
    <section class="ts-panel">
        <div class="ts-panel-header ts-neworg-header">
            <h2 class="ts-panel-title">@t("Create organization")</h2>
            <p class="ts-panel-subtitle ts-panel-subtitle-lg">@t("Business organizations have their own billing and never use the Personal allowance.")</p>
        </div>
    </section>

    <section class="ts-panel ts-neworg ts-neworg-wizard">
        <div class="ts-row-between">
            <span class="ts-meta">@t("Step") @Model.Step @t("of") 3</span>
            <span class="ts-meta">@Model.ProgressPercent%</span>
        </div>
        <div class="ts-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Model.ProgressPercent" aria-label='@t("New organization progress")'>
            <div class="ts-progress-bar" style="width:@Model.ProgressPercent%"></div>
        </div>
        <ol class="ts-wizard-steps" aria-label='@t("New organization steps")'>
            @for (var i = 0; i < steps.Length; i++)
            {
                <li class="ts-wizard-step @(i + 1 < Model.Step ? "ts-wizard-step-done" : null) @(i + 1 == Model.Step ? "ts-wizard-step-active" : null)">
                    @steps[i]
                </li>
            }
        </ol>

        @if (Model.Step == 1)
        {
            <form method="post" action="/api/v1/dashboard/organizations/create" class="ts-form">
                <div class="ts-field">
                    <label class="ts-label" for="newOrganizationName">@t("Organization name")</label>
                    <input class="ts-input" id="newOrganizationName" name="name" placeholder="Acme" required />
                </div>
                <div class="ts-field">
                    <label class="ts-label" for="newOrganizationPlan">@t("Plan")</label>
                    <select class="ts-select" id="newOrganizationPlan" name="planId" required @(Model.Plans.Length == 0 ? "disabled" : null)>
                        @if (Model.Plans.Length == 0)
                        {
                            <option value="" selected disabled>@t("No billing plans are available")</option>
                        }
                        else
                        {
                            @foreach (var plan in Model.Plans)
                            {
                                <option value="@plan.PlanId">@plan.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="ts-form-actions ts-form-actions-start">
                    <button class="ts-btn ts-btn-primary ts-btn-lg ts-btn-full" type="submit">@Icons.Building2(20) @t("Create organization")</button>
                </div>
            </form>
        }
        else if (Model.Step == 2)
        {
            @if (Model.PaymentStatus == "canceled")
            {
                <div class="ts-alert ts-alert-warning">
                    <span class="ts-alert-title">@t("Payment setup canceled")</span>
                    <span class="ts-alert-body">@t("No payment method was changed; you can safely try again.")</span>
                </div>
            }
            @if (Model.PaymentStatus == "success")
            {
                <div class="ts-alert ts-alert-success"><span class="ts-alert-title">@t("Business billing is active")</span><span class="ts-alert-body">@t("Your Personal allowance remains separate from this Business organization.")</span></div>
                <div class="ts-form-actions"><a class="ts-btn ts-btn-primary ts-btn-lg" href="/organizations/new?step=database">@Icons.ArrowRight(20) @t("Continue to database setup")</a></div>
            }
            else if (Model.Plans.Length == 0)
            {
                <p class="ts-muted ts-ui">@t("Select a billing plan before continuing.")</p>
            }
            else
            {
                <p class="ts-muted ts-ui">@t("This Business organization requires its own paid billing. Your Personal allowance stays separate.")</p>
                <dl class="ts-wizard-summary">
                    <div class="ts-wizard-summary-row">
                        <dt>@t("Plan")</dt>
                        <dd>@Model.Plans[0].Name</dd>
                    </div>
                    <div class="ts-wizard-summary-row">
                        <dt>@t("Billing interval")</dt>
                        <dd>@t("Monthly")</dd>
                    </div>
                </dl>
            }
            @if (Model.PaymentStatus != "success")
            {
                <div class="ts-form-actions">
                    <a class="ts-btn ts-btn-primary ts-btn-lg" href="@checkoutHref">@Icons.CreditCard(20) @t("Continue to secure payment setup")</a>
                </div>
            }
        }
        else
        {
            <form method="post" action="/api/v1/dashboard/organizations/create-database" class="ts-form">
                <div class="ts-field">
                    <label class="ts-label" for="newOrganizationProjectName">@t("Project name")</label>
                    <input class="ts-input" id="newOrganizationProjectName" name="projectName" placeholder="Production" required />
                </div>
                <fieldset class="ts-field ts-project-regions">
                    <legend class="ts-label">@Icons.Database(16) @t("Primary regions")</legend>
                    <div class="ts-region-picker ts-region-picker-compact">
                        <img class="ts-region-map" src="@AssetUrls.Url("/brand/region-map.svg")" alt="" decoding="async" />
                        @foreach (var region in Model.RegionCatalog)
                        {
                            <label class="ts-region-pin-btn" style="left:@RegionPins.Left(region.Code);top:@RegionPins.Top(region.Code)">
                                <input class="ts-sr-only" type="checkbox" name="regions" value="@region.Code" @(region.Code == Model.SuggestedRegion ? "checked" : null) />
                                <span class="ts-region-pin-dot" aria-hidden="true"></span>
                            </label>
                        }
                    </div>
                    <ul class="ts-sr-only" aria-label='@t("Regions")'>
                        @foreach (var region in Model.RegionCatalog)
                        {
                            <li>@region.Name (@region.Code) — @(region.Code == Model.SuggestedRegion ? t("Selected") : t("Available"))</li>
                        }
                    </ul>
                    <div class="ts-field">
                        <label class="ts-label" for="newOrganizationBackupRegion">@t("Backup region")</label>
                        <select class="ts-select" id="newOrganizationBackupRegion" name="backupRegion">
                            @foreach (var region in Model.RegionCatalog.Where(r => r.Code == Model.SuggestedRegion))
                            {
                                <option value="@region.Code" selected>@region.Code</option>
                            }
                        </select>
                    </div>
                </fieldset>
                <div class="ts-form-actions">
                    <a class="ts-btn ts-btn-secondary ts-btn-lg" href="/organizations/new?step=payment">@Icons.ArrowLeft(20) @t("Back")</a>
                    <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">@Icons.Plus(20) @t("Create database and open Dashboard")</button>
                </div>
            </form>
        }
        <p class="ts-meta"><a class="ts-link ts-wizard-link" href="/organizations/new?step=organization">@t("Start another Business organization")</a></p>
    </section>
</div>
@ShellHtml.Bottom(shell)
