@inherits RazorSlice<TerraScale.Dashboard.Features.ApiKeys.ApiKeysPage>
@{ var kind = Model.DialogKind; var dialog = "create-" + kind; var selected = Model.Create == kind && (Model.DraftScopes.Length > 0 || Model.Error.Length > 0) ? Model.DraftScopes.Split([',', ' ', '\n', '\t'], StringSplitOptions.RemoveEmptyEntries) : ["sql:read"]; }
<dialog id="@dialog" class="ts-dialog ts-credential-dialog" closedby="any" aria-labelledby="@(dialog + "-title")" data-init="@(Model.Create == kind ? "el.showModal()" : "void 0")"><div class="ts-dialog-content">
<header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@(dialog + "-title")">New API key</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@dialog">@Icons.Render("X", 18)</button></header>
<form method="post" data-submit-once action="@Model.With("/api/v1/dashboard/credentials/" + kind)" class="ts-form ts-credential-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" />@if (Model.Error.Length > 0 && Model.Create == kind) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
<div class="ts-field"><label class="ts-label" for="@(kind + "-name")">Name</label><input class="ts-input" id="@(kind + "-name")" name="name" value="@(Model.Create == kind ? Model.Name : "")" placeholder="production-api" maxlength="128" autocomplete="off" required /></div>
<div class="ts-field"><label class="ts-label" for="@(kind + "-database")">Database</label><select class="ts-select" id="@(kind + "-database")" name="databaseId"><option value="">All databases</option>@if (Model.Context.Project is not null) { @foreach (var database in Model.Context.Project.Databases.Values.OrderBy(database => database.Name)) { <option value="@database.Id" selected="@(Model.Create == kind && Model.DraftDatabaseId == database.Id)">@database.Name</option> } }</select></div>
<div class="ts-field"><span class="ts-label">Permissions</span><div class="ts-stack-sm">@foreach (var option in new[] { "sql:read", "sql:write", "databases:read", "databases:write" }) { <label class="ts-check"><input type="checkbox" name="scopes" value="@option" checked="@(selected.Contains(option))" /><span>@option</span></label> }</div></div>
<div class="ts-field"><label class="ts-label" for="@(kind + "-expiry")">Expiration</label><select class="ts-select" id="@(kind + "-expiry")" name="expiresInDays">@foreach (var option in new[] { (Days: "0", Label: "No expiry"), (Days: "30", Label: "30 days"), (Days: "90", Label: "90 days"), (Days: "365", Label: "1 year") }) { <option value="@option.Days" selected="@(Model.Create == kind && Model.DraftExpiresInDays == option.Days)">@option.Label</option> }</select></div>
<div class="ts-field"><label class="ts-label" for="@(kind + "-cidrs")">Allowed IPs</label><textarea class="ts-input ts-mono" id="@(kind + "-cidrs")" name="allowedCidrs" rows="3" spellcheck="false" autocomplete="off" placeholder="Any IP, or one CIDR per line: 203.0.113.0/24">@(Model.Create == kind ? Model.DraftAllowedCidrs : "")</textarea></div>
<div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="@dialog">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">@(kind == "key" ? "Create key" : "Create client")</button></div>
</form></div></dialog>
