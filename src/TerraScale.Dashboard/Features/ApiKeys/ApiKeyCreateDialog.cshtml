@using TerraScale.Dashboard.Features.ApiKeys
@inherits RazorSlice<ApiKeysPage>
@{ var kind = Model.DialogKind; var dialog = "create-" + kind; var drafted = Model.Create == kind; var selected = drafted && (Model.DraftScopes.Length > 0 || Model.Error.Length > 0) ? Model.DraftScopes.Split([',', ' ', '\n', '\t'], StringSplitOptions.RemoveEmptyEntries) : [.. ApiKeyFormat.ReadOnlyScopes]; var preset = ApiKeyFormat.Preset(selected); var cidrs = drafted ? Model.DraftAllowedCidrs : ""; }
<dialog id="@dialog" class="ts-dialog ts-credential-dialog" closedby="any" aria-labelledby="@(dialog + "-title")" data-init="@(drafted ? "el.showModal()" : "void 0")"><div class="ts-dialog-content">
<header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@(dialog + "-title")">New API key</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@dialog">@Icons.Render("X", 18)</button></header>
<form method="post" data-submit-once action="@Model.With("/api/v1/dashboard/credentials/" + kind)" class="ts-form ts-credential-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="dialog" value="@dialog" />@if (Model.Error.Length > 0 && drafted) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
<div class="ts-field"><label class="ts-label" for="@(kind + "-name")">Name</label><input class="ts-input" id="@(kind + "-name")" name="name" type="text" value="@(drafted ? Model.Name : "")" placeholder="production-api" minlength="1" maxlength="128" pattern=".*\S.*" title="Enter a name of up to 128 characters." autocomplete="off" spellcheck="false" required /></div>
<fieldset class="ts-field ts-apikeys-permissions" data-signals="{_access: '@preset'}"><legend class="ts-label">Permissions</legend>
<div class="ts-apikeys-choices">@foreach (var choice in new[] { (Value: "full", Label: "Full access", Scopes: string.Join(',', ApiKeyFormat.FullAccessScopes)), (Value: "read", Label: "Read only", Scopes: string.Join(',', ApiKeyFormat.ReadOnlyScopes)), (Value: "custom", Label: "Custom", Scopes: "") }) { <label class="ts-apikeys-choice"><input type="radio" name="scopes" value="@choice.Scopes" data-access="@choice.Value" checked="@(preset == choice.Value)" data-on:change="$_access = el.dataset.access; if (el.value) { el.closest('fieldset').querySelectorAll('.ts-apikeys-scopes-grid input').forEach(scope => { scope.checked = el.value.split(',').includes(scope.value) }) }" /><span>@choice.Label</span></label> }</div>
<fieldset class="ts-apikeys-scopes-grid" disabled="@(preset != "custom")" data-attr:disabled="$_access !== 'custom'"><legend class="ts-sr-only">Scopes</legend>@foreach (var resource in new[] { (Name: "SQL", Prefix: "sql"), (Name: "Databases", Prefix: "databases") }) { <div class="ts-apikeys-scope-row"><span class="ts-apikeys-scope-name">@resource.Name</span>@foreach (var level in new[] { (Name: "Read", Suffix: "read"), (Name: "Write", Suffix: "write") }) { var scope = resource.Prefix + ":" + level.Suffix; <label class="ts-check"><input type="checkbox" name="scopes" value="@scope" checked="@selected.Contains(scope)" aria-label="@(resource.Name + " " + level.Suffix)" /><span aria-hidden="true">@level.Name</span></label> }</div> }</fieldset>
</fieldset>
<div class="ts-apikeys-selects"><div class="ts-field"><label class="ts-label" for="@(kind + "-database")">Database</label><select class="ts-select" id="@(kind + "-database")" name="databaseId"><option value="">All databases</option>@if (Model.Context.Project is not null) { @foreach (var database in Model.Context.Project.Databases.Values.OrderBy(database => database.Name)) { <option value="@database.Id" selected="@(drafted && Model.DraftDatabaseId == database.Id)">@database.Name</option> } }</select></div>
<div class="ts-field"><label class="ts-label" for="@(kind + "-expiry")">Expiration</label><select class="ts-select" id="@(kind + "-expiry")" name="expiresInDays" required>@foreach (var option in new[] { (Days: "0", Label: "No expiry"), (Days: "30", Label: "30 days"), (Days: "90", Label: "90 days"), (Days: "365", Label: "1 year") }) { <option value="@option.Days" selected="@(drafted && Model.DraftExpiresInDays == option.Days)">@option.Label</option> }</select></div></div>
<details class="ts-apikeys-restrictions" open="@(cidrs.Length > 0)"><summary>@Icons.Render("ChevronRight", 14)<span>Restrictions</span></summary><div class="ts-field"><label class="ts-label" for="@(kind + "-cidrs")">Allowed IPs</label><textarea class="ts-input ts-mono" id="@(kind + "-cidrs")" name="allowedCidrs" rows="3" maxlength="2080" spellcheck="false" autocomplete="off" placeholder="Any IP, or one CIDR per line: 203.0.113.0/24">@cidrs</textarea></div></details>
<div class="ts-dialog-footer"><button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="@dialog">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Create key</button></div>
</form></div></dialog>
