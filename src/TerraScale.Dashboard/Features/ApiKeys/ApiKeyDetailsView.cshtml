@using TerraScale.Dashboard.Features.ApiKeys
@inherits RazorSlice<ApiKeyDetailsPage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
@{ var key = Model.Key; var cidrsDialog = Model.CidrsDialog; }
<main class="ts-page ts-apikeys-page ts-apikeys-details" data-key-id="@key.Id" data-project-id="@Model.Context.Project?.Id" data-organization-id="@Model.Context.Organization?.Id">
<header class="ts-apikeys-header"><div class="ts-apikeys-heading"><nav class="ts-breadcrumb" aria-label="Breadcrumb"><a href="/api-keys">API keys</a><span aria-hidden="true">/</span><span aria-current="page">@key.Name</span></nav><h1>@key.Name</h1></div><div class="ts-page-actions"><button class="ts-btn ts-btn-secondary" type="button" command="show-modal" commandfor="@("rotate-" + key.Id)">@Icons.Render("RotateCw", 16)<span>Rotate</span></button><button class="ts-btn ts-btn-danger" type="button" command="show-modal" commandfor="@("revoke-" + key.Id)">@Icons.Render("Trash2", 16)<span>Revoke</span></button></div></header>
@if (Model.Error.Length > 0 && !Model.ErrorInDialog) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
@if (Model.Warning.Length > 0 && Model.Secret is null) { <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">@Model.Warning</p></div> }
@if (Model.Secret is { } secret) { @(await RenderPartialAsync<ApiKeySecretDialog, ApiKeySecret>(secret)) }
<section class="ts-card" id="key-details" aria-labelledby="key-details-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="key-details-title">Details</h2></div></header><div class="ts-card-body"><dl class="ts-kv ts-apikeys-kv">
<div><dt>Status</dt><dd>@if (!key.IsActive) { <span class="ts-badge ts-badge-neutral"><span class="ts-dot" aria-hidden="true"></span>Expired</span> } else if (ApiKeyService.ExpiresSoon(key, Model.Now)) { <span class="ts-badge ts-badge-warning"><span class="ts-dot" aria-hidden="true"></span>Expires soon</span> } else { <span class="ts-badge ts-badge-success"><span class="ts-dot" aria-hidden="true"></span>Active</span> }</dd></div>
<div><dt>Key ID</dt><dd class="ts-mono">@key.Id</dd></div>
<div><dt>Permissions</dt><dd><div class="ts-row ts-apikeys-scopes">@if (ApiKeyFormat.FullAccess(key.Scopes)) { <span class="ts-badge ts-badge-neutral">Full access</span> }@foreach (var scope in key.Scopes) { <code>@scope</code> }</div></dd></div>
<div><dt>Database</dt><dd>@(key.DatabaseName ?? "All project databases")</dd></div>
<div><dt>Created by</dt><dd class="ts-break">@ApiKeyFormat.CreatedBy(key)</dd></div>
<div><dt>Created</dt><dd><time datetime="@ApiKeyFormat.Machine(key.CreatedAt)">@ApiKeyFormat.Instant(key.CreatedAt)</time></dd></div>
<div><dt>Expires</dt><dd>@if (key.ExpiresAt is { } expires) { <time datetime="@ApiKeyFormat.Machine(expires)">@ApiKeyFormat.Instant(expires)</time> } else { <span>Never</span> }</dd></div>
<div><dt>Last used</dt><dd>@if (key.LastUsedAt is { } used) { <time datetime="@ApiKeyFormat.Machine(used)">@ApiKeyFormat.Instant(used)</time> } else { <span>Never</span> }</dd></div>
@if (key.PreviousSecretExpiresAt is { } grace) { <div><dt>Previous secret</dt><dd>Works until <time datetime="@ApiKeyFormat.Machine(grace)">@ApiKeyFormat.Instant(grace)</time></dd></div> }
</dl></div></section>
<section class="ts-card" id="key-allowed-ips" aria-labelledby="key-allowed-ips-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="key-allowed-ips-title">Allowed IPs</h2></div><div class="ts-card-actions"><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" command="show-modal" commandfor="@cidrsDialog">@Icons.Render("Pencil", 14)<span>Edit</span></button></div></header><div class="ts-card-body">@if (key.AllowedCidrs is { Count: > 0 } cidrs) { <ul class="ts-apikeys-cidrs">@foreach (var cidr in cidrs) { <li><code>@cidr</code></li> }</ul> } else { <p class="ts-meta">Any IP</p> }</div></section>
@(await RenderPartialAsync<ApiKeyActionDialogs, ApiKeyActions>(Model.Actions))
<dialog id="@cidrsDialog" class="ts-dialog ts-apikeys-action-dialog" closedby="any" aria-labelledby="@(cidrsDialog + "-title")" data-init="@(Model.CidrsFailed ? "el.showModal()" : "void 0")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@(cidrsDialog + "-title")">Allowed IPs</h2></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@cidrsDialog">@Icons.Render("X", 18)</button></header>
<form method="post" data-submit-once action="/api/v1/dashboard/credentials/allowed-cidrs" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="keyId" value="@key.Id" /><input type="hidden" name="dialog" value="@cidrsDialog" /><input type="hidden" name="view" value="@ApiKeyPages.DetailsView" />
<div class="ts-field"><label class="ts-sr-only" for="@(cidrsDialog + "-value")">Allowed IPs</label><textarea class="ts-input ts-mono" id="@(cidrsDialog + "-value")" name="allowedCidrs" rows="4" maxlength="2080" spellcheck="false" autocomplete="off" placeholder="Any IP, or one CIDR per line: 203.0.113.0/24" aria-invalid="@(Model.CidrsFailed ? "true" : null)" aria-describedby="@(Model.CidrsFailed ? cidrsDialog + "-error" : null)">@(Model.DraftAllowedCidrs ?? ApiKeyFormat.Lines(key.AllowedCidrs))</textarea>@if (Model.CidrsFailed) { <p class="ts-field-error" id="@(cidrsDialog + "-error")" role="alert">@Model.Error</p> }</div>
<div class="ts-dialog-footer"><button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="@cidrsDialog">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Save</button></div></form></div></dialog>
</main>
@functions { public ShellModel LayoutModel => Model.Shell; }
