@using TerraScale.Dashboard.Features.ApiKeys
@inherits RazorSlice<ApiKeysPage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
<main class="ts-page ts-apikeys-page" data-project-id="@Model.Context.Project?.Id" data-organization-id="@Model.Context.Organization?.Id">
<header class="ts-page-header"><h1 class="ts-page-title">API keys</h1>@if (Model.Context.CanManageKeys) { <div class="ts-page-actions"><button class="ts-btn ts-btn-primary" type="button" command="show-modal" commandfor="create-key">@Icons.Render("KeyRound", 16)<span>New API key</span></button></div> }</header>
<div id="api-keys-content">@(await RenderPartialAsync<ApiKeysContent, ApiKeysPage>(Model))</div>
</main>
@functions { public ShellModel LayoutModel => Model.Shell; }
