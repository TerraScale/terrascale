@inherits RazorSlice<TerraScale.Dashboard.Features.ApiKeys.ApiKeysPage>
@implements IUsesLayout<TerraScale.Dashboard.Shared.UI.Slices.ShellDocument, ShellModel>
<main class="ts-page ts-apikeys-page" data-project-id="@Model.Context.Project?.Id" data-organization-id="@Model.Context.Organization?.Id">
<header class="ts-apikeys-header"><div class="ts-stack-sm"><h1>API keys</h1><p class="ts-meta">API keys and machine clients that let your applications reach this project’s databases.</p></div>@if (Model.Context.CanManage) { <div class="ts-page-actions"><button class="ts-btn ts-btn-primary" type="button" command="show-modal" commandfor="@(Model.TabKind.Length == 0 ? "create-credential" : "create-" + Model.TabKind)">@Icons.Render(Model.TabKind.Length == 0 ? "Plus" : Model.TabKind == "m2m" ? "Bot" : "KeyRound", 16)<span>@(Model.TabKind.Length == 0 ? "Create credential" : Model.TabKind == "m2m" ? "Create client" : "Create key")</span></button></div> }</header>
@if (Model.Error.Length > 0 && Model.Create.Length == 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
@if (Model.Revealed is not null) {
<section class="ts-alert ts-alert-success ts-apikeys-secret" data-signals="{_keyCopyStatus: ''}" data-list-url="@Model.With("/api-keys")" data-init="history.replaceState(null, '', el.dataset.listUrl)">
<h2 class="ts-alert-title">Secret for @Model.Revealed.Key.Name</h2><p class="ts-alert-body">Copy it now: it is shown only once. If you lose it, create a replacement key and revoke this key.</p>
<div class="ts-row">
<code id="api-key-secret" class="ts-apikeys-secret-value" tabindex="0" role="textbox" aria-readonly="true" aria-label="API key secret" aria-describedby="api-key-copy-help" data-on:focus="const range = document.createRange(); range.selectNodeContents(el); const selection = window.getSelection(); selection.removeAllRanges(); selection.addRange(range)">@Model.Revealed.Secret</code>
<button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" data-on:click="
    $_keyCopyStatus = 'Copying…';
    const secretOutput = document.getElementById('api-key-secret');
    const failed = () => { secretOutput.focus(); $_keyCopyStatus = 'Copy failed. Secret selected; press Ctrl+C or ⌘C to copy manually.'; };
    try {
        if (!navigator.clipboard?.writeText) { failed(); }
        else { navigator.clipboard.writeText(secretOutput.textContent).then(() => { $_keyCopyStatus = 'API key copied.'; }).catch(failed); }
    } catch { failed(); }
">@Icons.Render("Copy", 14)<span>Copy</span></button>
</div>
<p id="api-key-copy-help" class="ts-hint">To copy manually, focus the secret with Tab, then press Ctrl+C (Windows/Linux) or ⌘C (Mac).</p>
<p class="ts-hint" role="status" aria-live="polite" aria-atomic="true" data-text="$_keyCopyStatus"></p>
</section>
}
@if (Model.Context.CanManage) {
@(await RenderPartialAsync<TerraScale.Dashboard.Features.ApiKeys.ApiKeyCreateDialog, TerraScale.Dashboard.Features.ApiKeys.ApiKeysPage>(Model with { DialogKind = "key" }))
@(await RenderPartialAsync<TerraScale.Dashboard.Features.ApiKeys.ApiKeyCreateDialog, TerraScale.Dashboard.Features.ApiKeys.ApiKeysPage>(Model with { DialogKind = "m2m" }))
@if (Model.TabKind.Length == 0) {
<dialog id="create-credential" class="ts-dialog" closedby="any" aria-labelledby="create-credential-title" aria-describedby="create-credential-description"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="create-credential-title">Create credential</h2><p class="ts-dialog-description" id="create-credential-description">Choose the type of credential to create.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="create-credential">@Icons.Render("X", 18)</button></header><div class="ts-row"><a class="ts-btn ts-btn-secondary" href="@Model.With("/api-keys", create: "key")">@Icons.Render("KeyRound", 16)API key</a><a class="ts-btn ts-btn-secondary" href="@Model.With("/api-keys", create: "m2m")">@Icons.Render("Bot", 16)M2M client</a></div></div></dialog>
}}

<section class="ts-card @(Model.Filtered.Count > 0 ? "ts-card-flush" : "")" id="credentials" aria-labelledby="credentials-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="credentials-title">Credentials</h2><p class="ts-card-description">Keys and machine clients in the selected project.</p></div></header>
<form class="ts-filters ts-apikeys-filters" method="get" action="/api-keys" role="search" aria-label="@("Filter " + Model.TabLabel)"><input type="hidden" name="kind" value="@Model.TabKind" /><input class="ts-input" type="search" name="q" value="@Model.Search" placeholder="@Model.SearchLabel" aria-label="@Model.SearchLabel" /><nav class="ts-tabs ts-apikeys-kinds" aria-label="Credential types">@* ProjectCredential has no client kind, and Filtered returns no M2M rows, so the M2M count is 0. *@@foreach (var tab in new[] { (Kind: "", Label: "All credentials", Count: Model.Keys.Count), (Kind: "key", Label: "API keys", Count: Model.Keys.Count), (Kind: "m2m", Label: "M2M clients", Count: 0) }) { <a class="ts-tab" href="@Model.With("/api-keys", tab.Kind)" aria-current="@(Model.TabKind == tab.Kind ? "page" : null)"><span>@tab.Label</span><span class="ts-tab-count">@tab.Count</span></a> }</nav><select class="ts-select" name="status" aria-label="Status"><option value="">All statuses</option><option value="active" selected="@(Model.Status == "active")">Active</option><option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option></select><select class="ts-select" name="databaseId" aria-label="Database" title="@Model.DatabaseFilterTitle" data-on:change="el.title = el.selectedOptions[0].textContent"><option value="">All databases</option>@if (Model.Context.Project is not null) { @foreach (var database in Model.Context.Project.Databases.Values.OrderBy(database => database.Name)) { <option value="@database.Id" selected="@(Model.DatabaseId == database.Id)">@database.Name</option> } }</select><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Filter</button>@if (Model.Search.Length > 0 || Model.DatabaseId.Length > 0 || Model.Status.Length > 0) { <a class="ts-btn ts-btn-ghost ts-btn-sm" href="@Model.With("/api-keys", clear: true)">Clear</a> }</form><div class="ts-card-body">
@if (Model.Filtered.Count == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No credentials match these filters.</p><p class="ts-empty-detail">Change the filters or create a new credential.</p></div> }
else { <div class="ts-table-wrap"><table class="ts-table"><thead><tr><th>Name</th><th>Type</th><th>Prefix</th><th>Scopes</th><th>Database</th><th>Created by</th><th class="ts-apikeys-date">Created</th><th class="ts-apikeys-date">Expires</th><th>Allowed IPs</th><th class="ts-apikeys-date">Last used</th><th>Status</th>@if (Model.Context.CanManage) { <th class="ts-table-actions">Actions</th> }</tr></thead><tbody>
@foreach (var key in Model.Filtered) {
var type = TerraScale.Dashboard.Features.ApiKeys.ApiKeysPage.CredentialType(key);
<tr><td class="ts-strong">@key.Name</td><td><span class="ts-badge ts-badge-neutral ts-apikeys-type">@Icons.Render(type.Icon, 12)@type.Label</span></td><td><code>@(key.Id + "_")…</code></td><td><div class="ts-row ts-apikeys-scopes">@foreach (var scope in key.Scopes) { <span class="ts-badge ts-badge-neutral">@scope</span> }</div></td><td class="ts-meta">@(key.DatabaseName ?? "All project databases")</td><td class="ts-meta ts-break">@(key.CreatedByEmail.Length > 0 ? key.CreatedByEmail : key.CreatedByUserId.Length > 0 ? key.CreatedByUserId : "Unknown")</td><td class="ts-meta ts-mono ts-apikeys-date">@key.CreatedAt.UtcDateTime.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</td><td class="ts-meta ts-mono ts-apikeys-date">@(key.ExpiresAt?.UtcDateTime.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "No expiry")@if (TerraScale.Dashboard.Features.ApiKeys.ApiKeyService.ExpiresSoon(key, Model.Now)) { <span class="ts-badge ts-badge-warning">Expires soon</span> }</td><td><div class="ts-row ts-apikeys-scopes">@if (key.AllowedCidrs is { Count: > 0 } cidrs) { @foreach (var cidr in cidrs) { <code>@cidr</code> } } else { <span class="ts-meta">Any IP</span> }</div></td><td class="ts-meta ts-mono ts-apikeys-date">@(key.LastUsedAt?.UtcDateTime.ToString("MMM d, yyyy HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture) ?? "Never")</td><td><span class="ts-badge @(key.IsActive ? "ts-badge-success" : "ts-badge-neutral")"><span class="ts-dot" aria-hidden="true"></span>@(key.IsActive ? "Active" : "Expired")</span></td>
@if (Model.Context.CanManage) { <td class="ts-table-actions"><div class="ts-row ts-row-end"><button class="ts-btn ts-btn-ghost ts-btn-sm" type="button" command="show-modal" commandfor="@("cidrs-" + key.Id)"><span>Edit allowed IPs</span></button><button class="ts-btn ts-btn-secondary ts-btn-sm" type="button" command="show-modal" commandfor="@("rotate-" + key.Id)"><span>Rotate</span></button><button class="ts-btn ts-btn-danger ts-btn-sm" type="button" command="show-modal" commandfor="@("revoke-" + key.Id)"><span>Revoke</span></button></div>
@foreach (var action in new[] { "rotate", "revoke" }) {
var dialog = action + "-" + key.Id;
<dialog id="@dialog" class="ts-dialog" closedby="any" aria-labelledby="@(dialog + "-title")" aria-describedby="@(dialog + "-description")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@(dialog + "-title")">@(action == "rotate" ? "Rotate " : "Revoke ")@key.Name?</h2><p class="ts-dialog-description" id="@(dialog + "-description")">@(action == "rotate" ? "Rotating issues a new secret, shown once. With no grace, the old secret and its tokens stop everywhere within 2 seconds; open connections (including Postgres) close within 3 seconds. With a grace period, the old secret works until it ends; these bounds start then." : "Revoking stops this key everywhere within 2 seconds: new requests are refused and open connections (including Postgres) are closed within 3 seconds.")</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@dialog">@Icons.Render("X", 18)</button></header><form method="post" action="@Model.With("/api/v1/dashboard/credentials/" + action)"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="keyId" value="@key.Id" />@if (action == "rotate") { <label class="ts-field"><span class="ts-label">Old secret keeps working for</span><select class="ts-select" name="previousSecretTtl"><option value="0" selected>No grace period</option><option value="3600">1 hour</option><option value="86400">1 day</option></select></label> }<div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="@dialog">Cancel</button><button class="ts-btn @(action == "rotate" ? "ts-btn-primary" : "ts-btn-danger")" type="submit">@(action == "rotate" ? "Rotate secret" : "Revoke credential")</button></div></form></div></dialog>
}
<dialog id="@("cidrs-" + key.Id)" class="ts-dialog" closedby="any" aria-labelledby="@("cidrs-" + key.Id + "-title")"><div class="ts-dialog-content"><header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@("cidrs-" + key.Id + "-title")">Allowed IPs for @key.Name</h2><p class="ts-dialog-description">Requests with this key must come from one of these IPs, and from the project's list when it has one. Changes apply within 60 seconds.</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@("cidrs-" + key.Id)">@Icons.Render("X", 18)</button></header><form method="post" action="@Model.With("/api/v1/dashboard/credentials/allowed-cidrs")" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="keyId" value="@key.Id" /><label class="ts-field"><span class="ts-label">Allowed IPs (CIDR)</span><textarea class="ts-input ts-mono" name="allowedCidrs" rows="4" spellcheck="false" autocomplete="off">@TerraScale.Dashboard.Features.ApiKeys.ApiKeysPage.Lines(key.AllowedCidrs)</textarea><span class="ts-hint">One per line or comma separated, up to 32. Leave empty to allow any IP.</span></label><div class="ts-dialog-footer"><button class="ts-btn ts-btn-ghost" type="button" command="close" commandfor="@("cidrs-" + key.Id)">Cancel</button><button class="ts-btn ts-btn-primary" type="submit">Save allowed IPs</button></div></form></div></dialog></td>}
</tr>
}</tbody></table></div>}
</div></section>
<section class="ts-card" id="network-access" aria-labelledby="network-access-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="network-access-title">Network access</h2><p class="ts-card-description">Requests with any key in this project must come from these IPs, on top of each key's own list. Changes apply within 60 seconds.</p></div></header><div class="ts-card-body">
@if (Model.ProjectCidrs is null) { <p class="ts-meta" role="status">The project's allowed IPs are unavailable. Try again shortly.</p> }
else if (Model.Context.CanManage) { <form method="post" action="@Model.With("/api/v1/dashboard/credentials/project-allowed-cidrs")" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><label class="ts-field"><span class="ts-label">Allowed IPs (CIDR)</span><textarea class="ts-input ts-mono" name="allowedCidrs" rows="4" spellcheck="false" autocomplete="off" placeholder="203.0.113.0/24">@TerraScale.Dashboard.Features.ApiKeys.ApiKeysPage.Lines(Model.ProjectCidrs)</textarea><span class="ts-hint">One per line or comma separated, up to 32. Leave empty to allow any IP.</span></label><div class="ts-form-actions"><button class="ts-btn ts-btn-primary" type="submit">Save network access</button></div></form> }
else { <div class="ts-row ts-apikeys-scopes">@if (Model.ProjectCidrs.Count == 0) { <span class="ts-meta">Any IP</span> } else { @foreach (var cidr in Model.ProjectCidrs) { <code>@cidr</code> } }</div> }
</div></section></main>
@functions { public ShellModel LayoutModel => Model.Shell; }
