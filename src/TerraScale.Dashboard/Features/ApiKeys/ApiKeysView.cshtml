@using TerraScale.Dashboard.Features.ApiKeys
@inherits RazorSlice<ApiKeysPage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
<main class="ts-page ts-apikeys-page" data-project-id="@Model.Context.Project?.Id" data-organization-id="@Model.Context.Organization?.Id">
<h1 class="ts-sr-only">API keys</h1>
@if (Model.Error.Length > 0 && !Model.ErrorInDialog) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
@if (Model.Warning.Length > 0 && Model.Secret is null) { <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">@Model.Warning</p></div> }
@if (Model.Secret is { } secret) { @(await RenderPartialAsync<ApiKeySecretDialog, ApiKeySecret>(secret)) }
@if (Model.Context.CanManageKeys) {
@(await RenderPartialAsync<ApiKeyCreateDialog, ApiKeysPage>(Model with { DialogKind = "key" }))
}

<section class="ts-card @(Model.Filtered.Count > 0 ? "ts-card-flush" : "")" id="credentials" aria-labelledby="credentials-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="credentials-title">Credentials</h2></div>@if (Model.Context.CanManageKeys) { <div class="ts-card-actions"><button class="ts-btn ts-btn-primary ts-btn-sm" type="button" command="show-modal" commandfor="create-key">@Icons.Render("KeyRound", 16)<span>Create key</span></button></div> }</header>
<form class="ts-filters ts-apikeys-filters" method="get" action="/api-keys" role="search" aria-label="Filter API keys"><input class="ts-input" type="search" name="q" value="@Model.Search" placeholder="Search API keys" aria-label="Search API keys" maxlength="128" autocomplete="off" /><select class="ts-select" name="status" aria-label="Status"><option value="">All statuses</option><option value="active" selected="@(Model.Status == "active")">Active</option><option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option></select><select class="ts-select" name="databaseId" aria-label="Database" title="@Model.DatabaseFilterTitle" data-on:change="el.title = el.selectedOptions[0].textContent"><option value="">All databases</option>@if (Model.Context.Project is not null) { @foreach (var database in Model.Context.Project.Databases.Values.OrderBy(database => database.Name)) { <option value="@database.Id" selected="@(Model.DatabaseId == database.Id)">@database.Name</option> } }</select><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Filter</button>@if (Model.Search.Length > 0 || Model.DatabaseId.Length > 0 || Model.Status.Length > 0) { <a class="ts-btn ts-btn-ghost ts-btn-sm" href="@Model.With("/api-keys", clear: true)">Clear</a> }</form><div class="ts-card-body">
@if (Model.ViewerOnly) { <div class="ts-empty" role="status"><p class="ts-empty-title">Only project members can see API keys.</p></div> }
else if (Model.Filtered.Count == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No credentials match these filters.</p></div> }
else { <div class="ts-table-wrap"><table class="ts-table ts-table-stacked ts-apikeys-table"><thead><tr><th scope="col">Name</th><th scope="col">Key</th><th scope="col">Access</th><th scope="col">Last used</th><th scope="col">Expires</th>@if (Model.Context.CanManageKeys) { <th scope="col" class="ts-table-actions"><span class="ts-sr-only">Actions</span></th> }</tr></thead><tbody>
@foreach (var key in Model.Filtered) {
var details = "/api-keys/" + key.Id;
<tr data-key-id="@key.Id"><td class="ts-table-strong ts-apikeys-name"><a href="@details">@key.Name</a></td>
<td data-label="Key"><code class="ts-apikeys-hint" title="@(key.Id + "_")">@ApiKeyFormat.Hint(key)</code></td>
<td data-label="Access"><span class="ts-badge ts-badge-neutral ts-apikeys-access">@ApiKeyFormat.Access(key.Scopes)</span></td>
<td data-label="Last used" class="ts-meta">@if (key.LastUsedAt is { } used) { <time datetime="@ApiKeyFormat.Machine(used)" title="@ApiKeyFormat.Instant(used)">@ApiKeyFormat.Date(used)</time> } else { <span>Never</span> }</td>
<td data-label="Expires" class="ts-meta">@if (!key.IsActive) { <span class="ts-badge ts-badge-neutral"><span class="ts-dot" aria-hidden="true"></span>Expired</span> } else if (key.ExpiresAt is { } expires) { <span class="ts-apikeys-expiry"><time datetime="@ApiKeyFormat.Machine(expires)" title="@ApiKeyFormat.Instant(expires)">@ApiKeyFormat.Date(expires)</time>@if (ApiKeyService.ExpiresSoon(key, Model.Now)) { <span class="ts-badge ts-badge-warning">Expires soon</span> }</span> } else { <span>Never</span> }</td>
@if (Model.Context.CanManageKeys) { <td class="ts-table-actions"><div class="ts-row ts-apikeys-actions"><a class="ts-icon-btn" href="@details" aria-label="Details" title="Details">@Icons.Render("Info", 16)</a><button class="ts-icon-btn" type="button" command="show-modal" commandfor="@("rotate-" + key.Id)" aria-label="Rotate" title="Rotate">@Icons.Render("RotateCw", 16)</button><button class="ts-icon-btn ts-apikeys-revoke" type="button" command="show-modal" commandfor="@("revoke-" + key.Id)" aria-label="Revoke" title="Revoke">@Icons.Render("Trash2", 16)</button></div>
@(await RenderPartialAsync<ApiKeyActionDialogs, ApiKeyActions>(Model.Actions(key)))</td> }
</tr>
}</tbody></table></div>
@if (Model.HasMore || Model.Cursor.Length > 0) { <div class="ts-row ts-apikeys-paging" role="navigation" aria-label="Credentials pages">@if (Model.Cursor.Length > 0) { <a class="ts-btn ts-btn-ghost ts-btn-sm" href="@Model.With("/api-keys", clear: true)">First page</a> } @if (Model.HasMore) { <a class="ts-btn ts-btn-secondary ts-btn-sm" href="@Model.With("/api-keys")">Next</a> }</div> }}
</div></section></main>
@functions { public ShellModel LayoutModel => Model.Shell; }
