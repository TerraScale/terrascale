@using TerraScale.Dashboard.Features.ApiKeys
@inherits RazorSlice<ApiKeySecret>
<dialog id="key-secret" class="ts-dialog ts-apikeys-secret-dialog" closedby="none" aria-labelledby="key-secret-title" aria-describedby="key-secret-notice" data-done-url="@Model.DoneUrl" data-signals="{_keyCopied: false, _keyCopyStatus: '', _keyShown: false}" data-init="el.showModal(); history.replaceState(null, '', el.dataset.doneUrl)" data-on:cancel="evt.preventDefault()"><div class="ts-dialog-content">
<header class="ts-apikeys-secret-head"><span class="ts-apikeys-secret-badge" aria-hidden="true">@Icons.Render("Check", 20)</span><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="key-secret-title">@(Model.Rotated ? "API key rotated" : "API key created")</h2><p class="ts-apikeys-secret-sub">@Model.Revealed.Key.Name · @Model.DatabaseLabel</p></div></header>
@if (Model.Warning.Length > 0) { <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">@Model.Warning</p></div> }
<div class="ts-apikeys-secret-chips">@foreach (var scope in Model.Metadata.Scopes) { <span class="ts-apikeys-secret-chip">@scope</span> }<span class="ts-apikeys-secret-chip">@Model.ExpiryLabel</span></div>
<div class="ts-apikeys-secret-row" data-class:ts-apikeys-secret-open="$_keyShown"><span class="ts-apikeys-secret-mask" aria-hidden="true">@if (Model.Prefixed) {<span class="ts-apikeys-secret-prefix">sk_</span>}@Model.MaskHead…<span class="ts-apikeys-secret-bullets"></span>…@Model.MaskTail</span><code id="api-key-secret" class="ts-apikeys-secret-value" tabindex="-1" role="textbox" aria-readonly="true" aria-label="API key" data-attr:tabindex="$_keyShown ? '0' : '-1'" data-on:focus="const range = document.createRange(); range.selectNodeContents(el); const selection = window.getSelection(); selection.removeAllRanges(); selection.addRange(range)">@if (Model.Prefixed) {<span class="ts-apikeys-secret-prefix">sk_</span>}@Model.SecretBody</code><button class="ts-icon-btn" type="button" aria-pressed="false" aria-label="Show key" data-attr:aria-pressed="$_keyShown ? 'true' : 'false'" data-attr:aria-label="$_keyShown ? 'Hide key' : 'Show key'" data-on:click="$_keyShown = !$_keyShown">@Icons.Render("Eye", 16)</button></div>
<button class="ts-btn ts-btn-primary ts-btn-block ts-apikeys-copy" type="button" data-class:ts-apikeys-copied="$_keyCopied" data-on:click="
    const secretOutput = document.getElementById('api-key-secret');
    const failed = () => { $_keyCopied = false; secretOutput.focus(); $_keyCopyStatus = 'Copy failed. Secret selected; press Ctrl+C or ⌘C to copy manually.'; };
    try {
        if (!navigator.clipboard?.writeText) { failed(); }
        else { navigator.clipboard.writeText(secretOutput.textContent.trim()).then(() => { $_keyCopied = true; $_keyCopyStatus = 'API key copied.'; }).catch(failed); }
    } catch { failed(); }
"><span class="ts-apikeys-copy-idle">@Icons.Render("Copy", 16)</span><span class="ts-apikeys-copy-done">@Icons.Render("Check", 16)</span><span data-text="$_keyCopied ? 'Copied' : 'Copy API key'">Copy API key</span></button>
<p class="ts-apikeys-copy-status" role="status" aria-live="polite" aria-atomic="true" data-class:ts-sr-only="$_keyCopied" data-text="$_keyCopyStatus"></p>
<div class="ts-apikeys-secret-foot"><p class="ts-apikeys-secret-note" id="key-secret-notice">Shown once. Rotate the key if you lose it.</p><a class="ts-btn ts-btn-ghost ts-btn-sm" href="@Model.DoneUrl">Done</a></div>
</div></dialog>
