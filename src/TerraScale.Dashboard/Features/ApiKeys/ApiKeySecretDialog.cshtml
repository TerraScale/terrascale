@using TerraScale.Dashboard.Features.ApiKeys
@inherits RazorSlice<ApiKeySecret>
<dialog id="key-secret" class="ts-dialog ts-apikeys-secret-dialog" closedby="none" aria-labelledby="key-secret-title" aria-describedby="key-secret-notice" data-done-url="@Model.DoneUrl" data-signals="{_keyCopied: false, _keyCopyStatus: ''}" data-init="el.showModal(); history.replaceState(null, '', el.dataset.doneUrl)" data-on:cancel="evt.preventDefault()"><div class="ts-dialog-content">
<header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="key-secret-title">@(Model.Rotated ? "API key rotated" : "API key created")</h2></div></header>
@if (Model.Warning.Length > 0) { <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">@Model.Warning</p></div> }
<div class="ts-field"><span class="ts-label" id="key-secret-label">@Model.Revealed.Key.Name</span><div class="ts-apikeys-secret-field"><code id="api-key-secret" class="ts-apikeys-secret-value" tabindex="0" role="textbox" aria-readonly="true" aria-labelledby="key-secret-label" data-on:focus="const range = document.createRange(); range.selectNodeContents(el); const selection = window.getSelection(); selection.removeAllRanges(); selection.addRange(range)">@Model.Revealed.Secret</code><button class="ts-btn ts-btn-secondary ts-btn-sm ts-apikeys-copy" type="button" data-class:ts-apikeys-copied="$_keyCopied" data-on:click="
    const secretOutput = document.getElementById('api-key-secret');
    const failed = () => { $_keyCopied = false; secretOutput.focus(); $_keyCopyStatus = 'Copy failed. Secret selected; press Ctrl+C or ⌘C to copy manually.'; };
    try {
        if (!navigator.clipboard?.writeText) { failed(); }
        else { navigator.clipboard.writeText(secretOutput.textContent).then(() => { $_keyCopied = true; $_keyCopyStatus = 'API key copied.'; }).catch(failed); }
    } catch { failed(); }
"><span class="ts-apikeys-copy-idle">@Icons.Render("Copy", 14)</span><span class="ts-apikeys-copy-done">@Icons.Render("Check", 14)</span><span data-text="$_keyCopied ? 'Copied' : 'Copy'">Copy</span></button></div></div>
<p class="ts-apikeys-secret-notice" id="key-secret-notice">Copy it now. We won't show it again; rotate the key to get a new one.</p>
<p class="ts-meta ts-apikeys-copy-status" role="status" aria-live="polite" aria-atomic="true" data-text="$_keyCopyStatus"></p>
<div class="ts-dialog-footer"><a class="ts-btn ts-btn-primary" href="@Model.DoneUrl">Done</a></div>
</div></dialog>
