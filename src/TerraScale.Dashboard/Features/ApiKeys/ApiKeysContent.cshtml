@using TerraScale.Dashboard.Features.ApiKeys
@inherits RazorSlice<ApiKeysPage>
<div id="api-keys-content">
@if (Model.Error.Length > 0 && !Model.ErrorInDialog) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
@if (Model.Warning.Length > 0 && Model.Secret is null) { <div class="ts-alert ts-alert-warning" role="status"><p class="ts-alert-body">@Model.Warning</p></div> }
@if (Model.Secret is { } secret) { @(await RenderPartialAsync<ApiKeySecretDialog, ApiKeySecret>(secret)) }
@if (Model.Context.CanManageKeys) {
@(await RenderPartialAsync<ApiKeyCreateDialog, ApiKeysPage>(Model with { DialogKind = "key" }))
}
<section class="ts-card @(Model.Filtered.Count > 0 ? "ts-card-flush" : "")" id="credentials" aria-labelledby="credentials-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="credentials-title">Credentials</h2></div><div class="ts-card-actions"><form class="ts-filters ts-apikeys-filters" method="get" action="/api-keys" role="search" aria-label="Filter API keys" data-on:submit="evt.preventDefault(); history.replaceState(null, '', '/api-keys' + (new URLSearchParams(new FormData(el)).toString() ? '?' + new URLSearchParams(new FormData(el)) : '')); @@get('/api-keys', {contentType: 'form', retryMaxCount: 0})"><input class="ts-input" type="search" name="q" value="@Model.Search" placeholder="Search API keys" aria-label="Search API keys" maxlength="128" autocomplete="off" /><select class="ts-select" name="status" aria-label="Status" data-on:change="el.form.requestSubmit()"><option value="">All statuses</option><option value="active" selected="@(Model.Status == "active")">Active</option><option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option></select><select class="ts-select" name="databaseId" aria-label="Database" title="@Model.DatabaseFilterTitle" data-on:change="el.title = el.selectedOptions[0].textContent; el.form.requestSubmit()"><option value="">All databases</option>@if (Model.Context.Project is not null) { @foreach (var database in Model.Context.Project.Databases.Values.OrderBy(database => database.Name)) { <option value="@database.Id" selected="@(Model.DatabaseId == database.Id)">@database.Name</option> } }</select>@if (Model.Search.Length > 0 || Model.DatabaseId.Length > 0 || Model.Status.Length > 0) { <a class="ts-btn ts-btn-ghost ts-btn-sm" href="@Model.With("/api-keys", clear: true)">Clear</a> }</form></div></header>
<div class="ts-card-body">@(await RenderPartialAsync<ApiKeysPatch, ApiKeysPage>(Model))</div></section>
</div>
