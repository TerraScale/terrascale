@using TerraScale.Dashboard.Features.ApiKeys
@inherits RazorSlice<ApiKeyActions>
@foreach (var action in new[] { "rotate", "revoke" }) {
var dialog = action + "-" + Model.Key.Id;
var rotate = action == "rotate";
var failed = Model.Error.Length > 0 && Model.Reopen == dialog;
<dialog id="@dialog" class="ts-dialog ts-apikeys-action-dialog" closedby="any" aria-labelledby="@(dialog + "-title")" aria-describedby="@(dialog + "-description")" data-init="@(failed ? "el.showModal()" : "void 0")"><div class="ts-dialog-content">
<header class="ts-dialog-head"><div class="ts-dialog-header"><h2 class="ts-dialog-title" id="@(dialog + "-title")">@(rotate ? "Rotate " : "Revoke ")@Model.Key.Name?</h2><p class="ts-dialog-description" id="@(dialog + "-description")">@(rotate ? "The old secret stops working within 2 seconds after the grace period, and its open connections close within 3 seconds." : "This key stops working everywhere within 2 seconds, and its open connections close within 3 seconds.")</p></div><button class="ts-icon-btn" type="button" aria-label="Close" command="close" commandfor="@dialog">@Icons.Render("X", 18)</button></header>
@if (rotate && Model.Key.PreviousSecretExpiresAt is { } grace && grace > Model.Now) { <p class="ts-dialog-description">The previous secret still works until <time datetime="@ApiKeyFormat.Machine(grace)">@ApiKeyFormat.Instant(grace)</time>. Rotating now ends it immediately.</p> }
<form method="post" data-submit-once action="@("/api/v1/dashboard/credentials/" + action + Model.Query)" class="ts-form"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><input type="hidden" name="keyId" value="@Model.Key.Id" /><input type="hidden" name="dialog" value="@dialog" />@if (Model.View.Length > 0) { <input type="hidden" name="view" value="@Model.View" /> }
@if (failed) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
@if (rotate) { <div class="ts-field"><label class="ts-label" for="@(dialog + "-grace")">Grace period</label><select class="ts-select" id="@(dialog + "-grace")" name="previousSecretTtl" required>@foreach (var option in new[] { (Seconds: "0", Label: "None"), (Seconds: "3600", Label: "1 hour"), (Seconds: "86400", Label: "1 day") }) { <option value="@option.Seconds" selected="@(failed && Model.DraftGrace.Length > 0 ? Model.DraftGrace == option.Seconds : option.Seconds == "0")">@option.Label</option> }</select></div> }
<div class="ts-dialog-footer"><button class="ts-btn ts-btn-secondary" type="button" command="close" commandfor="@dialog">Cancel</button><button class="ts-btn @(rotate ? "ts-btn-primary" : "ts-btn-danger")" type="submit">@(rotate ? "Rotate key" : "Revoke key")</button></div>
</form></div></dialog>
}
