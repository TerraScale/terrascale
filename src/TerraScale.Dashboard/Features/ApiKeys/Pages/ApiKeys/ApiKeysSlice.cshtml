@inherits RazorSlice<ApiKeysPageModel>
@using System
@using TerraScale.Dashboard.Features.ApiKeys
@{
    var shell = Model.Shell;
    string StatusTone(string status) => status switch { "Active" => "ts-badge-success", "Expiring" => "ts-badge-warning", _ => "ts-badge-danger" };
    string ScopeSummary(string[] scopes) => scopes.Length == 0 ? "No scopes" : scopes.Length == 1 ? scopes[0] : $"{scopes[0]} +{scopes.Length - 1}";
    string DatabaseLabel(string id) => id.Length == 0 ? "Project" : (Model.Databases.FirstOrDefault(d => d.Id == id).Name ?? id);
    string LastUsed(CredentialView c) => ApiKeyFormatting.UtcDateTime(c.LastUsedAt);
    string Expires(CredentialView c) => ApiKeyFormatting.UtcDateTime(c.ExpiresAt);
}
@ShellHtml.Top(shell)
<div class="ts-page ts-notes-page">
    @if (Model.LoadError is { } loadError)
    {
        <div class="ts-alert ts-alert-warning">
            <span class="ts-alert-title">@Icons.TriangleAlert(16) @loadError</span>
        </div>
    }

    <section class="ts-apikeys-section">
        <div class="ts-apikeys-heading">
            <div>
                <h2 class="ts-panel-title">Credentials</h2>
                <p class="ts-panel-subtitle">API keys and machine-to-machine clients stored by the authentication service</p>
            </div>
            <div class="ts-apikeys-actions">
                <a class="ts-btn ts-btn-primary ts-btn-lg" href="/api-keys?create=key">@Icons.Plus(16) Create key</a>
                <a class="ts-btn ts-btn-secondary ts-btn-lg" href="/api-keys?create=m2m">@Icons.Cpu(16) Create OAuth client</a>
            </div>
        </div>

        <div class="ts-apikeys-counts" aria-label="Credential counts">
            <span><strong>@Model.ActiveKeys</strong> active keys</span>
            <span><strong>@Model.Expiring</strong> expiring</span>
            <span><strong>@Model.M2mClients</strong> M2M clients</span>
        </div>

        <form class="ts-filter-bar ts-apikeys-filters" method="get" action="/api-keys" role="search">
            <div class="ts-filter-field ts-apikeys-search">
                <label class="ts-filter-label" for="credential-filter">Filter credentials</label>
                <div class="ts-apikeys-search-box">
                    @Icons.Search(16)
                    <input class="ts-input ts-search-input" id="credential-filter" type="search" name="q" value="@Model.Query" placeholder="Search credentials" />
                </div>
            </div>
            <div class="ts-filter-field">
                <span class="ts-filter-label" id="credential-kind-label">Type</span>
                <input type="hidden" name="kind" value="@Model.Kind" />
                <details class="ts-menu ts-filter-menu">
                    <summary class="ts-select ts-filter-select ts-filter-trigger" aria-labelledby="credential-kind-label credential-kind-value"><span id="credential-kind-value">@(Model.Kind == "key" ? "API keys" : Model.Kind == "m2m" ? "M2M clients" : "All types")</span></summary>
                    <div class="ts-menu-panel">
                        <button class="ts-menu-item" type="button" data-filter-value="" aria-current="@(Model.Kind == "" ? "true" : null)">All types</button>
                        <button class="ts-menu-item" type="button" data-filter-value="key" aria-current="@(Model.Kind == "key" ? "true" : null)">API keys</button>
                        <button class="ts-menu-item" type="button" data-filter-value="m2m" aria-current="@(Model.Kind == "m2m" ? "true" : null)">M2M clients</button>
                    </div>
                </details>
            </div>
            <div class="ts-filter-field">
                <span class="ts-filter-label" id="credential-status-label">Status</span>
                <input type="hidden" name="status" value="@Model.Status" />
                <details class="ts-menu ts-filter-menu">
                    <summary class="ts-select ts-filter-select ts-filter-trigger" aria-labelledby="credential-status-label credential-status-value"><span id="credential-status-value">@(Model.Status == "Active" || Model.Status == "Expiring" || Model.Status == "Revoked" ? Model.Status : "All statuses")</span></summary>
                    <div class="ts-menu-panel">
                        <button class="ts-menu-item" type="button" data-filter-value="" aria-current="@(Model.Status == "" ? "true" : null)">All statuses</button>
                        <button class="ts-menu-item" type="button" data-filter-value="Active" aria-current="@(Model.Status == "Active" ? "true" : null)">Active</button>
                        <button class="ts-menu-item" type="button" data-filter-value="Expiring" aria-current="@(Model.Status == "Expiring" ? "true" : null)">Expiring</button>
                        <button class="ts-menu-item" type="button" data-filter-value="Revoked" aria-current="@(Model.Status == "Revoked" ? "true" : null)">Revoked</button>
                    </div>
                </details>
            </div>
            <div class="ts-filter-field">
                <span class="ts-filter-label" id="credential-database-label">Database</span>
                <input type="hidden" name="database" value="@Model.DatabaseId" />
                <details class="ts-menu ts-filter-menu">
                    <summary class="ts-select ts-filter-select ts-filter-trigger" aria-labelledby="credential-database-label credential-database-value"><span id="credential-database-value">@(Model.Databases.FirstOrDefault(d => d.Id == Model.DatabaseId).Name ?? "All databases")</span></summary>
                    <div class="ts-menu-panel">
                        <button class="ts-menu-item" type="button" data-filter-value="" aria-current="@(Model.DatabaseId == "" ? "true" : null)">All databases</button>
                        @foreach (var database in Model.Databases)
                        {
                            <button class="ts-menu-item" type="button" data-filter-value="@database.Id" aria-current="@(Model.DatabaseId == database.Id ? "true" : null)">@database.Name</button>
                        }
                    </div>
                </details>
            </div>
            <button class="ts-btn ts-btn-secondary ts-btn-lg" type="submit">Apply filters</button>
            @if (Model.Query.Length > 0 || Model.Kind.Length > 0 || Model.Status.Length > 0 || Model.DatabaseId.Length > 0)
            {
                <a class="ts-btn ts-btn-ghost ts-btn-lg" href="/api-keys">Clear</a>
            }
        </form>

        @if (!Model.HasAnyCredentials)
        {
            <div class="ts-credential-empty">
                <div class="ts-empty-state">
                    <div class="ts-empty-state-content">
                        <div class="ts-empty-state-iconbox">@Icons.SearchX(16)</div>
                        <span class="ts-empty-state-title">No credentials</span>
                        <p class="ts-empty-state-desc">Create an API key or a machine client when a service needs to authenticate with this project.</p>
                    </div>
                    <div class="ts-empty-state-action">
                        <a class="ts-btn ts-btn-secondary ts-btn-lg" href="/api-keys?create=key">Create key</a>
                    </div>
                </div>
            </div>
        }
        else if (Model.Credentials.Count == 0)
        {
            <div class="ts-credential-empty">
                <div class="ts-empty-state">
                    <div class="ts-empty-state-content">
                        <div class="ts-empty-state-iconbox">@Icons.SearchX(16)</div>
                        <span class="ts-empty-state-title">No credentials match</span>
                        <p class="ts-empty-state-desc">Adjust the search or filters to see another credential.</p>
                    </div>
                    <div class="ts-empty-state-action">
                        <a class="ts-btn ts-btn-secondary ts-btn-lg" href="/api-keys">Clear filters</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="ts-table-wrap ts-apikeys-table-wrap">
                <table class="ts-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Credential</th>
                            <th>Scope</th>
                            <th>Database</th>
                            <th>Owner</th>
                            <th>Last used</th>
                            <th>Expires</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var credential in Model.Credentials)
                        {
                            var revoked = credential.Status == "Revoked";
                            <tr>
                                <td>
                                    <div class="ts-credential-name">
                                        @(credential.Kind == "key" ? Icons.KeyRound(15) : Icons.Cpu(15))
                                        <span class="ts-credential-name-text">@credential.Name</span>
                                    </div>
                                </td>
                                <td><span class="ts-badge @(credential.Kind == "key" ? "ts-badge-info" : "ts-badge-neutral")">@(credential.Kind == "key" ? "API key" : "M2M client")</span></td>
                                <td class="ts-table-mono ts-credential-mono">@credential.Prefix...@credential.LastFour</td>
                                <td class="ts-credential-meta">@ScopeSummary(credential.Scopes)</td>
                                <td class="ts-credential-meta">@DatabaseLabel(credential.DatabaseId)</td>
                                <td class="ts-credential-meta">@(credential.CreatedByEmail.Length > 0 ? credential.CreatedByEmail : "System")</td>
                                <td class="ts-credential-meta">@LastUsed(credential)</td>
                                <td class="ts-credential-meta">@Expires(credential)</td>
                                <td><span class="ts-badge @StatusTone(credential.Status)">@credential.Status</span></td>
                                <td>
                                    <div class="ts-credential-actions">
                                        <form method="post" action="/api/v1/dashboard/credentials/rotate">
                                            <input type="hidden" name="kind" value="@credential.Kind" />
                                            <input type="hidden" name="id" value="@credential.Id" />
                                            <input type="hidden" name="name" value="@credential.Name" />
                                            <button type="submit" class="ts-btn ts-btn-ghost ts-btn-lg" @(revoked ? "disabled" : null)>@Icons.RotateCw(14) Rotate</button>
                                        </form>
                                        <button type="button" class="ts-btn ts-btn-destructive ts-btn-lg" @(revoked ? "disabled" : null) data-on:click="document.querySelector('#revoke-@credential.Kind-@credential.Id').showModal()">Revoke</button>
                                    </div>
                                </td>
                            </tr>
                            <dialog class="ts-dialog" id="revoke-@credential.Kind-@credential.Id">
                                <div class="ts-dialog-content">
                                    <div class="ts-dialog-header">
                                        <h3 class="ts-dialog-title">Revoke credential</h3>
                                        <p class="ts-dialog-description">This action cannot be undone.</p>
                                    </div>
                                    <div class="ts-alert ts-alert-danger">
                                        <span class="ts-alert-title">@Icons.CircleAlert(16) Revoke @credential.Name?</span>
                                        <span class="ts-alert-body">Revoking stops the credential from authenticating immediately. Consumers still using it will begin failing, and the credential cannot be restored.</span>
                                    </div>
                                    <div class="ts-dialog-footer">
                                        <button type="button" class="ts-btn ts-btn-ghost ts-btn-lg" data-on:click="document.querySelector('#revoke-@credential.Kind-@credential.Id').close()">Cancel</button>
                                        <form method="post" action="/api/v1/dashboard/credentials/revoke">
                                            <input type="hidden" name="kind" value="@credential.Kind" />
                                            <input type="hidden" name="id" value="@credential.Id" />
                                            <input type="hidden" name="name" value="@credential.Name" />
                                            <button type="submit" class="ts-btn ts-btn-destructive ts-btn-lg">@Icons.ShieldOff(16) Revoke permanently</button>
                                        </form>
                                    </div>
                                </div>
                            </dialog>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<dialog class="ts-dialog" id="create-key-dialog" @(Model.CreateKind == "key" ? "data-autoopen" : null)>
    <div class="ts-dialog-content">
        <div class="ts-dialog-header">
            <h3 class="ts-dialog-title">Create API key</h3>
            <p class="ts-dialog-description">Create a persisted project credential through the authentication API.</p>
        </div>
        @if (Model.Error is { } error && Model.CreateKind == "key")
        {
            <div class="ts-alert ts-alert-danger"><span class="ts-alert-title">@Icons.CircleAlert(16) @error</span></div>
        }
        <form class="ts-form" method="post" action="/api/v1/dashboard/credentials/key">
            <div class="ts-field">
                <label class="ts-label" for="key-name">Name</label>
                <input class="ts-input" id="key-name" name="name" required placeholder="Service credential" />
            </div>
            <div class="ts-field">
                <label class="ts-label" for="key-scopes">Scopes</label>
                <input class="ts-input" id="key-scopes" name="scopes" required placeholder="database:read, database:write" />
                <span class="ts-hint">Separate scopes with commas, spaces, or new lines.</span>
            </div>
            <div class="ts-field">
                <label class="ts-label" for="key-database">Database</label>
                <select class="ts-select" id="key-database" name="databaseId">
                    <option value="">Project</option>
                    @foreach (var database in Model.Databases)
                    {
                        <option value="@database.Id">@database.Name</option>
                    }
                </select>
            </div>
            <div class="ts-field">
                <label class="ts-label" for="key-expires">Expires at</label>
                <input class="ts-input" id="key-expires" name="expiresAt" type="datetime-local" />
                <span class="ts-hint">Leave blank for a non-expiring credential if the project policy allows it.</span>
            </div>
            <div class="ts-form-actions">
                <a class="ts-btn ts-btn-ghost ts-btn-lg" href="/api-keys">Cancel</a>
                <button type="submit" class="ts-btn ts-btn-primary ts-btn-lg">@Icons.KeyRound(16) Create key</button>
            </div>
        </form>
    </div>
</dialog>

<dialog class="ts-dialog" id="create-m2m-dialog" @(Model.CreateKind == "m2m" ? "data-autoopen" : null)>
    <div class="ts-dialog-content">
        <div class="ts-dialog-header">
            <h3 class="ts-dialog-title">Create OAuth client</h3>
            <p class="ts-dialog-description">Create a persisted project credential through the authentication API.</p>
        </div>
        @if (Model.Error is { } m2mError && Model.CreateKind == "m2m")
        {
            <div class="ts-alert ts-alert-danger"><span class="ts-alert-title">@Icons.CircleAlert(16) @m2mError</span></div>
        }
        <form class="ts-form" method="post" action="/api/v1/dashboard/credentials/m2m">
            <div class="ts-field">
                <label class="ts-label" for="m2m-name">Name</label>
                <input class="ts-input" id="m2m-name" name="name" required placeholder="Service credential" />
            </div>
            <div class="ts-field">
                <label class="ts-label" for="m2m-scopes">Scopes</label>
                <input class="ts-input" id="m2m-scopes" name="scopes" required placeholder="database:read, database:write" />
                <span class="ts-hint">Separate scopes with commas, spaces, or new lines.</span>
            </div>
            <div class="ts-field">
                <label class="ts-label" for="m2m-database">Database</label>
                <select class="ts-select" id="m2m-database" name="databaseId">
                    <option value="">Project</option>
                    @foreach (var database in Model.Databases)
                    {
                        <option value="@database.Id">@database.Name</option>
                    }
                </select>
            </div>
            <div class="ts-field">
                <label class="ts-label" for="m2m-expires">Expires at</label>
                <input class="ts-input" id="m2m-expires" name="expiresAt" type="datetime-local" />
                <span class="ts-hint">Leave blank for a non-expiring credential if the project policy allows it.</span>
            </div>
            <div class="ts-form-actions">
                <a class="ts-btn ts-btn-ghost ts-btn-lg" href="/api-keys">Cancel</a>
                <button type="submit" class="ts-btn ts-btn-primary ts-btn-lg">@Icons.KeyRound(16) Create OAuth client</button>
            </div>
        </form>
    </div>
</dialog>

@if (Model.SecretValue is { } secret)
{
    <dialog class="ts-dialog" data-autoopen>
        <div class="ts-dialog-content">
            <div class="ts-dialog-header">
                <h3 class="ts-dialog-title">Credential secret</h3>
                <p class="ts-dialog-description">Copy this secret now. It will not be shown again.</p>
            </div>
            <div class="ts-alert ts-alert-warning">
                <span class="ts-alert-title">@Icons.TriangleAlert(16) Secret is shown once</span>
                <span class="ts-alert-body">Store this credential secret in a secure vault before closing this dialog.</span>
            </div>
            <dl class="ts-secret-list">
                <div class="ts-secret-row"><dt class="ts-muted">Project</dt><dd class="ts-secret-value">@shell.Store.ActiveProjectId</dd></div>
                <div class="ts-secret-row"><dt class="ts-muted">Credential</dt><dd class="ts-secret-value">@Model.SecretId</dd></div>
                <div class="ts-secret-row"><dt class="ts-muted">Name</dt><dd class="ts-secret-value">@Model.SecretName</dd></div>
                <div class="ts-secret-section">
                    <dt class="ts-muted">Secret</dt>
                    <dd class="ts-secret-secret-row">
                        <code class="ts-secret-code">@secret</code>
                        <button type="button" class="ts-icon-btn" data-copy="@secret" aria-label="Copy secret">@Icons.Copy(15)</button>
                    </dd>
                </div>
            </dl>
            <div class="ts-form-actions">
                <button type="button" class="ts-btn ts-btn-primary ts-btn-lg" data-copy="@secret">@Icons.Copy(16)<span data-copy-label>Copy secret</span></button>
                <a class="ts-btn ts-btn-ghost ts-btn-lg" href="/api-keys">Done</a>
            </div>
        </div>
    </dialog>
}

@if (Model.Toast is { } toast)
{
    <div class="ts-toasts"><div class="ts-toast"><span class="ts-alert-title">@Icons.CircleCheck(16) @toast</span></div></div>
}
@ShellHtml.Bottom(shell)
