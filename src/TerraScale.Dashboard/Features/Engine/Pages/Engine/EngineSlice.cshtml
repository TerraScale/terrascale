@inherits RazorSlice<EnginePageModel>
@{
    var shell = Model.Shell;
    string ReadyTone(bool healthy) => healthy ? "ts-badge-success" : "ts-badge-danger";
    string AvailableTone(bool available) => available ? "ts-badge-success" : "ts-badge-neutral";
}
@ShellHtml.Top(shell)
<div class="ts-page ts-engine-page">
    <div class="ts-toolbar">
        <nav class="ts-tabs" aria-label="Engine sections">
            <a class="ts-tab" href="/engine" aria-current="page" aria-selected="true">@Icons.Activity(16) Engine</a>
        </nav>
        @if (Model.Configured)
        {
            <a class="ts-btn ts-btn-ghost" href="/engine">@Icons.RefreshCw(16) Refresh</a>
        }
    </div>

    @if (!Model.Configured)
    {
        <section class="ts-section ts-engine-section" aria-labelledby="engine-not-configured-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="engine-not-configured-title">Engine observability is not configured</h2>
                    <p class="ts-meta">This page reads live TerraBase member health, the region catalog, and the Prometheus metric surface.</p>
                </div>
                <span class="ts-badge ts-badge-warning">Not configured</span>
            </div>
            <div class="ts-alert ts-alert-info ts-engine-setup-alert" role="status">
                <span class="ts-alert-title">@Icons.Terminal(16) Point the dashboard at a TerraBase host</span>
                <span class="ts-alert-body">
                    Set <code>TERRABASE_URL</code> to the TerraBase origin and optionally
                    <code>TERRABASE_API_KEY</code> to a member API key, then restart the dashboard,<br />
                    for example:<br />
                    <code>TERRABASE_URL=http://127.0.0.1:8080 TERRABASE_API_KEY=dev dotnet run --project src/TerraScale.Dashboard</code>
                </span>
            </div>
        </section>
    }
    else
    {
        <section class="ts-section ts-engine-section" aria-labelledby="engine-health-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="engine-health-title">Member health</h2>
                    <p class="ts-meta">Live from <code>@Model.Url</code></p>
                </div>
            </div>
            @if (Model.Health is not null)
            {
                <dl class="ts-kpis" aria-label="Member health facts">
                    <div>
                        <dt>@Icons.Globe2(14) Region</dt>
                        <dd><span class="ts-kpi-value">@Model.Health.Region</span></dd>
                        <small class="ts-meta">Serving member region</small>
                    </div>
                    <div>
                        <dt>@Icons.Server(14) Build</dt>
                        <dd><span class="ts-kpi-value">@Model.Health.Version</span></dd>
                        <small class="ts-meta">Member build version</small>
                    </div>
                    <div>
                        <dt>@Icons.Activity(14) Ready</dt>
                        <dd><span class="ts-kpi-value"><span class="ts-badge @ReadyTone(Model.Health.Healthy)">@(Model.Health.Healthy ? "Healthy" : "Unhealthy")</span></span></dd>
                        <small class="ts-meta">Member readiness</small>
                    </div>
                    <div>
                        <dt>@Icons.Gauge(14) Metric samples</dt>
                        <dd><span class="ts-kpi-value">@DashboardStore.FormatNumber(Model.SampleCount)</span></dd>
                        <small class="ts-meta">Scraped from /internal/metrics</small>
                    </div>
                </dl>
            }
            else
            {
                <div class="ts-alert ts-alert-danger" role="alert">
                    <span class="ts-alert-title">@Icons.TriangleAlert(16) Member health unavailable</span>
                    <span class="ts-alert-body"><code>GET /api/v1/health</code> failed: @Model.HealthError</span>
                </div>
            }
        </section>

        <section class="ts-section ts-engine-section" aria-labelledby="engine-regions-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="engine-regions-title">Region catalog</h2>
                    <p class="ts-meta">Regions and validated member hosts advertised by the TerraBase host.</p>
                </div>
                @if (Model.Regions is not null)
                {
                    <span class="ts-badge ts-badge-neutral">@DashboardStore.FormatNumber(Model.RegionsTotal) regions · @DashboardStore.FormatNumber(Model.HostCount) hosts</span>
                }
            </div>
            @if (Model.Regions is not null)
            {
                if (Model.Regions.Count is 0)
                {
                    @EmptyState("No regions reported", "The configured TerraBase host returned an empty region catalog.")
                }
                else
                {
                    <div class="ts-table-wrap ts-engine-table-wrap">
                        <table class="ts-table">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Country</th>
                                    <th>Coordinates</th>
                                    <th>Available</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var region in Model.Regions)
                                {
                                    <tr>
                                        <td><span class="ts-badge ts-badge-neutral">@region.Code</span></td>
                                        <td class="ts-table-strong">@region.Name</td>
                                        <td class="ts-muted">@region.Country</td>
                                        <td class="ts-muted">@region.Latitude.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture), @region.Longitude.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</td>
                                        <td><span class="ts-badge @AvailableTone(region.Available)">@(region.Available ? "Available" : "Unavailable")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <nav class="ts-pager" aria-label="Region catalog pages">
                        <span class="ts-meta">Showing @Model.RegionsFirst–@Model.RegionsLast of @Model.RegionsTotal regions</span>
                        @if (Model.RegionsPageCount > 1)
                        {
                            <div class="ts-row ts-row-tight">
                                @if (Model.RegionsPage > 1)
                                {
                                    <a class="ts-btn ts-btn-ghost" href="@Model.RegionsHref(Model.RegionsPage - 1)" rel="prev">@Icons.ArrowLeft(14) Previous</a>
                                }
                                @for (var pageNumber = 1; pageNumber <= Model.RegionsPageCount; pageNumber++)
                                {
                                    <a class="ts-btn ts-btn-ghost ts-pager-page" href="@Model.RegionsHref(pageNumber)" aria-current="@(pageNumber == Model.RegionsPage ? "page" : null)">@pageNumber</a>
                                }
                                @if (Model.RegionsPage < Model.RegionsPageCount)
                                {
                                    <a class="ts-btn ts-btn-ghost" href="@Model.RegionsHref(Model.RegionsPage + 1)" rel="next">Next @Icons.ChevronRight(14)</a>
                                }
                            </div>
                        }
                    </nav>
                }
            }
            else
            {
                <div class="ts-alert ts-alert-danger" role="alert">
                    <span class="ts-alert-title">@Icons.TriangleAlert(16) Region catalog unavailable</span>
                    <span class="ts-alert-body"><code>GET /api/v1/regions</code> failed: @Model.CatalogError</span>
                </div>
            }
        </section>

        <section class="ts-section ts-engine-section" aria-labelledby="engine-metrics-title">
            <div class="ts-section-head">
                <div>
                    <h2 class="ts-panel-title" id="engine-metrics-title">Metric surface</h2>
                    <p class="ts-meta">Prometheus metric families exposed at <code>/internal/metrics</code>.</p>
                </div>
                @if (Model.Metrics is not null)
                {
                    <span class="ts-badge ts-badge-neutral">@DashboardStore.FormatNumber(Model.MetricsTotal) families</span>
                }
            </div>
            @if (Model.Metrics is not null)
            {
                if (Model.Metrics.Count is 0)
                {
                    @EmptyState("No metric families reported", "The configured TerraBase host returned no Prometheus metric families.")
                }
                else
                {
                    <div class="ts-table-wrap ts-engine-metric-list ts-engine-table-wrap">
                        <table class="ts-table">
                            <thead>
                                <tr>
                                    <th>Metric</th>
                                    <th>Help</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var metric in Model.Metrics)
                                {
                                    <tr>
                                        <td><code>@metric.Name</code></td>
                                        <td class="ts-muted">@metric.Help</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <nav class="ts-pager" aria-label="Metric family pages">
                        <span class="ts-meta">Showing @Model.MetricsFirst–@Model.MetricsLast of @Model.MetricsTotal metric families</span>
                        @if (Model.MetricsPageCount > 1)
                        {
                            <div class="ts-row ts-row-tight">
                                @if (Model.MetricsPage > 1)
                                {
                                    <a class="ts-btn ts-btn-ghost" href="@Model.MetricsHref(Model.MetricsPage - 1)" rel="prev">@Icons.ArrowLeft(14) Previous</a>
                                }
                                @for (var pageNumber = 1; pageNumber <= Model.MetricsPageCount; pageNumber++)
                                {
                                    <a class="ts-btn ts-btn-ghost ts-pager-page" href="@Model.MetricsHref(pageNumber)" aria-current="@(pageNumber == Model.MetricsPage ? "page" : null)">@pageNumber</a>
                                }
                                @if (Model.MetricsPage < Model.MetricsPageCount)
                                {
                                    <a class="ts-btn ts-btn-ghost" href="@Model.MetricsHref(Model.MetricsPage + 1)" rel="next">Next @Icons.ChevronRight(14)</a>
                                }
                            </div>
                        }
                    </nav>
                }
            }
            else
            {
                <div class="ts-alert ts-alert-danger" role="alert">
                    <span class="ts-alert-title">@Icons.TriangleAlert(16) Metric surface unavailable</span>
                    <span class="ts-alert-body"><code>GET /internal/metrics</code> failed: @Model.MetricsError</span>
                </div>
            }
        </section>
    }
</div>
@ShellHtml.Bottom(shell)

@functions {
    private static Microsoft.AspNetCore.Html.HtmlString EmptyState(string title, string description) => new(
        $"<div class=\"ts-empty\"><span class=\"ts-empty-icon\">{Icons.SearchX(16).Value}</span><span class=\"ts-empty-title\">{title}</span><span class=\"ts-empty-meta\">{description}</span></div>");
}
