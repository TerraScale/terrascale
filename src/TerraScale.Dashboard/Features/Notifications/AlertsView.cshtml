@inherits RazorSlice<TerraScale.Dashboard.Features.Notifications.AlertsPage>
@implements IUsesLayout<TerraScale.Dashboard.Common.UI.Slices.ShellDocument, ShellModel>
@using System.Globalization
@using TerraScale.Dashboard.Features.Notifications
<main class="ts-page">
<h1 class="ts-sr-only">Alerts</h1><div class="ts-page-actions"><a class="ts-btn ts-btn-ghost" href="/notifications">Notifications</a></div>
@if (Model.Error.Length > 0) { <div class="ts-alert ts-alert-danger" role="alert"><p class="ts-alert-body">@Model.Error</p></div> }
@if (Model.Created is { } created && Model.Secret is { } secret)
{
<section class="ts-card" aria-labelledby="alert-secret-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="alert-secret-title">Webhook signing secret for @created.Name</h2><p class="ts-card-description">Store it now; it cannot be shown again. Decode it as base64url bytes and verify X-TerraScale-Signature (v1=HMAC-SHA256 of "timestamp.body").</p></div></header><div class="ts-card-body ts-stack"><pre class="ts-code" id="alert-secret" data-on:pagehide__window="el.textContent = ''">@secret</pre><a class="ts-btn ts-btn-primary" href="/notifications/alerts">Continue to alerts</a></div></section>
}
<section class="ts-card ts-card-flush" aria-labelledby="alert-rules-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="alert-rules-title">Alert rules for @Model.Project.Name</h2><p class="ts-card-description">Checked every minute over the last five complete minutes. A rule fires when the value is above its threshold and resolves when it is at or below it.</p></div></header><div class="ts-card-body">
@if (Model.Rules.Count == 0) { <div class="ts-empty" role="status"><p class="ts-empty-title">No alert rules yet.</p><p class="ts-empty-detail">@(Model.CanManage ? "Create a rule below." : "Organization owners create alert rules.")</p></div> }
else
{
<div class="ts-table-wrap"><table class="ts-table" id="alert-rules"><thead><tr><th scope="col">Rule</th><th scope="col">Condition</th><th scope="col">Database</th><th scope="col">Notify</th><th scope="col">State</th>@if (Model.CanManage) { <th scope="col">Actions</th> }</tr></thead><tbody>
@foreach (var rule in Model.Rules)
{
<tr><td class="ts-strong">@rule.Name</td><td>@AlertsPage.Metric(rule.Metric) &gt; @rule.Threshold.ToString(CultureInfo.InvariantCulture)<div class="ts-meta">Last value @(rule.Value?.ToString(CultureInfo.InvariantCulture) ?? "not measured")</div></td><td>@Model.Database(rule)</td><td>@(string.Join(", ", new[] { rule.Email ? "Email to owners" : "", rule.WebhookUrl is null ? "" : "Webhook" }.Where(item => item.Length > 0)) is { Length: > 0 } channels ? channels : "None")@if (rule.WebhookUrl is not null) { <div class="ts-meta ts-break">@rule.WebhookUrl</div> }</td>
<td><span class="ts-badge ts-badge-@(rule.State == "firing" ? "danger" : "success")" data-alert-state="@rule.State">@rule.State</span>@if (rule.Since is { } since) { <div class="ts-meta">since <time datetime="@since.ToString("O", CultureInfo.InvariantCulture)">@since.UtcDateTime.ToString("MMM d HH:mm 'UTC'", CultureInfo.InvariantCulture)</time></div> }</td>
@if (Model.CanManage) { <td class="ts-stack-sm"><form method="post" action="/api/v1/notifications/alerts/@rule.Id/threshold" class="ts-row"><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><label class="ts-sr-only" for="threshold-@rule.Id">Threshold for @rule.Name</label><input class="ts-input" id="threshold-@rule.Id" name="threshold" type="number" step="any" min="0" value="@rule.Threshold.ToString(CultureInfo.InvariantCulture)" required /><button class="ts-btn ts-btn-secondary ts-btn-sm" type="submit">Save</button></form><form method="post" action="/api/v1/notifications/alerts/@rule.Id/delete" data-submit-once><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><button class="ts-btn ts-btn-danger ts-btn-sm" type="submit">Delete</button></form></td> }</tr>
}
</tbody></table></div>
}
</div></section>
@if (Model.CanManage && Model.Rules.Count < 20)
{
<section class="ts-card" aria-labelledby="alert-create-title"><header class="ts-card-head"><div class="ts-card-heading"><h2 class="ts-card-title" id="alert-create-title">Create alert rule</h2><p class="ts-card-description">Up to 20 rules per project. Email goes to organization owners.</p></div></header><div class="ts-card-body">
<form method="post" action="/api/v1/notifications/alerts" class="ts-form" data-submit-once><input type="hidden" name="_csrf" value="@Model.Shell.CsrfToken" /><div class="ts-form-grid">
<div class="ts-field"><label class="ts-label" for="alert-name">Name</label><input class="ts-input" id="alert-name" name="name" maxlength="64" required /></div>
<div class="ts-field"><label class="ts-label" for="alert-metric">Metric</label><select class="ts-select" id="alert-metric" name="metric">@foreach (var metric in AlertRules.Metrics) { <option value="@metric">@AlertsPage.Metric(metric)</option> }</select></div>
<div class="ts-field"><label class="ts-label" for="alert-threshold">Threshold</label><input class="ts-input" id="alert-threshold" name="threshold" type="number" step="any" min="0" required /><p class="ts-hint">Fires when the value is above this number.</p></div>
<div class="ts-field"><label class="ts-label" for="alert-database">Database</label><select class="ts-select" id="alert-database" name="database"><option value="">Every database</option>@foreach (var database in Model.Project.Databases.Values.OrderBy(item => item.Name, StringComparer.Ordinal)) { <option value="@database.Id">@database.Name</option> }</select><p class="ts-hint">Operation units are measured for the whole organization.</p></div>
<div class="ts-field"><label class="ts-label" for="alert-webhook">Webhook URL (optional)</label><input class="ts-input" id="alert-webhook" name="webhook" type="url" maxlength="2048" placeholder="https://receiver.example/alerts" autocomplete="off" /><p class="ts-hint">Public HTTPS only. Failed deliveries retry each minute, up to 3 attempts.</p></div>
<label class="ts-check"><input type="checkbox" name="email" checked /> Email organization owners</label>
</div><div class="ts-form-actions"><button type="submit" class="ts-btn ts-btn-primary">Create rule</button></div></form>
</div></section>
}
</main>
@functions { public ShellModel LayoutModel => Model.Shell; }
