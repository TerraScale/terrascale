@inherits RazorSlice<NotificationsPageModel>
@{
    var shell = Model.Shell;
    string SeverityTone(string severity) => severity switch
    {
        "danger" => "danger",
        "warning" => "warning",
        _ => "info",
    };
}
@ShellHtml.Top(shell)
<div class="ts-page ts-notes-page">
    <section class="ts-panel ts-panel-20">
        <div class="ts-notifications-header">
            <p class="ts-muted ts-ui">Product notifications returned by the TerraScale API for the signed-in account.</p>
            <div class="ts-row">
                <form method="post" action="/api/v1/notifications/read-all">
                    <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit" disabled="@(Model.Unread == 0 ? "disabled" : null)">@Icons.CheckCheck(16) Mark all read</button>
                </form>
                <a class="ts-btn ts-btn-secondary" href="/notifications">@Icons.RefreshCw(16) Refresh</a>
            </div>
        </div>
        <div class="ts-notifications-stats">
            <div class="ts-stat-card">
                <span class="ts-text-upper">Unread</span>
                <div class="ts-stat-row">
                    <span class="ts-stat-value">@Model.Unread</span>
                    <span class="ts-badge @(Model.Unread > 0 ? "ts-badge-warning" : "ts-badge-success")">Unread</span>
                </div>
            </div>
            <div class="ts-stat-card">
                <span class="ts-text-upper">Critical</span>
                <div class="ts-stat-row">
                    <span class="ts-stat-value">@Model.Critical</span>
                    <span class="ts-badge @(Model.Critical > 0 ? "ts-badge-danger" : "ts-badge-success")">Critical</span>
                </div>
            </div>
            <div class="ts-stat-card">
                <span class="ts-text-upper">Total</span>
                <div class="ts-stat-row">
                    <span class="ts-stat-value">@Model.Total</span>
                    <span class="ts-badge ts-badge-info">Total</span>
                </div>
            </div>
        </div>
    </section>

    <section class="ts-panel">
        <div class="ts-panel-header ts-row-between">
            <div>
                <h2 class="ts-panel-title">Inbox</h2>
                <p class="ts-panel-subtitle">Loaded @DashboardStore.FormatUtcDateTime(Model.LoadedAt)</p>
            </div>
            <span class="ts-muted">@Icons.Bell(18)</span>
        </div>
        @if (Model.Notifications.Count is 0)
        {
            <div class="ts-padded">
                <div class="ts-empty">
                    <span class="ts-empty-icon">@Icons.SearchX(16)</span>
                    <span class="ts-empty-title">No notifications returned</span>
                    <span class="ts-empty-meta">The API did not return persistent notifications for this account.</span>
                </div>
            </div>
        }
        else
        {
            <div class="ts-stack-sm ts-padded">
                @foreach (var notification in Model.Notifications)
                {
                    var unread = notification.Status == "Unread";
                    <div class="ts-notification @(unread ? "ts-notification-unread" : null)">
                        <span class="ts-notification-icon">@(notification.Severity == "danger" ? Icons.TriangleAlert(17) : Icons.Bell(17))</span>
                        <div class="ts-notification-body">
                            <div class="ts-row ts-row-tight ts-flex-wrap">
                                <strong class="ts-notification-title">@notification.Title</strong>
                                <span class="ts-badge ts-badge-@SeverityTone(notification.Severity)">@notification.Severity</span>
                                @if (unread)
                                {
                                    <span class="ts-badge ts-badge-info">Unread</span>
                                }
                            </div>
                            @if (notification.Body.Length > 0)
                            {
                                <p class="ts-notification-text">@notification.Body</p>
                            }
                            <small class="ts-notification-meta">@Icons.Clock(13) @DashboardStore.FormatUtcDateTime(notification.CreatedAt)</small>
                        </div>
                        @if (unread)
                        {
                            <form method="post" action="/api/v1/notifications/@notification.Id/read">
                                <button class="ts-btn ts-notification-mark" type="submit">@Icons.CheckCheck(14) Mark read</button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
    </section>
</div>
@ShellHtml.Bottom(shell)
