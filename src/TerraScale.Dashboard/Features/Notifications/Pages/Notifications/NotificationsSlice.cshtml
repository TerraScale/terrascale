@inherits RazorSlice<NotificationsPageModel>
@{
    var shell = Model.Shell;
    string SeverityTone(string severity) => severity switch
    {
        "danger" => "danger",
        "warning" => "warning",
        "success" => "success",
        _ => "info",
    };
    string SeverityLabel(string severity) => severity switch
    {
        "danger" => "Critical",
        "warning" => "Warning",
        "success" => "Resolved",
        _ => "Update",
    };
}
@ShellHtml.Top(shell)
<div class="ts-page ts-notes-page">
    <section class="ts-panel ts-notifications-overview" aria-label="Notification summary">
        <div class="ts-notifications-header">
            <div>
                <span class="ts-notifications-eyebrow">YOUR ACTIVITY</span>
                <h2>Stay on top of what matters.</h2>
                <p>Updates about your account, databases, and team in one place.</p>
            </div>
            <div class="ts-notifications-actions">
                <form method="post" action="/api/v1/notifications/read-all">
                    <button class="ts-btn ts-btn-primary" type="submit" disabled="@(Model.Unread == 0 ? "disabled" : null)">@Icons.CheckCheck(16) Mark all read</button>
                </form>
                <a class="ts-btn ts-btn-secondary" href="/notifications">@Icons.RefreshCw(16) Refresh</a>
            </div>
        </div>
        <div class="ts-notifications-stats">
            <div class="ts-notifications-stat ts-notifications-stat-unread">
                <span>Unread</span>
                <strong>@Model.Unread</strong>
            </div>
            <div class="ts-notifications-stat ts-notifications-stat-critical">
                <span>Critical</span>
                <strong>@Model.Critical</strong>
            </div>
            <div class="ts-notifications-stat">
                <span>All notifications</span>
                <strong>@Model.Total</strong>
            </div>
        </div>
    </section>

    <section class="ts-panel ts-notifications-inbox" aria-labelledby="notifications-inbox-title">
        <div class="ts-notifications-inbox-header">
            <div>
                <h2 id="notifications-inbox-title">Inbox</h2>
                <p>@Model.Total @(Model.Total == 1 ? "notification" : "notifications")</p>
            </div>
            <span class="ts-notifications-count" aria-label="@Model.Unread unread notifications">@Model.Unread unread</span>
        </div>
        @if (Model.Notifications.Count is 0)
        {
            <div class="ts-notifications-empty">
                <span class="ts-notifications-empty-icon">@Icons.Bell(24)</span>
                <h3>You're all caught up</h3>
                <p>New notifications will appear here when there's something to review.</p>
            </div>
        }
        else
        {
            <div class="ts-notifications-list">
                @foreach (var notification in Model.Notifications)
                {
                    var unread = notification.Status == "Unread";
                    <article class="ts-notification @(unread ? "ts-notification-unread" : null)">
                        <span class="ts-notification-icon ts-notification-icon-@SeverityTone(notification.Severity)" aria-hidden="true">@(notification.Severity == "danger" || notification.Severity == "warning" ? Icons.TriangleAlert(18) : Icons.Bell(18))</span>
                        <div class="ts-notification-body">
                            <div class="ts-notification-heading">
                                <strong class="ts-notification-title">@notification.Title</strong>
                                @if (unread)
                                {
                                    <span class="ts-notification-unread-label">New</span>
                                }
                            </div>
                            @if (notification.Body.Length > 0)
                            {
                                <p class="ts-notification-text">@notification.Body</p>
                            }
                            <div class="ts-notification-details">
                                <span class="ts-badge ts-badge-@SeverityTone(notification.Severity)">@SeverityLabel(notification.Severity)</span>
                                <time class="ts-notification-meta" datetime="@notification.CreatedAt">@Icons.Clock(13) @DashboardStore.FormatUtcDateTime(notification.CreatedAt)</time>
                            </div>
                        </div>
                        @if (unread)
                        {
                            <form method="post" action="/api/v1/notifications/@notification.Id/read">
                                <button class="ts-btn ts-notification-mark" type="submit">@Icons.Check(15) Mark read</button>
                            </form>
                        }
                    </article>
                }
            </div>
        }
    </section>
</div>
@ShellHtml.Bottom(shell)
