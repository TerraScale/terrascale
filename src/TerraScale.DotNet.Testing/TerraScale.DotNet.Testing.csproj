<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Same targets as the SDK; see src/TerraScale.DotNet/TerraScale.DotNet.csproj. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(BundledNETCoreAppTargetFrameworkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0</TargetFrameworks>
    <TargetFramework />
    <PackageId>TerraScale.DotNet.Testing</PackageId>
    <Version>0.1.0</Version>
    <Description>Starts the pinned TerraBase release binary for integration tests of TerraScale services.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerraScale.DotNet.Tests" />
    <ProjectReference Include="../TerraScale.DotNet/TerraScale.DotNet.csproj" />
  </ItemGroup>
</Project>
