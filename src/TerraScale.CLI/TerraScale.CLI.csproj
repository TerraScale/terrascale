<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TerraScale.CLI</RootNamespace>
    <AssemblyName>terrascale</AssemblyName>
    <Version>0.0.1</Version>
    <!-- Release artifact: one native executable per platform (C# replacement of the Go ts-cli). -->
    <PublishAot>true</PublishAot>
    <!-- IDE0005 runs in the build and needs the XML documentation file; the root rule covers TerraBase only. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
