<Project>
  <!-- The vendored Turso .NET driver (UPSTREAM.md) in place of upstream's bindings/dotnet build files. Third-party code:
       the compiler's warnings are errors, but the repository's analyzer and style rules (root Directory.Build.props),
       which are for TerraScale's code, are not imported. -->
  <PropertyGroup>
    <Version>0.8.2</Version>
    <TursoTargetFrameworks>net11.0</TursoTargetFrameworks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <!-- As the root props: the same restore graph for build and publish, one set of lock files, locked in CI. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Outside the upstream directories, which the update script replaces. -->
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)locks/$(MSBuildProjectName).packages.lock.json</NuGetLockFilePath>
    <!-- NU1507/NU1801 as in the root props: NuGet.config maps every package to one source; offline restores still work. -->
    <NoWarn>$(NoWarn);NU1507;NU1801</NoWarn>
  </PropertyGroup>
</Project>
