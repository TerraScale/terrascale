From 103e8cd1998e131e4e2ab1ae0820c06b73f69f4b Mon Sep 17 00:00:00 2001
From: mariogk <mariogk@terrascale.tech>
Date: Fri, 23 Oct 2026 00:02:52 -0300
Subject: [PATCH] fix(turso): GUID conversion reads only the column's own
 declaration

GetValue checked every TEXT or BLOB value for a GUID declaration through
GetDeclaredTypeName, whose SQL-text fallback prepares PRAGMA table_info and
index_list for expression columns: about 20% of the CPU of a TerraBase point
read. An expression has no declared type (sqlite3_column_decltype), so the
native metadata alone decides, as in SQLite.
---
 src/Turso.Data.Sqlite/SqliteDataReader.cs | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/Turso.Data.Sqlite/SqliteDataReader.cs b/src/Turso.Data.Sqlite/SqliteDataReader.cs
index fd2ef70c6..07ca96ea6 100644
--- a/src/Turso.Data.Sqlite/SqliteDataReader.cs
+++ b/src/Turso.Data.Sqlite/SqliteDataReader.cs
@@ -664,7 +664,9 @@ public class SqliteDataReader : DbDataReader
         EnsureHasCurrentRow();
         var statement = GetStatement();
         var value = TursoBindings.GetValue(statement, ordinal);
-        if (value.ValueType is TursoValueType.Blob or TursoValueType.Text && IsGuidType(GetDeclaredTypeName(ordinal)))
+        // TerraScale: only a column's own declaration makes it a GUID, as sqlite3_column_decltype has none for an expression;
+        // the SQL-text fallback of GetDeclaredTypeName ran schema queries for every TEXT or BLOB expression value read.
+        if (value.ValueType is TursoValueType.Blob or TursoValueType.Text && IsGuidType(TursoBindings.GetDeclaredTypeName(statement, ordinal)))
             return ToGuid(value);
 
         return value.ValueType switch
-- 
2.54.0

