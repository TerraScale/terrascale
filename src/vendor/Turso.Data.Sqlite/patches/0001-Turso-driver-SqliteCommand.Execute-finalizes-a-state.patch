From 34ca7a73313bf13dc6ec86f98ecbe8bdaaf7bc83 Mon Sep 17 00:00:00 2001
From: mariogk <mariogk@terrascale.tech>
Date: Mon, 12 Oct 2026 09:56:46 -0300
Subject: [PATCH] Turso driver: SqliteCommand.Execute finalizes a statement
 that fails

A statement without result columns (a write, BEGIN, COMMIT, ROLLBACK, a
savepoint) that failed while it stepped was never disposed: the garbage
collector's finalizer thread finalized it later, a second user of the
connection, which Turso refuses with "concurrent use forbidden" when it
meets the owner stepping another statement. The statement is now
disposed before the error propagates.

Test: FailedStatementTests.AFailedWriteLeavesNothingForTheFinalizer.
---
 src/Turso.Data.Sqlite/SqliteCommand.cs | 27 ++++++++++++++++++--------
 1 file changed, 19 insertions(+), 8 deletions(-)

diff --git a/src/Turso.Data.Sqlite/SqliteCommand.cs b/src/Turso.Data.Sqlite/SqliteCommand.cs
index 445339c3..4cfe70f0 100644
--- a/src/Turso.Data.Sqlite/SqliteCommand.cs
+++ b/src/Turso.Data.Sqlite/SqliteCommand.cs
@@ -301,19 +301,30 @@ public class SqliteCommand : DbCommand
                     continue;
 
                 var statement = PrepareSingleStatement(sql);
-                if (TursoBindings.GetFieldCount(statement) > 0)
+                try
                 {
-                    _hasOpenReader = true;
-                    Connection?.ReaderOpened();
-                    return new SqliteDataReader(this, statement, statements[i], statements.Skip(i + 1).ToList(), recordsAffected, behavior, CloseReader);
-                }
+                    if (TursoBindings.GetFieldCount(statement) > 0)
+                    {
+                        _hasOpenReader = true;
+                        Connection?.ReaderOpened();
+                        return new SqliteDataReader(this, statement, statements[i], statements.Skip(i + 1).ToList(), recordsAffected, behavior, CloseReader);
+                    }
 
-                while (TursoBindings.Read(statement))
+                    while (TursoBindings.Read(statement))
+                    {
+                    }
+
+                    if (CountsRowsAffected(statements[i]))
+                        recordsAffected += TursoBindings.RowsAffected(statement);
+                }
+                catch
                 {
+                    // TerraScale: finalize a failed statement here, not on the finalizer thread, which would use the
+                    // connection while its owner does ("concurrent use forbidden").
+                    statement.Dispose();
+                    throw;
                 }
 
-                if (CountsRowsAffected(statements[i]))
-                    recordsAffected += TursoBindings.RowsAffected(statement);
                 statement.Dispose();
             }
         }
