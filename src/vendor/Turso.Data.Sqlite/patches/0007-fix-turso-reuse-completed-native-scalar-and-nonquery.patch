From 83551c0d780ed5069c366a6c26151dd5ec9e570d Mon Sep 17 00:00:00 2001
From: mariogk <mariogk@terrascale.tech>
Date: Thu, 22 Oct 2026 10:05:30 -0300
Subject: [PATCH] fix(turso): reuse completed native scalar and nonquery
 statements

---
 src/Turso.Data.Sqlite/SqliteCommand.cs    | 85 ++++++++++++++++++++---
 src/Turso.Data.Sqlite/SqliteDataReader.cs | 10 ++-
 2 files changed, 84 insertions(+), 11 deletions(-)

diff --git a/src/Turso.Data.Sqlite/SqliteCommand.cs b/src/Turso.Data.Sqlite/SqliteCommand.cs
index f8afb1e4..b7c57b28 100644
--- a/src/Turso.Data.Sqlite/SqliteCommand.cs
+++ b/src/Turso.Data.Sqlite/SqliteCommand.cs
@@ -16,2 +16,5 @@ public class SqliteCommand : DbCommand
     private TursoStatementHandle? _statement;
+    private TursoDatabaseHandle? _statementDatabase;
+    private string? _statementSql;
+    private bool _disposed;
     private string _commandText = string.Empty;
@@ -61,2 +64,4 @@ public class SqliteCommand : DbCommand
             ThrowIfReaderOpen(nameof(CommandText));
+            if (_commandText != (value ?? string.Empty))
+                ClearStatement();
             _commandText = value ?? string.Empty;
@@ -95,2 +100,4 @@ public class SqliteCommand : DbCommand
             ThrowIfReaderOpen(nameof(Connection));
+            if (!ReferenceEquals(_connection, value))
+                ClearStatement();
             _connection = value;
@@ -169,4 +176,3 @@ public class SqliteCommand : DbCommand
         {
-            _statement?.Dispose();
-            _statement = null;
+            ClearStatement();
             return;
@@ -177,5 +183,4 @@ public class SqliteCommand : DbCommand
         {
-            preparedStatement = PrepareSingleStatement(statements[0]);
-            _statement?.Dispose();
-            _statement = preparedStatement;
+            preparedStatement = TakeStatement(statements[0]);
+            ReturnStatement(preparedStatement);
             preparedStatement = null;
@@ -261,4 +266,5 @@ public class SqliteCommand : DbCommand
         {
+            _disposed = true;
             _activeManagedCommand?.Dispose();
-            _statement?.Dispose();
+            ClearStatement();
         }
@@ -295,2 +301,6 @@ public class SqliteCommand : DbCommand
         var statements = SplitStatements(CommandText);
+        // Public readers keep fresh preparation and lazy execution, including schema metadata and RETURNING.
+        var reusable = statements.Count == 1 && method is "ExecuteScalar" or "ExecuteNonQuery";
+        if (!reusable)
+            ClearStatement();
         try
@@ -302,3 +312,3 @@ public class SqliteCommand : DbCommand
 
-                var statement = PrepareSingleStatement(sql);
+                var statement = reusable ? TakeStatement(sql) : PrepareSingleStatement(sql);
                 try
@@ -309,3 +319,3 @@ public class SqliteCommand : DbCommand
                         Connection?.ReaderOpened();
-                        return new SqliteDataReader(this, statement, statements[i], statements.Skip(i + 1).ToList(), recordsAffected, behavior, CloseReader);
+                        return new SqliteDataReader(this, statement, statements[i], statements.Skip(i + 1).ToList(), recordsAffected, behavior, CloseReader, reusable);
                     }
@@ -327,3 +337,6 @@ public class SqliteCommand : DbCommand
 
-                statement.Dispose();
+                if (reusable)
+                    ReturnStatement(statement);
+                else
+                    statement.Dispose();
             }
@@ -630,2 +643,56 @@ public class SqliteCommand : DbCommand
 
+    private void ClearStatement()
+    {
+        _statement?.Dispose();
+        _statement = null;
+    }
+
+    private TursoStatementHandle TakeStatement(string sql)
+    {
+        var database = Connection!.DatabaseHandle;
+        var rewritten = RewriteFacadeStatement(sql, Connection);
+        var statement = _statement;
+        _statement = null;
+        var reused = statement is { IsClosed: false, IsInvalid: false }
+            && ReferenceEquals(_statementDatabase, database) && _statementSql == rewritten;
+        if (!reused)
+        {
+            statement?.Dispose();
+            (_statementDatabase, _statementSql) = (database, rewritten);
+            return PrepareSingleStatement(sql);
+        }
+
+        try
+        {
+            BindParameters(statement!);
+            return statement!;
+        }
+        catch
+        {
+            statement!.Dispose();
+            throw;
+        }
+    }
+
+    internal void ReturnStatement(TursoStatementHandle statement)
+    {
+        try
+        {
+            if (_disposed || _statementDatabase is not { IsClosed: false, IsInvalid: false })
+            {
+                statement.Dispose();
+                return;
+            }
+
+            // Native v0.8.2 reset clears bindings too, so idle commands retain no parameter payloads.
+            TursoBindings.ResetStatement(statement);
+            _statement = statement;
+        }
+        catch
+        {
+            statement.Dispose();
+            throw;
+        }
+    }
+
     internal TursoStatementHandle PrepareSingleStatement(string sql)
diff --git a/src/Turso.Data.Sqlite/SqliteDataReader.cs b/src/Turso.Data.Sqlite/SqliteDataReader.cs
index fd2ef70c..b1a9a3eb 100644
--- a/src/Turso.Data.Sqlite/SqliteDataReader.cs
+++ b/src/Turso.Data.Sqlite/SqliteDataReader.cs
@@ -28,2 +28,3 @@ public class SqliteDataReader : DbDataReader
     private bool _hasPrefetchedRow;
+    private bool _reusable;
     private bool _hadResultSet;
@@ -33,3 +34,3 @@ public class SqliteDataReader : DbDataReader
 
-    internal SqliteDataReader(SqliteCommand command, TursoStatementHandle statement, string currentSql, List<string> remainingSql, int recordsAffected, CommandBehavior behavior, Action closeCallback)
+    internal SqliteDataReader(SqliteCommand command, TursoStatementHandle statement, string currentSql, List<string> remainingSql, int recordsAffected, CommandBehavior behavior, Action closeCallback, bool reusable = false)
     {
@@ -37,2 +38,3 @@ public class SqliteDataReader : DbDataReader
         _statement = statement;
+        _reusable = reusable;
         _currentSql = currentSql;
@@ -831,2 +833,3 @@ public class SqliteDataReader : DbDataReader
         {
+            _reusable = false;
             _command.Connection?.CheckTransactionAfterFailure();
@@ -922,3 +925,6 @@ public class SqliteDataReader : DbDataReader
 
-                _statement.Dispose();
+                if (_reusable)
+                    _command.ReturnStatement(_statement);
+                else
+                    _statement.Dispose();
                 _statement = null;
-- 
2.54.0

