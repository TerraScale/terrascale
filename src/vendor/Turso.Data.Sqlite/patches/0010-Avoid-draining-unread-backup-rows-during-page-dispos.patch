From 4091dbda59e714d4fcb0895d2c85bd3ef9be8669 Mon Sep 17 00:00:00 2001
From: mariogk <mariogk@terrascale.tech>
Date: Fri, 23 Oct 2026 17:14:08 -0300
Subject: [PATCH] Avoid draining unread backup rows during page disposal

---
 src/Turso.Data/TursoDataReader.cs | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/src/Turso.Data/TursoDataReader.cs b/src/Turso.Data/TursoDataReader.cs
index caf273e75..1e56f8ebd 100644
--- a/src/Turso.Data/TursoDataReader.cs
+++ b/src/Turso.Data/TursoDataReader.cs
@@ -268,6 +268,27 @@ public class TursoDataReader : DbDataReader
         base.Dispose(disposing);
     }
 
+    /// <summary>
+    /// Closes the reader without stepping its unread rows: Dispose finalizes, and native finalize steps a running
+    /// statement to its end. Reset aborts it instead, so call this only for a statement whose unread rows have no effect
+    /// (a read-only SELECT); a write's open transaction follows native reset rules.
+    /// </summary>
+    public void Abort()
+    {
+        if (_isClosed)
+            return;
+
+        try
+        {
+            if (!_statement.IsInvalid)
+                TursoBindings.ResetStatement(_statement);
+        }
+        finally
+        {
+            Dispose();
+        }
+    }
+
     public override bool Read()
     {
         EnsureOpen();
-- 
