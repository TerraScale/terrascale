<Project>
  <PropertyGroup>
    <!-- Upstream packs Turso.Raw as Turso.Data.Native: a project of that id could not reference the package below. -->
    <PackageId>$(MSBuildProjectName)</PackageId>
  </PropertyGroup>

  <!-- The driver's regression tests reach the hooks TerraScale's patches add (tests/Turso.Data.Sqlite.Tests). -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Turso.Data.Sqlite'">
    <InternalsVisibleTo Include="Turso.Data.Sqlite.Tests" />
  </ItemGroup>

  <Import Project="../../../Turso.Native.targets" />

  <!-- Linux uses TerraScale's pinned patched core; other platforms retain upstream native assets. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Turso.Raw'">
    <PackageReference Include="Turso.Data.Native">
      <ExcludeAssets Condition="'$(_TerraScaleTursoRid)' == 'linux-x64' or '$(_TerraScaleTursoRid)' == 'linux-arm64'">runtime;native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
