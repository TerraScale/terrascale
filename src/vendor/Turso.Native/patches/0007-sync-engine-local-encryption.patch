+
+#[derive(Clone)]
+pub struct LocalEncryption(pub turso_core::EncryptionOpts);
+
+impl std::fmt::Debug for LocalEncryption {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("LocalEncryption")
+            .field("cipher", &self.0.cipher)
+            .finish_non_exhaustive()
+    }
+}
+
+impl LocalEncryption {
+    pub fn key(&self) -> Result<turso_core::EncryptionKey> {
+        Ok(turso_core::EncryptionKey::from_hex_string(&self.0.hexkey)?)
+    }
+    pub fn codec(&self) -> Result<turso_core::EncryptionContext> {
+        let cipher = turso_core::CipherMode::try_from(self.0.cipher.as_str())?;
+        Ok(turso_core::EncryptionContext::new(
+            cipher,
+            &self.key()?,
+            PAGE_SIZE,
+        )?)
+    }
+}
+
+fn local_encryption_key(opts: &DatabaseSyncEngineOpts) -> Result<Option<turso_core::EncryptionKey>> {
+    opts.local_encryption.as_ref().map(LocalEncryption::key).transpose()
+}
+
+fn local_codec(opts: &DatabaseSyncEngineOpts) -> Result<Option<turso_core::EncryptionContext>> {
+    opts.local_encryption.as_ref().map(LocalEncryption::codec).transpose()
 }
 
