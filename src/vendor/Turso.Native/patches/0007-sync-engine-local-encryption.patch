     pub remote_encryption_key: Option<String>,
+    pub local_codec: Option<turso_core::EncryptionContext>,
+}
+
+const LOCAL_CODEC_PROTOCOL_ERROR: &str =
+    "local encryption supports only V1 page streams without partial sync";
+
+fn ensure_no_local_codec(local_codec: Option<&turso_core::EncryptionContext>) -> Result<()> {
+    if local_codec.is_some() {
+        return Err(Error::DatabaseSyncEngineError(
+            LOCAL_CODEC_PROTOCOL_ERROR.to_string(),
+        ));
+    }
+    Ok(())
+}
+
+pub fn seal_page(
+    local_codec: Option<&turso_core::EncryptionContext>,
+    page_no: u32,
+    page: &mut [u8],
+) -> Result<()> {
+    let Some(codec) = local_codec else {
+        return Ok(());
+    };
+    let reserved = codec.required_reserved_bytes() as usize;
+    if page.len() != PAGE_SIZE || page[PAGE_SIZE - reserved..].iter().any(|&b| b != 0) {
+        return Err(Error::DatabaseSyncEngineError(format!(
+            "page {page_no} has no free reserved space for local encryption"
+        )));
+    }
+    if page_no == 1 && !page.starts_with(b"SQLite format 3\0") {
+        return Err(Error::DatabaseSyncEngineError(
+            "page 1 has no SQLite header for local encryption".to_string(),
+        ));
+    }
+    let sealed = codec.encrypt_page(page, page_no as usize)?;
+    page.copy_from_slice(&sealed);
+    Ok(())
+}
+
+pub fn open_page(
+    local_codec: Option<&turso_core::EncryptionContext>,
+    page_no: u32,
+    page: &mut [u8],
+) -> Result<()> {
+    let Some(codec) = local_codec else {
+        return Ok(());
+    };
+    if page.len() != PAGE_SIZE {
+        return Err(Error::DatabaseSyncEngineError(format!(
+            "page {page_no} has unexpected size: {} != {PAGE_SIZE}",
+            page.len()
+        )));
+    }
+    let opened = codec.decrypt_page(page, page_no as usize)?;
+    page.copy_from_slice(&opened);
+    Ok(())
 }
 
