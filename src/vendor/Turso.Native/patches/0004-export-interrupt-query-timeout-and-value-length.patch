 }
 
+#[no_mangle]
+pub extern "C" fn turso_connection_interrupt(
+    connection: *const c::turso_connection_t,
+    error_opt_out: *mut *const std::ffi::c_char,
+) -> c::turso_status_code_t {
+    let connection = match unsafe { TursoConnection::ref_from_capi(connection) } {
+        Ok(connection) => connection,
+        Err(err) => return unsafe { err.to_capi(error_opt_out) },
+    };
+    connection.interrupt();
+    c::turso_status_code_t::TURSO_OK
+}
+
+#[no_mangle]
+pub extern "C" fn turso_connection_set_query_timeout_ms(
+    connection: *const c::turso_connection_t,
+    timeout_ms: u64,
+    error_opt_out: *mut *const std::ffi::c_char,
+) -> c::turso_status_code_t {
+    let connection = match unsafe { TursoConnection::ref_from_capi(connection) } {
+        Ok(connection) => connection,
+        Err(err) => return unsafe { err.to_capi(error_opt_out) },
+    };
+    connection.set_query_timeout(std::time::Duration::from_millis(timeout_ms));
+    c::turso_status_code_t::TURSO_OK
+}
+
+#[no_mangle]
+pub extern "C" fn turso_connection_set_max_value_length(
+    connection: *const c::turso_connection_t,
+    length: i64,
+    error_opt_out: *mut *const std::ffi::c_char,
+) -> c::turso_status_code_t {
+    let connection = match unsafe { TursoConnection::ref_from_capi(connection) } {
+        Ok(connection) => connection,
+        Err(err) => return unsafe { err.to_capi(error_opt_out) },
+    };
+    connection.set_max_value_length(length);
+    c::turso_status_code_t::TURSO_OK
+}
