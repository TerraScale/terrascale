+fn requested_blob_length(value: &Value) -> i64 {
+    match value {
+        Value::Numeric(Numeric::Integer(i)) => *i,
+        Value::Numeric(Numeric::Float(f)) => f64::from(*f) as i64,
+        Value::Text(t) => t.as_str().parse().unwrap_or(0),
+        _ => 0,
+    }
+}
+
+fn value_byte_length(value: &Value) -> i64 {
+    match value {
+        Value::Text(t) => t.as_str().len() as i64,
+        Value::Blob(b) => b.len() as i64,
+        _ => 0,
+    }
+}
