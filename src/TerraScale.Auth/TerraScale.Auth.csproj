<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>TerraScale.Auth</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!-- ponytail: sibling-checkout source reference; swap to a published nupkg feed when TerraScale.DotNet ships one -->
    <TerraScaleSdkProject Condition="'$(TerraScaleSdkProject)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\ts-dotnet\src\TerraScale.DotNet\TerraScale.DotNet.csproj')">$(MSBuildThisFileDirectory)..\..\..\ts-dotnet\src\TerraScale.DotNet\TerraScale.DotNet.csproj</TerraScaleSdkProject>
    <!-- Worktree layout: .claude/worktrees/&lt;wt&gt;/src/... needs six levels up. -->
    <TerraScaleSdkProject Condition="'$(TerraScaleSdkProject)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\..\..\..\ts-dotnet\src\TerraScale.DotNet\TerraScale.DotNet.csproj')">$(MSBuildThisFileDirectory)..\..\..\..\..\..\ts-dotnet\src\TerraScale.DotNet\TerraScale.DotNet.csproj</TerraScaleSdkProject>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>terrascale/ts-auth</ContainerRepository>
    <ContainerPort>8080</ContainerPort>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\ts-libs\src\TerraScale.Endpoints\TerraScale.Endpoints.csproj')">
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\ts-libs\src\TerraScale.Endpoints\TerraScale.Endpoints.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)..\..\..\ts-libs\src\TerraScale.Endpoints\TerraScale.Endpoints.csproj')">
    <PackageReference Include="TerraScale.Endpoints" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The admin page uses the same server-rendered slice pattern as ts-dashboard. -->
    <PackageReference Include="RazorSlices" Version="0.11.3" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(TerraScaleSdkProject)')">
    <ProjectReference Include="$(TerraScaleSdkProject)" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot/**" />
    <EmbeddedResource Include="wwwroot/admin/admin.css" LogicalName="TerraScale.Auth.Admin.Assets.admin.css" />
    <EmbeddedResource Include="wwwroot/admin/datastar.js" LogicalName="TerraScale.Auth.Admin.Assets.datastar.js" />
    <EmbeddedResource Include="wwwroot/admin/logo.svg" LogicalName="TerraScale.Auth.Admin.Assets.logo.svg" />
    <EmbeddedResource Include="wwwroot/fonts/oxanium-latin-wght-normal.woff2" LogicalName="TerraScale.Auth.Admin.Assets.oxanium.woff2" />
    <EmbeddedResource Include="wwwroot/fonts/jetbrains-mono-latin-wght-normal.woff2" LogicalName="TerraScale.Auth.Admin.Assets.jetbrains-mono.woff2" />
  </ItemGroup>

  <Target Name="EnsureTerraScaleSdk" BeforeTargets="BeforeBuild" Condition="!Exists('$(TerraScaleSdkProject)')">
    <Error Text="TerraScale.DotNet SDK project not found at '$(TerraScaleSdkProject)'. Clone ts-dotnet as a sibling of ts-auth, or pass -p:TerraScaleSdkProject=&lt;path&gt;." />
  </Target>

</Project>
