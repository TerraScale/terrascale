@inherits RazorSlice<ResetPasswordPageModel>
@{
    var token = HttpContext?.Request?.Query["token"].FirstOrDefault() ?? "";
    var title = Model.Reset ? "Set a new password" : "Reset password";
    var subtitle = Model.Reset
        ? "Choose a new password for your TerraScale account."
        : "We will send password reset instructions to your email.";
    var action = Model.Reset ? "Set new password" : "Reset password";
}
@FlowHtml.Document("Reset password")
<main class="ts-auth">
    <div class="ts-auth-card">
        <div class="ts-auth-brand">
            <img src="/brand/logo-terrascale-auth.svg" alt="TerraScale" decoding="async" />
        </div>
        <div>
            <h1 class="ts-auth-title">@title</h1>
            <p class="ts-auth-subtitle">@subtitle</p>
        </div>
        @if (Model.Sent)
        {
            <div class="ts-alert ts-alert-success" role="status">
                <span class="ts-alert-title">@Icons.CircleCheckBig(16) Check your email</span>
                <span class="ts-alert-body">If an account exists for that address, reset instructions are on the way.</span>
            </div>
        }
        @if (Model.Error is { } error)
        {
            <div class="ts-alert ts-alert-danger" role="alert">
                <span class="ts-alert-title">@Icons.CircleAlert(16) @error</span>
            </div>
        }
        <form class="ts-form" method="post" action="/reset-password">
            @if (Model.Reset)
            {
                <input type="hidden" name="token" value="@token" />
                <div class="ts-field">
                    <label class="ts-label" for="newPassword">New password</label>
                    <input class="ts-input" type="password" id="newPassword" name="newPassword" autocomplete="new-password" required minlength="8" placeholder="••••••••" />
                    <span class="ts-hint">At least 8 characters.</span>
                </div>
                <div class="ts-field">
                    <label class="ts-label" for="confirmPassword">Confirm new password</label>
                    <input class="ts-input" type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required minlength="8" placeholder="••••••••" />
                </div>
            }
            else
            {
                <div class="ts-field">
                    <label class="ts-label" for="email">Email</label>
                    <input class="ts-input" type="email" id="email" name="email" autocomplete="email" required placeholder="you@company.com" />
                </div>
            }
            <button class="ts-btn ts-btn-primary ts-btn-lg" type="submit">@action</button>
        </form>
        <p class="ts-auth-footer"><a class="ts-link" href="/login">Back to sign in</a></p>
    </div>
    <nav class="ts-auth-footer-links" aria-label="Footer">
        <a href="/docs">Support</a>
        <a href="/legal/privacy">Privacy</a>
        <a href="/legal/terms">Terms</a>
    </nav>
</main>
@FlowHtml.End()
