@inherits RazorSlice<TerraScale.Dashboard.Features.Auth.AuthPage>
@implements IUsesLayout<TerraScale.Dashboard.UI.Slices.Document, DocumentModel>
@inject AssetUrls Assets
<main class="ts-login">
    <section class="ts-login-hero" aria-hidden="true">
        @(await RenderPartialAsync<TerraScale.Dashboard.UI.Slices.RegionMap>())
        <ul class="ts-login-regions"><li><span class="ts-dot"></span>San Francisco</li><li><span class="ts-dot"></span>São Paulo</li></ul>
    </section>
    <div class="ts-login-column">
        <div class="ts-login-panel">
            <div class="ts-login-stack">
                <div class="ts-login-heading">
                    <img class="ts-login-logo" src="@Assets.Url("brand/logo-terrascale-blue.svg")" alt="TerraScale" decoding="async" />
                    <div class="ts-auth-heading"><h1 class="ts-auth-title" id="login-title">@Model.Title</h1><p class="ts-auth-subtitle">@Model.Subtitle</p></div>
                </div>
                @if (Model.Error.Length != 0) { <div class="ts-alert ts-alert-danger" role="alert">@Model.Error</div> }
                @if (Model.Notice.Length != 0) { <div class="ts-alert ts-alert-success" role="status">@Model.Notice</div> }
                <form class="ts-form" method="post" action="@Model.Action" data-submit-once novalidate>
                    <input type="hidden" name="_csrf" value="@Model.CsrfToken" />
                    <input type="hidden" name="redirectTo" value="@Model.ReturnTo" />
                    @if (Model.Mode is "code-verify" or "reset-complete")
                    {
                        <input type="hidden" name="email" value="@Model.Email" />
                        <div class="ts-field"><label class="ts-label" for="code">Code</label><input class="ts-input ts-input-lg" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="64" required /></div>
                    }
                    else
                    {
                        <div class="ts-field">
                            <label class="ts-label" for="email">Email</label>
                            <input class="ts-input ts-input-lg" type="email" id="email" name="email" value="@Model.Email" autocomplete="email" placeholder="name@@company.com" required aria-invalid="@(Model.EmailError.Length != 0 ? "true" : null)" aria-describedby="@(Model.EmailError.Length != 0 ? "email-error" : null)" />
                            @if (Model.EmailError.Length != 0) { <p class="ts-field-error" id="email-error">@Model.EmailError</p> }
                        </div>
                    }
                    @if (Model.Mode is "login" or "reset-complete")
                    {
                        <div class="ts-field">
                            <div class="ts-row-between"><label class="ts-label" for="password">@(Model.Mode == "login" ? "Password" : "New password")</label>@if (Model.Mode == "login") { <a class="ts-link ts-meta" href="/reset-password">Forgot password</a> }</div>
                            @(await RenderPartialAsync<TerraScale.Dashboard.UI.Slices.PasswordInput, TerraScale.Dashboard.UI.PasswordField>(new("password", Model.Mode == "login" ? "current-password" : "new-password", Model.PasswordError)))
                            @if (Model.PasswordError.Length != 0) { <p class="ts-field-error" id="password-error">@Model.PasswordError</p> }
                        </div>
                    }
                    @if (Model.Mode == "reset-complete")
                    {
                        <div class="ts-field"><label class="ts-label" for="confirmPassword">Confirm new password</label>@(await RenderPartialAsync<TerraScale.Dashboard.UI.Slices.PasswordInput, TerraScale.Dashboard.UI.PasswordField>(new("confirmPassword", "new-password")))</div>
                    }
                    <button class="ts-btn ts-btn-primary ts-btn-lg ts-btn-block" type="submit">@(Model.Mode switch { "login" => "Sign in", "code-verify" => "Continue", "reset-complete" => "Change password", _ => "Email me a code" })</button>
                </form>
                @if (Model.Mode == "login")
                {
                    <div class="ts-auth-divider" aria-hidden="true">Other sign-in options</div>
                    <div class="ts-auth-providers ts-auth-providers-stack">
                        <a class="ts-btn ts-btn-secondary" href="/login/code?redirectTo=@Uri.EscapeDataString(Model.ReturnTo)">Email me a code</a>
                        <a class="ts-btn ts-btn-secondary" href="/login/sso?redirectTo=@Uri.EscapeDataString(Model.ReturnTo)">Single sign-on</a>
                    </div>
                }
            </div>
            @if (Model.Mode == "login") { <p class="ts-auth-footer">New to TerraScale? <a class="ts-link" href="/onboarding?redirectTo=@Uri.EscapeDataString(Model.ReturnTo)">Create account</a></p> }
            else { <p class="ts-auth-footer"><a class="ts-link" href="/login?redirectTo=@Uri.EscapeDataString(Model.ReturnTo)">← Back to sign in</a></p> }
        </div>
        <footer class="ts-login-footer"><div class="ts-auth-locale"><label class="ts-sr-only" for="auth-locale">Language</label><select id="auth-locale" class="ts-select ts-input-sm" aria-label="Language"><option value="en" selected>English</option><option value="pt-BR">Português</option></select></div></footer>
    </div>
</main>
@functions {
    public DocumentModel LayoutModel => Model.Document;
}
