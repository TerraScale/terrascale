@inherits RazorSlice<AdminDatabasesPageModel>
@{ var shell = Model.Shell; }
@ShellHtml.Top(shell)
<div class="ts-page ts-admin-root">
    <div>
        <h2 class="ts-admin-title">Databases</h2>
        <p class="ts-admin-subtitle">Owner-only database inventory.</p>
    </div>
    <section class="ts-admin-summary" aria-label="Database summary">
        @(AdminPresentation.Stat("Databases", Model.Rows.Count.ToString()))
        @(AdminPresentation.Stat("Regions", Model.RegionCount.ToString()))
    </section>
    @(AdminPresentation.Filter("/admin/databases", "Databases", Model.Query))
    @(AdminPresentation.TableStart("Databases"))
    @if (Model.Rows.Count == 0)
    {
        @(AdminPresentation.TableEmpty("Databases"))
    }
    else
    {
        <div class="ts-table-wrap">
            <table class="ts-table">
                <thead>
                    <tr>
                        <th>Database</th>
                        <th>Regions</th>
                        <th>Version</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>
                                <div class="ts-admin-database-name">
                                    @Icons.Database(16)
                                    <div>
                                        <div class="ts-admin-cell-name">@row.Name</div>
                                        <div class="ts-admin-cell-id">@row.DatabaseId</div>
                                    </div>
                                </div>
                            </td>
                            <td>@(string.Join(", ", row.Regions).Length > 0 ? string.Join(", ", row.Regions) : "-")</td>
                            <td><span class="ts-badge ts-badge-info">v@row.Version</span></td>
                            <td>@AdminPresentation.Timestamp(row.CreatedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @(AdminPresentation.TableEnd)
</div>
@ShellHtml.Bottom(shell)
