@inherits RazorSlice<AdminUsagePageModel>
@{ var shell = Model.Shell; }
@ShellHtml.Top(shell)
<div class="ts-page ts-admin-root">
    <div>
        <h2 class="ts-admin-title">Usage</h2>
        <p class="ts-admin-subtitle">Owner-only platform usage summary.</p>
    </div>
    <section class="ts-admin-summary-three" aria-label="Platform summary">
        @(AdminPresentation.Stat("Organizations", Model.Overview.Organizations.ToString()))
        @(AdminPresentation.Stat("Projects", Model.Overview.Projects.ToString()))
        @(AdminPresentation.Stat("Databases", Model.Overview.Databases.ToString()))
    </section>
    @(AdminPresentation.TableStart("Usage"))
    @if (Model.Overview.Usage.Length == 0)
    {
        @(AdminPresentation.TableEmpty("Usage"))
    }
    else
    {
        <div class="ts-table-wrap">
            <table class="ts-table">
                <thead>
                    <tr>
                        <th>Metric</th>
                        <th>Value</th>
                        <th>Unit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Overview.Usage)
                    {
                        <tr>
                            <td>@row.Name</td>
                            <td class="ts-table-num">@row.Quantity.ToString("N0")</td>
                            <td>@(row.Unit ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @(AdminPresentation.TableEnd)
</div>
@ShellHtml.Bottom(shell)
