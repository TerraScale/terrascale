<?xml version="1.0" encoding="utf-8"?>
<!-- Hermetic sources: external packages come from nuget.org only. Sibling
     TerraScale libraries are project references pinned by CI. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
