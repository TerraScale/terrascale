<?xml version="1.0" encoding="utf-8"?>
<!-- Hermetic sources: external deps come from nuget.org only. Without this the
     user/runner-level config also lists the private terrascale feed, which with
     central package management raises NU1507 (error under TreatWarningsAsErrors). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
