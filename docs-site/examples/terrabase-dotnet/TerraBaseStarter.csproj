<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TerraScale.DotNet" Version="$(TerraBaseSdkPackageVersion)" />
  </ItemGroup>
  <Target Name="RequireExactPackage" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(TerraBaseSdkPackageVersion)' == ''" Text="Pass -p:TerraBaseSdkPackageVersion=0.0.12 and a local feed built from ts-dotnet; see https://docs.terrascale.tech/getting-started/csharp." />
  </Target>
</Project>
