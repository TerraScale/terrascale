<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <IsPackable>false</IsPackable>
    <!-- The repository defaults to net11.0; fall back to the newest bundled
         runtime so the suite still builds and runs under a .NET 10 SDK. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(BundledNETCoreAppTargetFrameworkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0</TargetFrameworks>
    <TargetFramework />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.72.10" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TerraScale.DotNet\TerraScale.DotNet.csproj" />
    <None Include="../../contracts/auth/**/*" Link="contracts/auth/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../contracts/terrabase/**/*" Link="contracts/terrabase/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
