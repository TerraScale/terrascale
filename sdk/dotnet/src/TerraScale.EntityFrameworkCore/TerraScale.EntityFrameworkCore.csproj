<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(BundledNETCoreAppTargetFrameworkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0</TargetFrameworks>
    <TargetFramework />
    <PackageId>TerraScale.EntityFrameworkCore</PackageId>
    <Version>0.0.1</Version>
    <Description>Entity Framework Core provider for TerraBase.</Description>
    <PackageProjectUrl>https://github.com/TerraScale/terrascale/tree/main/sdk/dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TerraScale/terrascale</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>terrascale;terrabase;database;sql;efcore;entityframeworkcore</PackageTags>
    <Deterministic>true</Deterministic>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../docs/entity-framework-core.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <ProjectReference Include="../TerraScale.DotNet/TerraScale.DotNet.csproj" />
  </ItemGroup>
</Project>
