<Project Sdk="Microsoft.NET.Sdk">

  <!-- TerraBase.Protocol — the TerraBase Engine Protocol (TBEP) C# client -->
  <!-- library (ticket SE-14, charter PD-2026-08-26-02 D4): the single      -->
  <!-- interop artifact every C# consumer (API host SE-08, CLI SE-13 direct -->
  <!-- mode) uses to speak TBEP to the Rust engine process over the        -->
  <!-- required UDS binding (PD-2026-08-26-11 D1; the QUIC binding is      -->
  <!-- deferred until a networked-engine need is recorded).                 -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
    <LangVersion>preview</LangVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- The mandated codec pair (PD-2026-08-26-02 D4): Rust rmp-serde on
         the engine side against MessagePack-CSharp here, contractful and
         positional; contractless/typeless modes are never enabled. -->
    <PackageReference Include="MessagePack" Version="3.1.8" />
  </ItemGroup>

</Project>
