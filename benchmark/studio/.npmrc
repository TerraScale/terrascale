# Force devDependencies to install even when the surrounding environment
# exports NODE_ENV=production (inherited from container images). npm treats
# that as --omit=dev, which drops vite-plus/vinext/@voidzero-dev from
# node_modules and makes `vp run vinext:build` fail with
# "Failed to locate local Vite+ CLI". Mirrors TerraScale.Dashboard.Next.
include=dev
