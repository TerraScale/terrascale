# Build output
bin/
!terra-rust/src/bin/
obj/
target/
TestResults/
artifacts/
binaries/

# Runtime data from benchmark runs. Keep Markdown reports and receipt JSON.
**/receipts/**/data/
**/receipts/**/source/
**/receipts/**/targets/
**/receipts/**/object-store/
**/receipts/**/objects/
**/receipts/**/engine/
**/receipts/**/larger-than-memory/
**/receipts/**/topology/
**/bench/*/data/
**/bench/*/source/
**/bench/*/targets/
**/bench/*/object-store/
**/bench/*/objects/
**/bench/*/engine/
**/bench/*/larger-than-memory/
**/bench/*/topology/
# Some diagnostics put their generated run tree below another run directory.
# Ignore those runtime trees while leaving run-root reports and receipt JSON
# available for review and staging.
**/bench/**/data/
**/bench/**/source/
**/bench/**/targets/
**/bench/**/object-store/
**/bench/**/objects/
**/bench/**/engine/
**/bench/**/larger-than-memory/
**/bench/**/topology/
**/bench/**/runner-app/
**/bench/**/runtimes/
**/bench/**/frozen-runtime/
**/bench/**/frozen-provenance/
.terrascale/

# Generated binaries, database files, raw samples, and run logs.
*.dll
*.exe
*.so
*.dylib
*.pdb
*.bin
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.wal
*.wal.*
*.seg
*.sst
*.ldb
*.ltx
*.pfx
*.p12
*.key
*.log
*.jsonl
# Guest raw samples are acceptance evidence in the active benchmark tree.
!/bench/**/*.jsonl
*.nettrace
*.spool
*.dmp
*.core
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.zst

# Firecracker run receipts and small logs remain reviewable. Generated guest
# images and compiled engine test executables stay local to the VM fixture cache.
/bench/firecracker-harness/**/guest-rootfs.ext4
/bench/firecracker-harness/**/firecracker.pid
/bench/firecracker-harness/engine-test-fixtures/*/tb_*
/bench/firecracker-harness/engine-test-fixtures/*/storage_contract-*
# Keep versioned image build receipts visible while large kernel/rootfs and
# downloaded package or OCI bytes stay local to the fixture cache.
/bench/fixtures/firecracker-images/**/vmlinux
/bench/fixtures/firecracker-images/**/rootfs.ext4
/bench/fixtures/firecracker-images/**/cache/
/bench/fixtures/firecracker-images/**/downloads/
/bench/fixtures/firecracker-images/**/oci/
!/bench/firecracker-harness/**/*.log
# Compiled executables and OCI layer bytes staged for Firecracker runs stay
# local; manifests, receipts and provenance remain reviewable.
/bench/**/payloads/
/bench/**/.run-inputs/*/harness/
/bench/**/.run-inputs/*/program/
/bench/**/oci-layout/*/blobs/
/bench/firecracker-harness/**/test-program
/bench/firecracker-harness/**/*-musl
/bench/firecracker-harness/**/apt-helper
/bench/firecracker-harness/**/evidence/rustfs

# Launcher metadata and other generated operational files.
**/launch.env

# Trash / editor leftovers
*~
*.bak
*.tmp
*.orig
*.rej
Thumbs.db

# Python harness bytecode and reproducible CI smoke outputs.
__pycache__/
/bench/csharp-smoke*/
