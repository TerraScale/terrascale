+    /// <summary>
+    /// Starts a newly selected invisible build from one consistent source
+    /// snapshot when the physical backend supports snapshot construction.
+    /// </summary>
+    internal async ValueTask<AutomaticIndexRecord> StartBuildFromSnapshotAsync(
+        string candidateId,
+        ulong minimumTargetPosition,
+        CancellationToken cancellationToken = default)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(candidateId);
+
+        var claim = LifecycleClaim(candidateId);
+        await claim.WaitAsync(cancellationToken).ConfigureAwait(false);
+        try
+        {
+            var current = Require(candidateId);
+            EnsurePhase(current, AutomaticIndexPhase.Selected);
+            if (backend is not IAutomaticIndexSnapshotBuildBackend snapshots)
+            {
+                throw new AutomaticIndexLifecycleException(
+                    "The physical backend cannot start a build from a consistent snapshot.");
+            }
+
+            AutomaticIndexRecord completed;
+            await using (var snapshot = await snapshots.CaptureBuildSnapshotAsync(
+                candidateId, cancellationToken).ConfigureAwait(false))
+            {
+                if (snapshot.TargetPosition < minimumTargetPosition)
+                {
+                    throw new AutomaticIndexLifecycleException(
+                        "The captured build snapshot precedes the requested source cut.");
+                }
+
+                // Persist the zero-position intent before resetting the physical
+                // generation. A crash after this checkpoint can resume the same
+                // immutable source copy without exposing a partial index.
+                var starting = await TransitionAsync(current, AutomaticIndexPhase.Building, current with
+                {
+                    TargetPosition = snapshot.TargetPosition,
+                    AppliedPosition = 0,
+                    Visible = false,
+                }, "snapshot build started", cancellationToken).ConfigureAwait(false);
+                try
+                {
+                    await backend.BuildInvisibleAsync(starting.Candidate, snapshot.TargetPosition, cancellationToken)
+                        .ConfigureAwait(false);
+                    await snapshot.BuildAsync(cancellationToken).ConfigureAwait(false);
+                    completed = await TransitionAsync(starting, AutomaticIndexPhase.Building, starting with
+                    {
+                        AppliedPosition = snapshot.TargetPosition,
+                    }, "snapshot build completed", cancellationToken).ConfigureAwait(false);
+                }
+                catch
+                {
+                    await TryReconcileAsync(starting, CancellationToken.None).ConfigureAwait(false);
+                    throw;
+                }
+            }
+
+            await TryReleaseBuildSnapshotAsync(candidateId, completed.TargetPosition!.Value, CancellationToken.None)
+                .ConfigureAwait(false);
+            return completed;
+        }
+        finally
+        {
+            claim.Release();
+        }
+    }
