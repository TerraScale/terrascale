+    private static bool CanServeShape(
+        IndexDefinition definition,
+        IndexRuntimeQuery query,
+        out string? rejectionReason)
+    {
+        ArgumentNullException.ThrowIfNull(definition);
+        ArgumentNullException.ThrowIfNull(query);
+
+        var access = AccessFor(definition, query.Predicates);
+        if (definition.Kind == IndexKind.FullText
+            && access != IndexAccessMethod.FullTextSeek)
+        {
+            rejectionReason = "A full-text candidate requires a Contains predicate over an indexed field.";
+            return false;
+        }
+
+        var substringPredicate = FullTextPlannerRules.SubstringPredicate(definition, query.Predicates);
+        if (substringPredicate is not null)
+        {
+            rejectionReason = FullTextPlannerRules.SubstringRejectionReason(substringPredicate);
+            return false;
+        }
+
+        if (definition.Kind == IndexKind.Relationship)
+        {
+            rejectionReason = "Relationship indexes require coupled source and target collection planning.";
+            return false;
+        }
+
+        if (!PartialFilterIsImplied(definition, query.Predicates, out var partialReason))
+        {
+            rejectionReason = partialReason;
+            return false;
+        }
+
+        if (access == IndexAccessMethod.Scan
+            && !HasSupportedEntryScanShape(definition, query.Predicates))
+        {
+            rejectionReason = "The query has no supported leading-key predicate for this index.";
+            return false;
+        }
+
+        rejectionReason = null;
+        return true;
+    }
