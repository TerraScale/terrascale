+#[derive(Clone, Debug)]
+enum InjectedBody {
+    ShortOnce,
+    OversizedOnce,
+    ReplaceObject(Bytes),
+}
+
+#[derive(Debug)]
+struct FaultInjectingStore {
+    inner: Arc<dyn ObjectStore>,
+    next_body_fault: Mutex<Option<(Path, InjectedBody)>>,
+}
+
+impl FaultInjectingStore {
+    fn new(inner: Arc<dyn ObjectStore>) -> Self {
+        Self {
+            inner,
+            next_body_fault: Mutex::new(None),
+        }
+    }
+
+    fn arm(&self, path: Path, fault: InjectedBody) {
+        *self.next_body_fault.lock().expect("fault mutex is healthy") = Some((path, fault));
+    }
+
+    fn clear(&self) {
+        *self.next_body_fault.lock().expect("fault mutex is healthy") = None;
+    }
+
+    fn fault_for(&self, location: &Path) -> Option<InjectedBody> {
+        let mut guard = self.next_body_fault.lock().expect("fault mutex is healthy");
+        if !guard.as_ref().is_some_and(|(target, _)| target == location) {
+            return None;
+        }
+        match guard.as_ref().map(|(_, fault)| fault) {
+            Some(InjectedBody::ReplaceObject(bytes)) => {
+                Some(InjectedBody::ReplaceObject(bytes.clone()))
+            }
+            Some(InjectedBody::ShortOnce | InjectedBody::OversizedOnce) => {
+                guard.take().map(|(_, fault)| fault)
+            }
+            None => None,
+        }
+    }
+}
+
+impl Display for FaultInjectingStore {
+    fn fmt(&self, formatter: &mut Formatter<'_>) -> fmt::Result {
+        write!(formatter, "fault-injecting({})", self.inner)
+    }
