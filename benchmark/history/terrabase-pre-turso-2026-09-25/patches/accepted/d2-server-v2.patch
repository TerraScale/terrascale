+//! Strict, bounded RustFS archival configuration. Secrets never enter argv or logs.
+
+use std::fs::OpenOptions;
+use std::io::{self, Read};
+use std::net::IpAddr;
+use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+use std::path::Path;
+
+use serde::Deserialize;
+use sha2::{Digest, Sha256};
+use url::{Host, Url};
+use zeroize::Zeroizing;
+
+const MAX_CONFIG_BYTES: usize = 16 * 1024;
+const MAX_CREDENTIAL_BYTES: usize = 4 * 1024;
+const KEY_NAMESPACE: &str = "tb-objects/v1/";
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ArchiveFile {
+    version: u64,
+    provider: String,
+    endpoint: String,
+    bucket: String,
+    region: String,
+    credentials_file: String,
+    #[serde(default)]
+    allow_private_http: bool,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CredentialFile {
+    version: u64,
+    access_key_id: String,
+    secret_access_key: String,
+}
+
+/// Validated provider connection and durable, nonsecret destination identity.
+pub(crate) struct ArchiveConfig {
+    pub(crate) endpoint: String,
+    pub(crate) bucket: String,
+    pub(crate) region: String,
+    pub(crate) access_key_id: Zeroizing<String>,
+    pub(crate) secret_access_key: Zeroizing<String>,
+    pub(crate) allow_private_http: bool,
+    pub(crate) destination_id: [u8; 32],
+}
+
+#[derive(Debug, thiserror::Error)]
+pub(crate) enum ArchiveConfigError {
+    #[error("archive configuration file cannot be read")]
+    ConfigIo(#[source] io::Error),
+    #[error("archive configuration is invalid or exceeds its size limit")]
+    InvalidConfig,
+    #[error("archive credentials file cannot be read")]
+    CredentialIo(#[source] io::Error),
+    #[error("archive credentials must be a bounded owner-only regular file")]
+    InvalidCredentials,
+}
+
+fn bounded_file(
+    path: &Path,
+    max_bytes: usize,
+    private: bool,
+) -> Result<Vec<u8>, ArchiveConfigError> {
+    let mut file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(path)
+        .map_err(|error| {
+            if private {
+                ArchiveConfigError::CredentialIo(error)
+            } else {
+                ArchiveConfigError::ConfigIo(error)
+            }
+        })?;
+    let metadata = file.metadata().map_err(|error| {
+        if private {
+            ArchiveConfigError::CredentialIo(error)
+        } else {
+            ArchiveConfigError::ConfigIo(error)
+        }
+    })?;
+    if !metadata.is_file()
+        || metadata.nlink() != 1
+        || metadata.len() > max_bytes as u64
+        || (private
+            && (metadata.mode() & 0o7777 != 0o600
+                || metadata.uid() != rustix::process::geteuid().as_raw()))
+    {
+        return Err(if private {
+            ArchiveConfigError::InvalidCredentials
+        } else {
+            ArchiveConfigError::InvalidConfig
+        });
+    }
+    let mut bytes = Vec::with_capacity(usize::try_from(metadata.len()).expect("bounded file"));
+    file.take(max_bytes as u64 + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|error| {
+            if private {
+                ArchiveConfigError::CredentialIo(error)
+            } else {
+                ArchiveConfigError::ConfigIo(error)
+            }
+        })?;
+    if bytes.len() > max_bytes {
+        return Err(if private {
+            ArchiveConfigError::InvalidCredentials
+        } else {
+            ArchiveConfigError::InvalidConfig
+        });
+    }
+    Ok(bytes)
+}
+
+fn private_literal_ip(ip: IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(value) => value.is_private() || value.is_loopback() || value.is_link_local(),
+        IpAddr::V6(value) => {
+            value.is_unique_local() || value.is_loopback() || value.is_unicast_link_local()
+        }
+    }
+}
+
+fn digest_field(digest: &mut Sha256, value: &str) {
+    digest.update(
+        u32::try_from(value.len())
+            .expect("bounded archive configuration field")
+            .to_le_bytes(),
+    );
+    digest.update(value.as_bytes());
+}
+
+/// Parse all local policy and credential material before the shard opens.
+#[allow(
+    clippy::too_many_lines,
+    reason = "all archive settings and credentials must be validated together before shard open"
+)]
+pub(crate) fn load_archive_config(path: &Path) -> Result<ArchiveConfig, ArchiveConfigError> {
+    let bytes = bounded_file(path, MAX_CONFIG_BYTES, false)?;
+    let file: ArchiveFile =
+        serde_json::from_slice(&bytes).map_err(|_| ArchiveConfigError::InvalidConfig)?;
+    if file.version != 1 || file.provider != "rustfs" {
+        return Err(ArchiveConfigError::InvalidConfig);
+    }
+    let endpoint = Url::parse(&file.endpoint).map_err(|_| ArchiveConfigError::InvalidConfig)?;
+    let scheme = endpoint.scheme();
+    let host = endpoint.host().ok_or(ArchiveConfigError::InvalidConfig)?;
+    let port = endpoint
+        .port_or_known_default()
+        .ok_or(ArchiveConfigError::InvalidConfig)?;
+    let raw_authority = file
+        .endpoint
+        .split_once("://")
+        .map(|(_, rest)| rest.split('/').next().unwrap_or_default())
+        .ok_or(ArchiveConfigError::InvalidConfig)?;
+    if !matches!(scheme, "https" | "http")
+        || raw_authority.contains('@')
+        || !endpoint.username().is_empty()
+        || endpoint.password().is_some()
+        || endpoint.path() != "/"
+        || endpoint.query().is_some()
+        || endpoint.fragment().is_some()
+    {
+        return Err(ArchiveConfigError::InvalidConfig);
+    }
+    if let Host::Domain(domain) = &host
+        && (domain == &"amazonaws.com"
+            || domain.ends_with(".amazonaws.com")
+            || domain == &"amazonaws.com.cn"
+            || domain.ends_with(".amazonaws.com.cn"))
+    {
+        return Err(ArchiveConfigError::InvalidConfig);
+    }
+    if scheme == "http" {
+        let ip = match &host {
+            Host::Ipv4(value) => IpAddr::V4(*value),
+            Host::Ipv6(value) => IpAddr::V6(*value),
+            Host::Domain(_) => return Err(ArchiveConfigError::InvalidConfig),
+        };
+        if !file.allow_private_http || !private_literal_ip(ip) {
+            return Err(ArchiveConfigError::InvalidConfig);
+        }
+    }
+    if !(3..=63).contains(&file.bucket.len())
+        || !file.bucket.bytes().all(|byte| {
+            byte.is_ascii_lowercase() || byte.is_ascii_digit() || matches!(byte, b'-' | b'.')
+        })
+        || !file.bucket.as_bytes()[0].is_ascii_alphanumeric()
+        || !file.bucket.as_bytes()[file.bucket.len() - 1].is_ascii_alphanumeric()
+        || file.region.is_empty()
+        || file.region.len() > 64
+        || !file
+            .region
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-')
+    {
+        return Err(ArchiveConfigError::InvalidConfig);
+    }
+    let credential_path = Path::new(&file.credentials_file);
+    if !credential_path.is_absolute() {
+        return Err(ArchiveConfigError::InvalidConfig);
+    }
+    let credential_bytes =
+        Zeroizing::new(bounded_file(credential_path, MAX_CREDENTIAL_BYTES, true)?);
+    let credentials: CredentialFile = serde_json::from_slice(&credential_bytes)
+        .map_err(|_| ArchiveConfigError::InvalidCredentials)?;
+    let access_key_id = Zeroizing::new(credentials.access_key_id);
+    let secret_access_key = Zeroizing::new(credentials.secret_access_key);
+    if credentials.version != 1
+        || access_key_id.is_empty()
+        || secret_access_key.is_empty()
+        || access_key_id.len() > 512
+        || secret_access_key.len() > 2_048
+        || !access_key_id.bytes().all(|byte| byte.is_ascii_graphic())
+        || !secret_access_key
+            .bytes()
+            .all(|byte| byte.is_ascii_graphic())
+    {
+        return Err(ArchiveConfigError::InvalidCredentials);
+    }
+    let normalized_host = match &host {
+        Host::Ipv6(value) => format!("[{value}]"),
+        Host::Ipv4(value) => value.to_string(),
+        Host::Domain(value) => (*value).to_owned(),
+    };
+    let normalized_port = port.to_string();
+    let mut digest = Sha256::new();
+    digest.update(b"terrabase-archive-destination-v1\0");
+    for field in [
+        "rustfs",
+        scheme,
+        normalized_host.as_str(),
+        &normalized_port,
+        &file.bucket,
+        &file.region,
+        KEY_NAMESPACE,
+    ] {
+        digest_field(&mut digest, field);
+    }
+    Ok(ArchiveConfig {
+        endpoint: endpoint.to_string(),
+        bucket: file.bucket,
+        region: file.region,
+        access_key_id,
+        secret_access_key,
+        allow_private_http: file.allow_private_http,
+        destination_id: digest.finalize().into(),
+    })
+}
