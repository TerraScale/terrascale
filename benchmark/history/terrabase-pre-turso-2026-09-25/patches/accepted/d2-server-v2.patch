@@ -0,0 +1,399 @@
+//! One local-v1 candidate archive task. Remote I/O never holds the document owner.
+
+use std::io;
+use std::sync::Arc;
+use std::time::Duration;
+
+use object_store::aws::AmazonS3Builder;
+use tb_core::{Attribution, MemoryBudget};
+use tb_object::{ContentDigest, ObjectClient, ObjectLimits, TransferOwner, VerifiedObject};
+use tb_storage::{
+    ArchiveCut, ArchiveObjectRef, ArchiveProgress, ArchiveRunRefs, ArchiveVerifiedRefs,
+    ArchiveWalRefs, StorageError,
+};
+use tokio::io::AsyncRead;
+use tokio::sync::watch;
+use tokio::task::JoinHandle;
+
+use crate::archive_config::ArchiveConfig;
+use crate::local_v1_runtime::{ArchiveWorkerError, DocumentWorkerHandle};
+
+const WAL_CHUNK_BYTES: usize = 8 * 1024 * 1024;
+const IDLE_POLL: Duration = Duration::from_secs(5);
+const SHUTDOWN_LIMIT: Duration = Duration::from_secs(30);
+
+pub(crate) struct PreparedArchive {
+    client: ObjectClient,
+    owner: TransferOwner,
+    destination_id: [u8; 32],
+}
+
+impl PreparedArchive {
+    pub(crate) fn new(
+        config: ArchiveConfig,
+        budget: MemoryBudget,
+        attribution: Attribution,
+    ) -> Result<Self, io::Error> {
+        let store = AmazonS3Builder::new()
+            .with_endpoint(config.endpoint)
+            .with_bucket_name(config.bucket)
+            .with_region(config.region)
+            .with_access_key_id(config.access_key_id.as_str())
+            .with_secret_access_key(config.secret_access_key.as_str())
+            .with_allow_http(config.allow_private_http)
+            .with_virtual_hosted_style_request(false)
+            .build()
+            .map_err(|_| io::Error::other("invalid RustFS archive provider settings"))?;
+        let limits = ObjectLimits {
+            max_object_bytes: 80 * 1024 * 1024 * 1024,
+            upload_part_bytes: 16 * 1024 * 1024,
+            max_range_bytes: 1024 * 1024,
+            max_active_requests: 2,
+            max_upload_sessions: 1,
+            request_timeout: Duration::from_secs(30),
+        };
+        let client = ObjectClient::new(Arc::new(store), budget, limits)
+            .map_err(|_| io::Error::other("invalid archive transfer limits"))?;
+        Ok(Self {
+            client,
+            owner: TransferOwner {
+                tenant: attribution.tenant,
+                worker: attribution.worker,
+            },
+            destination_id: config.destination_id,
+        })
+    }
+
+    pub(crate) const fn destination_id(&self) -> [u8; 32] {
+        self.destination_id
+    }
+
+    pub(crate) fn start(self, worker: DocumentWorkerHandle) -> ArchiveTask {
+        let (stop, receiver) = watch::channel(false);
+        let join = tokio::spawn(run_archive_task(self, worker, receiver));
+        ArchiveTask { stop, join }
+    }
+}
+
+pub(crate) struct ArchiveTask {
+    stop: watch::Sender<bool>,
+    join: JoinHandle<()>,
+}
+
+impl ArchiveTask {
+    pub(crate) async fn shutdown(mut self) {
+        self.stop.send_modify(|stopped| *stopped = true);
+        if tokio::time::timeout(SHUTDOWN_LIMIT, &mut self.join)
+            .await
+            .is_err()
+        {
+            self.join.abort();
+            let _ = self.join.await;
+        }
+    }
+}
+
+#[derive(Debug, thiserror::Error)]
+enum ArchiveFailure {
+    #[error("archive owner operation failed")]
+    Worker(#[from] ArchiveWorkerError),
+    #[error("archive local source failed")]
+    Storage(#[from] StorageError),
+    #[error("archive provider operation failed")]
+    Provider(#[from] tb_object::ObjectError),
+    #[error("archive blocking stage failed")]
+    Blocking(#[from] tokio::task::JoinError),
+    #[error("archive provider lacks a required capability")]
+    Capability,
+}
+
+impl ArchiveFailure {
+    fn kind(&self) -> &'static str {
+        match self {
+            Self::Worker(ArchiveWorkerError::Busy) => "queue_full",
+            Self::Worker(_) => "owner",
+            Self::Storage(_) => "source",
+            Self::Provider(_) => "provider",
+            Self::Blocking(_) => "blocking",
+            Self::Capability => "capability",
+        }
+    }
+}
+
+fn record_failure(stage: &'static str, error: ArchiveFailure) -> ArchiveFailure {
+    metrics::counter!("terrabase_archive_errors_total", "stage" => stage, "kind" => error.kind())
+        .increment(1);
+    metrics::counter!("terrabase_archive_results_total", "stage" => stage, "result" => "failed")
+        .increment(1);
+    error
+}
+
+fn object_ref(verified: &VerifiedObject) -> ArchiveObjectRef {
+    ArchiveObjectRef {
+        key: verified.key().as_str(),
+        len: verified.length(),
+        sha256: *verified.sha256().as_bytes(),
+    }
+}
+
+async fn upload<R: AsyncRead + Unpin>(
+    archive: &PreparedArchive,
+    stage: &'static str,
+    reader: &mut R,
+    len: u64,
+    sha256: [u8; 32],
+) -> Result<ArchiveObjectRef, ArchiveFailure> {
+    metrics::counter!("terrabase_archive_attempts_total", "stage" => stage).increment(1);
+    let verified = archive
+        .client
+        .put_immutable(
+            reader,
+            len,
+            ContentDigest::from_bytes(sha256),
+            archive.owner,
+        )
+        .await
+        .map_err(|error| record_failure(stage, error.into()))?;
+    metrics::counter!("terrabase_archive_bytes_total", "stage" => stage).increment(len);
+    metrics::counter!("terrabase_archive_results_total", "stage" => stage, "result" => "verified")
+        .increment(1);
+    Ok(object_ref(&verified))
+}
+
+async fn blocking<T: Send + 'static>(
+    stage: &'static str,
+    operation: impl FnOnce() -> Result<T, StorageError> + Send + 'static,
+) -> Result<T, ArchiveFailure> {
+    metrics::counter!("terrabase_archive_attempts_total", "stage" => stage).increment(1);
+    let result = tokio::task::spawn_blocking(operation)
+        .await
+        .map_err(|error| record_failure(stage, error.into()))?
+        .map_err(|error| record_failure(stage, error.into()))?;
+    metrics::counter!("terrabase_archive_results_total", "stage" => stage, "result" => "ready")
+        .increment(1);
+    Ok(result)
+}
+
+#[allow(
+    clippy::cast_precision_loss,
+    clippy::too_many_lines,
+    reason = "Prometheus floating gauges approximate large sequence counters; one cycle retains its cut across bounded stages"
+)]
+async fn archive_cycle(
+    archive: &PreparedArchive,
+    worker: &DocumentWorkerHandle,
+    probed: &mut bool,
+) -> Result<bool, ArchiveFailure> {
+    metrics::counter!("terrabase_archive_attempts_total", "stage" => "progress").increment(1);
+    let progress = worker
+        .archive_progress()
+        .await
+        .map_err(|error| record_failure("progress", error.into()))?;
+    metrics::counter!("terrabase_archive_attempts_total", "stage" => "capture").increment(1);
+    let mut cut = worker
+        .begin_archive_cut(archive.destination_id, WAL_CHUNK_BYTES)
+        .await
+        .map_err(|error| record_failure("capture", error.into()))?;
+    let source = cut.frontier().get();
+    let candidate = match &progress {
+        ArchiveProgress::Candidate { frontier, .. } => {
+            metrics::gauge!("terrabase_archive_candidate_sequence")
+                .set(frontier.sequence.get() as f64);
+            frontier.sequence.get()
+        }
+        _ => {
+            metrics::gauge!("terrabase_archive_candidate_sequence").set(0.0);
+            0
+        }
+    };
+    metrics::gauge!("terrabase_archive_source_sequence").set(source as f64);
+    metrics::gauge!("terrabase_archive_candidate_lag").set(source.saturating_sub(candidate) as f64);
+    if matches!(progress, ArchiveProgress::Candidate { cut_id, .. } if cut_id == cut.id()) {
+        metrics::counter!("terrabase_archive_results_total", "stage" => "cycle", "result" => "unchanged")
+            .increment(1);
+        return Ok(false);
+    }
+
+    if !*probed {
+        metrics::counter!("terrabase_archive_attempts_total", "stage" => "probe").increment(1);
+        let report = archive
+            .client
+            .probe_capabilities(archive.owner)
+            .await
+            .map_err(|error| record_failure("probe", error.into()))?;
+        metrics::gauge!("terrabase_archive_capability_conditional_create")
+            .set(f64::from(u8::from(report.conditional_create)));
+        metrics::gauge!("terrabase_archive_capability_range_reads")
+            .set(f64::from(u8::from(report.range_reads)));
+        metrics::gauge!("terrabase_archive_capability_multipart_abort")
+            .set(f64::from(u8::from(report.multipart_abort)));
+        metrics::gauge!("terrabase_archive_capability_cas")
+            .set(f64::from(u8::from(report.conditional_manifest_update)));
+        if !report.conditional_create || !report.range_reads || !report.multipart_abort {
+            return Err(record_failure("probe", ArchiveFailure::Capability));
+        }
+        *probed = true;
+        metrics::gauge!("terrabase_archive_provider_probe_ok").set(1.0);
+        metrics::counter!("terrabase_archive_results_total", "stage" => "probe", "result" => "passed")
+            .increment(1);
+    }
+
+    let mut refs = ArchiveVerifiedRefs {
+        runs: Vec::with_capacity(cut.runs().len()),
+        wal: Vec::new(),
+    };
+    for index in 0..cut.runs().len() {
+        let (returned, source_file, sidecar, run_id, run_len, run_sha) =
+            blocking("run_source", move || {
+                let run = &cut.runs()[index];
+                let run_id = run.id();
+                let run_len = run.len();
+                let run_sha = run.sha256();
+                let source_file = run.open_reader()?;
+                let sidecar = run.remote_sidecar()?;
+                Ok((cut, source_file, sidecar, run_id, run_len, run_sha))
+            })
+            .await?;
+        cut = returned;
+        let mut source_file = tokio::fs::File::from_std(source_file);
+        let segment = upload(archive, "run", &mut source_file, run_len, run_sha).await?;
+        let mut sidecar_reader = sidecar.bytes();
+        let sidecar_ref = upload(
+            archive,
+            "sidecar",
+            &mut sidecar_reader,
+            sidecar.bytes().len() as u64,
+            sidecar.sha256(),
+        )
+        .await?;
+        refs.runs.push(ArchiveRunRefs {
+            run_id,
+            segment,
+            sidecar: sidecar_ref,
+        });
+    }
+    loop {
+        let (returned, chunk) = blocking("wal_source", move || {
+            let chunk = cut.next_wal_chunk()?;
+            Ok((cut, chunk))
+        })
+        .await?;
+        cut = returned;
+        let Some(chunk) = chunk else { break };
+        let mut reader = chunk.bytes();
+        let object = upload(
+            archive,
+            "wal",
+            &mut reader,
+            chunk.bytes().len() as u64,
+            chunk.sha256(),
+        )
+        .await?;
+        refs.wal.push(ArchiveWalRefs {
+            first: chunk.first,
+            last: chunk.last,
+            object,
+        });
+    }
+    let (returned, candidate) = blocking("candidate_encode", move || {
+        let candidate = cut.encode_candidate(&refs)?;
+        Ok((cut, candidate))
+    })
+    .await?;
+    cut = returned;
+    let mut reader = candidate.bytes();
+    let verified_candidate = upload(
+        archive,
+        "candidate",
+        &mut reader,
+        candidate.bytes().len() as u64,
+        candidate.sha256(),
+    )
+    .await?;
+    let source_cut_id = cut.id();
+    metrics::counter!("terrabase_archive_attempts_total", "stage" => "complete").increment(1);
+    match worker
+        .complete_archive_cut(cut, candidate, verified_candidate)
+        .await
+    {
+        Ok(frontier) => {
+            metrics::counter!("terrabase_archive_results_total", "stage" => "complete", "result" => "persisted")
+                .increment(1);
+            metrics::gauge!("terrabase_archive_candidate_sequence")
+                .set(frontier.sequence.get() as f64);
+            metrics::gauge!("terrabase_archive_candidate_lag")
+                .set(source.saturating_sub(frontier.sequence.get()) as f64);
+            Ok(true)
+        }
+        Err(error) => {
+            // A canceled response may follow a durable local index write. The
+            // persisted cut ID is the only safe retry discriminator.
+            let recovered = worker.archive_progress().await;
+            if matches!(recovered, Ok(ArchiveProgress::Candidate { cut_id, .. }) if cut_id == source_cut_id)
+            {
+                metrics::counter!("terrabase_archive_results_total", "stage" => "complete", "result" => "recovered")
+                    .increment(1);
+                Ok(true)
+            } else {
+                Err(record_failure("complete", error.into()))
+            }
+        }
+    }
+}
+
+fn retry_delay(failures: u32) -> Duration {
+    let base = 1_u64 << failures.saturating_sub(1).min(6);
+    let capped = base.min(60);
+    let mut bytes = [0_u8; 8];
+    let _ = getrandom::fill(&mut bytes);
+    let jitter = u64::from_le_bytes(bytes) % capped;
+    Duration::from_secs(1 + jitter)
+}
+
+async fn run_archive_task(
+    archive: PreparedArchive,
+    worker: DocumentWorkerHandle,
+    mut stop: watch::Receiver<bool>,
+) {
+    metrics::gauge!("terrabase_archive_active").set(1.0);
+    metrics::gauge!("terrabase_archive_degraded").set(0.0);
+    metrics::gauge!("terrabase_archive_provider_probe_ok").set(0.0);
+    metrics::gauge!("terrabase_archive_capability_conditional_create").set(0.0);
+    metrics::gauge!("terrabase_archive_capability_range_reads").set(0.0);
+    metrics::gauge!("terrabase_archive_capability_multipart_abort").set(0.0);
+    metrics::gauge!("terrabase_archive_capability_cas").set(0.0);
+    let mut probed = false;
+    let mut failures = 0_u32;
+    loop {
+        if *stop.borrow() {
+            break;
+        }
+        let result = async {
+            metrics::counter!("terrabase_archive_attempts_total", "stage" => "cycle").increment(1);
+            archive_cycle(&archive, &worker, &mut probed).await
+        }
+        .await;
+        let delay = match result {
+            Ok(changed) => {
+                failures = 0;
+                metrics::gauge!("terrabase_archive_degraded").set(0.0);
+                if changed {
+                    metrics::counter!("terrabase_archive_results_total", "stage" => "cycle", "result" => "candidate")
+                        .increment(1);
+                }
+                IDLE_POLL
+            }
+            Err(error) => {
+                failures = failures.saturating_add(1);
+                metrics::gauge!("terrabase_archive_degraded").set(1.0);
+                let _ = record_failure("cycle", error);
+                retry_delay(failures)
+            }
+        };
+        tokio::select! {
+            _ = tokio::time::sleep(delay) => {},
+            _ = stop.changed() => break,
+        }
+    }
+    metrics::gauge!("terrabase_archive_active").set(0.0);
+}
