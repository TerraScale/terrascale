+            let frame_start = self.next_offset;
+            if frame_start >= self.wal_end {
+                return Err(corrupt("archive WAL ends before frontier"));
+            }
+            self.wal.seek(SeekFrom::Start(frame_start))?;
+            let mut header = [0_u8; WAL_HEADER_LEN];
+            self.wal.read_exact(&mut header)?;
+            let frame_len = wal_frame_len(&header, &self.format)?;
+            if frame_len > self.max_bytes {
+                return Err(StorageError::Capacity("archive frame exceeds chunk"));
+            }
+            if !bytes.is_empty() && frame_len > self.max_bytes - bytes.len() {
+                break;
+            }
+            let frame_end = frame_start
+                .checked_add(frame_len as u64)
+                .ok_or(StorageError::Capacity("archive WAL offset"))?;
+            if frame_end > self.wal_end {
+                return Err(corrupt("archive WAL frame exceeds captured EOF"));
+            }
+            let mut frame_bytes = Vec::new();
+            frame_bytes
+                .try_reserve_exact(frame_len)
+                .map_err(|_| StorageError::Capacity("archive WAL frame allocation"))?;
+            frame_bytes.resize(frame_len, 0);
+            frame_bytes[..WAL_HEADER_LEN].copy_from_slice(&header);
+            self.wal.read_exact(&mut frame_bytes[WAL_HEADER_LEN..])?;
+            let frame = decode_wal_frame(&frame_bytes, &self.format)?;
+            if frame.sequence() != self.next_sequence {
+                return Err(corrupt("archive WAL sequence gap or repeat"));
+            }
+            if frame.sequence() > self.frontier.get() {
+                return Err(corrupt("archive WAL passed captured frontier"));
+            }
+            if frame.sequence() > self.checkpoint.get() {
+                if first.is_none() {
+                    first = Some(frame.sequence());
+                    chunk_start = frame_start;
+                }
+                last = Some(frame.sequence());
+                bytes.extend_from_slice(&frame_bytes);
+                self.exported_through = CommitSeq::new(frame.sequence());
+            }
+            self.next_sequence = self
+                .next_sequence
+                .checked_add(1)
+                .ok_or(StorageError::Capacity("archive sequence"))?;
+            self.next_offset = frame_end;
+        }
+        drop(scratch_permit);
+        let (Some(first), Some(last)) = (first, last) else {
+            return Err(corrupt("archive WAL has no frame after checkpoint"));
+        };
+        let sha256: [u8; 32] = Sha256::digest(&bytes).into();
+        self.chunks
+            .try_reserve(1)
+            .map_err(|_| StorageError::Capacity("archive chunk metadata"))?;
+        self.chunks.push(ChunkDescriptor {
+            first,
+            last,
+            start: chunk_start,
+            len: bytes.len() as u64,
+            sha256,
+        });
+        Ok(Some(ArchiveWalChunk {
+            first: CommitSeq::new(first),
+            last: CommitSeq::new(last),
+            bytes,
+            sha256,
+            _permit: permit,
+        }))
+    }
+
+    /// Encode the exact bounded candidate before uploading it. The returned
+    /// bytes and digest must themselves be readback-verified as one object.
+    ///
+    /// # Errors
+    /// Rejects incomplete export, wrong refs, changed source or memory limits.
+    pub fn encode_candidate(
+        &self,
+        refs: &ArchiveVerifiedRefs,
+    ) -> Result<ArchiveCandidate, StorageError> {
+        if self.failed
+            || self.exported_through != self.frontier
+            || refs.runs.len() != self.runs.len()
+            || refs.wal.len() != self.chunks.len()
+        {
+            return Err(corrupt("archive cut export or reference count incomplete"));
+        }
+        let permit = self.budget.try_reserve(self.attribution, INDEX_MAX * 4)?;
+        self.verify_sources()?;
+        self.verify_sidecars(refs)?;
+        let mut runs = Vec::new();
+        runs.try_reserve_exact(refs.runs.len())
+            .map_err(|_| StorageError::Capacity("archive reference memory"))?;
+        for (source, uploaded) in self.runs.iter().zip(&refs.runs) {
+            if source.id != uploaded.run_id
+                || uploaded.segment.len != source.len
+                || uploaded.segment.sha256 != source.sha256
+            {
+                return Err(corrupt("archive run reference differs from source"));
+            }
+            runs.push(RemoteArchiveRunRef {
+                id: source.id,
+                len: source.len,
+                sha256: source.sha256,
+                segment: RemoteArchiveObjectRef {
+                    key: &uploaded.segment.key,
+                    len: uploaded.segment.len,
+                    sha256: uploaded.segment.sha256,
+                },
+                sidecar: RemoteArchiveObjectRef {
+                    key: &uploaded.sidecar.key,
+                    len: uploaded.sidecar.len,
+                    sha256: uploaded.sidecar.sha256,
+                },
+            });
+        }
+        let mut wal = Vec::new();
+        wal.try_reserve_exact(refs.wal.len())
+            .map_err(|_| StorageError::Capacity("archive reference memory"))?;
+        for (source, uploaded) in self.chunks.iter().zip(&refs.wal) {
+            if uploaded.first.get() != source.first
+                || uploaded.last.get() != source.last
+                || uploaded.object.len != source.len
+                || uploaded.object.sha256 != source.sha256
+            {
+                return Err(corrupt("archive WAL reference differs from sealed source"));
+            }
+            wal.push(RemoteArchiveWalRef {
+                first: source.first,
+                last: source.last,
+                len: source.len,
+                sha256: source.sha256,
+                object: RemoteArchiveObjectRef {
+                    key: &uploaded.object.key,
+                    len: uploaded.object.len,
+                    sha256: uploaded.object.sha256,
+                },
+            });
+        }
+        let input = RemoteArchiveManifestInput {
+            mode: self.mode,
+            source_generation: self.source_generation,
+            checkpoint: self.checkpoint.get(),
+            retry_floor_ms: self.floor_ms,
+            frontier: self.frontier.get(),
+            runs: &runs,
+            wal: &wal,
+        };
+        let mut bytes = Vec::new();
+        encode_remote_archive_manifest_into(&mut bytes, input)?;
+        let sha256 = Sha256::digest(&bytes).into();
+        Ok(ArchiveCandidate {
+            cut_id: self.id,
+            instance: self.instance,
+            bytes,
+            sha256,
+            _permit: permit,
+        })
+    }
+
+    pub(crate) fn verify_sidecars(&self, refs: &ArchiveVerifiedRefs) -> Result<(), StorageError> {
+        if refs.runs.len() != self.runs.len() {
+            return Err(corrupt("archive run reference count"));
+        }
+        for (run, uploaded) in self.runs.iter().zip(&refs.runs) {
+            let sidecar = run.remote_sidecar()?;
+            if uploaded.sidecar.len != sidecar.bytes().len() as u64
+                || uploaded.sidecar.sha256 != sidecar.sha256()
+            {
+                return Err(corrupt("archive sidecar reference differs from source"));
+            }
+        }
+        Ok(())
+    }
+
+    pub(crate) fn verify_sources(&self) -> Result<(), StorageError> {
+        for run in &self.runs {
+            run::validate_run(
+                run.path
+                    .parent()
+                    .ok_or_else(|| corrupt("archive run parent"))?,
+                &RunMeta {
+                    id: run.id,
+                    bytes: run.len,
+                    sha256: run.sha256,
+                },
+                &self.format,
+            )?;
+        }
+        let mut wal = self.wal.try_clone()?;
+        for chunk in &self.chunks {
+            wal.seek(SeekFrom::Start(chunk.start))?;
+            let mut remaining = chunk.len;
+            let mut digest = Sha256::new();
+            let mut block = [0_u8; 8192];
+            while remaining > 0 {
+                let n = usize::try_from(remaining.min(block.len() as u64)).expect("bounded block");
+                wal.read_exact(&mut block[..n])?;
+                digest.update(&block[..n]);
+                remaining -= n as u64;
+            }
+            if <[u8; 32]>::from(digest.finalize()) != chunk.sha256 {
+                return Err(corrupt("archive WAL source changed"));
+            }
+        }
+        Ok(())
+    }
+}
+
