+            destination_id,
+            instance,
+            mode,
+            source_generation,
+            checkpoint,
+            frontier,
+            floor_ms,
+            runs: archive_runs,
+            wal,
+            wal_end,
+            next_offset: 0,
+            next_sequence: 1,
+            exported_through: checkpoint,
+            max_bytes,
+            format,
+            budget,
+            attribution,
+            chunks: Vec::new(),
+            failed: false,
+            _metadata_permit: metadata_permit,
