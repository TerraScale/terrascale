+//! Bounded, versioned candidate manifest for a local document archive.
+//!
+//! This describes verified immutable objects, but it is not a remote root or
+//! publication authority. A caller must authenticate the selected manifest.
+
+use std::collections::HashSet;
+
+use tb_core::{DatabaseId, DocumentId, MembershipEpoch, OriginId, ReplicaId, ShardId, TenantId};
+
+use crate::FormatError;
+
+const MAGIC: &[u8; 8] = b"TBARM001";
+const VERSION: u16 = 1;
+const PREFIX: &str = "tb-objects/v1/";
+const KEY_LEN: usize = PREFIX.len() + 26;
+const REF_LEN: usize = KEY_LEN + 8 + 32;
+const MODE_LEN: usize = 16 + 16 + 8 + 16 + 16 + 8 + 32;
+const HEADER_LEN: usize = 8 + 2 + 2 + 4 + MODE_LEN + 8 * 4 + 4 * 2;
+const RUN_LEN: usize = 8 + 8 + 32 + REF_LEN * 2;
+const WAL_LEN: usize = 8 + 8 + 8 + 32 + REF_LEN;
+const MAX_BYTES: usize = 1 << 20;
+const MAX_RUNS: usize = 2_048;
+const MAX_WAL_CHUNKS: usize = 4_096;
+const FORMAT: &str = "remote archive candidate";
+
+fn invalid(reason: &'static str) -> FormatError {
+    FormatError::Invalid {
+        format: FORMAT,
+        reason,
+    }
+}
+
+/// Exact identity from a validated local document mode marker.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct RemoteArchiveMode {
+    pub tenant: TenantId,
+    pub database: DatabaseId,
+    pub shard: ShardId,
+    pub origin: OriginId,
+    pub epoch: MembershipEpoch,
+    pub configuration: [u8; 32],
+}
+
+/// Provider key and exact readback-verified object identity.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct RemoteArchiveObjectRef<'a> {
+    pub key: &'a str,
+    pub len: u64,
+    pub sha256: [u8; 32],
+}
+
+/// One local immutable run and its authenticated range sidecar.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct RemoteArchiveRunRef<'a> {
+    pub id: u64,
+    pub len: u64,
+    pub sha256: [u8; 32],
+    pub segment: RemoteArchiveObjectRef<'a>,
+    pub sidecar: RemoteArchiveObjectRef<'a>,
+}
+
+/// One whole-frame sealed WAL interval.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct RemoteArchiveWalRef<'a> {
+    pub first: u64,
+    pub last: u64,
+    pub len: u64,
+    pub sha256: [u8; 32],
+    pub object: RemoteArchiveObjectRef<'a>,
+}
+
+/// Input for a candidate manifest; no recovery authority is implied.
+#[derive(Clone, Copy, Debug)]
+pub struct RemoteArchiveManifestInput<'a> {
+    pub mode: RemoteArchiveMode,
+    pub source_generation: u64,
+    pub checkpoint: u64,
+    pub retry_floor_ms: u64,
+    pub frontier: u64,
+    pub runs: &'a [RemoteArchiveRunRef<'a>],
+    pub wal: &'a [RemoteArchiveWalRef<'a>],
+}
+
+/// Fully validated borrowed view of a candidate manifest.
+#[derive(Clone, Copy, Debug)]
+pub struct RemoteArchiveManifest<'a> {
+    bytes: &'a [u8],
+    mode: RemoteArchiveMode,
+    source_generation: u64,
+    checkpoint: u64,
+    retry_floor_ms: u64,
+    frontier: u64,
+    runs: usize,
+    wal: usize,
+}
+
+impl<'a> RemoteArchiveManifest<'a> {
+    #[must_use]
+    pub const fn mode(&self) -> RemoteArchiveMode {
+        self.mode
+    }
+    #[must_use]
+    pub const fn source_generation(&self) -> u64 {
+        self.source_generation
+    }
+    #[must_use]
+    pub const fn checkpoint(&self) -> u64 {
+        self.checkpoint
+    }
+    #[must_use]
+    pub const fn retry_floor_ms(&self) -> u64 {
+        self.retry_floor_ms
+    }
+    #[must_use]
+    pub const fn frontier(&self) -> u64 {
+        self.frontier
+    }
+    #[must_use]
+    pub const fn run_count(&self) -> usize {
+        self.runs
+    }
+    #[must_use]
+    pub const fn wal_count(&self) -> usize {
+        self.wal
+    }
+    #[must_use]
+    pub const fn encoded_bytes(&self) -> &'a [u8] {
+        self.bytes
+    }
+
+    /// Iterate ordered run entries without allocating after validation.
+    #[must_use]
+    pub fn runs(&self) -> impl Iterator<Item = RemoteArchiveRunRef<'a>> + 'a {
+        self.bytes[HEADER_LEN..HEADER_LEN + self.runs * RUN_LEN]
+            .chunks_exact(RUN_LEN)
+            .map(parse_run)
+    }
+
+    /// Iterate contiguous sealed WAL entries without allocating after validation.
+    #[must_use]
+    pub fn wal(&self) -> impl Iterator<Item = RemoteArchiveWalRef<'a>> + 'a {
+        let start = HEADER_LEN + self.runs * RUN_LEN;
+        self.bytes[start..start + self.wal * WAL_LEN]
+            .chunks_exact(WAL_LEN)
+            .map(parse_wal)
+    }
+}
+
+fn canonical_key(key: &str) -> Result<(), FormatError> {
+    let suffix = key
+        .strip_prefix(PREFIX)
+        .ok_or_else(|| invalid("object key prefix"))?;
+    if key.len() != KEY_LEN || DocumentId::parse_canonical(suffix).is_err() {
+        return Err(invalid("object key is not canonical"));
+    }
+    Ok(())
+}
+
+fn object_ref_valid(reference: RemoteArchiveObjectRef<'_>) -> Result<(), FormatError> {
+    canonical_key(reference.key)?;
+    if reference.len == 0 {
+        return Err(invalid("empty archive object"));
+    }
+    Ok(())
+}
+
+fn validate(input: RemoteArchiveManifestInput<'_>) -> Result<usize, FormatError> {
+    if input.mode.epoch.get() == 0
+        || input.mode.origin.incarnation == [0; 16]
+        || input.mode.configuration == [0; 32]
+        || input.source_generation == 0 && input.checkpoint != 0
+        || input.frontier < input.checkpoint
+    {
+        return Err(invalid("mode or frontier"));
+    }
+    if input.runs.len() > MAX_RUNS || input.wal.len() > MAX_WAL_CHUNKS {
+        return Err(invalid("entry count exceeds hard cap"));
+    }
+    if input.checkpoint > 0 && input.runs.is_empty() {
+        return Err(invalid("checkpoint has no immutable run"));
+    }
+    let len = HEADER_LEN
+        .checked_add(
+            input
+                .runs
+                .len()
+                .checked_mul(RUN_LEN)
+                .ok_or_else(|| invalid("run length overflow"))?,
+        )
+        .and_then(|n| n.checked_add(input.wal.len().checked_mul(WAL_LEN)?))
+        .and_then(|n| n.checked_add(4))
+        .ok_or_else(|| invalid("manifest length overflow"))?;
+    if len > MAX_BYTES {
+        return Err(FormatError::LimitExceeded {
+            what: FORMAT,
+            value: len,
+            limit: MAX_BYTES,
+        });
+    }
+    let mut keys = HashSet::new();
+    keys.try_reserve(
+        input
+            .runs
+            .len()
+            .saturating_mul(2)
+            .saturating_add(input.wal.len()),
+    )
+    .map_err(|_| FormatError::Allocation)?;
+    let mut previous_run = 0;
+    for run in input.runs {
+        if run.id <= previous_run
+            || run.len == 0
+            || run.segment.len != run.len
+            || run.segment.sha256 != run.sha256
+        {
+            return Err(invalid("run order or identity"));
+        }
+        previous_run = run.id;
+        for reference in [run.segment, run.sidecar] {
+            object_ref_valid(reference)?;
+            if !keys.insert(reference.key) {
+                return Err(invalid("duplicate object key"));
+            }
+        }
+    }
+    let mut next = input.checkpoint.checked_add(1);
+    for entry in input.wal {
+        if next != Some(entry.first)
+            || entry.last < entry.first
+            || entry.len == 0
+            || entry.object.len != entry.len
+            || entry.object.sha256 != entry.sha256
+        {
+            return Err(invalid("WAL gap or object identity"));
+        }
+        object_ref_valid(entry.object)?;
+        if !keys.insert(entry.object.key) {
+            return Err(invalid("duplicate object key"));
+        }
+        next = entry.last.checked_add(1);
+    }
+    if input.frontier == input.checkpoint {
+        if !input.wal.is_empty() {
+            return Err(invalid("WAL after checkpoint frontier"));
+        }
+    } else if next != input.frontier.checked_add(1) {
+        return Err(invalid("WAL does not reach frontier"));
+    }
+    Ok(len)
+}
+
+fn put_ref(out: &mut Vec<u8>, reference: RemoteArchiveObjectRef<'_>) {
+    out.extend_from_slice(reference.key.as_bytes());
+    out.extend_from_slice(&reference.len.to_le_bytes());
+    out.extend_from_slice(&reference.sha256);
+}
+
+/// Calculate the exact encoded length after validating all entry invariants.
+/// Callers must reserve both encoded output and the bounded duplicate-key scratch.
+///
+/// # Errors
+/// Rejects malformed scope, references, sequence gaps and hard-cap overflows.
+pub fn remote_archive_manifest_encoded_len(
+    input: RemoteArchiveManifestInput<'_>,
+) -> Result<usize, FormatError> {
+    validate(input)
+}
+
+/// Encode a bounded candidate manifest with CRC32C.
+///
+/// # Errors
+/// Rejects any invalid input before mutating `out`.
+pub fn encode_remote_archive_manifest_into(
+    out: &mut Vec<u8>,
+    input: RemoteArchiveManifestInput<'_>,
+) -> Result<(), FormatError> {
+    let len = validate(input)?;
+    out.try_reserve(len).map_err(|_| FormatError::Allocation)?;
+    let start = out.len();
+    out.extend_from_slice(MAGIC);
+    out.extend_from_slice(&VERSION.to_le_bytes());
+    out.extend_from_slice(&0_u16.to_le_bytes());
+    out.extend_from_slice(&u32::try_from(len).expect("1 MiB hard cap").to_le_bytes());
+    out.extend_from_slice(&input.mode.tenant.to_bytes());
+    out.extend_from_slice(&input.mode.database.to_bytes());
+    out.extend_from_slice(&input.mode.shard.get().to_le_bytes());
+    out.extend_from_slice(&input.mode.origin.replica_id.to_bytes());
+    out.extend_from_slice(&input.mode.origin.incarnation);
+    out.extend_from_slice(&input.mode.epoch.get().to_le_bytes());
+    out.extend_from_slice(&input.mode.configuration);
+    out.extend_from_slice(&input.source_generation.to_le_bytes());
+    out.extend_from_slice(&input.checkpoint.to_le_bytes());
+    out.extend_from_slice(&input.retry_floor_ms.to_le_bytes());
+    out.extend_from_slice(&input.frontier.to_le_bytes());
+    out.extend_from_slice(
+        &u32::try_from(input.runs.len())
+            .expect("hard cap")
+            .to_le_bytes(),
+    );
+    out.extend_from_slice(
+        &u32::try_from(input.wal.len())
+            .expect("hard cap")
+            .to_le_bytes(),
+    );
+    for run in input.runs {
+        out.extend_from_slice(&run.id.to_le_bytes());
+        out.extend_from_slice(&run.len.to_le_bytes());
+        out.extend_from_slice(&run.sha256);
+        put_ref(out, run.segment);
+        put_ref(out, run.sidecar);
+    }
+    for entry in input.wal {
+        out.extend_from_slice(&entry.first.to_le_bytes());
+        out.extend_from_slice(&entry.last.to_le_bytes());
+        out.extend_from_slice(&entry.len.to_le_bytes());
+        out.extend_from_slice(&entry.sha256);
+        put_ref(out, entry.object);
+    }
+    let crc = crc32c::crc32c(&out[start..]);
+    out.extend_from_slice(&crc.to_le_bytes());
+    debug_assert_eq!(out.len() - start, len);
+    Ok(())
+}
+
+fn u64_at(bytes: &[u8], offset: usize) -> u64 {
+    u64::from_le_bytes(
+        bytes[offset..offset + 8]
+            .try_into()
+            .expect("validated slice"),
+    )
+}
+fn u32_at(bytes: &[u8], offset: usize) -> u32 {
+    u32::from_le_bytes(
+        bytes[offset..offset + 4]
+            .try_into()
+            .expect("validated slice"),
+    )
+}
+fn parse_ref(bytes: &[u8]) -> RemoteArchiveObjectRef<'_> {
+    let key = std::str::from_utf8(&bytes[..KEY_LEN]).expect("validated key");
+    RemoteArchiveObjectRef {
+        key,
+        len: u64_at(bytes, KEY_LEN),
+        sha256: bytes[KEY_LEN + 8..REF_LEN]
+            .try_into()
+            .expect("fixed digest"),
+    }
+}
+fn parse_run(bytes: &[u8]) -> RemoteArchiveRunRef<'_> {
+    RemoteArchiveRunRef {
+        id: u64_at(bytes, 0),
+        len: u64_at(bytes, 8),
+        sha256: bytes[16..48].try_into().expect("fixed digest"),
+        segment: parse_ref(&bytes[48..48 + REF_LEN]),
+        sidecar: parse_ref(&bytes[48 + REF_LEN..RUN_LEN]),
+    }
+}
+fn parse_wal(bytes: &[u8]) -> RemoteArchiveWalRef<'_> {
+    RemoteArchiveWalRef {
+        first: u64_at(bytes, 0),
+        last: u64_at(bytes, 8),
+        len: u64_at(bytes, 16),
+        sha256: bytes[24..56].try_into().expect("fixed digest"),
+        object: parse_ref(&bytes[56..WAL_LEN]),
+    }
+}
+
+/// Decode and validate every entry before returning a borrowed view.
+///
+/// # Errors
+/// Rejects unsupported versions, truncation, checksum failure, noncanonical keys,
+/// duplicate references, ordering gaps and any hard-cap excess.
+pub fn decode_remote_archive_manifest(
+    bytes: &[u8],
+) -> Result<RemoteArchiveManifest<'_>, FormatError> {
+    if bytes.len() < HEADER_LEN + 4 {
+        return Err(FormatError::Truncated {
+            format: FORMAT,
+            expected: HEADER_LEN + 4,
+            actual: bytes.len(),
+        });
+    }
+    if bytes.len() > MAX_BYTES {
+        return Err(FormatError::LimitExceeded {
+            what: FORMAT,
+            value: bytes.len(),
+            limit: MAX_BYTES,
+        });
+    }
+    if &bytes[..8] != MAGIC {
+        return Err(invalid("magic"));
+    }
+    let major = u16::from_le_bytes(bytes[8..10].try_into().expect("fixed version"));
+    let minor = u16::from_le_bytes(bytes[10..12].try_into().expect("fixed version"));
+    if major != VERSION || minor != 0 {
+        return Err(FormatError::UnsupportedVersion {
+            format: FORMAT,
+            major,
+            minor,
+        });
+    }
+    if u32_at(bytes, 12) as usize != bytes.len() {
+        return Err(invalid("declared length"));
+    }
+    let run_count = u32_at(bytes, HEADER_LEN - 8) as usize;
+    let wal_count = u32_at(bytes, HEADER_LEN - 4) as usize;
+    if run_count > MAX_RUNS || wal_count > MAX_WAL_CHUNKS {
+        return Err(invalid("entry count exceeds hard cap"));
+    }
+    let expected = HEADER_LEN
+        .checked_add(
+            run_count
+                .checked_mul(RUN_LEN)
+                .ok_or_else(|| invalid("run count overflow"))?,
+        )
+        .and_then(|n| n.checked_add(wal_count.checked_mul(WAL_LEN)?))
+        .and_then(|n| n.checked_add(4))
+        .ok_or_else(|| invalid("entry count overflow"))?;
+    if expected != bytes.len() {
+        return Err(invalid("entry count or length"));
+    }
+    if crc32c::crc32c(&bytes[..bytes.len() - 4]) != u32_at(bytes, bytes.len() - 4) {
+        return Err(FormatError::ChecksumMismatch { format: FORMAT });
+    }
+    let mode = RemoteArchiveMode {
+        tenant: TenantId::from_bytes(bytes[16..32].try_into().expect("fixed mode")),
+        database: DatabaseId::from_bytes(bytes[32..48].try_into().expect("fixed mode")),
+        shard: ShardId::new(u64_at(bytes, 48)),
+        origin: OriginId {
+            replica_id: ReplicaId::from_bytes(bytes[56..72].try_into().expect("fixed mode")),
+            incarnation: bytes[72..88].try_into().expect("fixed mode"),
+        },
+        epoch: MembershipEpoch::new(u64_at(bytes, 88)),
+        configuration: bytes[96..128].try_into().expect("fixed mode"),
+    };
+    let source_generation = u64_at(bytes, 128);
+    let checkpoint = u64_at(bytes, 136);
+    let retry_floor_ms = u64_at(bytes, 144);
+    let frontier = u64_at(bytes, 152);
+    let view = RemoteArchiveManifest {
+        bytes,
+        mode,
+        source_generation,
+        checkpoint,
+        retry_floor_ms,
+        frontier,
+        runs: run_count,
+        wal: wal_count,
+    };
+    // This validation allocates only bounded temporary duplicate-key scratch.
+    let runs: Vec<_> = view.runs().collect();
+    let wal: Vec<_> = view.wal().collect();
+    validate(RemoteArchiveManifestInput {
+        mode,
+        source_generation,
+        checkpoint,
+        retry_floor_ms,
+        frontier,
+        runs: &runs,
+        wal: &wal,
+    })?;
+    Ok(view)
+}
