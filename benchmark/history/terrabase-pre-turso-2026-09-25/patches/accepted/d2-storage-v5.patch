+pub(crate) struct ArchiveIndex {
+    sequence: u64,
+    cut_id: [u8; 32],
+    source_generation: u64,
+    bytes: Vec<u8>,
+    manifest: ArchiveObjectRef,
+    frontier: ArchiveCandidateFrontier,
+    _permit: Reservation,
+}
