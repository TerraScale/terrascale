+pub(crate) enum ArchiveState {
+    NotApplicable,
+    Ready(Option<ArchiveIndex>),
+    Degraded,
+}
+
+impl ArchiveState {
+    pub(crate) fn progress(&self) -> ArchiveProgress {
+        match self {
+            Self::NotApplicable => ArchiveProgress::NotApplicable,
+            Self::Ready(None) => ArchiveProgress::NoCandidate,
+            Self::Ready(Some(index)) => ArchiveProgress::Candidate {
+                cut_id: index.cut_id,
+                frontier: index.frontier,
+                manifest: index.manifest.clone(),
+            },
+            Self::Degraded => ArchiveProgress::Degraded,
+        }
+    }
+
+    pub(crate) fn validate_recovered(
+        &mut self,
+        mode: RemoteArchiveMode,
+        visible: CommitSeq,
+        floor_ms: u64,
+    ) {
+        if let Self::Ready(Some(index)) = self {
+            let valid = decode_remote_archive_manifest(&index.bytes).is_ok_and(|manifest| {
+                manifest.mode() == mode
+                    && manifest.frontier() <= visible.get()
+                    && manifest.retry_floor_ms() <= floor_ms
+            });
+            if !valid {
+                *self = Self::Degraded;
+            }
+        }
+    }
+}
