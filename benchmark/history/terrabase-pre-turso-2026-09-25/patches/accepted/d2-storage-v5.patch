+                let mut digest = Sha256::new();
+                while remaining > 0 {
+                    let n = usize::try_from(remaining.min(scratch.len() as u64))
+                        .expect("bounded archive scratch");
+                    file.read_exact(&mut scratch[..n])?;
+                    digest.update(&scratch[..n]);
+                    remaining -= n as u64;
+                }
+                Ok(digest.finalize().into())
+            };
+            let directory_sha256 = hash_range(header.directory_offset, header.directory_len)?;
