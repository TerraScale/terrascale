+/// Read the immutable, shard-local archive destination binding. A recovered
+/// record is not usable until its directory entry has passed an fsync barrier.
+pub(crate) fn read_destination(directory: &Path) -> Result<Option<[u8; 32]>, StorageError> {
+    let mut file = match OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(directory.join(DESTINATION_NAME))
+    {
+        Ok(file) => file,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error.into()),
+    };
+    let metadata = file.metadata()?;
+    if !metadata.is_file() || metadata.nlink() != 1 || metadata.len() != DESTINATION_LEN as u64 {
+        return Err(corrupt("archive destination type or length"));
+    }
+    let mut bytes = [0_u8; DESTINATION_LEN];
+    file.read_exact(&mut bytes)?;
+    let mut trailing = [0_u8; 1];
+    if file.read(&mut trailing)? != 0 || file.metadata()?.len() != DESTINATION_LEN as u64 {
+        return Err(corrupt("archive destination length changed during read"));
+    }
+    let id: [u8; 32] = bytes[12..44].try_into().expect("fixed destination ID");
+    if &bytes[..8] != DESTINATION_MAGIC
+        || bytes[8..10] != 1_u16.to_le_bytes()
+        || bytes[10..12] != [0; 2]
+        || id == [0; 32]
+        || bytes[44..48] != crc32c::crc32c(&bytes[..44]).to_le_bytes()
+    {
+        return Err(corrupt("archive destination record"));
+    }
+    File::open(directory)?.sync_all()?;
+    Ok(Some(id))
+}
+
+/// First opt-in is allowed only after the caller has checked NoCandidate.
+/// Any failure after create_new leaves archive enablement uncertain until reopen.
+pub(crate) fn create_destination(directory: &Path, id: [u8; 32]) -> Result<(), StorageError> {
+    if id == [0; 32] {
+        return Err(corrupt("empty archive destination identity"));
+    }
+    let mut bytes = [0_u8; DESTINATION_LEN];
+    bytes[..8].copy_from_slice(DESTINATION_MAGIC);
+    bytes[8..10].copy_from_slice(&1_u16.to_le_bytes());
+    bytes[12..44].copy_from_slice(&id);
+    bytes[44..48].copy_from_slice(&crc32c::crc32c(&bytes[..44]).to_le_bytes());
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(directory.join(DESTINATION_NAME))?;
+    file.write_all(&bytes)?;
+    file.sync_all()?;
+    crate::crash_at("after_archive_destination_file_sync");
+    File::open(directory)?.sync_all()?;
+    crate::crash_at("after_archive_destination_directory_sync");
+    Ok(())
+}
+
+fn slot_path(directory: &Path, slot: u64) -> PathBuf {
+    directory.join(format!("archive.{slot}"))
+}
+
+fn canonical_object_ref(reference: &ArchiveObjectRef) -> Result<(), StorageError> {
+    let suffix = reference
+        .key
+        .strip_prefix("tb-objects/v1/")
+        .ok_or_else(|| corrupt("archive object key prefix"))?;
+    if reference.key.len() != OBJECT_KEY_LEN
+        || DocumentId::parse_canonical(suffix).is_err()
+        || reference.len == 0
+    {
+        return Err(corrupt("archive object identity"));
+    }
+    Ok(())
+}
+
+fn candidate_contains_key(candidate: &tb_format::RemoteArchiveManifest<'_>, key: &str) -> bool {
+    candidate
+        .runs()
+        .any(|run| run.segment.key == key || run.sidecar.key == key)
+        || candidate.wal().any(|entry| entry.object.key == key)
+}
+
+fn read_slot(
+    path: &Path,
+    slot: u64,
+    budget: &MemoryBudget,
+    attribution: Attribution,
+) -> Result<ArchiveIndex, StorageError> {
+    let mut file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(path)?;
+    let meta = file.metadata()?;
+    if !meta.is_file()
+        || meta.nlink() != 1
+        || meta.len() < (INDEX_HEADER + 4) as u64
+        || meta.len() > INDEX_MAX as u64
+    {
+        return Err(corrupt("archive index type or length"));
+    }
+    let len =
+        usize::try_from(meta.len()).map_err(|_| StorageError::Capacity("archive index length"))?;
+    // Covers the raw record, copied candidate, decoder vectors and key scratch.
+    let permit = budget.try_reserve(
+        attribution,
+        len.checked_mul(4)
+            .ok_or(StorageError::Capacity("archive index memory"))?,
+    )?;
+    let mut bytes = Vec::new();
+    bytes
+        .try_reserve_exact(len)
+        .map_err(|_| StorageError::Capacity("archive index memory"))?;
+    bytes.resize(len, 0);
+    file.read_exact(&mut bytes)?;
+    let mut trailing = [0_u8; 1];
+    if file.read(&mut trailing)? != 0 || file.metadata()?.len() != meta.len() {
+        return Err(corrupt("archive index length changed during read"));
+    }
+    if &bytes[..8] != INDEX_MAGIC
+        || bytes[8..10] != INDEX_VERSION.to_le_bytes()
+        || bytes[10..12] != [0; 2]
+    {
+        return Err(corrupt("archive index header"));
+    }
+    let sequence = u64::from_le_bytes(bytes[12..20].try_into().expect("fixed header"));
+    let inner_len = u32::from_le_bytes(bytes[20..24].try_into().expect("fixed header")) as usize;
+    if sequence == 0
+        || sequence % 2 != slot
+        || inner_len != bytes.len() - INDEX_HEADER - 4
+        || crc32c::crc32c(&bytes[..bytes.len() - 4])
+            != u32::from_le_bytes(bytes[bytes.len() - 4..].try_into().expect("fixed CRC"))
+    {
+        return Err(corrupt("archive index order, checksum or length"));
+    }
+    let cut_id: [u8; 32] = bytes[24..56].try_into().expect("fixed cut ID");
+    let key = std::str::from_utf8(&bytes[56..96])
+        .map_err(|_| corrupt("archive manifest key UTF-8"))?
+        .to_owned();
+    let manifest = ArchiveObjectRef {
+        key,
+        len: u64::from_le_bytes(bytes[96..104].try_into().expect("fixed length")),
+        sha256: bytes[104..136].try_into().expect("fixed digest"),
+    };
+    canonical_object_ref(&manifest)?;
+    let mut candidate = Vec::new();
+    candidate
+        .try_reserve_exact(inner_len)
+        .map_err(|_| StorageError::Capacity("archive candidate memory"))?;
+    candidate.extend_from_slice(&bytes[INDEX_HEADER..bytes.len() - 4]);
+    if manifest.len != candidate.len() as u64
+        || manifest.sha256 != Sha256::digest(&candidate).into()
+    {
+        return Err(corrupt("archive manifest object identity"));
+    }
+    let decoded = decode_remote_archive_manifest(&candidate)?;
+    if candidate_contains_key(&decoded, &manifest.key) {
+        return Err(corrupt("archive manifest key duplicates payload object"));
+    }
+    Ok(ArchiveIndex {
+        sequence,
+        cut_id,
+        source_generation: decoded.source_generation(),
+        frontier: ArchiveCandidateFrontier {
+            sequence: CommitSeq::new(decoded.frontier()),
+            retry_floor_ms: decoded.retry_floor_ms(),
+        },
+        bytes: candidate,
+        manifest,
+        _permit: permit,
+    })
+}
+
+pub(crate) fn load_index(
+    directory: &Path,
+    budget: &MemoryBudget,
+    attribution: Attribution,
+) -> ArchiveState {
+    let mut valid: [Option<ArchiveIndex>; 2] = [None, None];
+    let mut present = false;
+    for (slot, entry) in valid.iter_mut().enumerate() {
+        let path = slot_path(directory, slot as u64);
+        match std::fs::symlink_metadata(&path) {
+            Ok(_) => {
+                present = true;
+                match read_slot(&path, slot as u64, budget, attribution) {
+                    Ok(record) => *entry = Some(record),
+                    Err(
+                        StorageError::Corrupt(_)
+                        | StorageError::Format(
+                            tb_format::FormatError::Truncated { .. }
+                            | tb_format::FormatError::Invalid { .. }
+                            | tb_format::FormatError::UnsupportedVersion { .. }
+                            | tb_format::FormatError::LimitExceeded { .. }
+                            | tb_format::FormatError::ChecksumMismatch { .. }
+                            | tb_format::FormatError::InvalidCommitMarker
+                            | tb_format::FormatError::Compression,
+                        ),
+                    ) => {}
+                    Err(_) => return ArchiveState::Degraded,
+                }
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(_) => return ArchiveState::Degraded,
+        }
+    }
+    let selected = match (valid[0].take(), valid[1].take()) {
+        (Some(a), Some(b)) => {
+            let (older, newer) = if a.sequence < b.sequence {
+                (a, b)
+            } else {
+                (b, a)
+            };
+            let source_order_ok = match (
+                decode_remote_archive_manifest(&older.bytes),
+                decode_remote_archive_manifest(&newer.bytes),
+            ) {
+                (Ok(old), Ok(new)) => {
+                    old.mode() == new.mode()
+                        && old.checkpoint() <= new.checkpoint()
+                        && old.source_generation() <= new.source_generation()
+                }
+                _ => false,
+            };
+            if older.sequence.checked_add(1) != Some(newer.sequence)
+                || older.frontier.sequence > newer.frontier.sequence
+                || older.frontier.retry_floor_ms > newer.frontier.retry_floor_ms
+                || !source_order_ok
+            {
+                return ArchiveState::Degraded;
+            }
+            Some(newer)
+        }
+        (Some(a), None) | (None, Some(a)) => Some(a),
+        (None, None) => None,
+    };
+    if selected.is_some() {
+        // A recovered rename is not reported as durable progress until its
+        // directory entry itself has passed the fsync barrier.
+        if File::open(directory)
+            .and_then(|file| file.sync_all())
+            .is_err()
+        {
+            return ArchiveState::Degraded;
+        }
+        return ArchiveState::Ready(selected);
+    }
+    if present || directory.join(INDEX_PENDING).exists() {
+        ArchiveState::Degraded
+    } else {
+        ArchiveState::Ready(None)
+    }
+}
+
+#[allow(
+    clippy::too_many_arguments,
+    reason = "the index write binds one candidate and one verified object identity"
+)]
+fn publish_index(
+    directory: &Path,
+    old: Option<&ArchiveIndex>,
+    candidate: &ArchiveCandidate,
+    manifest: &ArchiveObjectRef,
+    frontier: ArchiveCandidateFrontier,
+    source_generation: u64,
+    budget: &MemoryBudget,
+    attribution: Attribution,
+) -> Result<ArchiveIndex, StorageError> {
+    let sequence = old.map_or(1, |record| record.sequence.checked_add(1).unwrap_or(0));
+    if sequence == 0 {
+        return Err(StorageError::Capacity("archive index sequence"));
+    }
+    let encoded_len = INDEX_HEADER
+        .checked_add(candidate.bytes.len())
+        .and_then(|n| n.checked_add(4))
+        .ok_or(StorageError::Capacity("archive index length"))?;
+    let permit = budget.try_reserve(
+        attribution,
+        encoded_len
+            .checked_mul(4)
+            .ok_or(StorageError::Capacity("archive index memory"))?,
+    )?;
+    let pending = directory.join(INDEX_PENDING);
+    if pending.exists() {
+        let meta = std::fs::symlink_metadata(&pending)?;
+        if !meta.is_file() || meta.nlink() != 1 {
+            return Err(corrupt("archive pending type"));
+        }
+        std::fs::remove_file(&pending)?;
+        File::open(directory)?.sync_all()?;
+    }
+    let mut encoded = Vec::new();
+    encoded
+        .try_reserve_exact(encoded_len)
+        .map_err(|_| StorageError::Capacity("archive index memory"))?;
+    encoded.extend_from_slice(INDEX_MAGIC);
+    encoded.extend_from_slice(&INDEX_VERSION.to_le_bytes());
+    encoded.extend_from_slice(&0_u16.to_le_bytes());
+    encoded.extend_from_slice(&sequence.to_le_bytes());
+    encoded.extend_from_slice(
+        &u32::try_from(candidate.bytes.len())
+            .map_err(|_| StorageError::Capacity("archive index length"))?
+            .to_le_bytes(),
+    );
+    encoded.extend_from_slice(&candidate.cut_id);
+    encoded.extend_from_slice(manifest.key.as_bytes());
+    encoded.extend_from_slice(&manifest.len.to_le_bytes());
+    encoded.extend_from_slice(&manifest.sha256);
+    encoded.extend_from_slice(&candidate.bytes);
+    encoded.extend_from_slice(&crc32c::crc32c(&encoded).to_le_bytes());
+    debug_assert_eq!(encoded.len(), encoded_len);
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(&pending)?;
+    file.write_all(&encoded)?;
+    file.sync_all()?;
+    crate::crash_at("after_archive_index_pending_sync");
+    std::fs::rename(&pending, slot_path(directory, sequence % 2))?;
+    crate::crash_at("after_archive_index_rename_before_directory_sync");
+    File::open(directory)?.sync_all()?;
+    crate::crash_at("after_archive_index_directory_sync");
+    let mut bytes = Vec::new();
+    bytes
+        .try_reserve_exact(candidate.bytes.len())
+        .map_err(|_| StorageError::Capacity("archive candidate memory"))?;
+    bytes.extend_from_slice(&candidate.bytes);
+    Ok(ArchiveIndex {
+        sequence,
+        cut_id: candidate.cut_id,
+        source_generation,
+        bytes,
+        manifest: manifest.clone(),
+        frontier,
+        _permit: permit,
+    })
+}
+
+impl ArchiveState {
+    #[allow(
+        clippy::too_many_arguments,
+        reason = "completion checks and publishes one exact local candidate"
+    )]
+    pub(crate) fn complete(
+        &mut self,
+        directory: &Path,
+        cut: &ArchiveCut,
+        candidate: &ArchiveCandidate,
+        manifest: ArchiveObjectRef,
+        budget: &MemoryBudget,
+        attribution: Attribution,
+    ) -> Result<ArchiveCandidateFrontier, StorageError> {
+        let Self::Ready(current) = self else {
+            return Err(corrupt("archive index is degraded"));
+        };
+        if candidate.cut_id != cut.id
+            || candidate.instance != cut.instance
+            || cut.failed
+            || cut.exported_through != cut.frontier
+            || candidate.sha256 != Sha256::digest(&candidate.bytes).into()
+            || manifest.len != candidate.bytes.len() as u64
+            || manifest.sha256 != candidate.sha256
+        {
+            return Err(corrupt("archive candidate or readback identity mismatch"));
+        }
+        canonical_object_ref(&manifest)?;
+        let decoded = decode_remote_archive_manifest(&candidate.bytes)?;
+        if candidate_contains_key(&decoded, &manifest.key) {
+            return Err(corrupt("archive manifest key duplicates payload object"));
+        }
+        if decoded.mode() != cut.mode
+            || decoded.source_generation() != cut.source_generation
+            || decoded.checkpoint() != cut.checkpoint.get()
+            || decoded.frontier() != cut.frontier.get()
+            || decoded.retry_floor_ms() != cut.floor_ms
+            || decoded.run_count() != cut.runs.len()
+            || decoded.wal_count() != cut.chunks.len()
+        {
+            return Err(corrupt("archive candidate differs from captured cut"));
+        }
+        let next = ArchiveCandidateFrontier {
+            sequence: cut.frontier,
+            retry_floor_ms: cut.floor_ms,
+        };
+        if let Some(old) = current.as_ref() {
+            if next.sequence < old.frontier.sequence
+                || next.retry_floor_ms < old.frontier.retry_floor_ms
+            {
+                return Err(corrupt("archive candidate frontier regression"));
+            }
+            let old_manifest = decode_remote_archive_manifest(&old.bytes)?;
+            if decoded.checkpoint() < old_manifest.checkpoint()
+                || decoded.source_generation() < old.source_generation
+            {
+                return Err(corrupt("archive candidate source regression"));
+            }
+            if next.sequence == old.frontier.sequence {
+                if candidate.cut_id == old.cut_id {
+                    if candidate.bytes == old.bytes && manifest == old.manifest {
+                        File::open(directory)?.sync_all()?;
+                        return Ok(old.frontier);
+                    }
+                    return Err(corrupt("archive candidate references changed for same cut"));
+                }
+                if decoded.source_generation() == old.source_generation
+                    && next.retry_floor_ms == old.frontier.retry_floor_ms
+                {
+                    return Err(corrupt(
+                        "archive candidate changed without frontier progress",
+                    ));
+                }
+            }
+        }
+        match publish_index(
+            directory,
+            current.as_ref(),
+            candidate,
+            &manifest,
+            next,
+            cut.source_generation,
+            budget,
+            attribution,
+        ) {
+            Ok(record) => {
+                *current = Some(record);
+                Ok(next)
+            }
+            Err(error) => {
+                *self = load_index(directory, budget, attribution);
+                Err(error)
+            }
+        }
+    }
+}
