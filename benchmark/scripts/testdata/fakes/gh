#!/usr/bin/env bash
# Fake gh: repository variables as files in $FAKE_DIR/vars.
echo "gh $*" >> "$FAKE_LOG"
mkdir -p "$FAKE_DIR/vars"
case "$1 $2" in
  "auth status") exit 0 ;;
  "variable get") [[ -f "$FAKE_DIR/vars/$3" ]] && cat "$FAKE_DIR/vars/$3" || exit 1 ;;
  "variable set") name=$3; shift 3; while [[ $# -gt 0 ]]; do [[ $1 == --body ]] && printf '%s' "$2" > "$FAKE_DIR/vars/$name"; shift; done ;;
  "variable delete") rm -f "$FAKE_DIR/vars/$3" ;;
  *) echo "fake gh: unexpected $*" >&2; exit 2 ;;
esac
