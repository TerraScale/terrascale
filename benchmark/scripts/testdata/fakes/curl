#!/usr/bin/env bash
# Fake curl for gru's internal listener: logs "METHOD path" (never bodies) and answers like TerraBase.
printf 'curl argv:' >> "$FAKE_LOG"
printf ' %s' "$@" >> "$FAKE_LOG"
printf '\n' >> "$FAKE_LOG"
[[ $1 == -q && " $* " == *" --max-redirs 0 "* && " $* " != *" -L "* ]] || { echo "curl must disable config and redirects" >&2; exit 22; }
method=GET url="" data="" peer_header=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -X) method=$2; shift ;;
    -d) data=$2; shift ;;
    -H) [[ $2 == @* ]] && peer_header=${2#@}; shift ;;
    -o) shift ;;
    http*) url=$1 ;;
  esac
  shift
done
[[ -f "$peer_header" && $(stat -c %a "$peer_header") == 600 && $(cat "$peer_header") == "X-TerraBase-Peer-Credential: $TERRABASE_PEER_SECRET" ]] || { echo "unauthenticated internal request" >&2; exit 22; }
path=${url#http://127.0.0.1:*/}
path=/${path}
echo "curl $method $path" >> "$FAKE_LOG"
case "$method $path" in
  "GET /") exit 0 ;;
  "POST /v1/management/commits") echo '{"commit":"ok"}' ;;
  "POST /admin/api-keys")
    n=$(( $(cat "$FAKE_DIR/keys" 2> /dev/null || echo 0) + 1 )); echo "$n" > "$FAKE_DIR/keys"
    printf '{"id":"01KEY%021d","secret":"%s-%d","scopes":["documents:read","documents:write"]}' "$n" "$FAKE_SECRET" "$n" ;;
  "GET /v1/management/organizations/"*/api-keys) printf '{"items":[{"id":"%s"}],"next":null}' "$(cat "$FAKE_DIR/vars/TS_BENCH_FLY_KEY_ID" 2> /dev/null)" ;;
  "DELETE /v1/management/organizations/"*/api-keys/*) ;;
  "GET /v1/projects/"*/databases/bench/collections) echo '{"items":[{"name":"bench-01aa"},{"name":"keep-me"},{"name":"bench-01bb"}],"next_cursor":null}' ;;
  "DELETE /v1/projects/"*/databases/bench/collections/*) ;;
  *) echo "fake curl: unexpected $method $path" >&2; exit 22 ;;
esac
