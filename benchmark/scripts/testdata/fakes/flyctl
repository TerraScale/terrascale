#!/usr/bin/env bash
# Fake flyctl for tenant_script_test.go: logs its arguments, keeps "Fly" state in $FAKE_DIR.
echo "flyctl $*" >> "$FAKE_LOG"
case "$1 $2" in
  "auth whoami") echo me@example.com ;;
  "dig AAAA") echo fdaa::1 ;;
  "proxy "*) exec sleep 300 ;;
  "apps list") if [[ -f "$FAKE_DIR/app" ]]; then echo '[{"Name":"ts-bench"}]'; else echo '[]'; fi ;;
  "apps create") touch "$FAKE_DIR/app" ;;
  "secrets import") cat > "$FAKE_DIR/fly-secrets" ;;
  "secrets list") if [[ -f "$FAKE_DIR/fly-secrets" ]]; then echo '[{"Name":"TS_BENCH_API_KEY","Digest":"d1g3st","Status":"Staged"}]'; else echo '[]'; fi ;;
  "secrets unset") rm -f "$FAKE_DIR/fly-secrets" ;;
  *) echo "fake flyctl: unexpected $*" >&2; exit 2 ;;
esac
