<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TerraBase</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>preview</LangVersion>
    <AckWaiterSource Condition="'$(AckWaiterSource)' == ''">$(MSBuildThisFileDirectory)../../../src/TerraBase/Features/Replication/RemoteAckWaiter.cs</AckWaiterSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ulid" />
    <Compile Include="../../../src/TerraBase/Features/Replication/RemoteDurability.cs" Link="RemoteDurability.cs" />
    <Compile Include="../../../src/TerraBase/Engine/CommitResult.cs" Link="CommitResult.cs" />
    <Compile Include="../../../src/TerraBase/Engine/Lattices/ReplicaId.cs" Link="ReplicaId.cs" />
    <Compile Include="../../../src/TerraBase/Tenancy/TenantContext.cs" Link="TenantContext.cs" />
    <Compile Include="$(AckWaiterSource)" Link="RemoteAckWaiter.cs" />
  </ItemGroup>
</Project>
