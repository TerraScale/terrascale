FROM gcr.io/distroless/cc-debian12@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f

ARG TERRABASE_VERSION
ARG TERRABASE_REVISION
ARG TERRABASE_CREATED
ARG TERRABASE_BINARY_SHA256

LABEL org.opencontainers.image.title="TerraBase Studio" \
      org.opencontainers.image.description="Loopback-only TerraBase operator UI" \
      org.opencontainers.image.version="${TERRABASE_VERSION}" \
      org.opencontainers.image.revision="${TERRABASE_REVISION}" \
      org.opencontainers.image.created="${TERRABASE_CREATED}" \
      org.opencontainers.image.source="https://git.terrascale.tech/TerraScale/TerraBase" \
      org.opencontainers.image.licenses="MIT" \
      tech.terrascale.terrabase.base="gcr.io/distroless/cc-debian12@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f" \
      tech.terrascale.terrabase.binary.sha256="${TERRABASE_BINARY_SHA256}"

COPY --chown=65532:65532 rootfs/ /

USER 65532:65532
WORKDIR /var/lib/terrabase-studio
ENTRYPOINT ["/usr/local/bin/terrabase-studio"]
