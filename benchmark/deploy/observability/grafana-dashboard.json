{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Private TerraBase Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {"list": []},
  "description": "Traffic, latency, durability, replication, health, SLO burn, and egress for one TerraBase deployment.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Minimum readiness across every selected TerraBase target.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"color": "red", "text": "Not ready"}, "1": {"color": "green", "text": "Ready"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "11.0.0",
      "targets": [{"expr": "min(terrabase_ready{job=~\"$job\"})", "instant": true, "refId": "A"}],
      "title": "Readiness",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Completed requests per second. Prometheus derives this from the cumulative request counter.",
      "fieldConfig": {"defaults": {"decimals": 2, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "pluginVersion": "11.0.0",
      "targets": [{"expr": "sum(rate(terrabase_requests_total{job=~\"$job\",region=~\"$region\",operation=~\"$operation\"}[$__rate_interval]))", "instant": true, "refId": "A"}],
      "title": "Requests / second",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Errors and timeouts as a percentage of non-rejected completed requests. Rejections remain separate and are not unavailable under D-75.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "max": 100,
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "pluginVersion": "11.0.0",
      "targets": [{"expr": "100 * sum(rate(terrabase_requests_total{job=~\"$job\",region=~\"$region\",operation=~\"$operation\",outcome=~\"error|timeout\"}[$__rate_interval])) / clamp_min(sum(rate(terrabase_requests_total{job=~\"$job\",region=~\"$region\",operation=~\"$operation\",outcome!=\"rejected\"}[$__rate_interval])), 0.000000001)", "instant": true, "refId": "A"}],
      "title": "Errors + timeouts",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "p99 latency for successful requests in the selected Region and operation set.",
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.01}, {"color": "red", "value": 0.05}]},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "pluginVersion": "11.0.0",
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(terrabase_request_duration_seconds_bucket{job=~\"$job\",region=~\"$region\",operation=~\"$operation\",outcome=\"success\"}[$__rate_interval])))", "instant": true, "refId": "A"}],
      "title": "Successful request p99",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Completed request rate split by bounded operation family.",
      "fieldConfig": {"defaults": {"decimals": 2, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (operation) (rate(terrabase_requests_total{job=~\"$job\",region=~\"$region\",operation=~\"$operation\"}[$__rate_interval]))", "legendFormat": "{{operation}}", "refId": "A"}],
      "title": "Requests / second by operation",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Completed request rate split by outcome. Rejections, timeouts, and engine errors remain distinct.",
      "fieldConfig": {"defaults": {"decimals": 2, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (outcome) (rate(terrabase_requests_total{job=~\"$job\",region=~\"$region\",operation=~\"$operation\"}[$__rate_interval]))", "legendFormat": "{{outcome}}", "refId": "A"}],
      "title": "Requests / second by outcome",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Latency percentiles for successful requests. All three derive from the same fixed histogram buckets.",
      "fieldConfig": {"defaults": {"decimals": 3, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 9,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(terrabase_request_duration_seconds_bucket{job=~\"$job\",region=~\"$region\",operation=~\"$operation\",outcome=\"success\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(terrabase_request_duration_seconds_bucket{job=~\"$job\",region=~\"$region\",operation=~\"$operation\",outcome=\"success\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(terrabase_request_duration_seconds_bucket{job=~\"$job\",region=~\"$region\",operation=~\"$operation\",outcome=\"success\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "C"}
      ],
      "title": "Successful request latency percentiles",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Successful request p99 split by Region and operation to expose a localized slow path.",
      "fieldConfig": {"defaults": {"decimals": 3, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 10,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le, region, operation) (rate(terrabase_request_duration_seconds_bucket{job=~\"$job\",region=~\"$region\",operation=~\"$operation\",outcome=\"success\"}[$__rate_interval])))", "legendFormat": "{{region}} / {{operation}}", "refId": "A"}],
      "title": "p99 by Region and operation",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Minimum health across selected targets. Healthy is 1, degraded is 0.5, unhealthy is 0, and unknown is -1.",
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "max": 1,
          "min": -1,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.5}, {"color": "green", "value": 1}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 28},
      "id": 16,
      "options": {"legend": {"calcs": ["lastNotNull", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "asc"}},
      "targets": [{"expr": "min by (component) (terrabase_component_health{job=~\"$job\"})", "legendFormat": "{{component}}", "refId": "A"}],
      "title": "Component health",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Admission refusals by bounded reason. This is distinct from completed request outcomes.",
      "fieldConfig": {"defaults": {"decimals": 2, "min": 0, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 36},
      "id": 19,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (operation, reason) (rate(terrabase_admission_rejections_total{job=~\"$job\",operation=~\"$operation\"}[$__rate_interval]))", "legendFormat": "{{operation}} / {{reason}}", "refId": "A"}],
      "title": "Admission rejections / second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Commit attempts split into committed, refused, failed, and indeterminate outcomes.",
      "fieldConfig": {"defaults": {"decimals": 2, "min": 0, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 44},
      "id": 20,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (outcome) (rate(terrabase_commits_total{job=~\"$job\"}[$__rate_interval]))", "legendFormat": "{{outcome}}", "refId": "A"}],
      "title": "Commit outcomes / second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "End-to-end durability latency for successfully committed work.",
      "fieldConfig": {"defaults": {"decimals": 3, "min": 0, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 44},
      "id": 21,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(terrabase_commit_duration_seconds_bucket{job=~\"$job\",outcome=\"committed\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "A"}],
      "title": "Committed durability p99",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Verified frontier health. Healthy is 1, degraded is 0.5, unhealthy is 0, and unknown is -1.",
      "fieldConfig": {"defaults": {"decimals": 1, "max": 1, "min": -1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.5}, {"color": "green", "value": 1}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 52},
      "id": 24,
      "options": {"legend": {"calcs": ["lastNotNull", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "asc"}},
      "targets": [{"expr": "min by (region) (terrabase_replication_frontier_health{job=~\"$job\",region=~\"$region\"})", "legendFormat": "{{region}}", "refId": "A"}],
      "title": "Replication frontier health",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Latest durable sequence frontier published by the authoritative usage exporter.",
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 68},
      "id": 31,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "max(terrabase_usage_export_frontier{job=~\"$job\"})", "legendFormat": "frontier", "refId": "A"}],
      "title": "Usage export frontier",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Failures per second while publishing authoritative usage facts.",
      "fieldConfig": {"defaults": {"decimals": 3, "min": 0, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 68},
      "id": 32,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum(rate(terrabase_usage_export_failures_total{job=~\"$job\"}[$__rate_interval]))", "legendFormat": "failures / second", "refId": "A"}],
      "title": "Usage export failures / second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Dashboard-only request-error burn proxy from local request counters.",
      "fieldConfig": {"defaults": {"decimals": 2, "min": 0, "unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 6}]}} , "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 76},
      "id": 33,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "terrabase:slo:api_burn_rate:5m{job=~\"$job\",region=~\"$region\"}", "legendFormat": "5m", "refId": "A"},
        {"expr": "terrabase:slo:api_burn_rate:30m{job=~\"$job\",region=~\"$region\"}", "legendFormat": "30m", "refId": "B"},
        {"expr": "terrabase:slo:api_burn_rate:1h{job=~\"$job\",region=~\"$region\"}", "legendFormat": "1h", "refId": "C"},
        {"expr": "terrabase:slo:api_burn_rate:6h{job=~\"$job\",region=~\"$region\"}", "legendFormat": "6h", "refId": "D"}
      ],
      "title": "API error-budget burn (dashboard)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Projected monthly billable OCI egress as a percentage of 8 TB per Region. The projection uses 720 hours per month; CDN delivery is excluded.",
      "fieldConfig": {"defaults": {"decimals": 1, "max": 100, "min": 0, "unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 100}]}} , "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 76},
      "id": 34,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "100 * sum by (region) (increase(terrabase_egress_bytes_total{job=~\"$job\",region=~\"$region\"}[1h])) * 720 / 8000000000000", "legendFormat": "{{region}}", "refId": "A"}],
      "title": "Projected monthly egress by Region",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Signed host clock offset in seconds from the engine-fed NTP observation. A missing series is unknown, not zero.",
      "fieldConfig": {"defaults": {"decimals": 3, "unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.4}, {"color": "red", "value": 0.5}]}} , "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 84},
      "id": 35,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "terrabase_clock_offset_seconds{job=~\"$job\"}", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Host clock offset",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Rate of origin writes refused because the host clock observation exceeded 0.5 seconds in magnitude. Dashboard-only cause signal.",
      "fieldConfig": {"defaults": {"decimals": 3, "min": 0, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 84},
      "id": 36,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (job, instance) (rate(terrabase_clock_write_refusals_total{job=~\"$job\"}[$__rate_interval]))", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Clock write refusals / second",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["terrabase", "operations", "prometheus"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "definition": "label_values(terrabase_requests_total, job)",
        "hide": 0,
        "includeAll": false,
        "label": "Deployment job",
        "multi": false,
        "name": "job",
        "options": [],
        "query": {"query": "label_values(terrabase_requests_total, job)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "definition": "label_values(terrabase_requests_total{job=~\"$job\"}, region)",
        "hide": 0,
        "includeAll": true,
        "label": "Region",
        "multi": true,
        "name": "region",
        "options": [],
        "query": {"query": "label_values(terrabase_requests_total{job=~\"$job\"}, region)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "definition": "label_values(terrabase_requests_total{job=~\"$job\",region=~\"$region\"}, operation)",
        "hide": 0,
        "includeAll": true,
        "label": "Operation",
        "multi": true,
        "name": "operation",
        "options": [],
        "query": {"query": "label_values(terrabase_requests_total{job=~\"$job\",region=~\"$region\"}, operation)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {"refresh_intervals": ["5s", "15s", "30s", "1m", "5m"]},
  "timezone": "utc",
  "title": "TerraBase operations",
  "uid": "terrabase-operations",
  "version": 3
}
