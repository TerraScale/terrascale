{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Private TerraBase Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {"list": []},
  "description": "Traffic, latency, storage, replication, membership, and health for one TerraBase deployment.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Minimum readiness across every selected TerraBase target.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"color": "red", "text": "Not ready"}, "1": {"color": "green", "text": "Ready"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "11.0.0",
      "targets": [{"expr": "min(terrabase_ready{job=~\"$job\"})", "instant": true, "refId": "A"}],
      "title": "Readiness",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Completed requests per second. Prometheus derives this from the cumulative request counter.",
      "fieldConfig": {"defaults": {"decimals": 2, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "pluginVersion": "11.0.0",
      "targets": [{"expr": "sum(rate(terrabase_requests_total{job=~\"$job\",region=~\"$region\",operation=~\"$operation\"}[$__rate_interval]))", "instant": true, "refId": "A"}],
      "title": "Requests / second",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Errors and timeouts as a percentage of completed requests. Rejections remain separate.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "max": 100,
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "pluginVersion": "11.0.0",
      "targets": [{"expr": "100 * sum(rate(terrabase_requests_total{job=~\"$job\",region=~\"$region\",operation=~\"$operation\",outcome=~\"error|timeout\"}[$__rate_interval])) / clamp_min(sum(rate(terrabase_requests_total{job=~\"$job\",region=~\"$region\",operation=~\"$operation\"}[$__rate_interval])), 0.000000001)", "instant": true, "refId": "A"}],
      "title": "Errors + timeouts",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "p99 latency for successful requests in the selected Region and operation set.",
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.01}, {"color": "red", "value": 0.05}]},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "pluginVersion": "11.0.0",
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(terrabase_request_duration_seconds_bucket{job=~\"$job\",region=~\"$region\",operation=~\"$operation\",outcome=\"success\"}[$__rate_interval])))", "instant": true, "refId": "A"}],
      "title": "Successful request p99",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Current bytes across every bounded storage tier and selected Member target.",
      "fieldConfig": {"defaults": {"decimals": 1, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "pluginVersion": "11.0.0",
      "targets": [{"expr": "sum(terrabase_storage_bytes{job=~\"$job\"})", "instant": true, "refId": "A"}],
      "title": "Storage used",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Highest utilization among tiers with a finite reported capacity.",
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "max": 100,
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "id": 6,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "11.0.0",
      "targets": [{"expr": "max(100 * terrabase_storage_bytes{job=~\"$job\"} / clamp_min(terrabase_storage_capacity_bytes{job=~\"$job\"}, 1))", "instant": true, "refId": "A"}],
      "title": "Highest storage utilization",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Completed request rate split by bounded operation family.",
      "fieldConfig": {"defaults": {"decimals": 2, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (operation) (rate(terrabase_requests_total{job=~\"$job\",region=~\"$region\",operation=~\"$operation\"}[$__rate_interval]))", "legendFormat": "{{operation}}", "refId": "A"}],
      "title": "Requests / second by operation",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Completed request rate split by outcome. Rejections, timeouts, and engine errors remain distinct.",
      "fieldConfig": {"defaults": {"decimals": 2, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (outcome) (rate(terrabase_requests_total{job=~\"$job\",region=~\"$region\",operation=~\"$operation\"}[$__rate_interval]))", "legendFormat": "{{outcome}}", "refId": "A"}],
      "title": "Requests / second by outcome",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Latency percentiles for successful requests. All three derive from the same fixed histogram buckets.",
      "fieldConfig": {"defaults": {"decimals": 3, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 9,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(terrabase_request_duration_seconds_bucket{job=~\"$job\",region=~\"$region\",operation=~\"$operation\",outcome=\"success\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(terrabase_request_duration_seconds_bucket{job=~\"$job\",region=~\"$region\",operation=~\"$operation\",outcome=\"success\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(terrabase_request_duration_seconds_bucket{job=~\"$job\",region=~\"$region\",operation=~\"$operation\",outcome=\"success\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "C"}
      ],
      "title": "Successful request latency percentiles",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Successful request p99 split by Region and operation to expose a localized slow path.",
      "fieldConfig": {"defaults": {"decimals": 3, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 10,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le, region, operation) (rate(terrabase_request_duration_seconds_bucket{job=~\"$job\",region=~\"$region\",operation=~\"$operation\",outcome=\"success\"}[$__rate_interval])))", "legendFormat": "{{region}} / {{operation}}", "refId": "A"}],
      "title": "p99 by Region and operation",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Measured bytes summed across selected Member targets and split by storage tier.",
      "fieldConfig": {"defaults": {"decimals": 1, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 20},
      "id": 11,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (tier) (terrabase_storage_bytes{job=~\"$job\"})", "legendFormat": "{{tier}}", "refId": "A"}],
      "title": "Storage usage by tier",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Used bytes divided by finite configured capacity. An absent tier has unknown or unbounded capacity.",
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "max": 100,
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 20},
      "id": 12,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "100 * sum by (tier) (terrabase_storage_bytes{job=~\"$job\"}) / clamp_min(sum by (tier) (terrabase_storage_capacity_bytes{job=~\"$job\"}), 1)", "legendFormat": "{{tier}}", "refId": "A"}],
      "title": "Storage utilization by tier",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Current storage minus the value 24 hours earlier. Positive is growth and negative is reclamation.",
      "fieldConfig": {"defaults": {"decimals": 1, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 20},
      "id": 13,
      "options": {"legend": {"calcs": ["lastNotNull", "max", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (tier) (terrabase_storage_bytes{job=~\"$job\"}) - sum by (tier) (terrabase_storage_bytes{job=~\"$job\"} offset 24h)", "legendFormat": "{{tier}}", "refId": "A"}],
      "title": "Storage change over 24 hours",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Maximum observed replication lag for each Region across selected Member targets.",
      "fieldConfig": {"defaults": {"decimals": 3, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 28},
      "id": 14,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "max by (region) (terrabase_replication_lag_seconds{job=~\"$job\",region=~\"$region\"})", "legendFormat": "{{region}}", "refId": "A"}],
      "title": "Replication lag by Region",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Maximum admitted topology observation per Region. Confirm topology before treating a count as quorum loss.",
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 28},
      "id": 15,
      "options": {"legend": {"calcs": ["lastNotNull", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "asc"}},
      "targets": [{"expr": "max by (region) (terrabase_active_members{job=~\"$job\",region=~\"$region\"})", "legendFormat": "{{region}}", "refId": "A"}],
      "title": "Active Members by Region",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Minimum health across selected targets. Healthy is 1, degraded is 0.5, unhealthy is 0, and unknown is -1.",
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "max": 1,
          "min": -1,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.5}, {"color": "green", "value": 1}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 28},
      "id": 16,
      "options": {"legend": {"calcs": ["lastNotNull", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "asc"}},
      "targets": [{"expr": "min by (component) (terrabase_component_health{job=~\"$job\"})", "legendFormat": "{{component}}", "refId": "A"}],
      "title": "Component health",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Current admitted operations that have not completed.",
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 36},
      "id": 17,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (operation) (terrabase_in_flight_operations{job=~\"$job\",operation=~\"$operation\"})", "legendFormat": "{{operation}}", "refId": "A"}],
      "title": "In-flight operations",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Queue depth divided by configured queue capacity.",
      "fieldConfig": {"defaults": {"decimals": 1, "max": 100, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 95}]}, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 36},
      "id": 18,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "100 * terrabase_queue_depth{job=~\"$job\"} / clamp_min(terrabase_queue_capacity{job=~\"$job\"}, 1)", "legendFormat": "{{queue}}", "refId": "A"}],
      "title": "Queue utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Admission refusals by bounded reason. This is distinct from completed request outcomes.",
      "fieldConfig": {"defaults": {"decimals": 2, "min": 0, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 36},
      "id": 19,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (operation, reason) (rate(terrabase_admission_rejections_total{job=~\"$job\",operation=~\"$operation\"}[$__rate_interval]))", "legendFormat": "{{operation}} / {{reason}}", "refId": "A"}],
      "title": "Admission rejections / second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Commit attempts split into committed, refused, failed, and indeterminate outcomes.",
      "fieldConfig": {"defaults": {"decimals": 2, "min": 0, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 44},
      "id": 20,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (outcome) (rate(terrabase_commits_total{job=~\"$job\"}[$__rate_interval]))", "legendFormat": "{{outcome}}", "refId": "A"}],
      "title": "Commit outcomes / second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "End-to-end durability latency for successfully committed work.",
      "fieldConfig": {"defaults": {"decimals": 3, "min": 0, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 44},
      "id": 21,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(terrabase_commit_duration_seconds_bucket{job=~\"$job\",outcome=\"committed\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "A"}],
      "title": "Committed durability p99",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "p99 WAL fsync latency for successful synchronization attempts.",
      "fieldConfig": {"defaults": {"decimals": 3, "min": 0, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 44},
      "id": 22,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(terrabase_wal_fsync_duration_seconds_bucket{job=~\"$job\",outcome=\"success\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "A"}],
      "title": "WAL fsync p99",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Bytes waiting for replication or repair delivery by Region.",
      "fieldConfig": {"defaults": {"decimals": 1, "min": 0, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 52},
      "id": 23,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "max by (region) (terrabase_replication_backlog_bytes{job=~\"$job\",region=~\"$region\"})", "legendFormat": "{{region}}", "refId": "A"}],
      "title": "Replication backlog by Region",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Verified frontier health. Healthy is 1, degraded is 0.5, unhealthy is 0, and unknown is -1.",
      "fieldConfig": {"defaults": {"decimals": 1, "max": 1, "min": -1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.5}, {"color": "green", "value": 1}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 52},
      "id": 24,
      "options": {"legend": {"calcs": ["lastNotNull", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "asc"}},
      "targets": [{"expr": "min by (region) (terrabase_replication_frontier_health{job=~\"$job\",region=~\"$region\"})", "legendFormat": "{{region}}", "refId": "A"}],
      "title": "Replication frontier health",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Storage operation errors split by tier and bounded operation.",
      "fieldConfig": {"defaults": {"decimals": 3, "min": 0, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 52},
      "id": 25,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (tier, operation) (rate(terrabase_storage_errors_total{job=~\"$job\"}[$__rate_interval]))", "legendFormat": "{{tier}} / {{operation}}", "refId": "A"}],
      "title": "Storage errors / second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Bytes waiting for compaction by storage tier.",
      "fieldConfig": {"defaults": {"decimals": 1, "min": 0, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 60},
      "id": 26,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (tier) (terrabase_compaction_backlog_bytes{job=~\"$job\"})", "legendFormat": "{{tier}}", "refId": "A"}],
      "title": "Compaction backlog",
      "type": "timeseries"
    },
    {
