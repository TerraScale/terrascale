+//! Publication-journal catch-up interfaces.
+
+/// The operation represented by a publication-journal row.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum JournalOperation {
+    /// Insert or replace the canonical document bytes.
+    Upsert,
+    /// Remove the document; `value` is empty and must not resurrect it.
+    Delete,
+}
+
+/// One journal operation in the moved key range.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct JournalEntry {
+    sequence: u64,
+    key: Vec<u8>,
+    value: Vec<u8>,
+    operation: JournalOperation,
+}
+
+impl JournalEntry {
+    /// Creates a journal entry containing opaque canonical bytes.
+    #[must_use]
+    pub fn new(sequence: u64, key: Vec<u8>, value: Vec<u8>) -> Self {
+        Self { sequence, key, value, operation: JournalOperation::Upsert }
+    }
+
+    /// Creates a deletion tombstone. Tombstones are copied during catch-up,
+    /// so a delete acknowledged on the source cannot be lost at cutover.
+    #[must_use]
+    pub fn delete(sequence: u64, key: Vec<u8>) -> Self {
+        Self { sequence, key, value: Vec::new(), operation: JournalOperation::Delete }
+    }
+
+    /// Returns the global journal sequence.
+    #[must_use]
+    pub const fn sequence(&self) -> u64 {
+        self.sequence
+    }
+
+    /// Returns the canonical key used for range filtering.
+    #[must_use]
+    pub fn key(&self) -> &[u8] {
+        &self.key
+    }
+
+    /// Returns the opaque operation/document bytes.
+    #[must_use]
+    pub fn value(&self) -> &[u8] {
+        &self.value
+    }
+
+    /// Returns whether this row upserts or deletes the document.
+    #[must_use]
+    pub const fn operation(&self) -> JournalOperation {
+        self.operation
+    }
+}
+
+/// Reader seam for the durable publication journal.
+pub trait JournalReader {
+    /// Reader-specific I/O failure.
+    type Error;
+
+    /// Returns entries strictly after `after`, in sequence order.
+    fn read_after(&mut self, after: u64, limit: usize) -> Result<Vec<JournalEntry>, Self::Error>;
+}
+
+/// Target seam for idempotent journal application.
+pub trait JournalWriter {
+    /// Writer-specific I/O failure.
+    type Error;
+
+    /// Applies a contiguous batch durably before returning.
+    fn apply_journal(&mut self, entries: &[JournalEntry]) -> Result<(), Self::Error>;
+
+    /// Persists the source checkpoint after applying the selected rows.
+    ///
+    /// The default preserves the original adapter contract. SQLite adapters
+    /// should override this method and commit the rows plus checkpoint in one
+    /// transaction; a retry after a crash is then an idempotent transaction
+    /// replay rather than an acknowledged-write loss window.
+    fn advance_checkpoint(&mut self, _through: u64) -> Result<(), Self::Error> {
+        Ok(())
+    }
+
+    /// Applies selected rows and advances the checkpoint as one durable unit.
+    fn apply_journal_and_checkpoint(
+        &mut self,
+        entries: &[JournalEntry],
+        through: u64,
+    ) -> Result<(), Self::Error> {
+        self.apply_journal(entries)?;
+        self.advance_checkpoint(through)
+    }
+}
+
+/// Catch-up protocol failure detected before cutover.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum CatchUpError {
+    /// The journal reader failed before returning a batch.
+    ReaderFailed,
+    /// The target failed to durably apply a batch.
+    WriterFailed,
+    /// A journal sequence was not strictly greater than the applied mark.
+    SequenceRegressed {
+        /// Last applied sequence.
+        previous: u64,
+        /// Invalid returned sequence.
+        returned: u64,
+    },
+    /// A journal batch was not strictly increasing.
+    SequenceOutOfOrder,
+    /// A journal entry had an empty key.
+    EmptyKey,
+}
+
+/// Resumable journal tail state.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct JournalCatchUp {
+    applied_through: u64,
+    lower: Option<Vec<u8>>,
+    upper: Option<Vec<u8>>,
+}
+
+impl JournalCatchUp {
+    /// Starts tailing after the supplied durable checkpoint.
+    #[must_use]
+    pub const fn new(applied_through: u64) -> Self {
+        Self { applied_through, lower: None, upper: None }
+    }
+
+    /// Starts tailing a moved range below the upper-exclusive `upper` bound.
+    pub fn for_range(
+        applied_through: u64,
+        lower: Option<Vec<u8>>,
+        upper: Vec<u8>,
+    ) -> Result<Self, CatchUpError> {
+        if upper.is_empty()
+            || lower.as_deref().is_some_and(|lower| lower.is_empty() || lower >= upper.as_slice())
+        {
+            return Err(CatchUpError::EmptyKey);
+        }
+        Ok(Self { applied_through, lower, upper: Some(upper) })
+    }
+
+    /// Returns the last successfully applied sequence.
+    #[must_use]
+    pub const fn applied_through(&self) -> u64 {
+        self.applied_through
+    }
+
+    /// Reads, validates, and applies one bounded journal batch.
+    ///
+    /// The target is called only after all sequence and key checks pass, so a
+    /// malformed response cannot partially advance the catch-up checkpoint.
+    pub fn step<R, W>(
+        &mut self,
+        reader: &mut R,
+        writer: &mut W,
+        limit: usize,
+    ) -> Result<usize, CatchUpError>
+    where
+        R: JournalReader,
+        W: JournalWriter,
+    {
+        let entries = reader
+            .read_after(self.applied_through, limit.max(1))
+            .map_err(|_| CatchUpError::ReaderFailed)?;
+        let mut previous = self.applied_through;
+        for entry in &entries {
+            if entry.sequence() <= previous {
+                return Err(CatchUpError::SequenceRegressed {
+                    previous,
+                    returned: entry.sequence(),
+                });
+            }
+            if entry.key().is_empty() {
+                return Err(CatchUpError::EmptyKey);
+            }
+            previous = entry.sequence();
+        }
+        if entries.windows(2).any(|pair| pair[0].sequence() >= pair[1].sequence()) {
+            return Err(CatchUpError::SequenceOutOfOrder);
+        }
+        let selected: Vec<_> = entries
+            .iter()
+            .filter(|entry| {
+                self.lower.as_deref().is_none_or(|lower| entry.key() >= lower)
+                    && self.upper.as_deref().is_none_or(|upper| entry.key() < upper)
+            })
+            .cloned()
+            .collect();
+        // The checkpoint is for the source journal, rather than only for the
+        // rows which happen to belong to this range.  Advancing it when a
+        // page contains only rows for another range is essential: otherwise
+        // the same page is read forever and a split can never catch up.
+        writer
+            .apply_journal_and_checkpoint(
+                &selected,
+                entries.last().map_or(self.applied_through, JournalEntry::sequence),
+            )
+            .map_err(|_| CatchUpError::WriterFailed)?;
+        // Do this only after the target has durably accepted the selected
+        // rows.  A retry after a crash before the caller persists this value
+        // is safe because JournalWriter is explicitly idempotent.
+        self.applied_through = entries.last().map_or(self.applied_through, JournalEntry::sequence);
+        Ok(entries.len())
+    }
+}
diff --git a/src/shard_split/cutover.rs b/src/shard_split/cutover.rs
new file mode 100644
index 00000000..ab155f41
--- /dev/null
+++ b/src/shard_split/cutover.rs
@@ -0,0 +1,149 @@
+//! Writer-drain fence and cutover permit contracts.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+
+// A permit is intentionally tied to one fence instance.  This prevents a
+// permit copied from an unrelated split from passing `WriterFence::permits`.
+// The value is an opaque capability; it is not a routing generation or a
+// persisted sequence number.
+static NEXT_FENCE_ID: AtomicU64 = AtomicU64::new(1);
+
+/// State of the source writer fence.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum WriterFenceState {
+    /// New writes are accepted.
+    Open,
+    /// New writes drain while the target catches up.
+    Draining,
+    /// The source is fenced and routing may be swapped.
+    Fenced,
+}
+
+/// Why a writer fence operation failed.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum FenceError {
+    /// A second drain request was made while one is active.
+    AlreadyDraining,
+    /// The target or acknowledgements trail the requested sequence.
+    NotDrained {
+        /// Target sequence applied at the fence attempt.
+        target_applied: u64,
+        /// Required sequence.
+        required: u64,
+    },
+    /// New writes are not accepted after fencing.
+    Fenced,
+    /// The operation requires a draining fence.
+    WrongState(WriterFenceState),
+}
+
+/// An unforgeable-in-practice permit returned only after a successful fence.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct CutoverPermit {
+    required: u64,
+    fence_id: u64,
+}
+
+impl CutoverPermit {
+    /// Returns the acknowledged sequence covered by this permit.
+    #[must_use]
+    pub const fn required(&self) -> u64 {
+        self.required
+    }
+
+    /// Returns whether this value was issued by a writer fence.
+    #[must_use]
+    pub(crate) const fn is_valid(self) -> bool {
+        self.fence_id != 0
+    }
+}
+
+/// Monotonic source-writer drain state.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct WriterFence {
+    state: WriterFenceState,
+    required: u64,
+    acked_through: u64,
+    fence_id: u64,
+}
+
+impl WriterFence {
+    /// Creates an open writer fence.
+    #[must_use]
+    pub fn new() -> Self {
+        // Zero is reserved for an invalid permit.  The wrapping fallback is
+        // practically unreachable, but keeps construction total even after
+        // an exceptionally long-lived process exhausts the counter.
+        let id = NEXT_FENCE_ID.fetch_add(1, Ordering::Relaxed);
+        Self {
+            state: WriterFenceState::Open,
+            required: 0,
+            acked_through: 0,
+            fence_id: if id == 0 { 1 } else { id },
+        }
+    }
+
+    /// Returns the current fence state.
+    #[must_use]
+    pub const fn state(&self) -> WriterFenceState {
+        self.state
+    }
+
+    /// Returns the highest acknowledged source sequence observed.
+    #[must_use]
+    pub const fn acked_through(&self) -> u64 {
+        self.acked_through
+    }
+
+    /// Begins draining writes through `required` before cutover.
+    pub fn begin_drain(&mut self, required: u64) -> Result<(), FenceError> {
+        match self.state {
+            WriterFenceState::Open => {
+                self.required = self.required.max(required);
+                self.state = WriterFenceState::Draining;
+                Ok(())
+            }
+            state => Err(if state == WriterFenceState::Draining {
+                FenceError::AlreadyDraining
+            } else {
+                FenceError::WrongState(state)
+            }),
+        }
+    }
+
+    /// Records an acknowledged write while the source drains.
+    pub fn note_acked(&mut self, sequence: u64) -> Result<(), FenceError> {
+        if self.state == WriterFenceState::Fenced {
+            return Err(FenceError::Fenced);
+        }
+        self.acked_through = self.acked_through.max(sequence);
+        Ok(())
+    }
+
+    /// Fences the source only when the target has applied every required ack.
+    pub fn try_fence(&mut self, target_applied: u64) -> Result<CutoverPermit, FenceError> {
+        if self.state != WriterFenceState::Draining {
+            return Err(FenceError::WrongState(self.state));
+        }
+        let required = self.required.max(self.acked_through);
+        if target_applied < required {
+            return Err(FenceError::NotDrained { target_applied, required });
+        }
+        self.state = WriterFenceState::Fenced;
+        Ok(CutoverPermit { required, fence_id: self.fence_id })
+    }
+
+    /// Checks that a cutover permit still matches this fence.
+    #[must_use]
+    pub fn permits(&self, permit: CutoverPermit) -> bool {
+        self.state == WriterFenceState::Fenced
+            && permit.fence_id == self.fence_id
+            && permit.required <= self.acked_through.max(self.required)
+    }
+}
+
+impl Default for WriterFence {
+    fn default() -> Self {
+        Self::new()
+    }
+}
