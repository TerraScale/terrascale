+fn json_storage_preserves_finite_float_variants_and_bits() {
+    for number in
+        [0.0_f64, -0.0, 42.0, -42.0, 0.125, f64::MIN_POSITIVE, f64::MAX, 9_007_199_254_740_992.0]
