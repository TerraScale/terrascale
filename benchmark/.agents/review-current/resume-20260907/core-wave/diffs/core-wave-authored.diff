@@ -0,0 +1,395 @@
+//! Transactional schema and migration control records.
+
+use super::{EngineError, Transaction};
+use crate::{storage, types::DocumentValue};
+
+impl Transaction<'_> {
+    pub(crate) fn read_private_metadata(
+        &self,
+        key: &str,
+    ) -> Result<Option<DocumentValue>, EngineError> {
+        if let Some(staged) = self.metadata.iter().rev().find(|change| change.key == key) {
+            return Ok(staged.value.clone());
+        }
+        self.engine
+            .lock_storage()?
+            .port
+            .private_metadata_at(self.scope.tenant(), key, self.snapshot_sequence)
+            .map_err(|()| EngineError::StorageFailure)
+    }
+
+    pub(crate) fn put_private_metadata(
+        &mut self,
+        key: &str,
+        value: DocumentValue,
+    ) -> Result<(), EngineError> {
+        if key.is_empty() || key.len() > 4096 || storage::encode_private_value(&value).is_none() {
+            return Err(EngineError::InvalidDocument);
+        }
+        self.stage_private_metadata(key, Some(value));
+        Ok(())
+    }
+
+    pub(crate) fn delete_private_metadata(&mut self, key: &str) -> Result<(), EngineError> {
+        if key.is_empty() || key.len() > 4096 {
+            return Err(EngineError::InvalidDocument);
+        }
+        self.stage_private_metadata(key, None);
+        Ok(())
+    }
+
+    fn stage_private_metadata(&mut self, key: &str, value: Option<DocumentValue>) {
+        if let Some(staged) = self.metadata.iter_mut().find(|change| change.key == key) {
+            staged.value = value;
+        } else {
+            self.metadata.push(storage::PrivateMetadataWrite { key: key.to_owned(), value });
+        }
+    }
+}
+
+impl Transaction<'_> {
+    /// Stages an exact-byte schema envelope CAS with this transaction's validation changes.
+    ///
+    /// The comparison runs under the `SQLite` commit transaction. A conflict
+    /// rejects the entire transaction, including documents and validation state.
+    ///
+    /// # Errors
+    /// Returns `InvalidDocument` for oversized or duplicate target envelopes.
+    pub fn stage_schema_metadata(
+        &mut self,
+        database: &str,
+        branch: &str,
+        collection: &str,
+        expected: Option<&[u8]>,
+        replacement: &[u8],
+    ) -> Result<(), EngineError> {
+        if database.is_empty()
+            || database.len() > 255
+            || branch.is_empty()
+            || branch.len() > 255
+            || collection.is_empty()
+            || collection.len() > 255
+            || replacement.len() > 16 * 1024 * 1024
+            || expected.is_some_and(|bytes| bytes.len() > 16 * 1024 * 1024)
+            || self.schema_envelopes.iter().any(|record| {
+                record.database == database
+                    && record.branch == branch
+                    && record.collection == collection
+            })
+        {
+            return Err(EngineError::InvalidDocument);
+        }
+        self.schema_envelopes.push(storage::SchemaEnvelopeWrite {
+            database: database.to_owned(),
+            branch: branch.to_owned(),
+            collection: collection.to_owned(),
+            expected: expected.map(<[u8]>::to_vec),
+            replacement: replacement.to_vec(),
+        });
+        Ok(())
+    }
+}
+
+impl Transaction<'_> {
+    /// Binds schema controls to an immutable collection generation and manifest.
+    ///
+    /// Progress retains this identity; only a new schema changes it. The
+    /// durable writer records the initial winner stamp independently of later
+    /// progress stamps, so progress cannot elect another schema generation.
+    ///
+    /// # Errors
+    /// Rejects a zero generation or invalid collection identifier.
+    pub fn stage_schema_bundle(
+        &mut self,
+        collection: &str,
+        generation: u64,
+        manifest: [u8; 32],
+    ) -> Result<(), EngineError> {
+        crate::types::CollectionName::try_new(collection)
+            .map_err(|_| EngineError::InvalidDocument)?;
+        let generation = i64::try_from(generation)
+            .ok()
+            .filter(|value| *value > 0)
+            .ok_or(EngineError::InvalidDocument)?;
+        let value = DocumentValue::Object(std::collections::BTreeMap::from([
+            ("generation".into(), DocumentValue::Integer(generation)),
+            (
+                "manifest".into(),
+                DocumentValue::String(blake3::Hash::from_bytes(manifest).to_hex().to_string()),
+            ),
+        ]));
+        self.put_private_metadata(&format!("schema:bundle/{collection}"), value)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::engine::{CommitError, CommitOutcome, Engine, EngineConfig};
+    use crate::types::{
+        CollectionName, Document, DocumentId, ExpectedVersion, LocalDurability, OperationId,
+        TenantId, TenantScope,
+    };
+
+    fn open(tag: &str) -> (std::path::PathBuf, Engine) {
+        let path = std::env::temp_dir().join(format!(
+            "terrabase-private-{tag}-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()
+        ));
+        let engine = Engine::open(EngineConfig::durable(&path).unwrap()).unwrap();
+        (path, engine)
+    }
+    fn begin<'a>(engine: &'a Engine, scope: &TenantScope, operation: &str) -> Transaction<'a> {
+        engine
+            .begin(
+                scope,
+                engine.read_snapshot(scope).unwrap(),
+                OperationId::try_new(operation).unwrap(),
+            )
+            .unwrap()
+    }
+    fn value() -> DocumentValue {
+        DocumentValue::Object(std::collections::BTreeMap::from([
+            ("version".into(), DocumentValue::Integer(1)),
+            (
+                "rules".into(),
+                DocumentValue::Array(vec![DocumentValue::Object(
+                    std::collections::BTreeMap::from([
+                        ("rule".into(), DocumentValue::String("required".into())),
+                        ("field".into(), DocumentValue::String("name".into())),
+                    ]),
+                )]),
+            ),
+        ]))
+    }
+    fn document(id: &str) -> Document {
+        Document::new(
+            DocumentId::try_new(id).unwrap(),
+            CollectionName::try_new("users").unwrap(),
+            DocumentValue::Object(std::collections::BTreeMap::default()),
+        )
+    }
+
+    #[test]
+    fn private_metadata_atomic_restart_snapshots_and_unbilled_state() {
+        let (path, engine) = open("restart");
+        let scope = engine.scope_for(&TenantId::try_new("tenant").unwrap());
+        let old = begin(&engine, &scope, "old-reader");
+        let mut aborted = begin(&engine, &scope, "aborted");
+        aborted.put_private_metadata("control", DocumentValue::Integer(1)).unwrap();
+        drop(aborted);
+        assert_eq!(
+            begin(&engine, &scope, "after-abort").read_private_metadata("control").unwrap(),
+            None
+        );
+        let mut transaction = begin(&engine, &scope, "control-write");
+        transaction.put_private_metadata("control", DocumentValue::Integer(2)).unwrap();
+        transaction.stage_schema_metadata("db", "main", "users", None, b"schema-v1").unwrap();
+        assert!(matches!(transaction.commit(LocalDurability::Synced), CommitOutcome::Committed(_)));
+        assert_eq!(
+            old.read_private_metadata("control").unwrap(),
+            None,
+            "immutable metadata snapshot"
+        );
+        drop(old);
+        let mut replay = begin(&engine, &scope, "control-write");
+        replay.put_private_metadata("control", DocumentValue::Integer(2)).unwrap();
+        replay.stage_schema_metadata("db", "main", "users", None, b"schema-v1").unwrap();
+        assert!(
+            matches!(replay.commit(LocalDurability::Synced), CommitOutcome::Committed(_)),
+            "identity replay precedes envelope CAS"
+        );
+        let mut reuse = begin(&engine, &scope, "control-write");
+        reuse.put_private_metadata("control", DocumentValue::Integer(3)).unwrap();
+        assert_eq!(
+            reuse.commit(LocalDurability::Synced),
+            CommitOutcome::Rejected(CommitError::OperationIdReuse)
+        );
+        assert!(
+            engine
+                .snapshot_documents(&scope, &engine.read_snapshot(&scope).unwrap())
+                .unwrap()
+                .is_empty()
+        );
+        assert!(engine.journal_rows(&scope, 0, 100).unwrap().is_empty());
+        assert_eq!(engine.metering_live_bytes(&scope), 0);
+        let usage = engine.metering_fact(&scope, "tenant");
+        assert!(usage.is_none_or(|fact| fact.writes() == 0));
+        engine.shutdown().unwrap();
+        let engine = Engine::open(EngineConfig::durable(&path).unwrap()).unwrap();
+        let scope = engine.scope_for(&TenantId::try_new("tenant").unwrap());
+        assert_eq!(
+            begin(&engine, &scope, "reopened").read_private_metadata("control").unwrap(),
+            Some(DocumentValue::Integer(2))
+        );
+        assert_eq!(
+            engine.schema_metadata_load("db", "main", "users").unwrap(),
+            Some(b"schema-v1".to_vec())
+        );
+        let other = engine.scope_for(&TenantId::try_new("other").unwrap());
+        assert_eq!(
+            begin(&engine, &other, "isolated").read_private_metadata("control").unwrap(),
+            None
+        );
+        engine.shutdown().unwrap();
+        std::fs::remove_dir_all(path).unwrap();
+    }
+
+    #[test]
+    fn private_metadata_schema_commit_fence_and_atomic_cas_refusal() {
+        let (path, engine) = open("schema-fence");
+        let scope = engine.scope_for(&TenantId::try_new("tenant").unwrap());
+        let mut stale = begin(&engine, &scope, "stale-document");
+        stale.put(document("stale"), ExpectedVersion::New).unwrap();
+        let mut rejected = begin(&engine, &scope, "schema-with-invalid-document");
+        rejected.put(document("invalid"), ExpectedVersion::New).unwrap();
+        rejected.put_private_metadata("family:validation/users", value()).unwrap();
+        assert_eq!(
+            rejected.commit(LocalDurability::Synced),
+            CommitOutcome::Rejected(CommitError::Validation)
+        );
+        assert_eq!(
+            begin(&engine, &scope, "not-installed")
+                .read_private_metadata("family:validation/users")
+                .unwrap(),
+            None
+        );
+        let mut schema = begin(&engine, &scope, "install-schema");
+        schema.put_private_metadata("family:validation/users", value()).unwrap();
+        schema.stage_schema_metadata("db", "main", "users", None, b"schema-v1").unwrap();
+        assert!(matches!(schema.commit(LocalDurability::Synced), CommitOutcome::Committed(_)));
+        assert_eq!(
+            stale.commit(LocalDurability::Synced),
+            CommitOutcome::Rejected(CommitError::Validation)
+        );
+        let mut conflict = begin(&engine, &scope, "stale-envelope");
+        conflict.delete_private_metadata("family:validation/users").unwrap();
+        conflict.stage_schema_metadata("db", "main", "users", None, b"wrong").unwrap();
+        assert_eq!(
+            conflict.commit(LocalDurability::Synced),
+            CommitOutcome::Rejected(CommitError::Conflict)
+        );
+        assert_eq!(
+            begin(&engine, &scope, "still-installed")
+                .read_private_metadata("family:validation/users")
+                .unwrap(),
+            Some(value())
+        );
+        assert!(
+            engine
+                .snapshot_documents(&scope, &engine.read_snapshot(&scope).unwrap())
+                .unwrap()
+                .is_empty()
+        );
+        engine.shutdown().unwrap();
+        std::fs::remove_dir_all(path).unwrap();
+    }
+}
+
+#[cfg(test)]
+mod bundle_tests {
+    use super::*;
+    use crate::{
+        engine::{CommitOutcome, Engine, EngineConfig},
+        types::{LocalDurability, OperationId, TenantId},
+    };
+    fn engine(tag: &str) -> (std::path::PathBuf, Engine) {
+        let path = std::env::temp_dir().join(format!(
+            "terrabase-bundle-{tag}-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()
+        ));
+        let engine = Engine::open(EngineConfig::durable(&path).unwrap()).unwrap();
+        (path, engine)
+    }
+    fn publish(
+        engine: &Engine,
+        name: &str,
+        manifest: u8,
+        expected: Option<&[u8]>,
+        envelope: &[u8],
+        control: i64,
+    ) {
+        let scope = engine.scope_for(&TenantId::try_new("tenant").unwrap());
+        let mut transaction = engine
+            .begin(
+                &scope,
+                engine.read_snapshot(&scope).unwrap(),
+                OperationId::try_new(name).unwrap(),
+            )
+            .unwrap();
+        transaction.stage_schema_bundle("users", 1, [manifest; 32]).unwrap();
+        transaction
+            .put_private_metadata("family:validation/users", DocumentValue::Integer(control))
+            .unwrap();
+        transaction.stage_schema_metadata("db", "main", "users", expected, envelope).unwrap();
+        assert!(matches!(transaction.commit(LocalDurability::Synced), CommitOutcome::Committed(_)));
+    }
+    #[test]
+    fn schema_bundle_converges_when_losing_generation_progress_arrives_last() {
+        let (a_path, a) = engine("a");
+        let (b_path, b) = engine("b");
+        let (x_path, x) = engine("x");
+        let (y_path, y) = engine("y");
+        publish(&a, "a-schema", 1, None, b"a", 1);
+        publish(&b, "b-schema", 2, None, b"b", 2);
+        let scope_a = a.scope_for(&TenantId::try_new("tenant").unwrap());
+        let scope_b = b.scope_for(&TenantId::try_new("tenant").unwrap());
+        let a_initial = a.replication_publications(&scope_a, 0, 10).unwrap().remove(0).1;
+        let b_initial = b.replication_publications(&scope_b, 0, 10).unwrap().remove(0).1;
+        let a_wins = (a_initial.hlc, &a_initial.origin) > (b_initial.hlc, &b_initial.origin);
+        let (loser, old, new, manifest, control) = if a_wins {
+            (&b, b"b".as_slice(), b"b-progress".as_slice(), 2, 2)
+        } else {
+            (&a, b"a".as_slice(), b"a-progress".as_slice(), 1, 1)
+        };
+        publish(loser, "loser-progress", manifest, Some(old), new, control);
+        let loser_scope = loser.scope_for(&TenantId::try_new("tenant").unwrap());
+        let progress =
+            loser.replication_publications(&loser_scope, 0, 10).unwrap().pop().unwrap().1;
+        for (target, groups, progress_first) in [
+            (&x, vec![&a_initial, &b_initial, &progress], false),
+            (&y, vec![&progress, &b_initial, &a_initial], true),
+        ] {
+            let scope = target.scope_for(&TenantId::try_new("tenant").unwrap());
+            for (index, group) in groups.into_iter().enumerate() {
+                if progress_first && index == 0 {
+                    assert!(matches!(
+                        target.apply_replicated_publication(&scope, group),
+                        Err(EngineError::Conflict)
+                    ));
+                    assert_eq!(target.schema_metadata_load("db", "main", "users").unwrap(), None);
+                    continue;
+                }
+                target.apply_replicated_publication(&scope, group).unwrap();
+            }
+            if progress_first {
+                target.apply_replicated_publication(&scope, &progress).unwrap();
+            }
+            let expected = if a_wins { b"a".as_slice() } else { b"b".as_slice() };
+            assert_eq!(
+                target.schema_metadata_load("db", "main", "users").unwrap(),
+                Some(expected.to_vec())
+            );
+            let transaction = target
+                .begin(
+                    &scope,
+                    target.read_snapshot(&scope).unwrap(),
+                    OperationId::try_new("read-controls").unwrap(),
+                )
+                .unwrap();
+            assert_eq!(
+                transaction.read_private_metadata("family:validation/users").unwrap(),
+                Some(DocumentValue::Integer(if a_wins { 1 } else { 2 }))
+            );
+        }
+        a.shutdown().unwrap();
+        b.shutdown().unwrap();
+        x.shutdown().unwrap();
+        y.shutdown().unwrap();
+        for path in [a_path, b_path, x_path, y_path] {
+            std::fs::remove_dir_all(path).unwrap();
+        }
+    }
+}
diff --git a/src/engine/recovery_statistics.rs b/src/engine/recovery_statistics.rs
new file mode 100644
index 00000000..8cd9f896
--- /dev/null
+++ b/src/engine/recovery_statistics.rs
@@ -0,0 +1,193 @@
+//! Bounded logical recovery evidence independent of assigned document revisions.
+
+use super::{Engine, EngineError};
+use crate::types::{Cancellation, Document, DocumentValue, TenantId, TenantScope};
+
+/// Logical document evidence at one fixed publication and TTL boundary.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct RecoveryStatistics {
+    /// Publication boundary used for the scan.
+    pub journal_cut: u64,
+    /// Fixed TTL visibility clock in Unix milliseconds.
+    pub captured_at_millis: u64,
+    /// Number of live logical document winners.
+    pub row_count: u64,
+    /// BLAKE3 logical-content digest, excluding assigned document versions.
+    ///
+    /// The aggregate starts with `terrabase.logical-recovery.v1\0`, followed
+    /// by 32-byte document hashes in tenant/collection/identifier lexical order.
+    /// Each document hash starts with `terrabase.logical-document.v1\0`, then
+    /// framed tenant, collection and identifier followed by its typed value.
+    /// Framing means little-endian u64 byte length followed by UTF-8 bytes.
+    /// Value tags are null=0, boolean=1, integer=2, float=3, string=4, array=5,
+    /// object=6. Booleans append 0/1; integers append little-endian i64;
+    /// floats append IEEE-754 bits as little-endian u64. Strings use framing.
+    /// Arrays and objects append little-endian u64 entry counts, then values;
+    /// object entries have framed keys in lexical order followed by values.
+    pub checksum: [u8; 32],
+}
+
+impl Engine {
+    /// Computes recovery evidence using pages capped at 256 documents and
+    /// four MiB of stored bodies. This read emits no metering write facts.
+    /// Source and restored target use the same TTL clock; their publication
+    /// cuts may differ because restored documents receive fresh revisions.
+    ///
+    /// # Errors
+    /// Rejects foreign scopes, unavailable snapshots, exceeded page bounds,
+    /// cancellation, and storage failures. No partial digest is returned.
+    pub fn recovery_statistics(
+        &self,
+        scope: &TenantScope,
+        boundary: u64,
+        captured_at_millis: u64,
+        cancellation: Option<&Cancellation>,
+    ) -> Result<RecoveryStatistics, EngineError> {
+        let mut hasher = logical_state_hasher();
+        let mut cursor = None;
+        let mut row_count = 0_u64;
+        loop {
+            check_cancelled(cancellation)?;
+            let records = self.export_snapshot_records(
+                scope,
+                boundary,
+                captured_at_millis,
+                cursor.as_ref(),
+                256,
+            )?;
+            if records.is_empty() {
+                break;
+            }
+            for record in &records {
+                check_cancelled(cancellation)?;
+                hasher.update(&logical_document_digest(scope.tenant(), record.document()));
+                row_count = row_count.checked_add(1).ok_or(EngineError::StorageFailure)?;
+            }
+            cursor = records.last().map(|record| {
+                (record.document().collection().clone(), record.document().id().clone())
+            });
+        }
+        check_cancelled(cancellation)?;
+        Ok(RecoveryStatistics {
+            journal_cut: boundary,
+            captured_at_millis,
+            row_count,
+            checksum: *hasher.finalize().as_bytes(),
+        })
+    }
+}
+
+fn check_cancelled(cancellation: Option<&Cancellation>) -> Result<(), EngineError> {
+    if cancellation.is_some_and(Cancellation::is_cancelled) {
+        return Err(EngineError::Cancelled);
+    }
+    Ok(())
+}
+
+pub(crate) fn logical_state_hasher() -> blake3::Hasher {
+    let mut hasher = blake3::Hasher::new();
+    hasher.update(b"terrabase.logical-recovery.v1\0");
+    hasher
+}
+
+/// Hashes one tenant/key/value without revision metadata for recovery evidence.
+pub(crate) fn logical_document_digest(tenant: &TenantId, document: &Document) -> [u8; 32] {
+    let mut hasher = blake3::Hasher::new();
+    hasher.update(b"terrabase.logical-document.v1\0");
+    hash_bytes(&mut hasher, tenant.as_str().as_bytes());
+    hash_document(&mut hasher, document);
+    *hasher.finalize().as_bytes()
+}
+
+fn hash_document(hasher: &mut blake3::Hasher, document: &Document) {
+    hash_bytes(hasher, document.collection().as_str().as_bytes());
+    hash_bytes(hasher, document.id().as_str().as_bytes());
+    hash_value(hasher, document.value());
+}
+
+fn hash_bytes(hasher: &mut blake3::Hasher, bytes: &[u8]) {
+    hasher.update(&(bytes.len() as u64).to_le_bytes());
+    hasher.update(bytes);
+}
+
+fn hash_value(hasher: &mut blake3::Hasher, value: &DocumentValue) {
+    match value {
+        DocumentValue::Null => {
+            hasher.update(&[0]);
+        }
+        DocumentValue::Boolean(value) => {
+            hasher.update(&[1, u8::from(*value)]);
+        }
+        DocumentValue::Integer(value) => {
+            hasher.update(&[2]);
+            hasher.update(&value.to_le_bytes());
+        }
+        DocumentValue::Number(value) => {
+            hasher.update(&[3]);
+            hasher.update(&value.to_bits().to_le_bytes());
+        }
+        DocumentValue::String(value) => {
+            hasher.update(&[4]);
+            hash_bytes(hasher, value.as_bytes());
+        }
+        DocumentValue::Array(values) => {
+            hasher.update(&[5]);
+            hasher.update(&(values.len() as u64).to_le_bytes());
+            for value in values {
+                hash_value(hasher, value);
+            }
+        }
+        DocumentValue::Object(values) => {
+            hasher.update(&[6]);
+            hasher.update(&(values.len() as u64).to_le_bytes());
+            for (key, value) in values {
+                hash_bytes(hasher, key.as_bytes());
+                hash_value(hasher, value);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::types::{CollectionName, DocumentId};
+
+    fn digest(document: &Document) -> [u8; 32] {
+        logical_document_digest(&TenantId::try_new("tenant").unwrap(), document)
+    }
+
+    #[test]
+    fn logical_checksum_ignores_versions_but_detects_content_and_key_changes() {
+        let mut source = Document::new(
+            DocumentId::try_new("id").unwrap(),
+            CollectionName::try_new("items").unwrap(),
+            DocumentValue::Array(vec![
+                DocumentValue::Integer(1),
+                DocumentValue::String("value".into()),
+            ]),
+        );
+        source.set_version(17);
+        let mut restored = source.clone();
+        restored.set_version(1);
+        assert_eq!(digest(&source), digest(&restored));
+        let changed = Document::new(
+            source.id().clone(),
+            source.collection().clone(),
+            DocumentValue::Integer(1),
+        );
+        assert_ne!(digest(&source), digest(&changed));
+        let renamed = Document::new(
+            DocumentId::try_new("other").unwrap(),
+            source.collection().clone(),
+            source.value().clone(),
+        );
+        assert_ne!(digest(&source), digest(&renamed));
+        let float = Document::new(
+            source.id().clone(),
+            source.collection().clone(),
+            DocumentValue::Number(1.0),
+        );
+        assert_ne!(digest(&changed), digest(&float));
+    }
+}
diff --git a/src/engine/repair_summary.rs b/src/engine/repair_summary.rs
new file mode 100644
index 00000000..98d52fca
--- /dev/null
+++ b/src/engine/repair_summary.rs
@@ -0,0 +1,209 @@
+//! Epoch-bound, immutable local cuts for durable range reconciliation.
+use super::{Engine, EngineError, ReplicatedPublication};
+use crate::types::{TenantId, TenantScope};
+use std::collections::BTreeMap;
+use terrabase_replication_core::anti_entropy::RangeFingerprint;
+
+/// One tenant's exact set of source publications at a durable local cut.
+///
+/// Source frontiers are maximum represented sequences; sequence holes are not
+/// evidence of missing writes because sequences can belong to other tenants.
+#[derive(Clone, Debug)]
+pub struct ReplicationRepairCut {
+    tenant: TenantId,
+    epoch: u64,
+    database: crate::identity::DatabaseUlid,
+    local_sequence: u64,
+    frontier: BTreeMap<String, u64>,
+    baseline: [u8; 32],
+    expires: std::time::Instant,
+}
+impl ReplicationRepairCut {
+    /// Durable local journal high-water captured with this cut.
+    #[must_use]
+    pub const fn local_sequence(&self) -> u64 {
+        self.local_sequence
+    }
+    /// Database incarnation that owns this cut.
+    #[must_use]
+    pub const fn epoch(&self) -> u64 {
+        self.epoch
+    }
+    /// Maximum represented source sequence for each origin at this cut.
+    #[must_use]
+    pub fn frontier(&self) -> &BTreeMap<String, u64> {
+        &self.frontier
+    }
+    /// Stable database-lineage marker captured atomically with this cut.
+    #[must_use]
+    pub const fn baseline_digest(&self) -> [u8; 32] {
+        self.baseline
+    }
+}
+impl Engine {
+    /// Captures an exact tenant-scoped source set without loading publications.
+    ///
+    /// # Errors
+    /// Rejects invalid scopes, closed storage, or corrupt summary state.
+    pub fn replication_repair_cut(
+        &self,
+        scope: &TenantScope,
+    ) -> Result<ReplicationRepairCut, EngineError> {
+        self.validate_scope(scope)?;
+        let storage = self.lock_storage()?;
+        let local_sequence = storage.port.published_state().0.get();
+        let (frontier, baseline) = storage
+            .port
+            .replication_repair_cut(scope.tenant(), local_sequence)
+            .map_err(|()| EngineError::StorageFailure)?;
+        Ok(ReplicationRepairCut {
+            tenant: scope.tenant().clone(),
+            epoch: self.session_epoch().get(),
+            database: self.database_id(),
+            local_sequence,
+            frontier,
+            baseline,
+            expires: std::time::Instant::now() + std::time::Duration::from_mins(5),
+        })
+    }
+    fn validate_repair_cut(
+        &self,
+        scope: &TenantScope,
+        cut: &ReplicationRepairCut,
+        origin: &str,
+        first: u64,
+        last: u64,
+    ) -> Result<(), EngineError> {
+        self.validate_scope(scope)?;
+        if std::time::Instant::now() >= cut.expires
+            || cut.tenant != *scope.tenant()
+            || cut.epoch != self.session_epoch().get()
+            || cut.database != self.database_id()
+            || origin.is_empty()
+            || origin.len() > 255
+            || first == 0
+            || first > last
+            || last > i64::MAX as u64
+        {
+            return Err(EngineError::InvalidDocument);
+        }
+        Ok(())
+    }
+    /// Summarizes an inclusive source sequence range at an immutable local cut.
+    /// Uses at most two partial leaves and fixed-fanout aggregate lookups.
+    ///
+    /// # Errors
+    /// Rejects a foreign scope/incarnation, invalid range, or unavailable history.
+    pub fn replication_range_summary(
+        &self,
+        scope: &TenantScope,
+        cut: &ReplicationRepairCut,
+        origin: &str,
+        first: u64,
+        last: u64,
+    ) -> Result<RangeFingerprint, EngineError> {
+        self.validate_repair_cut(scope, cut, origin, first, last)?;
+        self.lock_storage()?
+            .port
+            .replication_range_summary(scope.tenant(), origin, cut.local_sequence, first, last)
+            .map_err(|()| EngineError::StorageFailure)
+    }
+    /// Loads at most 4096 source positions and revalidates canonical full hashes.
+    /// Retention loss or changed source bytes fail closed; summaries never stand
+    /// in for the actual transaction delivered through the normal apply path.
+    ///
+    /// # Errors
+    /// Rejects invalid cuts, oversized leaves, lost retained rows, or corruption.
+    pub fn replication_range_publications(
+        &self,
+        scope: &TenantScope,
+        cut: &ReplicationRepairCut,
+        origin: &str,
+        first: u64,
+        last: u64,
+    ) -> Result<Vec<ReplicatedPublication>, EngineError> {
+        self.validate_repair_cut(scope, cut, origin, first, last)?;
+        if last - first >= 4096 {
+            return Err(EngineError::SnapshotPageLimitExceeded);
+        }
+        self.lock_storage()?
+            .port
+            .replication_range_publications(scope.tenant(), origin, cut.local_sequence, first, last)
+            .map_err(|()| EngineError::StorageFailure)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{
+        engine::{CommitOutcome, EngineConfig},
+        types::{DocumentValue, LocalDurability, OperationId},
+    };
+    #[test]
+    fn durable_frozen_cuts_revalidate_retained_original_publications() {
+        let path = std::env::temp_dir().join(format!(
+            "repair-cut-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()
+        ));
+        let engine = Engine::open(EngineConfig::durable(&path).unwrap()).unwrap();
+        let tenant = TenantId::try_new("tenant").unwrap();
+        let scope = engine.scope_for(&tenant);
+        for operation in ["one", "two"] {
+            let mut tx = engine
+                .begin(
+                    &scope,
+                    engine.read_snapshot(&scope).unwrap(),
+                    OperationId::try_new(operation).unwrap(),
+                )
+                .unwrap();
+            tx.put_private_metadata("key", DocumentValue::String(operation.to_owned())).unwrap();
+            assert!(matches!(tx.commit(LocalDurability::Synced), CommitOutcome::Committed(_)));
+        }
+        let cut = engine.replication_repair_cut(&scope).unwrap();
+        let (origin, last) = cut.frontier().iter().next().unwrap();
+        let expected = engine.replication_range_summary(&scope, &cut, origin, 1, *last).unwrap();
+        assert_eq!(expected.count, 2);
+        let mut expired = cut.clone();
+        expired.expires = std::time::Instant::now();
+        assert!(engine.replication_range_summary(&scope, &expired, origin, 1, *last).is_err());
+        let mut foreign = cut.clone();
+        foreign.epoch = foreign.epoch.wrapping_add(1);
+        assert!(engine.replication_range_summary(&scope, &foreign, origin, 1, *last).is_err());
+        assert_eq!(
+            engine.replication_range_publications(&scope, &cut, origin, 1, *last).unwrap().len(),
+            2
+        );
+        assert!(
+            engine
+                .replication_range_summary(
+                    &engine.scope_for(&TenantId::try_new("other").unwrap()),
+                    &cut,
+                    origin,
+                    1,
+                    *last
+                )
+                .is_err()
+        );
+        engine.shutdown().unwrap();
+        let engine = Engine::open(EngineConfig::durable(&path).unwrap()).unwrap();
+        let scope = engine.scope_for(&tenant);
+        assert_eq!(
+            engine.replication_range_summary(&scope, &cut, origin, 1, *last).unwrap(),
+            expected
+        );
+        let raw = rusqlite::Connection::open(path.join("terrabase.sqlite3")).unwrap();
+        raw.execute("UPDATE replication_publications SET operation='tampered'", []).unwrap();
+        assert!(engine.replication_range_publications(&scope, &cut, origin, 1, *last).is_err());
+        assert_eq!(
+            engine.replication_range_summary(&scope, &cut, origin, 1, *last).unwrap(),
+            expected
+        );
+        raw.execute("DELETE FROM replication_publications", []).unwrap();
+        assert!(engine.replication_range_publications(&scope, &cut, origin, 1, *last).is_err());
+        drop(raw);
+        engine.shutdown().unwrap();
+        std::fs::remove_dir_all(path).unwrap();
+    }
+}
