+/// Normalizes numbered SQLite markers for the SQL front end. `sqlparser`
+/// preserves `?1` as a marker containing `?`, while the binding seam uses
+/// `1`; named `:1` is equivalent in SQLite. Quoted text and comments remain
+/// byte-for-byte unchanged.
+fn normalize_sql_parameter_markers(text: &str) -> String {
+    #[derive(Clone, Copy, PartialEq, Eq)]
+    enum Mode {
+        Code,
+        Single,
+        Double,
+        Backtick,
+        Bracket,
+        LineComment,
+        BlockComment,
+    }
+    let mut chars = text.chars().peekable();
+    let mut mode = Mode::Code;
+    let mut output = String::with_capacity(text.len());
+    while let Some(character) = chars.next() {
+        match mode {
+            Mode::Code => match character {
+                '\'' => {
+                    output.push(character);
+                    mode = Mode::Single;
+                }
+                '"' => {
+                    output.push(character);
+                    mode = Mode::Double;
+                }
+                '`' => {
+                    output.push(character);
+                    mode = Mode::Backtick;
+                }
+                '[' => {
+                    output.push(character);
+                    mode = Mode::Bracket;
+                }
+                '-' if chars.peek() == Some(&'-') => {
+                    output.push_str("--");
+                    chars.next();
+                    mode = Mode::LineComment;
+                }
+                '/' if chars.peek() == Some(&'*') => {
+                    output.push_str("/*");
+                    chars.next();
+                    mode = Mode::BlockComment;
+                }
+                '?' if chars.peek().is_some_and(char::is_ascii_digit) => output.push(':'),
+                _ => output.push(character),
+            },
+            Mode::Single => {
+                output.push(character);
+                if character == '\'' {
+                    if chars.peek() == Some(&'\'') {
+                        output.push(chars.next().expect("peeked quote"));
+                    } else {
+                        mode = Mode::Code;
+                    }
+                }
+            }
+            Mode::Double => {
+                output.push(character);
+                if character == '"' {
+                    if chars.peek() == Some(&'"') {
+                        output.push(chars.next().expect("peeked quote"));
+                    } else {
+                        mode = Mode::Code;
+                    }
+                }
+            }
+            Mode::Backtick => {
+                output.push(character);
+                if character == '`' {
+                    mode = Mode::Code;
+                }
+            }
+            Mode::Bracket => {
+                output.push(character);
+                if character == ']' {
+                    mode = Mode::Code;
+                }
+            }
+            Mode::LineComment => {
+                output.push(character);
+                if character == '\n' || character == '\r' {
+                    mode = Mode::Code;
+                }
+            }
+            Mode::BlockComment => {
+                output.push(character);
+                if character == '*' && chars.peek() == Some(&'/') {
+                    output.push(chars.next().expect("peeked slash"));
+                    mode = Mode::Code;
+                }
+            }
+        }
+    }
+    output
+}
