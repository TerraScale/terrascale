+/// A validated route catalog with its durable generation.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct RouteCatalog {
+    /// The validated key-range table.
+    pub(crate) table: RouteTable,
+    /// Monotonic route generation (zero is the initial catalog).
+    pub(crate) generation: u64,
+}
+
+/// Failures reading or installing a route catalog.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) enum RouteCatalogError {
+    /// Bytes were malformed or violated route invariants.
+    Malformed,
+    /// The caller's expected catalog is stale.
+    Conflict,
+    /// The underlying engine failed.
+    Engine(EngineError),
+}
+
+impl From<EngineError> for RouteCatalogError {
+    fn from(error: EngineError) -> Self {
+        Self::Engine(error)
+    }
+}
+
+fn key(incarnation: u128) -> String {
+    format!("control:shard-route/v1/{incarnation:032x}")
+}
+fn split_key(incarnation: u128) -> String {
+    format!("control:shard-split/v1/{incarnation:032x}")
+}
+
+fn push_bound(out: &mut Vec<u8>, bound: Option<&[u8]>) -> Result<(), RouteCatalogError> {
+    let bytes = bound.unwrap_or_default();
+    let len = u32::try_from(bytes.len()).map_err(|_| RouteCatalogError::Malformed)?;
+    out.extend_from_slice(&len.to_be_bytes());
+    out.extend_from_slice(bytes);
+    Ok(())
+}
+
+/// Encodes a route catalog in a bounded, versioned binary form.
+pub(crate) fn encode_catalog(catalog: &RouteCatalog) -> Result<Vec<u8>, RouteCatalogError> {
+    let routes = catalog.table.routes();
+    if routes.is_empty() || routes.len() > MAX_ROUTES {
+        return Err(RouteCatalogError::Malformed);
+    }
+    let mut out = Vec::with_capacity(32);
+    out.push(VERSION);
+    out.extend_from_slice(&catalog.generation.to_be_bytes());
+    out.extend_from_slice(
+        &(u32::try_from(routes.len()).map_err(|_| RouteCatalogError::Malformed)?).to_be_bytes(),
+    );
+    for route in routes {
+        if route.shard_id() == 0 {
+            return Err(RouteCatalogError::Malformed);
+        }
+        out.extend_from_slice(&route.shard_id().to_be_bytes());
+        push_bound(&mut out, route.lower())?;
+        push_bound(&mut out, route.upper())?;
+    }
+    (out.len() <= MAX_BYTES).then_some(out).ok_or(RouteCatalogError::Malformed)
+}
+
+struct Reader<'a> {
+    bytes: &'a [u8],
+    at: usize,
+}
+impl<'a> Reader<'a> {
+    fn take(&mut self, n: usize) -> Result<&'a [u8], RouteCatalogError> {
+        let end = self.at.checked_add(n).ok_or(RouteCatalogError::Malformed)?;
+        let value = self.bytes.get(self.at..end).ok_or(RouteCatalogError::Malformed)?;
+        self.at = end;
+        Ok(value)
+    }
+    fn u32(&mut self) -> Result<u32, RouteCatalogError> {
+        Ok(u32::from_be_bytes(self.take(4)?.try_into().unwrap()))
+    }
+    fn u64(&mut self) -> Result<u64, RouteCatalogError> {
+        Ok(u64::from_be_bytes(self.take(8)?.try_into().unwrap()))
+    }
+    fn bound(&mut self) -> Result<Option<Vec<u8>>, RouteCatalogError> {
+        let n = usize::try_from(self.u32()?).map_err(|_| RouteCatalogError::Malformed)?;
+        if n == 0 {
+            return Ok(None);
+        }
+        Ok(Some(self.take(n)?.to_vec()))
+    }
+}
+
+/// Decodes and validates a complete route catalog.
+pub(crate) fn decode_catalog(bytes: &[u8]) -> Result<RouteCatalog, RouteCatalogError> {
+    if bytes.len() > MAX_BYTES {
+        return Err(RouteCatalogError::Malformed);
+    }
+    let mut r = Reader { bytes, at: 0 };
+    if r.take(1)?[0] != VERSION {
+        return Err(RouteCatalogError::Malformed);
+    }
+    let generation = r.u64()?;
+    let count = usize::try_from(r.u32()?).map_err(|_| RouteCatalogError::Malformed)?;
+    if count == 0 || count > MAX_ROUTES {
+        return Err(RouteCatalogError::Malformed);
+    }
+    let mut routes = Vec::with_capacity(count);
+    let mut ids = std::collections::BTreeSet::new();
+    for _ in 0..count {
+        let id = r.u64()?;
+        if id == 0 || !ids.insert(id) {
+            return Err(RouteCatalogError::Malformed);
+        }
+        let route = ShardRoute::new(id, r.bound()?, r.bound()?)
+            .map_err(|_| RouteCatalogError::Malformed)?;
+        routes.push(route);
+    }
+    if r.at != bytes.len() {
+        return Err(RouteCatalogError::Malformed);
+    }
+    let table = RouteTable::new(routes)
+        .map_err(|_| RouteCatalogError::Malformed)?
+        .with_generation(generation);
+    Ok(RouteCatalog { table, generation })
+}
+
+fn value(bytes: &[u8]) -> DocumentValue {
+    DocumentValue::String(hex::encode(bytes))
+}
+fn bytes(value: Option<DocumentValue>) -> Result<Option<Vec<u8>>, RouteCatalogError> {
+    let Some(value) = value else {
+        return Ok(None);
+    };
+    let DocumentValue::String(value) = value else {
+        return Err(RouteCatalogError::Malformed);
+    };
+    hex::decode(value).map(Some).map_err(|_| RouteCatalogError::Malformed)
+}
+
+impl Engine {
+    /// Loads the authoritative serving router for an admitted database.
+    /// Catalog decoding remains engine-owned; callers receive only the
+    /// validated router and its durable generation.
+    pub fn load_shard_router(
+        &self,
+        scope: &TenantScope,
+    ) -> Result<Option<(crate::shard_split::ShardRouter, u64)>, EngineError> {
+        let incarnation = u128::from_be_bytes(self.database_id().as_bytes().to_owned());
+        Ok(self
+            .load_shard_route_catalog(scope, incarnation)
+            .map_err(|_| EngineError::StorageFailure)?
+            .map(|catalog| {
+                (crate::shard_split::ShardRouter::from_table(catalog.table), catalog.generation)
+            }))
+    }
+
+    pub(crate) fn validate_shard_admission(
+        &self,
+        scope: &TenantScope,
+        token: &ShardAdmissionToken,
+        writes: &[crate::storage::StagedWrite],
+    ) -> Result<(), EngineError> {
+        let incarnation = u128::from_be_bytes(self.database_id().as_bytes().to_owned());
+        if token.database_incarnation != incarnation || token.shard_id == 0 || token.keys.is_empty()
+        {
+            return Err(EngineError::Conflict);
+        }
+        let Some(catalog) = self
+            .load_shard_route_catalog(scope, token.database_incarnation)
+            .map_err(|_| EngineError::StorageFailure)?
+        else {
+            return Err(EngineError::Conflict);
+        };
+        (catalog.generation == token.route_generation
+            && token.keys.iter().all(|key| catalog.table.route(key) == Some(token.shard_id))
+            && writes.iter().all(|write| {
+                token.keys.iter().any(|key| write.document_id().as_str().as_bytes() == key)
+            }))
+        .then_some(())
+        .ok_or(EngineError::Conflict)
+    }
+
+    pub(crate) fn shard_catalog_exists(&self, scope: &TenantScope) -> Result<bool, EngineError> {
+        Ok(self
+            .load_shard_route_catalog(
+                scope,
+                u128::from_be_bytes(self.database_id().as_bytes().to_owned()),
+            )
+            .map_err(|_| EngineError::StorageFailure)?
+            .is_some())
+    }
+    /// Loads the route catalog for a database incarnation from a snapshot.
+    /// Reservation-free: the origin-commit fast path calls this on every
+    /// commit, so it must not reserve the shared `route-load` operation
+    /// identity. Reserving it turned concurrent distinct-document commits
+    /// into spurious `Conflict` rejections via the fail-closed
+    /// `unwrap_or(true)` in the commit path.
+    pub(crate) fn load_shard_route_catalog(
+        &self,
+        scope: &TenantScope,
+        incarnation: u128,
+    ) -> Result<Option<RouteCatalog>, RouteCatalogError> {
+        let snapshot = self.read_snapshot(scope)?;
+        let value = self
+            .lock_storage()
+            .map_err(RouteCatalogError::from)?
+            .port
+            .private_metadata_at(scope.tenant(), &key(incarnation), snapshot.sequence())
+            .map_err(|()| RouteCatalogError::Engine(EngineError::StorageFailure))?;
+        bytes(value).and_then(|value| value.map_or(Ok(None), |raw| decode_catalog(&raw).map(Some)))
+    }
+
+    /// Atomically installs route bytes and the durable cutover split record.
+    pub(crate) fn install_shard_route_catalog(
+        &self,
+        scope: &TenantScope,
+        incarnation: u128,
+        expected: Option<&[u8]>,
+        replacement: &[u8],
+        split: &DurableSplitState,
+        operation: OperationId,
+    ) -> Result<u64, RouteCatalogError> {
+        let catalog = decode_catalog(replacement)?;
+        let mut tx = self.begin(scope, self.read_snapshot(scope)?, operation)?;
+        let current = bytes(tx.read_private_metadata(&key(incarnation))?)?;
+        if current.as_deref() == Some(replacement) {
+            return Ok(catalog.generation);
+        }
+        if current.as_deref() != expected {
+            return Err(RouteCatalogError::Conflict);
+        }
+        tx.put_private_metadata(&key(incarnation), value(replacement))?;
+        tx.put_private_metadata(&split_key(incarnation), value(&split.encode()))?;
+        match tx.commit(LocalDurability::Synced) {
+            CommitOutcome::Committed(_) => Ok(catalog.generation),
+            CommitOutcome::Rejected(CommitError::Conflict) => Err(RouteCatalogError::Conflict),
+            CommitOutcome::Rejected(error) => Err(RouteCatalogError::Engine(match error {
+                CommitError::Validation => EngineError::InvalidDocument,
+                CommitError::OperationIdReuse { .. } => EngineError::Conflict,
+                CommitError::EngineClosed => EngineError::Closed(super::EngineClosed),
+                CommitError::UsageRequiresSynced => EngineError::InvalidDocument,
+                CommitError::StorageFailure => EngineError::StorageFailure,
+                CommitError::Conflict => EngineError::Conflict,
+            })),
+            CommitOutcome::Unknown(_) => {
+                Err(RouteCatalogError::Engine(EngineError::StorageFailure))
+            }
+        }
+    }
+
+    /// Installs a fenced split route and its cut-over record atomically.
+    pub(crate) fn install_shard_split_route(
+        &self,
+        scope: &TenantScope,
+        context: &CutoverContext,
+        state: &DurableSplitState,
+        operation: OperationId,
+    ) -> Result<u64, RouteCatalogError> {
+        if !context.permit.is_valid() || state.context() != Some(context.split) {
+            return Err(RouteCatalogError::Malformed);
+        }
+        if context.permit.required() < context.drained_through
+            || state.source_high_water() > context.drained_through
+            || state.acked_through() > context.drained_through
+            || state.target_applied_through() < context.drained_through
+        {
+            return Err(RouteCatalogError::Conflict);
+        }
+        let _fence = self
+            .origin_commit_barrier
+            .write()
+            .map_err(|_| RouteCatalogError::Engine(EngineError::StorageFailure))?;
+        // A writer may have committed before this exclusive fence was
+        // acquired while the split worker still carried the old watermark.
+        // The published sequence is the engine's durable upper bound for all
+        // origin writes, so the target must cover it before cutover proceeds.
+        if context.drained_through < self.published_sequence()?.get() {
+            return Err(RouteCatalogError::Conflict);
+        }
+        let mut tx = self.begin(scope, self.read_snapshot(scope)?, operation)?;
+        tx.internal_maintenance = true;
+        let route_key = key(context.split.database_incarnation());
+        let current =
+            bytes(tx.read_private_metadata(&route_key)?)?.ok_or(RouteCatalogError::Malformed)?;
+        let catalog = decode_catalog(&current)?;
+        if catalog.generation != context.route_generation {
+            return Err(RouteCatalogError::Conflict);
+        }
+        let mut table = catalog.table;
+        table
+            .split(
+                context.split.source_shard(),
+                context.split.target_shard(),
+                state.split_key().to_vec(),
+                context.permit,
+            )
+            .map_err(|_| RouteCatalogError::Conflict)?;
+        let generation = catalog.generation.checked_add(1).ok_or(RouteCatalogError::Malformed)?;
+        let replacement = encode_catalog(&RouteCatalog { table, generation })?;
+        let mut lifecycle = ShardSplit::from_durable_state(state.clone())
+            .map_err(|_| RouteCatalogError::Malformed)?;
+        lifecycle.cut_over_with_permit(context.permit).map_err(|_| RouteCatalogError::Conflict)?;
+        tx.put_private_metadata(&route_key, value(&replacement))?;
+        tx.put_private_metadata(
+            &split_key(context.split.database_incarnation()),
+            value(&lifecycle.durable_state().encode()),
+        )?;
+        match tx.commit(LocalDurability::Synced) {
+            CommitOutcome::Committed(_) => Ok(generation),
+            CommitOutcome::Rejected(CommitError::Conflict) => Err(RouteCatalogError::Conflict),
+            CommitOutcome::Rejected(error) => Err(RouteCatalogError::Engine(match error {
+                CommitError::Validation => EngineError::InvalidDocument,
+                CommitError::OperationIdReuse { .. } => EngineError::Conflict,
+                CommitError::EngineClosed => EngineError::Closed(super::EngineClosed),
+                CommitError::UsageRequiresSynced => EngineError::InvalidDocument,
+                CommitError::StorageFailure => EngineError::StorageFailure,
+                CommitError::Conflict => EngineError::Conflict,
+            })),
+            CommitOutcome::Unknown(_) => {
+                Err(RouteCatalogError::Engine(EngineError::StorageFailure))
+            }
+        }
+    }
+
+    /// Recovers the durable route receipt and authoritative catalog together.
+    pub(crate) fn recover_shard_split_route(
+        &self,
+        scope: &TenantScope,
+        split: &crate::shard_split::SplitContext,
+    ) -> Result<Option<(CommittedSplitRoute, RouteCatalog)>, RouteCatalogError> {
+        let tx = self.begin(
+            scope,
+            self.read_snapshot(scope)?,
+            OperationId::try_new("route-recover").map_err(|_| RouteCatalogError::Malformed)?,
+        )?;
+        let catalog = bytes(tx.read_private_metadata(&key(split.database_incarnation()))?)?
+            .map(|raw| decode_catalog(&raw))
+            .transpose()?;
+        let Some(catalog) = catalog else {
+            return Ok(None);
+        };
+        let Some(raw) = bytes(tx.read_private_metadata(&split_key(split.database_incarnation()))?)?
+        else {
+            return Ok(None);
+        };
+        let state = DurableSplitState::decode(&raw).map_err(|_| RouteCatalogError::Malformed)?;
+        if state.context() != Some(*split)
+            || !matches!(state.phase(), SplitPhase::CutOver | SplitPhase::Complete)
+        {
+            return Ok(None);
+        }
+        Ok(Some((
+            CommittedSplitRoute {
+                split: *split,
+                generation: catalog.generation,
+                route: catalog.table.clone(),
+            },
+            catalog,
+        )))
+    }
+}
diff --git a/src/engine/shard_split_tests.rs b/src/engine/shard_split_tests.rs
new file mode 100644
index 00000000..551f0ece
--- /dev/null
+++ b/src/engine/shard_split_tests.rs
@@ -0,0 +1,106 @@
+use super::shard_split::{RouteCatalog, RouteCatalogError, decode_catalog, encode_catalog};
+use crate::shard_split::{
+    CutoverContext, DurableSplitState, RouteTable, ShardRoute, ShardSplit, SplitContext,
+    SplitEngineAdapter, SplitPhase, WriterFence,
+};
+
+#[test]
+fn encrypted_target_creation_is_durable_and_exactly_idempotent() {
+    let (dir, source, tenant) = super::tests::open_owned_engine("split-target-lifecycle");
+    let scope = source.scope_for(&tenant);
+    let source = std::sync::Arc::new(source);
+    let incarnation = u128::from_be_bytes(source.database_id().as_bytes().to_owned());
+    let context = SplitContext::new(7, incarnation, 11, 12, 3, 0);
+    let mut split = ShardSplit::plan_with_context(Some(b"a".to_vec()), b"m".to_vec(), context)
+        .expect("split plan");
+    split.begin_backfill().expect("backfill");
+    let mut adapter = super::shard_split::ScopedShardEngine::new(source.clone(), scope).unwrap();
+    adapter.save(&split.durable_state()).expect("durable split state");
+    adapter.create_split_target(&context).expect("first target create");
+    adapter.create_split_target(&context).expect("idempotent target create");
+    let target_path = dir.join("shards").join("000000000000000c.sqlite3");
+    assert!(target_path.is_dir(), "target is an Engine durable location");
+    drop(adapter);
+    drop(source);
+    let _ = std::fs::remove_dir_all(dir);
+}
+
+#[test]
+fn catalog_codec_round_trip_and_rejects_bad_inputs() {
+    let table = RouteTable::new(vec![
+        ShardRoute::new(1, None, Some(b"m".to_vec())).unwrap(),
+        ShardRoute::new(2, Some(b"m".to_vec()), None).unwrap(),
+    ])
+    .unwrap();
+    let catalog = RouteCatalog { table: table.with_generation(7), generation: 7 };
+    let encoded = encode_catalog(&catalog).unwrap();
+    assert_eq!(decode_catalog(&encoded).unwrap(), catalog);
+    for bad in [vec![], vec![2], {
+        let mut value = encoded.clone();
+        value.push(0);
+        value
+    }] {
+        assert_eq!(decode_catalog(&bad), Err(RouteCatalogError::Malformed));
+    }
+    let mut duplicate = encoded.clone();
+    duplicate[30..38].copy_from_slice(&1_u64.to_be_bytes());
+    assert_eq!(decode_catalog(&duplicate), Err(RouteCatalogError::Malformed));
+}
+
+#[test]
+fn split_cutover_refuses_drain_ahead_of_target_without_changing_route() {
+    let (dir, engine) = super::tests::open_engine("split-cutover-watermark");
+    let scope = super::tests::tenant_scope(&engine, "split-cutover-watermark");
+    let incarnation = u128::from_be_bytes(engine.database_id().as_bytes().to_owned());
+    let initial = RouteCatalog { table: RouteTable::single(1), generation: 0 };
+    let initial_bytes = encode_catalog(&initial).unwrap();
+    engine
+        .install_shard_route_catalog(
+            &scope,
+            incarnation,
+            None,
+            &initial_bytes,
+            &DurableSplitState::new(None, b"m".to_vec(), 0, 0, 0, SplitPhase::Planned),
+            super::tests::operation("split-route-init"),
+        )
+        .unwrap();
+
+    let context = SplitContext::new(1, incarnation, 1, 2, 1, 0);
+    let mut split = ShardSplit::plan_with_context(None, b"m".to_vec(), context).unwrap();
+    split.begin_backfill().unwrap();
+    split.begin_catch_up(1).unwrap();
+    split.note_source_high_water(1);
+    split.note_acked(1);
+    split.note_target_applied(1);
+    let mut fence = WriterFence::new();
+    fence.begin_drain(5).unwrap();
+    let permit = fence.try_fence(5).unwrap();
+    let cutover =
+        CutoverContext { split: context, route_generation: 0, drained_through: 5, permit };
+
+    assert_eq!(
+        engine.install_shard_split_route(
+            &scope,
+            &cutover,
+            &split.durable_state(),
+            super::tests::operation("split-route-stale-target"),
+        ),
+        Err(RouteCatalogError::Conflict)
+    );
+    assert_eq!(engine.load_shard_router(&scope).unwrap().unwrap().0.route(b"a"), Some(1));
+
+    split.note_target_applied(5);
+    let generation = engine
+        .install_shard_split_route(
+            &scope,
+            &cutover,
+            &split.durable_state(),
+            super::tests::operation("split-route-caught-up"),
+        )
+        .unwrap();
+    assert_eq!(generation, 1);
+    assert_eq!(engine.load_shard_router(&scope).unwrap().unwrap().0.route(b"a"), Some(2));
+    assert_eq!(engine.load_shard_router(&scope).unwrap().unwrap().0.route(b"z"), Some(1));
+    drop(engine);
+    let _ = std::fs::remove_dir_all(dir);
+}
diff --git a/src/engine/shard_supervisor.rs b/src/engine/shard_supervisor.rs
new file mode 100644
index 00000000..865f8785
--- /dev/null
+++ b/src/engine/shard_supervisor.rs
@@ -0,0 +1,232 @@
+//! Engine-owned online shard split worker.
+//!
+//! This is the production call graph for a split: the durable lifecycle
+//! runtime admits the operation, the snapshot copier fills the target, the
+//! retained publication journal catches up its tail, and the runtime performs
+//! the fenced route CAS.  Callers advance it in bounded steps so a worker
+//! cannot monopolize the engine.
+
+use std::sync::Arc;
+
+use crate::shard_split::{
+    RangeCopier, ShardRouter, ShardSplit, SplitOrchestratorAdapter, SplitPhase, SplitRuntime,
+    SplitRuntimeError, WriterFence,
+};
+
+use super::{
+    shard_catchup::ShardJournalCatchUp,
+    shard_split::{
+        RouteCatalogError, ScopedShardEngine, ScopedShardRangeSource, ScopedShardRangeTarget,
+    },
+    Engine, EngineError,
+};
+use crate::types::TenantScope;
+
+/// Work completed by one supervisor step.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum SplitStep {
+    /// A bounded snapshot or journal page was applied.
+    Progress,
+    /// The route was cut over, verified, and the split completed.
+    Complete { generation: u64 },
+}
+
+/// Failure while driving the real engine split path.
+#[derive(Debug, Eq, PartialEq)]
+pub(crate) enum SplitSupervisorError<OE> {
+    /// The generic runtime rejected lifecycle, placement, or route work.
+    Runtime(SplitRuntimeError<RouteCatalogError, EngineError, RouteCatalogError, OE>),
+    /// The engine journal could not provide a complete bounded tail page.
+    CatchUp(super::shard_catchup::ShardCatchUpError),
+    /// The target could not be opened.
+    TargetOpen(super::EngineOpenError),
+    /// No durable route exists from which to admit a newly started worker.
+    MissingRoute,
+}
+
+/// Drives one admitted database split through the production adapters.
+pub(crate) struct ShardSplitSupervisor<O>
+where
+    O: SplitOrchestratorAdapter,
+{
+    runtime: SplitRuntime<ScopedShardEngine, O>,
+    engine: Arc<Engine>,
+    source: ScopedShardRangeSource,
+    target: Arc<Engine>,
+    copier: Option<RangeCopier>,
+    catchup: Option<ShardJournalCatchUp>,
+    fence: WriterFence,
+    scope: TenantScope,
+}
+
+impl<O> ShardSplitSupervisor<O>
+where
+    O: SplitOrchestratorAdapter,
+{
+    /// Admits a new split and opens the real source and target adapters.
+    pub(crate) fn start(
+        engine: Arc<Engine>,
+        scope: TenantScope,
+        split: ShardSplit,
+        orchestrator: O,
+        router: ShardRouter,
+    ) -> Result<Self, SplitSupervisorError<O::Error>> {
+        let adapter = ScopedShardEngine::new(Arc::clone(&engine), scope.clone())
+            .map_err(|_| SplitSupervisorError::MissingRoute)?;
+        let target = Arc::new(
+            adapter
+                .open_target(&split.context().ok_or(SplitSupervisorError::MissingRoute)?)
+                .map_err(SplitSupervisorError::TargetOpen)?,
+        );
+        let source = ScopedShardRangeSource::new(Arc::clone(&engine), &scope)
+            .map_err(|_| SplitSupervisorError::MissingRoute)?;
+        let mut runtime = SplitRuntime::new(adapter, orchestrator, router);
+        runtime.admit(split).map_err(SplitSupervisorError::Runtime)?;
+        let state = runtime.split().expect("admitted split").durable_state();
+        let copier =
+            RangeCopier::new(state.lower().map(ToOwned::to_owned), state.split_key().to_vec())
+                .map_err(|_| SplitSupervisorError::MissingRoute)?;
+        Ok(Self {
+            runtime,
+            engine,
+            source,
+            target,
+            copier: Some(copier),
+            catchup: None,
+            fence: WriterFence::new(),
+            scope,
+        })
+    }
+
+    /// Reopens a durable split after a process restart.
+    pub(crate) fn resume(
+        engine: Arc<Engine>,
+        scope: TenantScope,
+        orchestrator: O,
+        router: ShardRouter,
+    ) -> Result<Option<Self>, SplitSupervisorError<O::Error>> {
+        let adapter = ScopedShardEngine::new(Arc::clone(&engine), scope.clone())
+            .map_err(|_| SplitSupervisorError::MissingRoute)?;
+        let mut runtime = SplitRuntime::new(adapter, orchestrator, router);
+        if !runtime.resume().map_err(SplitSupervisorError::Runtime)? {
+            return Ok(None);
+        }
+        let split = runtime.split().expect("resumed split");
+        let context = split.context().ok_or(SplitSupervisorError::MissingRoute)?;
+        let target = Arc::new(
+            ScopedShardEngine::new(Arc::clone(&engine), scope.clone())
+                .map_err(|_| SplitSupervisorError::MissingRoute)?
+                .open_target(&context)
+                .map_err(SplitSupervisorError::TargetOpen)?,
+        );
+        let source = ScopedShardRangeSource::new(Arc::clone(&engine), &scope)
+            .map_err(|_| SplitSupervisorError::MissingRoute)?;
+        let (copier, catchup) = match split.phase() {
+            SplitPhase::Planned | SplitPhase::Backfilling => (
+                Some(
+                    RangeCopier::new(
+                        split.lower().map(ToOwned::to_owned),
+                        split.split_key().to_vec(),
+                    )
+                    .map_err(|_| SplitSupervisorError::MissingRoute)?,
+                ),
+                None,
+            ),
+            SplitPhase::CatchingUp => (
+                None,
+                Some(
+                    ShardJournalCatchUp::new(
+                        Arc::clone(&engine),
+                        Arc::clone(&target),
+                        scope.clone(),
+                        target.scope_for(scope.tenant()),
+                        &split.durable_state(),
+                        split.durable_state().target_applied_through(),
+                    )
+                    .map_err(SplitSupervisorError::CatchUp)?,
+                ),
+            ),
+            SplitPhase::CutOver | SplitPhase::Complete | SplitPhase::Aborted => (None, None),
+        };
+        Ok(Some(Self {
+            runtime,
+            engine,
+            source,
+            target,
+            copier,
+            catchup,
+            fence: WriterFence::new(),
+            scope,
+        }))
+    }
+
+    /// Applies one bounded page and advances the split state machine.
+    pub(crate) fn step(
+        &mut self,
+        copy_limit: usize,
+        catchup_limit: u32,
+    ) -> Result<SplitStep, SplitSupervisorError<O::Error>> {
+        if let Some(copier) = &mut self.copier {
+            let mut target = ScopedShardRangeTarget::open(Arc::clone(&self.target), &self.scope);
+            if !copier
+                .step(&mut self.source, &mut target, copy_limit)
+                .map_err(|_| SplitSupervisorError::MissingRoute)?
+            {
+                return Ok(SplitStep::Progress);
+            }
+            let state = self.runtime.split().expect("active split").durable_state();
+            let through = self.source_boundary()?;
+            self.runtime.begin_catch_up(through).map_err(SplitSupervisorError::Runtime)?;
+            self.catchup = Some(
+                ShardJournalCatchUp::new(
+                    Arc::clone(&self.engine),
+                    Arc::clone(&self.target),
+                    self.scope.clone(),
+                    self.target.scope_for(self.scope.tenant()),
+                    &state,
+                    0,
+                )
+                .map_err(SplitSupervisorError::CatchUp)?,
+            );
+            self.copier = None;
+            return Ok(SplitStep::Progress);
+        }
+        if let Some(catchup) = &mut self.catchup {
+            let count = catchup.step(catchup_limit).map_err(SplitSupervisorError::CatchUp)?;
+            let high = catchup.source_high_water().map_err(SplitSupervisorError::CatchUp)?;
+            self.runtime
+                .note_frontiers(high, catchup.applied_through(), high)
+                .map_err(SplitSupervisorError::Runtime)?;
+            if count > 0 || catchup.applied_through() < high {
+                return Ok(SplitStep::Progress);
+            }
+            self.fence.begin_drain(high).map_err(|_| SplitSupervisorError::MissingRoute)?;
+            self.fence.note_acked(high).map_err(|_| SplitSupervisorError::MissingRoute)?;
+            let permit = self
+                .fence
+                .try_fence(catchup.applied_through())
+                .map_err(|_| SplitSupervisorError::MissingRoute)?;
+            let generation =
+                self.runtime.cut_over(permit, high).map_err(SplitSupervisorError::Runtime)?;
+            self.runtime.complete().map_err(SplitSupervisorError::Runtime)?;
+            self.catchup = None;
+            return Ok(SplitStep::Complete { generation });
+        }
+        let generation = self
+            .runtime
+            .split()
+            .and_then(|split| {
+                (split.phase() == SplitPhase::Complete)
+                    .then(|| self.runtime.router().table().generation())
+            })
+            .ok_or(SplitSupervisorError::MissingRoute)?;
+        Ok(SplitStep::Complete { generation })
+    }
+
+    fn source_boundary(&self) -> Result<u64, SplitSupervisorError<O::Error>> {
+        self.engine
+            .journaled_high_water()
+            .map_err(|_| SplitSupervisorError::MissingRoute)
+            .map(|sequence| sequence.map_or(0, |sequence| sequence.get()))
+    }
+}
