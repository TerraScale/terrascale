@@ -0,0 +1,35 @@
+//! COPS admission over the engine's durable per-origin prefixes.
+use super::{Engine, EngineError, merge};
+use crate::types::TenantScope;
+
+impl Engine {
+    /// Returns the durable local origin identity used by complete publication tailers.
+    /// # Errors
+    /// Returns storage failure when the storage lock is unavailable.
+    pub fn replication_origin(&self) -> Result<String, EngineError> {
+        Ok(self.lock_storage()?.port.local_replication_origin().to_owned())
+    }
+
+    /// Checks causal admission for an atomic source publication.
+    /// # Errors
+    /// Rejects invalid scope, metadata or unavailable durable frontier.
+    pub fn replication_publication_dependencies_ready(
+        &self,
+        scope: &TenantScope,
+        publication: &super::ReplicatedPublication,
+    ) -> Result<bool, EngineError> {
+        self.validate_scope(scope)?;
+        let context =
+            merge::decode_context(&publication.context).ok_or(EngineError::InvalidDocument)?;
+        if publication.origin.is_empty() || publication.origin_sequence == 0 {
+            return Err(EngineError::InvalidDocument);
+        }
+        let frontier = self.durable_origin_prefixes(scope)?;
+        Ok(frontier.get(&publication.origin).copied().unwrap_or(0)
+            >= publication.origin_sequence.saturating_sub(1)
+            && context
+                .frontier()
+                .iter()
+                .all(|(origin, sequence)| frontier.get(origin).copied().unwrap_or(0) >= *sequence))
+    }
+}
diff --git a/src/engine/replication_outbox.rs b/src/engine/replication_outbox.rs
new file mode 100644
index 00000000..33874617
--- /dev/null
+++ b/src/engine/replication_outbox.rs
@@ -0,0 +1,106 @@
+//! Retained original transaction groups for trusted regional replication.
+
+use super::{Engine, EngineError, ReplicatedPublication};
+use crate::types::TenantScope;
+
+impl Engine {
+    /// Reads complete original source groups, including forwarded peer groups.
+    ///
+    /// Results carry their local durable cursor, while each publication retains
+    /// its source origin, sequence, values, and private controls before merging.
+    /// Pages contain at most 1024 groups and 64 MiB of encoded bodies.
+    ///
+    /// # Errors
+    /// Returns a scope, closed-engine, invalid-limit or bounded storage failure.
+    pub fn replication_publications(
+        &self,
+        scope: &TenantScope,
+        after_local_sequence: u64,
+        limit: u32,
+    ) -> Result<Vec<(u64, ReplicatedPublication)>, EngineError> {
+        self.validate_scope(scope)?;
+        if !(1..=1024).contains(&limit) {
+            return Err(EngineError::SnapshotPageLimitExceeded);
+        }
+        self.lock_storage()?
+            .port
+            .replication_publications(scope.tenant(), after_local_sequence, limit)
+            .map_err(|()| EngineError::StorageFailure)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{
+        engine::{CommitOutcome, EngineConfig},
+        types::{
+            CollectionName, Document, DocumentId, DocumentValue, ExpectedVersion, LocalDurability,
+            OperationId, TenantId,
+        },
+    };
+
+    #[test]
+    fn retained_publication_outbox_keeps_original_values_and_private_controls() {
+        let path = std::env::temp_dir().join(format!(
+            "terrabase-outbox-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()
+        ));
+        let engine = Engine::open(EngineConfig::durable(&path).unwrap()).unwrap();
+        let scope = engine.scope_for(&TenantId::try_new("tenant").unwrap());
+        for (operation, value) in [("first", 1), ("second", 2)] {
+            let mut transaction = engine
+                .begin(
+                    &scope,
+                    engine.read_snapshot(&scope).unwrap(),
+                    OperationId::try_new(operation).unwrap(),
+                )
+                .unwrap();
+            transaction
+                .put(
+                    Document::new(
+                        DocumentId::try_new("id").unwrap(),
+                        CollectionName::try_new("users").unwrap(),
+                        DocumentValue::Integer(value),
+                    ),
+                    ExpectedVersion::Any,
+                )
+                .unwrap();
+            transaction.put_private_metadata("control", DocumentValue::Integer(value)).unwrap();
+            assert!(matches!(
+                transaction.commit(LocalDurability::Synced),
+                CommitOutcome::Committed(_)
+            ));
+        }
+        let groups = engine.replication_publications(&scope, 0, 10).unwrap();
+        assert_eq!(groups.len(), 2);
+        assert_eq!(groups[0].1.records[0].body, DocumentValue::Integer(1));
+        assert_eq!(groups[1].1.records[0].body, DocumentValue::Integer(2));
+        assert_eq!(groups[1].1.origin_sequence, groups[0].1.origin_sequence + 1);
+        let first_controls =
+            crate::storage::decode_private_changes(&groups[0].1.private_payload).unwrap();
+        assert_eq!(first_controls.0[0].value, Some(DocumentValue::Integer(1)));
+        let fingerprint = groups[0].1.fingerprint().unwrap();
+        assert!(
+            engine
+                .replication_publications(
+                    &engine.scope_for(&TenantId::try_new("other").unwrap()),
+                    0,
+                    10
+                )
+                .unwrap()
+                .is_empty()
+        );
+        assert_eq!(engine.replication_publications(&scope, groups[0].0, 10).unwrap().len(), 1);
+        engine.shutdown().unwrap();
+        let engine = Engine::open(EngineConfig::durable(&path).unwrap()).unwrap();
+        let scope = engine.scope_for(&TenantId::try_new("tenant").unwrap());
+        assert_eq!(
+            engine.replication_publications(&scope, 0, 10).unwrap()[0].1.fingerprint().unwrap(),
+            fingerprint
+        );
+        engine.shutdown().unwrap();
+        std::fs::remove_dir_all(path).unwrap();
+    }
+}
diff --git a/src/engine/replication_wire.rs b/src/engine/replication_wire.rs
new file mode 100644
index 00000000..575ad1d9
--- /dev/null
+++ b/src/engine/replication_wire.rs
@@ -0,0 +1,129 @@
+//! Bounded full-publication wire codec, independent of the small lane envelope.
+use super::{EngineError, ReplicatedPublication, ReplicatedRecord};
+use super::{MAX_REPLICATION_PUBLICATION_BYTES as MAX_BYTES, MAX_REPLICATION_PUBLICATION_RECORDS};
+use crate::types::{CollectionName, DocumentId, DocumentValue};
+fn invalid() -> EngineError {
+    EngineError::InvalidDocument
+}
+fn field(out: &mut Vec<u8>, bytes: &[u8]) -> Result<(), EngineError> {
+    if out.len().saturating_add(bytes.len()).saturating_add(4) > MAX_BYTES {
+        return Err(invalid());
+    }
+    out.extend_from_slice(&u32::try_from(bytes.len()).map_err(|_| invalid())?.to_be_bytes());
+    out.extend_from_slice(bytes);
+    Ok(())
+}
+fn take<'a>(bytes: &mut &'a [u8], len: usize) -> Result<&'a [u8], EngineError> {
+    let value = bytes.get(..len).ok_or_else(invalid)?;
+    *bytes = &bytes[len..];
+    Ok(value)
+}
+fn take_field<'a>(bytes: &mut &'a [u8]) -> Result<&'a [u8], EngineError> {
+    let length = u32::from_be_bytes(take(bytes, 4)?.try_into().map_err(|_| invalid())?) as usize;
+    take(bytes, length)
+}
+fn text(bytes: &[u8]) -> Result<String, EngineError> {
+    String::from_utf8(bytes.to_vec()).map_err(|_| invalid())
+}
+impl ReplicatedPublication {
+    /// Encodes one complete bounded source transaction for fragmentation.
+    /// # Errors
+    /// Rejects invalid publication fields or encoded groups beyond 64 MiB.
+    pub fn encode_wire(&self) -> Result<Vec<u8>, EngineError> {
+        self.fingerprint()?;
+        let mut out = b"TBGP1".to_vec();
+        field(&mut out, self.origin.as_bytes())?;
+        field(&mut out, self.commit_ulid.as_bytes())?;
+        field(&mut out, &self.context)?;
+        field(&mut out, &self.private_payload)?;
+        out.extend_from_slice(&self.origin_sequence.to_be_bytes());
+        out.extend_from_slice(&self.hlc.to_be_bytes());
+        out.extend_from_slice(
+            &u32::try_from(self.records.len()).map_err(|_| invalid())?.to_be_bytes(),
+        );
+        for record in &self.records {
+            field(&mut out, record.collection.as_str().as_bytes())?;
+            field(&mut out, record.id.as_str().as_bytes())?;
+            out.push(u8::from(record.deleted));
+            let body = if record.deleted {
+                Vec::new()
+            } else {
+                crate::storage::encode_private_value(&record.body).ok_or_else(invalid)?
+            };
+            field(&mut out, &body)?;
+        }
+        if out.len() > MAX_BYTES {
+            return Err(invalid());
+        }
+        Ok(out)
+    }
+    /// Decodes exactly one complete transaction, rejecting trailing bytes.
+    /// # Errors
+    /// Rejects malformed, oversized or inconsistent causal source data.
+    pub fn decode_wire(mut bytes: &[u8]) -> Result<Self, EngineError> {
+        if bytes.len() > MAX_BYTES || take(&mut bytes, 5)? != b"TBGP1" {
+            return Err(invalid());
+        }
+        let origin = text(take_field(&mut bytes)?)?;
+        let commit_ulid = text(take_field(&mut bytes)?)?;
+        let context = take_field(&mut bytes)?.to_vec();
+        let private_payload = take_field(&mut bytes)?.to_vec();
+        let origin_sequence =
+            u64::from_be_bytes(take(&mut bytes, 8)?.try_into().map_err(|_| invalid())?);
+        let hlc = u64::from_be_bytes(take(&mut bytes, 8)?.try_into().map_err(|_| invalid())?);
+        let count =
+            u32::from_be_bytes(take(&mut bytes, 4)?.try_into().map_err(|_| invalid())?) as usize;
+        if count > MAX_REPLICATION_PUBLICATION_RECORDS || count > bytes.len() / 13 {
+            return Err(invalid());
+        }
+        // Causal metadata is repeated in the engine's owned record representation.
+        // Refuse wire-level fanout that would amplify a tiny header into GiBs.
+        let shared_bytes =
+            origin.len().saturating_add(commit_ulid.len()).saturating_add(context.len());
+        if count
+            .checked_mul(shared_bytes)
+            .and_then(|metadata| metadata.checked_add(bytes.len()))
+            .is_none_or(|expanded| expanded > MAX_BYTES)
+        {
+            return Err(invalid());
+        }
+        let mut records = Vec::with_capacity(count);
+        for _ in 0..count {
+            let collection =
+                CollectionName::try_new(&text(take_field(&mut bytes)?)?).map_err(|_| invalid())?;
+            let id = DocumentId::try_new(&text(take_field(&mut bytes)?)?).map_err(|_| invalid())?;
+            let deleted = match take(&mut bytes, 1)?[0] {
+                0 => false,
+                1 => true,
+                _ => return Err(invalid()),
+            };
+            let raw = take_field(&mut bytes)?;
+            let body = if deleted {
+                if !raw.is_empty() {
+                    return Err(invalid());
+                }
+                DocumentValue::Null
+            } else {
+                crate::storage::decode_private_value(raw).ok_or_else(invalid)?
+            };
+            records.push(ReplicatedRecord {
+                collection,
+                id,
+                body,
+                deleted,
+                origin: origin.clone(),
+                origin_sequence,
+                hlc,
+                commit_ulid: commit_ulid.clone(),
+                context: context.clone(),
+            });
+        }
+        if !bytes.is_empty() {
+            return Err(invalid());
+        }
+        let publication =
+            Self { origin, origin_sequence, hlc, commit_ulid, context, records, private_payload };
+        publication.fingerprint()?;
+        Ok(publication)
+    }
+}
