+        None if public.origin_proof_previous_key_file.is_some() => Err(Box::new(
+            DaemonError::Engine("origin-proof previous key requires a current key".into()),
+        )),
+        None => Ok(crate::reactive_api::OriginProofKeyRing::default()),
+    }
+}
