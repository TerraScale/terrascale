+            vfs.name(),
+        )
+        .unwrap();
+        connection
+            .execute_batch(
+                "PRAGMA temp_store=MEMORY; PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL;",
+            )
+            .unwrap();
+        connection
+    }
