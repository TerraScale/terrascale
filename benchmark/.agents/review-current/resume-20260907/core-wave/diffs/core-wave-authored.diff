+    drop(engine);
+    let reopened = reopen_engine(&dir);
+    assert_eq!(reopened.auto_index_lifecycle_snapshot(&owner, None, 10).unwrap(), snapshot);
+    drop(reopened);
+    std::fs::remove_dir_all(dir).unwrap();
