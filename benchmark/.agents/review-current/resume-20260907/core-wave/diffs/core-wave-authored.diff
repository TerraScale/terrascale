+           INSERT INTO observed_sync SELECT synchronous FROM pragma_synchronous;
+         END;",
+        )
+        .unwrap();
+    for (index, durability, expected) in [
+        (1, LocalDurability::Written, 1),
+        (2, LocalDurability::Synced, 2),
