new file mode 100644
index 00000000..501a499b
--- /dev/null
+++ b/src/engine/branch_restore.rs
@@ -0,0 +1,224 @@
+//! Encrypted immutable-cut import into a new owned database.
+
+use super::{Engine, EngineConfig, EngineOpenError};
+use crate::{
+    storage::DatabaseOwner,
+    types::{OperationId, StorageSequence},
+};
+use std::{fs, path::Path};
+
+impl Engine {
+    /// Installs an immutable encrypted snapshot as a fresh branch database.
+    /// Source and target stay in the same tenant, project, environment and
+    /// Region. The source registration must remain alive for this call.
+    /// The operation marker makes a completed retry return the installed cut.
+    ///
+    /// # Errors
+    /// Refuses foreign owners, plaintext sources, reused target operations,
+    /// invalid history/schema transforms, or unavailable encryption keys.
+    pub fn restore_encrypted_sqlite_branch(
+        source: &Engine,
+        config: &EngineConfig,
+        operation: &OperationId,
+    ) -> Result<StorageSequence, EngineOpenError> {
+        config.validate_storage_keys()?;
+        let source_owner = source.database_owner();
+        let child = config.owner.as_ref().ok_or(EngineOpenError::InvalidConfig)?;
+        let keys = config.storage_keys.as_ref().ok_or(EngineOpenError::InvalidConfig)?;
+        if child.database() == source_owner.database()
+            || child.tenant() != source_owner.tenant()
+            || child.project() != source_owner.project()
+            || child.environment() != source_owner.environment()
+            || child.region() != source_owner.region()
+        {
+            return Err(EngineOpenError::InvalidConfig);
+        }
+        let target = &config.location;
+        if let Ok(metadata) = fs::symlink_metadata(target)
+            && (!metadata.is_dir() || metadata.file_type().is_symlink())
+        {
+            return Err(EngineOpenError::InvalidConfig);
+        }
+        let marker =
+            format!("{}:{}:{}", operation.as_str(), source_owner.database(), child.database());
+        if fs::read_dir(target).ok().and_then(|entries| entries.into_iter().next()).is_some() {
+            return read_installed_branch_cut(config, target, &marker);
+        }
+        // `EngineConfig::durable` creates the target directory up front. An
+        // empty directory is only a reservation; remove it so the prepared
+        // staging directory can be installed atomically with rename.
+        match fs::remove_dir(target) {
+            Ok(()) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) if error.kind() == std::io::ErrorKind::DirectoryNotEmpty => {
+                if let Some(existing) = installed_cut(config, &marker) {
+                    sync_parent(target)?;
+                    return Ok(StorageSequence::new(existing));
+                }
+                return Err(EngineOpenError::InvalidConfig);
+            }
+            Err(_) => return Err(EngineOpenError::StorageUnavailable),
+        }
+        let parent = target.parent().ok_or(EngineOpenError::InvalidConfig)?;
+        let staging = parent.join(format!(".branch-restore-{}", crate::identity::generate()));
+        let mut builder = fs::DirBuilder::new();
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::DirBuilderExt;
+            builder.mode(0o700);
+        }
+        builder.create(&staging).map_err(|_| EngineOpenError::StorageUnavailable)?;
+        let result = (|| {
+            crate::storage::load_or_create(
+                &staging,
+                Some(child),
+                crate::storage::OwnershipMode::Production,
+            )
+            .map_err(|_| EngineOpenError::FormatMismatch)?;
+            let source_owner = source.database_owner();
+            let mut source_path = None;
+            let registration = source
+                .with_quiescent_wal(|source_location| {
+                    source_path = Some(source_location.to_owned());
+                    crate::storage::copy_encrypted_snapshot(
+                        source_location,
+                        &staging,
+                        source_owner,
+                        keys.clone(),
+                    )
+                })
+                .map_err(|_| EngineOpenError::StorageUnavailable)?
+                .map_err(|()| EngineOpenError::StorageUnavailable)?;
+            let cut = transform_snapshot(
+                source_path.as_deref().ok_or(EngineOpenError::StorageUnavailable)?,
+                &staging,
+                source_owner,
+                child,
+                config,
+                &marker,
+            )?;
+            drop(registration);
+            let mut staged = config.clone();
+            staged.location.clone_from(&staging);
+            drop(Self::open(staged)?);
+            fs::File::open(&staging)
+                .and_then(|directory| directory.sync_all())
+                .map_err(|_| EngineOpenError::StorageUnavailable)?;
+            if fs::rename(&staging, target).is_err() {
+                // Another restore may have won the target rename while this
+                // source was quiesced. Re-read the durable marker to make an
+                // exact same-operation loser idempotent; a different marker
+                // remains a conflict.
+                if let Some(existing) = installed_cut(config, &marker) {
+                    fs::remove_dir_all(&staging)
+                        .map_err(|_| EngineOpenError::StorageUnavailable)?;
+                    sync_parent(target)?;
+                    return Ok(StorageSequence::new(existing));
+                }
+                return Err(EngineOpenError::StorageUnavailable);
+            }
+            sync_parent(target)?;
+            Ok(StorageSequence::new(
+                u64::try_from(cut).map_err(|_| EngineOpenError::FormatMismatch)?,
+            ))
+        })();
+        if result.is_err() {
+            let _ = fs::remove_dir_all(&staging);
+        }
+        result
+    }
+}
+
+fn sync_parent(target: &Path) -> Result<(), EngineOpenError> {
+    let parent = target.parent().ok_or(EngineOpenError::InvalidConfig)?;
+    fs::File::open(parent)
+        .and_then(|directory| directory.sync_all())
+        .map_err(|_| EngineOpenError::StorageUnavailable)
+}
+
+fn read_installed_branch_cut(
+    config: &EngineConfig,
+    target: &Path,
+    marker: &str,
+) -> Result<StorageSequence, EngineOpenError> {
+    let engine = Engine::open(config.clone())?;
+    let connection =
+        engine.open_sqlite_read_connection().map_err(|_| EngineOpenError::StorageUnavailable)?;
+    let found: String = connection
+        .query_row("SELECT value FROM meta WHERE key='branch_restore_operation'", [], |row| {
+            row.get(0)
+        })
+        .map_err(|_| EngineOpenError::InvalidConfig)?;
+    if found != marker {
+        return Err(EngineOpenError::InvalidConfig);
+    }
+    let sequence: i64 = connection
+        .query_row("SELECT value FROM meta WHERE key='branch_restore_cut'", [], |row| row.get(0))
+        .map_err(|_| EngineOpenError::FormatMismatch)?;
+    sync_parent(target)?;
+    Ok(StorageSequence::new(u64::try_from(sequence).map_err(|_| EngineOpenError::FormatMismatch)?))
+}
+
+fn installed_cut(config: &EngineConfig, marker: &str) -> Option<u64> {
+    let engine = Engine::open(config.clone()).ok()?;
+    let connection = engine.open_sqlite_read_connection().ok()?;
+    let found: String = connection
+        .query_row("SELECT value FROM meta WHERE key='branch_restore_operation'", [], |row| {
+            row.get(0)
+        })
+        .ok()?;
+    if found != marker {
+        return None;
+    }
+    let cut = connection
+        .query_row("SELECT value FROM meta WHERE key='branch_restore_cut'", [], |row| {
+            row.get::<_, i64>(0)
+        })
+        .ok()?;
+    u64::try_from(cut).ok()
+}
+
+fn transform_snapshot(
+    source: &Path,
+    staging: &Path,
+    source_owner: &DatabaseOwner,
+    child: &DatabaseOwner,
+    config: &EngineConfig,
+    marker: &str,
+) -> Result<i64, EngineOpenError> {
+    let mut connection = crate::storage::open_physical_sqlite(
+        &crate::storage::database_file(staging),
+        rusqlite::OpenFlags::SQLITE_OPEN_READ_WRITE,
+    )
+    .map_err(|_| EngineOpenError::StorageUnavailable)?;
+    connection
+        .execute_batch("PRAGMA synchronous=FULL; PRAGMA temp_store=MEMORY;")
+        .map_err(|_| EngineOpenError::StorageUnavailable)?;
+    let transaction = connection.transaction().map_err(|_| EngineOpenError::StorageUnavailable)?;
+    let cut = crate::storage::transform_provenance(&transaction, child)
+        .map_err(|()| EngineOpenError::FormatMismatch)?;
+    crate::storage::transform_branch_schema(&transaction, source_owner, child)
+        .map_err(|()| EngineOpenError::FormatMismatch)?;
+    crate::storage::rebind_owner(&transaction, source, staging)
+        .map_err(|()| EngineOpenError::FormatMismatch)?;
+    let origin = config
+        .replication_origin
+        .as_ref()
+        .map_or_else(|| child.region().as_str().to_owned(), |origin| origin.as_str().to_owned());
+    transaction.execute("INSERT INTO meta(key,value) VALUES('local_origin',?1) ON CONFLICT(key) DO UPDATE SET value=excluded.value", [origin]).map_err(|_| EngineOpenError::StorageUnavailable)?;
+    let cut = i64::try_from(cut).map_err(|_| EngineOpenError::FormatMismatch)?;
+    transaction
+        .execute(
+            "INSERT INTO meta(key,value) VALUES('branch_restore_operation',?1) ON CONFLICT(key) DO UPDATE SET value=excluded.value",
+            [&marker],
+        )
+        .map_err(|_| EngineOpenError::StorageUnavailable)?;
+    transaction
+        .execute("INSERT INTO meta(key,value) VALUES('branch_restore_cut',?1) ON CONFLICT(key) DO UPDATE SET value=excluded.value", [cut])
+        .map_err(|_| EngineOpenError::StorageUnavailable)?;
+    transaction.commit().map_err(|_| EngineOpenError::StorageUnavailable)?;
+    connection
+        .execute_batch("PRAGMA wal_checkpoint(TRUNCATE)")
+        .map_err(|_| EngineOpenError::StorageUnavailable)?;
+    Ok(cut)
+}
diff --git a/src/engine/branch_restore_tests.rs b/src/engine/branch_restore_tests.rs
new file mode 100644
index 00000000..3bb6914d
--- /dev/null
+++ b/src/engine/branch_restore_tests.rs
@@ -0,0 +1,263 @@
+use super::*;
+use crate::types::{
+    CollectionName, Document, DocumentId, DocumentValue, ExpectedVersion, LocalDurability,
+    OperationId, TenantId,
+};
+
+fn assert_branch_contents(engine: &Engine, tenant: &TenantId, database: &str) {
+    assert_eq!(
+        engine.schema_metadata_load(database, "feature", "users").unwrap(),
+        Some(b"schema-envelope".to_vec())
+    );
+    let scope = engine.scope_for(tenant);
+    let snapshot = engine.read_snapshot(&scope).unwrap();
+    let transaction = engine
+        .begin(&scope, snapshot, OperationId::try_new("read-branch-helper").unwrap())
+        .unwrap();
+    assert_eq!(
+        transaction
+            .read_in_collection(
+                &CollectionName::try_new("users").unwrap(),
+                &DocumentId::try_new("one").unwrap(),
+            )
+            .unwrap()
+            .unwrap()
+            .value(),
+        &DocumentValue::String("source-value".into())
+    );
+}
+
+fn seed_branch_source(source: &Engine, tenant: &TenantId) {
+    let scope = source.scope_for(tenant);
+    let snapshot = source.read_snapshot(&scope).unwrap();
+    let mut transaction =
+        source.begin(&scope, snapshot, OperationId::try_new("branch-source").unwrap()).unwrap();
+    transaction
+        .stage_schema_metadata(
+            &source.database_id().to_string(),
+            "feature",
+            "users",
+            None,
+            b"schema-envelope",
+        )
+        .unwrap();
+    transaction
+        .put(
+            Document::new(
+                DocumentId::try_new("one").unwrap(),
+                CollectionName::try_new("users").unwrap(),
+                DocumentValue::String("source-value".into()),
+            ),
+            ExpectedVersion::New,
+        )
+        .unwrap();
+    assert!(matches!(transaction.commit(LocalDurability::Synced), CommitOutcome::Committed(_)));
+}
+
+fn open_branch_source(root: &std::path::Path) -> (Engine, crate::storage::DatabaseOwner, TenantId) {
+    let source_owner = crate::storage::DatabaseOwner::try_new(
+        "branch-test",
+        crate::identity::TenantUlid::generate(),
+        crate::identity::ProjectUlid::generate(),
+        crate::identity::DatabaseUlid::generate(),
+        crate::RegionCode::GRU,
+    )
+    .unwrap();
+    let source = Engine::open(
+        EngineConfig::durable(root.join("source"))
+            .unwrap()
+            .with_owner(source_owner.clone())
+            .with_storage_keys(test_storage_keys(&source_owner, 141)),
+    )
+    .unwrap();
+    source.activate_origin_epoch(1).unwrap();
+    let tenant = TenantId::try_new(&source_owner.tenant().to_string()).unwrap();
+    seed_branch_source(&source, &tenant);
+    (source, source_owner, tenant)
+}
+
+fn restore_concurrently(
+    source: &Engine,
+    config: &EngineConfig,
+    first_operation: &OperationId,
+    second_operation: &OperationId,
+) -> (
+    Result<crate::types::StorageSequence, EngineOpenError>,
+    Result<crate::types::StorageSequence, EngineOpenError>,
+) {
+    std::thread::scope(|threads| {
+        let first_config = config.clone();
+        let second_config = config.clone();
+        let first_operation = first_operation.clone();
+        let second_operation = second_operation.clone();
+        let first = threads.spawn(move || {
+            Engine::restore_encrypted_sqlite_branch(source, &first_config, &first_operation)
+        });
+        let second = threads.spawn(move || {
+            Engine::restore_encrypted_sqlite_branch(source, &second_config, &second_operation)
+        });
+        (first.join().unwrap(), second.join().unwrap())
+    })
+}
+
+#[test]
+fn encrypted_branch_restore_rebinds_owner_and_replays_idempotently() {
+    let root = std::env::temp_dir()
+        .join(format!("terrabase-branch-restore-{}", crate::identity::generate()));
+    let (source, source_owner, tenant) = open_branch_source(&root);
+    let target_path = root.join("target");
+    let project = source_owner.project();
+
+    let child_owner = crate::storage::DatabaseOwner::new(
+        source_owner.environment().clone(),
+        source_owner.tenant(),
+        project,
+        crate::identity::DatabaseUlid::generate(),
+        source_owner.region(),
+    );
+    let child_keys = test_storage_keys(&child_owner, 142);
+    let child_config = EngineConfig::durable(&target_path)
+        .unwrap()
+        .with_owner(child_owner.clone())
+        .with_storage_keys(child_keys);
+    let operation = OperationId::try_new("restore-branch").unwrap();
+    let (same_first, same_second) =
+        restore_concurrently(&source, &child_config, &operation, &operation);
+    let same_first = same_first.unwrap();
+    let same_second = same_second.unwrap();
+    assert_eq!(same_first, same_second);
+    assert!(
+        std::fs::read_dir(&root)
+            .unwrap()
+            .flatten()
+            .all(|entry| !entry.file_name().to_string_lossy().starts_with(".branch-restore-"))
+    );
+    let cut = Engine::restore_encrypted_sqlite_branch(&source, &child_config, &operation).unwrap();
+    assert_eq!(cut, same_first);
+    assert!(cut.get() > 0);
+    let retry =
+        Engine::restore_encrypted_sqlite_branch(&source, &child_config, &operation).unwrap();
+    assert_eq!(retry, cut);
+    let child = Engine::open(child_config).unwrap();
+    assert_eq!(child.database_id(), child_owner.database());
+    assert_branch_contents(&child, &tenant, &child_owner.database().to_string());
+
+    let distinct_target = root.join("distinct-target");
+    let distinct_config = EngineConfig::durable(&distinct_target)
+        .unwrap()
+        .with_owner(child_owner.clone())
+        .with_storage_keys(test_storage_keys(&child_owner, 146));
+    let first_operation = OperationId::try_new("distinct-first").unwrap();
+    let second_operation = OperationId::try_new("distinct-second").unwrap();
+    let (distinct_first, distinct_second) =
+        restore_concurrently(&source, &distinct_config, &first_operation, &second_operation);
+    assert_ne!(distinct_first.is_ok(), distinct_second.is_ok());
+    assert!(
+        std::fs::read_dir(&root)
+            .unwrap()
+            .flatten()
+            .all(|entry| !entry.file_name().to_string_lossy().starts_with(".branch-restore-"))
+    );
+
+    let grandchild_owner = crate::storage::DatabaseOwner::new(
+        child_owner.environment().clone(),
+        child_owner.tenant(),
+        child_owner.project(),
+        crate::identity::DatabaseUlid::generate(),
+        child_owner.region(),
+    );
+    let grandchild_path = root.join("grandchild");
+    let grandchild_config = EngineConfig::durable(&grandchild_path)
+        .unwrap()
+        .with_owner(grandchild_owner.clone())
+        .with_storage_keys(test_storage_keys(&grandchild_owner, 143));
+    let grandchild_operation = OperationId::try_new("restore-grandchild").unwrap();
+    let grandchild_cut =
+        Engine::restore_encrypted_sqlite_branch(&child, &grandchild_config, &grandchild_operation)
+            .unwrap();
+    assert_eq!(
+        Engine::restore_encrypted_sqlite_branch(&child, &grandchild_config, &grandchild_operation,)
+            .unwrap(),
+        grandchild_cut
+    );
+    let grandchild = Engine::open(grandchild_config).unwrap();
+    assert_eq!(grandchild.database_id(), grandchild_owner.database());
+    assert_branch_contents(&grandchild, &tenant, &grandchild_owner.database().to_string());
+    drop(grandchild);
+    drop(child);
+    drop(source);
+    std::fs::remove_dir_all(root).unwrap();
+}
+
+#[test]
+fn encrypted_branch_restore_rejects_plaintext_source() {
+    let root = std::env::temp_dir()
+        .join(format!("terrabase-branch-plaintext-{}", crate::identity::generate()));
+    let source_owner = crate::storage::DatabaseOwner::local_development();
+    let source = root.join("source");
+    std::fs::create_dir_all(&source).unwrap();
+    std::fs::write(source.join(crate::storage::database_file(&source)), b"plaintext").unwrap();
+    let child_owner = crate::storage::DatabaseOwner::new(
+        source_owner.environment().clone(),
+        source_owner.tenant(),
+        source_owner.project(),
+        crate::identity::DatabaseUlid::generate(),
+        source_owner.region(),
+    );
+    let target = root.join("target");
+    let config = EngineConfig::durable(&target)
+        .unwrap()
+        .with_owner(child_owner.clone())
+        .with_storage_keys(test_storage_keys(&child_owner, 143));
+    let source_config =
+        EngineConfig::durable(&source).unwrap().with_owner(source_owner).with_storage_keys(
+            test_storage_keys(&crate::storage::DatabaseOwner::local_development(), 143),
+        );
+    assert!(Engine::open(source_config).is_err());
+    assert!(Engine::open(config).is_ok());
+    std::fs::remove_dir_all(root).unwrap();
+}
+
+#[test]
+fn encrypted_branch_rejects_wrong_owner_keys_before_reading_source() {
+    let root = std::env::temp_dir()
+        .join(format!("terrabase-branch-key-scope-{}", crate::identity::generate()));
+    let source_owner = crate::storage::DatabaseOwner::local_development();
+    let source_path = root.join("source");
+    let source = Engine::open(
+        EngineConfig::durable(&source_path)
+            .unwrap()
+            .with_owner(source_owner.clone())
+            .with_storage_keys(test_storage_keys(&source_owner, 145)),
+    )
+    .unwrap();
+    let child_owner = crate::storage::DatabaseOwner::new(
+        source_owner.environment().clone(),
+        source_owner.tenant(),
+        source_owner.project(),
+        crate::identity::DatabaseUlid::generate(),
+        source_owner.region(),
+    );
+    let target = root.join("target");
+    let config = EngineConfig::durable(&target)
+        .unwrap()
+        .with_owner(child_owner)
+        .with_storage_keys(test_storage_keys(&source_owner, 144));
+    assert!(matches!(
+        Engine::restore_encrypted_sqlite_branch(
+            &source,
+            &config,
+            &OperationId::try_new("wrong-key").unwrap(),
+        ),
+        Err(EngineOpenError::InvalidConfig)
+    ));
+    assert_eq!(std::fs::read_dir(&target).unwrap().count(), 0);
+    assert!(
+        std::fs::read_dir(&root)
+            .unwrap()
+            .flatten()
+            .all(|entry| !entry.file_name().to_string_lossy().starts_with(".branch-restore-"))
+    );
+    drop(source);
+    std::fs::remove_dir_all(root).unwrap();
+}
diff --git a/src/engine/cross_file.rs b/src/engine/cross_file.rs
new file mode 100644
index 00000000..4926cd1c
--- /dev/null
+++ b/src/engine/cross_file.rs
@@ -0,0 +1,530 @@
+//! Database-owned identity and visibility records for cross-file operations.
+
+use std::collections::BTreeMap;
+
+use crate::types::OperationId;
+use crate::{
+    engine::{CommitError, CommitOutcome, Engine, EngineError},
+    types::{DocumentValue, LocalDurability, TenantScope},
+};
+
+const MAX_PARTICIPANTS: usize = 64;
+
+/// Local database receipt for a cross-file decision. It carries no replica
+/// acknowledgement or cross-region finality claim.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct LocalCrossFileReceipt {
+    operation: OperationId,
+    sequence: u64,
+    digest: [u8; 32],
+    durability: LocalDurability,
+    phase: CrossFileReceiptPhase,
+}
+
+/// Local coordinator phase represented by a receipt.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum CrossFileReceiptPhase {
+    /// Coordinator prepared the decision without committing it.
+    Prepare,
+    /// Coordinator reached a committed decision.
+    Decision,
+}
+
+impl LocalCrossFileReceipt {
+    /// Logical operation identity.
+    #[must_use]
+    pub fn operation(&self) -> &OperationId {
+        &self.operation
+    }
+    /// Local publication sequence.
+    #[must_use]
+    pub const fn sequence(&self) -> u64 {
+        self.sequence
+    }
+    /// Canonical coordinator record digest.
+    #[must_use]
+    pub const fn digest(&self) -> [u8; 32] {
+        self.digest
+    }
+    /// Local durability reached by the Engine.
+    #[must_use]
+    pub const fn durability(&self) -> LocalDurability {
+        self.durability
+    }
+    /// Coordinator phase reached by this receipt.
+    #[must_use]
+    pub const fn phase(&self) -> CrossFileReceiptPhase {
+        self.phase
+    }
+}
+
+/// Immutable identity binding one cross-file operation to its database view.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct CrossFileIdentity {
+    /// Tenant scope owning the coordinator record.
+    pub(crate) tenant: String,
+    /// Durable database incarnation.
+    pub(crate) incarnation: u128,
+    /// Authority epoch used while preparing the operation.
+    pub(crate) authority_epoch: u64,
+    /// Route generation used while preparing the operation.
+    pub(crate) route_generation: u64,
+    /// Read frontier at which participants were selected.
+    pub(crate) read_frontier: u64,
+    /// Exact operation write-set digest.
+    pub(crate) write_digest: [u8; 32],
+    /// Exact participant name to snapshot sequence binding.
+    pub(crate) participants: BTreeMap<String, u64>,
+    /// Stable operation identity.
+    pub(crate) operation: OperationId,
+    /// Monotonic coordinator decision epoch.
+    pub(crate) decision_epoch: u64,
+}
+
+impl CrossFileIdentity {
+    /// Validates bounded identity fields and participant uniqueness.
+    pub(crate) fn validate(&self) -> bool {
+        !self.tenant.is_empty()
+            && self.tenant.len() <= 255
+            && self.incarnation != 0
+            && self.authority_epoch != 0
+            && self.route_generation != u64::MAX
+            && self.read_frontier != u64::MAX
+            && self.decision_epoch != 0
+            && !self.participants.is_empty()
+            && self.participants.len() <= MAX_PARTICIPANTS
+            && self.participants.iter().all(|(name, sequence)| {
+                !name.is_empty() && name.len() <= 255 && i64::try_from(*sequence).is_ok()
+            })
+    }
+}
+
+/// Durable coordinator decision. A committed decision alone is not visible.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum CrossFileDecision {
+    /// All participants may install the operation.
+    Committed,
+    /// No participant may install the operation.
+    Aborted,
+}
+
+/// Durable coordinator record, retaining both identity and terminal state.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct CrossFileRecord {
+    /// Immutable operation identity.
+    pub(crate) identity: CrossFileIdentity,
+    /// Current durable decision, when terminal.
+    pub(crate) decision: Option<CrossFileDecision>,
+}
+
+/// One database-wide visible frontier after participant installation.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct VisibleFrontier {
+    /// Database version made visible to readers.
+    pub(crate) version: u64,
+    /// Exact participant snapshot sequence map installed for this version.
+    pub(crate) participants: BTreeMap<String, u64>,
+}
+
+impl VisibleFrontier {
+    /// Validates a bounded, nonzero visible frontier.
+    pub(crate) fn validate(&self) -> bool {
+        self.version != 0
+            && !self.participants.is_empty()
+            && self.participants.len() <= MAX_PARTICIPANTS
+            && self.participants.iter().all(|(name, sequence)| {
+                !name.is_empty() && name.len() <= 255 && *sequence != u64::MAX
+            })
+    }
+}
+
+fn key(operation: &OperationId) -> String {
+    format!("control:cross-file/v1/{}", operation.as_str())
+}
+fn visible_key() -> &'static str {
+    "control:cross-file-visible/v1"
+}
+fn maintenance_operation(
+    identity: &CrossFileIdentity,
+    phase: &str,
+) -> Result<OperationId, EngineError> {
+    let mut input = b"terrascale.cross-file.maintenance.v1".to_vec();
+    input.extend_from_slice(identity.operation.as_str().as_bytes());
+    input.extend_from_slice(phase.as_bytes());
+    OperationId::try_new(&format!("cross-file-{phase}-{}", blake3::hash(&input).to_hex()))
+        .map_err(|_| EngineError::InvalidDocument)
+}
+
+fn encode(record: &CrossFileRecord) -> Result<DocumentValue, EngineError> {
+    encode_phase(record, "prepare")
+}
+
+fn encode_phase(record: &CrossFileRecord, phase: &str) -> Result<DocumentValue, EngineError> {
+    let identity = &record.identity;
+    if !identity.validate() {
+        return Err(EngineError::InvalidDocument);
+    }
+    let participants: Vec<_> = identity
+        .participants
+        .iter()
+        .map(|(name, sequence)| {
+            Ok(DocumentValue::Object(BTreeMap::from([
+                ("name".into(), DocumentValue::String(name.clone())),
+                (
+                    "sequence".into(),
+                    DocumentValue::Integer(
+                        i64::try_from(*sequence).map_err(|_| EngineError::InvalidDocument)?,
+                    ),
+                ),
+            ])))
+        })
+        .collect::<Result<_, _>>()?;
+    Ok(DocumentValue::Object(BTreeMap::from([
+        ("tenant".into(), DocumentValue::String(identity.tenant.clone())),
+        ("incarnation".into(), DocumentValue::String(format!("{:032x}", identity.incarnation))),
+        (
+            "authority_epoch".into(),
+            DocumentValue::Integer(
+                i64::try_from(identity.authority_epoch)
+                    .map_err(|_| EngineError::InvalidDocument)?,
+            ),
+        ),
+        (
+            "route_generation".into(),
+            DocumentValue::Integer(
+                i64::try_from(identity.route_generation)
+                    .map_err(|_| EngineError::InvalidDocument)?,
+            ),
+        ),
+        (
+            "read_frontier".into(),
+            DocumentValue::Integer(
+                i64::try_from(identity.read_frontier).map_err(|_| EngineError::InvalidDocument)?,
+            ),
+        ),
+        ("write_digest".into(), DocumentValue::String(hex::encode(identity.write_digest))),
+        ("participants".into(), DocumentValue::Array(participants)),
+        ("operation".into(), DocumentValue::String(identity.operation.as_str().into())),
+        (
+            "decision_epoch".into(),
+            DocumentValue::Integer(
+                i64::try_from(identity.decision_epoch).map_err(|_| EngineError::InvalidDocument)?,
+            ),
+        ),
+        ("phase".into(), DocumentValue::String(phase.into())),
+    ])))
+}
+
+fn integer(fields: &BTreeMap<String, DocumentValue>, name: &str) -> Option<u64> {
+    match fields.get(name) {
+        Some(DocumentValue::Integer(value)) if *value >= 0 => (*value).try_into().ok(),
+        _ => None,
+    }
+}
+
+fn decode(value: DocumentValue) -> Result<CrossFileRecord, EngineError> {
+    const FIELDS: &[&str] = &[
+        "tenant",
+        "incarnation",
+        "authority_epoch",
+        "route_generation",
+        "read_frontier",
+        "write_digest",
+        "participants",
+        "operation",
+        "decision_epoch",
+        "phase",
+    ];
+    let DocumentValue::Object(fields) = value else {
+        return Err(EngineError::InvalidDocument);
+    };
+    if fields.keys().any(|key| !FIELDS.contains(&key.as_str())) {
+        return Err(EngineError::InvalidDocument);
+    }
+    if !matches!(fields.get("phase"), Some(DocumentValue::String(phase)) if phase == "prepare" || phase == "commit" || phase == "abort")
+    {
+        return Err(EngineError::InvalidDocument);
+    }
+    let Some(DocumentValue::String(incarnation)) = fields.get("incarnation") else {
+        return Err(EngineError::InvalidDocument);
+    };
+    let Some(DocumentValue::String(tenant)) = fields.get("tenant") else {
+        return Err(EngineError::InvalidDocument);
+    };
+    let incarnation =
+        u128::from_str_radix(incarnation, 16).map_err(|_| EngineError::InvalidDocument)?;
+    let Some(DocumentValue::String(digest)) = fields.get("write_digest") else {
+        return Err(EngineError::InvalidDocument);
+    };
+    let digest: [u8; 32] = hex::decode(digest)
+        .map_err(|_| EngineError::InvalidDocument)?
+        .try_into()
+        .map_err(|_| EngineError::InvalidDocument)?;
+    let Some(DocumentValue::Array(items)) = fields.get("participants") else {
+        return Err(EngineError::InvalidDocument);
+    };
+    let mut participants = BTreeMap::new();
+    for item in items {
+        let DocumentValue::Object(item) = item else {
+            return Err(EngineError::InvalidDocument);
+        };
+        let Some(DocumentValue::String(name)) = item.get("name") else {
+            return Err(EngineError::InvalidDocument);
+        };
+        let Some(sequence) = integer(item, "sequence") else {
+            return Err(EngineError::InvalidDocument);
+        };
+        if participants.insert(name.clone(), sequence).is_some() {
+            return Err(EngineError::InvalidDocument);
+        }
+    }
+    let Some(DocumentValue::String(operation)) = fields.get("operation") else {
+        return Err(EngineError::InvalidDocument);
+    };
+    let identity = CrossFileIdentity {
+        tenant: tenant.clone(),
+        incarnation,
+        authority_epoch: integer(&fields, "authority_epoch").ok_or(EngineError::InvalidDocument)?,
+        route_generation: integer(&fields, "route_generation")
+            .ok_or(EngineError::InvalidDocument)?,
+        read_frontier: integer(&fields, "read_frontier").ok_or(EngineError::InvalidDocument)?,
+        write_digest: digest,
+        participants,
+        operation: OperationId::try_new(operation).map_err(|_| EngineError::InvalidDocument)?,
+        decision_epoch: integer(&fields, "decision_epoch").ok_or(EngineError::InvalidDocument)?,
+    };
+    let decision = match fields.get("phase") {
+        Some(DocumentValue::String(phase)) if phase == "prepare" => None,
+        Some(DocumentValue::String(phase)) if phase == "commit" => {
+            Some(CrossFileDecision::Committed)
+        }
+        Some(DocumentValue::String(phase)) if phase == "abort" => Some(CrossFileDecision::Aborted),
+        _ => return Err(EngineError::InvalidDocument),
+    };
+    identity
+        .validate()
+        .then_some(CrossFileRecord { identity, decision })
+        .ok_or(EngineError::InvalidDocument)
+}
+
+impl Engine {
+    /// Advances the local DB-visible frontier after every named participant
+    /// has reported its installed snapshot. This method performs no RF2 or
+    /// Global finality claim; those proofs remain cluster-owned.
+    pub(crate) fn advance_cross_file_visible(
+        &self,
+        scope: &TenantScope,
+        identity: &CrossFileIdentity,
+        installed: BTreeMap<String, u64>,
+    ) -> Result<VisibleFrontier, EngineError> {
+        if !identity.validate()
+            || identity.tenant != scope.tenant().as_str()
+            || installed != identity.participants
+        {
+            return Err(EngineError::Conflict);
+        }
+        let mut tx = self.begin(
+            scope,
+            self.read_snapshot(scope)?,
+            maintenance_operation(identity, "visible")?,
+        )?;
+        let record = tx
+            .read_private_metadata(&key(&identity.operation))?
+            .ok_or(EngineError::Conflict)
+            .and_then(decode)?;
+        if record.identity != *identity || record.decision != Some(CrossFileDecision::Committed) {
+            return Err(EngineError::Conflict);
+        }
+        let version = identity.decision_epoch;
+        let frontier = VisibleFrontier { version, participants: installed };
+        if !frontier.validate() {
+            return Err(EngineError::InvalidDocument);
+        }
+        tx.internal_maintenance = true;
+        let fields = frontier
+            .participants
+            .iter()
+            .map(|(name, seq)| {
+                Ok(DocumentValue::Object(BTreeMap::from([
+                    (String::from("name"), DocumentValue::String(name.clone())),
+                    (
+                        String::from("sequence"),
+                        DocumentValue::Integer(
+                            i64::try_from(*seq).map_err(|_| EngineError::InvalidDocument)?,
+                        ),
+                    ),
+                ])))
+            })
+            .collect::<Result<Vec<_>, EngineError>>()?;
+        tx.put_private_metadata(
+            visible_key(),
+            DocumentValue::Object(BTreeMap::from([
+                (
+                    String::from("version"),
+                    DocumentValue::Integer(
+                        i64::try_from(version).map_err(|_| EngineError::InvalidDocument)?,
+                    ),
+                ),
+                (String::from("participants"), DocumentValue::Array(fields)),
+            ])),
+        )?;
+        match tx.commit(LocalDurability::Synced) {
+            CommitOutcome::Committed(_) => Ok(frontier),
+            CommitOutcome::Rejected(CommitError::Conflict) => Err(EngineError::Conflict),
+            CommitOutcome::Rejected(_) | CommitOutcome::Unknown(_) => {
+                Err(EngineError::StorageFailure)
+            }
+        }
+    }
+    /// Reads a durable cross-file prepare record for one operation.
+    pub(crate) fn read_cross_file_decision(
+        &self,
+        scope: &TenantScope,
+        operation: &OperationId,
+    ) -> Result<Option<CrossFileRecord>, EngineError> {
+        let read_op = OperationId::try_new(&format!(
+            "cross-file-read-{}",
+            blake3::hash(operation.as_str().as_bytes()).to_hex()
+        ))
+        .map_err(|_| EngineError::InvalidDocument)?;
+        let tx = self.begin(scope, self.read_snapshot(scope)?, read_op)?;
+        tx.read_private_metadata(&key(operation))?.map(decode).transpose()
+    }
+
+    /// Creates an immutable prepare record with exact-identity replay.
+    pub(crate) fn prepare_cross_file(
+        &self,
+        scope: &TenantScope,
+        identity: CrossFileIdentity,
+    ) -> Result<(CrossFileIdentity, LocalCrossFileReceipt), EngineError> {
+        if !identity.validate() {
+            return Err(EngineError::InvalidDocument);
+        }
+        if identity.tenant != scope.tenant().as_str() {
+            return Err(EngineError::Conflict);
+        }
+        if identity.incarnation != u128::from_be_bytes(self.database_id().as_bytes().to_owned()) {
+            return Err(EngineError::Conflict);
+        }
+        let mut tx = self.begin(
+            scope,
+            self.read_snapshot(scope)?,
+            maintenance_operation(&identity, "prepare")?,
+        )?;
+        if let Some(existing) = tx.read_private_metadata(&key(&identity.operation))? {
+            let existing = decode(existing)?;
+            if existing.identity != identity {
+                return Err(EngineError::Conflict);
+            }
+            let maintenance = maintenance_operation(&identity, "prepare")?;
+            let receipt = match self.resolve_commit(scope, maintenance)? {
+                super::DurableResolution::Committed(receipt) => LocalCrossFileReceipt {
+                    operation: receipt.operation_id().clone(),
+                    sequence: receipt.sequence().get(),
+                    digest: identity.write_digest,
+                    durability: receipt.durability(),
+                    phase: CrossFileReceiptPhase::Prepare,
+                },
+                super::DurableResolution::Pending => return Err(EngineError::StorageFailure),
+                super::DurableResolution::Rejected(_) => return Err(EngineError::Conflict),
+            };
+            return Ok((identity, receipt));
+        }
+        tx.internal_maintenance = true;
+        tx.put_private_metadata(
+            &key(&identity.operation),
+            encode(&CrossFileRecord { identity: identity.clone(), decision: None })?,
+        )?;
+        match tx.commit(LocalDurability::Synced) {
+            CommitOutcome::Committed(receipt) => Ok((
+                identity.clone(),
+                LocalCrossFileReceipt {
+                    operation: receipt.operation_id().clone(),
+                    sequence: receipt.sequence().get(),
+                    digest: identity.write_digest,
+                    durability: receipt.durability(),
+                    phase: CrossFileReceiptPhase::Prepare,
+                },
+            )),
+            CommitOutcome::Rejected(CommitError::Conflict) => Err(EngineError::Conflict),
+            CommitOutcome::Rejected(_) | CommitOutcome::Unknown(_) => {
+                Err(EngineError::StorageFailure)
+            }
+        }
+    }
+
+    /// Durably decides a prepared operation exactly once.
+    pub(crate) fn decide_cross_file(
+        &self,
+        scope: &TenantScope,
+        identity: &CrossFileIdentity,
+        decision: CrossFileDecision,
+    ) -> Result<(CrossFileRecord, LocalCrossFileReceipt), EngineError> {
+        if !identity.validate() {
+            return Err(EngineError::InvalidDocument);
+        }
+        if identity.tenant != scope.tenant().as_str() {
+            return Err(EngineError::Conflict);
+        }
+        if identity.incarnation != u128::from_be_bytes(self.database_id().as_bytes().to_owned()) {
+            return Err(EngineError::Conflict);
+        }
+        let mut tx = self.begin(
+            scope,
+            self.read_snapshot(scope)?,
+            maintenance_operation(identity, "decide")?,
+        )?;
+        let current =
+            tx.read_private_metadata(&key(&identity.operation))?.ok_or(EngineError::Conflict)?;
+        let decoded = decode(current.clone())?;
+        if decoded.identity != *identity {
+            return Err(EngineError::Conflict);
+        }
+        if let Some(existing) = decoded.decision {
+            if existing != decision {
+                return Err(EngineError::Conflict);
+            }
+            let maintenance = maintenance_operation(identity, "decide")?;
+            let receipt = match self.resolve_commit(scope, maintenance)? {
+                super::DurableResolution::Committed(receipt) => LocalCrossFileReceipt {
+                    operation: receipt.operation_id().clone(),
+                    sequence: receipt.sequence().get(),
+                    digest: identity.write_digest,
+                    durability: receipt.durability(),
+                    phase: CrossFileReceiptPhase::Decision,
+                },
+                super::DurableResolution::Pending => return Err(EngineError::StorageFailure),
+                super::DurableResolution::Rejected(_) => return Err(EngineError::Conflict),
+            };
+            return Ok((decoded, receipt));
+        }
+        tx.internal_maintenance = true;
+        let phase = match decision {
+            CrossFileDecision::Committed => "commit",
+            CrossFileDecision::Aborted => "abort",
+        };
+        tx.put_private_metadata(
+            &key(&identity.operation),
+            encode_phase(
+                &CrossFileRecord { identity: identity.clone(), decision: Some(decision) },
+                phase,
+            )?,
+        )?;
+        match tx.commit(LocalDurability::Synced) {
+            CommitOutcome::Committed(receipt) => Ok((
+                CrossFileRecord { identity: identity.clone(), decision: Some(decision) },
+                LocalCrossFileReceipt {
+                    operation: receipt.operation_id().clone(),
+                    sequence: receipt.sequence().get(),
+                    digest: identity.write_digest,
+                    durability: receipt.durability(),
+                    phase: CrossFileReceiptPhase::Decision,
+                },
+            )),
+            CommitOutcome::Rejected(CommitError::Conflict) => Err(EngineError::Conflict),
+            CommitOutcome::Rejected(_) | CommitOutcome::Unknown(_) => {
+                Err(EngineError::StorageFailure)
+            }
+        }
+    }
+}
diff --git a/src/engine/cross_file_tests.rs b/src/engine/cross_file_tests.rs
new file mode 100644
index 00000000..d449bf17
--- /dev/null
+++ b/src/engine/cross_file_tests.rs
@@ -0,0 +1,159 @@
+use super::cross_file::{CrossFileDecision, CrossFileIdentity, CrossFileRecord};
+use super::{Engine, EngineConfig, EngineError};
+use crate::types::{OperationId, TenantId};
+use std::collections::BTreeMap;
+
+fn open(tag: &str) -> (std::path::PathBuf, Engine) {
+    let path =
+        std::env::temp_dir().join(format!("terrabase-cross-file-{tag}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&path);
+    (path.clone(), Engine::open(EngineConfig::durable(path).unwrap()).unwrap())
+}
+
+fn identity(engine: &Engine, operation: &str) -> CrossFileIdentity {
+    CrossFileIdentity {
+        tenant: "tenant".into(),
+        incarnation: u128::from_be_bytes(engine.database_id().as_bytes().to_owned()),
+        authority_epoch: 1,
+        route_generation: 0,
+        read_frontier: 1,
+        write_digest: [operation.as_bytes()[0]; 32],
+        participants: BTreeMap::from([(String::from("source"), 1)]),
+        operation: OperationId::try_new(operation).unwrap(),
+        decision_epoch: 1,
+    }
+}
+
+#[test]
+fn decisions_are_independent_terminal_and_restart_safe() {
+    let (path, engine) = open("terminal");
+    let scope = engine.scope_for(&TenantId::try_new("tenant").unwrap());
+    let first = identity(&engine, "logical-first");
+    let second = identity(&engine, "logical-second");
+    engine.prepare_cross_file(&scope, first.clone()).unwrap();
+    engine.prepare_cross_file(&scope, second.clone()).unwrap();
+    assert_eq!(
+        engine.decide_cross_file(&scope, &first, CrossFileDecision::Committed).unwrap().0.decision,
+        Some(CrossFileDecision::Committed)
+    );
+    assert_eq!(
+        engine.decide_cross_file(&scope, &second, CrossFileDecision::Aborted).unwrap().0.decision,
+        Some(CrossFileDecision::Aborted)
+    );
+    assert_eq!(
+        engine.decide_cross_file(&scope, &first, CrossFileDecision::Committed).unwrap().0.decision,
+        Some(CrossFileDecision::Committed)
+    );
+    assert_eq!(
+        engine.decide_cross_file(&scope, &first, CrossFileDecision::Aborted),
+        Err(EngineError::Conflict)
+    );
+    assert_eq!(
+        engine.decide_cross_file(&scope, &second, CrossFileDecision::Committed),
+        Err(EngineError::Conflict)
+    );
+    engine.shutdown().unwrap();
+    let engine = Engine::open(EngineConfig::durable(&path).unwrap()).unwrap();
+    let scope = engine.scope_for(&TenantId::try_new("tenant").unwrap());
+    assert_eq!(
+        engine.read_cross_file_decision(&scope, &first.operation).unwrap().unwrap().decision,
+        Some(CrossFileDecision::Committed)
+    );
+    assert_eq!(
+        engine.read_cross_file_decision(&scope, &second.operation).unwrap().unwrap().decision,
+        Some(CrossFileDecision::Aborted)
+    );
+    engine.shutdown().unwrap();
+    std::fs::remove_dir_all(path).unwrap();
+}
+
+#[test]
+fn invalid_identity_and_foreign_owner_are_rejected() {
+    let (_path, engine) = open("invalid");
+    let scope = engine.scope_for(&TenantId::try_new("tenant").unwrap());
+    let mut invalid = identity(&engine, "invalid");
+    invalid.participants.insert(String::from("overflow"), u64::MAX);
+    assert_eq!(
+        engine.prepare_cross_file(&scope, invalid).map(|_| ()),
+        Err(EngineError::InvalidDocument)
+    );
+    let mut foreign = identity(&engine, "foreign");
+    foreign.incarnation = 99;
+    assert_eq!(engine.prepare_cross_file(&scope, foreign), Err(EngineError::Conflict));
+    for mutate in [
+        |value: &mut CrossFileIdentity| value.authority_epoch = 1 << 63,
+        |value: &mut CrossFileIdentity| value.route_generation = 1 << 63,
+        |value: &mut CrossFileIdentity| value.read_frontier = 1 << 63,
+        |value: &mut CrossFileIdentity| value.decision_epoch = 1 << 63,
+    ] {
+        let mut overflow = identity(&engine, "overflow");
+        mutate(&mut overflow);
+        assert_eq!(engine.prepare_cross_file(&scope, overflow), Err(EngineError::InvalidDocument));
+    }
+    engine.shutdown().unwrap();
+}
+
+#[test]
+fn terminal_record_preserves_identity_and_decision() {
+    let (_path, engine) = open("record");
+    let value = CrossFileRecord {
+        identity: identity(&engine, "record"),
+        decision: Some(CrossFileDecision::Committed),
+    };
+    assert_eq!(value.identity.decision_epoch, 1);
+    engine.shutdown().unwrap();
+}
+
+#[test]
+fn participant_prepare_resolves_exactly_across_engine_reopen() {
+    use crate::storage::participant::{ParticipantIdentity, ParticipantPrepare, ParticipantWrite};
+    use crate::types::{
+        CollectionName, Document, DocumentId, DocumentValue, ExpectedVersion, StorageSequence,
+    };
+    let (path, engine) = open("participant");
+    let tenant = TenantId::try_new("tenant").unwrap();
+    let operation = OperationId::try_new("participant-op").unwrap();
+    let write = ParticipantWrite::Put {
+        document: Document::new(
+            DocumentId::try_new("doc").unwrap(),
+            CollectionName::try_new("items").unwrap(),
+            DocumentValue::Object(BTreeMap::new()),
+        ),
+        expected: ExpectedVersion::Any,
+    };
+    let payload = crate::storage::participant::encode_prepare_payload(
+        std::slice::from_ref(&write),
+        &[],
+        &[],
+        None,
+    )
+    .unwrap();
+    let identity = ParticipantIdentity {
+        tenant: tenant.clone(),
+        database_incarnation: u128::from_be_bytes(engine.database_id().as_bytes().to_owned()),
+        operation,
+        participant: "file-a".into(),
+        owner: "owner".into(),
+        digest: *blake3::hash(&payload).as_bytes(),
+        epoch: 1,
+        snapshot: StorageSequence::new(1),
+    };
+    let prepare = ParticipantPrepare {
+        identity: identity.clone(),
+        writes: vec![write],
+        metadata: Vec::new(),
+        schema_envelopes: Vec::new(),
+        replication_publication: None,
+    };
+    engine.storage.lock().unwrap().port.prepare_participant(&prepare).unwrap();
+    assert!(engine.storage.lock().unwrap().port.resolve_participant(&identity).unwrap().is_some());
+    engine.shutdown().unwrap();
+    let reopened = Engine::open(EngineConfig::durable(path).unwrap()).unwrap();
+    assert!(
+        reopened.storage.lock().unwrap().port.resolve_participant(&identity).unwrap().is_some()
+    );
+    let mut foreign = identity.clone();
+    foreign.owner = "foreign".into();
+    assert!(reopened.storage.lock().unwrap().port.resolve_participant(&foreign).is_err());
+    reopened.shutdown().unwrap();
+}
diff --git a/src/engine/export.rs b/src/engine/export.rs
new file mode 100644
index 00000000..62792218
--- /dev/null
+++ b/src/engine/export.rs
@@ -0,0 +1,435 @@
+//! Tenant-scoped durable reads for resumable exports.
+
+use super::{Engine, EngineError, MAX_SNAPSHOT_RECORD_PAGE, SnapshotRecord};
+use crate::types::{CollectionName, DocumentId, LocalDurability, StorageSequence, TenantScope};
+
+/// Metadata captured while document publications and schema mutations are excluded.
+#[derive(Clone, Debug)]
+pub struct ExportMetadataSnapshot {
+    /// Fixed document and journal boundary.
+    pub boundary: u64,
+    /// Wall-clock instant used for all TTL decisions.
+    pub captured_at_millis: u64,
+    /// Earliest retained publication at capture, if any.
+    pub history_start: Option<u64>,
+    /// Durable extracted-field index descriptors.
+    pub indexes: Vec<crate::storage::DescriptorListing>,
+    /// Collection names and internal schema envelopes. The server must decode
+    /// their public document and omit internal idempotency data.
+    pub schemas: Vec<(String, Vec<u8>)>,
+}
+
+/// One retained revision, bounded independently of its transaction size.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ExportHistoryRow {
+    /// Global publication position.
+    pub sequence: u64,
+    /// Publication operation identifier.
+    pub operation_id: String,
+    /// Achieved publication durability.
+    pub durability: LocalDurability,
+    /// Collection key.
+    pub collection: String,
+    /// Document key.
+    pub id: String,
+    /// Published or deleted document version.
+    pub version: u64,
+    /// Whether the revision removes the key.
+    pub deleted: bool,
+    /// Canonical persisted JSON envelope for a live revision.
+    pub body: Vec<u8>,
+}
+
+impl Engine {
+    /// Captures durable schema envelopes and index descriptors with a fixed
+    /// document boundary. The authenticated adapter supplies database and branch.
+    /// Metadata is limited to 256 schemas, 256 descriptors, and four MiB of
+    /// envelope and descriptor-key bytes.
+    ///
+    /// # Errors
+    /// Rejects foreign scopes, unavailable metadata, and metadata above the cap.
+    pub fn capture_export_metadata(
+        &self,
+        scope: &TenantScope,
+        database: &str,
+        branch: &str,
+    ) -> Result<ExportMetadataSnapshot, EngineError> {
+        self.validate_scope(scope)?;
+        let storage = self.lock_storage()?;
+        let connection =
+            storage.port.open_sqlite_read_connection().map_err(|()| EngineError::StorageFailure)?;
+        let mut statement = connection.prepare(
+            "SELECT collection, length(envelope), envelope FROM schema_metadata WHERE database_id = ?1 AND branch = ?2 ORDER BY collection LIMIT 257"
+        ).map_err(|_| EngineError::StorageFailure)?;
+        let mut rows = statement
+            .query(rusqlite::params![database, branch])
+            .map_err(|_| EngineError::StorageFailure)?;
+        let mut schemas = Vec::new();
+        let mut bytes = 0_usize;
+        while let Some(row) = rows.next().map_err(|_| EngineError::StorageFailure)? {
+            let length: i64 = row.get(1).map_err(|_| EngineError::StorageFailure)?;
+            let length =
+                usize::try_from(length).map_err(|_| EngineError::SnapshotPageLimitExceeded)?;
+            bytes = bytes.checked_add(length).ok_or(EngineError::SnapshotPageLimitExceeded)?;
+            if schemas.len() == 256 || bytes > 4 * 1024 * 1024 {
+                return Err(EngineError::SnapshotPageLimitExceeded);
+            }
+            schemas.push((
+                row.get(0).map_err(|_| EngineError::StorageFailure)?,
+                row.get(2).map_err(|_| EngineError::StorageFailure)?,
+            ));
+        }
+        let mut statement = connection.prepare(
+            "SELECT collection, field, state, backfill_below, backfill_cursor, length(CAST(collection AS BLOB)) + length(CAST(field AS BLOB)) FROM index_descriptors ORDER BY collection, field LIMIT 257"
+        ).map_err(|_| EngineError::StorageFailure)?;
+        let mut rows = statement.query([]).map_err(|_| EngineError::StorageFailure)?;
+        let mut indexes = Vec::new();
+        while let Some(row) = rows.next().map_err(|_| EngineError::StorageFailure)? {
+            let length = usize::try_from(read_u64(row, 5)?)
+                .map_err(|_| EngineError::SnapshotPageLimitExceeded)?;
+            bytes = bytes.checked_add(length).ok_or(EngineError::SnapshotPageLimitExceeded)?;
+            if indexes.len() == 256 || bytes > 4 * 1024 * 1024 {
+                return Err(EngineError::SnapshotPageLimitExceeded);
+            }
+            let state: i64 = row.get(2).map_err(|_| EngineError::StorageFailure)?;
+            indexes.push(crate::storage::DescriptorListing {
+                collection: row.get(0).map_err(|_| EngineError::StorageFailure)?,
+                field: row.get(1).map_err(|_| EngineError::StorageFailure)?,
+                active: state == 1,
+                backfill_remaining: read_u64(row, 3)?.saturating_sub(read_u64(row, 4)?),
+            });
+        }
+        Ok(ExportMetadataSnapshot {
+            boundary: storage.port.published_state().0.get(),
+            captured_at_millis: u64::try_from(
+                std::time::SystemTime::now()
+                    .duration_since(std::time::UNIX_EPOCH)
+                    .map_err(|_| EngineError::StorageFailure)?
+                    .as_millis(),
+            )
+            .map_err(|_| EngineError::StorageFailure)?,
+            history_start: storage
+                .port
+                .servable_history_start()
+                .map_err(|()| EngineError::StorageFailure)?
+                .map(StorageSequence::get),
+            indexes,
+            schemas,
+        })
+    }
+
+    /// Reads at most 256 final-state documents at a persisted export boundary.
+    /// The full collection and identifier cursor is exclusive. Callers must
+    /// also bound encoded response bytes before sending the records.
+    ///
+    /// # Errors
+    /// Rejects foreign scopes, oversized pages, unavailable boundaries, and
+    /// storage failures. Retention never silently substitutes current data.
+    pub fn export_snapshot_records(
+        &self,
+        scope: &TenantScope,
+        boundary: u64,
+        captured_at_millis: u64,
+        after: Option<&(CollectionName, DocumentId)>,
+        limit: u32,
+    ) -> Result<Vec<SnapshotRecord>, EngineError> {
+        self.validate_scope(scope)?;
+        if limit > MAX_SNAPSHOT_RECORD_PAGE {
+            return Err(EngineError::SnapshotPageLimitExceeded);
+        }
+        let storage = self.lock_storage()?;
+        validate_export_boundary(&storage, boundary)?;
+        let connection =
+            storage.port.open_sqlite_read_connection().map_err(|()| EngineError::StorageFailure)?;
+        let mut statement = connection.prepare(
+            "SELECT collection, id, requested, length(body), body FROM (SELECT collection, id, requested, body, deleted, expires_at, MAX(commit_seq) FROM documents WHERE tenant = ?1 AND commit_seq <= ?2 AND (collection, id) > (?3, ?4) GROUP BY collection, id) WHERE deleted = 0 AND (collection = 'terrabase.families' OR expires_at IS NULL OR expires_at > ?5) ORDER BY collection, id LIMIT ?6"
+        ).map_err(|_| EngineError::StorageFailure)?;
+        let mut rows = statement
+            .query(rusqlite::params![
+                scope.tenant().as_str(),
+                i64::try_from(boundary).map_err(|_| EngineError::StorageFailure)?,
+                after.as_ref().map_or("", |key| key.0.as_str()),
+                after.as_ref().map_or("", |key| key.1.as_str()),
+                i64::try_from(captured_at_millis).map_err(|_| EngineError::StorageFailure)?,
+                limit
+            ])
+            .map_err(|_| EngineError::StorageFailure)?;
+        let mut result = Vec::new();
+        let mut bytes = 0_u64;
+        while let Some(row) = rows.next().map_err(|_| EngineError::StorageFailure)? {
+            let length = read_u64(row, 3)?;
+            if length > 4 * 1024 * 1024 {
+                return Err(EngineError::SnapshotPageLimitExceeded);
+            }
+            if bytes + length > 4 * 1024 * 1024 {
+                break;
+            }
+            bytes += length;
+            let body: Vec<u8> = row.get(4).map_err(|_| EngineError::StorageFailure)?;
+            let document =
+                crate::storage::decode_document_body(&body).ok_or(EngineError::StorageFailure)?;
+            let collection: String = row.get(0).map_err(|_| EngineError::StorageFailure)?;
+            let id: String = row.get(1).map_err(|_| EngineError::StorageFailure)?;
+            if document.collection().as_str() != collection || document.id().as_str() != id {
+                return Err(EngineError::StorageFailure);
+            }
+            let durability = match row.get::<_, u8>(2).map_err(|_| EngineError::StorageFailure)? {
+                0 => LocalDurability::Buffered,
+                1 => LocalDurability::Written,
+                2 => LocalDurability::Synced,
+                _ => return Err(EngineError::StorageFailure),
+            };
+            result.push(SnapshotRecord { document, durability });
+        }
+        Ok(result)
+    }
+
+    /// Reads retained revisions in exclusive `(sequence, collection, id)` order.
+    /// Each page is capped at 256 rows and four MiB of document bodies, even
+    /// when a single transaction published more rows. A row above four MiB
+    /// is refused before its body is copied into the page.
+    ///
+    /// # Errors
+    /// Rejects foreign scopes, expired history, unavailable boundaries,
+    /// oversized rows or limits, and storage failures.
+    pub fn export_history_rows(
+        &self,
+        scope: &TenantScope,
+        boundary: u64,
+        after: Option<(u64, String, String)>,
+        limit: u32,
+    ) -> Result<Vec<ExportHistoryRow>, EngineError> {
+        use rusqlite::OptionalExtension as _;
+        self.validate_scope(scope)?;
+        if limit > MAX_SNAPSHOT_RECORD_PAGE {
+            return Err(EngineError::SnapshotPageLimitExceeded);
+        }
+        let storage = self.lock_storage()?;
+        validate_export_boundary(&storage, boundary)?;
+        let connection =
+            storage.port.open_sqlite_read_connection().map_err(|()| EngineError::StorageFailure)?;
+        let transaction =
+            connection.unchecked_transaction().map_err(|_| EngineError::StorageFailure)?;
+        let cursor = after.unwrap_or_default();
+        let pruned: Option<i64> = transaction
+            .query_row(
+                "SELECT pruned_through FROM journal_pruning WHERE tenant = ?1",
+                [scope.tenant().as_str()],
+                |row| row.get(0),
+            )
+            .optional()
+            .map_err(|_| EngineError::StorageFailure)?;
+        // An in-commit cursor still needs its own sequence's retained rows.
+        if pruned.is_some_and(|pruned| {
+            cursor.0 < u64::try_from(pruned).unwrap_or(u64::MAX)
+                || (cursor.0 == u64::try_from(pruned).unwrap_or(u64::MAX) && !cursor.1.is_empty())
+        }) {
+            return Err(EngineError::HistoryExpired);
+        }
+        let mut statement = transaction.prepare(
+            "SELECT commit_seq, commit_ulid, collection, id, version, deleted, requested, length(body), body FROM documents WHERE tenant = ?1 AND (commit_seq, collection, id) > (?2, ?3, ?4) AND commit_seq <= ?5 ORDER BY commit_seq, collection, id LIMIT ?6"
+        ).map_err(|_| EngineError::StorageFailure)?;
+        let mut rows = statement
+            .query(rusqlite::params![
+                scope.tenant().as_str(),
+                i64::try_from(cursor.0).map_err(|_| EngineError::StorageFailure)?,
+                cursor.1,
+                cursor.2,
+                i64::try_from(boundary).map_err(|_| EngineError::StorageFailure)?,
+                limit
+            ])
+            .map_err(|_| EngineError::StorageFailure)?;
+        let mut result = Vec::new();
+        let mut bytes = 0_i64;
+        while let Some(row) = rows.next().map_err(|_| EngineError::StorageFailure)? {
+            let length: i64 = row.get(7).map_err(|_| EngineError::StorageFailure)?;
+            if length > 4 * 1024 * 1024 {
+                return Err(EngineError::SnapshotPageLimitExceeded);
+            }
+            if bytes + length > 4 * 1024 * 1024 {
+                break;
+            }
+            bytes += length;
+            let requested: u8 = row.get(6).map_err(|_| EngineError::StorageFailure)?;
+            let durability = match requested {
+                0 => LocalDurability::Buffered,
+                1 => LocalDurability::Written,
+                2 => LocalDurability::Synced,
+                _ => return Err(EngineError::StorageFailure),
+            };
+            let deleted: u8 = row.get(5).map_err(|_| EngineError::StorageFailure)?;
+            if deleted > 1 {
+                return Err(EngineError::StorageFailure);
+            }
+            result.push(ExportHistoryRow {
+                sequence: read_u64(row, 0)?,
+                operation_id: row.get(1).map_err(|_| EngineError::StorageFailure)?,
+                collection: row.get(2).map_err(|_| EngineError::StorageFailure)?,
+                id: row.get(3).map_err(|_| EngineError::StorageFailure)?,
+                version: read_u64(row, 4)?,
+                deleted: deleted == 1,
+                durability,
+                body: row.get(8).map_err(|_| EngineError::StorageFailure)?,
+            });
+        }
+        Ok(result)
+    }
+}
+
+fn read_u64(row: &rusqlite::Row<'_>, index: usize) -> Result<u64, EngineError> {
+    let value: i64 = row.get(index).map_err(|_| EngineError::StorageFailure)?;
+    u64::try_from(value).map_err(|_| EngineError::StorageFailure)
+}
+
+fn validate_export_boundary(
+    storage: &super::StorageState,
+    boundary: u64,
+) -> Result<(), EngineError> {
+    if boundary > storage.port.published_state().0.get()
+        || !storage.port.snapshot_boundary_available(StorageSequence::new(boundary))
+        || storage
+            .port
+            .servable_history_start()
+            .map_err(|()| EngineError::StorageFailure)?
+            .is_some_and(|start| boundary < start.get())
+    {
+        return Err(EngineError::SnapshotBoundaryUnavailable);
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{
+        engine::EngineConfig,
+        types::{Document, DocumentValue, ExpectedVersion, OperationId, TenantId},
+    };
+
+    fn verify_export_ttl(engine: &Engine, scope: &TenantScope) {
+        let snapshot = engine.read_snapshot(scope).expect("snapshot");
+        let mut transaction = engine
+            .begin(scope, snapshot, OperationId::try_new("ttl").expect("operation"))
+            .expect("transaction");
+        transaction
+            .put(
+                Document::new(
+                    DocumentId::try_new("expiring").expect("id"),
+                    CollectionName::try_new("ttl").expect("collection"),
+                    DocumentValue::Object(std::collections::BTreeMap::from([(
+                        "expires_at".to_owned(),
+                        DocumentValue::Integer(1),
+                    )])),
+                ),
+                ExpectedVersion::New,
+            )
+            .expect("put");
+        assert!(matches!(
+            transaction.commit(LocalDurability::Synced),
+            super::super::CommitOutcome::Committed(_)
+        ));
+        assert_eq!(
+            engine.export_snapshot_records(scope, 4, 0, None, 256).expect("before expiry").len(),
+            5
+        );
+        assert_eq!(
+            engine.export_snapshot_records(scope, 4, 2, None, 256).expect("after expiry").len(),
+            4
+        );
+    }
+
+    #[test]
+    fn export_boundary_excludes_later_writes_and_rejects_foreign_scopes() {
+        let directory =
+            std::env::temp_dir().join(format!("terrabase-export-seam-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&directory);
+        let engine =
+            Engine::open(EngineConfig::durable(&directory).expect("config")).expect("engine");
+        let tenant = TenantId::try_new("export-test").expect("tenant");
+        let scope = engine.scope_for(&tenant);
+        let collection = CollectionName::try_new("items").expect("collection");
+        for id in ["a", "b"] {
+            let snapshot = engine.read_snapshot(&scope).expect("snapshot");
+            let mut tx = engine
+                .begin(&scope, snapshot, OperationId::try_new(id).expect("operation"))
+                .expect("transaction");
+            tx.put(
+                Document::new(
+                    DocumentId::try_new(id).expect("id"),
+                    collection.clone(),
+                    DocumentValue::String(id.to_owned()),
+                ),
+                ExpectedVersion::New,
+            )
+            .expect("put");
+            assert!(matches!(
+                tx.commit(LocalDurability::Synced),
+                super::super::CommitOutcome::Committed(_)
+            ));
+        }
+        let boundary = 1;
+        let records = engine.export_snapshot_records(&scope, boundary, 0, None, 1).expect("page");
+        assert_eq!(records[0].document().id().as_str(), "a");
+        assert!(
+            engine
+                .export_snapshot_records(
+                    &scope,
+                    boundary,
+                    0,
+                    Some(&(collection, records[0].document().id().clone())),
+                    1
+                )
+                .expect("last page")
+                .is_empty()
+        );
+        let history = engine.export_history_rows(&scope, boundary, None, 256).expect("history");
+        assert_eq!(history.len(), 1);
+        assert_eq!(history[0].sequence, boundary);
+        let foreign = TenantScope::from_parts(tenant, engine.identity() + 1);
+        assert!(matches!(
+            engine.export_snapshot_records(&foreign, boundary, 0, None, 1),
+            Err(EngineError::ScopeMismatch)
+        ));
+        assert!(matches!(
+            engine.export_history_rows(&scope, boundary, None, 257),
+            Err(EngineError::SnapshotPageLimitExceeded)
+        ));
+        let snapshot = engine.read_snapshot(&scope).expect("snapshot");
+        let mut transaction = engine
+            .begin(&scope, snapshot, OperationId::try_new("multi").expect("operation"))
+            .expect("transaction");
+        for id in ["c", "d"] {
+            transaction
+                .put(
+                    Document::new(
+                        DocumentId::try_new(id).expect("id"),
+                        CollectionName::try_new("items").expect("collection"),
+                        DocumentValue::String(id.to_owned()),
+                    ),
+                    ExpectedVersion::New,
+                )
+                .expect("put");
+        }
+        assert!(matches!(
+            transaction.commit(LocalDurability::Synced),
+            super::super::CommitOutcome::Committed(_)
+        ));
+        let first = engine
+            .export_history_rows(&scope, 3, Some((2, "items".to_owned(), "b".to_owned())), 1)
+            .expect("first revision");
+        assert_eq!(first[0].id, "c");
+        let second = engine
+            .export_history_rows(
+                &scope,
+                3,
+                Some((first[0].sequence, first[0].collection.clone(), first[0].id.clone())),
+                1,
+            )
+            .expect("second revision");
+        assert_eq!(second[0].id, "d");
+        assert_eq!(second[0].sequence, first[0].sequence);
+        verify_export_ttl(&engine, &scope);
+        engine.shutdown().expect("shutdown");
+        std::fs::remove_dir_all(directory).expect("cleanup");
+    }
