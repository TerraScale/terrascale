+        return Err(());
+    }
+    std::fs::copy(backup, &file).map_err(|_| ())?;
+    let mut connection = Connection::open(&file).map_err(|_| ())?;
+    if validate_database_binding(&connection, &source_binding).map_err(|_| ())? {
+        return Err(());
