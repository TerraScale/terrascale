+    fn generation(path: &Path) -> PathBuf {
+        let manifest = std::fs::read(backing(path)).unwrap();
+        let mut generation = backing(path).into_os_string();
+        generation.push(".gen-");
+        generation
+            .push(manifest[8..40].iter().map(|byte| format!("{byte:02x}")).collect::<String>());
