new file mode 100644
index 00000000..f09650e5
--- /dev/null
+++ b/src/shard_split/lifecycle.rs
@@ -0,0 +1,326 @@
+//! Split lifecycle and zero-loss cutover gate.
+
+use super::{
+    CutoverPermit, WriterFence,
+    state::{DurableSplitState, SplitStateError},
+};
+
+/// One key-range split's lifecycle phase.
+#[derive(Clone, Copy, Debug, Eq, Hash, Ord, PartialEq, PartialOrd)]
+pub enum SplitPhase {
+    /// Planned: the shard file is not yet created.
+    Planned,
+    /// The shard file exists and range backfill is running.
+    Backfilling,
+    /// Backfill is complete and the journal tail is being applied.
+    CatchingUp,
+    /// Routing is on the target and the moved range is being verified.
+    CutOver,
+    /// Verification succeeded and the source range was removed.
+    Complete,
+    /// The split was aborted before routing moved.
+    Aborted,
+}
+
+/// Why a split plan was refused.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum SplitPlanError {
+    /// The split key was empty.
+    EmptySplitKey,
+}
+
+/// Why a lifecycle transition was refused.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum SplitCutoverError {
+    /// The target trails the source or acknowledged frontier.
+    NotCaughtUp {
+        /// Highest sequence durably applied by the target.
+        target_applied: u64,
+        /// Highest sequence required before cutover.
+        required: u64,
+    },
+    /// A route cutover must carry a permit produced by the writer fence.
+    InvalidFencePermit,
+    /// The transition is not valid in the current phase.
+    WrongPhase(SplitPhase),
+}
+
+/// One online key-range split's durable lifecycle and cutover gate.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ShardSplit {
+    split_key: Vec<u8>,
+    lower: Option<Vec<u8>>,
+    source_high_water: u64,
+    target_applied_through: u64,
+    acked_through: u64,
+    phase: SplitPhase,
+    context: Option<super::SplitContext>,
+}
+
+impl ShardSplit {
+    /// Plans a split moving keys below the upper-exclusive `split_key`.
+    pub fn plan(lower: Option<Vec<u8>>, split_key: Vec<u8>) -> Result<Self, SplitPlanError> {
+        if split_key.is_empty()
+            || lower
+                .as_deref()
+                .is_some_and(|value| value.is_empty() || value >= split_key.as_slice())
+        {
+            return Err(SplitPlanError::EmptySplitKey);
+        }
+        Ok(Self {
+            split_key,
+            lower,
+            source_high_water: 0,
+            target_applied_through: 0,
+            acked_through: 0,
+            phase: SplitPhase::Planned,
+            context: None,
+        })
+    }
+
+    /// Plans a split with the identity and placement context required for a
+    /// restart-safe orchestration attempt.
+    pub fn plan_with_context(
+        lower: Option<Vec<u8>>,
+        split_key: Vec<u8>,
+        context: super::SplitContext,
+    ) -> Result<Self, SplitPlanError> {
+        let mut split = Self::plan(lower, split_key)?;
+        split.context = Some(context);
+        Ok(split)
+    }
+
+    /// Restores a split from its durable state.
+    pub fn from_durable_state(state: DurableSplitState) -> Result<Self, SplitStateError> {
+        if state.split_key().is_empty() {
+            return Err(SplitStateError::EmptySplitKey);
+        }
+        if state.lower().is_some_and(|lower| lower >= state.split_key()) {
+            return Err(SplitStateError::Malformed);
+        }
+        Ok(Self {
+            split_key: state.split_key().to_vec(),
+            lower: state.lower().map(ToOwned::to_owned),
+            source_high_water: state.source_high_water(),
+            target_applied_through: state.target_applied_through(),
+            acked_through: state.acked_through(),
+            phase: state.phase(),
+            context: state.context(),
+        })
+    }
+
+    /// Returns a restart-safe state snapshot.
+    #[must_use]
+    pub fn durable_state(&self) -> DurableSplitState {
+        let state = DurableSplitState::new(
+            self.lower.clone(),
+            self.split_key.clone(),
+            self.source_high_water,
+            self.target_applied_through,
+            self.acked_through,
+            self.phase,
+        );
+        match self.context {
+            Some(context) => state.with_context(context),
+            None => state,
+        }
+    }
+
+    /// Returns the moved range's upper-exclusive bound.
+    #[must_use]
+    pub fn split_key(&self) -> &[u8] {
+        &self.split_key
+    }
+
+    /// Returns the inclusive lower bound of the moved range, when bounded.
+    #[must_use]
+    pub fn lower(&self) -> Option<&[u8]> {
+        self.lower.as_deref()
+    }
+
+    /// Returns the current lifecycle phase.
+    #[must_use]
+    pub const fn phase(&self) -> SplitPhase {
+        self.phase
+    }
+
+    /// Returns the latest source journal high-water mark.
+    #[must_use]
+    pub const fn source_high_water(&self) -> u64 {
+        self.source_high_water
+    }
+
+    /// Returns the target's applied-through mark.
+    #[must_use]
+    pub const fn target_applied_through(&self) -> u64 {
+        self.target_applied_through
+    }
+
+    /// Returns the highest acknowledged write sequence.
+    #[must_use]
+    pub const fn acked_through(&self) -> u64 {
+        self.acked_through
+    }
+
+    /// Returns the identity, session frontier, and placement context.
+    #[must_use]
+    pub const fn context(&self) -> Option<super::SplitContext> {
+        self.context
+    }
+
+    /// Marks the target shard file created and begins range backfill.
+    pub fn begin_backfill(&mut self) -> Result<(), SplitCutoverError> {
+        match self.phase {
+            SplitPhase::Planned => {
+                self.phase = SplitPhase::Backfilling;
+                Ok(())
+            }
+            // Recovery may replay the operation after the durable transition
+            // was committed but before the worker observed its response.
+            SplitPhase::Backfilling => Ok(()),
+            _ => Err(SplitCutoverError::WrongPhase(self.phase)),
+        }
+    }
+
+    /// Marks backfill complete through `through` and begins journal catch-up.
+    pub fn begin_catch_up(&mut self, through: u64) -> Result<(), SplitCutoverError> {
+        match self.phase {
+            SplitPhase::Backfilling => {
+                self.target_applied_through = self.target_applied_through.max(through);
+                self.phase = SplitPhase::CatchingUp;
+                Ok(())
+            }
+            // The catch-up start is also a retry-safe checkpoint update.
+            SplitPhase::CatchingUp => {
+                self.target_applied_through = self.target_applied_through.max(through);
+                Ok(())
+            }
+            _ => Err(SplitCutoverError::WrongPhase(self.phase)),
+        }
+    }
+
+    /// Advances the source high-water mark monotonically.
+    pub fn note_source_high_water(&mut self, sequence: u64) {
+        if matches!(
+            self.phase,
+            SplitPhase::Planned | SplitPhase::Backfilling | SplitPhase::CatchingUp
+        ) {
+            self.source_high_water = self.source_high_water.max(sequence);
+        }
+    }
+
+    /// Advances the target applied-through mark monotonically.
+    pub fn note_target_applied(&mut self, sequence: u64) {
+        if matches!(self.phase, SplitPhase::Backfilling | SplitPhase::CatchingUp) {
+            self.target_applied_through = self.target_applied_through.max(sequence);
+        }
+    }
+
+    /// Advances the acknowledged-write frontier monotonically.
+    pub fn note_acked(&mut self, sequence: u64) {
+        if matches!(
+            self.phase,
+            SplitPhase::Planned | SplitPhase::Backfilling | SplitPhase::CatchingUp
+        ) {
+            self.acked_through = self.acked_through.max(sequence);
+        }
+    }
+
+    /// Reports whether source and acknowledged writes are fully applied.
+    #[must_use]
+    pub const fn can_cut_over(&self) -> bool {
+        matches!(self.phase, SplitPhase::CatchingUp)
+            && self.target_applied_through >= self.source_high_water
+            && self.target_applied_through >= self.acked_through
+    }
+
+    /// Moves routing to the target, only after the zero-loss gate passes.
+    pub fn cut_over(&mut self) -> Result<(), SplitCutoverError> {
+        if self.phase == SplitPhase::CutOver {
+            return Ok(());
+        }
+        self.require_phase(SplitPhase::CatchingUp)?;
+        let required = self.source_high_water.max(self.acked_through);
+        if self.target_applied_through < required {
+            return Err(SplitCutoverError::NotCaughtUp {
+                target_applied: self.target_applied_through,
+                required,
+            });
+        }
+        self.phase = SplitPhase::CutOver;
+        Ok(())
+    }
+
+    /// Moves the lifecycle to cut-over using a writer-fence permit.
+    ///
+    /// The permit is checked before changing any state.  The plain
+    /// [`Self::cut_over`] method remains available for owners that perform
+    /// the equivalent fence and route replacement in one storage transaction;
+    /// this method is the explicit, easy-to-audit form for that path.
+    pub fn cut_over_with_permit(&mut self, permit: CutoverPermit) -> Result<(), SplitCutoverError> {
+        if !permit.is_valid() {
+            return Err(SplitCutoverError::InvalidFencePermit);
+        }
+        let required = self.source_high_water.max(self.acked_through);
+        // The permit describes the writer sequence that was drained.  The
+        // lifecycle must also have observed that sequence on the target;
+        // otherwise a caller could fence writers and publish a route while
+        // the target still trails the fenced writes.
+        let required = required.max(permit.required());
+        if self.target_applied_through < required {
+            return Err(SplitCutoverError::NotCaughtUp {
+                target_applied: self.target_applied_through,
+                required,
+            });
+        }
+        self.cut_over()
+    }
+
+    /// Moves to cut-over only when the permit belongs to `fence`.
+    ///
+    /// A permit is intentionally opaque, but accepting a permit from an
+    /// unrelated fence would let a concurrent split move a route.  Callers
+    /// that have a writer fence should use this method; the permit-only
+    /// method remains for storage adapters that perform both checks in one
+    /// transaction.
+    pub fn cut_over_with_fence(
+        &mut self,
+        fence: &WriterFence,
+        permit: CutoverPermit,
+    ) -> Result<(), SplitCutoverError> {
+        if !fence.permits(permit) {
+            return Err(SplitCutoverError::InvalidFencePermit);
+        }
+        self.cut_over_with_permit(permit)
+    }
+
+    /// Marks the moved range verified and eligible for source cleanup.
+    pub fn note_verified(&mut self) -> Result<(), SplitCutoverError> {
+        match self.phase {
+            SplitPhase::CutOver => {
+                self.phase = SplitPhase::Complete;
+                Ok(())
+            }
+            // Verification and source cleanup are commonly retried after a
+            // process restart.  Completion is terminal and idempotent.
+            SplitPhase::Complete => Ok(()),
+            _ => Err(SplitCutoverError::WrongPhase(self.phase)),
+        }
+    }
+
+    /// Aborts a split before cutover; no route was moved.
+    pub fn abort(&mut self) -> Result<(), SplitCutoverError> {
+        match self.phase {
+            SplitPhase::Planned | SplitPhase::Backfilling | SplitPhase::CatchingUp => {
+                self.phase = SplitPhase::Aborted;
+                Ok(())
+            }
+            SplitPhase::Aborted => Ok(()),
+            phase => Err(SplitCutoverError::WrongPhase(phase)),
+        }
+    }
+
+    fn require_phase(&self, expected: SplitPhase) -> Result<(), SplitCutoverError> {
+        if self.phase == expected { Ok(()) } else { Err(SplitCutoverError::WrongPhase(self.phase)) }
+    }
+}
diff --git a/src/shard_split/range_copy.rs b/src/shard_split/range_copy.rs
new file mode 100644
index 00000000..d61e3d08
--- /dev/null
+++ b/src/shard_split/range_copy.rs
@@ -0,0 +1,320 @@
+//! Range backfill interfaces.
+
+/// One opaque canonical key and its canonical document bytes.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct CopyEntry {
+    key: Vec<u8>,
+    value: Vec<u8>,
+}
+
+impl CopyEntry {
+    /// Creates one copy entry. Empty keys are refused by the source contract.
+    #[must_use]
+    pub fn new(key: Vec<u8>, value: Vec<u8>) -> Self {
+        Self { key, value }
+    }
+
+    /// Returns the canonical key.
+    #[must_use]
+    pub fn key(&self) -> &[u8] {
+        &self.key
+    }
+
+    /// Returns the opaque canonical document bytes.
+    #[must_use]
+    pub fn value(&self) -> &[u8] {
+        &self.value
+    }
+}
+
+/// One bounded backfill response, checkpointed at a journal sequence.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct CopyBatch {
+    entries: Vec<CopyEntry>,
+    through: u64,
+    done: bool,
+}
+
+/// Durable cursor for restarting a range copy without rescanning applied
+/// rows. The target apply operation remains idempotent if a crash happens
+/// between its commit and persistence of this cursor.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct CopyCheckpoint {
+    lower: Option<Vec<u8>>,
+    upper: Vec<u8>,
+    after_key: Option<Vec<u8>>,
+    through: u64,
+    copied: u64,
+    done: bool,
+}
+
+impl CopyCheckpoint {
+    /// Returns the lower-inclusive bound, when the range is bounded below.
+    #[must_use]
+    pub fn lower(&self) -> Option<&[u8]> {
+        self.lower.as_deref()
+    }
+    /// Returns the upper-exclusive bound.
+    #[must_use]
+    pub fn upper(&self) -> &[u8] {
+        &self.upper
+    }
+
+    /// Returns the last copied key, if any.
+    #[must_use]
+    pub fn after_key(&self) -> Option<&[u8]> {
+        self.after_key.as_deref()
+    }
+
+    /// Returns the source sequence represented by the copy.
+    #[must_use]
+    pub const fn through(&self) -> u64 {
+        self.through
+    }
+
+    /// Returns the number of entries applied.
+    #[must_use]
+    pub const fn copied(&self) -> u64 {
+        self.copied
+    }
+
+    /// Returns whether the source declared the range complete.
+    #[must_use]
+    pub const fn done(&self) -> bool {
+        self.done
+    }
+}
+
+impl CopyBatch {
+    /// Creates a response for a range-copy page.
+    #[must_use]
+    pub fn new(entries: Vec<CopyEntry>, through: u64, done: bool) -> Self {
+        Self { entries, through, done }
+    }
+
+    /// Returns entries in canonical key order.
+    #[must_use]
+    pub fn entries(&self) -> &[CopyEntry] {
+        &self.entries
+    }
+
+    /// Returns the source sequence represented by this page.
+    #[must_use]
+    pub const fn through(&self) -> u64 {
+        self.through
+    }
+
+    /// Returns whether this page completes the backfill.
+    #[must_use]
+    pub const fn done(&self) -> bool {
+        self.done
+    }
+}
+
+/// Failure detected while driving a range copy.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum CopyError {
+    /// The source failed before returning a page.
+    SourceFailed,
+    /// The target failed to durably apply a page.
+    TargetFailed,
+    /// A non-terminal empty page repeated the current checkpoint.
+    NoProgress,
+    /// A source returned a page that regressed its sequence checkpoint.
+    CheckpointRegressed {
+        /// Last accepted checkpoint.
+        previous: u64,
+        /// Invalid returned checkpoint.
+        returned: u64,
+    },
+    /// A source returned keys out of canonical order.
+    KeysOutOfOrder,
+    /// A source returned an empty key.
+    EmptyKey,
+}
+
+/// Source-side range scan seam implemented by the storage worker.
+pub trait RangeCopySource {
+    /// Source-specific I/O failure.
+    type Error;
+
+    /// Reads one bounded page at or above `lower`, strictly after `after_key`,
+    /// and below `upper`.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`Self::Error`] when the source scan fails.
+    fn read_range(
+        &mut self,
+        lower: Option<&[u8]>,
+        after_key: Option<&[u8]>,
+        upper: &[u8],
+        limit: usize,
+    ) -> Result<CopyBatch, Self::Error>;
+}
+
+/// Target-side idempotent apply seam implemented by the storage worker.
+pub trait RangeCopyTarget {
+    /// Target-specific I/O failure.
+    type Error;
+
+    /// Applies one page transactionally and durably.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`Self::Error`] when the page cannot be applied durably.
+    fn apply_copy_batch(&mut self, batch: &CopyBatch) -> Result<(), Self::Error>;
+}
+
+/// Resumable, bounded range-copy driver.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct RangeCopier {
+    lower: Option<Vec<u8>>,
+    upper: Vec<u8>,
+    after_key: Option<Vec<u8>>,
+    through: u64,
+    copied: u64,
+    done: bool,
+}
+
+impl RangeCopier {
+    /// Starts a copy of keys below `upper`.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`CopyError::EmptyKey`] when `upper` is empty.
+    pub fn new(lower: Option<Vec<u8>>, upper: Vec<u8>) -> Result<Self, CopyError> {
+        if upper.is_empty()
+            || lower.as_deref().is_some_and(|lower| lower.is_empty() || lower >= upper.as_slice())
+        {
+            return Err(CopyError::EmptyKey);
+        }
+        Ok(Self { lower, upper, after_key: None, through: 0, copied: 0, done: false })
+    }
+
+    /// Resumes from a previously durable cursor.
+    pub fn resume(checkpoint: CopyCheckpoint) -> Result<Self, CopyError> {
+        if checkpoint.upper.is_empty()
+            || checkpoint
+                .lower
+                .as_deref()
+                .is_some_and(|lower| lower.is_empty() || lower >= checkpoint.upper.as_slice())
+            || checkpoint
+                .after_key
+                .as_deref()
+                .is_some_and(|key| key.is_empty() || key >= checkpoint.upper.as_slice())
+        {
+            return Err(CopyError::EmptyKey);
+        }
+        Ok(Self {
+            lower: checkpoint.lower,
+            upper: checkpoint.upper,
+            after_key: checkpoint.after_key,
+            through: checkpoint.through,
+            copied: checkpoint.copied,
+            done: checkpoint.done,
+        })
+    }
+
+    /// Returns the upper-exclusive range bound.
+    #[must_use]
+    pub fn upper(&self) -> &[u8] {
+        &self.upper
+    }
+
+    /// Returns the lower-inclusive bound, when the range is bounded below.
+    #[must_use]
+    pub fn lower(&self) -> Option<&[u8]> {
+        self.lower.as_deref()
+    }
+
+    /// Returns the last durable source checkpoint.
+    #[must_use]
+    pub const fn through(&self) -> u64 {
+        self.through
+    }
+
+    /// Returns the number of entries durably applied so far.
+    #[must_use]
+    pub const fn copied(&self) -> u64 {
+        self.copied
+    }
+
+    /// Returns whether the source has declared the range complete.
+    #[must_use]
+    pub const fn is_done(&self) -> bool {
+        self.done
+    }
+
+    /// Returns the cursor that should be persisted after a successful step.
+    #[must_use]
+    pub fn checkpoint(&self) -> CopyCheckpoint {
+        CopyCheckpoint {
+            lower: self.lower.clone(),
+            upper: self.upper.clone(),
+            after_key: self.after_key.clone(),
+            through: self.through,
+            copied: self.copied,
+            done: self.done,
+        }
+    }
+
+    /// Copies and applies one bounded page, preserving its checkpoint.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`CopyError::SourceFailed`] when the source scan fails,
+    /// [`CopyError::CheckpointRegressed`] when the page checkpoint moves
+    /// backwards, [`CopyError::NoProgress`] when a non-terminal empty page
+    /// repeats the current checkpoint, [`CopyError::EmptyKey`] for an empty
+    /// key, [`CopyError::KeysOutOfOrder`] for keys outside the range or out
+    /// of canonical order, and [`CopyError::TargetFailed`] when the target
+    /// cannot apply the page durably.
+    pub fn step<S, T>(
+        &mut self,
+        source: &mut S,
+        target: &mut T,
+        limit: usize,
+    ) -> Result<bool, CopyError>
+    where
+        S: RangeCopySource,
+        T: RangeCopyTarget,
+    {
+        if self.done {
+            return Ok(true);
+        }
+        let batch = source
+            .read_range(self.lower.as_deref(), self.after_key.as_deref(), &self.upper, limit.max(1))
+            .map_err(|_| CopyError::SourceFailed)?;
+        if batch.through() < self.through {
+            return Err(CopyError::CheckpointRegressed {
+                previous: self.through,
+                returned: batch.through(),
+            });
+        }
+        if batch.entries().is_empty() && !batch.done() && batch.through() == self.through {
+            return Err(CopyError::NoProgress);
+        }
+        let mut previous = self.after_key.as_deref();
+        for entry in batch.entries() {
+            if entry.key().is_empty() {
+                return Err(CopyError::EmptyKey);
+            }
+            if self.lower.as_deref().is_some_and(|lower| entry.key() < lower)
+                || entry.key() >= self.upper.as_slice()
+                || previous.is_some_and(|key| entry.key() <= key)
+            {
+                return Err(CopyError::KeysOutOfOrder);
+            }
+            previous = Some(entry.key());
+        }
+        target.apply_copy_batch(&batch).map_err(|_| CopyError::TargetFailed)?;
+        self.through = batch.through();
+        self.copied = self.copied.saturating_add(batch.entries().len() as u64);
+        if let Some(entry) = batch.entries().last() {
+            self.after_key = Some(entry.key().to_vec());
+        }
+        self.done = batch.done();
+        Ok(self.done)
+    }
+}
