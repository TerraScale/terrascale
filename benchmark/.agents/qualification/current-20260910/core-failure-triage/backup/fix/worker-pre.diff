+    struct RetentionArtifacts {
+        _lease: Arc<DatabaseKeyLease>,
+        _connection: rusqlite::Connection,
+        namespace: String,
+        expired: super::super::BackupManifest,
+        unexpired: super::super::BackupManifest,
+        envelope: BackupEnvelope,
+    }
+
+    fn retention_artifacts(
+        engine_dir: &Path,
+        engine: &Engine,
+        config: &StreamConfig,
+    ) -> RetentionArtifacts {
+        let database = engine.database_id().to_string();
+        let incarnation = u128::from_be_bytes(engine.database_id().as_bytes());
+        let file_identity = crate::shard_split::FileShardIdentity {
+            database_incarnation: incarnation,
+            shard_id: 1,
+            region: engine.database_owner().region(),
+            origin_lane_incarnation: 1,
+        };
+        let namespace = participant_namespace(file_identity);
+        committed(put(
+            engine,
+            engine.database_owner().tenant().to_text().as_str(),
+            "retention-expiry-op",
+            "retention-expiry-doc",
+            "users",
+            text("retention"),
+            LocalDurability::Synced,
+        ));
+        let boundary = engine.journaled_high_water().unwrap().unwrap();
+        // Pin the committed publication clock to a deterministic old value
+        // after the real commit. This keeps the expired capture clock at
+        // or after its source boundary while making its retention deadline
+        // unambiguously elapsed.
+        let connection = crate::storage::open_physical_sqlite(
+            &crate::engine::database_file(engine_dir),
+            rusqlite::OpenFlags::SQLITE_OPEN_READ_WRITE,
+        )
+        .unwrap();
+        connection
+            .execute(
+                "UPDATE replication_publications SET committed_at = 1_000 WHERE local_seq = ?1",
+                rusqlite::params![boundary.get().cast_signed()],
+            )
+            .unwrap();
+        let lease = config.keys.lease().unwrap();
+        let make_point = |clock| {
+            let reader: Arc<dyn BackupReader + Send + Sync> = config.keys.clone();
+            run_backup(
+                engine,
+                BackupPlan::snapshot_at(
+                    boundary,
+                    BackupEncryption::from_database_key_lease(
+                        &lease,
+                        engine.database_owner().region(),
+                        0,
+                    )
+                    .unwrap(),
+                )
+                .with_retention_days(1)
+                .unwrap()
+                .with_capture_unix_millis(clock)
+                .with_reader(reader),
+                &config.staging.join(&namespace),
+            )
+            .unwrap()
+            .manifest()
+            .clone()
+        };
+        let now =
+            std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis();
+        let now = u64::try_from(now).unwrap();
+        // Boundary zero has clock zero, so this is a valid expired capture.
+        let expired = make_point(2_000);
+        let unexpired = make_point(now);
+        let envelope = BackupEnvelope::assemble(
+            database.clone(),
+            incarnation,
+            1,
+            vec![BackupEnvelopeParticipant {
+                file_identity,
+                is_root: true,
+                routes: vec![crate::shard_split::ShardRoute::new(1, None, None).unwrap()],
+                participant_id: "shard-0000000000000001".into(),
+                database_id: database.clone(),
+                database_incarnation: incarnation,
+                route_generation: 1,
+                boundary: boundary.get(),
+                manifest: expired.clone(),
+            }],
+        )
+        .unwrap();
+        RetentionArtifacts {
+            namespace,
+            expired,
+            unexpired,
+            envelope,
+            _lease: lease,
+            _connection: connection,
+        }
+    }
