+    fn retention_setup() -> RetentionSetup {
+        let (engine_dir, engine) = open_engine("scheduled-envelope-retention");
+        let engine = Arc::new(engine);
+        let staging = location("scheduled-envelope-retention-staging");
+        let first_store = Arc::new(object_store::memory::InMemory::new());
+        let second_store = Arc::new(RetentionDeleteStore {
+            inner: Arc::new(object_store::memory::InMemory::new()),
+            pause_key: std::sync::Mutex::new(None),
+            deleted: Arc::new(tokio::sync::Notify::new()),
+        });
+        let first = Arc::new(ObjectDestination::for_test(
+            Provider::Oci,
+            first_store,
+            4 * 1024 * 1024,
+            8 * 1024 * 1024,
+        ));
+        let second = Arc::new(ObjectDestination::for_test(
+            Provider::Tigris,
+            second_store.clone(),
+            4 * 1024 * 1024,
+            8 * 1024 * 1024,
+        ));
+        let config = StreamConfig {
+            engine: engine.clone(),
+            keys: keys(&engine),
+            destinations: vec![(Provider::Oci, first.clone()), (Provider::Tigris, second.clone())],
+            historical_destinations: Vec::new(),
+            policy_revision: "retention-restart".into(),
+            retention_days: 1,
+            staging: staging.clone(),
+            placement: PlacementLock::br_only(),
+        };
+        let limits = FleetLimits {
+            streams: 1,
+            staging_bytes_per_stream: 32 * 1024 * 1024,
+            inventory_bytes_per_stream: 16 * 1024 * 1024,
+            points_per_stream: 16,
+        };
+        RetentionSetup { engine_dir, engine, config, limits, second_store }
+    }
