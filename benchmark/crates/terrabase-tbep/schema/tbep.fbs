// ---------------------------------------------------------------------------
// Protocol constants
// ---------------------------------------------------------------------------
//
// The pinned compiler (flatc 25.12.19) removed `const` declarations from
// the schema grammar, so the protocol constants live in three places,
// each checked in:
//
// - `TBEP_PROTOCOL_MAJOR = 1` and `TBEP_PROTOCOL_MINOR = 0` are the
//   envelope field defaults below (`protocol_major`, `protocol_minor`).
//   A reader rejects an unsupported major before any body access.
// - The global frame ceiling `MAX_FRAME_BYTES = 16777216` and the
//   per-operation budgets live in `schema/tbep-registry.json`
//   (`max_frame_bytes`, `budgets`); the receiver enforces them before
//   parsing (see `tools/tbep-fbs` decode seam).
// - The registry wire version this envelope mirrors is
//   `tbep-registry.json` `wire_version` (currently 1).

/// Required-feature bits carried in the envelope. Bit 0 is the only
/// defined feature: application-level Zstandard for large opaque
/// payloads, which a receiver may serve only after a decision-grade
/// codec receipt exists (ADR 0025). Unknown required bits fail closed
/// before body access.
enum FeatureBits : ulong (bit_flags) {
  ZSTD_LARGE_PAYLOAD = 0
}

// ---------------------------------------------------------------------------
// The operation discriminant (registry frame codes, explicit)
// ---------------------------------------------------------------------------

/// Every TBEP frame kind by its `tbep-registry.json` wire code: the
/// three channel frames (1..=3), every operation request and response
/// code, and the three notification codes. Codes are explicit, stable,
/// and never reused; `NONE` (0) is the absent sentinel.
enum TbepOperation : ushort {
  NONE = 0,
  // Channel frames.
  ERROR = 1,
  NEGOTIATION_REQUEST = 2,
  NEGOTIATION_RESPONSE = 3,
  // Documents.
  DOCUMENT_READ = 257,
  DOCUMENT_READ_RESPONSE = 513,
  DOCUMENT_WRITE = 258,
  DOCUMENT_WRITE_RESPONSE = 514,
  DOCUMENT_DELETE = 259,
  DOCUMENT_DELETE_RESPONSE = 515,
  DOCUMENT_BATCH = 264,
  DOCUMENT_BATCH_RESPONSE = 605,
  // Query.
  QUERY_EXECUTE = 260,
  QUERY_EXECUTE_RESPONSE = 516,
  QUERY_CANCEL = 261,
  QUERY_CANCEL_RESPONSE = 517,
  // Typed families.
  FAMILY_READ = 262,
  FAMILY_READ_RESPONSE = 518,
  FAMILY_WRITE = 263,
  FAMILY_WRITE_RESPONSE = 519,
  // Backbone subscriptions.
  BACKBONE_SUBSCRIBE = 272,
  BACKBONE_SUBSCRIBE_RESPONSE = 528,
  BACKBONE_ACKNOWLEDGE = 273,
  BACKBONE_ACKNOWLEDGE_RESPONSE = 529,
  BACKBONE_UNSUBSCRIBE = 274,
  BACKBONE_UNSUBSCRIBE_RESPONSE = 530,
  // Sync delivery.
  SYNC_SESSION_SETUP = 288,
  SYNC_SESSION_SETUP_RESPONSE = 544,
  SYNC_DELTA_PULL = 289,
  SYNC_DELTA_PULL_RESPONSE = 545,
  SYNC_SNAPSHOT_PULL = 290,
  SYNC_SNAPSHOT_PULL_RESPONSE = 546,
  SYNC_CHECKPOINT_ACK = 291,
  SYNC_CHECKPOINT_ACK_RESPONSE = 547,
  SYNC_MUTATION_SUBMIT = 292,
  SYNC_MUTATION_SUBMIT_RESPONSE = 548,
  SYNC_SESSION_CLOSE = 293,
  SYNC_SESSION_CLOSE_RESPONSE = 549,
  // Topology and admin.
  TOPOLOGY_READ = 304,
  TOPOLOGY_READ_RESPONSE = 560,
  ADMIN_STATUS = 305,
  ADMIN_STATUS_RESPONSE = 561,
  // Replication observation.
  REPLICATION_CONFLICTS = 306,
  REPLICATION_CONFLICTS_RESPONSE = 562,
  REPLICATION_FENCED = 307,
  REPLICATION_FENCED_RESPONSE = 563,
  REPLICATION_DEPOSITIONS = 308,
  REPLICATION_DEPOSITIONS_RESPONSE = 564,
  REPLICATION_CURSOR = 309,
  REPLICATION_CURSOR_RESPONSE = 565,
  REPLICATION_HEALTH = 310,
  REPLICATION_HEALTH_RESPONSE = 566,
  REPLICATION_DENIALS = 311,
  REPLICATION_DENIALS_RESPONSE = 567,
  // Supervision.
  CHANNEL_BIND = 320,
  CHANNEL_BIND_RESPONSE = 576,
  SUPERVISION_HEALTH = 321,
  SUPERVISION_HEALTH_RESPONSE = 577,
  SUPERVISION_SHUTDOWN = 322,
  SUPERVISION_SHUTDOWN_RESPONSE = 578,
  // Schemas and migrations.
  SCHEMA_DECLARE = 336,
  SCHEMA_DECLARE_RESPONSE = 592,
  SCHEMA_STATUS = 337,
  SCHEMA_STATUS_RESPONSE = 593,
  SCHEMA_VALIDATE = 338,
  SCHEMA_VALIDATE_RESPONSE = 594,
  MIGRATION_STATUS = 339,
  MIGRATION_STATUS_RESPONSE = 595,
  MIGRATION_DRY_RUN = 340,
  MIGRATION_DRY_RUN_RESPONSE = 596,
  MIGRATION_APPLY = 341,
  MIGRATION_APPLY_RESPONSE = 597,
  // Storage tiers.
  TIER_CONFIGURE = 342,
  TIER_CONFIGURE_RESPONSE = 598,
  TIER_INSPECT = 343,
  TIER_INSPECT_RESPONSE = 599,
  TIER_DRY_RUN = 344,
  TIER_DRY_RUN_RESPONSE = 600,
  TIER_EXPLAIN = 345,
  TIER_EXPLAIN_RESPONSE = 601,
  TIER_RUN = 346,
  TIER_RUN_RESPONSE = 602,
  TIER_PAUSE = 347,
  TIER_PAUSE_RESPONSE = 603,
  TIER_RESUME = 348,
  TIER_RESUME_RESPONSE = 604,
  // Notifications (server-pushed).
  SUBSCRIPTION_BATCH = 769,
  TRIGGER_NOTIFICATION = 770,
  SUBSCRIPTION_CLOSED = 771
}

// ---------------------------------------------------------------------------
// The frame body union (declaration order pins the structural tag)
// ---------------------------------------------------------------------------

/// The typed body of one TBEP envelope. Members are the three channel
/// frames, every operation request and response body in registry
/// operation order, then the three notifications. Members are append-only
/// and never reordered; the wire-authoritative discriminant is the
/// envelope's `operation` code.
union TbepFrame {
  ErrorFrame,
  NegotiationRequestFrame,
  NegotiationResponseFrame,
  ChannelBindRequest,
  ChannelBindResponse,
  DocumentReadRequest,
  DocumentReadResponse,
  DocumentWriteRequest,
  DocumentWriteResponse,
  DocumentDeleteRequest,
  DocumentDeleteResponse,
  DocumentBatchRequest,
  DocumentBatchResponse,
  QueryExecuteRequest,
  QueryExecuteResponse,
  QueryCancelRequest,
  QueryCancelResponse,
  FamilyReadRequest,
  FamilyReadResponse,
  FamilyWriteRequest,
  FamilyWriteResponse,
  BackboneSubscribeRequest,
  BackboneSubscribeResponse,
  BackboneAcknowledgeRequest,
  BackboneAcknowledgeResponse,
  BackboneUnsubscribeRequest,
  BackboneUnsubscribeResponse,
  SyncSessionSetupRequest,
  SyncSessionSetupResponse,
  SyncDeltaPullRequest,
  SyncDeltaPullResponse,
  SyncSnapshotPullRequest,
  SyncSnapshotPullResponse,
  SyncCheckpointAckRequest,
  SyncCheckpointAckResponse,
  SyncMutationSubmitRequest,
  SyncMutationSubmitResponse,
  SyncSessionCloseRequest,
  SyncSessionCloseResponse,
  TopologyReadRequest,
  TopologyReadResponse,
  AdminStatusRequest,
  AdminStatusResponse,
  ReplicationConflictsRequest,
  ReplicationConflictsResponse,
  ReplicationFencedRequest,
  ReplicationFencedResponse,
  ReplicationDepositionsRequest,
  ReplicationDepositionsResponse,
  ReplicationCursorRequest,
  ReplicationCursorResponse,
  ReplicationHealthRequest,
  ReplicationHealthResponse,
  ReplicationDenialsRequest,
  ReplicationDenialsResponse,
  SupervisionHealthRequest,
  SupervisionHealthResponse,
  SupervisionShutdownRequest,
  SupervisionShutdownResponse,
  SchemaDeclareRequest,
  SchemaDeclareResponse,
  SchemaStatusRequest,
  SchemaStatusResponse,
  SchemaValidateRequest,
  SchemaValidateResponse,
  MigrationStatusRequest,
  MigrationStatusResponse,
  MigrationDryRunRequest,
  MigrationDryRunResponse,
  MigrationApplyRequest,
  MigrationApplyResponse,
  TierConfigureRequest,
  TierConfigureResponse,
  TierInspectRequest,
  TierInspectResponse,
  TierDryRunRequest,
  TierDryRunResponse,
  TierExplainRequest,
  TierExplainResponse,
  TierRunRequest,
  TierRunResponse,
  TierPauseRequest,
  TierPauseResponse,
  TierResumeRequest,
  TierResumeResponse,
  SubscriptionBatchFrame,
  TriggerNotificationFrame,
  SubscriptionClosedFrame
}

// ---------------------------------------------------------------------------
// The envelope (ADR 0025: exactly these seven fields)
// ---------------------------------------------------------------------------

/// One complete TBEP frame: the protocol version pair, the required
/// feature bits, the operation discriminant, the correlation and
/// causation ULIDs, and the typed body. A QUIC stream carries standard
/// size-prefixed FlatBuffers of this root type; one prefix names one
/// complete buffer and no second transport length prefix is added.
table TbepEnvelope {
  /// Protocol major; unsupported majors fail closed before body access.
  protocol_major: ushort = 1 (id: 0);
  /// Protocol minor; additive schema change bumps this.
  protocol_minor: ushort (id: 1);
  /// Required feature bits (see `FeatureBits`); unknown required bits
  /// fail closed before body access.
  required_features: FeatureBits (id: 2);
  /// The wire-authoritative frame discriminant
  /// (`tbep-registry.json` code).
  operation: TbepOperation (id: 3);
  /// The caller-assigned correlation identity (ADR 0027 ULID, 16 bytes).
  correlation: Ulid (id: 4);
  /// The frame this frame answers or continues (ADR 0027 ULID,
  /// 16 bytes); the zeroed ULID marks a frame with no causal parent.
  causation: Ulid (id: 5);
  /// The typed frame body.
  body: TbepFrame (id: 7);
}

root_type TbepEnvelope;
file_identifier "TBEP";
