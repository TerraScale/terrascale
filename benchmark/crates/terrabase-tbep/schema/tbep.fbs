// `tbep.fbs` — the authoritative TBEP root schema (ADR 0025, phase 1).
//
// Private TerraBase Engine Protocol envelope: generated FlatBuffers over
// QUIC with TLS 1.3 between the Rust engine and `TerraScale.Database`.
// FlatBuffers is never exposed to a public browser or SDK.
//
// Authority and generation:
//
// - This checked-in root schema is the single authority for the TBEP
//   FlatBuffers surface (one file on purpose: the pinned compiler's
//   single-file output is one deterministic artifact to drift-check).
//   Generated files are never schema authority.
// - Bindings are regenerated by `tools/tbep-fbs/generate.sh` with the
//   pinned compiler (`flatc` 25.12.19, `nixpkgs#flatbuffers`) and must be
//   byte-identical to the committed artifacts
//   (`src/generated/fbs/*_generated.rs`); `tests/fbs_drift.rs` enforces
//   the drift contract.
// - Every table field has an explicit contiguous numeric `(id: N)`. IDs
//   are never reused or reinterpreted; compatible change is append-only
//   within the current major (ADR 0025 "Versioning").
// - The FlatBuffers language assigns union member discriminants by
//   declaration order and has no syntax to make them explicit, so the
//   wire-authoritative operation discriminant is the envelope's explicit
//   `operation: TbepOperation` numeric code (the `tbep-registry.json`
//   frame code, never reused). The `body` union tag is structural,
//   pinned by this declaration order, and must never be reordered.
//
// Phase-1 scope, stated honestly: this schema and its generated bindings
// are added beside the live positional-array codec; no wire migration has
// happened. The existing codec remains the served TBEP surface until the
// coordinated break in a later ADR 0025 phase.

namespace terrabase.tbep;

// ---------------------------------------------------------------------------
// Shared payload definitions (registry `enums`, `types`, `value_type`)
// ---------------------------------------------------------------------------

enum ErrorCode : ushort {
  NONE = 0,
  UNSUPPORTED_VERSION = 1,
  MALFORMED_FRAME = 2,
  UNKNOWN_FRAME_KIND = 3,
  UNKNOWN_OPERATION = 4,
  DIGEST_MISMATCH = 5,
  IDEMPOTENCY_PAIRING = 6,
  UNBOUND_CHANNEL = 7,
  ALREADY_BOUND = 8,
  INVALID_REQUEST = 9,
  OPERATION_REFUSED = 10,
  ENGINE_FAILURE = 11,
  SESSION_REFUSED = 12,
  SUBSCRIPTION_REFUSED = 13,
  CHECKPOINT_REFUSED = 14,
  SHUTTING_DOWN = 15,
  FRAME_TOO_LARGE = 16,
  OVERLOADED = 17,
  PROTOCOL_VERSION_MISMATCH = 18,
  BACKUP_CLUSTER_READ_ONLY = 19,
  BACKUP_CLUSTER_IMMUTABLE = 20,
  COLD_TIER_UNAVAILABLE = 21,
  FRONTIER_UNREACHABLE = 22
}

/// Registry `acknowledgement` (codes 1..=3); absent means the caller did
/// not request an acknowledgement level beyond the default.
enum Acknowledgement : ubyte {
  NONE = 0,
  REGIONAL_QUORUM = 1,
  GLOBAL_QUORUM = 2,
  BACKUP_ACK = 3
}

/// Registry `backup_outcome`; the registry's `none` variant keeps code 1
/// as `NO_BACKUP` (a real observation, distinct from the field being
/// absent).
enum BackupOutcome : ubyte {
  NONE = 0,
  NO_BACKUP = 1,
  FULL = 2,
  PARTIAL = 3
}

/// Registry `read_level` (codes 1..=3).
enum ReadLevel : ubyte {
  NONE = 0,
  LOCAL = 1,
  REGIONAL_QUORUM_READ = 2,
  GLOBAL_QUORUM_READ = 3
}

/// Registry `cluster_mode` (codes 1..=3).
enum ClusterMode : ubyte {
  NONE = 0,
  STANDALONE = 1,
  ACTIVE = 2,
  BACKUP = 3
}

/// Registry `tier_decision`; the registry's `none` variant keeps code 4
/// as `NONE_DECISION`.
enum TierDecision : ubyte {
  NONE = 0,
  PROMOTE = 1,
  DEMOTE = 2,
  SPLIT = 3,
  NONE_DECISION = 4,
  REFUSED = 5
}

/// Registry `write_reason` (codes 1..=3).
enum WriteReason : ubyte {
  NONE = 0,
  INVALID_DOCUMENT = 1,
  SCHEMA_REFUSED = 2,
  NOT_FOUND = 3
}

/// Registry `query_terminal` (codes 1..=2).
enum QueryTerminal : ubyte {
  NONE = 0,
  COMPLETE = 1,
  TRUNCATED = 2
}

/// Registry `cancel_outcome` (codes 1..=3).
enum CancelOutcome : ubyte {
  NONE = 0,
  CANCELLED = 1,
  ALREADY_COMPLETE = 2,
  UNKNOWN_QUERY = 3
}

/// Registry `change_kind` (codes 1..=2).
enum ChangeKind : ubyte {
  NONE = 0,
  PUT = 1,
  DELETE = 2
}

/// Registry `mutation_reason` (codes 1..=3).
enum MutationReason : ubyte {
  NONE = 0,
  SCOPE_REFUSED = 1,
  INVALID_BODY = 2,
  SEQUENCE_OUT_OF_ORDER = 3
}

/// Registry `health_state` (codes 1..=4).
enum HealthState : ubyte {
  NONE = 0,
  STARTING = 1,
  SERVING = 2,
  DRAINING = 3,
  STOPPED = 4
}

/// Registry `shutdown_reason` (codes 1..=2).
enum ShutdownReason : ubyte {
  NONE = 0,
  OPERATOR = 1,
  SUPERVISOR = 2
}

/// Registry `subscription_close_reason` (codes 1..=2).
enum SubscriptionCloseReason : ubyte {
  NONE = 0,
  REPLACED = 1,
  SHUTTING_DOWN = 2
}

/// Registry `binding_kind` (code 1 today; additive bindings append).
enum BindingKind : ubyte {
  NONE = 0,
  LOCAL_UDS = 1
}

/// Registry `conflict_outcome_kind` (codes 1..=3).
enum ConflictOutcomeKind : ubyte {
  NONE = 0,
  WINNER = 1,
  DEPOSED_OWNER_RETAINED = 2,
  UNTRUSTED_CLOCK = 3
}

/// Registry `denial_seam` (codes 1..=2).
enum DenialSeam : ubyte {
  NONE = 0,
  SERVE_REQUEST = 1,
  APPLY_DELIVERY = 2
}

/// Registry `replication_status` (codes 1..=7).
enum ReplicationStatus : ubyte {
  NONE = 0,
  ASSIGNED = 1,
  ACTIVE = 2,
  RESPONSIVE = 3,
  STALE = 4,
  UNAVAILABLE = 5,
  DEGRADED = 6,
  UNKNOWN = 7
}

/// Registry `violation_kind` (codes 1..=6).
enum ViolationKind : ubyte {
  NONE = 0,
  DOCUMENT_NOT_OBJECT = 1,
  MISSING_REQUIRED_FIELD = 2,
  TYPE_MISMATCH = 3,
  VALUE_NOT_ALLOWED = 4,
  NUMBER_OUT_OF_RANGE = 5,
  LENGTH_OUT_OF_RANGE = 6
}

/// Registry `coercion` (codes 1..=4).
enum Coercion : ubyte {
  NONE = 0,
  INTEGER_TO_TEXT = 1,
  TEXT_TO_INTEGER = 2,
  INTEGER_TO_NUMBER = 3,
  NUMBER_TO_INTEGER = 4
}

/// Registry `transform_rejection` (codes 1..=2).
enum TransformRejection : ubyte {
  NONE = 0,
  VALUE_NOT_COERCIBLE = 1,
  TARGET_FIELD_OCCUPIED = 2
}

/// Registry `rollback_limit_kind` (codes 1..=2).
enum RollbackLimitKind : ubyte {
  NONE = 0,
  REVERSIBLE = 1,
  NOT_REVERSIBLE = 2
}

/// Registry `migration_state_kind`; the registry's `none` variant keeps
/// code 1 as `NO_MIGRATION`.
enum MigrationStateKind : ubyte {
  NONE = 0,
  NO_MIGRATION = 1,
  IN_PROGRESS = 2,
  ROLLING_BACK = 3,
  COMPLETE = 4
}

/// Registry `plan_problem_kind` (codes 1..=2).
enum PlanProblemKind : ubyte {
  NONE = 0,
  TRANSFORM_REJECTED = 1,
  TARGET_VIOLATIONS = 2
}

/// Registry `field_transform` (codes 1..=4).
enum FieldTransform : ubyte {
  NONE = 0,
  ADD_FIELD = 1,
  REMOVE_FIELD = 2,
  RENAME_FIELD = 3,
  RETYPE_FIELD = 4
}

// ---------------------------------------------------------------------------
// Fixed-width value types
// ---------------------------------------------------------------------------

/// A TerraBase ULID in the fixed 16-byte binary representation of
/// ADR 0027. Private and public binary protocols carry exactly 16 bytes.
struct Ulid {
  bytes: [ubyte:16];
}

/// Registry `clock_stamp`: an HLC tick/counter pair inside a conflict
/// record.
struct ClockStamp {
  ticks: ulong;
  counter: ulong;
}

/// Registry `transform_counts`: all-scalar, so a fixed inline struct.
struct TransformCounts {
  added: ulong;
  removed: ulong;
  renamed: ulong;
  retyped: ulong;
}

// ---------------------------------------------------------------------------
// The recursive JSON-family value (registry `value_type`, tags 0..=6)
// ---------------------------------------------------------------------------

/// Registry `value`: a tagged union. Arrays and objects wrap their
/// elements in `ValueCell`/`ValueEntry` tables because FlatBuffers
/// vectors of unions are not portable across the pinned language set.
union TbepValue {
  ValueNull,
  ValueBoolean,
  ValueInteger,
  ValueNumber,
  ValueString,
  ValueArray,
  ValueObject
}

/// Registry `value` variant `null` (tag 0).
table ValueNull {}

/// Registry `value` variant `boolean` (tag 1).
table ValueBoolean {
  value: bool (id: 0);
}

/// Registry `value` variant `integer` (tag 2).
table ValueInteger {
  value: long (id: 0);
}

/// Registry `value` variant `number` (tag 3).
table ValueNumber {
  value: double (id: 0);
}

/// Registry `value` variant `string` (tag 4); bounded by the frame's
/// budget class in the semantic validator.
table ValueString {
  value: string (id: 0);
}

/// Registry `value` variant `array` (tag 5).
table ValueArray {
  items: [ValueCell] (id: 0);
}

/// One array element: a wrapper table carrying the element union.
table ValueCell {
  value: TbepValue (id: 1);
}

/// Registry `value` variant `object` (tag 6).
table ValueObject {
  entries: [ValueEntry] (id: 0);
}

/// One object member: bounded key plus the member union.
table ValueEntry {
  key: string (id: 0);
  value: TbepValue (id: 2);
}

// ---------------------------------------------------------------------------
// Tagged payload unions (registry tagged enums with payload fields)
// ---------------------------------------------------------------------------

/// Registry `expected_version` (codes 1..=3): absent, any, or exact.
union ExpectedVersion {
  ExpectedVersionAbsent,
  ExpectedVersionAny,
  ExpectedVersionExact
}

/// Registry `expected_version` variant `absent` (code 1).
table ExpectedVersionAbsent {}

/// Registry `expected_version` variant `any` (code 2).
table ExpectedVersionAny {}

/// Registry `expected_version` variant `exact` (code 3).
table ExpectedVersionExact {
  version: ulong (id: 0);
}

/// Registry `write_outcome` (codes 1..=3).
union WriteOutcome {
  WriteCommitted,
  WriteConflict,
  WriteRejected
}

/// Registry `write_outcome` variant `committed` (code 1).
table WriteCommitted {
  receipt: CommitReceipt (id: 0);
}

/// Registry `write_outcome` variant `conflict` (code 2).
table WriteConflict {}

/// Registry `write_outcome` variant `rejected` (code 3).
table WriteRejected {
  reason: WriteReason (id: 0);
}

/// Registry `subscription_start` (codes 1..=2).
union SubscriptionStart {
  SubscriptionStartLive,
  SubscriptionStartSequence
}

/// Registry `subscription_start` variant `live` (code 1).
table SubscriptionStartLive {}

/// Registry `subscription_start` variant `sequence` (code 2).
table SubscriptionStartSequence {
  storage_sequence: ulong (id: 0);
}

/// Registry `mutation_outcome` (codes 1..=2).
union MutationOutcome {
  MutationApplied,
  MutationRejected
}

/// Registry `mutation_outcome` variant `applied` (code 1).
table MutationApplied {
  receipt: CommitReceipt (id: 0);
}

/// Registry `mutation_outcome` variant `rejected` (code 2).
table MutationRejected {
  reason: MutationReason (id: 0);
}

/// Registry `sync_change` (codes 1..=2).
union SyncChange {
  SyncChangePut,
  SyncChangeDelete
}

/// Registry `sync_change` variant `put` (code 1).
table SyncChangePut {
  fields: [SyncField] (id: 0);
}

/// Registry `sync_change` variant `delete` (code 2).
table SyncChangeDelete {}

/// Registry `transform_literal` (codes 1..=3).
union TransformLiteral {
  LiteralBoolean,
  LiteralInteger,
  LiteralText
}

/// Registry `transform_literal` variant `boolean` (code 1).
table LiteralBoolean {
  value: bool (id: 0);
}

/// Registry `transform_literal` variant `integer` (code 2).
table LiteralInteger {
  value: long (id: 0);
}

/// Registry `transform_literal` variant `text` (code 3).
table LiteralText {
  value: string (id: 0);
}

// ---------------------------------------------------------------------------
// Shared payload tables (registry `types`)
// ---------------------------------------------------------------------------

/// Registry `document_body`.
table DocumentBody {
  id: string (id: 0);
  collection: string (id: 1);
  version: ulong (id: 2);
  body: TbepValue (id: 4);
}

/// Registry `document_put`.
table DocumentPut {
  id: string (id: 0);
  collection: string (id: 1);
  body: TbepValue (id: 3);
}

/// Registry `batch_write`.
table BatchWrite {
  document: DocumentPut (id: 0);
  expected: ExpectedVersion (id: 2);
  operation_id: string (id: 3);
}

/// Registry `commit_receipt`.
table CommitReceipt {
  sequence: ulong (id: 0);
  version: ulong (id: 1);
  operation_id: string (id: 2);
  acknowledgement: Acknowledgement (id: 3);
  backup: BackupOutcome (id: 4);
}

/// Registry `tier_move_reason`.
table TierMoveReason {
  fact: string (id: 0);
  observed: string (id: 1);
}

/// Registry `tier_move_receipt`.
table TierMoveReceipt {
  policy_id: string (id: 0);
  policy_version: uint (id: 1);
  decision: TierDecision (id: 2);
  reasons: [TierMoveReason] (id: 3);
  segment_id: ulong (id: 4);
  bytes: ulong (id: 5);
  manifest_before: ulong (id: 6);
  manifest_after: ulong (id: 7);
  dry_run: bool (id: 8);
  manifest_accepted: bool (id: 9);
}

/// Registry `change_event`.
table ChangeEvent {
  sequence: ulong (id: 0);
  operation_id: string (id: 1);
  kind: ChangeKind (id: 2);
  collection: string (id: 3);
  document: string (id: 4);
}

/// Registry `sync_field`.
table SyncField {
  name: string (id: 0);
  value: TbepValue (id: 2);
}

/// Registry `conflict_outcome`.
table ConflictOutcome {
  kind: ConflictOutcomeKind (id: 0);
  member: string (id: 1);
}

/// Registry `conflict_record`.
table ConflictRecord {
  tenant: string (id: 0);
  operations: [string] (id: 1);
  members: [string] (id: 2);
  clocks: [ClockStamp] (id: 3);
  outcome: ConflictOutcome (id: 4);
}

/// Registry `fenced_record`.
table FencedRecord {
  range: string (id: 0);
  batch_epoch: ulong (id: 1);
  highest_epoch: ulong (id: 2);
  source: string (id: 3);
}

/// Registry `deposition_record`.
table DepositionRecord {
  range: string (id: 0);
  held_epoch: ulong (id: 1);
  owner_epoch: ulong (id: 2);
  new_owner: string (id: 3);
}

/// Registry `denial_record`.
table DenialRecord {
  seam: DenialSeam (id: 0);
  scope_tenant: string (id: 1);
  attempted_tenant: string (id: 2);
  counterparty: string (id: 3);
}

/// Registry `schema_violation`.
table SchemaViolation {
  field: string (id: 0);
  kind: ViolationKind (id: 1);
}

/// Registry `plan_problem`.
table PlanProblem {
  document: string (id: 0);
  field: string (id: 1);
  kind: PlanProblemKind (id: 2);
  rejection: TransformRejection (id: 3);
  violations: [SchemaViolation] (id: 4);
}

/// Registry `migration_state`.
table MigrationState {
  kind: MigrationStateKind (id: 0);
  manifest: string (id: 1);
  from_version: ulong (id: 2);
  to_version: ulong (id: 3);
  documents: ulong (id: 4);
  transformed: ulong (id: 5);
  pages: ulong (id: 6);
}

/// Registry `migration_plan`.
table MigrationPlan {
  manifest: string (id: 0);
  collection: string (id: 1);
  from_version: ulong (id: 2);
  to_version: ulong (id: 3);
  ready: bool (id: 4);
  documents: ulong (id: 5);
  source_digest: string (id: 6);
  result_digest: string (id: 7);
  transform_counts: TransformCounts (id: 8);
  problems: [PlanProblem] (id: 9);
  problems_truncated: bool (id: 10);
}

/// Registry `migration_receipt`.
table MigrationReceipt {
  collection: string (id: 0);
  manifest: string (id: 1);
  from_version: ulong (id: 2);
  to_version: ulong (id: 3);
  source_digest: string (id: 4);
  result_digest: string (id: 5);
  documents: ulong (id: 6);
  transformed: ulong (id: 7);
  transform_counts: TransformCounts (id: 8);
  pages: ulong (id: 9);
  rollback_limit: RollbackLimitKind (id: 10);
  acknowledged_not_rollbackable: bool (id: 11);
  already_applied: bool (id: 12);
}

/// Registry `field_transform_step`.
table FieldTransformStep {
  kind: FieldTransform (id: 0);
  field: string (id: 1);
  to: string (id: 2);
  default: TransformLiteral (id: 4);
  coercion: Coercion (id: 5);
}

/// Registry `schema_migration_contract`.
table SchemaMigrationContract {
  collection: string (id: 0);
  from_version: ulong (id: 1);
  to_version: ulong (id: 2);
  target: TbepValue (id: 4);
  transforms: [FieldTransformStep] (id: 5);
}

// ---------------------------------------------------------------------------
// Channel frames (registry `channel_frames`)
// ---------------------------------------------------------------------------

table ErrorFrame {
  code: ErrorCode (id: 0);
  detail: string (id: 1);  // bounded: 256 bytes (registry max_detail_bytes)
}

/// Registry `channel_frames` row `negotiation_request` (code 2,
/// client-to-server).
table NegotiationRequestFrame {
  supported_versions: [ushort] (id: 0);
  capabilities: [string] (id: 1);
}

/// Registry `channel_frames` row `negotiation_response` (code 3,
/// server-to-client).
table NegotiationResponseFrame {
  selected_version: ushort (id: 0);
  accepted_capabilities: [string] (id: 1);
}

// ---------------------------------------------------------------------------
// Operation request/response/notification bodies (registry `operations`,
// `notifications`)
// ---------------------------------------------------------------------------

table ChannelBindRequest {
  principal: string (id: 0);  // bounded: 128
  tenant: string (id: 1);     // bounded: 64
}

/// Registry operation `channel.bind` (response code 576).
table ChannelBindResponse {
  tenant: string (id: 0);         // bounded: 64
  serving_instance: ulong (id: 1);
}

/// Registry operation `supervision.health` (request code 321).
table SupervisionHealthRequest {}

/// Registry operation `supervision.health` (response code 577).
table SupervisionHealthResponse {
  state: HealthState (id: 0);
  sessions: uint (id: 1);
  subscriptions: uint (id: 2);
  frames_served: ulong (id: 3);
}

/// Registry operation `supervision.shutdown` (request code 322).
table SupervisionShutdownRequest {
  reason: ShutdownReason (id: 0);
}

/// Registry operation `supervision.shutdown` (response code 578).
table SupervisionShutdownResponse {
  state: HealthState (id: 0);
  in_flight: uint (id: 1);
}

// ---------------------------------------------------------------------------
// Documents (registry family `documents`)
// ---------------------------------------------------------------------------

/// Registry operation `document.read` (request code 257).
table DocumentReadRequest {
  collection: string (id: 0);  // bounded: 64
  document: string (id: 1);    // bounded: 64
  level: ReadLevel (id: 2);
}

/// Registry operation `document.read` (response code 513).
table DocumentReadResponse {
  found: bool (id: 0);
  document: DocumentBody (id: 1);
  position: ulong (id: 2);
}

/// Registry operation `document.write` (request code 258).
table DocumentWriteRequest {
  document: DocumentPut (id: 0);
  expected: ExpectedVersion (id: 2);
  operation_id: string (id: 3);  // bounded: 128
  ack: Acknowledgement (id: 4);
}

/// Registry operation `document.write` (response code 514).
table DocumentWriteResponse {
  outcome: WriteOutcome (id: 1);
}

/// Registry operation `document.delete` (request code 259).
table DocumentDeleteRequest {
  collection: string (id: 0);         // bounded: 64
  document: string (id: 1);           // bounded: 64
  expected: ExpectedVersion (id: 3);
  operation_id: string (id: 4);       // bounded: 128
  ack: Acknowledgement (id: 5);
}

/// Registry operation `document.delete` (response code 515).
table DocumentDeleteResponse {
  outcome: WriteOutcome (id: 1);
}

/// Registry operation `document.batch` (request code 264).
table DocumentBatchRequest {
  items: [BatchWrite] (id: 0);
  ack: Acknowledgement (id: 1);
}

/// Registry operation `document.batch` (response code 605).
table DocumentBatchResponse {
  outcome: WriteOutcome (id: 1);
}

// ---------------------------------------------------------------------------
// Query (registry family `query`)
// ---------------------------------------------------------------------------

/// Registry operation `query.execute` (request code 260).
table QueryExecuteRequest {
  query_id: ulong (id: 0);
  text: string (id: 1);   // bounded: 16384
  max_items: uint (id: 2);
  level: ReadLevel (id: 3);
}

/// Registry operation `query.execute` (response code 516).
table QueryExecuteResponse {
  documents: [DocumentBody] (id: 0);
  count: uint (id: 1);
  terminal: QueryTerminal (id: 2);
  position: ulong (id: 3);
}

/// Registry operation `query.cancel` (request code 261).
table QueryCancelRequest {
  query_id: ulong (id: 0);
}

/// Registry operation `query.cancel` (response code 517).
table QueryCancelResponse {
  outcome: CancelOutcome (id: 0);
}

// ---------------------------------------------------------------------------
// Typed families (registry family `families`)
// ---------------------------------------------------------------------------

/// Registry operation `family.read` (request code 262); `family` is one of
/// the registry `family_kinds`, `request` is canonical native bytes under
/// the named `request_codec`.
table FamilyReadRequest {
  family: string (id: 0);          // bounded: 64, one of family_kinds
  name: string (id: 1);            // bounded: 128
  request_codec: string (id: 2);   // bounded: 64
  request: [ubyte] (id: 3);        // bounded by the operation class budget
}

/// Registry operation `family.read` (response code 518).
table FamilyReadResponse {
  response_codec: string (id: 0);  // bounded: 64
  response: [ubyte] (id: 1);
}

/// Registry operation `family.write` (request code 263).
table FamilyWriteRequest {
  family: string (id: 0);          // bounded: 64, one of family_kinds
  name: string (id: 1);            // bounded: 128
  request_codec: string (id: 2);   // bounded: 64
  request: [ubyte] (id: 3);
  operation_id: string (id: 4);    // bounded: 128
}

/// Registry operation `family.write` (response code 519).
table FamilyWriteResponse {
  response_codec: string (id: 0);  // bounded: 64
  response: [ubyte] (id: 1);
}

// ---------------------------------------------------------------------------
// Backbone subscriptions (registry family `backbone`)
// ---------------------------------------------------------------------------

/// Registry operation `backbone.subscribe` (request code 272).
table BackboneSubscribeRequest {
  subscription_id: ulong (id: 0);
  collections: [string] (id: 1);
  from: SubscriptionStart (id: 3);
}

/// Registry operation `backbone.subscribe` (response code 528).
table BackboneSubscribeResponse {
  subscription_id: ulong (id: 0);
  start_sequence: ulong (id: 1);
}

/// Registry operation `backbone.acknowledge` (request code 273).
table BackboneAcknowledgeRequest {
  subscription_id: ulong (id: 0);
  through_sequence: ulong (id: 1);
}

/// Registry operation `backbone.acknowledge` (response code 529).
table BackboneAcknowledgeResponse {
  subscription_id: ulong (id: 0);
  acknowledged_through: ulong (id: 1);
}

/// Registry operation `backbone.unsubscribe` (request code 274).
table BackboneUnsubscribeRequest {
  subscription_id: ulong (id: 0);
}

/// Registry operation `backbone.unsubscribe` (response code 530).
table BackboneUnsubscribeResponse {
  subscription_id: ulong (id: 0);
}

/// Registry notification `subscription_batch` (code 769, subscription
/// class).
table SubscriptionBatchFrame {
  subscription_id: ulong (id: 0);
  from_sequence: ulong (id: 1);
  events: [ChangeEvent] (id: 2);
  next_sequence: ulong (id: 3);
}

/// Registry notification `trigger_notification` (code 770, trigger
/// class): content-free by contract.
table TriggerNotificationFrame {
  subscription_id: ulong (id: 0);
  collection: string (id: 1);    // bounded: 64
  sequence: ulong (id: 2);
  operation_id: string (id: 3);  // bounded: 128
}

/// Registry notification `subscription_closed` (code 771, control
/// class).
table SubscriptionClosedFrame {
  subscription_id: ulong (id: 0);
  reason: SubscriptionCloseReason (id: 1);
}

// ---------------------------------------------------------------------------
// Sync delivery (registry family `sync`, delivery class)
// ---------------------------------------------------------------------------

/// Registry operation `sync.session_setup` (request code 288); `resume`
/// is an opaque checkpoint under codec `terrabase.sync-core/checkpoint@1`.
table SyncSessionSetupRequest {
