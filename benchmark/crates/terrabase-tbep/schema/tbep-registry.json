  "envelope": {
    "shape": "[version u8, kind u16, correlation u64, causation u64, idempotency str?, digest u64, body bin]; fixed_cost_bytes is the worst-case envelope cost bound (maximal-width integers, bin8 body header); small integers ride as msgpack fixints so actual frames sit below it",
    "digest": "fnv1a-64 over the encoded body bytes",
    "idempotency_encoding": "nil when absent, a bounded utf-8 string when present; nil anywhere else in any frame fails closed on both sides",
    "fixed_cost_bytes": 35,
    "stream_prefix": "u32 little-endian length of the encoded envelope"
  },
  "payload_codecs": [
    "loro-delta/1",
    "loro-snapshot/1",
