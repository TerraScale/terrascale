<Project Sdk="Microsoft.NET.Sdk">

  <!-- TerraBase.Protocol.Tests — the C# half of the TBEP conformance -->
  <!-- suite (SE-14, PD-2026-08-26-02 D4): the same golden-vector       -->
  <!-- corpus the Rust runner replays (crates/terrabase-tbep/vectors/)  -->
  <!-- drives this suite, so both languages must agree on every byte.   -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>preview</LangVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.56.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TerraBase/TerraBase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The committed cross-language corpus, copied beside the test
         binary so this suite and the Rust runner read the same bytes. -->
    <None
      Include="..\..\crates\terrabase-tbep\vectors\tbep\**\*.json"
      CopyToOutputDirectory="PreserveNewest"
      Link="vectors\tbep\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
