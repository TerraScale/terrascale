<Project Sdk="Microsoft.NET.Sdk">

  <!-- TerraBase.Protocol.Tests — the C# half of the TBEP conformance -->
  <!-- suite (SE-14, PD-2026-08-26-02 D4). The exact engine-published    -->
  <!-- corpus is vendored under this test project with a copy manifest;  -->
  <!-- the project does not depend on an untracked Rust checkout.         -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>preview</LangVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.56.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TerraBase/TerraBase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tracked cross-language corpus and its integrity manifest are
         copied beside the test binary. -->
    <None Update="vectors\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
