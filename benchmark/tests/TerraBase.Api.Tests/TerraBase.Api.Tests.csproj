<Project Sdk="Microsoft.NET.Sdk">

  <!-- TerraBase.Api.Tests — the SE-08 host test family: the local     -->
  <!-- gate and tenant-isolation suites, the SSE/WebSocket parity and   -->
  <!-- resume rows, the engine-communication probes (red-then-green),  -->
  <!-- supervision against a real engine process loss, the audit       -->
  <!-- discipline, and the SE-04 golden sync vectors driven end to     -->
  <!-- end through the host to the real Rust engine over UDS.           -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>preview</LangVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.56.18" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TerraBase/TerraBase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tracked SE-04 golden vectors and their integrity manifest are
         copied beside the test binary. The live-engine rows still require
         the separately provisioned Rust engine. -->
    <None Update="vectors\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
