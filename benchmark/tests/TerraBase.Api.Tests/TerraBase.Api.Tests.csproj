<Project Sdk="Microsoft.NET.Sdk">

  <!-- TerraBase.Api.Tests — the SE-08 host test family: the local     -->
  <!-- gate and tenant-isolation suites, the SSE/WebSocket parity and   -->
  <!-- resume rows, the engine-communication probes (red-then-green),  -->
  <!-- supervision against a real engine process loss, the audit       -->
  <!-- discipline, and the SE-04 golden sync vectors driven end to     -->
  <!-- end through the host to the real Rust engine over UDS.           -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>preview</LangVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.56.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TerraBase/TerraBase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SE-04 golden vectors (the sync-engine compatibility
         guarantee) are consumed from the committed corpus beside the
         test binary, exactly as the Protocol suite copies the TBEP
         corpus: the host replays them end to end through its sync
         sessions to the engine and back. -->
    <None
      Include="..\..\crates\terrabase-sync-core\vectors\terrascale.sync.v2\*.json"
      CopyToOutputDirectory="PreserveNewest"
      Link="vectors\terrascale.sync.v2\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
