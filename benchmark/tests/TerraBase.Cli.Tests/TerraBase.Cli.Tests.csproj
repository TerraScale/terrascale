<Project Sdk="Microsoft.NET.Sdk">

  <!-- TerraBase.Cli.Tests — the SE-13 operator-CLI test family: the     -->
  <!-- grammar/configuration and machine-output contract rows (no        -->
  <!-- engine), the live API host fixture rows (the SE-08 harness        -->
  <!-- pattern: the real Rust engine process spawned over UDS under the  -->
  <!-- real ASP.NET host), the "changes follow" tail with checkpoint     -->
  <!-- resume through a dropped connection, and the direct-TBEP mode     -->
  <!-- rows against a local engine process through the SE-14 client.     -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>preview</LangVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.56.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerraBase.Cli\TerraBase.Cli.csproj" />
    <!-- The live-host fixture boots the real host in process
         (TerraBaseHost.Create + EngineOptions): the same served surface
         the production entry point runs. -->
    <ProjectReference Include="..\..\host\TerraBase.Api\TerraBase.Api.csproj" />
    <!-- The SM-04 schema rows reuse the host test family's scripted TBEP
         engine (the scripted engine is a fixture, not production code), so
         the CLI drives the real host over the same scripted wire answers
         the host's own rows drive. -->
    <ProjectReference Include="..\..\host\TerraBase.Api.Tests\TerraBase.Api.Tests.csproj" />
  </ItemGroup>

</Project>
