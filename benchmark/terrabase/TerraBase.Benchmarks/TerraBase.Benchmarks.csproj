<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TerraBase.Benchmarks</RootNamespace>
    <AssemblyName>TerraBase.Benchmarks</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TerraBase/TerraBase.csproj" />
  </ItemGroup>

  <!-- The ts-dotnet SDK engine lane references the sibling TerraScale.DotNet
       project directly, so CI environments without the workspace layout still
       build (the reference and the lane compile only when the project exists). -->
  <PropertyGroup>
    <TerraScaleSdkProject>../../../ts-dotnet/src/TerraScale.DotNet/TerraScale.DotNet.csproj</TerraScaleSdkProject>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(TerraScaleSdkProject)')">
    <DefineConstants>$(DefineConstants);TERRASCALE_SDK</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(TerraScaleSdkProject)')">
    <ProjectReference Include="$(TerraScaleSdkProject)" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="LiteDB" />
    <PackageReference Include="Turso.Data.Sqlite.Provider" />
  </ItemGroup>
</Project>
