{
	admin off
	auto_https off
	persist_config off
	skip_install_trust
}

(edge) {
	tls {$E2E_EDGE_CERT} {$E2E_EDGE_KEY}
}

https://dash.terrascale.tech, https://mcp.terrascale.tech, https://platform.terrascale.tech {
	import edge
	reverse_proxy 127.0.0.1:8085 {
		flush_interval -1
	}
}

https://auth.terrascale.tech {
	import edge
	@organizationCreate {
		method POST
		path /v1/terrascale/organizations
	}
	reverse_proxy @organizationCreate 127.0.0.1:8027
	reverse_proxy 127.0.0.1:8090 {
		flush_interval -1
	}
}

