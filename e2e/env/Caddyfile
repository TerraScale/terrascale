{
	admin off
	auto_https off
	persist_config off
	skip_install_trust
}

(edge) {
	tls {$E2E_EDGE_CERT} {$E2E_EDGE_KEY}
}

https://dash.terrascale.tech, https://mcp.terrascale.tech, https://platform.terrascale.tech {
	import edge
	reverse_proxy 127.0.0.1:{$E2E_PORT_dashboard} {
		flush_interval -1
	}
}

https://auth.terrascale.tech {
	import edge
	@organizationCreate {
		method POST
		path /v1/terrascale/organizations
	}
	reverse_proxy @organizationCreate 127.0.0.1:{$E2E_PORT_stripe} {
		header_up X-Forwarded-For {remote_host}
	}
	reverse_proxy 127.0.0.1:{$E2E_PORT_auth} {
		header_up X-Forwarded-For {remote_host}
		flush_interval -1
	}
}

