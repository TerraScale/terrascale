{
  "name": "ts-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "tsc --noEmit",
    "lint": "vp lint && vp fmt --check",
    "db:bootstrap:local": "wrangler d1 execute ts-atlas --local --file schema.sql",
    "db:bootstrap:remote": "wrangler d1 execute ts-atlas --remote --file schema.sql",
    "audit:dependencies": "npm audit --ignore-scripts --audit-level=high",
    "prebuild": "npm run audit:dependencies"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261026.1",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "@cloudflare/vite-plugin": {
      "vite": {
        ".": "8.3.3",
        "rolldown": "1.2.11"
      }
    },
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@12.0.2"
}
