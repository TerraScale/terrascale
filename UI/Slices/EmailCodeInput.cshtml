@inherits RazorSlice<string>
<div class="ts-field">
    <label class="ts-sr-only" for="code">Six-digit code</label>
    <div class="ts-email-code" data-signals="{_codeCaret: 0, _codeEnd: 0}">
        <input class="ts-input ts-input-lg ts-email-code-input" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="64" pattern="[0-9]{6}" required autofocus spellcheck="false"
               data-bind="_emailCode" data-init="@(EmailCodeBehaviors.CodeInput + "; el.parentElement.classList.add('ts-email-code-ready')")"
               data-on:beforeinput="@EmailCodeBehaviors.CodeBeforeInput" data-on:input="@EmailCodeBehaviors.CodeInput"
               data-on:select="$_codeCaret = el.selectionStart; $_codeEnd = el.selectionEnd" data-on:keyup="$_codeCaret = el.selectionStart; $_codeEnd = el.selectionEnd"
               data-on:focus="$_codeCaret = el.selectionStart; $_codeEnd = el.selectionEnd"
               data-on:pointerdown="@EmailCodeBehaviors.CodePointerDown" data-on:pointermove="@EmailCodeBehaviors.CodePointerMove"
               data-on:pointerup="@EmailCodeBehaviors.CodePointerUp" data-on:pointercancel="@EmailCodeBehaviors.CodePointerUp"
               data-on:lostpointercapture="el._codePointer = null" data-on:dblclick="el.select()" data-on:paste="@EmailCodeBehaviors.CodePaste"
               aria-invalid="@(Model.Length != 0 ? "true" : null)" aria-describedby="@(Model.Length != 0 ? "code-error" : null)" />
        <div class="ts-email-code-slots" aria-hidden="true">
            @for (var index = 0; index < 6; index++)
            {
                <span class="ts-email-code-slot" data-text="@($"$_emailCode[{index}] || ''")"
                      data-class:ts-email-code-active="@($"Math.min($_codeCaret, 5) === {index}")"
                      data-class:ts-email-code-selected="@($"$_codeCaret <= {index} && $_codeEnd > {index}")"></span>
            }
        </div>
    </div>
    @if (Model.Length != 0) { <p class="ts-field-error" id="code-error">@Model</p> }
</div>
