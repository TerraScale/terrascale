@inherits RazorSlice<PasswordField>
@{
    var reveal = "$_" + Model.Id + "Reveal";
    var filled = "$_" + Model.Id + "Filled";
}
<div class="ts-input-group" data-signals="@("{_" + Model.Id + "Reveal: false, _" + Model.Id + "Filled: false}")">
    <input class="ts-input" type="password" id="@Model.Id" name="@Model.Id" autocomplete="@Model.Autocomplete" placeholder="@(Model.Placeholder.Length != 0 ? Model.Placeholder : null)" minlength="@(Model.MinLength != 0 ? Model.MinLength.ToString() : null)" required
           aria-invalid="@(Model.Error.Length != 0 ? "true" : null)" aria-describedby="@Model.DescribedBy" autofocus="@(Model.Autofocus || Model.Error.Length != 0 ? "autofocus" : null)"
           data-attr:type="@(reveal + " ? 'text' : 'password'")" data-on:input="@(filled + " = el.value !== ''; " + filled + " || (" + reveal + " = false)")" />
    <button class="ts-input-adornment" type="button" data-password-toggle aria-controls="@Model.Id" aria-pressed="false" aria-label="Show password" hidden
            data-attr:hidden="@("!" + filled)" data-attr:aria-pressed="@("String(" + reveal + ")")"
            data-attr:aria-label="@(reveal + " ? 'Hide password' : 'Show password'")" data-on:click="@(reveal + " = !" + reveal)">
        @Icons.Render("Eye")
    </button>
</div>
