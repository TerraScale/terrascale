@inherits RazorSlice<DocumentModel>
@implements IUsesLayout<TerraScale.Dashboard.UI.Slices.Document, DocumentModel>
<main class="ts-auth">
    <section class="ts-auth-card">
        <div class="ts-auth-heading">
            <h1 class="ts-auth-title">Temporarily unavailable</h1>
            <p class="ts-auth-subtitle">We couldn't reach the service. Please try again shortly.</p>
        </div>
        <a class="ts-btn ts-btn-primary" href="/">Try again</a>
    </section>
</main>
@functions {
    public DocumentModel LayoutModel => Model;
}
