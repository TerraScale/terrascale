<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>TerraScale.Dashboard</RootNamespace>
    <AssemblyName>TerraScale.Dashboard</AssemblyName>
    <WebRoot>web/static</WebRoot>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);test-results/**;tests/**;scripts/**;vendor/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="RazorSlices" Version="0.12.1" />
    <PackageReference Include="Stripe.net" Version="53.0.0" />
    <PackageReference Include="TerraScale.DotNet" Version="0.1.0-dashboard.g130925898daf0207134d9582b7b672a5a1c3233b" />
    <Compile Remove="tests/**/*.cs;scripts/**/*.cs;vendor/**/*.cs" />
    <None Update="**/*" Watch="false" />
    <Content Include="web/static/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="web/static/**/*" Watch="false" />
    <Watch Include="web/assets/**/*" />
  </ItemGroup>
  <Target Name="BundleDashboardAssets" BeforeTargets="PrepareForBuild">
    <Exec Command="npm ci --ignore-scripts" Condition="!Exists('node_modules/lightningcss/package.json')" />
    <Exec Command="node scripts/build-css.mjs" />
    <Exec Command="node scripts/build-js.mjs" />
  </Target>
</Project>
