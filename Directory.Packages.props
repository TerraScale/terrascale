<Project>
  <!-- Central versions for every TerraScale project in this repository (libs, auth, TerraBase, benchmark).
       One version per package: the highest used by any of the three former repositories.
       Keep to the latest mutually compatible releases; lock files pin the full graph. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Banned APIs (BannedSymbols.txt) for the TerraBase area: referenced by Directory.Build.targets. -->
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" />
  </ItemGroup>
  <!-- Roslyn for src/TerraBase.Analyzers and the Endpoints generator: keep at or below the compiler in the
       pinned SDK (5.11 on 11.0.100-rc.1), or the analyzer fails to load (CS8032). -->
  <ItemGroup Label="Analyzer authoring">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0-1.26328.17" />
  </ItemGroup>
  <!-- Microsoft.Extensions track the .NET 11 SDK and shared framework; lower pins
       downgrade what ASP.NET Core 11 requires (NU1109). -->
  <ItemGroup Label="Protocol Buffers (Features/Sync page pull)">
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
  </ItemGroup>
  <!-- Dashboard-to-TerraBase RPC (src/TerraScale.TerraBase.Contracts): MagicOnion over gRPC with MessagePack. -->
  <ItemGroup Label="MagicOnion">
    <PackageVersion Include="MagicOnion.Abstractions" Version="7.11.0" />
    <PackageVersion Include="MagicOnion.Client" Version="7.11.0" />
    <PackageVersion Include="MagicOnion.Server" Version="7.11.0" />
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <!-- MagicOnion's gRPC dependencies, pinned to the Grpc.Tools release train above. -->
    <PackageVersion Include="Grpc.AspNetCore.Server" Version="2.84.0" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.84.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageVersion Include="Grpc.Net.Common" Version="2.84.0" />
  </ItemGroup>
  <ItemGroup Label="Microsoft Extensions (Core)">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Physical" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0-rc.1.26425.128" />
  </ItemGroup>
  <!-- Interpolated log calls (src/TerraBase, src/TerraScale.Logging) and allocation-light strings on hot paths:
       Cysharp, the same release train as ZLogger. -->
  <ItemGroup Label="Interpolated strings">
    <PackageVersion Include="ZLogger" Version="2.5.10" />
    <PackageVersion Include="ZString" Version="2.6.0" />
  </ItemGroup>
  <ItemGroup Label="API and hosting">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.13" />
    <PackageVersion Include="RazorSlices" Version="0.12.1" />
  </ItemGroup>
  <!-- ts-auth OIDC discovery, JWKS and JWT validation (Features/UserAuth). -->
  <ItemGroup Label="Authentication">
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="OpenIddict.Core" Version="7.7.1" />
    <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.7.1" />
    <PackageVersion Include="Geralt" Version="4.4.0" />
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <PackageVersion Include="QRCoder" Version="1.8.1" />
  </ItemGroup>
  <ItemGroup Label="Integrations">
    <PackageVersion Include="Sentry.AspNetCore" Version="6.12.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageVersion Include="Stripe.net" Version="53.0.0" />
  </ItemGroup>
  <!-- OpenTelemetry: keep every package on the same release train. The Prometheus
       exporter is only published as beta; it serves the required /metrics scrape. -->
  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.19.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
  </ItemGroup>
  <!-- Storage engine (Engine/Turso): tracks the .NET 11 train like Microsoft.Extensions. -->
  <ItemGroup Label="Storage engine">
    <!-- Last MIT release: 9.x NuGet binaries introduce commercial maintenance terms. -->
    <PackageVersion Include="JsonSchema.Net" Version="8.0.5" />
  </ItemGroup>
  <!-- S3-compatible object storage (Tigris) for continuous backups (Features/Backup). -->
  <ItemGroup Label="Object storage">
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.1" />
  </ItemGroup>
  <!-- Cron expressions for scheduled backups (Features/Management/Backups). -->
  <ItemGroup Label="Scheduling">
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="Jint" Version="4.17.0" />
  </ItemGroup>
  <ItemGroup Label="Performance primitives">
    <PackageVersion Include="NativeCompressions" Version="0.6.1" />
    <PackageVersion Include="Ulid" Version="1.4.1" />
    <PackageVersion Include="NUlid" Version="1.7.3" />
  </ItemGroup>
  <!-- Management SQL subset (Features/Management/Queries): parses read-only SELECT into engine queries. -->
  <ItemGroup Label="SQL parsing">
    <PackageVersion Include="SqlParserCS" Version="0.6.5" />
  </ItemGroup>
  <!-- Benchmarks (benchmark/dotnet): BenchmarkDotNet 0.16 is the first release with net11.0 support. -->
  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
  </ItemGroup>
  <ItemGroup Label="Integration tests">
    <PackageVersion Include="TUnit" Version="1.73.19" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <!-- A real PostgreSQL client for TerraBase's wire listener (Fast). -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- FakeTimeProvider: drives the backup scheduler's clock. Ships on the 10.x train with Resilience. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>
  <!-- Preserve the dashboard's imported Scalar dependency without changing other areas. -->
  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('TerraScale.Dashboard'))">
    <PackageVersion Update="Scalar.AspNetCore" Version="2.18.0" />
  </ItemGroup>
</Project>
