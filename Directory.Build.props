<Project>
  <!-- One rule set for every project. Each project belongs to an area by its folder; a rule that one area's code cannot
       meet stays scoped to the area that had it before (IsTerraBaseArea, IsLibsArea). -->
  <PropertyGroup>
    <ProjectFolder>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)'))</ProjectFolder>
    <IsTerraBaseArea Condition="$(ProjectFolder.StartsWith('src/TerraBase'))">true</IsTerraBaseArea>
    <IsLibsArea Condition="$(ProjectFolder.Contains('TerraScale.Endpoints')) or $(ProjectFolder.Contains('TerraScale.Logging'))">true</IsLibsArea>
    <IsDashboardArea Condition="$(ProjectFolder.StartsWith('src/TerraScale.Dashboard'))">true</IsDashboardArea>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for IDE0005 (unused usings) in the build. -->
    <GenerateDocumentationFile Condition="'$(IsTerraBaseArea)' == 'true'">true</GenerateDocumentationFile>
    <!-- XML documentation and comment-requiring diagnostics are suppressed globally because TerraScale enforces a
         no-comments rule in C# source files (GenerateDocumentationFile stays enabled where needed for IDE0005):
         - CS1591: missing XML comment on a publicly visible type or member
         - CS1573 / CS1712: missing <param> / <typeparam> tag in an XML comment
         - CS0419 / CS1574 / CS1580 / CS1581 / CS1584 / CS1723 / CA1200: XML comment cref attribute warnings
         - CS1570 / CS1587 / CS1589 / CS1590 / CS1592: malformed, misplaced, or failed <include> XML comments
         - CS1571 / CS1572 / CS1710 / CS1711 / CS1734 / CS1735: duplicate or unmatched <param>/<typeparam>/<paramref>/<typeparamref> tags
         - IDE0073: require a file header comment -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1712;CS0419;CS1570;CS1571;CS1572;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1592;CS1710;CS1711;CS1723;CS1734;CS1735;CA1200;IDE0073</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <!-- The pinned compiler retains invalid Razor generator state across shared compilations. -->
    <UseSharedCompilation>false</UseSharedCompilation>
    <Authors>TerraScale</Authors>
    <!-- Container tooling builds Linux images; the release binaries are linux-x64 and linux-arm64. -->
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- NU1507: packageSourceMapping in NuGet.config already pins each package to one source.
         NU1801: a temporarily unreachable source must not fail offline or container restores;
         locked-mode restore still fails on any missing package.
         IDE0007/IDE0008: `var` versus an explicit type is left to the author (human decision, 2026-10-04). -->
    <NoWarn>$(NoWarn);NU1507;NU1801;IDE0007;IDE0008</NoWarn>
    <!-- The releases are self-contained single-file linux-x64 and linux-arm64 executables. Declaring the
         runtimes and the single-file analyzer here makes build and publish restore the
         same graph, so one set of lock files serves both in locked mode, and single-file
         incompatibilities surface at build time. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
