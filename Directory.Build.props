<Project>
  <!-- One rule set for every project. Each project belongs to an area by its folder; a rule that one area's code cannot
       meet stays scoped to the area that had it before (IsTerraBaseArea, IsLibsArea). -->
  <PropertyGroup>
    <ProjectFolder>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)'))</ProjectFolder>
    <IsTerraBaseArea Condition="$(ProjectFolder.StartsWith('src/TerraBase')) or $(ProjectFolder.StartsWith('tests/TerraBase'))">true</IsTerraBaseArea>
    <IsLibsArea Condition="$(ProjectFolder.Contains('TerraScale.Endpoints')) or $(ProjectFolder.Contains('TerraScale.Logging'))">true</IsLibsArea>
    <IsDashboardArea Condition="$(ProjectFolder.StartsWith('src/TerraScale.Dashboard')) or $(ProjectFolder.StartsWith('tests/TerraScale.Dashboard'))">true</IsDashboardArea>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- TerraBase's discriminated unions (`union` declarations) are a preview language feature; every other area is on 14.0. -->
    <LangVersion Condition="'$(IsTerraBaseArea)' == 'true'">preview</LangVersion>
    <LangVersion Condition="'$(IsTerraBaseArea)' != 'true'">14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- ts-libs keeps style out of the build: its public signatures carry unused parameters that are API. -->
    <EnforceCodeStyleInBuild Condition="'$(IsLibsArea)' != 'true'">true</EnforceCodeStyleInBuild>
    <!-- Required for IDE0005 (unused usings) in the build; TerraBase's public APIs carry XML docs. -->
    <GenerateDocumentationFile Condition="'$(IsTerraBaseArea)' == 'true' or '$(IsDashboardArea)' == 'true'">true</GenerateDocumentationFile>
    <!-- CS1591: TerraBase is a server, not a library, and its code carries no comments (user rule 2026-10-29: "do not
         comment the code"). The documentation file stays generated because IDE0005 needs it in the build. -->
    <NoWarn Condition="'$(IsTerraBaseArea)' == 'true' or '$(IsDashboardArea)' == 'true'">$(NoWarn);CS1591</NoWarn>
    <!-- ts-libs tests use real cultures (fr-FR), so the invariant mode stays with TerraBase and ts-auth. -->
    <InvariantGlobalization Condition="'$(IsLibsArea)' != 'true'">true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <UseSharedCompilation>false</UseSharedCompilation>
    <Authors>TerraScale</Authors>
    <!-- Container tooling builds Linux images; the release binaries are linux-x64 and linux-arm64. -->
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- NU1507: packageSourceMapping in NuGet.config already pins each package to one source.
         NU1801: a temporarily unreachable source must not fail offline or container restores;
         locked-mode restore still fails on any missing package.
         EXTEXP0001: experimental Microsoft.Extensions resilience APIs are accepted on .NET 11 previews.
         IDE0007/IDE0008: `var` versus an explicit type is left to the author (human decision, 2026-10-04). -->
    <NoWarn>$(NoWarn);NU1507;NU1801;EXTEXP0001;IDE0007;IDE0008</NoWarn>
    <!-- The releases are self-contained single-file linux-x64 and linux-arm64 executables. Declaring the
         runtimes and the single-file analyzer here makes build and publish restore the
         same graph, so one set of lock files serves both in locked mode, and single-file
         incompatibilities surface at build time. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- Reproducible restores: lock files are committed and CI restores in locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- ts-dotnet (the TerraScale .NET SDK) is a separate repository, consumed as source by ts-auth.
         It is checked out next to this repository; override with -p:TsDotnetRoot=<the ts-dotnet checkout>
         (or the TsDotnetRoot environment variable) when it lives elsewhere. -->
    <TsDotnetRoot Condition="'$(TsDotnetRoot)' == ''">$(MSBuildThisFileDirectory)../ts-dotnet</TsDotnetRoot>
  </PropertyGroup>

</Project>
