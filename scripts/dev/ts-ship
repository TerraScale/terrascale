#!/usr/bin/env python3
"""TS_SHIP_SUPERVISOR_WRAPPER

Run the host ts-ship outside the shell's job-control process group.

A T3/OpenCode session suspend stops the foreground pipeline group (the
`ts-ship | tail` case). SIGSTOP cannot be caught, and a stopped parent cannot
reap, so children become zombies. This process stays in that group only as a
waiter. The ship runs in a new session, ignores terminal stop signals, and is a
child subreaper so descendants whose parents have exited are waited on. If the
waiter is killed, the ship receives SIGTERM.

Install over the host binary by moving it aside first:

    mv ~/.local/bin/ts-ship ~/.local/bin/ts-ship.impl
    install scripts/dev/ts-ship ~/.local/bin/ts-ship

From a checkout, `scripts/dev/ts-ship` uses `TS_SHIP_IMPL`, a sibling
`ts-ship.impl`, or the next `ts-ship` on `PATH`.
"""

from __future__ import annotations

import ctypes
import os
import runpy
import signal
import stat
import sys

PR_SET_PDEATHSIG = 1
PR_SET_CHILD_SUBREAPER = 36
MARKER = "TS_SHIP_SUPERVISOR_WRAPPER"


def _libc():
    libc = ctypes.CDLL(None, use_errno=True)
    libc.prctl.argtypes = [ctypes.c_int, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong]
    libc.prctl.restype = ctypes.c_int
    return libc


def _prctl(option: int, arg: int) -> None:
    if _libc().prctl(option, arg, 0, 0, 0) != 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err), option)


def _is_fifo(fd: int) -> bool:
    try:
        return stat.S_ISFIFO(os.fstat(fd).st_mode)
    except OSError:
        return False


def _is_wrapper(path: str) -> bool:
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            return MARKER in handle.read(2048)
    except OSError:
        return False


def resolve_impl() -> str:
    env = os.environ.get("TS_SHIP_IMPL")
    if env:
        if not os.path.isfile(env):
            sys.stderr.write(f"ts-ship: TS_SHIP_IMPL not found: {env}\n")
            raise SystemExit(127)
        return env
    sibling = os.path.join(os.path.dirname(os.path.realpath(__file__)), "ts-ship.impl")
    if os.path.isfile(sibling) and not _is_wrapper(sibling):
        return sibling
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        if not directory:
            continue
        candidate = os.path.join(directory, "ts-ship")
        if not os.path.isfile(candidate) or _is_wrapper(candidate):
            continue
        try:
            if os.path.samefile(candidate, __file__):
                continue
        except OSError:
            continue
        return candidate
    sys.stderr.write("ts-ship: implementation not found; set TS_SHIP_IMPL or install ts-ship.impl beside this wrapper\n")
    raise SystemExit(127)


def _exit_code(status: int) -> int:
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    if os.WIFSIGNALED(status):
        return 128 + os.WTERMSIG(status)
    return 1


def _wait(pid: int, flags: int = 0) -> tuple[int, int]:
    while True:
        try:
            return os.waitpid(pid, flags)
        except InterruptedError:
            continue


def _run_impl(impl: str) -> int:
    sys.argv = [impl, *sys.argv[1:]]
    try:
        runpy.run_path(impl, run_name="__main__")
    except SystemExit as exc:
        code = exc.code
        if code is None:
            return 0
        if isinstance(code, int):
            return code & 255
        return 1
    except BaseException:
        sys.excepthook(*sys.exc_info())
        return 1
    return 0


def _ignore_terminal_stops() -> None:
    for signum in (signal.SIGTSTP, signal.SIGTTIN, signal.SIGTTOU, signal.SIGPIPE):
        signal.signal(signum, signal.SIG_IGN)


def _state_log() -> str:
    root = os.environ.get("TS_SHIP_STATE_DIR") or os.path.join(
        os.path.expanduser("~"), ".local", "state", "ts-ship"
    )
    os.makedirs(root, exist_ok=True)
    return os.path.join(root, f"detached-{os.getpid()}.log")


def _redirect_pipes(log_path: str) -> None:
    fd = os.open(log_path, os.O_CREAT | os.O_APPEND | os.O_WRONLY, 0o644)
    try:
        if _is_fifo(1):
            os.dup2(fd, 1)
        if _is_fifo(2):
            os.dup2(fd, 2)
    finally:
        os.close(fd)


def _reap_orphans(impl_pid: int) -> int:
    while True:
        pid, status = _wait(-1, 0)
        if pid != impl_pid:
            continue
        while True:
            try:
                extra, _ = _wait(-1, os.WNOHANG)
            except ChildProcessError:
                break
            if extra == 0:
                break
        return _exit_code(status)


def supervise(impl: str) -> None:
    """Wait in the caller's process group; run impl in its own session."""
    piped = _is_fifo(1) or _is_fifo(2)
    log_path = _state_log() if piped else ""
    if piped:
        notice = (
            f"ts-ship: detached from job control; log {log_path}\n"
            "ts-ship: a pipeline's exit status is the last stage, not the ship\n"
        ).encode()
        signal.signal(signal.SIGPIPE, signal.SIG_IGN)
        try:
            os.write(1 if _is_fifo(1) else 2, notice)
        except OSError:
            pass

    reaper = os.fork()
    if reaper > 0:
        for fd in (1, 2):
            if _is_fifo(fd):
                os.close(fd)
        try:
            _, status = _wait(reaper, 0)
        except ChildProcessError:
            os._exit(1)
        os._exit(_exit_code(status))

    try:
        os.setsid()
    except OSError as exc:
        os.write(2, f"ts-ship: setsid failed: {exc}\n".encode())
        os._exit(1)
    _ignore_terminal_stops()
    try:
        _prctl(PR_SET_PDEATHSIG, signal.SIGTERM)
        _prctl(PR_SET_CHILD_SUBREAPER, 1)
    except OSError as exc:
        os.write(2, f"ts-ship: prctl failed: {exc}\n".encode())
        os._exit(1)
    if os.getppid() == 1:
        os._exit(1)
    if log_path:
        _redirect_pipes(log_path)
    os.environ["TS_SHIP_REAPER"] = str(os.getpid())

    impl_pid = os.fork()
    if impl_pid == 0:
        try:
            os.setpgid(0, 0)
        except OSError:
            pass
        try:
            _prctl(PR_SET_PDEATHSIG, signal.SIGTERM)
        except OSError as exc:
            os.write(2, f"ts-ship: prctl failed: {exc}\n".encode())
            os._exit(1)
        if os.getppid() == 1:
            os._exit(1)
        os._exit(_run_impl(impl))
    try:
        os.setpgid(impl_pid, impl_pid)
    except OSError:
        pass
    os._exit(_reap_orphans(impl_pid))


def main() -> None:
    supervise(resolve_impl())


if __name__ == "__main__":
    main()
