FROM rust:1.88.0-bookworm@sha256:af306cfa71d987911a781c37b59d7d67d934f49684058f96cf72079c3626bfe0 AS parser
ENV SOURCE_DATE_EPOCH=1791270348 CARGO_INCREMENTAL=0 CARGO_TARGET_DIR=/parser-target
ENV RUSTFLAGS="--remap-path-prefix=/repo=/usr/src/terrascale"
WORKDIR /repo
COPY src/vendor/Turso.Native/sql src/vendor/Turso.Native/sql
COPY scripts/vendor/prepare-router-parser-source.sh scripts/vendor/prepare-router-parser-source.sh
RUN bash scripts/vendor/prepare-router-parser-source.sh \
    && cargo build --manifest-path src/vendor/Turso.Native/sql/Cargo.toml --locked --release
COPY scripts/vendor/router-parser-smoke.c /smoke.c
RUN cc -Wall -Wextra -Werror -Isrc/vendor/Turso.Native/sql /smoke.c -L/parser-target/release -lterrascale_sql_parser -o /smoke \
    && LD_LIBRARY_PATH=/parser-target/release /smoke > /smoke.txt
ARG TARGETARCH
RUN case "$TARGETARCH" in amd64) rid=linux-x64; machine=3e00 ;; arm64) rid=linux-arm64; machine=b700 ;; *) exit 1 ;; esac \
    && test "$(od -An -tx1 -j18 -N2 /parser-target/release/libterrascale_sql_parser.so | tr -d ' \n')" = "$machine" \
    && mkdir -p "/out/router-parser/runtimes/$rid/native" "/out/router-parser/$rid" \
    && cp /parser-target/release/libterrascale_sql_parser.so "/out/router-parser/runtimes/$rid/native/" \
    && cp src/vendor/Turso.Native/sql/Cargo.lock src/vendor/Turso.Native/sql/ts_sql.h src/vendor/Turso.Native/sql/parser-limits.patch /smoke.txt "/out/router-parser/$rid/" \
    && cp artifacts/router-parser/turso/LICENSE.md artifacts/router-parser/turso/NOTICE.md "/out/router-parser/$rid/" \
    && rustc --version --verbose > "/out/router-parser/$rid/rustc.txt" \
    && nm -D --defined-only /parser-target/release/libterrascale_sql_parser.so > "/out/router-parser/$rid/exports.txt" \
    && cd /out/router-parser && sha256sum "runtimes/$rid/native/libterrascale_sql_parser.so" > "$rid/SHA256SUMS"

FROM scratch AS native
COPY --from=parser /out/ /
