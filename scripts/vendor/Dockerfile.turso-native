# syntax=docker/dockerfile:1
# Maintenance only: the helper requires a real host of the target architecture.
FROM rust:1.88.0-bookworm@sha256:af306cfa71d987911a781c37b59d7d67d934f49684058f96cf72079c3626bfe0 AS build
ADD --checksum=sha256:7ea83d5e28577cf9d8655b77705902379e06b82fb29424f6ea328b5f26f17ecb https://codeload.github.com/tursodatabase/turso/tar.gz/5c168be5ef6a32ac966daf5983502a4f694b37ad /turso.tar.gz
WORKDIR /turso
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
RUN tar -xzf /turso.tar.gz --strip-components=1
# Upstream core/build.rs uses this instead of wall-clock/git metadata.
ENV SOURCE_DATE_EPOCH=1791270348 CARGO_INCREMENTAL=0 \
    RUSTFLAGS="--cfg=tokio_unstable --remap-path-prefix=/turso=/usr/src/turso -C link-arg=-Wl,-z,nodelete"
COPY scripts/vendor/turso-native-budget.patch /inputs/turso-native-budget.patch
COPY src/vendor/Turso.Native/patches/*.patch /inputs/
RUN echo 'eadb14ec88ac351c938908443bcb89da324411e4eb8f8d068b3cc755fc0808ae  /inputs/0001-preserve-page-authentication-damage.patch' | sha256sum --check \
    && git apply --check /inputs/0001-preserve-page-authentication-damage.patch && git apply /inputs/0001-preserve-page-authentication-damage.patch \
    && echo 'e90dfc73d7064867fcfa5120c9b23f86d57eeaa7e6fca4c2c53005c80a37314f  /inputs/0002-select-runtime-aegis-c-backend.patch' | sha256sum --check \
    && git apply --check /inputs/0002-select-runtime-aegis-c-backend.patch && git apply /inputs/0002-select-runtime-aegis-c-backend.patch \
    && git apply --check /inputs/turso-native-budget.patch && git apply /inputs/turso-native-budget.patch \
    && echo '1f8be1f08274d7eb4ca5b4f37dcce153107e6177fec8efb53d8097df46bafd59  /inputs/0004-explicit-wal-revision-contract.patch' | sha256sum --check \
    && git apply --check /inputs/0004-explicit-wal-revision-contract.patch && git apply /inputs/0004-explicit-wal-revision-contract.patch
# The sync dependency selects encryption + FTS without the transitive pure-rust default.
RUN cargo +1.88.0 tree --locked --package turso_sync_sdk_kit --features turso_sdk_kit/fts -e features -i aegis > /inputs/aegis-feature-tree.txt \
    && ! grep -E 'feature "(pure-rust|pure-rust-crypto)"' /inputs/aegis-feature-tree.txt \
    && aegis=(/usr/local/cargo/registry/src/*/aegis-0.9.8) && test "${#aegis[@]}" = 1 \
    && echo "6d8f7dfa155082559521a4ee9fa7190e8ea5853201969ce7cbc2c6a503d4f37a  ${aegis[0]}/build.rs" | sha256sum --check \
    && echo '6455f6063640de4aa6970178fe071cd8dee9483541c884a438009d64a42e7f97  /inputs/0003-keep-aegis-c-runtime-portable.patch' | sha256sum --check \
    && (cd "${aegis[0]}" && git apply --check /inputs/0003-keep-aegis-c-runtime-portable.patch && git apply /inputs/0003-keep-aegis-c-runtime-portable.patch) \
    && cp "${aegis[0]}/build.rs" /inputs/aegis-build.rs \
    && cp /usr/local/cargo/registry/cache/*/aegis-0.9.8.crate /inputs/ \
    && echo '78412fa53e6da95324e8902c3641b3ff32ab45258582ea997eb9169c68ffa219  /inputs/aegis-0.9.8.crate' | sha256sum --check \
    && cargo +1.88.0 build --locked --package turso_sync_sdk_kit --features turso_sdk_kit/fts --profile lib-release \
    && cp target/lib-release/libturso_sync_sdk_kit.so target/lib-release/libturso_sdk_kit.so
ARG TARGETARCH
COPY scripts/vendor/turso-native-smoke.c scripts/vendor/turso-native-contract-smoke.c scripts/vendor/turso-native-wal-smoke.c \
     scripts/vendor/Dockerfile.turso-native scripts/vendor/build-turso-native.sh scripts/vendor/check-turso-native-crypto.sh /inputs/
RUN case "$TARGETARCH" in amd64) rid=linux-x64; machine=3e00 ;; arm64) rid=linux-arm64; machine=b700 ;; *) exit 1 ;; esac \
    && test "$(od -An -tx1 -N6 target/lib-release/libturso_sdk_kit.so | tr -d ' \n')" = 7f454c460201 \
    && test "$(od -An -tx1 -j18 -N2 target/lib-release/libturso_sdk_kit.so | tr -d ' \n')" = "$machine" \
    && mkdir -p "/out/runtimes/$rid/native" /out/release \
    && mv /inputs/aegis-feature-tree.txt "/out/release/$rid-aegis-feature-tree.txt" \
    && bash /inputs/check-turso-native-crypto.sh target/lib-release/libturso_sdk_kit.so "$rid" /out/release \
    && readelf -d target/lib-release/libturso_sdk_kit.so > "/out/release/$rid-elf-dynamic.txt" \
    && ! grep -E 'RPATH|RUNPATH|Shared library: \[/' "/out/release/$rid-elf-dynamic.txt" \
    && readelf --version-info target/lib-release/libturso_sdk_kit.so > "/out/release/$rid-elf-versions.txt" \
    && nm -D --defined-only target/lib-release/libturso_sdk_kit.so > "/out/release/$rid-exports.txt" \
    && grep -qw turso_sync_database_new "/out/release/$rid-exports.txt" \
    && grep -qw turso_terrascale_storage_error_contract "/out/release/$rid-exports.txt" \
    && grep -qw turso_connection_set_fts_progress_handler "/out/release/$rid-exports.txt" \
    && for symbol in turso_terrascale_wal_contract turso_terrascale_wal_manual turso_terrascale_wal_state turso_terrascale_wal_frame_pages turso_terrascale_wal_checkpoint_truncate turso_terrascale_snapshot_read_page turso_terrascale_page_size; do grep -qw "$symbol" "/out/release/$rid-exports.txt"; done \
    && cc -Wall -Wextra -Werror -I sdk-kit /inputs/turso-native-smoke.c -L target/lib-release -lturso_sdk_kit -o /smoke \
    && cc -Wall -Wextra -Werror -I sdk-kit /inputs/turso-native-contract-smoke.c -L target/lib-release -lturso_sdk_kit -o /contract-smoke \
    && cc -Wall -Wextra -Werror -I sdk-kit /inputs/turso-native-wal-smoke.c -L target/lib-release -lturso_sdk_kit -o /wal-smoke \
    && LD_LIBRARY_PATH=/turso/target/lib-release /smoke 2>&1 | tee "/out/release/$rid-fts-smoke.txt" \
    && LD_LIBRARY_PATH=/turso/target/lib-release /smoke expression 2>&1 | tee "/out/release/$rid-expression-probe.txt" \
    && LD_LIBRARY_PATH=/turso/target/lib-release /contract-smoke 2>&1 | tee "/out/release/$rid-contract1-smoke.txt" \
    && LD_LIBRARY_PATH=/turso/target/lib-release /wal-smoke 2>&1 | tee "/out/release/$rid-wal-smoke.txt" \
    && cp target/lib-release/libturso_sdk_kit.so "/out/runtimes/$rid/native/" \
    && (cd /usr/local/cargo/registry/src \
        && find . -type f \( -iname '*license*' -o -iname 'copying*' -o -iname 'notice*' -o -name Cargo.toml -o -name .cargo-checksum.json \) -print0 \
        | sort -z | tar --mtime="@$SOURCE_DATE_EPOCH" --owner=0 --group=0 --numeric-owner --null -T - -czf "/out/release/$rid-dependency-licenses.tar.gz") \
    && cp /inputs/* LICENSE.md NOTICE.md Cargo.lock /out/release/ \
    && cp /turso.tar.gz /out/release/turso-5c168be5ef6a32ac966daf5983502a4f694b37ad.tar.gz \
    && { printf 'source_commit=5c168be5ef6a32ac966daf5983502a4f694b37ad\nversion=0.8.2\nrid=%s\nhost=%s\n' "$rid" "$(uname -m)"; \
         printf 'rust_image=rust:1.88.0-bookworm@sha256:af306cfa71d987911a781c37b59d7d67d934f49684058f96cf72079c3626bfe0\n'; \
         printf 'command=cargo +1.88.0 build --locked --package turso_sync_sdk_kit --features turso_sdk_kit/fts --profile lib-release\n'; \
         printf 'sdk_dependency_defaults=disabled;features=encryption,fts\naegis_backend=runtime-dispatched-c\nSOURCE_DATE_EPOCH=%s\nRUSTFLAGS=%s\n' "$SOURCE_DATE_EPOCH" "$RUSTFLAGS"; \
         rustc +1.88.0 --version --verbose; \
         cd /out/release; sha256sum Cargo.lock *.patch Dockerfile.turso-native *.sh aegis-build.rs "$rid-aegis-feature-tree.txt" *.c *.crate *.tar.gz; \
         cd /out; sha256sum "runtimes/$rid/native/libturso_sdk_kit.so"; \
       } > "/out/release/$rid-build-receipt.txt" \
    && cd /out \
    && find runtimes release -type f -print0 | sort -z | xargs -0 sha256sum > "SHA256SUMS-$rid"

FROM scratch AS native
COPY --from=build /out/ /
