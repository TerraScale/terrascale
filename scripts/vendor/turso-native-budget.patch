+#[test]
+fn distinct_term_clauses_are_charged_individually_on_a_tiny_index() {
+    let attachment = test_attachment();
+    let (segment, _) = build_and_load_segment(&attachment, &[(1, "zaa")]);
+    let mut cursor = FtsCursor::new(&attachment);
+    cursor.segments = vec![segment];
+    cursor.ensure_searcher().unwrap();
+    let parser = tantivy::query::QueryParser::for_index(
+        cursor.index.as_ref().unwrap(),
+        vec![cursor.default_fields[0]],
+    );
+    let terms = (0..500u16)
+        .map(|i| {
+            format!(
+                "z{}{}",
+                char::from(b'a' + (i / 26) as u8),
+                char::from(b'a' + (i % 26) as u8)
+            )
+        })
+        .collect::<Vec<_>>()
+        .join(" OR ");
+    assert_eq!(terms.len(), 3496);
+    let (query, errors) = parser.parse_query_lenient(&terms);
+    assert!(errors.is_empty());
+    let mut physical_terms = 0;
+    query.query_terms(&mut |_, _| physical_terms += 1);
+    assert_eq!(physical_terms, 500);
+    assert!(fts_query_clause_count(query.as_ref(), terms.len() as u64) >= 500);
+
+    let repeated = std::iter::repeat_n("zaa", 500)
+        .collect::<Vec<_>>()
+        .join(" OR ");
+    let (query, errors) = parser.parse_query_lenient(&repeated);
+    assert!(errors.is_empty());
+    let mut physical_terms = 0;
+    query.query_terms(&mut |_, _| physical_terms += 1);
+    assert_eq!(physical_terms, 1);
+    assert!(fts_query_clause_count(query.as_ref(), repeated.len() as u64) < 500);
+}
