+    }
+    if query.is::<tantivy::query::PhrasePrefixQuery>() {
+        return 50;
+    }
+    if query.is::<tantivy::query::BoostQuery>() {
+        let mut positional_terms = 0u64;
+        query.query_terms(&mut |_, positions| {
+            positional_terms = positional_terms.saturating_add(u64::from(positions));
+        });
+        // Opaque boosted subtrees may hide one 50-term prefix expansion per positional term.
+        return positional_terms.saturating_mul(50);
+    }
+    0
+}
+
+fn fts_query_position_bytes(
+    query: &dyn tantivy::query::Query,
+    segment: &SegmentReader,
+    fields: &[Field],
+    has_slop: bool,
+) -> Result<u64> {
+    fields.iter().try_fold(0u64, |bytes, field| {
+        let mut occurrences = 0u64;
+        query.query_terms(&mut |term, positions| {
+            if positions && term.field() == *field {
+                occurrences = occurrences.saturating_add(1);
+            }
+        });
+        if occurrences == 0 {
+            return Ok(bytes);
+        }
+        let tokens = segment
+            .inverted_index(*field)
+            .map_err(|error| LimboError::InternalError(format!("FTS token count error: {error}")))?
+            .total_num_tokens();
+        let linear = tokens.saturating_mul(occurrences).saturating_mul(64);
+        let carrying = if has_slop {
+            fts_query_carrying_bytes(query, *field, tokens)
+        } else {
+            0
+        };
+        Ok(bytes.saturating_add(linear).saturating_add(carrying))
+    })
+}
+
+fn fts_query_carrying_bytes(query: &dyn tantivy::query::Query, field: Field, tokens: u64) -> u64 {
+    if let Some(boolean) = query.downcast_ref::<tantivy::query::BooleanQuery>() {
+        return boolean.clauses().iter().fold(0u64, |bytes, (_, clause)| {
+            bytes.saturating_add(fts_query_carrying_bytes(clause.as_ref(), field, tokens))
+        });
+    }
+    if !query.is::<tantivy::query::PhraseQuery>() && !query.is::<tantivy::query::BoostQuery>() {
+        return 0;
+    }
+    let mut terms = 0u64;
+    query.query_terms(&mut |term, positions| {
+        if positions && term.field() == field {
+            terms = terms.saturating_add(1);
+        }
+    });
+    if terms < 3 || tokens == 0 {
+        return 0;
+    }
+    let mut entries = tokens;
+    // A carrying join can append L*R + L + R entries; later joins consume that expanded output.
+    for _ in 0..terms - 2 {
+        entries = entries
+            .saturating_mul(tokens)
+            .saturating_add(entries)
+            .saturating_add(tokens);
+        if entries == u64::MAX {
+            return u64::MAX;
+        }
+    }
+    entries.saturating_mul(64)
+}
+
+fn fts_query_has_slop(ast: &tantivy::query_grammar::UserInputAst) -> bool {
+    use tantivy::query_grammar::{UserInputAst, UserInputLeaf};
+    match ast {
+        UserInputAst::Clause(clauses) => clauses.iter().any(|(_, child)| fts_query_has_slop(child)),
+        UserInputAst::Boost(child, _) => fts_query_has_slop(child),
+        UserInputAst::Leaf(leaf) => {
+            matches!(leaf.as_ref(), UserInputLeaf::Literal(literal) if literal.slop > 0)
+        }
+    }
+}
