+#[cfg(feature = "test_helper")]
+#[test]
+fn completed_fts_statements_release_payloads_in_an_open_transaction() {
+    for mvcc in [false, true] {
+        let db = crate::Database::open(
+            Arc::new(crate::MemoryIO::new()),
+            ":memory:",
+            crate::OpenOptions::new(Arc::new(crate::SqliteDialect))
+                .db_opts(crate::DatabaseOpts::default().with_index_method(true)),
+        )
+        .unwrap();
+        let conn = db.connect().unwrap();
+        if mvcc {
+            conn.execute("PRAGMA journal_mode = 'mvcc'").unwrap();
+        }
+        for sql in [
+            "CREATE TABLE a(id INTEGER PRIMARY KEY, body TEXT)",
+            "CREATE TABLE b(id INTEGER PRIMARY KEY, body TEXT)",
+            "CREATE INDEX a_fts ON a USING fts(body)",
+            "CREATE INDEX b_fts ON b USING fts(body)",
+            "INSERT INTO a VALUES (1, 'native')",
+            "INSERT INTO b VALUES (1, 'native')",
+            "BEGIN",
+            "UPDATE a SET body = 'native updated' WHERE id = 1",
+        ] {
+            conn.execute(sql).unwrap();
+        }
+        for sql in [
+            "SELECT count(*) FROM a WHERE fts_match(body, 'native')",
+            "SELECT count(*) FROM b WHERE fts_match(body, 'native')",
+            "SELECT id, fts_score(body, 'native') FROM a WHERE fts_match(body, 'native') LIMIT 10001",
+            "SELECT count(*) FROM a WHERE fts_match(body, 'native')",
+        ] {
+            let rows = conn.prepare(sql).unwrap().run_collect_rows().unwrap();
+            assert_eq!(rows[0][0], Value::from_i64(1));
+            assert!(!conn.get_auto_commit());
+            let entries = conn.index_method_tx_cursors.lock();
+            assert!(!entries.is_empty());
+            for entry in entries.iter() {
+                let stats = entry.cursor.test_stats().unwrap().unwrap();
+                assert_eq!(stats.segment_count, None, "{sql}");
+                assert_eq!(stats.storage_file_count, 0, "{sql}");
+                assert_eq!(stats.cached_bytes, Some(0), "{sql}");
+            }
+        }
+        assert!(conn.index_method_tx_cursors.lock().len() >= 2);
+        conn.execute("ROLLBACK").unwrap();
+        let rows = conn
+            .prepare("SELECT count(*) FROM a WHERE fts_match(body, 'updated')")
+            .unwrap()
+            .run_collect_rows()
+            .unwrap();
+        assert_eq!(rows, vec![vec![Value::from_i64(0)]]);
+        let rows = conn
+            .prepare("SELECT count(*) FROM a WHERE fts_match(body, 'native')")
+            .unwrap()
+            .run_collect_rows()
+            .unwrap();
+        assert_eq!(rows, vec![vec![Value::from_i64(1)]]);
+    }
+}
