+fn fts_query_clause_count(query: &dyn tantivy::query::Query, query_bytes: u64) -> u64 {
+    if let Some(boolean) = query.downcast_ref::<tantivy::query::BooleanQuery>() {
+        return boolean.clauses().iter().fold(1u64, |count, (_, clause)| {
+            count.saturating_add(fts_query_clause_count(clause.as_ref(), query_bytes))
+        });
+    }
+    if query.is::<tantivy::query::BoostQuery>() {
+        // BoostQuery hides its subtree; the bounded source length bounds its syntax nodes.
+        return query_bytes;
+    }
+    let mut terms = 0u64;
+    query.query_terms(&mut |_, _| terms = terms.saturating_add(1));
+    terms.max(1)
+}
