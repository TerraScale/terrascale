+/// TerraScale's internal ABI: configure only while this connection is idle.
+/// The callback must remain alive until cleared and must not reenter Turso.
+#[no_mangle]
+pub extern "C" fn turso_connection_set_fts_progress_handler(
+    connection: *const c::turso_connection_t,
+    callback: Option<unsafe extern "C" fn(u64, u64) -> i32>,
+    error_opt_out: *mut *const std::ffi::c_char,
+) -> c::turso_status_code_t {
+    let connection = match unsafe { TursoConnection::ref_from_capi(connection) } {
+        Ok(connection) => connection,
+        Err(err) => return unsafe { err.to_capi(error_opt_out) },
+    };
+    connection.set_fts_progress_handler(callback.map(|callback| {
+        Box::new(move |work, bytes| unsafe { callback(work, bytes) != 0 })
+            as Box<dyn Fn(u64, u64) -> bool + Send + Sync>
+    }));
+    c::turso_status_code_t::TURSO_OK
+}
