+#[test]
+fn dense_phrase_positions_and_prefix_expansions_are_charged_before_scorers() {
+    let attachment = test_attachment();
+    let body = "a ".repeat(262144);
+    let (segment, _) = build_and_load_segment(&attachment, &[(1, body.as_str())]);
+    let mut cursor = FtsCursor::new(&attachment);
+    cursor.segments = vec![segment];
+    cursor.ensure_searcher().unwrap();
+    let segment = &cursor.searcher.as_ref().unwrap().segment_readers()[0];
+    let parser = tantivy::query::QueryParser::for_index(
+        cursor.index.as_ref().unwrap(),
+        vec![cursor.default_fields[0]],
+    );
+    for (terms, positional_occurrences, expansions) in [
+        (r#""a a""#, 2, 0),
+        (r#""a a"~2"#, 2, 0),
+        (r#""a a"*"#, 1, 50),
+        (r#"("a a")^2"#, 2, 100),
+        (r#"("a a"* OR "a a")^2"#, 3, 150),
+    ] {
+        let query = parser.parse_query(terms).unwrap();
+        assert_eq!(
+            fts_query_position_bytes(query.as_ref(), segment, &cursor.default_fields, false)
+                .unwrap(),
+            262144 * positional_occurrences * 64,
+            "{terms}"
+        );
+        assert_eq!(
+            fts_query_prefix_expansions(query.as_ref()),
+            expansions,
+            "{terms}"
+        );
+    }
+    let terms = (0..300)
+        .map(|slop| format!("\"a a\"~{slop}"))
+        .collect::<Vec<_>>()
+        .join(" OR ");
+    assert!(terms.len() < FTS_MAX_QUERY_BYTES);
+    let query = parser.parse_query(&terms).unwrap();
+    assert_eq!(
+        fts_query_position_bytes(query.as_ref(), segment, &cursor.default_fields, false).unwrap(),
+        262144 * 600 * 64
+    );
+    let repeated = std::iter::repeat_n(r#""a a""#, 300)
+        .collect::<Vec<_>>()
+        .join(" OR ");
+    let (query, errors) = parser.parse_query_lenient(&repeated);
+    assert!(errors.is_empty());
+    assert_eq!(
+        fts_query_position_bytes(query.as_ref(), segment, &cursor.default_fields, false).unwrap(),
+        262144 * 2 * 64
+    );
+    let query = parser.parse_query("a").unwrap();
+    assert_eq!(
+        fts_query_position_bytes(query.as_ref(), segment, &cursor.default_fields, false).unwrap(),
+        0
+    );
+    let query = cursor
+        .cached_parser
+        .as_ref()
+        .unwrap()
+        .parse_query(r#""a a"*"#)
+        .unwrap();
+    assert_eq!(fts_query_prefix_expansions(query.as_ref()), 100);
+    assert_eq!(
+        fts_query_position_bytes(query.as_ref(), segment, &cursor.default_fields, false).unwrap(),
+        262144 * 64
+    );
+}
+
+#[test]
+fn carrying_slop_scratch_is_bounded_across_every_intermediate_join() {
+    let attachment = test_attachment();
+    let body = format!("{}{}c", "b ".repeat(8192), "a ".repeat(8192));
+    assert_eq!(body.len(), 32769);
+    let (segment, _) = build_and_load_segment(&attachment, &[(1, body.as_str())]);
+    let mut cursor = FtsCursor::new(&attachment);
+    cursor.segments = vec![segment];
+    cursor.ensure_searcher().unwrap();
+    let segment = &cursor.searcher.as_ref().unwrap().segment_readers()[0];
+    let parser = tantivy::query::QueryParser::for_index(
+        cursor.index.as_ref().unwrap(),
+        vec![cursor.default_fields[0]],
+    );
+    let tokens = 16385u64;
+    let first_join = tokens * tokens + 2 * tokens;
+    let second_join = first_join * tokens + first_join + tokens;
+    for (terms, expected) in [
+        (r#""a b c""#, tokens * 3 * 64),
+        (r#""a b c"~0"#, tokens * 3 * 64),
+        (r#""a b c"~20000"#, (tokens * 3 + first_join) * 64),
+        (r#"("a b c"~20000)^2"#, (tokens * 3 + first_join) * 64),
+        (
+            r#""a b c"~20000 OR "a b c"~20001"#,
+            (tokens * 3 + first_join) * 128,
+        ),
+        (r#""a b c d"~20000"#, (tokens * 4 + second_join) * 64),
+        (r#""a b c d e f g h"~20000"#, u64::MAX),
+        (r#""a b c"*"#, tokens * 2 * 64),
+    ] {
+        let (ast, errors) = tantivy::query_grammar::parse_query_lenient(terms);
+        assert!(errors.is_empty(), "{terms}");
+        let has_slop = fts_query_has_slop(&ast);
+        let (query, errors) = parser.build_query_from_user_input_ast_lenient(ast);
+        assert!(errors.is_empty(), "{terms}");
+        // Estimate only: constructing the unadmitted carrying scorer would allocate hundreds of MiB.
+        let actual =
+            fts_query_position_bytes(query.as_ref(), segment, &cursor.default_fields, has_slop)
+                .unwrap();
+        assert_eq!(actual, expected, "{terms}");
+    }
+    assert!(first_join * 64 > 128 * 1024 * 1024);
+    assert!(first_join * 64 > 33566720 * 5);
+}
