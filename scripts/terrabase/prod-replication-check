#!/usr/bin/env python3
"""Live replication check of a TerraBase cell (TS-660). Exits 0 when every member agrees, 1 on any failure, 2 on usage.

usage: prod-replication-check [--canary FILE] [--docs N] [--max-lag-seconds S] [--log-minutes M] [--host-exec CMD]

Writes only to the canary database named in FILE: creates, replaces, patches and deletes N fixed documents
(UUIDv5 ids per host; runs on one host take turns through FILE.lock) of collection "canary" through the API, with If-None-Match and If-Match, and checks that stale
conditional writes answer 412. Then it reads every document directly from every member and compares status,
JSON and version (ETag, tombstones included) with what the API answered, until they agree or S seconds pass.
It also requires each member's admin /metrics (replication durable lag, catalog follower lag,
rejected groups, prefix mismatches) and its last M minutes of logs (replication warnings, corruption).
The API and every member must be ready in FILE's region before writes; every client request is region-pinned
and every response must identify that region, including errors; redirects are not followed.
This is a sampled canary check, not proof of Anna-only service or a continuous production soak.

FILE (mode 0600) is JSON: {"api": "https://gru.api.terrascale.tech", "region": "gru-1", "project": "<project id>",
"database": "<database name>", "secret": "tb_...", "members": ["10.251.0.11:9465", ...],
"member_ca": "<PEM of the member CA>"}. CMD runs a shell script from stdin on a member; {ip} is replaced
by the member's host, and {member} by its full host:port. CMD must report completion of both metrics and logs;
an empty CMD, missing gauges or incomplete host observations cannot pass.
"""
import argparse
import concurrent.futures
import fcntl
import ipaddress
import json
import math
import os
import re
import socket
import ssl
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

COLLECTION = "canary"
DEFAULT_CANARY = os.path.expanduser("~/.config/terrabase/gru-1-canary.json")
DEFAULT_HOST_EXEC = (
    "ssh -o BatchMode=yes -o ConnectTimeout=10 mariogk-dev ssh -o BatchMode=yes -o ConnectTimeout=8"
    " -o UserKnownHostsFile=.local/state/ts574-release/known_hosts_gru1 -J ts-ops ubuntu@{ip} bash -s"
)
# Peer connectivity blips (a member restarting or a deploy) retry by design; anything else a replication or catalog
# component warns about is a failure.
TRANSIENT = re.compile(r"Unavailable|Connection refused|No route to host|timed out|DeadlineExceeded|Cancelled|reset by peer|Error starting gRPC call")
CORRUPT = re.compile(r"corrupt|malformed|checksum mismatch|digest mismatch", re.IGNORECASE)

# Prints one record per line: start, metric, log (category, message, first exception line) and bad (corruption).
HOST_SCRIPT = r"""
set -euo pipefail
metrics=$(mktemp)
logs=$(mktemp)
trap 'rm -f "$metrics" "$logs"' EXIT
pid=$(pgrep -f /install/terrabase/)
if [[ ! $pid =~ ^[0-9]+$ ]]; then
    echo "expected one TerraBase process, found: ${pid//[[:space:]]/ }" >&2
    exit 3
fi
started=$(stat -c %Y "/proc/$pid")
echo "start $started"
curl --fail --silent --show-error --max-time 5 http://127.0.0.1:9464/metrics > "$metrics"
awk '/^terrabase_(replication_(sender_durable_lag|sender_initialized|received_groups_total|sender_prefix_mismatches_total)|catalog_follower_(connected|lag))[ {]/ { print "metric " $0 }' "$metrics"
echo "complete metrics"
sudo journalctl -u terrascale-orchestrator-host --since "-MINUTES min" -o cat --no-pager > "$logs"
awk '/^(warn|fail|crit): TerraBase\.(Features\.(Replication|Catalog|CrossRegion)|Engine)/ { c = $0; getline m; getline e; print "log " c "\t" m "\t" e }' "$logs"
awk 'tolower($0) ~ /corrupt|malformed|checksum mismatch|digest mismatch/ && count++ < 5 { print "bad " $0 }' "$logs"
echo "complete logs"
"""

failures = []


def fail(message):
    failures.append(message)
    print("FAIL " + message, flush=True)


def load_canary(path):
    mode = os.stat(path).st_mode
    if mode & (stat.S_IRWXG | stat.S_IRWXO):
        raise ValueError("canary file holds an API key: chmod 600 it")
    with open(path, encoding="utf-8") as file:
        canary = json.load(file)
    if not isinstance(canary, dict):
        raise ValueError("canary file must contain an object")
    missing = {"api", "region", "project", "database", "secret", "members", "member_ca"} - canary.keys()
    if missing:
        raise ValueError(f"canary file lacks {', '.join(sorted(missing))}")
    region = canary["region"]
    if not isinstance(region, str) or not re.fullmatch(r"[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?", region):
        raise ValueError("canary region must be a valid region id")
    members = canary["members"]
    if not isinstance(members, list) or not 1 <= len(members) <= 100:
        raise ValueError("canary members must contain 1 to 100 distinct host:port addresses")
    identities = set()
    for member in members:
        if not isinstance(member, str) or not re.fullmatch(r"(?:[A-Za-z0-9.-]+|\[[A-Fa-f0-9:]+\]):[0-9]+", member):
            raise ValueError("canary members must contain valid host:port addresses")
        address = urllib.parse.urlsplit("https://" + member)
        hostname = address.hostname
        if ":" in hostname or re.fullmatch(r"[0-9]+(?:\.[0-9]+){3}", hostname):
            hostname = str(ipaddress.ip_address(hostname))
        else:
            label = r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?"
            if len(hostname) > 253 or not re.fullmatch(rf"{label}(?:\.{label})*\.?", hostname):
                raise ValueError("canary members must contain valid hostname labels")
            hostname = hostname.rstrip(".")
        if not address.port or (hostname, address.port) in identities:
            raise ValueError("canary members must contain distinct host:port addresses with valid ports")
        identities.add((hostname, address.port))
    return canary


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Answers a redirect as itself (an HTTPError), so every observation comes from the configured target."""

    def redirect_request(self, request, fp, code, msg, headers, newurl):
        return None


class Api:
    def __init__(self, base, secret, context, project, database, region):
        self.base = base.rstrip("/")
        self.secret = secret
        self.opener = urllib.request.build_opener(NoRedirect, urllib.request.HTTPSHandler(context=context))
        self.region = region
        self.prefix = f"/v1/projects/{project}/databases/{database}/collections"

    def call(self, method, path, body=None, headers=None, content_type="application/json"):
        data = None if body is None else json.dumps(body).encode()
        request = urllib.request.Request(self.base + self.prefix + path, data=data, method=method)
        if data is not None:
            request.add_header("Content-Type", content_type)
        for name, value in (headers or {}).items():
            request.add_header(name, value)
        return self.send(request)

    def send(self, request):
        request.add_header("Authorization", "Bearer " + self.secret)
        # The edge refuses Python's default User-Agent (Cloudflare error 1010).
        request.add_header("User-Agent", "terrabase-prod-replication-check/1")
        request.add_header("X-TerraScale-Region-Pin", self.region)
        try:
            with self.opener.open(request, timeout=20) as response:
                self.check_region(response.headers)
                return response.status, (response.headers.get("ETag") or "").strip('"'), json.loads(response.read() or b"null")
        except urllib.error.HTTPError as error:
            self.check_region(error.headers)
            raw = error.read()
            try:
                payload = json.loads(raw)
            except ValueError:
                payload = raw[:200].decode(errors="replace")
            return error.code, (error.headers.get("ETag") or "").strip('"'), payload

    def check_region(self, headers):
        observed = headers.get_all("X-TerraBase-Region", [])
        if observed != [self.region]:
            raise RuntimeError(f"serving region header must name {self.region} exactly once; received {observed}")

    def ready(self):
        status, _, body = self.send(urllib.request.Request(self.base + "/readyz", method="GET"))
        if status != 200 or not isinstance(body, dict) or body.get("status") != "ready" or body.get("region") != self.region:
            raise RuntimeError(f"readiness must report ready in {self.region}; received HTTP {status} {body}")

    def document(self, id_, method="GET", body=None, headers=None, content_type="application/json"):
        return self.call(method, f"/{COLLECTION}/documents/{id_}", body, headers, content_type)


def expect(what, got, *codes):
    if got[0] not in codes:
        fail(f"{what}: HTTP {got[0]} {json.dumps(got[2])[:200]}, expected {'/'.join(map(str, codes))}")
        return False
    return True


def write(api, ids, run):
    """Runs the canary's writes through the API; returns id -> (status, version, document) as the API answered it."""
    status = api.call("POST", "", {"name": COLLECTION})
    expect("create collection", status, 201, 409)
    expected = {}
    for index, id_ in enumerate(ids):
        current = api.document(id_)
        if not expect(f"read {id_}", current, 200, 404):
            continue
        document = {"run": run, "index": index}
        if current[0] == 404:
            # Absent or a tombstone: a conditional create.
            written = api.document(id_, "PUT", document, {"If-None-Match": "*"})
            if not expect(f"create {id_} with If-None-Match: *", written, 201):
                continue
            expect(f"second create {id_} with If-None-Match: *", api.document(id_, "PUT", {"stale": run}, {"If-None-Match": "*"}), 412)
        else:
            written = api.document(id_, "PUT", document, {"If-Match": f'"{current[1]}"'})
            if not expect(f"replace {id_} with If-Match", written, 200):
                continue
            expect(f"replace {id_} with a stale If-Match", api.document(id_, "PUT", {"stale": run}, {"If-Match": f'"{current[1]}"'}), 412)
        version = written[2]["version"]
        if index % 3 == 1:
            patched = api.document(id_, "PATCH", {"patched": run}, {"If-Match": f'"{version}"'}, "application/merge-patch+json")
            if expect(f"patch {id_} with If-Match", patched, 200):
                document["patched"] = run
                version = patched[2]["version"]
        if index % 4 == 3:
            deleted = api.document(id_, "DELETE", headers={"If-Match": f'"{version}"'})
            if expect(f"delete {id_} with If-Match", deleted, 200, 204):
                expected[id_] = (404, deleted[2]["version"] if isinstance(deleted[2], dict) else None, None)
                continue
        expected[id_] = (200, version, document)
    return expected


def compare(member, api, expected, deadline, expected_run):
    """Polls one member until it answers every expected state; returns (matched, seconds, differences)."""
    started = time.monotonic()
    pending = dict(expected)
    differences = {}
    while True:
        for id_, (status, version, document) in list(pending.items()):
            got = api.document(id_)
            body = got[2] if isinstance(got[2], dict) else {}
            same = got[0] == status and (version is None or got[1] == version) and (
                status != 200 or (body.get("version") == version and body.get("document") == document))
            if same:
                del pending[id_]
                differences.pop(id_, None)
            else:
                writer = (body.get("document") or {}).get("run")
                differences[id_] = (f"HTTP {got[0]} version {got[1] or '-'}, expected HTTP {status} version {version}"
                                    + (f" (written by run {writer}: another check ran concurrently)" if writer and writer != expected_run else ""))
        if not pending or time.monotonic() > deadline:
            return len(expected) - len(pending), time.monotonic() - started, differences
        time.sleep(0.5)


def listing(api):
    """The member's live documents of the canary collection: id -> version."""
    found, cursor = {}, None
    while True:
        status, _, page = api.call("GET", f"/{COLLECTION}/documents?limit=100" + (f"&cursor={cursor}" if cursor else ""))
        if status != 200:
            raise RuntimeError(f"list answered HTTP {status}")
        found.update({item["id"]: item["version"] for item in page["items"]})
        cursor = page.get("next_cursor")
        if not cursor:
            return found


def agree(members, deadline):
    """Lists every member until they all list the same live documents or the deadline passes; returns the last listings.

    Members are listed one after another, so a write another client makes meanwhile (another host's run) can reach one
    member's listing and not the next: only a difference that outlasts the deadline is divergence.
    """
    members = dict(members)
    while True:
        listings = {}
        for member, client in list(members.items()):
            try:
                listings[member] = listing(client)
            except (OSError, RuntimeError, ValueError) as error:
                fail(f"{member}: {error}")
                del members[member]
        values = list(listings.values())
        if all(live == values[0] for live in values) or time.monotonic() > deadline:
            return listings
        time.sleep(0.5)


def host(command, member, minutes):
    ip = urllib.parse.urlsplit("https://" + member).hostname
    result = subprocess.run(
        command.replace("{ip}", ip).replace("{member}", member), shell=True, input=HOST_SCRIPT.replace("MINUTES", str(minutes)),
        capture_output=True, text=True, timeout=120, check=False)
    if result.returncode != 0:
        # The cause comes last: ssh's jump-host warnings and banners come first.
        stderr = result.stderr.strip()
        raise RuntimeError(f"host command exited {result.returncode}: {stderr if len(stderr) <= 200 else '...' + stderr[-197:]}")
    report = {"start": None, "metrics": {}, "logs": [], "bad": []}
    complete = set()
    for line in result.stdout.splitlines():
        kind, _, rest = line.partition(" ")
        if kind == "start":
            report["start"] = int(rest) if rest.strip() else None
        elif kind == "complete":
            complete.add(rest)
        elif kind == "metric":
            # name{labels} value [timestamp]; the scope label is the same on every series.
            name, value = rest.split()[:2]
            name = re.sub(r'otel_scope_name="[^"]*"', "", name).replace("{,", "{").replace(",}", "}").replace("{}", "")
            number = float(value)
            if not math.isfinite(number) or number < 0 or name in report["metrics"]:
                raise ValueError("host metrics contain an invalid value or duplicate series")
            report["metrics"][name] = number
        elif kind == "log":
            report["logs"].append(rest)
        elif kind == "bad":
            report["bad"].append(rest)
    if complete != {"metrics", "logs"}:
        raise ValueError("host observations incomplete: metrics and logs completion required")
    if report["start"] is None or report["start"] <= 0:
        raise ValueError("host observations lack a process start time")
    required = {"terrabase_replication_sender_initialized", "terrabase_replication_sender_durable_lag"}
    missing = required - report["metrics"].keys()
    if missing:
        raise ValueError("host metrics missing " + ", ".join(sorted(missing)))
    catalog = {"terrabase_catalog_follower_connected", "terrabase_catalog_follower_lag"}
    if report["metrics"].keys() & catalog and catalog - report["metrics"].keys():
        raise ValueError("host metrics require both catalog follower connected and lag gauges")
    return report


def signals(report, minutes):
    """Failure signals in one sample: rejection counters, persistent replication warnings and corruption signs."""
    found = []
    metrics = report["metrics"]
    for name in ('terrabase_replication_received_groups_total{result="rejected"}', "terrabase_replication_sender_prefix_mismatches_total"):
        if metrics.get(name, 0) > 0:
            found.append(f"{name} = {metrics[name]:g} since the process started")
    # Retry delays and counts differ on every line: group by the text without its numbers.
    persistent = [re.sub(r"\d+(\.\d+)?", "N", re.sub(r"\s+", " ", entry)) for entry in report["logs"] if not TRANSIENT.search(entry)]
    report["transient"] = len(report["logs"]) - len(persistent)
    report["errors"] = len(persistent)
    for entry in sorted(set(persistent), key=persistent.count, reverse=True)[:3]:
        found.append(f"log ({persistent.count(entry)}x in {minutes} min): {entry[:300]}")
    for entry in report["bad"]:
        found.append(f"corruption sign in the log: {entry[:300]}")
    return found


def sample(command, member, minutes):
    try:
        report = host(command, member, minutes)
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        return {"error": str(error)}
    report["signals"] = signals(report, minutes)
    return report


def check_hosts(command, members, minutes, deadline):
    """Samples every member until replication lag is 0 everywhere or the deadline passes; returns member -> report."""
    with concurrent.futures.ThreadPoolExecutor(len(members)) as pool:
        while True:
            reports = dict(zip(members, pool.map(lambda member: sample(command, member, minutes), members)))
            lagging = [member for member, report in reports.items() if "error" not in report and lag(report)]
            # A later healthy scrape must not erase missing evidence or a failure signal from this run: a restart resets
            # the counters and the log window moves on. Only convergence is retried.
            if any("error" in report or report["signals"] for report in reports.values()) or not lagging or time.monotonic() > deadline:
                break
            time.sleep(2)
    for member, report in reports.items():
        if "error" in report:
            fail(f"{member}: host checks failed: {report['error']}")
            continue
        metrics = report["metrics"]
        if metrics["terrabase_replication_sender_initialized"] != 1:
            fail(f"{member}: replication sender not initialized (journal heads still being measured)")
        if lag(report):
            fail(f"{member}: replication not converged: {lag(report)}")
        for message in report["signals"]:
            fail(f"{member}: {message}")
    return reports


def lag(report):
    """Non-zero replication lag of one member: the sender's durable lag, and a follower's catalog lag or disconnection."""
    metrics = report["metrics"]
    found = {}
    if metrics["terrabase_replication_sender_durable_lag"] != 0:
        found["durable_lag"] = metrics["terrabase_replication_sender_durable_lag"]
    if "terrabase_catalog_follower_connected" in metrics:
        if metrics["terrabase_catalog_follower_connected"] != 1:
            found["catalog_connected"] = metrics["terrabase_catalog_follower_connected"]
        if metrics["terrabase_catalog_follower_lag"] != 0:
            found["catalog_lag"] = metrics["terrabase_catalog_follower_lag"]
    return found


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--canary", default=DEFAULT_CANARY)
    parser.add_argument("--docs", type=int, default=20)
    parser.add_argument("--max-lag-seconds", type=float, default=15)
    parser.add_argument("--log-minutes", type=int, default=20)
    parser.add_argument("--host-exec", default=DEFAULT_HOST_EXEC)
    options = parser.parse_args()
    if not 1 <= options.docs <= 100:
        parser.error("--docs must be 1 to 100")
    if not math.isfinite(options.max_lag_seconds) or options.max_lag_seconds <= 0:
        parser.error("--max-lag-seconds must be positive and finite")
    if not 1 <= options.log_minutes <= 2880:
        parser.error("--log-minutes must be 1 to 2880")
    if not options.host_exec.strip():
        parser.error("--host-exec must collect metrics and logs; host checks cannot be skipped")
    try:
        canary = load_canary(options.canary)
    except (OSError, ValueError, TypeError) as error:
        parser.error(f"cannot load canary file: {error}")
    # Runs on this host take turns, so one never rewrites the documents another is still comparing; another host has its own.
    lock = open(options.canary + ".lock", "w", encoding="utf-8")  # held until the process exits
    for _ in range(180):
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            time.sleep(1)
    else:
        sys.exit(f"another prod-replication-check has held {options.canary}.lock for 3 minutes")
    members = {
        member: Api(f"https://{member}", canary["secret"], ssl.create_default_context(cadata=canary["member_ca"]), canary["project"], canary["database"], canary["region"])
        for member in canary["members"]}
    api = Api(canary["api"], canary["secret"], ssl.create_default_context(), canary["project"], canary["database"], canary["region"])
    # Verify every configured target before any canary mutation, even if the public API routes elsewhere.
    for target, client in [(canary["api"], api), *members.items()]:
        try:
            client.ready()
        except (OSError, RuntimeError, ValueError) as error:
            fail(f"{target}: serving-region observation failed: {error}")
            return 1
    print(f"region {canary['region']}: API and {len(members)} configured members ready", flush=True)
    # Stable ids, so every run cycles the same documents and the canary does not grow.
    ids = [str(uuid.uuid5(uuid.NAMESPACE_URL, f"terrabase-prod-replication-check/{socket.gethostname()}/{index}")) for index in range(options.docs)]
    run = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + uuid.uuid4().hex[:8]
    print(f"run {run}: {options.docs} documents in {canary['api']} database {canary['database']}, {len(members)} members", flush=True)

    rows = {member: {} for member in members}
    try:
        expected = write(api, ids, run)
        deadline = time.monotonic() + options.max_lag_seconds
        print(f"wrote: {sum(1 for state in expected.values() if state[0] == 200)} live, {sum(1 for state in expected.values() if state[0] == 404)} deleted", flush=True)
        reachable = {}
        for member, client in members.items():
            try:
                matched, seconds, differences = compare(member, client, expected, deadline, run)
            except (OSError, RuntimeError, ValueError) as error:
                fail(f"{member}: {error}")
                continue
            reachable[member] = client
            rows[member].update(matched=f"{matched}/{len(expected)}", seconds=f"{seconds:.1f}")
            for id_, difference in sorted(differences.items()):
                fail(f"{member}: {id_} {difference}")
        listings = agree(reachable, time.monotonic() + options.max_lag_seconds)
        for member, live in listings.items():
            for id_, (status, version, _) in sorted(expected.items()):
                want = version if status == 200 else None
                if live.get(id_) != want:
                    fail(f"{member}: listing has {id_} at {live.get(id_, 'absent')}, expected {want or 'absent'}")
        # Every member must list the same live documents, those of earlier runs and other hosts' runs included.
        reference = next(iter(listings.values()), {})
        for member, live in listings.items():
            if live != reference:
                differing = sorted(set(live.items()) ^ set(reference.items()))[:3]
                fail(f"{member}: lists {len(live)} live documents, {next(iter(listings))} lists {len(reference)}; differing: {differing}")
    except (OSError, RuntimeError, ValueError, KeyError) as error:
        fail(f"API {canary['api']}: {error!r}")

    try:
        reports = check_hosts(options.host_exec, list(members), options.log_minutes, time.monotonic() + options.max_lag_seconds)
        for member in members:
            report = reports[member]
            if "error" in report:
                continue
            rows[member].update(
                durable_lag=f"{report['metrics']['terrabase_replication_sender_durable_lag']:g}",
                catalog_lag=f"{report['metrics'].get('terrabase_catalog_follower_lag', 0):g}",
                log_errors=report["errors"], log_transient=report["transient"],
                started=time.strftime("%H:%M:%SZ", time.gmtime(report["start"])))
    except (OSError, RuntimeError, ValueError) as error:
        fail(f"host checks: {error!r}")

    columns = ["matched", "seconds", "durable_lag", "catalog_lag", "log_errors", "log_transient", "started"]
    print("member".ljust(18) + "".join(column.ljust(15) for column in columns))
    for member, row in rows.items():
        print(member.ljust(18) + "".join(str(row.get(column, "-")).ljust(15) for column in columns))
    if failures:
        print(f"FAILED: {len(failures)} problems in run {run}", flush=True)
        return 1
    print(f"OK: sampled canary state and host observations agree on run {run}", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
