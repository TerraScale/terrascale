  {"path": "^(?:tests/TerraScale\\.Dashboard\\.E2E/Support/axe\\-core/axe\\.min\\.js)$", "repo": "terrascale", "terms": ["documents", "collections", "document-feeds"], "match": "\\b(?:document|documentElement|compareDocumentPosition|createHTMLDocument|topDocument|globalDocumentSet|Documents|Document|HTMLCollection)\\b|\\bfeed(?=:)|(?<=\\\")feed(?=\\\")", "reason": "Pinned axe accessibility library DOM symbols and the ARIA feed role, not database APIs."},
