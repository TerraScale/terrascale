  {"path": "^(?:src/TerraScale\\.Dashboard|tests/TerraScale\\.Dashboard\\.E2E)/.*\\.(?:cs|cshtml)$", "repo": "terrascale", "terms": ["documents"], "match": "\\bdocument\\.(?:getElementById|querySelector(?:All)?|createElement|body|head|documentElement|addEventListener|activeElement|fonts|readyState|createRange)\\b", "reason": "DOM calls embedded in Razor, C# strings and Playwright browser journeys."},
