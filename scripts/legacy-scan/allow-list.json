[
  {"path": "(^|/)AGENTS\\.md$", "reason": "Human-owned agent instructions are governance, not product surfaces."},
  {"path": "^scripts/legacy-scan/", "repo": "terrascale", "reason": "Scanner policy and process fixtures necessarily name forbidden terms."},
  {"path": "^\\.cos/archive/", "reason": "Explicitly archived planning history."},
  {"path": "^(?:docs/)?archive/", "reason": "Explicitly archived history; active documentation is scanned."},
  {"path": "^benchmark/bench/", "repo": "terrascale", "reason": "Immutable historical measurement reports retained for comparisons."},
  {"path": "(^|/)(?:THIRD[-_]PARTY[-_]NOTICES(?:\\.md|\\.txt)?|NOTICE(?:\\.md|\\.txt)?|LICENSE(?:\\.md|\\.txt)?)$", "terms": ["engine-brand", "libsql"], "reason": "Required upstream license and third-party attribution."},
  {"path": "^src/vendor/", "repo": "terrascale", "terms": ["engine-brand", "libsql"], "reason": "Vendored engine implementation names are internal."},
  {"path": "^(?:src/TerraBase/Engine/Turso/|scripts/vendor/|tests/Turso\\.Data\\.Sqlite\\.Tests/)", "repo": "terrascale", "terms": ["engine-brand"], "reason": "Internal engine wrapper, build and qualification code."},
  {"path": ".*", "terms": ["documents"], "match": "\\bJsonDocument(?:Options)?\\b|\\b(?:XDocument|XmlDocument)\\b", "reason": "JSON and XML parser types are not document APIs."},
  {"path": ".*", "terms": ["collections"], "match": "\\bSystem\\.Collections(?:\\.[A-Za-z]+)*\\b|\\b(?:IReadOnlyCollection|ICollection|ObservableCollection|ReadOnlyCollection|IServiceCollection|ServiceCollection|ServiceCollectionDescriptorExtensions|ServiceCollectionServiceExtensions|EndpointServiceCollectionExtensions)\\b|\\bGC\\.CollectionCount\\b", "reason": "Standard library collection types and GC measurements."},
  {"path": ".*", "terms": ["collections"], "match": "(?i)\\bGC collections?\\b|\\bgarbage collections?\\b", "reason": "Garbage collection terminology."},
  {"path": ".*", "terms": ["custom-wire"], "match": "(?i)\\b(?:postgres(?:ql)?|psql|PG)[ -]wire[ -]protocol\\b", "reason": "Postgres wire is a retained public SQL surface."},
  {"path": ".*\\.[cm]?[jt]sx?$", "terms": ["documents"], "match": "\\bdocument\\.(?:getElementById|querySelector(?:All)?|createElement|body|head|documentElement|addEventListener|removeEventListener|cookie|title|location|referrer|readyState|visibilityState|hidden|dispatchEvent|createTextNode|defaultView|activeElement)\\b", "reason": "Browser DOM APIs are unrelated to database documents."},
  {"path": ".*\\.cs$", "terms": ["documents"], "match": "\\bJsonDocument\\??\\s+document\\b|\\bdocument\\b(?=\\s*=\\s*(?:await\\s+)?JsonDocument\\.Parse(?:Async)?\\b)|\\bdocument\\.(?:RootElement|Dispose)\\b|\\b(?:JsonDocument(?:Options)?|XDocument|XmlDocument|OpenApiDocument)\\b", "reason": "Parser local declarations and parser members; other text on the line stays scanned."},
  {"path": ".*\\.[cm]?[jt]sx?$", "terms": ["documents"], "match": "\\bdocument\\.(?:appendChild|removeChild|createDocumentFragment|createRange|createEvent|importNode|adoptNode|elementFromPoint|elementsFromPoint|hasFocus|write|writeln)\\b|\\bownerDocument\\b", "reason": "Additional standard DOM operations and ownerDocument property."},
  {"path": "^(?:src/TerraBase/(?:Engine|Features)/.*(?:HomeApply|ConflictResolution)|tests/TerraBase\\.(?:Fast|Slow)/.*(?:HomeApply|ConflictResolution)|docs/terrabase/(?:sql|replication)/(?:home-apply|hlc-conflicts)[^/]*)", "repo": "terrascale", "terms": ["leaderless"], "match": "(?i)\\bLWW\\b|last[ _-]writer[ _-]wins", "reason": "D5/R6 retain HLC column conflict resolution in the new home-apply boundary; leaderless remains forbidden."},
  {"path": "^src/vendor/Turso\\.Data\\.Sqlite/src/Turso\\.Data\\.Sqlite/Properties/Resources\\.cs$", "repo": "terrascale", "terms": ["collections"], "match": "\\bUnknownCollection\\b|\\bcollectionName\\b|\\bUnknown collection\\b|\\bToo many restrictions specified for collection\\b", "reason": "ADO.NET schema collection diagnostics are unrelated to the retired API."},
  {"path": ".*", "terms": ["fly"], "match": "\\bflyctl\\s+storage\\b", "reason": "Tigris storage administration is retained; application commands remain forbidden."},
  {"path": ".*\\.cs$", "terms": ["documents"], "context": "\\bJsonDocument\\??\\s+document\\b|\\bdocument\\s*=\\s*(?:await\\s+)?JsonDocument\\.Parse(?:Async)?\\b", "match": "\\breturn\\s+document\\b", "reason": "Returning a locally bound JSON parser value is not a document API."},
  {"path": "^src/TerraScale\\.Endpoints/RequestBinder\\.cs$", "repo": "terrascale", "terms": ["documents", "collections"], "match": "\\b(?:document|documentOptions|ReadDocumentAsync|IsMutableCollection|collection|collections)\\b", "reason": "Shared HTTP JSON/reflection binder locals and helpers; storage API identifiers remain scanned."},
  {"path": "^src/vendor/Turso\\.Data\\.Sqlite/src/Turso\\.Data\\.Sqlite/SqliteConnection\\.cs$", "repo": "terrascale", "terms": ["collections"], "match": "\\b(?:DbMetaDataCollectionNames|MetaDataCollections|CollectionName|collectionName|UnknownCollection)\\b", "reason": "Retained ADO.NET SQL schema discovery symbols."}
]
