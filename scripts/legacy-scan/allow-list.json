[
  {
    "path": "(^|/)AGENTS\\.md$",
    "reason": "Human-owned agent instructions are governance, not product surfaces."
  },
  {
    "path": "^scripts/legacy-scan/",
    "repo": "terrascale",
    "reason": "Scanner policy and process fixtures necessarily name forbidden terms."
  },
  {
    "path": "^\\.cos/archive/",
    "reason": "Explicitly archived planning history."
  },
  {
    "path": "^(?:docs/)?archive/",
    "reason": "Explicitly archived history; active documentation is scanned."
  },
  {
    "path": "^benchmark/bench/",
    "repo": "terrascale",
    "reason": "Immutable historical measurement reports retained for comparisons."
  },
  {
    "path": "(^|/)(?:THIRD[-_]PARTY[-_]NOTICES(?:\\.md|\\.txt)?|NOTICE(?:\\.md|\\.txt)?|LICENSE(?:\\.md|\\.txt)?)$",
    "terms": [
      "engine-brand",
      "libsql"
    ],
    "reason": "Required upstream license and third-party attribution."
  },
  {
    "path": "^src/vendor/",
    "repo": "terrascale",
    "terms": [
      "engine-brand",
      "libsql"
    ],
    "reason": "Vendored engine implementation names are internal."
  },
  {
    "path": "^(?:src/TerraBase/Engine/Turso/|scripts/vendor/|tests/Turso\\.Data\\.Sqlite\\.Tests/)",
    "repo": "terrascale",
    "terms": [
      "engine-brand"
    ],
    "reason": "Internal engine wrapper, build and qualification code."
  },
  {
    "path": ".*",
    "terms": [
      "documents"
    ],
    "match": "\\bJsonDocument(?:Options)?\\b|\\b(?:XDocument|XmlDocument)\\b",
    "reason": "JSON and XML parser types are not document APIs."
  },
  {
    "path": ".*",
    "terms": [
      "collections"
    ],
    "match": "\\bSystem\\.Collections(?:\\.[A-Za-z]+)*\\b|\\b(?:IReadOnlyCollection|ICollection|ObservableCollection)\\b|\\bGC\\.CollectionCount\\b",
    "reason": "Standard library collection types and GC measurements."
  },
  {
    "path": ".*",
    "terms": [
      "collections"
    ],
    "match": "(?i)\\bGC collections?\\b|\\bgarbage collections?\\b",
    "reason": "Garbage collection terminology."
  },
  {
    "path": ".*",
    "terms": [
      "custom-wire"
    ],
    "match": "(?i)\\b(?:postgres(?:ql)?|psql|PG)[ -]wire[ -]protocol\\b",
    "reason": "Postgres wire is a retained public SQL surface."
  },
  {
    "path": ".*\\.[cm]?[jt]sx?$",
    "terms": [
      "documents"
    ],
    "match": "\\bdocument\\.(?:getElementById|querySelector(?:All)?|createElement|body|head|documentElement|addEventListener|removeEventListener|cookie|title|location|referrer|readyState|visibilityState|hidden|dispatchEvent|createTextNode|defaultView|activeElement)\\b",
    "reason": "Browser DOM APIs are unrelated to database documents."
  }
]
