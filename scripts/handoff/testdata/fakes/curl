#!/usr/bin/env bash
# Fake curl: ts-auth/TerraBase readiness and gru's TerraBase internal listener (management, API keys) as JSON state in
# $FAKE_DIR/tb.json. Logs method and URL only.
set -euo pipefail
method="" data="" out="" write="" fail=0 url=""
while [[ $# -gt 0 ]]; do
  case $1 in
    -X) method=$2; shift ;;
    -d) data=$2; shift ;;
    -o) out=$2; shift ;;
    -w) write=$2; shift ;;
    -H | -m) shift ;;
    --fail | -sS | --fail-with-body) fail=1 ;;
    http*) url=$1 ;;
  esac
  shift
done
[[ -n $method ]] || { [[ -n $data ]] && method=POST || method=GET; }
echo "curl $method $url" >> "$FAKE_LOG"
state="$FAKE_DIR/tb.json"
[[ -f $state ]] || echo '{"orgs":[],"projects":[],"dbs":[],"keys":[],"seq":0}' > "$state"
next() { local n; n=$(jq -r '.seq + 1' "$state"); jq ".seq = $n" "$state" > "$state.t" && mv "$state.t" "$state"; printf '01FAKE%020d' "$n"; }
code=200 body='{}'
path=${url#http*://*/}; path="/$path"
case "$method $url" in
  "GET https://ts-auth.fly.dev/readyz") body='{"status":"ready"}' ;;
  "GET https://ts-terrabase.fly.dev/healthz" | "GET http://127.0.0.1:"*/healthz) body='{"status":"ok","region":"gru"}' ;;
  "POST http://127.0.0.1:"*/admin/api-keys)
    id=$(next)
    jq --arg id "$id" --argjson k "$data" '.keys += [{id: $id, name: $k.name, project: $k.projectId, scopes: $k.scopes, expiresAt: $k.expiresAt}]' "$state" > "$state.t" && mv "$state.t" "$state"
    body=$(jq -cn --arg id "$id" --arg s "$FAKE_SECRET" --argjson k "$data" '{id: $id, secret: $s, expiresAt: $k.expiresAt}')
    code=201 ;;
  *)
    case "$method $path" in
      "GET /v1/management/organizations") body=$(jq -c '{items: .orgs}' "$state") ;;
      "POST /v1/management/organizations") id=$(next); jq --arg id "$id" --argjson b "$data" '.orgs += [{id: $id, name: $b.name}]' "$state" > "$state.t" && mv "$state.t" "$state"; body="{\"id\":\"$id\"}" ;;
      "PUT /v1/management/organizations/"*/plan) body='{}' ;;
      "GET /v1/management/organizations/"*/projects) body=$(jq -c '{items: .projects}' "$state") ;;
      "POST /v1/management/organizations/"*/projects) id=$(next); jq --arg id "$id" --argjson b "$data" '.projects += [{id: $id, name: $b.name}]' "$state" > "$state.t" && mv "$state.t" "$state"; body="{\"id\":\"$id\"}" ;;
      "GET /v1/management/organizations/"*/databases) body=$(jq -c '{items: .dbs}' "$state") ;;
      "POST /v1/management/organizations/"*/databases) id=$(next); jq --arg id "$id" --argjson b "$data" '.dbs += [{id: $id, name: $b.name}]' "$state" > "$state.t" && mv "$state.t" "$state"; body="{\"id\":\"$id\"}" ;;
      "GET /v1/management/organizations/"*/api-keys) body=$(jq -c '{items: [.keys[] | {id, name, expiresAt, createdAt: "2026-10-12T00:00:00Z"}]}' "$state") ;;
      "DELETE /v1/management/organizations/"*/api-keys/*) id=${path##*/}; jq --arg id "$id" '.keys |= map(select(.id != $id))' "$state" > "$state.t" && mv "$state.t" "$state"; code=204; body='' ;;
      "DELETE /v1/management/organizations/"*/databases/*) id=${path##*/}; jq --arg id "$id" '.dbs |= map(select(.id != $id))' "$state" > "$state.t" && mv "$state.t" "$state"; code=204; body='' ;;
      "DELETE /v1/management/organizations/"*/projects/*) id=${path##*/}; jq --arg id "$id" '.projects |= map(select(.id != $id))' "$state" > "$state.t" && mv "$state.t" "$state"; code=204; body='' ;;
      "DELETE /v1/management/organizations/"*) id=${path##*/}; jq --arg id "$id" '.orgs |= map(select(.id != $id))' "$state" > "$state.t" && mv "$state.t" "$state"; code=204; body='' ;;
      *) echo "fake curl: unexpected $method $url" >&2; exit 2 ;;
    esac ;;
esac
if [[ -n $out ]]; then printf '%s' "$body" > "$out"; else printf '%s' "$body"; fi
[[ -n $write ]] && printf '%s' "${write//%\{http_code\}/$code}"
[[ $fail == 1 && $code -ge 400 ]] && exit 22
exit 0
