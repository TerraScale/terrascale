{
  "name": "ts-status",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "tsc --noEmit",
    "lint": "vp lint && vp fmt --check",
    "predeploy": "npm run check",
    "deploy": "npm run build && npm run deploy:prebuilt",
    "deploy:prebuilt": "wrangler deploy -c dist/ts_status_vantage_sfo/wrangler.json --experimental-provision=false --experimental-auto-create=false --message \"$REVISION\" && wrangler deploy -c dist/ts_status_vantage_gru/wrangler.json --experimental-provision=false --experimental-auto-create=false --message \"$REVISION\" && wrangler deploy -c dist/ts_status/wrangler.json --experimental-provision=false --experimental-auto-create=false --message \"$REVISION\"",
    "db:bootstrap:local": "wrangler d1 execute ts-status --local --file schema.sql",
    "db:bootstrap:remote": "wrangler d1 execute ts-status --remote --file schema.sql",
    "world-map:sync": "node scripts/world-map-sync.mjs",
    "audit:dependencies": "npm audit --ignore-scripts --audit-level=high",
    "prebuild": "npm run audit:dependencies",
    "predeploy:prebuilt": "npm run audit:dependencies"
  },
  "dependencies": {
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261026.1",
    "@types/node": "^26.4.0",
    "dotted-map": "^3.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "@cloudflare/vite-plugin": {
      "vite": {
        ".": "8.3.3",
        "rolldown": "1.2.11"
      }
    },
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@12.0.2"
}
